Publisher: Springer Science and Business Media Deutschland GmbH
Type: Conference paper},
	keywords = {Explainable AI, Generative AI, Large language model, Information systems, Human computer interaction, Language model, Information use, Crime, Case based reasoning, Casebased reasonings (CBR), Constrained function, Detection rules, Error detection, Fraud detection, Novel applications, Spatiotemporal event},
