	year = {2024},
	note = {Publisher: Springer Nature
Type: Article},
	keywords = {Large language model, Usability, Systematic literature review, Knowledge graph, Language model, Literature reviews, Evaluation framework, Natural anguage processing, Research challenges, Review process, Semi-automatics, Usability engineering},
	annote = {Article},
	annote = {Cited by: 61; All Open Access; Green Accepted Open Access; Green Open Access; Hybrid Gold Open Access},
