@inproceedings{maes_mitigating_2025,
	title = {Mitigating {Misleadingness} in {LLM}-{Generated} {Natural} {Language} {Explanations} for {Recommender} {Systems}: {Ensuring} {Broad} {Truthfulness} {Through} {Factuality} and {Faithfulness}},
	volume = {3957},
	isbn = {978-966-654-489-9 978-80-7378-002-9 978-80-248-1025-6 978-9986-34-274-8 978-80-7378-171-2 978-2-9544948-0-7 978-80-248-2391-1 978-956-236-198-9 80-248-1025-5 80-7378-002-X},
