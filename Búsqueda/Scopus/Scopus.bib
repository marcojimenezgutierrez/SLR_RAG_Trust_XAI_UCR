Publisher: Springer Science and Business Media Deutschland GmbH
Type: Conference paper},
	keywords = {Explainable AI, Retrieval-augmented generation, Decision making, Teaching, Computer aided instruction, Students, Critical challenges, Decision-making process, Counseling system, K-12 education, Learning environments, Long-term development, Problem behaviors, Student problem behavior},
