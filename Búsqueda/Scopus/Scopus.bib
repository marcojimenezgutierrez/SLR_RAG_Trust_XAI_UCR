Type: Article},
	keywords = {Generative AI, Large language model, Chatbots, Retrieval augmented generation, Knowledge based systems, Language model, Computational linguistics, E-learning, Conversational agents, Generative language model, Digital assistants, Digital tutor},
	annote = {Cited by: 25; All Open Access; Gold Open Access},
}

@article{mutawa_impacts_2024,
	title = {Impacts of {Generative} {AI} on the {Future} of {Research} and {Education}},
