	author = {Esposito, Matteo and Palagiano, Francesco and Lenarduzzi, Valentina and Taibi, Davide},
	year = {2024},
	note = {ISSN: 19493770; 19493789
Type: Conference paper},
	keywords = {Generative AI, XAI, Explainability, Large Language Model, Actionability, Analysis, Fine-Tuning, Human Experts, Management, Retrieval Augmented Generation, Risk, Security, Standards, Large language model, Retrieval augmented generation, Language model, Laws and legislation, Human engineering, Fine tuning, Risk management, Risk analysis, Risk assessment, Analyze, Health risks, Human expert, Risk perception},
	pages = {517 -- 527},
	annote = {Cited by: 1; All Open Access; Gold Open Access},
}

