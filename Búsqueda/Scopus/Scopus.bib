	keywords = {Explainable AI, Generative AI, Retrieval-augmented generation, Query languages, Structured Query Language, Online searching, AI Technologies, Competition, European laws, Field focusing, Intricate structures, Legal queries, Nearest neighbor search, NLP in legal industry, Open source searches},
