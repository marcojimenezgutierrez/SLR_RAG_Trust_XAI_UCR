@article{storey_generative_2025,
	title = {Generative {Artificial} {Intelligence}: {Evolving} {Technology}, {Growing} {Societal} {Impact}, and {Opportunities} for {Information} {Systems} {Research}},
	issn = {13873326; 15729419},
