	year = {2025},
	note = {Publisher: Cell Press
Type: Review},
	keywords = {Large language model, Visualization, Prompt engineering, GPT-4, Language model, Artificial intelligence security, Artificial intelligence agent, Artificial intelligence-generated content, Prompt evaluation, Vision language model, Work simplification},
	annote = {Cited by: 35; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
}

