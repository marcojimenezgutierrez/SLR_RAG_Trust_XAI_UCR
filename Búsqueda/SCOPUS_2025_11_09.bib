@ARTICLE{Wehner2025,
	author = {Wehner, Jan and Abdelnabi, Sahar and Tan, Daniel C.H. and Krueger, David and Fritz, Mario},
	title = {Taxonomy, Opportunities, and Challenges of Representation Engineering for Large Language Models},
