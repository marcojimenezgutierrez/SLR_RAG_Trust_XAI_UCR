@ARTICLE{Munch2025493,
	author = {Munch, Lauritz Aastrup and Bjerring, Jens Christian},
	title = {Can large language models help solve the cost problem for the right to explanation?},
	year = {2025},
	journal = {Journal of Medical Ethics},
	volume = {51},
