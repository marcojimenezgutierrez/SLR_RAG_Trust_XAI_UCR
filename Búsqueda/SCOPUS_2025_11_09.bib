	affiliations = {Columbia University, Department of Biomedical Informatics, New York, United States; National Center for Biotechnology Information (NCBI), Bethesda, United States; Khoury College of Computer Sciences, Boston, United States; University of Pennsylvania, Epidemiology and Informatics, Philadelphia, United States; Weill Cornell Medicine, Department of Population Health Sciences, New York, United States; Weill Cornell Medicine, Institute of AI for Digital Health, New York, United States; Weill Cornell Medicine, New York, United States; Cornell Ann S. Bowers College of Computing and Information Science, Ithaca, United States; University of Pittsburgh, Department of Health Information Management, Pittsburgh, United States; Vanderbilt University Medical Center, Nashville, United States; Vanderbilt University Medical Center, Department of Biostatistics, Nashville, United States; Vanderbilt University School of Engineering, Nashville, United States; University of Haifa, Department of Information Systems, Haifa, Israel},
	abstract = {Evidence-based medicine promises to improve the quality of healthcare by empowering medical decisions and practices with the best available evidence. The rapid growth of medical evidence, which can be obtained from various sources, poses a challenge in collecting, appraising, and synthesizing the evidential information. Recent advancements in generative AI, exemplified by large language models, hold promise in facilitating the arduous task. However, developing accountable, fair, and inclusive models remains a complicated undertaking. In this perspective, we discuss the trustworthiness of generative AI in the context of automated summarization of medical evidence. © 2024 Elsevier B.V., All rights reserved.},
