@ARTICLE{Yang2025,
	author = {Yang, Yangrui and Wang, Pengfei and Liu, Xuemei and Luo, Wenyu and Yang, Libo},
	title = {A Multi-Agent and GraphRAG-Based Framework for Operation and Management Decision-Making in Hydraulic Projects},
	year = {2025},
	journal = {Water Resources Management},
	pages = {},
	doi = {10.1007/s11269-025-04312-5},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105010769713&doi=10.1007%2Fs11269-025-04312-5&partnerID=40&md5=d9da52c09f7f871b6b471455f9c8d3de},
	affiliations = {North China University of Water Resources and Electric Power, School of Information Engineering, Zhengzhou, China; North China University of Water Resources and Electric Power, School of Electronic Engineering, Zhengzhou, China; North China University of Water Resources and Electric Power, School of Economics and Management, Zhengzhou, China; North China University of Water Resources and Electric Power, Collaborative Innovation Center for Efficient Utilization of Water Resources, Zhengzhou, China},
	abstract = {Inspection of hydraulic projects is a core management task to ensure the safe and stable operation of major infrastructure. The current traditional inspection model has significant shortcomings, such as high reliance on manual labor, low accuracy in identifying potential risks, and insufficient dynamic decision-making capabilities. This paper innovatively constructs a multi-agent collaborative intelligent decision-making framework that integrates large language models (LLMs) and graph retrieval-augmented generation (Graph RAG) technologies. Through a modular architecture encompassing perception, cognition, and decision, the framework achieves full-process automated inspection. The study employs multi-source inspection data from the past three years to construct a multimodal dataset. Domain-adaptive fine-tuning enhances the F1 scores of the multimodal large model in equipment recognition and defect detection by 7.2% and 6.9%, respectively. Furthermore, a dynamic knowledge graph system based on Graph RAG is established. Knowledge injection techniques compensate for gaps in domain-specific knowledge, while entity-relation reasoning mechanisms effectively mitigate model hallucination phenomena. Experimental results demonstrate that the hydraulic engineering inspection reports generated by this method, evaluated by both experts and operations personnel, accurately reflect professional knowledge and technical depth in the field of hydraulic engineering maintenance. This research provides a new technical paradigm with strong explainability and high reliability for the intelligent operation and maintenance of hydraulic engineering infrastructure, offering significant engineering application value to promote digital transformation within the industry. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Graph retrieval-augmented generation; Multi-agent; Multimodal large language models; Operation and maintenance},
	keywords = {Automation; Decision making; Graphic methods; Human engineering; Hydraulic machinery; Hydraulic structures; Hydraulics; Inspection; Intelligent agents; Knowledge based systems; Large datasets; Maintainability; Metadata; Personnel; Project management; Graph retrieval-augmented generation; Hydraulic engineering; Hydraulic projects; Language model; Multi agent; Multi-modal; Multimodal large language model; Operation and management; Operation decisions; Operations and maintenance; Multi agent systems},
