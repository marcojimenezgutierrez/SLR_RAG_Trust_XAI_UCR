	note = {Cited by: 5; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access}
}

@CONFERENCE{Salimi202527,
	author = {Salimi, Pedram and Wiratunga, Nirmalie and Corsar, David},
	title = {Agentic CBR in Action: Empowering Loan Approvals Through Interactive, Counterfactual Explanations},
	year = {2025},
	journal = {CEUR Workshop Proceedings},
	volume = {3993},
	pages = {27 - 42},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105011073232&partnerID=40&md5=22ab028c862347b054bd307277557d49},
	affiliations = {Robert Gordon University, Aberdeen, United Kingdom},
	abstract = {Large Language Models (LLMs) have demonstrated impressive conversational capabilities, yet their susceptibility to hallucinations and inconsistent recommendations poses significant risks in high-stakes domains such as finance. This paper presents an interactive chatbot for loan application guidance that leverages a case-based reasoning (CBR) approach to generate actionable counterfactual explanations within an agentic framework. Our system employs a supervisor agent, built using the LangGraph framework, to orchestrate four specialised agents: a classifier agent that provides an initial loan prediction, a causally-aware counterfactual explanation agent that proposes minimal yet feasible modifications to reverse an unfavourable decision, a Feature Actionability Taxonomy (FAT) agent that updates user-specific immutability constraints based on feedback, and a template-based natural language generation (NLG) agent that transforms counterfactual suggestions into clear, user-friendly explanations. A key strength of our design is the automated feedback loop: when users indicate that certain suggestions are unworkable, the FAT agent revises the constraints and instructs the counterfactual generation agent to produce a refined explanation. We detail the system architecture and workflow and outline an experimental plan that compares our full agentic chatbot to ablated variants and a LLM-Only Baseline. And finally we outline a planned user study to evaluate how controlled reasoning affects trust in high-stakes lending. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Agentic workflow; CBR; Conversational AI; Counterfactual explanations; Hallucinations; Large Language Models},
	keywords = {Chatbots; Computer architecture; Feedback; Finance; Information systems; Information use; Agentic workflow; Casebased reasonings (CBR); Conversational AI; Counterfactual explanation; Counterfactuals; Hallucination; Language model; Large language model; Work-flows; Case based reasoning},
	correspondence_address = {P. Salimi; Robert Gordon University, Aberdeen, Garthdee House, Garthdee Rd, AB10 7AQ, United Kingdom; email: p.salimi@rgu.ac.uk},
