	title = {A Retrieval-Augmented Generation Strategy to Enhance Medical Chatbot Reliability},
	year = {2024},
	journal = {Lecture Notes in Computer Science},
	volume = {14844 LNAI},
	pages = {213 - 223},
	doi = {10.1007/978-3-031-66538-7_22},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85200788990&doi=10.1007%2F978-3-031-66538-7_22&partnerID=40&md5=1f8150a51a1fcf22a212abac293b39df},
	affiliations = {Bruno Kessler Foundation, Trento, Italy; Free University of Bozen-Bolzano, Bolzano, Italy},
	abstract = {The advent of Large Language Models opened new perspectives concerning their usage within the digital health domain. However, their intrinsic probabilistic and unpredictable behavior needs the design of trustworthy strategies aiming to avoid the creation of hallucinations that, especially within the digital health domain, may lead to severe harm. Such an issue has been addressed with the adoption of Retrieval-Augmented Generation solutions, where the text generation task is supported by controlled knowledge injected into the prompts. Even if the hallucination issue is mitigated, the generation of certified information (such as trustworthy content granted by the system’s owner) requires more sophisticated strategies. In this work, we propose an approach where the classic Retrieval-Augmented Generation pipeline is enhanced with a further initial step where the Large Language Model is asked to generate a preliminary text used to query the repository of certified information for presenting the appropriate content to the final user. © 2024 Elsevier B.V., All rights reserved.},
	keywords = {Information retrieval; Chatbots; Language model; Probabilistics; Text generations; Computational linguistics},
	correspondence_address = {L. Sanna; Fondazione Bruno Kessler, Trento, Italy; email: lsanna@fbk.eu},
	editor = {Finkelstein, J. and Moskovitch, R. and Parimbelli, E.},
