	pages = {20166 - 20270},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85203837986&partnerID=40&md5=bfd10aa1f3ba0637441f4fd539b7b412},
	affiliations = {Lehigh University, Bethlehem, United States; University of Notre Dame, Notre Dame, United States; Illinois Institute of Technology, Chicago, United States; CISPA, St Ingbert, Germany; University of Cambridge, Cambridge, United Kingdom; Institut Polytechnique de Paris, Palaiseau, France; William & Mary, Williamsburg, United States; Texas A&M University, College Station, United States; University of Georgia, Athens, United States; Samsung Research America, Mountain View, United States; Stanford University, Stanford, United States; MLCommons; University of Oxford, Oxford, United Kingdom; Lawrence Livermore National Laboratory, Livermore, United States; Salesforce.com, Inc., San Francisco, United States; University of Wisconsin-Madison, Madison, United States; Microsoft Research, Redmond, United States; Carnegie Mellon University, Pittsburgh, United States; Mohamed Bin Zayed University of Artificial Intelligence, Abu Dhabi, United Arab Emirates; University of Maryland, College Park, College Park, United States; University of California, Berkeley, Berkeley, United States; University of Illinois Urbana-Champaign, Urbana, United States; Rutgers University, New Jersey, United States; The University of North Carolina at Chapel Hill, Chapel Hill, United States; Massachusetts Institute of Technology, Cambridge, United States; Harvard University, Cambridge, United States; Duke University, Durham, United States; The University of Tennessee, Knoxville, Knoxville, United States; University of Southern California, Los Angeles, United States; Michigan State University, East Lansing, United States; Microsoft Research Asia, Beijing, China; Technische Universiteit Eindhoven, Eindhoven, Netherlands; Drexel University, Philadelphia, United States; University of California, Los Angeles, Los Angeles, United States; Virginia Polytechnic Institute and State University, Blacksburg, United States; University of Illinois at Chicago, Chicago, United States; IBM Research, Yorktown Heights, United States; Yale University, New Haven, United States; Columbia University, New York, United States; University of California, Santa Barbara, Santa Barbara, United States; Massachusetts General Hospital, Boston, United States; Northwestern University, Evanston, United States; Florida International University, Miami, United States; Johns Hopkins University, Baltimore, United States; University of Pennsylvania, Philadelphia, United States},
	abstract = {Large language models (LLMs) have gained considerable attention for their excellent natural language processing capabilities. Nonetheless, these LLMs present many challenges, particularly in the realm of trustworthiness. This paper introduces TRUSTLLM, a comprehensive study of trustworthiness in LLMs, including principles for different dimensions of trustworthiness, established benchmark, evaluation, and analysis of trustworthiness for mainstream LLMs, and discussion of open challenges and future directions. Specifically, we first propose a set of principles for trustworthy LLMs that span eight different dimensions. Based on these principles, we further establish a benchmark across six dimensions including truthfulness, safety, fairness, robustness, privacy, and machine ethics. We then present a study evaluating 16 mainstream LLMs in TRUSTLLM, consisting of over 30 datasets. Our findings firstly show that in general trustworthiness and capability (i.e., functional effectiveness) are positively related. Secondly, our observations reveal that proprietary LLMs generally outperform most open-source counterparts in terms of trustworthiness, raising concerns about the potential risks of widely accessible open-source LLMs. However, a few open-source LLMs come very close to proprietary ones, suggesting that open-source models can achieve high levels of trustworthiness without additional mechanisms like moderator, offering valuable insights for developers in this field. Thirdly, it is important to note that some LLMs may be overly calibrated towards exhibiting trustworthiness, to the extent that they compromise their utility by mistakenly treating benign prompts as harmful and consequently not responding. Besides these observations, we've uncovered key insights into the multifaceted trustworthiness in LLMs. We emphasize the importance of ensuring transparency not only in the models themselves but also in the technologies that underpin trustworthiness. We advocate that the establishment of an AI alliance between industry, academia, and the open-source community to foster collaboration is imperative to advance the trustworthiness of LLMs. Our dataset, code, and toolkit will be available at § https://github.com/HowieHwong/TrustLLM and the leaderboard is released at https://trustllmbenchmark.github. io/TrustLLM-Website/. © 2024 Elsevier B.V., All rights reserved.},
	keywords = {Artificial intelligence; Benchmarking; Modeling languages; Natural language processing systems; Open source software; Open systems; Problem oriented languages; Benchmark analysis; Benchmark evaluation; Evaluation and analysis; Functionals; Language model; Language processing; Natural languages; Open-source; Potential risks; Processing capability},
	correspondence_address = {Y. Huang; Lehigh University, United States; email: yhuang37@nd.edu; L. Sun; Lehigh University, United States; email: lis221@lehigh.edu},
	editor = {Salakhutdinov, R. and Kolter, Z. and Heller, K. and Weller, A. and Oliver, N. and Scarlett, J. and Berkenkamp, F.},
	publisher = {ML Research Press},
	issn = {26403498},
