@ARTICLE{Pinna2025,
	author = {Pinna, Simone and Massa, Silvia Maria and Riboni, Daniele},
	title = {AI-Driven Differential Diagnosis: Leveraging RAG and LLMs in Intelligent Healthcare Systems},
