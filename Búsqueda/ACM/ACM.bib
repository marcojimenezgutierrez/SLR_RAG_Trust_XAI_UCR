	title = {Time-{Sensitve} {Retrieval}-{Augmented} {Generation} for {Question} {Answering}},
	isbn = {978-1-4503-0949-3 978-1-59593-991-3 978-1-4503-2416-8 978-1-58113-146-8 978-1-4503-2425-0 978-1-60558-810-0 978-1-4503-0954-7 978-1-4503-2413-7 978-1-60558-807-0 978-1-4503-2421-2},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85210021300&doi=10.1145%2F3627673.3679800&partnerID=40&md5=44748277ac34c53ff2a232e2661cec10},
	doi = {10.1145/3627673.3679800},
	abstract = {Retrieval-augmented generation (RAG) enhances large language models (LLMs) by accessing external data sources, offering a promising way to improve accuracy and reliability. Despite its potential, conventional retrievers encounter bias and flaws with time-sensitive queries. In this paper, a benchmark query dataset is constructed to retrieve documents containing time-evolving facts, and the results show that current embedding-based similarity-matching methods struggle to handle queries with explicit temporal constraints. Therefore, we propose a novel approach that integrates supervised contrastive learning with tailored negative sample pairs for temporal constraints to train the retriever of an RAG system, along with query-side fine-tuning and routing techniques. Experimental results show that our approach significantly enhances the retriever performance of time-sensitive queries while ensuring the effectiveness of general queries. We will make the code and dataset publicly available at https://github.com/suzhou-22/TS-Retriever. © 2024 Elsevier B.V., All rights reserved.},
	language = {English},
	booktitle = {International {Conference} on {Information} and {Knowledge} {Management}, {Proceedings}},
	publisher = {Association for Computing Machinery},
	author = {Wu, Feifan and Liu, Lingyuan and He, Wentao and Liu, Ziqi and Zhang, Zhiqiang and Wang, Haofeng Fen and Wang, Meng},
	year = {2024},
	note = {ISSN: 21550751
Type: Conference paper},
	keywords = {large language model, retrieval-augmented generation, retriever, supervised contrastive learning, Large language model, Retrieval-augmented generation, Question answering, Language model, 'current, Adversarial machine learning, Contrastive Learning, Query languages, Question Answering, Structured Query Language, Embeddings, Supervised learning, External data sources, Retriever, Self-supervised learning, Spatio-temporal data, Supervised contrastive learning, Temporal constraints},
	pages = {2544 -- 2553},
