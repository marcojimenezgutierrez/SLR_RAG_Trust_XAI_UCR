@book{noauthor_dimes_2025,
	address = {New York, NY, USA},
	title = {{DIMES} '25: {Proceedings} of the 3rd {Workshop} on {Disruptive} {Memory} {Systems}},
	isbn = {979-8-4007-2226-4},
	abstract = {About the Workshop on Disruptive Memory Systems (DIMES). Recent innovations in the memory subsystem are reshaping the foundations that system software has relied on for decades. Instead of a single main-memory tier, modern systems now feature a non-uniform, deep, and fragmented memory hierarchy, where bandwidth and latency vary significantly. This trend toward diversification is set to accelerate with the commodification of CXL, which enables memory modules to be placed on the PCIe bus. Technologies like processing-in- and processing-near-memory are breaking away from the classical von Neumann architecture, enabling memory to perform computations itself.},
	publisher = {Association for Computing Machinery},
	year = {2025},
}

