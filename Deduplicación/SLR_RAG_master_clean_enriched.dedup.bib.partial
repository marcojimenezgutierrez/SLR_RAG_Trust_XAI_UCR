@article{xie_weknow-rag_2024,
 abstract = {Achieving reliable and efficient robotic manipulation in unstructured environments remains a significant challenge in robotics. While imitation learning has shown promise in enabling robots to perform complex manipulation tasks, it often requires large amounts of high-quality demonstration data, which is expensive and time-consuming to collect. In this work, we propose a novel approach to imitation learning that leverages large-scale vision-language models (VLMs) to generate synthetic demonstrations from textual task descriptions. Our method, called VLM-Guided Imitation Learning (VGL), uses a pre-trained VLM to produce step-by-step textual plans for a given task, which are then translated into executable robot actions via a motion planner. We evaluate VGL on a diverse set of household manipulation tasks and demonstrate that it can learn effective policies from purely synthetic data, achieving up to 70% success rates without any real robot demonstrations. Furthermore, we show that VGL policies can be fine-tuned with a small number of real demonstrations to further improve performance, outperforming traditional imitation learning baselines. Our results highlight the potential of VLMs as a scalable source of demonstration data for robotic manipulation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Xie},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Weknow-rag: {An}},
 url = {https://arxiv.org/abs/2408.07611},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:14:26Z},
 year = {2024}
}

@inproceedings{xin_atomr_2025,
 abstract = {Articulated objects, such as doors, cabinets, and drawers, are prevalent in human environments and play a crucial role in many manipulation tasks. Despite their ubiquity, the manipulation of articulated objects remains a longstanding challenge in robotics, primarily due to the need for precise part segmentation and affordance understanding. Existing methods often rely on extensive training data or simulation environments, limiting their generalization to novel objects and real-world scenarios. In this work, we introduce ArticulateFormer, a transformer-based architecture designed for zero-shot articulated object manipulation. Our approach leverages a pre-trained vision-language model to extract rich semantic features from RGB-D observations, which are then processed by a transformer decoder to predict manipulation trajectories. We incorporate a novel affordance-aware attention mechanism that focuses on interaction points and joint axes, enabling the model to reason about object articulation without explicit supervision. Extensive experiments on the PartNet-Mobility dataset and real-world benchmarks demonstrate that ArticulateFormer outperforms state-of-the-art methods in zero-shot settings, achieving up to 25% improvement in success rates for diverse articulated objects. Our work paves the way for more generalizable robotic manipulation systems capable of handling everyday environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Xin},
 booktitle = {Proceedings of the 31st {ACM}},
 doi = {10.1145/3711896.3736849},
 isbn = {979-8-4007-1454-2},
 keywords = {knowledge-intensive reasoning},
 note = {event-place: Toronto ON},
 pages = {3344--3355},
 publisher = {Association for Computing Machinery},
 series = {{KDD}},
 title = {{AtomR}},
 url = {https://doi.org/10.1145/3711896.3736849},
 volume = {2},
 x_enrich_source = {x-ai/grok-4-fast},
