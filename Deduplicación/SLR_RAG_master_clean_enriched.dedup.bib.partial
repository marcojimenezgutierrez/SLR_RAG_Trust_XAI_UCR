 title = {{SUGAR}},
 url = {https://doi.org/10.1109/icassp49660.2025.10890064},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:47:25Z},
 year = {2025}
}

@inproceedings{zulfikar_memoro_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their performance can vary significantly across different tasks and domains. To facilitate the comparison of LLMs, we present LLM Comparator, an open-source visual analytics platform that enables side-by-side evaluation of multiple LLMs. Our platform supports interactive exploration of model outputs through customizable prompts, diverse evaluation metrics, and visualizations that highlight similarities and differences in responses. Users can query models in natural language, compare outputs qualitatively and quantitatively, and identify patterns such as biases or inconsistencies. We demonstrate the utility of LLM Comparator through case studies in education, content generation, and ethical auditing, showing how it empowers non-experts to assess and select appropriate LLMs for specific use cases. By providing an intuitive interface for model comparison, LLM Comparator bridges the gap between LLM research and practical application.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zulfikar},
 booktitle = {Proceedings of the 2024 {CHI}},
