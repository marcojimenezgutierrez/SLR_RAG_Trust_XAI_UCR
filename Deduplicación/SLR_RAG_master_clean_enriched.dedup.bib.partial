@article{liu_toward_2025,
 abstract = {The explosive growth of Internet of Things (IoT) devices has led to an unprecedented surge in data generation, necessitating efficient and secure data sharing mechanisms, particularly in industrial settings. Traditional centralized approaches suffer from single points of failure, privacy breaches, and scalability issues. To address these challenges, this paper proposes a blockchain-enabled secure and efficient data sharing framework for the Industrial Internet of Things (IIoT). The framework integrates smart contracts for automated access control, attribute-based encryption for fine-grained privacy preservation, and a consortium blockchain to ensure decentralization and tamper-resistance. We introduce a novel consensus mechanism tailored for resource-constrained IIoT devices, reducing computational overhead while maintaining security. Extensive simulations and real-world experiments demonstrate that our framework achieves up to 40% improvement in data sharing efficiency and significantly enhances security against common attacks compared to state-of-the-art solutions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Liu},
 doi = {10.1109/MNET.2025.3583298},
 issn = {1558-156X},
 journal = {IEEE Network},
