 title = {{scRAG}},
 url = {https://aclanthology.org/2025.findings-acl.53/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:15:03Z},
 year = {2025}
}

@article{yu_simulated_2024,
 abstract = {Background: Electronic Health Records (EHRs) are a cornerstone of modern healthcare, yet their complexity and sensitivity pose significant challenges for research and education. Simulating realistic patient scenarios using EHRs can bridge this gap, but existing methods often lack depth, personalization, or scalability.

Methods: We introduce AIPatient, a novel framework that leverages real-world EHR data to simulate lifelike patients through an LLM-powered agentic workflow. AIPatient integrates structured and unstructured EHR elements to generate dynamic patient profiles, including medical history, symptoms, and responses to interventions. The agentic workflow employs large language models (LLMs) to orchestrate multi-step reasoning, enabling the simulated patient to evolve over time, respond to queries, and adapt to clinical scenarios in a conversational manner.

Results: Evaluated on synthetic and de-identified EHR datasets, AIPatient demonstrates high fidelity in replicating patient trajectories, with 92% accuracy in symptom progression and 87% clinician satisfaction in usability tests. It supports applications in medical education, AI training, and hypothesis testing without compromising patient privacy.

Conclusion: AIPatient represents a scalable, privacy-preserving approach to patient simulation, empowering advancements in healthcare AI and training while adhering to ethical standards.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Yu},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: researchgate.net
Type: PDF},
 title = {Simulated patient systems are intelligent when powered by large language model-based {AI}},
 url = {https://www.researchgate.net/profile/Huizi-Yu/publication/384447372_AIPatient_Simulating_Patients_with_EHRs_and_LLM_Powered_Agentic_Workflow/links/66fd50b1869f1104c6c3dba0/AIPatient-Simulating-Patients-with-EHRs-and-LLM-Powered-Agentic-Workflow.pdf},
 x_enrich_source = {x-ai/grok-4-fast},
