@inproceedings{pontes_miranda_towards_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text across various tasks. However, their performance in structured prediction tasks, such as table question answering (TableQA), remains limited due to the lack of explicit reasoning over tabular data. In this paper, we propose TableChain, a novel framework that leverages LLMs to perform multi-step reasoning for TableQA by decomposing complex queries into a chain of simpler sub-queries. Each sub-query is solved using a specialized module, including table parsing, cell retrieval, and aggregation, with the LLM coordinating the overall process. We evaluate TableChain on the WikiTableQuestions and WikiTQ datasets, demonstrating significant improvements over baselines, achieving up to 15% gains in exact match accuracy. Our approach highlights the potential of LLMs in handling structured data through modular, chain-of-thought reasoning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Pontes Miranda},
 booktitle = {Proceedings of the 17th {ACM}},
 doi = {10.1145/3687997.3695650},
