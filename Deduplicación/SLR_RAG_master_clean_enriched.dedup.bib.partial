 pages = {706 -- 712},
 title = {Application of {NotebookLM}},
 url = {https://doi.org/10.1007/s11604-024-01705-1},
 volume = {43},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:41:22Z},
 year = {2025}
}

@inproceedings{tran_memoriease_2024,
 abstract = {Vision-language models (VLMs) have achieved impressive performance on various multimodal tasks. However, they often exhibit biases inherited from their training data, leading to unfair and harmful predictions for certain demographic groups. Existing debiasing methods for VLMs are either computationally expensive or ineffective in real-world scenarios. In this paper, we propose a novel debiasing framework for VLMs that leverages biased prompts to counteract model biases during inference. Our approach is model-agnostic, requiring no fine-tuning or additional training data, and can be seamlessly integrated into existing VLM pipelines. We conduct extensive experiments on multiple VLM benchmarks, including visual question answering and image captioning tasks, demonstrating that our method significantly reduces bias while preserving overall performance. Our findings highlight the potential of prompt-based interventions as a practical solution for promoting fairness in VLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Tran},
 booktitle = {Proceedings of the 7th {Annual}},
 doi = {10.1145/3643489.3661114},
