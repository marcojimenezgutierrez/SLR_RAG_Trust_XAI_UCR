@article{jiang_rag-thief_2024,
 abstract = {The rapid advancement of large language models (LLMs) has shown their potential to serve as generalist agents for a wide range of tasks. However, their application to physical manipulation tasks, especially in unstructured environments, remains limited due to the lack of fine-grained spatial understanding and precise control. To address this, we introduce a novel framework that leverages the multimodal capabilities of LLMs to generate high-level task plans and low-level manipulation primitives, enabling end-to-end control of robotic arms. Our approach, called LLM-Mani, integrates visual perception with language-based reasoning to decompose complex tasks into executable sequences of actions. We evaluate LLM-Mani on a diverse set of manipulation benchmarks, including object grasping, stacking, and tool usage, demonstrating significant improvements over existing methods in generalization and success rates. Our results highlight the potential of LLMs as versatile controllers for robotic manipulation, paving the way for more autonomous and adaptable robotic systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Jiang},
 journal = {arXiv preprint arXiv:2411.14110},
 keywords = {source: Google Scholar},
