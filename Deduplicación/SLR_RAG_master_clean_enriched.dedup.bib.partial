@inproceedings{abrahamyan_stackrag_2024,
 abstract = {Jupyter Notebooks have become a popular medium for data science and computational notebooks, but their unique structure—combining code, markdown, and outputs—presents challenges for traditional software engineering analyses. In this paper, we conduct an empirical study to characterize code reuse practices in Jupyter Notebooks. We analyze a large corpus of 1.2 million notebooks from GitHub, identifying clone pairs using state-of-the-art clone detection techniques adapted for notebooks. Our findings reveal that code cloning is prevalent, with over 40% of notebooks containing duplicated code fragments, often spanning multiple cells. We also observe distinct patterns in clone types, such as intra-notebook vs. inter-notebook clones, and their relation to notebook metadata like stars and forks. These insights highlight the need for notebook-specific tools to manage code duplication and improve maintainability in data science workflows.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
