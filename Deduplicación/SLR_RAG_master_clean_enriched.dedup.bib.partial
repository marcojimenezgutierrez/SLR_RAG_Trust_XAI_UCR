@inproceedings{hemmat_adaptive_2025,
 abstract = {This paper proposes a novel deep learning-based approach for detecting adversarial attacks in autonomous driving systems. We focus on improving the robustness of perception modules against imperceptible perturbations. By integrating attention mechanisms with generative adversarial networks, our model achieves higher detection accuracy and lower false positives compared to existing methods. Experimental results on benchmark datasets demonstrate the effectiveness of our framework in real-world scenarios.},
