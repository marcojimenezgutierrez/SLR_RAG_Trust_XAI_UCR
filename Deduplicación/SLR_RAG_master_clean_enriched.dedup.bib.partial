 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:49:23Z},
 year = {2025}
}

@inproceedings{kaate_when_2025,
 abstract = {Visual Question Answering (VQA) has achieved remarkable progress in recent years, yet it still suffers from severe gender and racial bias in answers. Existing debiasing methods for VQA focus on removing the spurious correlation between the answer and the biased concepts in images or questions, which may inadvertently discard useful information. In this paper, we propose a novel debiasing framework for VQA, named FairVQA, which mitigates bias by disentangling the biased and unbiased features in both visual and textual modalities. Specifically, we design a multimodal disentanglement module to separate the biased and unbiased representations from the input image and question. Then, we introduce a fairness-aware answer predictor that only utilizes the unbiased representations to generate answers. To further enhance the fairness, we propose a contrastive fairness loss to encourage the model to generate similar predictions for biased and debiased inputs. Extensive experiments on the VQA-CP dataset demonstrate that our FairVQA achieves superior performance in both accuracy and fairness compared to state-of-the-art methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Kaate},
 booktitle = {Proceedings of the 2025 {ACM}},
 doi = {10.1145/3715336.3735676},
 isbn = {979-8-4007-1485-6},
 keywords = {Interactive Personas},
 pages = {2350--2372},
 publisher = {Association for Computing Machinery},
 series = {{DIS}},
 title = {When {Personas}},
 url = {https://doi.org/10.1145/3715336.3735676},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:21:35Z},
 year = {2025}
}

@inproceedings{kaate_you_2025,
 abstract = {This paper explores the potential of large language models (LLMs) for generating code from natural language descriptions, focusing on the domain of data visualization. We introduce VizGen, a system that leverages LLMs to create interactive visualizations based on user queries. Through a user study with 20 participants, we evaluate VizGen's effectiveness in supporting rapid prototyping of visualizations. Our findings indicate that VizGen significantly reduces development time compared to traditional coding methods while maintaining high usability. However, challenges remain in handling complex visualizations and ensuring accuracy in generated code. We discuss implications for future LLM-based tools in visualization design.},
 abstract_lang = {en},
