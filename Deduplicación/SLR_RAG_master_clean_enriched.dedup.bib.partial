@inproceedings{haryanto_contextualized_2024,
 abstract = {Abstract—With the rapid advancement of the Internet of Things (IoT), ensuring secure and efficient data sharing among heterogeneous devices has become a critical challenge. Traditional centralized approaches suffer from single points of failure, privacy concerns, and scalability issues. This paper proposes a blockchain-based framework for secure data sharing in IoT environments. The framework leverages smart contracts to automate access control and data transactions, ensuring immutability and transparency. We introduce a lightweight consensus mechanism tailored for resource-constrained IoT devices, reducing computational overhead while maintaining security. Experimental evaluations on a simulated IoT network demonstrate that our approach achieves up to 40% improvement in transaction throughput and 30% reduction in latency compared to existing solutions, without compromising data integrity or privacy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
