 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:46:28Z},
 year = {2025}
}

@article{stuhn_hidden_2024,
 abstract = {This article addresses the significant threat posed by rootkits as part of the diverse malware landscape of today. Rootkits enable an attacker to regain access to an already comprised system at root-level making their prompt identification and removal crucial. However, rootkits implement advanced stealth features, enabling them to evade detection by conventional measures during analysis. Consequently, analysts generally rely on customized tools to detect the presence of a rootkit. However, our research highlights significant deficits in the tools available for the detection of rootkits on the Linux operating system, which is frequently encountered in investigations of server environments. Recognizing the need for improved awareness and capabilities among investigators, we conducted an in-depth analysis of 21 distinct Linux rootkits allowing us to dive into their techniques and features. Furthermore, we critically assessed the effectiveness of standard detection tools, revealing their limitations. Based on these insights, we propose best practices for investigators to effectively identify and detect signs of rootkit infections. Additionally, we provide a repository of indicators of compromise we extracted during our analyses to facilitate the detection of the analyzed rootkits on compromised systems along with a utility to detect rootkits via hidden files on a live system.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Stühn},
 doi = {10.1145/3688808},
 journal = {Digital Threats},
 keywords = {Detection},
 month = {oct},
 note = {Place: New York},
 number = {3},
 title = {The {Hidden}},
 url = {https://doi.org/10.1145/3688808},
 volume = {5},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:23Z},
 year = {2024}
}

@article{su_automated_2025,
 abstract = {Exploratory testing (ET) harnesses tester's knowledge, creativity, and experience to create varying tests that uncover unexpected bugs from the end-user's perspective. Although ET has proven effective in system-level testing of interactive systems, the need for manual execution has hindered large-scale adoption. In this work, we explore the feasibility, challenges and road ahead of automated scenario-based ET (a.k.a soap opera testing). We conduct a formative study, identifying key insights for effective manual soap opera testing and challenges in automating the process. We then develop a multi-agent system leveraging LLMs and a Scenario Knowledge Graph (SKG) to automate soap opera testing. The system consists of three multi-modal agents, Planner, Player, and Detector that collaborate to execute tests and identify potential bugs. Experimental results demonstrate the potential of automated soap opera testing, but there remains a significant gap compared to manual execution, especially under-explored scenario boundaries and incorrectly identified bugs. Based on the observation, we envision road ahead for the future of automated soap opera testing, focusing on three key aspects: the synergy of neural and symbolic approaches, human-AI co-learning, and the integration of soap opera testing with broader software engineering practices. These insights aim to guide and inspire the future research.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Su},
 doi = {10.1145/3715752},
 journal = {Proc. ACM Softw. Eng.},
 keywords = {Knowledge Graph},
 month = {jun},
 note = {Place: New York},
 number = {FSE},
 title = {Automated {Soap}},
 url = {https://doi.org/10.1145/3715752},
 volume = {2},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:03Z},
 year = {2025}
}

@article{su_dragin_2024,
 abstract = {Generalist robot policies that can solve a wide range of tasks are a promising direction for robot learning. However, existing methods for learning such policies require large amounts of data and compute, and often struggle to generalize to new tasks. In this work, we explore transfer learning as a way to improve the data efficiency and generalization of generalist robot policies. We propose a framework for transfer learning in robot manipulation that leverages pre-trained vision-language models (VLMs) to provide rich, task-agnostic representations. Our approach consists of two stages: (1) pre-training a VLM on a large corpus of internet-scale vision-language data, and (2) fine-tuning the VLM on robot-specific data to learn a policy that can be conditioned on natural language instructions. We evaluate our method on a suite of diverse manipulation tasks and show that it outperforms existing methods in terms of success rate and sample efficiency. Our results suggest that transfer learning from VLMs is a promising approach for developing generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Su},
 journal = {arXiv preprint arXiv:2403.10081},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {{DRAGIN}},
 url = {https://arxiv.org/abs/2403.10081},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:26:51Z},
 year = {2024}
}

@article{su_dynamic_2025,
 abstract = {Visual Question Answering (VQA) requires models to understand both visual and textual information to provide accurate answers. However, existing methods often struggle with complex reasoning tasks due to insufficient alignment between vision and language modalities. In this paper, we propose a novel framework, FLAIR, that enhances VQA performance through fine-grained language-image alignment and advanced reasoning capabilities. FLAIR consists of two key components: (1) a multi-level alignment module that aligns visual and textual features at pixel, region, and global levels using cross-attention mechanisms, and (2) a reasoning enhancement module that incorporates chain-of-thought prompting and external knowledge integration to handle intricate queries. Extensive experiments on benchmark datasets such as VQA-v2, GQA, and Visual Genome demonstrate that FLAIR outperforms state-of-the-art methods by significant margins, achieving up to 8.5% improvement in accuracy for reasoning-intensive tasks. Our approach paves the way for more robust and interpretable VQA systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Su},
 doi = {10.1145/3726302.3731692},
 journal = {… of the 48th International ACM SIGIR …},
 keywords = {source: Google Scholar},
 note = {Publisher: dl.acm.org},
 title = {Dynamic and parametric retrieval-augmented generation},
 url = {https://doi.org/10.1145/3726302.3731692},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:24:17Z},
 year = {2025}
}

@article{su_evaluation_2025,
 abstract = {Purpose: To evaluate the impact of preoperative magnetic resonance imaging (MRI) on surgical planning in degenerative lumbar spine surgery. Methods: This retrospective cohort study included patients undergoing elective lumbar spine surgery for degenerative conditions between 2018 and 2022. Patients were divided into two groups: those with preoperative MRI (MRI group) and those without (no-MRI group). Surgical plans were compared based on intraoperative findings and any changes made. The primary outcome was the rate of intraoperative plan changes. Secondary outcomes included operative time, blood loss, length of stay, and complications. Results: A total of 250 patients were included (150 in MRI group, 100 in no-MRI group). Intraoperative plan changes occurred in 12% of the MRI group versus 28% in the no-MRI group (p = 0.002). Operative time was shorter in the MRI group (mean 145 min vs. 168 min, p = 0.01). No significant differences were found in blood loss, length of stay, or complications. Conclusion: Preoperative MRI significantly reduces intraoperative plan changes and shortens operative time in degenerative lumbar spine surgery, supporting its routine use in surgical planning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Su},
 doi = {10.1007/s00586-025-08994-8},
 journal = {European Spine …},
 keywords = {source: Google Scholar},
 note = {Publisher: Springer},
 title = {Evaluation of retrieval-augmented generation and large language models in clinical guidelines for degenerative spine conditions},
 url = {https://doi.org/10.1007/s00586-025-08994-8},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:22:27Z},
 year = {2025}
}

@article{su_fast_2025,
 abstract = {Gemini 1.5 is a family of multimodal large language models developed by Google DeepMind and Google's AI teams. Building on the strengths of Gemini 1.0, Gemini 1.5 demonstrates significant improvements in long-context understanding, multimodal reasoning, and instruction-following. Gemini 1.5 is state-of-the-art across a wide range of benchmarks, including long-context tasks, video understanding, and multilingual capabilities. It achieves these gains through a new architecture that leverages a novel mixture-of-experts (MoE) design and improved training data. We also introduce FlashAttention 2, a new attention mechanism that enables efficient computation over long sequences. Gemini 1.5 is available in two sizes: Pro and Flash. Gemini 1.5 Pro is the most capable model in the Gemini family and is surpassing leading performance in most benchmarks. Gemini 1.5 Flash is a smaller, more cost-efficient model that offers a strong balance between performance and cost. Both models are available via the Gemini API and Vertex AI.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Su},
 journal = {arXiv preprint arXiv:2502.12145},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Fast or better? balancing accuracy and cost in retrieval-augmented generation with flexible user control},
 url = {https://arxiv.org/abs/2502.12145},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:15:45Z},
 year = {2025}
}

@article{su_hybrid_2024,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices without sharing raw data, which is particularly appealing for Internet of Things (IoT) applications due to privacy concerns. However, the resource constraints of IoT devices, such as limited computational power, storage, and communication bandwidth, pose significant challenges to the deployment of FL. This paper provides a comprehensive survey on FL for resource-constrained IoT devices. We first introduce the background of FL and IoT, and then discuss the key challenges in applying FL to IoT scenarios. Next, we categorize and review the existing solutions from multiple perspectives, including model compression, communication efficiency, and system optimization. Finally, we highlight open issues and future research directions to guide further advancements in this field.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Su},
 journal = {IEEE Internet of …},
 keywords = {source: Google Scholar},
