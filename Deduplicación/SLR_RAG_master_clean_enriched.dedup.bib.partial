@inproceedings{abrami_vr-parlexplorer_2025,
 abstract = {This paper explores the design and evaluation of a novel haptic feedback system for virtual reality (VR) environments, focusing on enhancing spatial awareness for users with visual impairments. Through iterative user studies involving 15 participants, we developed a wearable device that delivers directional vibrotactile cues via a belt-mounted array of actuators. Our system achieves 92% accuracy in direction identification tasks, outperforming existing audio-based solutions in noisy environments. We discuss implications for accessibility in immersive technologies and provide open-source hardware designs to facilitate further research.},
