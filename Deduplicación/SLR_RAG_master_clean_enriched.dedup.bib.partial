@article{bhat_retrieval_2024,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices while preserving data privacy by keeping data local. However, deploying FL on resource-constrained Internet of Things (IoT) devices is challenging due to limited computational, storage, and communication resources. This paper presents a comprehensive survey on FL for resource-constrained IoT devices. We first introduce the fundamentals of FL and discuss its unique challenges in IoT environments. Then, we categorize and analyze existing solutions from three perspectives: model optimization, communication efficiency, and privacy preservation. Finally, we highlight open research issues and future directions to facilitate the practical deployment of FL in IoT systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
