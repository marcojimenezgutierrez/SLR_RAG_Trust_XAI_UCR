@inproceedings{pratelli_evaluation_2025,
 abstract = {This paper explores the design and evaluation of a novel haptic feedback system for virtual reality (VR) environments, focusing on enhancing user immersion through skin deformation. We present Hapticskin, a wearable device that uses pneumatic actuators to simulate realistic touch sensations, such as pressure and texture, on the user's forearm. Through a series of user studies involving 24 participants, we demonstrate that Hapticskin significantly improves task performance in VR interactions (p < 0.01) and increases perceived realism compared to traditional vibrotactile feedback. Our findings highlight the potential of skin-based haptics in applications like remote collaboration and medical training, while addressing challenges in comfort and portability.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
