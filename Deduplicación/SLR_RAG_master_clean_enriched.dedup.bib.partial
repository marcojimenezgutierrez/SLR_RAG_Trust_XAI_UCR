@article{yu_evaluation_2024,
 abstract = {This chapter explores the integration of blockchain technology with artificial intelligence (AI) for enhancing supply chain management. We propose a hybrid framework that leverages AI-driven predictive analytics and blockchain's decentralized ledger to ensure transparency, security, and efficiency in supply chains. The framework is evaluated through simulations on real-world datasets, demonstrating improved traceability and reduced fraud risks. Key challenges such as scalability and interoperability are addressed, with recommendations for future implementations.},
