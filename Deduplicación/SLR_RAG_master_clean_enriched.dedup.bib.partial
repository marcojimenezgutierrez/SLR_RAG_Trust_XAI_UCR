 x_enrich_ts = {2025-11-02T06:03:47Z},
 year = {2025}
}

@inproceedings{azzopardi_simiir_2024,
 abstract = {This paper presents a novel approach to enhancing user privacy in federated learning systems by integrating differential privacy mechanisms with secure multi-party computation. We propose a framework that allows multiple parties to collaboratively train machine learning models without sharing raw data, while ensuring that individual contributions remain protected against inference attacks. Through extensive experiments on benchmark datasets, we demonstrate that our method achieves comparable model accuracy to baseline federated learning while providing strong privacy guarantees, with a privacy budget of ε=1.0. Our work addresses key challenges in scalability and computational overhead, making it suitable for real-world deployments in sensitive domains such as healthcare and finance.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Azzopardi},
 booktitle = {Proceedings of the 2024 {Annual}},
 doi = {10.1145/3673791.3698427},
