 year = {2024}
}

@inproceedings{jiang_retrieval_2025,
 abstract = {Mobile apps are increasingly relying on AI to provide personalized experiences. However, current personalization approaches often require extensive user data collection, raising privacy concerns. In this paper, we explore privacy-preserving personalization in mobile apps using federated learning (FL). We propose a framework that enables on-device model training without sharing raw user data with central servers. Our approach leverages differential privacy to further protect user information during aggregation. Through experiments on real-world mobile app datasets, we demonstrate that our method achieves comparable personalization accuracy to centralized approaches while significantly reducing privacy risks. We also discuss challenges in deploying FL on resource-constrained mobile devices and propose optimizations for efficiency.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
