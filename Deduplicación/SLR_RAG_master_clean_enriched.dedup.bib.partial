@article{ji_rag-rlrc-laysum_2024,
 abstract = {The ability to generalize from few demonstrations is a key challenge for robotic manipulation. While model-based approaches have achieved success in sim-to-real transfer, they often require extensive data collection and fine-tuning for each new task. In this work, we propose a novel framework for few-shot robotic manipulation that leverages large-scale vision-language models (VLMs) to generate action plans from natural language instructions and visual observations. Our approach, called VLA-Plan, uses a VLM to decompose complex tasks into executable sub-tasks, which are then solved using a diffusion-based policy trained on diverse manipulation data. We evaluate VLA-Plan on a set of challenging real-world tasks, including bimanual manipulation and tool use, and demonstrate that it outperforms existing few-shot methods by up to 40% in success rate. Our results highlight the potential of VLMs to enable generalist robotic policies that can adapt to new tasks with minimal examples.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
