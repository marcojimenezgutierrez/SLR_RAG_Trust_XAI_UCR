 year = {2025}
}

@inproceedings{song_rag-hat_2024,
 abstract = {Large language models (LLMs) have achieved remarkable success in code generation, but they still struggle with generating code that correctly handles complex dependencies, such as those involving external libraries or intricate control flows. In this paper, we introduce DepCode, a novel framework that enhances code generation by incorporating dependency-aware retrieval and augmentation. DepCode first retrieves relevant code snippets and documentation using a dependency-focused retriever, then augments the prompt with this information to guide the LLM in producing more accurate and dependency-compliant code. We evaluate DepCode on benchmarks like HumanEval and MBPP, demonstrating significant improvements in pass@1 accuracy, particularly for tasks requiring library usage and dependency resolution. Our approach also reduces hallucinations and improves code robustness, making it a practical enhancement for real-world code generation applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 4},
