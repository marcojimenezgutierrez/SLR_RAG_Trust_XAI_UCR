@inproceedings{nguyen-ho_t-eagle_2025,
 abstract = {BreatheSense: Assessing Breathing Patterns for Stress Detection Using Commodity Smartwatches

Detecting stress is crucial for promoting mental well-being, but current methods often rely on self-reports or specialized sensors, limiting their accessibility. In this paper, we explore the potential of breathing patterns, captured via commodity smartwatches, for stress detection. We conducted a study with 30 participants performing stressful and non-stressful tasks while wearing a smartwatch on their wrist. Using inertial measurement unit (IMU) data, we extracted breathing features and trained machine learning models to classify stress levels. Our results show that wrist-based breathing signals can achieve up to 82% accuracy in distinguishing stress from baseline states, outperforming heart rate variability (HRV) features alone. We discuss implications for pervasive stress monitoring and opportunities for integrating breathing-based sensing into everyday wearables.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Nguyen-Ho},
 booktitle = {Proceedings of the 8th {Annual}},
