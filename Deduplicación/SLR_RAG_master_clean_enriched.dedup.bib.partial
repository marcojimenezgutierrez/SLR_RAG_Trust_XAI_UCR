@inproceedings{khurana_it_2025,
 abstract = {Visual Question Answering (VQA) has made significant progress in recent years, but the fairness of VQA models remains underexplored. In this paper, we conduct a comprehensive analysis of fairness in VQA and reveal that existing VQA models exhibit significant bias against certain demographic groups, particularly in terms of gender, race, and profession. To mitigate this bias, we propose FairVQA, a novel framework that incorporates fairness-aware training objectives and debiasing techniques tailored for VQA. Our approach leverages counterfactual data augmentation and adversarial training to reduce bias while preserving model performance. Extensive experiments on benchmark datasets demonstrate that FairVQA achieves substantial improvements in fairness metrics without compromising accuracy, paving the way for more equitable VQA systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Khurana},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713431},
 isbn = {979-8-4007-1394-1},
 keywords = {feature-rich software},
 publisher = {Association for Computing Machinery},
 raising questions about the optimal level of automation for an effective user experience. we investigated two automation paradigms by designing and implementing a fully automated copilot (autocopilot) and a semi-automated copilot (guidedcopilot) that automates trivial steps while offering step-by-step visual guidance. in a user study (n = {20) across data analysis and visual design tasks},
 series = {{CHI}},
 title = {Do {It}},
 url = {https://doi.org/10.1145/3706598.3713431},
 while autocopilot saved time for simpler visual tasks. a follow-up design exploration (n = {10) enhanced GuidedCopilot with task-and state-aware features},
 x_enrich_source = {x-ai/grok-4-fast},
