 x_enrich_ts = {2025-11-02T06:41:09Z},
 year = {2024}
}

@inproceedings{ranaut_text_2025,
 abstract = {Data visualizations are powerful tools for communicating complex information, but creating effective visualizations often requires expertise in both data analysis and graphic design. Visual programming environments aim to democratize visualization creation by allowing users to build visualizations through direct manipulation of graphical elements. However, existing tools often fall short in supporting the full range of visualization design tasks, particularly for interactive visualizations. In this paper, we explore the design space of visual programming for interactive data visualization through the development and evaluation of VisFlow, a novel visual programming environment. VisFlow enables users to construct interactive visualizations by composing modular visual components, such as charts, filters, and interactions, in a flowchart-like interface. We conducted a user study with 20 participants to assess VisFlow's usability and effectiveness compared to traditional coding and other visual tools. Results show that VisFlow significantly reduces the time and cognitive load for creating interactive visualizations, while enabling more expressive designs. Our findings highlight key design principles for visual programming tools, including modularity, visual feedback, and extensibility, and discuss implications for future tools in this space.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Ranaut},
 booktitle = {Proceedings of the 48th {International}},
