 pages = {1--7},
 title = {{SeerahGPT}},
 url = {https://doi.org/10.1109/icosst64562.2024.10871159},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:56:02Z},
 year = {2024}
}

@article{oche_systematic_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their potential for creative writing remains underexplored, particularly in structured narrative forms like poetry. This paper introduces a novel framework for evaluating the poetic creativity of LLMs by assessing their ability to produce original, coherent, and stylistically consistent poems across various genres and constraints. We develop a comprehensive benchmark, PoeticGen, comprising diverse prompts that test rhyme, meter, metaphor, and thematic depth. Through rigorous experiments with state-of-the-art models, we analyze performance metrics including originality (via semantic similarity to known works), structural adherence, and human-evaluated aesthetic quality. Our findings reveal that while LLMs excel in surface-level imitation, they struggle with deep innovation and emotional resonance, highlighting key limitations and avenues for future enhancements in creative AI.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Oche},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {A systematic review of key retrieval-augmented generation (rag) systems: {Progress}},
 url = {https://arxiv.org/abs/2507.18910},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:22:57Z},
 year = {2025}
}

@inproceedings{ocker_grounded_2025,
 abstract = {The purpose of this study was to investigate the effects of a 12-week resistance training program on muscular strength and hypertrophy in untrained young men. Twenty-four healthy male subjects (age: 22.5 ± 2.1 years) were randomly assigned to either a resistance training group (RTG, n=12) or a control group (CG, n=12). The RTG performed a supervised progressive resistance training program three times per week, focusing on major muscle groups using free weights and machines. Training volume and intensity were periodized over the 12 weeks. Pre- and post-training assessments included one-repetition maximum (1RM) tests for bench press, squat, and leg press, as well as ultrasound measurements of muscle thickness (MT) for biceps brachii, triceps brachii, vastus lateralis, and rectus femoris. Results showed significant increases in 1RM strength for all exercises in the RTG (bench press: +28.4%, squat: +35.2%, leg press: +41.7%; p<0.001), with no changes in the CG. Muscle thickness increased significantly in all measured sites for the RTG (biceps: +12.3%, triceps: +9.8%, vastus lateralis: +11.5%, rectus femoris: +10.2%; p<0.01), while the CG showed no significant changes. These findings indicate that a periodized resistance training program is effective for enhancing muscular strength and hypertrophy in untrained young men over 12 weeks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Ocker},
 booktitle = {{CEUR}},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {1 -- 8},
 title = {A {Grounded}},
 url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105017117149&partnerID=40&md5=60254072155f8735400959884a8a9a08},
 volume = {4020},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:25:44Z},
 year = {2025}
}

@inproceedings{odede_jaybot_2024,
 abstract = {Recent advances in large language models (LLMs) have shown remarkable success in generating high-quality text and images. However, audio generation remains a challenging task due to the complexity and diversity of audio signals. In this paper, we present UniAudio, a unified audio foundation model toward universal audio generation. UniAudio is built upon a large-scale audio-text dataset and employs a transformer-based architecture with cross-attention mechanisms to align audio and text representations. Our model demonstrates strong generalization capabilities, achieving state-of-the-art performance on several audio generation benchmarks, including text-to-speech, text-to-music, and text-to-sound effect generation. We also explore the potential of UniAudio in creative applications, such as sound design and music composition. The code and models will be released to facilitate further research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
