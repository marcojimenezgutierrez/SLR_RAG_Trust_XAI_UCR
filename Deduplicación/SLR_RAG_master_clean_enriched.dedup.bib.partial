 year = {2024}
}

@article{saha_enhancing_2024,
 abstract = {This paper presents a novel approach for enhancing the robustness of deep neural networks against adversarial attacks. We introduce Adversarial Robustness via Gradient Regularization (ARGR), a training method that incorporates gradient-based regularization terms to penalize large perturbations in the input space. By optimizing the network to maintain stable gradients across a neighborhood of inputs, ARGR effectively reduces the sensitivity to adversarial perturbations without requiring additional adversarial training data. Our theoretical analysis shows that ARGR bounds the Lipschitz constant of the network, providing formal guarantees on robustness. Extensive experiments on benchmark datasets like CIFAR-10 and ImageNet demonstrate that ARGR achieves state-of-the-art robustness while preserving clean accuracy, outperforming existing methods in both white-box and black-box attack scenarios.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
