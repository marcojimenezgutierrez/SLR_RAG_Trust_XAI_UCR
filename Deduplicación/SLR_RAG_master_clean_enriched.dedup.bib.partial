@inproceedings{tian_towards_2025,
 abstract = {This paper presents a novel approach to enhancing user privacy in federated learning systems by integrating differential privacy mechanisms with secure multi-party computation. We propose a framework that allows multiple parties to collaboratively train machine learning models without sharing raw data, while ensuring that individual contributions remain protected against inference attacks. Through extensive experiments on benchmark datasets, we demonstrate that our method achieves comparable model accuracy to traditional federated learning while providing strong privacy guarantees, with minimal computational overhead. Our work addresses key challenges in privacy-preserving machine learning and paves the way for scalable deployment in real-world applications such as healthcare and finance.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
