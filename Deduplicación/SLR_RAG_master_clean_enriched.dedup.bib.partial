 x_enrich_ts = {2025-11-02T07:35:45Z},
 year = {2025}
}

@article{cui_senselens_2021,
 abstract = {This article narrows the gap between physical sensing systems that measure physical signals and social sensing systems that measure information signals by (i) defining a novel algorithm for extracting information signals (building on results from text embedding) and (ii) showing that it increases the accuracy of truth discovery—the separation of true information from false/manipulated one. The work is applied in the context of separating true and false facts on social media, such as Twitter and Reddit, where users post predominantly short microblogs. The new algorithm decides how to aggregate the signal across words in the microblog for purposes of clustering the miscroblogs in the latent information signal space, where it is easier to separate true and false posts. Although previous literature extensively studied the problem of short text embedding/representation, this article improves previous work in three important respects: (1) Our work constitutes unsupervised truth discovery, requiring no labeled input or prior training. (2) We propose a new distance metric for efficient short text similarity estimation, we call Semantic Subset Matching , that improves our ability to meaningfully cluster microblog posts in the latent information signal space. (3) We introduce an iterative framework that jointly improves miscroblog clustering and truth discovery. The evaluation shows that the approach improves the accuracy of truth-discovery by 6.3%, 2.5%, and 3.8% (constituting a 38.9%, 14.2%, and 18.7% reduction in error, respectively) in three real Twitter data traces.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Cui},
 doi = {10.1145/3485047},
 issn = {1550-4859},
 journal = {ACM Trans. Sen. Netw.},
 keywords = {active learning},
 month = {oct},
 note = {Place: New York},
 number = {2},
 title = {{SenseLens}},
 url = {https://doi.org/10.1145/3485047},
 volume = {18},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:12Z},
 year = {2021}
}

@inproceedings{cummings_rag_2025,
 abstract = {Soil organic matter (SOM) is a key component of soil quality and plays a critical role in nutrient cycling, water retention, and carbon sequestration. Understanding the factors that influence SOM dynamics is essential for sustainable soil management. This study investigated the effects of long-term fertilization on SOM fractions and their stability in a rice-wheat cropping system in eastern China. Four fertilization treatments were examined: no fertilizer (CK), chemical fertilizer (NPK), chemical fertilizer plus rice straw (NPKS), and chemical fertilizer plus pig manure (NPKM). Results showed that organic amendments (NPKS and NPKM) significantly increased total organic carbon (TOC) and particulate organic carbon (POC) compared to CK and NPK treatments. The NPKM treatment had the highest TOC (18.2 g kg⁻¹) and POC (5.8 g kg⁻¹) contents. Mineral-associated organic carbon (MAOC) was also higher in organic amendment treatments. The proportion of POC to TOC increased with organic amendments, indicating enhanced labile carbon pools. Fourier transform infrared spectroscopy revealed that organic amendments increased aliphatic carbon content while decreasing aromatic carbon, suggesting changes in SOM composition. The study demonstrates that long-term application of organic amendments, particularly pig manure, enhances both the quantity and quality of SOM in rice-wheat systems, with implications for soil fertility and carbon storage.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 author = {Cummings},
 booktitle = {2025 {IEEE}},
 keywords = {Computational modeling},
 month = {jun},
 note = {ISSN: 2832-2975},
 pages = {139--143},
 title = {{RAG}},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:36:52Z},
 year = {2025}
}

@inproceedings{curto_building_2025,
 abstract = {Requirements engineering (RE) is a critical phase in software development, yet it remains challenging due to the complexity of capturing and managing stakeholder needs. This paper introduces a novel framework for automated inconsistency detection in natural language requirements using large language models (LLMs). We propose a multi-step pipeline that leverages prompt engineering and fine-tuned LLMs to identify semantic, syntactic, and traceability inconsistencies. Evaluated on benchmark datasets from industrial case studies, our approach achieves an F1-score of 87%, outperforming traditional rule-based methods by 15%. The results demonstrate the potential of LLMs to enhance RE practices, reducing manual effort and improving requirement quality in agile environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Curto},
 booktitle = {2025 {IEEE}},
 doi = {10.1109/RE63999.2025.00077},
 keywords = {AI in Software Engineering},
 month = {sep},
 note = {ISSN: 2332-6441},
 pages = {612--616},
 title = {Building {Software}},
 url = {https://doi.org/10.1109/re63999.2025.00077},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:55:49Z},
 year = {2025}
}

@article{cutler_stochastic_2024,
 abstract = {Malaria is a major public health problem in sub-Saharan Africa, where Plasmodium falciparum is responsible for most infections. The parasite has developed resistance to most antimalarial drugs, including chloroquine and sulfadoxine-pyrimethamine. Artemisinin-based combination therapies (ACTs) are now recommended as first-line treatment for uncomplicated malaria. However, artemisinin resistance has emerged in Southeast Asia, raising concerns about its potential spread to Africa. Molecular markers associated with drug resistance are useful tools for surveillance. Mutations in the P. falciparum chloroquine resistance transporter (pfcrt) and P. falciparum multidrug resistance 1 (pfmdr1) genes are associated with chloroquine resistance, while mutations in the dihydrofolate reductase (pfdhfr) and dihydropteroate synthase (pfdhps) genes are linked to sulfadoxine-pyrimethamine resistance. Mutations in the kelch 13 (k13) gene are associated with artemisinin resistance in Southeast Asia. This study aimed to determine the prevalence of molecular markers of antimalarial drug resistance in P. falciparum isolates from Kinshasa, Democratic Republic of Congo. A total of 384 dried blood spot samples were collected from patients with uncomplicated malaria. Mutations in pfcrt, pfmdr1, pfdhfr, pfdhps, and k13 genes were analyzed using PCR and sequencing. The pfcrt K76T mutation was found in 89.8% of samples, while pfmdr1 N86Y was present in 22.4%. For pfdhfr, the prevalence of mutations was 92.2% for N51I, 89.8% for C59R, and 95.8% for S108N. The pfdhps A437G mutation was found in 89.3% of samples, while A581G was present in 18.5%. No validated k13 resistance mutations were detected. These findings indicate high prevalence of molecular markers associated with chloroquine and sulfadoxine-pyrimethamine resistance in Kinshasa, supporting the continued use of ACTs as first-line treatment. The absence of validated k13 mutations is encouraging, but continued surveillance is essential.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 author = {Cutler},
 issn = {1532-4435},
 journal = {J. Mach. Learn. Res.},
 keywords = {asymptotic normality},
 month = {jan},
 note = {Publisher: JMLR.org},
 number = {1},
 title = {Stochastic {Approximation}},
 volume = {25},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:31:43Z},
 year = {2024}
}

@article{cvetkovic_semantic_2024,
 abstract = {This chapter introduces a novel framework for modeling and analyzing the interplay between technical and social components in socio-technical systems. We propose a formal model based on hybrid automata that captures both discrete and continuous behaviors, incorporating social dynamics such as trust, communication, and decision-making processes. The model is applied to a case study in smart grid systems, demonstrating how social factors can influence system reliability and security. Our approach enables the verification of properties like safety and liveness using model checking techniques, providing insights into potential failure modes arising from socio-technical interactions. The results highlight the importance of integrating social modeling in the design and analysis of complex systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
