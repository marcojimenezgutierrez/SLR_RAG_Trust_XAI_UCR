 pages = {482--486},
 publisher = {Association for Computing Machinery},
 series = {{FSE}},
 title = {The {Lion}},
 url = {https://doi.org/10.1145/3663529.3663782},
 x_enrich_source = {x-ai/grok-4-fast},
