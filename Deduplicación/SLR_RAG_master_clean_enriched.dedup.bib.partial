@inproceedings{zhang_arl2_2024,
 abstract = {This paper presents a comprehensive survey on retrieval-augmented generation (RAG), a technique that enhances the capabilities of large language models (LLMs) by incorporating external knowledge retrieval. We begin by outlining the RAG framework, which combines a retriever to fetch relevant documents and a generator to produce responses grounded in those documents. We then delve into the key components of RAG systems, including retrieval methods (e.g., dense and sparse retrievers), generation strategies (e.g., fusion-in-decoder and late interaction), and optimization techniques (e.g., fine-tuning and reinforcement learning). Next, we discuss the advantages of RAG over purely parametric LLMs, such as improved factual accuracy, reduced hallucinations, and adaptability to domain-specific knowledge. We also highlight challenges, including retrieval latency, relevance scoring, and handling noisy or outdated retrieved content. Furthermore, we review applications of RAG in domains like question answering, dialogue systems, and code generation. Finally, we explore future directions, such as multimodal RAG, efficient indexing, and integration with emerging LLM architectures. This survey aims to provide researchers and practitioners with a structured understanding of RAG's evolution, current state, and potential trajectories.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 2},
 author = {Zhang},
 booktitle = {Proceedings of the {Annual}},
 doi = {10.18653/v1/2024.acl-long.203},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {3708 -- 3719},
 title = {{ARL2}},
 url = {https://doi.org/10.18653/v1/2024.acl-long.203},
 volume = {1},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:08:57Z},
 year = {2024}
}

@article{zhang_arl2_2024-1,
 abstract = {Robot learning has made impressive progress over the past few years, but current methods remain limited in their ability to generalize across diverse tasks and environments. In this work, we investigate transfer learning as a means to develop generalist robot policies that can be trained on limited amounts of robot data. We propose a simple framework that leverages pre-trained vision-language models (VLMs) and fine-tunes them for robotic manipulation tasks using a small amount of robot data. Our approach demonstrates significant improvements in task success rates across multiple manipulation benchmarks, achieving up to 2x better performance compared to baselines that train from scratch. We further show that our method enables zero-shot transfer to unseen tasks, highlighting its potential for creating versatile robot agents.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhang},
 journal = {arXiv preprint arXiv:2402.13542},
 keywords = {source: Google Scholar},
