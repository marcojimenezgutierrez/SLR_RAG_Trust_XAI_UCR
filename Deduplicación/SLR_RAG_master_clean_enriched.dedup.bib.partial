 volume = {14},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:02:25Z},
 year = {2024}
}

@inproceedings{caglayan_structured_2025,
 abstract = {Recent advances in artificial intelligence have led to the development of large language models (LLMs) capable of generating human-like text. However, these models often produce outputs that may contain biases, inaccuracies, or harmful content. This paper proposes a novel framework for enhancing the safety and reliability of LLMs through a multi-stage filtering and verification pipeline. Our approach integrates content moderation techniques, fact-checking mechanisms, and ethical alignment modules to mitigate risks associated with generated text. Experimental results on benchmark datasets demonstrate significant improvements in output quality, reducing harmful content by up to 85% while preserving fluency and coherence. The framework is designed to be modular, allowing easy integration into existing LLM architectures.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Çağlayan},
