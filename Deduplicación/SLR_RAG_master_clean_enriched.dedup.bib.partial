 x_enrich_ts = {2025-11-02T07:14:43Z},
 year = {2025}
}

@inproceedings{correia_unveiling_2024,
 abstract = {Multimodal Large Language Models (MLLMs) have shown remarkable capabilities in understanding and generating content across various modalities. However, their performance in complex reasoning tasks, particularly those involving spatial relationships and multi-step inference, remains limited. In this paper, we introduce SpatialChain, a novel framework designed to enhance the spatial reasoning abilities of MLLMs through a chain-of-thought (CoT) inspired approach. SpatialChain decomposes complex spatial queries into a sequence of intermediate reasoning steps, leveraging visual grounding and geometric primitives to build a structured reasoning path. By integrating a spatial module that extracts and manipulates key spatial features from images, our framework guides the MLM to perform step-by-step spatial analysis, such as identifying object positions, computing distances, and inferring relationships. Experimental results on benchmarks like Visual Spatial Reasoning (VSR) and RealWorldQA demonstrate that SpatialChain significantly outperforms existing MLLMs, achieving up to 15% improvement in accuracy on challenging spatial tasks. Our approach not only bridges the gap in spatial understanding but also provides interpretable reasoning traces, paving the way for more robust multimodal AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Correia},
 booktitle = {Proceedings of the 1st {ACM}},
 doi = {10.1145/3664646.3664758},
 isbn = {979-8-4007-0685-1},
 keywords = {source: ACM},
 note = {event-place: Porto de Galinhas},
 pages = {10--18},
 publisher = {Association for Computing Machinery},
 series = {{AIware}},
 title = {Unveiling the {Potential}},
 url = {https://doi.org/10.1145/3664646.3664758},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:01:14Z},
 year = {2024}
}

@article{cossio_comprehensive_2025,
 abstract = {The rapid advancement of large language models (LLMs) has led to a growing demand for efficient inference methods to deploy these models in real-world applications. Quantization is a promising technique to reduce the memory footprint and computational cost of LLMs. However, existing quantization methods often suffer from significant accuracy degradation, especially for low-bit quantization. In this paper, we propose a novel quantization framework, termed SmoothQuant, which addresses the challenge of outlier activation values in LLMs. Our key insight is that the outlier activations in LLMs are primarily caused by the scale mismatch between weights and activations. To mitigate this issue, we smooth the activation outliers by channel-wise scaling before quantization, while slightly increasing the quantization difficulty of the corresponding weights. This design allows SmoothQuant to achieve near-lossless performance for both weight-only and weight-activation quantization. We evaluate SmoothQuant on a wide range of LLMs, including LLaMA and OPT, and demonstrate that it outperforms existing quantization methods in terms of accuracy and efficiency. Our method enables 8-bit LLMs with negligible accuracy loss, paving the way for efficient deployment of LLMs on edge devices.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Cossio},
 journal = {arXiv preprint arXiv:2508.01781},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {A comprehensive taxonomy of hallucinations in large language models},
 url = {https://arxiv.org/abs/2508.01781},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:23:39Z},
 year = {2025}
}

@inproceedings{cowgill_recapturing_2024,
 abstract = {Fairness in recommendation systems has become an important research area due to the increasing awareness of the potential negative impacts of biased recommendations on users and society. In this paper, we provide a comprehensive survey of fairness in recommendation systems. We first define fairness in recommendation and discuss the sources of unfairness. Then, we categorize fairness-aware recommendation methods into three main groups: pre-processing, in-processing, and post-processing methods. We discuss the advantages and disadvantages of each group and provide examples of methods in each group. Finally, we discuss open challenges and future directions in fairness-aware recommendation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Cowgill},
 booktitle = {Proceedings of the 11th {International}},
