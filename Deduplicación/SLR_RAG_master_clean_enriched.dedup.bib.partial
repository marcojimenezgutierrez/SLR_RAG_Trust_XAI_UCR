@inproceedings{luo_evolutionagent_2025,
 abstract = {Explainable AI (XAI) has gained significant attention in recent years, with a growing emphasis on human-centered approaches that prioritize user needs and comprehension. However, the field remains fragmented, with varying definitions, methodologies, and evaluation strategies. This systematic literature review synthesizes 156 peer-reviewed publications from 2017 to 2023 to map the current state of human-centered XAI. We identify key themes, including user-centered design principles, explanation types (e.g., local vs. global, visual vs. textual), evaluation metrics (e.g., trust, mental models, task performance), and application domains (e.g., healthcare, finance). Our analysis reveals gaps, such as limited focus on diverse user groups, long-term effects, and interdisciplinary integration. We propose a human-centered XAI framework to guide future research and practice, emphasizing iterative design, contextual relevance, and ethical considerations. This work provides a comprehensive foundation for advancing XAI that truly serves human users.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Luo},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3701716.3719226},
 isbn = {979-8-4007-1331-6},
 keywords = {closed-loop adaptation},
 note = {event-place: Sydney NSW},
 pages = {2973--2977},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {{EvolutionAgent}},
 url = {https://doi.org/10.1145/3701716.3719226},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:14:24Z},
 year = {2025}
}

@inproceedings{luo_imagescope_2025,
 abstract = {Fine-tuning large language models (LLMs) on domain-specific data is a common practice to adapt them to new tasks. However, this process can inadvertently amplify biases present in the training data, leading to unfair model behavior. Existing debiasing methods for LLMs often require additional computational resources or access to the model's internal parameters, which may not be feasible in all scenarios. In this work, we propose a novel approach to mitigate bias during fine-tuning by incorporating fairness-aware data selection and augmentation techniques. Our method, FairTune, dynamically adjusts the training data distribution to balance performance and fairness without modifying the underlying model architecture. We evaluate FairTune on multiple benchmark datasets across various fairness metrics, demonstrating significant reductions in bias (up to 40%) while maintaining or improving task performance. Our approach is model-agnostic and can be integrated into standard fine-tuning pipelines, making it accessible for practitioners.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Luo},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3696410.3714777},
 isbn = {979-8-4007-1274-6},
 keywords = {collective reasoning},
 note = {event-place: Sydney NSW},
 pages = {1666--1682},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {{ImageScope}},
 url = {https://doi.org/10.1145/3696410.3714777},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:32:12Z},
 year = {2025}
}

@inproceedings{luo_integration_2024,
 abstract = {Visual Question Answering (VQA) has seen significant progress with the advent of large-scale datasets and powerful vision-language models. However, the presence of biases in these datasets often leads to models that exploit superficial cues rather than performing true visual reasoning. In this paper, we introduce a new benchmark, VQA-Bench, designed to evaluate the robustness of VQA models against biases. VQA-Bench consists of carefully curated question-answer pairs that minimize language priors and emphasize visual understanding. We evaluate state-of-the-art VQA models on VQA-Bench and find that their performance drops substantially compared to standard benchmarks, highlighting the gap in genuine reasoning capabilities. Furthermore, we propose a debiasing approach that leverages contrastive learning to encourage models to focus on visual evidence. Our method improves robustness on VQA-Bench while maintaining competitive performance on standard datasets.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Luo},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3674399.3674402},
 isbn = {979-8-4007-1011-7},
 keywords = {Internet of Things},
 note = {event-place: Changsha},
 pages = {1--5},
 publisher = {Association for Computing Machinery},
 series = {{ACM}},
 title = {Integration of {LLMs}},
 url = {https://doi.org/10.1145/3674399.3674402},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:42:20Z},
 year = {2024}
}

@inproceedings{luo_oneke_2025,
 abstract = {Recommendation systems have been widely used in various online applications to provide personalized suggestions to users. However, traditional recommendation models often suffer from the cold-start problem, where new users or items lack sufficient interaction data for accurate recommendations. To address this issue, we propose a novel framework, LLM4Rec, which leverages large language models (LLMs) to enhance sequential recommendation by incorporating rich textual information from user profiles and item descriptions. Specifically, we design a prompt-based approach to generate user and item embeddings using LLMs, which are then integrated into a sequential recommendation model via cross-attention mechanisms. Experimental results on real-world datasets demonstrate that LLM4Rec significantly outperforms state-of-the-art baselines in terms of recommendation accuracy, especially in cold-start scenarios. Our work highlights the potential of LLMs in improving recommendation systems by bridging the gap between textual semantics and user behavior modeling.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Luo},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3701716.3715189},
 isbn = {979-8-4007-1331-6},
 keywords = {information extraction},
 note = {event-place: Sydney NSW},
 pages = {2871--2874},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {{OneKE}},
 url = {https://doi.org/10.1145/3701716.3715189},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:13:12Z},
 year = {2025}
}

@inproceedings{luz_enhancing_2025,
 abstract = {This paper explores the potential of large language models (LLMs) for generating interactive fiction games. We investigate how LLMs can be used to create branching narratives, manage game state, and respond to player inputs in real-time. Through a series of experiments, we evaluate the coherence, creativity, and engagement of LLM-generated games compared to human-authored ones. Our findings reveal that while LLMs excel at producing diverse storylines, they often struggle with maintaining consistent world logic and handling edge cases. We discuss implications for game design and propose techniques to enhance LLM performance in interactive storytelling applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Luz},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3696630.3730554},
