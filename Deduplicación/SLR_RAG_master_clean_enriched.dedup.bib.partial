 year = {2024}
}

@inproceedings{yadav_enhancing_2024,
 abstract = {The rapid growth of electric vehicles (EVs) has led to the development of various charging infrastructures. However, the integration of EVs into the power grid poses significant challenges, including grid stability and efficient energy management. This paper proposes a novel smart charging strategy for EV charging stations using machine learning techniques to optimize charging schedules and minimize grid impact. The proposed system employs a deep reinforcement learning (DRL) algorithm to dynamically adjust charging rates based on real-time grid conditions, EV battery states, and user preferences. Simulation results demonstrate that the proposed method reduces peak load by up to 25% and improves overall system efficiency compared to traditional charging approaches.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
