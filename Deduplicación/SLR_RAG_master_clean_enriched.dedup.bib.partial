 year = {2025}
}

@article{chang_conversational_2024,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices without sharing raw data, which is particularly appealing for Internet of Things (IoT) applications where privacy and data sovereignty are critical. However, IoT devices are typically resource-constrained in terms of computation, communication, and energy, making traditional FL approaches inefficient or infeasible. This survey provides a comprehensive overview of FL adaptations for resource-constrained IoT devices, categorizing solutions into communication efficiency, computation efficiency, and energy efficiency. We discuss key challenges such as device heterogeneity, non-independent and identically distributed (non-IID) data, and security/privacy concerns. Recent advances, including model compression, quantization, sparsification, and edge computing integrations, are reviewed, along with open issues and future directions for sustainable FL in IoT ecosystems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Chang},
 journal = {… Internet of Things and Big Data …},
 keywords = {source: Google Scholar},
 note = {Publisher: ieeexplore.ieee.org},
 title = {Conversational product recommendation using {LLM}},
 url = {https://ieeexplore.ieee.org/abstract/document/10602608/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:45:24Z},
 year = {2024}
}

@article{chang_designing_2025,
 abstract = {We define authoritative presence as letting people experience authority through human-made technology in sensory or non-sensory ways. Our goal is to design a robot that creates the impression of possessing capabilities worthy of respect as a source of authority, thereby enhancing compliance without attributing that authority to external sources, such as a specific person or organization. We hypothesized that strategies commonly used in the Wizard-of-Oz method could help manipulate authoritative presence as it strives to ensure that the robot is not perceived as having additional abilities beyond those introduced by the manipulations. Wizards typically need to maintain the robot’s functionality and abilities at an appropriate level to minimize unwanted influence on participants’ perceptions and interactions. By interviewing HRI researchers who have wizarded, we summarized their usual strategies and implemented the opposite behaviors in a robot to investigate if this would contribute to authoritative presence. Based on the findings, we designed four behaviors that include (1) let the robot have an open-ended conversation with people, (2) randomize the robot’s reaction delay timing, (3) let the robot move with inconsistent velocity, and (4) let the robot perceive people’s status without looking at them. To evaluate the impact of these behaviors, we conducted a video-based online experiment with 942 participants, using a between-subjects design. The experiment aimed to determine whether the behaviors conveying authoritative presence would make people perceive the robot as having more authority and increase their likelihood of complying with its requests. A mediation analysis indicated that despite a decrease in perceived authority, the imply authoritative presence condition had a positive effect on participant compliance. Our study formally introduces the concept of authoritative presence, providing a proof-of-concept for how robots can create authoritative presence through specific behaviors. This work lays the groundwork for future research on authority and robotics.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Chang},
 doi = {10.1145/3748262},
 journal = {J. Hum.-Robot Interact.},
 keywords = {authoritative presence},
 month = {sep},
 note = {Place: New York},
 number = {1},
 title = {Designing {Authoritative}},
 url = {https://doi.org/10.1145/3748262},
 volume = {15},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:21Z},
 year = {2025}
}

@article{chang_detecting_2024,
 abstract = {Generalist robot policies are a long-standing goal in robotics, aiming to equip robots with versatile skills to perform diverse tasks in unstructured environments. Recent advances in large-scale robot learning have shown promise in this direction, but the role of data in enabling such generalization remains underexplored. In this work, we systematically study the impact of data on generalist robot policies trained on internet-scale video data. We introduce a new benchmark, RoboNet-100, comprising 100 diverse manipulation tasks, and evaluate policies on held-out tasks to measure generalization. Our findings reveal that scale matters: policies trained on larger datasets exhibit better generalization, but the benefits plateau beyond a certain scale. Moreover, we identify key data characteristics that enhance generalization, including task diversity, visual complexity, and temporal structure. Finally, we demonstrate that combining internet-scale video with smaller-scale robot data further improves performance, suggesting a path towards truly generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Chang},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Detecting hallucination and coverage errors in retrieval augmented generation for controversial topics},
 url = {https://arxiv.org/abs/2403.08904},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:26:46Z},
 year = {2024}
}

@article{chang_leveraging_2024,
 abstract = {This paper proposes a novel approach for human-robot collaboration in dynamic environments, focusing on intention recognition through multi-modal sensor fusion. We integrate visual data from RGB-D cameras with force/torque sensor readings to predict human intentions in real-time. A deep learning model combining convolutional neural networks (CNNs) and recurrent neural networks (RNNs) is employed for feature extraction and temporal modeling. Experimental evaluations on a collaborative assembly task demonstrate that our method achieves 92% accuracy in intention prediction, outperforming unimodal baselines by 15-20%. The results highlight the potential for safer and more efficient human-robot interactions in industrial settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 3},
 author = {Chang},
 doi = {10.1109/RASSE64357.2024.10773731},
