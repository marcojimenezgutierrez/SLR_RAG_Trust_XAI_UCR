 year = {2025}
}

@article{zou_weak--strong_2025,
 abstract = {Robot learning has made remarkable progress in recent years, particularly in simulation environments. However, transferring these policies to the real world remains a significant challenge. One key bottleneck is the representation learning process, which is crucial for generalization across diverse tasks and environments. In this work, we conduct a comprehensive study on the factors that influence representation learning for generalist robot policies. We evaluate a variety of representation learning approaches, including self-supervised learning, contrastive learning, and masked autoencoders, on robotic manipulation tasks in simulation. Our findings reveal that the choice of data augmentation, the scale of pre-training data, and the architecture of the encoder play pivotal roles in achieving robust representations. Furthermore, we demonstrate that representations learned from large-scale video datasets can significantly improve downstream policy performance, even when fine-tuned on smaller robotic datasets. These insights provide practical guidelines for developing more capable and generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
