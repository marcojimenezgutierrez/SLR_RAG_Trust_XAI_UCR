 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:55:51Z},
 year = {2024}
}

@inproceedings{li_rag-ddr_2025,
 abstract = {This study investigates the effects of climate change on coastal ecosystems in the Mediterranean region. Using a combination of satellite imagery and ground-based surveys, we analyzed changes in biodiversity and habitat loss over the past two decades. Our findings indicate a significant decline in seagrass meadows and coral populations, attributed to rising sea temperatures and ocean acidification. The results underscore the urgent need for adaptive management strategies to mitigate these impacts and preserve marine biodiversity.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Li},
 keywords = {source: Scopus},
