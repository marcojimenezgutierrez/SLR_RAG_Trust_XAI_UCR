@inproceedings{malandri_re-fin_2025,
 abstract = {This study investigates the effects of climate change on agricultural productivity in sub-Saharan Africa, using panel data from 1990 to 2020 across 45 countries. Employing a fixed-effects regression model, we find that rising temperatures and erratic rainfall patterns significantly reduce crop yields, with maize and sorghum being most affected. Adaptation strategies, such as improved irrigation and drought-resistant varieties, mitigate losses by up to 25%. Policy recommendations include increased investment in climate-resilient agriculture to enhance food security.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
