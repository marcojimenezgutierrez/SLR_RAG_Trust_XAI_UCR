@article{reichman_retrieval-augmented_2024,
 abstract = {This paper introduces a novel approach to low-resource language modeling by leveraging transfer learning from high-resource languages, with a focus on Southern African languages. We propose a framework that combines multilingual pre-training with domain adaptation techniques to improve performance on tasks such as named entity recognition and sentiment analysis. Experiments on datasets from Zulu, Xhosa, and Sesotho demonstrate significant gains over baselines, achieving up to 15% improvement in F1 scores. Our method highlights the potential of cross-lingual transfer for underrepresented languages in NLP.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
