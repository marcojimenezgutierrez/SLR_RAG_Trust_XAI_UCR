 title = {{XRAG}},
 url = {https://arxiv.org/abs/2505.10089},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:27:47Z},
 year = {2025}
}

@inproceedings{lo_ai_2025,
 abstract = {In this paper, we introduce a novel approach for few-shot learning in computer vision tasks, leveraging meta-learning techniques to adapt quickly to new classes with limited examples. Our method combines prototypical networks with attention mechanisms to enhance feature representation and generalization. Extensive experiments on miniImageNet and tieredImageNet datasets demonstrate that our approach outperforms state-of-the-art methods by achieving higher accuracy with fewer shots. We also explore applications in real-world scenarios, such as medical image classification, showing promising results for data-scarce domains.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
