@inproceedings{sarnikar_using_2025,
 abstract = {Abstract—In this paper, we propose a novel hybrid encryption scheme combining elliptic curve cryptography (ECC) and chaotic maps for enhancing security in wireless sensor networks (WSNs). The proposed approach addresses key challenges such as computational overhead, key management, and resistance to common attacks like man-in-the-middle and replay attacks. Simulation results demonstrate that our scheme achieves a 25% reduction in energy consumption compared to traditional AES-based methods while maintaining high security levels, making it suitable for resource-constrained IoT environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
