@inproceedings{juan_co-trained_2025,
 abstract = {Data visualization is a powerful tool for exploring and communicating insights from complex datasets. However, creating effective visualizations often requires expertise in both data analysis and graphic design, which can be a barrier for non-experts. Visual programming languages (VPLs) offer a promising approach to democratize visualization creation by allowing users to build visualizations through direct manipulation of visual elements. Despite their potential, the design space of VPLs for data visualization remains underexplored, particularly in terms of supporting interactive visualizations.

In this paper, we explore the design space of VPLs for interactive data visualization. We first conduct a systematic review of existing VPLs to identify key design dimensions, including representation of data, operations, and interactivity. Based on this analysis, we propose a framework for designing VPLs that balances expressiveness, usability, and learnability. We then present VisFlow, a novel VPL that implements our framework, enabling users to create interactive visualizations through a node-based interface that supports data transformation, visualization construction, and interactivity specification.

To evaluate VisFlow, we conducted a user study with 24 participants, comparing it to a traditional text-based programming environment (Python with Matplotlib and Plotly). Our results show that VisFlow significantly reduces task completion time and error rates while increasing user satisfaction, particularly for users with limited programming experience. We also identify opportunities for future work, such as integrating AI-assisted design suggestions and supporting collaborative visualization creation.

Our contributions include: (1) a comprehensive design framework for VPLs in data visualization, (2) the implementation of VisFlow as a proof-of-concept tool, and (3) empirical evidence of the benefits of visual programming for interactive visualization tasks. This work advances the field of human-computer interaction by making data visualization more accessible and empowering a broader range of users to create meaningful interactive visualizations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Juan},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3701716.3715524},
 isbn = {979-8-4007-1331-6},
 keywords = {earnings calls},
 note = {event-place: Sydney NSW},
 pages = {1048--1052},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {Co-{Trained}},
 url = {https://doi.org/10.1145/3701716.3715524},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:08:22Z},
 year = {2025}
}

@size=5).we open-source this toolkit enabling reproducible optimization of chunking strategies through automated synthetic dataset generation and multi-metric analysis pipelines. this work bridges critical gaps between generic rag architectures and enterprise requirements for precision-sensitive domains. our code is available on https://github.com/aryan-jadon/synthetic-data-generation-and-evaluation-using-reasoning-models.},
  month ={jul},
 abstract = {Obesity is associated with chronic low-grade inflammation and metabolic dysfunction. Adipose tissue macrophages (ATMs) are key mediators of obesity-induced inflammation and insulin resistance. Here we show that ATMs from obese mice and humans are characterized by increased expression of CD9, a member of the tetraspanin family. CD9 expression in ATMs is induced by saturated fatty acids through a mechanism involving toll-like receptor 4 (TLR4) and nuclear factor-κB (NF-κB). CD9 deficiency in myeloid cells protects mice from diet-induced obesity, insulin resistance, and adipose tissue inflammation. Mechanistically, CD9 promotes M1 macrophage polarization and enhances inflammatory responses to saturated fatty acids by facilitating TLR4 signaling. CD9 interacts with TLR4 and promotes TLR4 clustering and downstream signaling. These findings identify CD9 as a novel regulator of ATM function and suggest that targeting CD9 may represent a therapeutic strategy for obesity-related metabolic disorders.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:04:21Z}
}

@article{jung_intelligent_2025,
 abstract = {This study designed and empirically evaluated a method to enhance information accessibility for museum and art gallery visitors using a small Large Language Model (sLLM) based on the Retrieval-Augmented Generation (RAG) framework. Over 199,000 exhibition descriptions were collected and refined, and a question-answering dataset consisting of 102,000 pairs reflecting user personas was constructed to develop DocentGemma, a domain-optimized language model. This model was fine-tuned through Low-Rank Adaptation (LoRA) based on Google’s Gemma2-9B and integrated with FAISS and OpenSearch-based document retrieval systems within the LangChain framework. Performance evaluation was conducted using a dedicated Q&A benchmark for the docent domain, comparing the model against five commercial and open-source LLMs (including GPT-3.5 Turbo, LLaMA3.3-70B, and Gemma2-9B). DocentGemma achieved an accuracy of 85.55% and a perplexity of 3.78, demonstrating competitive performance in language generation and response accuracy within the domain-specific context. To enhance retrieval relevance, a Spatio-Contextual Retriever (SC-Retriever) was introduced, which combines semantic similarity and spatial proximity based on the user’s query and location. An ablation study confirmed that integrating both modalities improved retrieval quality, with the SC-Retriever achieving a recall@1 of 53.45% and a Mean Reciprocal Rank (MRR) of 68.12, representing a 17.5 20% gain in search accuracy compared to baseline models such as GTE and SpatialNN. System performance was further validated through field deployment at three major exhibition venues in Seoul (the Seoul History Museum, the Hwan-ki Museum, and the Hanseong Baekje Museum). A user test involving 110 participants indicated high response credibility and an average satisfaction score of 4.24. To ensure accessibility, the system supports various output formats, including multilingual speech and subtitles. This work illustrates a practical application of integrating LLM-based conversational capabilities into traditional docent services and suggests potential for further development toward location-aware interactive systems and AI-driven cultural content services.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Jung},
 doi = {10.3390/app15179398},
 journal = {Applied Sciences (Switzerland)},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {17},
 title = {An {Intelligent}},
 url = {https://doi.org/10.3390/app15179398},
 volume = {15},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:34:29Z},
 year = {2025}
}

@misc{junior_br-taxqa-r_2025,
 abstract = {This paper presents BR-TaxQA-R, a novel dataset designed to support question answering with references in the context of Brazilian personal income tax law. The dataset contains 715 questions from the 2024 official Q\&A document published by Brazil's Internal Revenue Service, enriched with statutory norms and administrative rulings from the Conselho Administrativo de Recursos Fiscais (CARF). We implement a Retrieval-Augmented Generation (RAG) pipeline using OpenAI embeddings for searching and GPT-4o-mini for answer generation. We compare different text segmentation strategies and benchmark our system against commercial tools such as ChatGPT and Perplexity.ai using RAGAS-based metrics. Results show that our custom RAG pipeline outperforms commercial systems in Response Relevancy, indicating stronger alignment with user queries, while commercial models achieve higher scores in Factual Correctness and fluency. These findings highlight a trade-off between legally grounded generation and linguistic fluency. Crucially, we argue that human expert evaluation remains essential to ensure the legal validity of AI-generated answers in high-stakes domains such as taxation. BR-TaxQA-R is publicly available at https://huggingface.co/datasets/unicamp-dl/BR-TaxQA-R.},
 abstract_lang = {en},
 abstract_source = {doi-json},
 author = {Júnior},
 doi = {10.48550/arXiv.2505.15916},
 file = {Preprint PDF:C\:\\Users\\Marco\\Zotero\\storage\\5K5YQE28\\Júnior et al. - 2025 - BR-TaxQA-R A Dataset for Question Answering with References for Brazilian Personal Income Tax Law},
 keywords = {source: Arxiv},
 month = {may},
 note = {arXiv:2505.15916 [cs]},
 publisher = {arXiv},
 shorttitle = {{BR}},
 title = {{BR}},
 url = {https://doi.org/10.48550/arxiv.2505.15916},
 urldate = {2025-10-26},
