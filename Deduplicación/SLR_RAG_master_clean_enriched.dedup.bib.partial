 pages = {369--379},
 publisher = {Association for Computing Machinery},
 series = {{ICTIR}},
 title = {Evaluating {List}},
 url = {https://doi.org/10.1145/3731120.3744606},
 x_enrich_source = {x-ai/grok-4-fast},
