 title = {Enhancing {LLM}},
 url = {https://doi.org/10.1007/s13755-025-00379-x},
 volume = {13},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:31:26Z},
 year = {2025}
}

@article{wang_evaluating_2024,
 abstract = {Learning generalist robot policies that can perform a variety of tasks in unstructured environments is a long-standing challenge in robotics. While large language models (LLMs) have shown remarkable generalization capabilities in language tasks, adapting them to robotics remains challenging due to the high-dimensional, continuous nature of robot actions and the need for real-world interaction. In this work, we propose a framework for learning generalist robot policies by leveraging the generalization abilities of LLMs through a process we call "semantic imagination." Our approach involves generating imagined semantic trajectories using an LLM conditioned on task descriptions, which are then used to train a robot policy via imitation learning. We evaluate our method on a diverse set of manipulation tasks and demonstrate that semantically imagined data enables zero-shot generalization to novel tasks and environments, outperforming baselines trained on real demonstrations. Our results highlight the potential of LLMs to unlock generalist capabilities in robotics through imagined experiences.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
