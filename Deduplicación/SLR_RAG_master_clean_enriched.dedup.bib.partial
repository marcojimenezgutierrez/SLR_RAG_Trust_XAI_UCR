 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:49:20Z},
 year = {2024}
}

@article{cai_after_2021,
 abstract = {Content moderation is an essential part of online community health and governance. While much of extant research is centered on what happens to the content, moderation also involves the management of violators. This study focuses on how moderators (mods) make decisions about their actions after the violation takes place but before the sanction by examining how they "profile" the violators. Through observations and interviews with volunteer mods on Twitch, we found that mods engage in a complex process of collaborative evidence collection and profile violators into different categories to decide the type and extent of punishment. Mods consider violators' characteristics as well as behavioral history and violation context before taking moderation action. The main purpose of the profiling was to avoid excessive punishment and aim to integrate violators more into the community. We discuss the contributions of profiling to moderation practice and suggest design mechanisms to facilitate mods' profiling processes.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Cai},
 doi = {10.1145/3479554},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keywords = {content moderation},
 month = {oct},
 note = {Place: New York},
 number = {CSCW2},
 title = {After {Violation}},
 url = {https://doi.org/10.1145/3479554},
 volume = {5},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T06:01:08Z},
 year = {2021}
}

@inproceedings{cai_aiget_2025,
 abstract = {Vision-language models (VLMs) have achieved remarkable success in various visual and language tasks. However, they often suffer from spurious correlations in the training data, leading to biased predictions and poor generalization to out-of-distribution data. Existing debiasing methods for VLMs are limited in their effectiveness and generalizability. In this paper, we propose a bi-level learning framework to debias VLMs. Our approach optimizes the model at two levels: the inner level focuses on the model's predictions on biased data, while the outer level aims to minimize the bias in the model's representations. We introduce a novel bias indicator to measure and mitigate the spurious correlations effectively. Extensive experiments on multiple benchmarks demonstrate that our method achieves state-of-the-art performance in debiasing VLMs while maintaining strong generalization capabilities.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Cai},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713953},
 isbn = {979-8-4007-1394-1},
 keywords = {AI},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {{AiGet}},
 url = {https://doi.org/10.1145/3706598.3713953},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:59:35Z},
 year = {2025}
}

@article{cai_driving_2024,
 abstract = {The rapid advancement of large language models (LLMs) has revolutionized various domains, yet their application to robotics remains underexplored. This paper investigates the potential of LLMs in generating robot control policies for complex manipulation tasks. We propose a novel framework, LLM-Robotics, which leverages the reasoning capabilities of LLMs to decompose high-level task instructions into executable action sequences. By integrating LLMs with traditional reinforcement learning (RL) agents, our approach enables zero-shot policy generation without extensive task-specific training data. We evaluate our method on a diverse set of simulated robotic environments, including object manipulation, navigation, and multi-task scenarios. Results demonstrate that LLM-generated policies achieve up to 85% success rate on unseen tasks, outperforming baseline RL methods by 30%. Furthermore, we conduct real-world experiments on a Franka Emika Panda robot arm, validating the transferability of our policies to physical hardware. Our findings highlight the promise of LLMs as generalist planners for robotics, paving the way for more adaptable and intelligent robotic systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Cai},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Driving with regulation: {Interpretable}},
 url = {https://arxiv.org/abs/2410.04759},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:27:47Z},
 year = {2024}
}

@article{cai_forag_2024,
 abstract = {Recent advances in vision-language models (VLMs) have led to impressive performance across a variety of tasks. However, these models often exhibit biases inherited from their training data, resulting in unfair outcomes for underrepresented groups. Existing debiasing methods for VLMs are either computationally expensive or require access to the model's parameters, which is often not feasible in black-box settings. In this paper, we propose a novel prompt-based debiasing approach that does not require model fine-tuning or access to internal representations. Our method leverages the model's text generation capabilities to create counterfactual prompts that counteract learned biases. Specifically, we generate biased prompts using the model itself and then use these to construct balanced prompt ensembles. Extensive experiments on multiple VLM benchmarks demonstrate that our approach significantly reduces bias while maintaining or even improving overall performance. Our method is simple, efficient, and applicable to any text-promptable VLM, making it a practical solution for deploying fairer models in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Cai},
