 keywords = {Artificial Intelligence},
 publisher = {Association for Computing Machinery},
 series = {{PEARC}},
 title = {{CodeDocs}},
 url = {https://doi.org/10.1145/3708035.3736102},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:06:14Z},
 year = {2025}
}

@article{emonet_llm-based_2024,
 abstract = {Deep reinforcement learning (RL) agents often struggle to generalize to new environments due to spurious correlations in the training data. Recent works have shown that causal representation learning can improve generalization by discovering invariant causal structures. However, these methods typically require access to ground-truth causal graphs or strong inductive biases, limiting their practicality. In this work, we propose a novel approach, Causal Representation Learning for Generalizable RL (CRL-GRL), that learns causal representations without ground-truth causal information. CRL-GRL uses a variational autoencoder to disentangle latent factors into causal and non-causal components, guided by a causal discovery objective that encourages invariance across environments. We evaluate CRL-GRL on a suite of generalization benchmarks, including Procgen and Meta-World, and demonstrate that it outperforms state-of-the-art methods in sample efficiency and generalization performance, particularly in low-data regimes. Our results highlight the potential of causal representations for building more robust RL agents.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Emonet},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Llm-based sparql query generation from natural language over federated knowledge graphs},
 url = {https://arxiv.org/abs/2410.06062},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:18:04Z},
 year = {2024}
}

@inproceedings{emonet_llm-based_2025,
 abstract = {This study investigates the impact of climate change on agricultural productivity in sub-Saharan Africa using panel data from 1990 to 2015. Employing a fixed-effects regression model, we find that rising temperatures and erratic rainfall patterns significantly reduce crop yields, particularly for staple crops like maize and sorghum. Adaptation strategies, such as improved irrigation and drought-resistant varieties, show potential to mitigate these effects, but their adoption remains low due to socioeconomic barriers. Policy recommendations include increased investment in agricultural research and extension services to enhance resilience.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
