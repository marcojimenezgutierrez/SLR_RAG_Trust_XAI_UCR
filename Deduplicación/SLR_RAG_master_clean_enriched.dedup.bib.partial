 x_enrich_ts = {2025-11-02T10:21:47Z},
 year = {2025}
}

@article{galitsky_enhancing_2025,
 abstract = {We present a novel approach to dialogue act recognition in conversational AI systems, focusing on the integration of semantic role labeling (SRL) and discourse relation parsing to enhance the understanding of speaker intentions. Our method leverages a transformer-based model fine-tuned on a combination of dialogue corpora, including Switchboard and AMI Meeting Corpus, achieving a 5.2% improvement in F1-score over baseline models. We evaluate the approach on real-world customer support dialogues, demonstrating robustness to noisy inputs and domain shifts. The proposed framework also incorporates uncertainty estimation via Bayesian neural networks, enabling more reliable deployment in interactive applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
