@article{zelin_rare_2024,
 abstract = {Multimodal data fusion has gained significant attention in recent years due to its ability to integrate complementary information from multiple sources, leading to improved performance in various tasks such as classification, detection, and segmentation. Deep learning techniques have revolutionized multimodal data fusion by enabling automatic feature extraction and learning complex interactions between modalities. This survey provides a comprehensive overview of deep learning methods for multimodal data fusion, categorizing them based on fusion strategies (early, late, and hybrid fusion), architectures (e.g., convolutional neural networks, transformers, and graph neural networks), and application domains (e.g., healthcare, autonomous driving, and remote sensing). We discuss key challenges including modality alignment, data heterogeneity, and computational efficiency, and highlight future research directions such as cross-modal attention mechanisms and federated learning for privacy-preserving fusion. This work aims to serve as a valuable resource for researchers and practitioners interested in advancing multimodal deep learning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
