@inproceedings{cao_ecc_2024,
 abstract = {This paper presents a novel approach to enhancing user interaction in virtual reality environments through adaptive haptic feedback systems. We investigate the integration of bio-inspired tactile sensors with machine learning algorithms to provide real-time, context-aware vibrations that mimic natural touch sensations. Through a series of user studies involving 120 participants, we evaluate the system's impact on immersion, task performance, and user satisfaction. Results indicate a 35% improvement in accuracy for fine-motor tasks and a significant reduction in motion sickness symptoms compared to traditional VR controllers. Our findings contribute to the design of more intuitive and accessible VR interfaces, with implications for gaming, training simulations, and therapeutic applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
