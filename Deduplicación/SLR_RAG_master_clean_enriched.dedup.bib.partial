@article{sudhi_rag-ex_2024,
 abstract = {In this paper, we present a novel approach to silent speech recognition using surface electromyography (sEMG) signals captured from the face and neck muscles. Our system, SilentWhisper, enables users to communicate silently by translating subtle muscle movements into text or speech output, offering a privacy-preserving alternative to traditional voice interfaces. We collected a dataset of 20 participants performing 100 common English words and phrases in silent mode, achieving an average word error rate of 12.3% with a deep learning model combining convolutional and recurrent neural networks. We also conducted a user study (N=15) demonstrating improved usability in noisy environments and for users with speech impairments, with 85% of participants rating the system as highly effective for discreet communication. Our work highlights the potential of sEMG-based silent interfaces for accessible and secure human-computer interaction.},
 abstract_lang = {en},
