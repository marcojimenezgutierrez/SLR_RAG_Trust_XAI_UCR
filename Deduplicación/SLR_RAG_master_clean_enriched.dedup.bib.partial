 title = {A smart multimodal healthcare copilot with powerful llm reasoning},
 url = {https://arxiv.org/abs/2506.02470},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:24:35Z},
 year = {2025}
}

@inproceedings{zhao_steprag_2025,
 abstract = {This paper proposes a novel framework for integrating machine learning techniques into software engineering processes to enhance knowledge discovery in large-scale codebases. We introduce a hybrid model that combines static code analysis with dynamic execution traces to identify latent patterns and potential vulnerabilities. Through extensive experiments on open-source repositories, our approach demonstrates a 25% improvement in anomaly detection accuracy compared to traditional methods. The framework is designed to be scalable and adaptable to various programming languages, paving the way for more intelligent software maintenance tools.},
