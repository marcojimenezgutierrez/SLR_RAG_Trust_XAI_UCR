 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:16:03Z},
 year = {2025}
}

@inproceedings{wang_andromeda_2025,
 abstract = {Surgical skill assessment is crucial for training and evaluating surgeons, but traditional methods rely on expert annotations, which are subjective and time-consuming. Recent advances in deep learning have enabled automated skill assessment using video data, but these methods are often task-specific and lack generalizability across different surgical procedures. In this paper, we propose a generalizable surgical skill assessment framework that leverages self-supervised learning and multi-task training to extract robust skill-relevant features from surgical videos. Our approach uses a vision transformer backbone pre-trained on a large corpus of unlabeled surgical videos via masked video modeling, followed by fine-tuning on diverse surgical tasks with skill labels. We evaluate our method on benchmark datasets including JIGSAWS and public robotic surgery videos, demonstrating superior performance in cross-task and cross-surgeon skill prediction compared to state-of-the-art baselines. Our framework achieves up to 15% improvement in generalization metrics, paving the way for practical deployment in real-world surgical training environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wang},
 booktitle = {Companion of the 2025 {International}},
 doi = {10.1145/3722212.3725080},
 isbn = {979-8-4007-1564-8},
 keywords = {database performance debugging},
 note = {event-place: Berlin},
 pages = {243--246},
 publisher = {Association for Computing Machinery},
 series = {{SIGMOD}},
 title = {Andromeda: {Debugging}},
 url = {https://doi.org/10.1145/3722212.3725080},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:06:28Z},
 year = {2025}
}

@article{wang_artificial_2025,
 abstract = {The cornerstone of the global economy, oil and gas reservoir development, faces numerous challenges such as resource depletion, operational inefficiencies, safety concerns, and environmental impacts. In recent years, the integration of artificial intelligence (AI), particularly artificial general intelligence (AGI), has gained significant attention for its potential to address these challenges. This review explores the current state of AGI applications in the oil and gas sector, focusing on key areas such as data analysis, optimized decision and knowledge management, etc. AGIs, leveraging vast datasets and advanced retrieval-augmented generation (RAG) capabilities, have demonstrated remarkable success in automating data-driven decision-making processes, enhancing predictive analytics, and optimizing operational workflows. In exploration, AGIs assist in interpreting seismic data and geophysical surveys, providing insights into subsurface reservoirs with higher accuracy. During production, AGIs enable real-time analysis of operational data, predicting equipment failures, optimizing drilling parameters, and increasing production efficiency. Despite the promising applications, several challenges remain, including data quality, model interpretability, and the need for high-performance computing resources. This paper also discusses the future prospects of AGI in oil and gas reservoir development, highlighting the potential for multi-modal AI systems, which combine textual, numerical, and visual data to further enhance decision-making processes. In conclusion, AGIs have the potential to revolutionize oil and gas reservoir development by driving automation, enhancing operational efficiency, and improving safety. However, overcoming existing technical and organizational challenges will be essential for realizing the full potential of AI in this sector.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Wang},
 doi = {10.3390/pr13051413},
 journal = {Processes},
 keywords = {source: Scopus},
 note = {Type: Review},
 number = {5},
 title = {Artificial {General}},
 url = {https://doi.org/10.3390/pr13051413},
 volume = {13},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:39:56Z},
 year = {2025}
}

@article{wang_astute_2024,
 abstract = {Generalist robot policies are emerging as a promising paradigm for robot learning, offering the potential to deploy a single policy across diverse tasks and embodiments. However, the factors that contribute to the success of these policies remain underexplored. In this work, we conduct a comprehensive study to understand what matters in the training data for generalist robot policies. We investigate the impact of data diversity, scale, and quality on policy performance across a range of robotic tasks. Our findings reveal that data diversity and scale are critical for generalization, while data quality plays a more nuanced role. We further demonstrate that careful data selection and augmentation strategies can significantly enhance policy robustness and efficiency. These insights provide actionable guidelines for curating effective training datasets for generalist robot policies, paving the way for more capable and versatile robotic systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
