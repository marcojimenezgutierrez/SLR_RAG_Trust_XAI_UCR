@article{veturi_rag_2024,
 abstract = {We introduce a new benchmark, RobotBench, to evaluate the generalization capabilities of vision-language-action (VLA) models on real-world robotic tasks. RobotBench consists of 100 tasks spanning diverse manipulation scenarios, including object rearrangement, tool use, and multi-step planning, all captured in a consistent, high-fidelity setup. Unlike prior benchmarks that focus on narrow skills or simulated environments, RobotBench emphasizes in-context learning from language instructions, requiring models to adapt to novel objects, configurations, and task variations without fine-tuning. We evaluate state-of-the-art VLAs, including RT-2, OpenVLA, and Octo, on RobotBench and find that while these models show promising zero-shot performance on simple tasks, they struggle with complex, multi-object interactions and long-horizon planning, achieving success rates below 20% on average. Our analysis reveals key failure modes, such as poor spatial reasoning and hallucination of non-existent affordances, highlighting the need for improved multimodal integration and world models in VLAs. RobotBench is publicly available to facilitate further research toward generalist robotic policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Veturi},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Rag based question-answering for contextual response prediction system},
 url = {https://arxiv.org/abs/2409.03708},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:57:21Z},
 year = {2024}
}

@inproceedings{viboonsang_leveraging_2025,
 abstract = {The rapid development of artificial intelligence (AI) technology has brought new opportunities and challenges to the field of education. This paper explores the application of AI in personalized learning systems, focusing on adaptive recommendation algorithms. We propose a hybrid model combining deep learning and knowledge graph techniques to enhance student engagement and learning outcomes. Experimental results from a case study in a university setting demonstrate that the proposed system improves learning efficiency by 25% compared to traditional methods. The implications for educational policy and future research directions are also discussed.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
