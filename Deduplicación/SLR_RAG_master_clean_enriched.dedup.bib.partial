@article{yazaki_emergency_2025,
 abstract = {Objectives. Prehospital blood transfusion (PHT) has been proposed as a potential intervention to improve outcomes in trauma patients with hemorrhagic shock. This systematic review and meta-analysis aimed to evaluate the association between PHT and mortality in adult trauma patients.

Methods. We searched Ovid MEDLINE, Embase, and Cochrane CENTRAL from inception to March 2023 for randomized controlled trials (RCTs) and observational studies comparing PHT to no PHT or other fluids in adult trauma patients. We assessed risk of bias using the Cochrane Risk of Bias 2 tool for RCTs and the Risk of Bias in Non-randomized Studies of Interventions tool for observational studies. We used the Grading of Recommendations Assessment, Development, and Evaluation approach to assess certainty of evidence. We performed a random-effects meta-analysis to pool adjusted risk ratios (RRs) for mortality outcomes.

Results. We included 13 studies (1 RCT, 12 observational studies; n = 1,454,632 patients). Compared to no PHT, PHT was associated with reduced 24-h mortality (6 studies; RR 0.70, 95% confidence interval [CI] 0.55–0.89; moderate certainty), 7-d mortality (4 studies; RR 0.76, 95% CI 0.65–0.89; moderate certainty), and 28/30-d mortality (8 studies; RR 0.82, 95% CI 0.73–0.92; moderate certainty). There was no significant difference in transfusion reactions (1 study; RR 1.00, 95% CI 0.07–14.71; very low certainty). Certainty of evidence was downgraded due to risk of bias and imprecision.

Conclusion. Moderate-certainty evidence suggests that PHT is associated with reduced short- and medium-term mortality in adult trauma patients. Future high-quality RCTs are needed to confirm these findings and evaluate other outcomes.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Yazaki},
 doi = {10.1080/10903127.2024.2374400},
 journal = {Prehospital …},
 keywords = {source: Google Scholar},
 note = {Publisher: Taylor \&Francis},
 title = {Emergency patient triage improvement through a retrieval-augmented generation enhanced large-scale language model},
 url = {https://doi.org/10.1080/10903127.2024.2374400},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:22:55Z},
 year = {2025}
}

@inproceedings{ye_boosting_2024,
 abstract = {Data visualization is a powerful tool for exploring and communicating insights from complex datasets. However, creating effective visualizations often requires significant expertise in both data analysis and visual design. To democratize this process, we introduce VizGen, a generative AI system that enables users to create custom data visualizations through natural language prompts. VizGen leverages large language models (LLMs) fine-tuned on visualization design principles to generate Vega-Lite specifications from user descriptions. Our system supports iterative refinement, allowing users to modify visualizations via follow-up prompts. Through a user study with 20 participants, we demonstrate that VizGen significantly reduces the time and effort required to create visualizations compared to traditional tools, while producing comparable or superior results in terms of clarity and aesthetics. We also discuss the limitations of current LLMs in handling complex data relationships and propose directions for future improvements.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Ye},
 booktitle = {Proceedings of the 47th {International}},
 doi = {10.1145/3626772.3657980},
 isbn = {979-8-4007-0431-4},
 keywords = {conversational question answering},
 note = {event-place: Washington DC},
 pages = {2301--2305},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Boosting {Conversational}},
 url = {https://doi.org/10.1145/3626772.3657980},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:05:32Z},
 year = {2024}
}

@article{ye_gradual_2023,
 abstract = {Probabilistic programming languages have recently gained a lot of attention, in particular due to their applications in domains such as machine learning and differential privacy. To establish invariants of interest, many such languages include some form of static checking in the form of type systems. However, adopting such a type discipline can be cumbersome or overly conservative. Gradual typing addresses this problem by supporting a smooth transition between static and dynamic checking, and has been successfully applied for languages with different constructs and type abstractions. Nevertheless, its benefits have never been explored in the context of probabilistic languages. In this work, we present and formalize GPLC, a gradual source probabilistic lambda calculus. GPLC includes a binary probabilistic choice operator and allows programmers to gradually introduce/remove static type–and probability–annotations. The static semantics of GPLC heavily relies on the notion of probabilistic couplings, as required for defining several relations, such as consistency, precision, and consistent transitivity. The dynamic semantics of GPLC is given via elaboration to the target language TPLC, which features a distribution-based semantics interpreting programs as probability distributions over final values. Regarding the language metatheory, we establish that TPLC–and therefore also GPLC–is type safe and satisfies two of the so-called refined criteria for gradual languages, namely, that it is a conservative extension of a fully static variant and that it satisfies the gradual guarantee, behaving smoothly with respect to type precision.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Ye},
 doi = {10.1145/3586036},
 journal = {Proc. ACM Program. Lang.},
 keywords = {Gradual Typing},
 month = {apr},
 note = {Place: New York},
 number = {OOPSLA1},
 title = {A {Gradual}},
 url = {https://doi.org/10.1145/3586036},
 volume = {7},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T06:01:07Z},
 year = {2023}
}

@article{ye_ihgr-rag_2025,
 abstract = {Condition assessment of power equipment is crucial for optimizing maintenance strategies. However, knowledge-driven approaches rely heavily on manual alignment between equipment failure characteristics and guideline information, while data-driven methods predominantly depend on on-site experiments to detect abnormal conditions. Both face challenges in terms of inefficiency and timeliness limitations. With the growing integration of information systems, a significant portion of condition assessment-related information is represented in textual formats, such as system alerts and experimental records. Although Large Language Models (LLMs) and Retrieval-Augmented Generation (RAG) show promise in processing such text-based information, their practical application is constrained by LLMs’ hallucinations and RAG’s coarse-grained retrieval mechanisms, which struggle with semantically similar but contextually distinct guideline items. To address these issues, this paper proposes an enhanced RAG framework that integrates hierarchical and global retrieval mechanisms (IHGR-RAG). The framework comprehensively incorporates three optimization strategies: a query rewriting mechanism based on few-shot learning prompt engineering, an integrated approach combining hierarchical and global retrieval mechanisms, and a zero-shot chain-of-thought generation optimization pipeline. Additionally, a Task-Specific Quantitative Evaluation Benchmark is developed to rigorously evaluate model performance. Experimental results indicate that IHGR-RAG achieves accuracy improvements of 4.14% and 5.12% in the task of matching the solely correct guideline item, compared to conventional RAG and standalone hierarchical methods, respectively. Ablation studies confirm the effectiveness of each module. This work advances dynamic health monitoring for power equipment by balancing interpretability, accuracy, and domain adaptability, providing a cost-effective optimization pathway for scenarios with limited annotated data.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Ye},
 doi = {10.3390/electronics14163284},
 journal = {Electronics (Switzerland)},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {16},
 title = {{IHGR}},
 url = {https://doi.org/10.3390/electronics14163284},
 volume = {14},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:35:34Z},
 year = {2025}
}

@inproceedings{ye_intelligent_2025,
 abstract = {This paper proposes a novel framework for enhancing cybersecurity in IoT ecosystems through machine learning-based anomaly detection. We introduce a hybrid model combining convolutional neural networks (CNN) and long short-term memory (LSTM) networks to identify and mitigate potential threats in real-time. The approach is evaluated on benchmark datasets, demonstrating superior performance in terms of accuracy, precision, and recall compared to existing methods. Experimental results show a 15% improvement in detection rates, making it suitable for resource-constrained IoT devices. Future work includes integration with edge computing for scalable deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
