@inproceedings{yin_lies_2024,
 abstract = {Data visualization is an essential tool for exploring and communicating insights from data, but creating effective visualizations often requires expertise in both data analysis and graphic design. Visual programming languages (VPLs) for data visualization aim to lower the barrier to entry by allowing users to create visualizations using a graphical interface instead of writing code. Despite their potential, VPLs have not been widely adopted, and little is known about how to design them to support diverse users and tasks. In this paper, we explore the design space of VPLs for interactive data visualization through a systematic analysis of 20 existing VPLs and a user study with 12 participants. We identify key design dimensions, including representation, interaction, and modularity, and discuss how they impact usability and expressiveness. Our findings inform the design of future VPLs and highlight opportunities for innovation in this space.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Yin},
 booktitle = {Proceedings of the 2024 {CHI}},
 doi = {10.1145/3613904.3642253},
