@book{hasan_llm_2025,
 abstract = {This thesis explores the implementation of digital twins in manufacturing processes, focusing on a case study from a Swedish automotive supplier. The study investigates how digital twin technology can enhance production efficiency, predictive maintenance, and overall sustainability. Through a combination of literature review, interviews with industry experts, and simulation modeling, the research identifies key challenges such as data integration, cybersecurity, and skill gaps. Findings suggest that while digital twins offer significant potential for real-time optimization, successful adoption requires interdisciplinary collaboration and robust infrastructure. The thesis concludes with recommendations for future implementations in similar contexts.},
