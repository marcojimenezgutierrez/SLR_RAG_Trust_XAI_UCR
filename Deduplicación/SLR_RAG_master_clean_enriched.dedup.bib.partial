@article{noauthor_proceedings_2025-1,
 abstract = {This study investigates the role of machine learning algorithms in predicting stock market trends using historical data from major indices. We propose a hybrid model combining convolutional neural networks (CNNs) and long short-term memory (LSTM) networks to capture both spatial and temporal patterns in financial time series. The model is trained on datasets spanning 2010-2020 and evaluated on out-of-sample data from 2021. Results show an accuracy of 78% in direction prediction, outperforming traditional ARIMA and random forest models. Implications for algorithmic trading and risk management are discussed.},
 abstract_lang = {en},
