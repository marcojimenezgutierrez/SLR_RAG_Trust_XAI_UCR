@inproceedings{azher_futuregen_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) and machine learning (ML) has revolutionized various scientific domains, including eScience. However, the integration of AI/ML in eScience workflows faces significant challenges, such as data heterogeneity, scalability, and reproducibility. This paper introduces a novel framework, eScienceAI, designed to streamline the application of AI/ML techniques in eScience pipelines. eScienceAI leverages containerization and orchestration tools to ensure portability and scalability across heterogeneous computing environments, from local clusters to cloud infrastructures. We demonstrate the framework's efficacy through case studies in bioinformatics and climate modeling, achieving up to 40% improvement in processing efficiency and enhanced reproducibility. Our results highlight the potential of eScienceAI to democratize AI/ML adoption in scientific research, fostering interdisciplinary collaboration and accelerating discovery.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Azher},
 booktitle = {2025 {IEEE}},
