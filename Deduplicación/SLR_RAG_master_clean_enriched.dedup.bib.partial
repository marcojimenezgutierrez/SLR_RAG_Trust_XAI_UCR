@article{jain_mitigating_2025,
 abstract = {This paper explores the integration of large language models (LLMs) into software engineering practices, focusing on code generation and review processes. We present a novel framework, LLM-SE, that leverages fine-tuned LLMs to automate routine tasks while enhancing developer productivity. Through empirical evaluation on open-source repositories, we demonstrate a 25% reduction in review time and improved code quality metrics. Our approach addresses key challenges such as hallucination mitigation and context awareness, providing actionable insights for practitioners adopting AI in SE workflows.},
