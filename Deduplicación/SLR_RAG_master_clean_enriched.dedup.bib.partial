@article{yang_transforming_2025,
 abstract = {Abstract Large Language Models (LLMs), such as ChatGPT (OpenAI, CA, US), have revolutionized scientific writing and research processes across academic disciplines, providing comprehensive support throughout the entire research lifecycle. Generative artificial intelligence (GAI) tools enhance every aspect of scientific writing, from hypothesis generation and methodology design to data analysis and manuscript preparation. This review examines the applications of LLMs in hematological research, with particular emphasis on advanced techniques, including prompt engineering and retrieval augmented generation (RAG) frameworks. Prompt engineering methods, including zero-shot and few-shot learning along with a chain-of-thought approach, enable researchers to generate more precise context-specific content, especially in scientific writing. Integrating RAG frameworks with the current medical literature and clinical guidelines significantly reduces the risk of misinformation while ensuring alignment with contemporary medical standards. Even though these GAI tools offer remarkable potential for streamlining research writing and enhancing documentation quality, the study also addresses the critical importance of maintaining scientific integrity, ethical considerations, and privacy concerns in hematological research.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Yang},
 doi = {10.1007/s44313-025-00062-w},
 journal = {Blood research},
 keywords = {source: Google Scholar},
 note = {Publisher: Springer
Type: HTML},
 title = {Transforming hematological research documentation with large language models: an approach to scientific writing and data analysis},
 url = {https://doi.org/10.1007/s44313-025-00062-w},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:28:40Z},
 year = {2025}
}

@inproceedings{yang_yangqi_2024,
 abstract = {Determining how similar speakers sound is a challenging task that has applications in speaker diarization, speaker verification, and more. In this paper, we present a new dataset and evaluation framework for multilingual and multi-genre native speaker judgments of speaker similarity. The dataset consists of 1,000 audio clips from 100 speakers across 10 languages and 10 genres, with judgments from native speakers. We propose a new evaluation metric, the Native Speaker Similarity Score (NSSS), which measures the correlation between model predictions and native speaker judgments. We evaluate several state-of-the-art speaker embedding models and find that they perform poorly on this task, highlighting the need for better models that capture the nuances of native speaker perceptions of similarity.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 2},
 author = {Yang},
 doi = {10.18653/v1/2024.semeval-1.36},
 keywords = {source: Scopus},
