@inproceedings{anh-khoa_gvec_2024,
 abstract = {This paper proposes a novel framework for multi-agent path planning in dynamic environments using reinforcement learning. We introduce a decentralized approach where agents learn cooperative policies through a shared reward mechanism, enabling efficient collision avoidance and goal achievement. Extensive simulations demonstrate superior performance compared to traditional methods, with up to 30% improvement in success rates and reduced computation time. The framework is evaluated on benchmark scenarios, highlighting its scalability for real-world robotic applications.},
