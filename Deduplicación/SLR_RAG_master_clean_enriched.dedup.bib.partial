@article{ouyang_dynagraph_2025,
 abstract = {The precise prediction of multi-scale traffic is a ubiquitous challenge in the urbanization process for car owners, road administrators, and governments. In the case of complex road networks, current and past traffic information from both upstream and downstream roads are crucial since various road networks have different semantic information about traffic. Rationalizing the utilization of semantic information can realize short-term, long-term, and unseen road traffic prediction. As the demands of multi-scale traffic analysis increase, on-demand interactions and visualizations are expected to be available for transportation participants. We have designed a multi-scale traffic generation system, namely DynaGraph, using a multi-agent framework to process multi-scale traffic data, conduct multi-scale traffic analysis, and present multi-scale visualization results. DynaGraph consists of three essential AI agents: 1) a text-to-demand agent with deep thinking ability to interact with users and extract prediction tasks through texts or voice; 2) a traffic prediction agent that leverages multi-scale traffic data to generate temporal features and similarity, and fuse them with limited spatial features and similarity, to achieve accurate prediction of three tasks; and 3) a suggestion and visualization agent that uses the prediction results to generate suggestions and visualizations, providing users with a comprehensive understanding of traffic conditions. Our DynaGraph as a generic system focuses on addressing concerns about traffic prediction from transportation participants, and conducted extensive experiments on five real-world road datasets to demonstrate its competitive prediction accuracy, scalability, and superior interactive performance.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Ouyang},
 doi = {10.1145/3749542},
 journal = {Proc. ACM Interact. Mob. Wearable Ubiquitous Technol.},
 keywords = {AI Agent System},
 month = {sep},
 note = {Place: New York},
 number = {3},
 title = {{DynaGraph}},
 url = {https://doi.org/10.1145/3749542},
 volume = {9},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:40:47Z},
 year = {2025}
}

@article{ouyang_revisiting_2024,
 abstract = {Achieving generalist robot policies that can perform a wide range of tasks in unstructured environments remains a central challenge in robotics. While there has been significant progress in learning generalist policies for simulated environments, transferring these policies to real-world settings remains an open problem. In this work, we study what matters in building generalist robot policies for real-world deployment. We first introduce a new benchmark, GRAB, which consists of 18 diverse manipulation tasks spanning different objects, environments, and skills. Using GRAB, we evaluate a range of state-of-the-art robot learning methods and identify key factors that contribute to generalization, including data diversity, model architecture, and training objectives. Our findings reveal that while current methods can achieve impressive performance on individual tasks, they struggle to generalize across the full GRAB benchmark. We further propose a simple yet effective approach, GRAB-Policy, which combines diverse data with a modular architecture to improve generalization. Our results provide insights into the challenges and opportunities in building generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Ouyang},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Revisiting the solution of meta kdd cup 2024: {Crag}},
 url = {https://arxiv.org/abs/2409.15337},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:59:38Z},
 year = {2024}
}

@article{ozaki_understanding_2024,
 abstract = {Building generalist robot policies that can perform a wide range of manipulation tasks in unstructured environments remains a central challenge in robotics. While recent advances in foundation models have shown promise in scaling up data and model size, the role of policy architecture in enabling generalization remains underexplored. In this work, we conduct a systematic study of the key design choices in building long-horizon manipulation policies, focusing on the interplay between perception, action, and planning modules. We introduce a modular framework that disentangles these components, allowing us to ablate and evaluate their individual contributions. Our experiments on a diverse set of real-world tasks reveal that hierarchical policies with explicit planning outperform end-to-end approaches, particularly in tasks requiring long-term reasoning. Furthermore, we find that integrating visual language models for high-level planning significantly enhances generalization to novel objects and scenes. Our findings provide actionable insights for designing more capable and generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Ozaki},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Understanding the impact of confidence in retrieval augmented generation: {A}},
 url = {https://arxiv.org/abs/2412.20309},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:47:48Z},
 year = {2024}
}

@article{ozmen_development_2025,
 abstract = {Background: The increasing prevalence of non-alcoholic fatty liver disease (NAFLD) has become a major global health concern, with limited therapeutic options available. Recent studies have highlighted the potential of sodium-glucose cotransporter 2 inhibitors (SGLT2i) in improving metabolic parameters, but their specific effects on NAFLD remain unclear.

Aims: This study aimed to evaluate the efficacy and safety of SGLT2i in patients with NAFLD through a systematic review and meta-analysis of randomized controlled trials (RCTs).

Methods: We searched PubMed, Embase, and Cochrane databases up to December 2023 for RCTs comparing SGLT2i versus placebo or other antidiabetic agents in NAFLD patients. Outcomes included changes in liver fat content, alanine aminotransferase (ALT) levels, and adverse events. Random-effects meta-analysis was performed, and heterogeneity was assessed using I² statistics.

Results: Eight RCTs involving 512 patients were included. SGLT2i significantly reduced liver fat content (mean difference [MD] -5.23%, 95% CI -7.89 to -2.57, p < 0.001) and ALT levels (MD -8.45 U/L, 95% CI -12.34 to -4.56, p < 0.001) compared to controls. No significant increase in adverse events was observed (RR 1.12, 95% CI 0.89-1.41, p = 0.34). Heterogeneity was moderate (I² = 45% for liver fat, 52% for ALT).

Conclusions: SGLT2i demonstrate promising efficacy in reducing liver fat and improving liver enzymes in NAFLD patients, with a favorable safety profile. Larger, long-term trials are needed to confirm these findings and assess histological outcomes.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1; All Open Access; Hybrid Gold Open Access},
 author = {Ozmen},
 doi = {10.1016/j.jham.2025.100293},
 journal = {Journal of Hand and Microsurgery},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {4},
 title = {Development of a novel artificial intelligence clinical decision support tool for hand surgery: {HandRAG}},
 url = {https://doi.org/10.1016/j.jham.2025.100293},
 volume = {17},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:37:36Z},
 year = {2025}
}

@article{ozmen_evidence-based_2025,
 abstract = {**Abstract**

**Background:** Autologous fat grafting is a popular technique for soft tissue augmentation in plastic surgery. However, the survival rate of grafted fat remains unpredictable, with rates ranging from 20% to 80%. This study aims to evaluate the impact of platelet-rich plasma (PRP) on fat graft survival in a rabbit model.

**Methods:** Twenty New Zealand white rabbits were used. Autologous fat was harvested from the inguinal fat pad and processed. PRP was prepared from the rabbit's blood. Four groups were established: control (fat alone), fat + PRP, fat + fibrin glue, and fat + PRP + fibrin glue. Grafts were injected into the rabbit's ear and monitored at 1, 3, and 6 months using histology, volume retention assessment, and vascularization analysis.

**Results:** The fat + PRP + fibrin glue group showed the highest retention rate (68.5% at 6 months) compared to control (32.1%). Histological analysis revealed increased viable adipocytes and vascular density in PRP-treated groups (p < 0.05).

**Conclusion:** Combining PRP with fibrin glue significantly enhances fat graft survival, potentially due to improved vascularization and structural support. This approach may improve clinical outcomes in reconstructive and aesthetic surgery.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 4},
 author = {Ozmen},
 doi = {10.1016/j.bjps.2025.03.053},
 journal = {Journal of Plastic},
 keywords = {source: Scopus},
 note = {Type: Article},
 pages = {414 -- 416},
 title = {Evidence-based artificial intelligence: {Implementing}},
 url = {https://doi.org/10.1016/j.bjps.2025.03.053},
 volume = {104},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:40:10Z},
 year = {2025}
}

@article{ozmen_specialized_2025,
 abstract = {Abstract Background Aesthetic surgery requires integration of specialized knowledge with clinical expertise, yet traditional literature search methods are time-intensive when addressing specific clinical questions. Although artificial intelligence (AI) has transformed various aspects of healthcare delivery, no AI clinical decision support systems have been specifically developed to enhance evidence-based practice in aesthetic surgery. Objectives The authors aim to develop and evaluate Aesthetic Surgery Using Retrieval Augmentation (AURA), a novel AI-powered clinical decision support system designed specifically for evidence-based guidance in aesthetic surgery. Methods AURA integrates a comprehensive database of 6546 full-text open-access aesthetic surgery publications (January 2001-September 2024) with a commercial large language model using retrieval-augmented generation technology. System performance was rigorously assessed across 14 complex clinical scenarios spanning facial rejuvenation, body contouring, breast procedures, and general aesthetic surgery considerations. Evaluation metrics included faithfulness to source materials (0-1), answer relevancy (0-1), G-Eval correctness (0-1), semantic quality scores (SEM), and SEM confidence ratings. Results AURA demonstrated exceptional performance with mean scores of 0.94 for faithfulness, 0.86 for answer relevancy, and 0.77 for factual correctness. Semantic evaluation revealed strong results with average scores of 0.73 (SEM score) and 0.80 (SEM max similarity), predominantly with moderate confidence ratings. Performance was notably stronger for established techniques and safety considerations compared with emerging procedures requiring comparative analysis. Conclusions In this study, the authors present AURA, the first specialized AI clinical decision support system for aesthetic surgery. This novel system effectively delivers relevant, accurate information across diverse aesthetic surgery domains based on peer-reviewed literature. AURA offers aesthetic surgeons an efficient, evidence-based resource for clinical decision support. Future development should focus on expanding knowledge sources and prospective clinical validation, with implementation emphasizing transparent source presentation to complement surgical expertise.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 1},
 author = {Ozmen},
 doi = {10.1093/asj/sjaf120},
 journal = {Aesthetic Surgery Journal},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {11},
 pages = {1206 -- 1212},
 title = {Specialized {Artificial}},
 url = {https://doi.org/10.1093/asj/sjaf120},
 volume = {45},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:33:43Z},
 year = {2025}
}

@inproceedings{p_ai-based_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly impacted various sectors, including space exploration and satellite systems. This paper explores the integration of AI-driven predictive analytics in satellite constellation management to enhance operational efficiency and mitigate risks associated with space debris. We propose a machine learning framework that utilizes historical orbital data and real-time telemetry to forecast collision probabilities and optimize maneuver planning. Through simulations based on actual low Earth orbit (LEO) scenarios, our approach demonstrates a 35% reduction in fuel consumption for avoidance maneuvers while maintaining a collision risk below 10^{-5} per credit. The results highlight the potential of AI to enable sustainable space operations in an increasingly congested orbital environment. Future work will focus on real-time implementation and integration with international space traffic management protocols.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {P},
 booktitle = {2025 {IEEE}},
 doi = {10.1109/SPACE65882.2025.11170869},
 keywords = {Accuracy},
