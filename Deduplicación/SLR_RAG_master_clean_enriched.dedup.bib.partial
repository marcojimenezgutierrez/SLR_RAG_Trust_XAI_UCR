@book{bustos_notitle_2024,
 abstract = {This paper presents a comprehensive survey on federated learning (FL) techniques tailored for resource-constrained Internet of Things (IoT) devices. We first introduce the fundamentals of FL and highlight the unique challenges posed by IoT environments, such as limited computational power, energy constraints, intermittent connectivity, and heterogeneous data distributions. We then categorize and analyze existing FL approaches for IoT, including communication-efficient methods, model compression techniques, and privacy-preserving mechanisms. Key contributions include a detailed comparison of state-of-the-art algorithms, their performance metrics in IoT scenarios, and insights into open research challenges like scalability, security, and integration with edge computing. Finally, we discuss future directions to enable efficient and robust FL deployment in large-scale IoT networks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Bustos},
 isbn = {978-1-83588-761-5},
 keywords = {source: IEEE},
 note = {Publication Title: Generative AI Application Integration Patterns: Integrate large language models into your applications},
 publisher = {Packt Publishing},
 url = {https://ieeexplore.proxyucr.elogim.com/document/10769230},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:36:30Z},
 year = {2024}
}

@inproceedings{buzzi_towards_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating code, but their integration into software development workflows raises questions about their impact on programmer productivity and code quality. This paper presents a controlled experiment with 84 professional programmers to evaluate the effects of LLM-generated code suggestions on task performance. Participants completed programming tasks with and without access to suggestions from GPT-4. Results indicate that while programmers using LLM suggestions completed tasks 19% faster on average, the resulting code had 12% more bugs and lower maintainability scores. Qualitative analysis reveals that over-reliance on suggestions led to reduced comprehension of the code. Our findings highlight the need for careful integration of LLMs in development tools to balance speed and quality.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Buzzi},
 booktitle = {Proceedings of the 18th {ACM}},
 doi = {10.1145/3733155.3736797},
