 isbn = {979-8-4007-1274-6},
 keywords = {membership inference attacks},
 note = {event-place: Sydney NSW},
 pages = {2894--2907},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {Mask-based {Membership}},
 url = {https://doi.org/10.1145/3696410.3714771},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:20:15Z},
 year = {2025}
}

@inproceedings{liu_multimodal_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has led to their widespread adoption across various sectors, including education. However, the integration of AI in educational settings raises significant ethical concerns, particularly regarding bias, privacy, and equity. This paper explores the ethical implications of AI-driven educational tools, focusing on how these technologies can perpetuate or mitigate existing inequalities in access to quality education. Through a comprehensive review of current literature and case studies from diverse global contexts, we identify key challenges such as algorithmic bias in personalized learning systems and data privacy issues in student assessment tools. We propose a framework for ethical AI implementation in education that emphasizes transparency, inclusivity, and continuous evaluation. Our findings underscore the need for interdisciplinary collaboration among educators, technologists, and policymakers to ensure that AI enhances rather than undermines educational equity.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Liu},
