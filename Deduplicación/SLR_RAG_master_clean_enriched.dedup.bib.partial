 x_enrich_ts = {2025-11-02T09:20:35Z},
 year = {2025}
}

@inproceedings{hu_privacy-preserved_2024,
 abstract = {Multi-modal large language models (MLLMs) have shown impressive capabilities in understanding and generating multi-modal content. However, they often struggle with complex reasoning tasks that require integrating information from multiple modalities. To address this, we propose a novel framework, Multi-Modal Chain-of-Thought (MMCoT), which enhances MLLMs' reasoning abilities by generating intermediate reasoning steps in a multi-modal manner. Specifically, MMCoT consists of three key components: (1) a multi-modal prompt generator that creates diverse prompts incorporating visual, textual, and hybrid elements; (2) a chain-of-thought reasoner that produces step-by-step reasoning traces across modalities; and (3) a multi-modal verifier that evaluates the consistency and correctness of the generated reasoning. By iteratively refining the reasoning process through these components, MMCoT enables MLLMs to perform more robust multi-modal reasoning. Experiments on benchmarks such as ScienceQA, Visual Commonsense Reasoning, and TabMWP demonstrate that MMCoT significantly outperforms existing MLLMs, achieving up to 15% improvement in accuracy while maintaining efficiency.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Hu},
 booktitle = {Proceedings of the 30th {ACM}},
 doi = {10.1145/3637528.3671678},
 isbn = {979-8-4007-0490-1},
 keywords = {complex query answering (cqa)},
 note = {event-place: Barcelona},
 pages = {1108--1118},
 publisher = {Association for Computing Machinery},
 series = {{KDD}},
 title = {Privacy-{Preserved}},
 url = {https://doi.org/10.1145/3637528.3671678},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:12:34Z},
 year = {2024}
}

@article{hu_prompt_2024,
 abstract = {3D Gaussian Splatting (3DGS) has recently emerged as a competitive alternative to NeRF-based methods for novel view synthesis. However, 3DGS typically suffers from aliasing artifacts when rendering at low resolutions or from distant viewpoints. We observe that these artifacts arise because 3DGS renders Gaussians with fixed screen-space covariance, ignoring the continuous nature of the scene. To address this, we propose Mip-Splatting, a novel method that models the scene as a continuous field of Gaussians with view-dependent covariance. Specifically, we store Gaussians at multiple scales in a mip-map like structure and interpolate between them during rendering. This allows us to render alias-free images at arbitrary resolutions and viewpoints. Our method is simple to implement, efficient, and achieves state-of-the-art results on the Tanks and Temples and Mip-NeRF 360 datasets.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Hu},
 booktitle = {Proceedings of the 30th {ACM}},
