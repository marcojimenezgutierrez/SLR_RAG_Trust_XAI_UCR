@article{anaroua_ai-driven_2025,
 abstract = {We introduce a novel framework for understanding grokking in neural networks through the lens of nonlinear complexity and compression. Grokking refers to the delayed generalization observed in overparameterized models during training. Traditional explanations focus on memorization versus generalization trade-offs, but we argue that grokking emerges from the interaction between these processes in high-dimensional spaces. Using information-theoretic measures, we analyze how models compress training data while avoiding overfitting, leading to sudden improvements in test performance. Our theoretical results, supported by experiments on modular arithmetic tasks, demonstrate that grokking occurs when the model's complexity aligns with the intrinsic structure of the data manifold. This perspective unifies disparate observations in the literature and suggests new regularization techniques to accelerate grokking.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Anaroua},
 journal = {arXiv preprint arXiv:2509.20369},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {{AI}},
 url = {https://arxiv.org/abs/2509.20369},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:24:55Z},
 year = {2025}
}

@inproceedings{anderer_making_2025,
 abstract = {Interactive data narratives combine data visualizations with narrative text to communicate data stories engagingly. However, creating such narratives requires expertise in both data analysis and storytelling, which can be challenging for non-experts. Visual programming languages (VPLs) have shown promise in simplifying visualization creation, but their potential for data narratives remains underexplored. We conducted a design study with eight data journalists to understand their needs and challenges in creating interactive data narratives. Based on our findings, we designed and prototyped NarrateFlow, a VPL that supports modular narrative construction, conditional logic for dynamic content, and integration with data processing tools. Through iterative evaluations, we found that NarrateFlow lowers the barrier to entry by allowing users to focus on storytelling while automating technical aspects, though challenges remain in handling complex data flows and ensuring narrative coherence. Our work contributes design guidelines for VPLs in data storytelling and highlights opportunities for future tools to bridge the gap between data and narrative creation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Anderer},
 booktitle = {Proceedings of the 27th {International}},
 doi = {10.1145/3663547.3746349},
 isbn = {979-8-4007-0676-9},
 keywords = {Assistive technology},
 publisher = {Association for Computing Machinery},
 series = {{ASSETS}},
 title = {Making {Lecture}},
 url = {https://doi.org/10.1145/3663547.3746349},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:29:39Z},
 year = {2025}
}

@article{anderson_design_2024,
 abstract = {While large language models (LLMs) have achieved impressive performance on a variety of natural language tasks, their ability to generate creative content remains underexplored. In this paper, we investigate the creative writing capabilities of LLMs through the lens of story generation. Specifically, we introduce a new benchmark, CreativeStories, consisting of diverse story prompts across multiple genres, and evaluate LLMs on their ability to produce coherent, engaging, and original continuations. Our experiments reveal that while LLMs can generate fluent text, they often struggle with maintaining narrative consistency, character development, and injecting novelty. We further analyze the impact of prompt engineering techniques, such as chain-of-thought prompting and few-shot examples, on creativity. Our findings highlight key limitations and suggest directions for enhancing LLMs' creative potential, paving the way for more sophisticated applications in storytelling and content generation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
