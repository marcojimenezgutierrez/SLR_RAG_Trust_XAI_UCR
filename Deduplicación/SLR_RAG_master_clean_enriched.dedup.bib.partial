@book{rothman__2024,
 abstract = {Design and develop generative AI-powered applications on AWS. Perform RAG and agentic workflows with advanced multimodality and enterprise readiness. Undertake problem solving and reasoning with Amazon Bedrock and LangChain. Build context-aware, multimodal reasoning applications using generative AI on AWS. Key Features. Understand the fundamentals of generative AI and how it works on AWS. Explore various RAG techniques and their implementation using Amazon Bedrock. Build a generative AI-powered chatbot using LangChain and Amazon Bedrock. Book Description. Building intelligent systems is a key competency for any organization looking to leverage the power of generative AI. This book is a practical guide to building intelligent systems using Amazon Bedrock and LangChain. You'll start by exploring the fundamentals of generative AI and understanding how it works on AWS. You'll learn how to use Amazon Bedrock and LangChain to build generative AI-powered applications. You'll also learn how to use RAG techniques to improve the accuracy of your applications. By the end of this book, you'll be able to build intelligent systems that can understand and respond to natural language queries. What you will learn. Understand the fundamentals of generative AI and how it works on AWS. Explore various RAG techniques and their implementation using Amazon Bedrock. Build a generative AI-powered chatbot using LangChain and Amazon Bedrock. Who this book is for. This book is for solution architects, developers, and technical professionals who want to build intelligent systems using generative AI on AWS. To make the most of this book, you should have a basic understanding of AWS services and Python programming.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
