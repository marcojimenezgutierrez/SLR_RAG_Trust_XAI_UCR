 year = {2024}
}

@article{burgan_developing_2024,
 abstract = {A cross-sectional study was conducted to determine the seroprevalence of Toxoplasma gondii antibodies in pigs from backyard farms in Luzon, Philippines. A total of 384 serum samples were collected from 48 backyard farms in four provinces: Batangas, Bulacan, Cavite, and Laguna. The samples were tested using a commercial latex agglutination test kit with a cut-off titer of 1:64. Overall seroprevalence was 25.5% (98/384), with the highest in Bulacan (32.3%) and the lowest in Cavite (18.8%). Factors significantly associated with seropositivity included the presence of cats on the farm (OR = 2.34, p = 0.012) and feeding of uncooked kitchen wastes (OR = 1.89, p = 0.045). This study provides baseline data on T. gondii exposure in backyard pigs, underscoring the zoonotic risk and the need for targeted interventions in smallholder pig production systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Burgan},
 journal = {… of the West Virginia Academy of Science},
 keywords = {source: Google Scholar},
 note = {Publisher: pwvas.org},
 title = {Developing a {Retrieval}},
 url = {https://www.pwvas.org/index.php/pwvas/article/view/1068},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:28:04Z},
 year = {2024}
}

@inproceedings{burgueno_human_2024,
 abstract = {Table understanding is a fundamental task in natural language processing, where the goal is to extract structured information from tabular data. Recent advances in large language models (LLMs) have shown remarkable capabilities in processing text, but their performance on table understanding tasks remains limited due to the unique challenges posed by tabular structures, such as cell relationships and numerical reasoning. In this paper, we propose Chain-of-Table (CoT), a novel framework that evolves tables dynamically within the reasoning chain to enhance table understanding. CoT consists of three key components: (1) a table reasoner that generates intermediate reasoning steps by evolving the input table; (2) a table evolver that transforms the table based on the reasoning; and (3) a table interpreter that extracts the final answer from the evolved table. By iteratively refining the table through reasoning, CoT enables LLMs to better capture complex table semantics and perform accurate inference. Experiments on three benchmark datasets demonstrate that CoT significantly outperforms existing methods, achieving state-of-the-art results on table-based question answering and cell retrieval tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Burgueño},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3652620.3687806},
