 series = {{SIGIR}},
 title = {Mitigating {Source}},
 url = {https://doi.org/10.1145/3726302.3730038},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:04:07Z},
 year = {2025}
}

@inproceedings{dai_next-search_2025,
 abstract = {Social Virtual Reality (Social VR) has emerged as a popular platform for remote social interaction, allowing users to connect with others in immersive virtual environments. However, most Social VR platforms employ generic avatars that do not accurately represent users' real-world body shapes, potentially leading to a disconnect between users' self-perception and their virtual representation. This mismatch may influence social dynamics, embodiment, and overall user experience. In this paper, we investigate the effects of avatar body shape realism on social interactions in VR through a between-subjects experiment (N=24) where participants engaged in dyadic conversations using either realistic body shape avatars (based on their own scanned bodies) or generic avatars. Our findings indicate that realistic body shapes significantly enhance users' sense of embodiment, social presence, and enjoyment compared to generic avatars. Moreover, realistic avatars led to more natural nonverbal communication behaviors, such as gestures and proxemics. These results underscore the importance of personalized body representations in Social VR and offer design guidelines for improving avatar systems to foster more authentic and engaging social experiences.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Dai},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730353},
