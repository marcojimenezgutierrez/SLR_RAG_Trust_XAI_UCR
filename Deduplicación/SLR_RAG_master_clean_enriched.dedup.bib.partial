 volume = {329},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:35:12Z},
 year = {2025}
}

@inproceedings{kurshan_ai_2024,
 abstract = {Visual analytics has been widely used to help data scientists explore and understand data. However, most existing visual analytics tools are designed for data scientists with expertise in machine learning and statistics, which limits their accessibility to non-experts. In this paper, we present FairVis, a visual analytics system that enables non-experts to discover intersectional fairness issues in bias detection. FairVis allows users to explore datasets and models through interactive visualizations that highlight potential biases across multiple protected attributes. We evaluate FairVis through a qualitative user study with domain experts and non-experts, demonstrating its effectiveness in identifying and mitigating biases in real-world datasets. Our findings show that FairVis empowers users without technical backgrounds to engage in fairness auditing, fostering more inclusive AI development practices.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Kurshan},
