}

@inproceedings{chen_self-improving_2025,
 abstract = {This study investigates the effects of climate change on agricultural productivity in sub-Saharan Africa using panel data from 1990 to 2015. Employing fixed effects regression models, we find that rising temperatures and erratic rainfall patterns significantly reduce crop yields, particularly for maize and sorghum. Adaptation strategies such as improved irrigation and drought-resistant varieties are shown to mitigate some impacts, but policy interventions are urgently needed to enhance resilience. The results underscore the vulnerability of smallholder farmers and the potential for substantial economic losses if current trends continue.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
