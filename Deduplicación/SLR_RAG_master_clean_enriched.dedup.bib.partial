@inproceedings{li_knowtrace_2025,
 abstract = {Neural Radiance Fields (NeRF) have shown remarkable success in novel view synthesis. However, they require hundreds of images for training, which is time-consuming and expensive to obtain. Recent works have attempted to reduce the required number of input views by leveraging additional information such as depth or semantic maps. In this work, we explore the use of audio as an additional supervision signal for few-shot novel view synthesis. We propose a novel method that incorporates audio features into the NeRF training process to guide the geometry and appearance reconstruction. Our approach uses audio-visual correspondence to constrain the 3D scene representation, enabling high-quality novel view synthesis from as few as 3 input images. Experimental results on real-world datasets demonstrate that our method outperforms existing few-shot NeRF baselines in terms of both visual fidelity and training efficiency.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
