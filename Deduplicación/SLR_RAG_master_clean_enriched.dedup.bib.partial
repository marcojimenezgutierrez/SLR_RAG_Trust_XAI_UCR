@misc{noauthor_scopus_nodate,
 abstract = {Retrieval-Augmented Generation (RAG) has recently gained significant attention as a promising approach to enhance the factual accuracy of large language models (LLMs). However, the trustworthiness of RAG outputs remains underexplored, particularly in terms of user perception and calibration of confidence. This study investigates user trust in RAG-enhanced LLMs through a series of experiments involving human participants evaluating responses from ChatGPT integrated with RAG. We examine factors such as perceived reliability, overtrust, and the impact of source attribution on user confidence. Results indicate that while RAG reduces hallucinations and improves factuality, users often exhibit overtrust in cited sources, leading to miscalibration. We also explore explainability techniques, including post-hoc explanations and feature attribution, to enhance AI transparency and user calibration. Our findings contribute to the development of more trustworthy generative AI systems by highlighting the need for better calibration mechanisms and interpretable retrieval processes.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 file = {Scopus - Document search results | Signed in:C\:\\Users\\Marco\\Zotero\\storage\\3W35T745\\results.html:text/html},
