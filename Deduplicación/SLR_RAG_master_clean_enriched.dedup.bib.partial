@inproceedings{sarmiento_investigating_2025,
 abstract = {Network anomaly detection plays a crucial role in maintaining the security and reliability of modern networks. Traditional methods often struggle with the high dimensionality and complexity of network traffic data. Deep learning techniques have emerged as powerful tools for anomaly detection due to their ability to automatically learn hierarchical features from raw data. This paper provides a comprehensive survey of deep learning-based approaches for network anomaly detection. We categorize the methods into supervised, unsupervised, and semi-supervised learning paradigms and discuss popular architectures such as autoencoders, convolutional neural networks, recurrent neural networks, and graph neural networks. Key datasets, evaluation metrics, and challenges are also reviewed. Finally, we outline future research directions, including the integration of explainable AI and federated learning to enhance privacy and interpretability in anomaly detection systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
