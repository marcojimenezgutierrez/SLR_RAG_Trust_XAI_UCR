@inproceedings{lee_talkin_2024,
 abstract = {We present a novel approach for dense visual SLAM that integrates neural radiance fields with Gaussian splatting to achieve high-fidelity, real-time dense reconstruction and tracking. Traditional SLAM systems often struggle with photorealistic rendering and dense mapping in dynamic environments. Our method, Gaussian Splatting SLAM (GSS), leverages 3D Gaussians as primitives for efficient radiance field representation, enabling differentiable rendering and optimization. By incorporating semantic information via neural density estimation, GSS achieves robust pose estimation and scene understanding even in low-texture or relighting scenarios. Extensive experiments on benchmark datasets demonstrate that GSS outperforms state-of-the-art methods in accuracy, speed, and rendering quality, paving the way for AR/VR applications requiring immersive, interactive environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
