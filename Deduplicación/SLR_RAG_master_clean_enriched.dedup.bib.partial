 pages = {358--368},
 publisher = {Association for Computing Machinery},
 series = {{ICTIR}},
 title = {A {Large}},
 url = {https://doi.org/10.1145/3731120.3744605},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:15:44Z},
 year = {2025}
}

@inproceedings{uprety_using_2025,
 abstract = {Recommendation systems have become ubiquitous in various online platforms, influencing user experiences and decisions. However, these systems often exhibit biases that can lead to unfair outcomes, such as amplifying stereotypes or marginalizing certain groups. This paper provides a comprehensive survey of methods to mitigate bias in recommendation systems. We categorize existing approaches into three main types: data-level, model-level, and post-processing techniques. For each category, we discuss key methodologies, their strengths, limitations, and evaluation metrics. Additionally, we highlight open challenges, including the trade-off between fairness and accuracy, multi-stakeholder fairness, and the need for real-world deployment considerations. Our survey aims to guide researchers and practitioners in developing more equitable recommendation systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Uprety},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3701716.3717752},
