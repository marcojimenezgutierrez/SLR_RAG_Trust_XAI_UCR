@inproceedings{phukon_localized_2024,
 abstract = {The rapid growth of Internet of Things (IoT) devices has led to increased concerns about security and privacy in data transmission. This paper proposes a novel hybrid encryption scheme combining Advanced Encryption Standard (AES) with Elliptic Curve Cryptography (ECC) to enhance secure data transmission in IoT networks. The proposed approach leverages the efficiency of AES for symmetric encryption and the strength of ECC for key exchange, reducing computational overhead while maintaining high security levels. Simulation results demonstrate that the scheme achieves a 25% reduction in encryption time compared to traditional RSA-based methods, with no compromise in resistance to common attacks such as man-in-the-middle and brute-force. The method is particularly suitable for resource-constrained IoT devices, ensuring robust protection for sensitive data in real-time applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
