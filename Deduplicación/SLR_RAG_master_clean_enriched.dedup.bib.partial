 publisher = {Association for Computing Machinery},
 series = {{IUI}},
 title = {Unequal {Opportunities}},
 url = {https://doi.org/10.1145/3708359.3712111},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:17:33Z},
 year = {2025}
}

@inproceedings{dumitru_evaluating_2025,
 abstract = {Visual programming languages (VPLs) allow users to create programs by manipulating visual elements rather than writing text-based code. Despite their potential to make programming more accessible, VPLs have not achieved widespread adoption. One possible reason is that existing VPLs do not adequately address the diverse needs of different user groups. To explore this, we conducted a design workshop with 12 participants from various backgrounds, including novices, experts, and domain specialists. During the workshop, participants designed VPLs for different use cases, such as data visualization, game development, and scientific computing. Our analysis of the workshop outcomes reveals key design considerations for VPLs, including the importance of modularity, expressiveness, and learnability. We also identify opportunities for VPLs to support collaborative programming and integration with domain-specific tools. Based on these findings, we propose a framework for designing inclusive VPLs that can adapt to different user needs and contexts.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Dumitru},
 booktitle = {Proceedings of the 2025 {International}},
 doi = {10.1145/3731120.3744606},
