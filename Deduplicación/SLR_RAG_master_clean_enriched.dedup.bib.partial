@inproceedings{pampel_regaining_2025,
 abstract = {The rapid advancement of deep learning techniques has significantly impacted the field of computer vision, particularly in tasks such as visual place recognition (VPR). Traditional VPR methods rely heavily on handcrafted features, which often struggle with challenges like appearance changes, viewpoint variations, and seasonal differences. Recent approaches have leveraged deep learning to extract robust image representations, yet they frequently overlook the semantic content of scenes, leading to suboptimal performance in complex environments. This paper proposes a novel framework that integrates semantic segmentation with deep learning-based VPR to enhance recognition accuracy. By incorporating semantic information, our method captures higher-level scene understanding, making it more resilient to environmental variations. We evaluate our approach on benchmark datasets such as Pittsburgh250k and Mapillary SLS, demonstrating significant improvements over state-of-the-art methods in terms of recall and precision. Our findings highlight the potential of semantic-aware VPR for applications in autonomous navigation and robotics.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
