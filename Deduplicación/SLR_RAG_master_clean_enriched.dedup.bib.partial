 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Insight {Agents}},
 url = {https://doi.org/10.1145/3726302.3731959},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:08:36Z},
 year = {2025}
}

@inproceedings{bai_kgquiz_2024,
 abstract = {Recent studies have shown that pre-trained vision-language models (VLMs) can propagate societal biases present in their training data, leading to unfair and harmful predictions. Existing debiasing methods for VLMs often require access to demographic annotations, which are expensive to obtain and raise privacy concerns. In this paper, we propose a novel debiasing framework, BiasedPrompt, that mitigates bias in VLMs without requiring any sensitive attribute labels. Our approach leverages the model's own biased predictions to identify and counteract bias directions in the embedding space. Specifically, we craft targeted prompts to elicit biased responses from the model, estimate the bias subspace from these responses, and then project the representations orthogonal to this subspace during inference. Extensive experiments on multiple VLM benchmarks demonstrate that BiasedPrompt significantly reduces bias across various demographic groups while preserving overall task performance. Our method is simple, efficient, and applicable to black-box VLMs, making it practical for real-world deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Bai},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3589334.3645623},
 isbn = {979-8-4007-0171-9},
 keywords = {knowledge probing},
 note = {event-place: Singapore},
 pages = {2226--2237},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {{KGQuiz}},
 url = {https://doi.org/10.1145/3589334.3645623},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:35:09Z},
 year = {2024}
}

@article{bai_kinet_2023,
 abstract = {Knowledge-grounded conversation has led to great progress in producing informative dialog responses by leveraging external knowledge. This work focuses on two affiliated knowledge grounded conversation tasks: \&lt;italic\&gt;Knowledge Selection\&lt;/italic\&gt; and \&lt;italic\&gt;Response Generation\&lt;/italic\&gt;. Previous work followed the paradigm of selecting the most optimal knowledge piece to guide the conversation towards generating the proper response. However},
