 keywords = {data preprocessing},
 note = {event-place: Barcelona},
 pages = {3690--3701},
 publisher = {Association for Computing Machinery},
 series = {{KDD}},
 title = {Efficient {Mixture}},
 url = {https://doi.org/10.1145/3637528.3671873},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:58:32Z},
 year = {2024}
}

@inproceedings{yan_generative_2024,
 abstract = {Vision-language models (VLMs) have achieved remarkable success in various vision tasks. However, they often inherit and amplify societal biases from their training data, leading to unfair outcomes for certain demographic groups. Existing debiasing methods for VLMs are limited in their effectiveness and generalizability. In this paper, we propose a novel debiasing framework, Biased Prompt Tuning (BPT), which leverages the power of prompt tuning to mitigate biases in VLMs. Specifically, we first identify biased prompts that elicit biased responses from the model. Then, we fine-tune the model using these biased prompts paired with debiased target outputs, encouraging the model to ignore bias-related cues. Extensive experiments on multiple VLM benchmarks demonstrate that BPT significantly reduces both explicit and implicit biases while maintaining or even improving task performance. Our approach is simple, effective, and applicable to a wide range of VLMs without requiring access to the model's parameters.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Yan},
 booktitle = {Proceedings of the 14th {Learning}},
 doi = {10.1145/3636555.3636856},
