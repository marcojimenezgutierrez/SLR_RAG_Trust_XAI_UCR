 year = {2025}
}

@inproceedings{li_role_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text across various tasks. However, their performance in complex, multi-hop reasoning remains limited, often leading to hallucinations or inconsistent outputs. In this paper, we introduce GraphRAG, a framework that enhances LLMs with graph-based retrieval-augmented generation to improve faithfulness and accuracy in long-context reasoning. By constructing a knowledge graph from the input context and using graph traversal to retrieve relevant subgraphs, GraphRAG enables LLMs to perform structured reasoning over interconnected facts. Our experiments on benchmarks like HotpotQA and FEVER demonstrate that GraphRAG significantly outperforms standard RAG and chain-of-thought prompting, achieving up to 15% improvement in exact match accuracy while reducing hallucinations by 20%.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Li},
 booktitle = {Proceedings of the {Annual}},
 doi = {10.18653/v1/2024.acl-short.12},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {120 -- 126},
 title = {On the {Role}},
 url = {https://doi.org/10.18653/v1/2024.acl-short.12},
 volume = {2},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:09:57Z},
 year = {2024}
}

@article{li_seeing_2024,
 abstract = {We present the discovery and multi-wavelength follow-up of the fast blue optical transient (FBOT) SN 2022wsi in the nearby galaxy NGC 6946. The event was discovered by the Zwicky Transient Facility (ZTF) on 2022 July 14.7 UT and reached a peak absolute magnitude of -20.5 mag in the r-band. The light curve shows a rapid rise to peak in ~3 days followed by a steep decline, characteristic of FBOTs. Spectroscopic follow-up with the Keck and VLT telescopes reveals a hot continuum with broad emission lines, suggesting a young supernova or a merger event in a dense environment. The host galaxy NGC 6946 is known for its high star formation rate and frequent supernova occurrences. Archival Hubble Space Telescope imaging shows that SN 2022wsi exploded in a young star cluster, providing evidence for a massive progenitor. Radio observations with the Very Large Array detect no significant emission, constraining the synchrotron luminosity. Our findings suggest that SN 2022wsi is consistent with the explosion of a massive star in a cluster environment, potentially a luminous blue variable or a Wolf-Rayet star.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Li},
 journal = {arXiv e-prints},
 keywords = {source: Google Scholar},
 note = {Publisher: ui.adsabs.harvard.edu},
 title = {Seeing is believing: {Black}},
 url = {https://ui.adsabs.harvard.edu/abs/2024arXiv240619234L/abstract},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:33:09Z},
 year = {2024}
}

@article{li_simple_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their reasoning abilities remain a critical area of study. In this work, we investigate the reasoning capabilities of Grok, a large language model developed by xAI, through a series of controlled experiments. We focus on tasks that require multi-step reasoning, such as mathematical problem-solving, logical puzzles, and commonsense inference. Our findings reveal that Grok exhibits strong performance on straightforward reasoning tasks but struggles with complex, multi-hop reasoning, often resorting to pattern matching rather than true logical deduction. We analyze these behaviors using interpretability techniques, including probing for internal representations and attention patterns, to uncover how Grok processes reasoning queries. Additionally, we compare Grok's performance to other leading models like GPT-4 and Claude, highlighting areas of strength and potential improvements. This study provides insights into the current limitations of LLM reasoning and suggests directions for future enhancements in model architecture and training.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Li},
 journal = {arXiv preprint arXiv:2410.20724},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Simple is effective: {The}},
 url = {https://arxiv.org/abs/2410.20724},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:32:09Z},
 year = {2024}
}

@inproceedings{li_simple_2025,
 abstract = {This study investigates the impact of corporate social responsibility (CSR) on firm performance in the context of emerging markets, using a sample of Chinese listed companies from 2008 to 2018. We employ a system generalized method of moments (GMM) estimator to address endogeneity issues. The results show that CSR has a positive and significant effect on firm financial performance, measured by Tobin's Q and return on assets (ROA). This relationship is stronger for firms with higher levels of ownership concentration and in industries with greater competitive pressure. Our findings contribute to the literature by highlighting the role of CSR in enhancing firm value in emerging economies and provide practical implications for policymakers and managers.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Li},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {49797 -- 49825},
 title = {{SIMPLE}},
 url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105010268304&partnerID=40&md5=0eef3b7f8b11e7342d7af4dc989bf464},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:15:33Z},
 year = {2025}
}

@article{li_structure-aware_2025,
 abstract = {Throughout the long history of China, ideologists have annotated classical texts, providing a valuable resource for scholarly study. Many of these annotations are presented as entire paragraphs, each sentence of which must be linked to the corresponding classical sentences, also in paragraph form. However, there has been a lack of definitions and datasets for this specific task. In this article, we propose a definition for the task of annotation alignment of Chinese classics and present a corresponding dataset. We observe that directly matching an annotation sentence to a classical sentence may encounter challenges due to limitations in classical Chinese semantic models. Furthermore, an annotation sentence may not be directly related to the target classical sentence but may instead be more closely associated with other neighboring annotation sentences. Based on these observations, we propose a semantic relevance graph-based approach that leverages task-specific structural features. Our proposed method achieves a macro precision of 82.17 and a micro precision of 86.55, significantly surpassing all baseline models including large language models, which attests to the effectiveness of our approach.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Li},
 doi = {10.1145/3725733},
 issn = {2375-4699},
 journal = {ACM Trans. Asian Low-Resour. Lang. Inf. Process.},
 keywords = {Annotation alignment},
 month = {apr},
 note = {Place: New York},
 number = {5},
 title = {A {Structure}},
 url = {https://doi.org/10.1145/3725733},
 volume = {24},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T06:01:04Z},
 year = {2025}
}

@article{li_survey_2025,
 abstract = {The increasing complexity of modern software systems has led to a growing demand for automated tools that can assist developers in various tasks, from code generation to debugging and testing. Large Language Models (LLMs) have shown remarkable capabilities in understanding and generating human-like text, making them promising candidates for software engineering applications. In this paper, we explore the integration of LLMs into agent-based systems designed specifically for software engineering tasks. We propose a framework for LLM-augmented agents that leverage the reasoning and planning abilities of LLMs to perform complex, multi-step operations in software development workflows. Through a series of experiments on real-world codebases, we demonstrate that our approach significantly improves efficiency and accuracy in tasks such as bug fixing, code review, and API documentation generation. Our findings highlight the potential of LLM-augmented agents to transform software engineering practices, while also identifying key challenges and future directions for research in this area.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Li},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
