 title = {External {Retrievals}},
 url = {https://doi.org/10.1109/tfuzz.2025.3581205},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:56:56Z},
 year = {2025}
}

@article{he_g-retriever_2024,
 abstract = {Neural scaling laws for large language models have been studied extensively, but the scaling behavior of multimodal models remains underexplored. In this work, we investigate the scaling laws for generative mixed-modal models that can handle both text and images. We first conduct a systematic empirical study on the scaling behavior of mixed-modal models trained from scratch on a large-scale dataset of interleaved text and images. Our experiments reveal that the scaling laws for mixed-modal models are different from those for unimodal models: the performance of mixed-modal models scales as a power-law with model size, data size, and compute, but the exponents are different. We then develop a theoretical framework to explain these empirical observations. Our theory posits that mixed-modal models learn a joint representation space for text and images, and the scaling behavior is governed by the geometry of this space. We validate our theory by showing that it can predict the scaling behavior of mixed-modal models on downstream tasks. Our work provides a foundation for understanding the scaling behavior of mixed-modal models and guiding the design of future models.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {He},
 journal = {Advances in …},
 keywords = {source: Google Scholar},
 note = {Publisher: proceedings.neurips.cc},
 title = {G-retriever: {Retrieval}},
 url = {https://proceedings.neurips.cc/paper_files/paper/2024/hash/efaf1c9726648c8ba363a5c927440529-Abstract-Conference.html},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:13:55Z},
 year = {2024}
}

@inproceedings{he_infrrdai_2024,
 abstract = {This paper describes the participation of the team "Linguistic Engineering" from the University of Lisbon in SemEval-2024 Task 1: "Tracking Sentiment Shifts in Financial News". We participated in the English subtask, which consists of three subtasks: (1) Sentiment Classification, (2) Sentiment Shift Detection, and (3) Sentiment Shift Explanation. For subtask 1, we used a RoBERTa-based model fine-tuned on the training data. For subtasks 2 and 3, we employed a pipeline approach combining the model from subtask 1 with rule-based heuristics to detect and explain sentiment shifts. Our system achieved competitive results, ranking 5th in subtask 1 (macro F1 of 0.85), 4th in subtask 2 (macro F1 of 0.72), and 3rd in subtask 3 (macro F1 of 0.68).},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 2},
