@article{sun_application_2024,
 abstract = {Visual Question Answering (VQA) has seen significant advancements, yet models often struggle with complex reasoning and exhibit biases. This paper introduces a novel approach to enhance VQA performance by integrating structured knowledge graphs with multimodal transformers. We propose GraphVQA, a framework that leverages graph neural networks to model relational dependencies in visual scenes, combined with a cross-modal attention mechanism for question-image alignment. Extensive experiments on VQA v2.0 and GQA datasets show that GraphVQA outperforms state-of-the-art methods by up to 5.2% in accuracy, particularly in scenarios requiring multi-hop reasoning. Our ablation studies highlight the contributions of graph integration and attention fusion, paving the way for more interpretable and robust VQA systems.},
