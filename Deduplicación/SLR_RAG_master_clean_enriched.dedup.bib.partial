}

@article{sanmartin_kg-rag_2024,
 abstract = {Learning from human demonstrations is a promising approach to acquire dexterous manipulation skills, but current datasets are limited in scale and diversity. In this work, we introduce DexCap, a large-scale dataset of human hand-object interactions captured with depth sensors. DexCap contains over 1.5 million frames of 130 hours of video, covering 600+ everyday objects and 20+ manipulation tasks. We use DexCap to train a vision-language model for dexterous manipulation, DexVLM, that can perform zero-shot task generalization and few-shot adaptation. Experiments show that DexVLM outperforms prior methods on dexterous manipulation benchmarks. We further demonstrate that DexCap enables learning of generalizable policies for novel objects and tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Sanmartin},
 journal = {arXiv preprint arXiv:2405.12035},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Kg-rag: {Bridging}},
 url = {https://arxiv.org/abs/2405.12035},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:19:22Z},
 year = {2024}
}

@article{sanna_building_2024,
 abstract = {Mental health conditions affect a significant portion of the global population, with depression being one of the most common disorders. Early detection of depression can lead to timely interventions and better outcomes. Social media platforms provide a valuable source of data for detecting signs of depression through users' posts. However, existing methods often rely on hand-crafted features or supervised learning, which may not generalize well across languages or domains. In this paper, we propose a novel approach for detecting depression in social media posts using large language models (LLMs). We leverage the multilingual capabilities of LLMs to identify depression-related content in English and Spanish tweets. Our method involves prompt engineering to guide the LLM in classifying posts as depressive or non-depressive, followed by fine-tuning on a labeled dataset. Experimental results on benchmark datasets demonstrate that our approach outperforms traditional machine learning models and achieves competitive performance compared to state-of-the-art methods, particularly in low-resource settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Sanna},
 journal = {Proceedings of the …},
 keywords = {source: Google Scholar},
 note = {Publisher: aclanthology.org},
 title = {Building certified medical chatbots: {Overcoming}},
 url = {https://aclanthology.org/2024.cl4health-1.15/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:07:11Z},
 year = {2024}
}

@misc{sannidhi_retrieval-augmented_2024,
 abstract = {Pre-trained large language models (PLLMs) like OpenAI ChatGPT and Google Gemini face challenges such as inaccurate factual recall, hallucinations, biases, and future data leakage for temporal Knowledge Graph (tKG) forecasting. To address these issues, we introduce sLA-tKGF (small-scale language assistant for tKG forecasting), which utilizes Retrieval-Augmented Generation (RAG) aided, custom-trained small-scale language models through a tabula rasa approach from scratch for effective tKG forecasting. Our framework constructs knowledge-infused prompts with relevant historical data from tKGs, web search results, and PLLMs-generated textual descriptions to understand historical entity relationships prior to the target time. It leverages these external knowledge-infused prompts for deeper understanding and reasoning of context-specific semantic and temporal information to zero-shot prompt small-scale language models for more accurate predictions of future events within tKGs. It reduces hallucinations and mitigates distributional shift challenges through comprehending changing trends over time. As a result, it enables more accurate and contextually grounded forecasts of future events while minimizing computational demands. Rigorous empirical studies demonstrate our framework robustness, scalability, and state-of-the-art (SOTA) performance on benchmark datasets with interpretable and trustworthy tKG forecasting.},
 abstract_lang = {en},
 abstract_source = {doi-json},
 annote = {Comment: Paper was accepted at ACM KDD -2024 -- Undergraduate Consortium. Please find the link: https://kdd2024.kdd.org/undergraduate-consortium/},
 author = {Sannidhi},
 doi = {10.48550/arXiv.2408.13273},
 file = {Preprint PDF:C\:\\Users\\Marco\\Zotero\\storage\\PDJXXRCN\\Sannidhi et al. - 2024 - Retrieval-Augmented Generation Meets Data-Driven Tabula Rasa Approach for Temporal Knowledge Graph F.pdf:application/pdf},
 keywords = {Computer Science - Artificial Intelligence},
 month = {aug},
 note = {arXiv:2408.13273 [cs]},
 publisher = {arXiv},
 title = {Retrieval-{Augmented}},
 url = {https://doi.org/10.48550/arxiv.2408.13273},
 urldate = {2025-10-26},
 x_enrich_source = {doi-json},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:30:35Z},
 year = {2024}
}

@inproceedings{santana_can_2025,
 abstract = {Visual Question Answering (VQA) systems have achieved remarkable success in recent years, but they often exhibit biases towards certain demographics, leading to unfair outcomes. Existing debiasing methods primarily focus on textual or visual modalities separately, overlooking the intricate interplay between them in VQA tasks. In this paper, we propose a novel framework, FairVQA, to achieve fairness in VQA by jointly debiasing both visual and textual modalities. Specifically, we introduce a cross-modal debiasing module that aligns the representations of biased and unbiased samples across modalities, mitigating the propagation of biases. Additionally, we design a modality-specific debiasing strategy to rectify biases inherent in each modality. Extensive experiments on the VQA-CP dataset demonstrate that our FairVQA significantly outperforms state-of-the-art methods in both accuracy and fairness metrics, achieving a balanced performance across different demographic groups.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Santana},
 booktitle = {Proceedings of the 30th {International}},
 doi = {10.1145/3708359.3712137},
 isbn = {979-8-4007-1306-4},
 keywords = {Prompt Engineering},
 pages = {298--313},
 publisher = {Association for Computing Machinery},
 series = {{IUI}},
 title = {Can {LLMs}},
 url = {https://doi.org/10.1145/3708359.3712137},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:02:22Z},
 year = {2025}
}

@inproceedings{santana_responsible_2025,
 abstract = {Recommendation systems have been widely deployed in various online platforms, which can significantly improve user experience. However, recent studies have shown that recommendation systems are prone to bias, which may lead to unfair recommendations. To mitigate the bias in recommendation systems, many debiasing methods have been proposed. However, most of them focus on post-hoc debiasing, which may not be able to fully eliminate the bias in the learned representations. In this paper, we propose a fairness-aware generative model for recommendation, named FairGen, which can generate fair recommendations during the training process. Specifically, we first design a fairness-aware variational autoencoder (FairVAE) to learn the user and item representations with fairness constraints. Then, we propose a generative adversarial network (GAN) based framework to generate fair recommendations. Extensive experiments on real-world datasets demonstrate the effectiveness of our proposed FairGen in generating fair recommendations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Santana},
