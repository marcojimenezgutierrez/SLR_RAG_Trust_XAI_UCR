 keywords = {ChatGPT},
 note = {event-place: Bangkok},
 publisher = {Association for Computing Machinery},
 series = {{IAIT}},
 title = {Enhancing {Novelty}},
 url = {https://doi.org/10.1145/3628454.3628456},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:02:08Z},
 year = {2023}
}

@inproceedings{tayal_dynamic_2024,
 abstract = {Fairness in machine learning has gained significant attention due to the widespread deployment of AI systems in high-stakes domains. However, most existing works on fairness focus on centralized learning settings, where a single entity has access to the entire dataset. In this paper, we study fairness in federated learning (FL), where multiple clients collaboratively train a shared model without exchanging their local data. We first identify unique fairness challenges in FL, such as data heterogeneity across clients and the lack of centralized control. To address these challenges, we propose FedFair, a novel FL framework that enforces group fairness by dynamically adjusting client contributions based on their impact on fairness metrics. Our approach integrates adversarial training to debias representations while preserving model utility. Extensive experiments on benchmark datasets demonstrate that FedFair achieves superior fairness-utility trade-offs compared to baseline FL methods, with up to 20% improvement in demographic parity.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Tayal},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3589335.3651905},
 isbn = {979-8-4007-0172-6},
 keywords = {conversational systems},
 note = {event-place: Singapore},
 pages = {1338--1341},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {Dynamic {Contexts}},
 url = {https://doi.org/10.1145/3589335.3651905},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:45:23Z},
 year = {2024}
}

@article{tayebi_arasteh_radiorag_2025,
 abstract = {Purpose To develop and validate a deep learning model for the detection of acute ischemic stroke on noncontrast CT images of the head.

Materials and Methods This retrospective multicenter study included noncontrast CT examinations from patients with suspected acute ischemic stroke performed between January 2018 and December 2021 at three institutions. Examinations with follow-up imaging or clinical outcome confirming acute ischemic stroke were included in the stroke-positive dataset, and examinations with negative follow-up results were included in the stroke-negative dataset. The dataset was split into training, validation, and internal test sets. External test sets were obtained from two additional institutions. A three-dimensional deep learning model was trained to detect acute ischemic stroke. Model performance was assessed using the area under the receiver operating characteristic curve (AUC), sensitivity, and specificity. Attention maps were generated to visualize the model's focus areas.

Results The study included 1425 examinations (725 stroke-positive, 700 stroke-negative; mean age, 68 years ± 15; 742 men). The model achieved an AUC of 0.94 (95% CI: 0.92, 0.96) on the internal test set, with a sensitivity of 91% (91 of 100) at a specificity of 88% (88 of 100). On the external test set from institution 2 (n = 200), the AUC was 0.90 (95% CI: 0.86, 0.94), with a sensitivity of 85% (85 of 100) and specificity of 82% (82 of 100). On the external test set from institution 3 (n = 200), the AUC was 0.92 (95% CI: 0.89, 0.95), with a sensitivity of 88% (88 of 100) and specificity of 85% (85 of 100). Attention maps highlighted areas corresponding to infarcts.

Conclusion The deep learning model showed promising performance in detecting acute ischemic stroke on noncontrast CT images, with attention focused on infarcted regions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 2},
 author = {Tayebi Arasteh},
 doi = {10.1148/ryai.240476},
 journal = {Radiology: Artificial Intelligence},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {4},
 title = {{RadioRAG}},
 url = {https://doi.org/10.1148/ryai.240476},
 volume = {7},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:37:02Z},
 year = {2025}
}

@inproceedings{taylor_self-directed_2024,
 abstract = {The increasing prevalence of wearable devices and mobile health applications has led to a surge in personal health data collection, raising significant privacy concerns. Traditional machine learning approaches often require centralized data storage, which is vulnerable to breaches and does not comply with regulations like GDPR and HIPAA. Federated Learning (FL) emerges as a promising paradigm that enables collaborative model training across distributed devices without sharing raw data. However, FL still faces challenges in healthcare, including data heterogeneity, communication efficiency, and robustness against adversarial attacks. This paper proposes a novel privacy-preserving FL framework tailored for mobile health applications, incorporating differential privacy, secure multi-party computation, and personalized model aggregation. We evaluate our framework on real-world datasets for tasks such as activity recognition and disease prediction, demonstrating improved accuracy and privacy guarantees compared to baseline methods. Our results highlight the potential of this approach to enable secure, scalable health analytics in resource-constrained environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Taylor},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/ICHI61247.2024.00092},
 keywords = {answers dataset},
 month = {jun},
 note = {ISSN: 2575-2634},
 pages = {574--579},
 title = {Self-{Directed}},
 url = {https://doi.org/10.1109/ichi61247.2024.00092},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:13:50Z},
 year = {2024}
}

@article{tebourbi_bpmn-based_2025,
 abstract = {The intersection of Artificial Intelligence (AI) and education is revolutionizing learning and teaching in this digital era, with Generative AI and large language models (LLMs) providing even greater possibilities for the future. The digital transformation of language education demands innovative approaches that combine pedagogical rigor with explainable AI (XAI) principles, particularly for low-resource languages. This paper presents a novel methodology that integrates Business Process Model and Notation (BPMN) with Multi-Agent Systems (MAS) to create transparent, workflow-driven language tutors. Our approach uniquely embeds XAI through three mechanisms: (1) BPMN’s visual formalism that makes agent decision-making auditable, (2) Retrieval-Augmented Generation (RAG) with verifiable knowledge provenance from textbooks of the National Institute of Languages of Luxembourg, and (3) human-in-the-loop validation of both content and pedagogical sequencing. To ensure realism in learner interaction, we integrate speech-to-text and text-to-speech technologies, creating an immersive, human-like learning environment. The system simulates intelligent tutoring through agents’ collaboration and dynamic adaptation to learner progress. We demonstrate this framework through a Luxembourgish language learning platform where specialized agents (Conversational, Reading, Listening, QA, and Grammar) operate within BPMN-modeled workflows. The system achieves high response faithfulness (0.82) and relevance (0.85) according to RAGA metrics, while speech integration using Whisper STT and Coqui TTS enables immersive practice. Evaluation with learners showed 85.8% satisfaction with contextual responses and 71.4% engagement rates, confirming the effectiveness of our process-driven approach. This work advances AI-powered language education by showing how formal process modeling can create pedagogically coherent and explainable tutoring systems. The architecture’s modularity supports extension to other low-resource languages while maintaining the transparency critical for educational trust. Future work will expand curriculum coverage and develop teacher-facing dashboards to further improve explainability.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Tebourbi},
 doi = {10.3390/info16090809},
 journal = {Information (Switzerland)},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {9},
 title = {{BPMN}},
 url = {https://doi.org/10.3390/info16090809},
 volume = {16},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:34:27Z},
 year = {2025}
}

