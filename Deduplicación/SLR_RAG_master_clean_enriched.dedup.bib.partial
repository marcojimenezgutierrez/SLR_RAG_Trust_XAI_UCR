 title = {Gender inclusive language generation framework: {A}},
 url = {https://doi.org/10.1016/j.knosys.2025.114092},
 volume = {328},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:33:43Z},
 year = {2025}
}

@inproceedings{shyalika_smartpilotagent-based_2025,
 abstract = {Obesity is a major risk factor for type 2 diabetes, cardiovascular disease, and certain types of cancer. The mechanisms underlying obesity-associated insulin resistance and metabolic dysfunction are incompletely understood. Here we show that obesity promotes the accumulation of senescent cells in adipose tissue and that selective elimination of senescent cells alleviates obesity-induced metabolic dysfunction. We found that high-fat diet (HFD)-induced obesity in mice increases the abundance of senescent cells, as indicated by elevated expression of senescence markers p16^Ink4a^ and p21^Cip1^ and senescence-associated β-galactosidase activity in adipose tissue. Genetic clearance of p16^Ink4a^-positive senescent cells in INK-ATTAC mice attenuated HFD-induced adipose tissue macrophage infiltration and inflammation and improved glucose homeostasis and insulin sensitivity. Similarly, pharmacological elimination of senescent cells using a combination of dasatinib and quercetin (D+Q) reduced adipose tissue senescent cell burden, decreased inflammation and macrophage infiltration, and improved metabolic parameters in obese mice. These findings demonstrate that cellular senescence contributes to obesity-associated metabolic dysfunction and suggest that senolytic interventions may represent a therapeutic strategy for obesity-related metabolic disease.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 address = {Richland},
 author = {Shyalika},
 booktitle = {Proceedings of the 24th {International}},
 isbn = {979-8-4007-1426-9},
 keywords = {agent-based architecture},
 note = {event-place: Detroit},
 pages = {3053--3055},
 publisher = {International Foundation for Autonomous Agents and Multiagent Systems},
 series = {{AAMAS}},
 title = {{SmartPilot}},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:14:19Z},
 year = {2025}
}

@article{sicari_open-ethical_2024,
 abstract = {This survey summarises the most recent methods for building and assessing helpful, honest, and harmless neural language models, considering small, medium, and large-size models. Pointers to open-source resources that help to align pre-trained models are given, including methods that use parameter-efficient techniques, specialized prompting frameworks, adapter modules, case-specific knowledge injection, and adversarially robust training techniques. Special care is given to evidencing recent progress on value alignment, commonsense reasoning, factuality enhancement, and abstract reasoning of language models. Most reviewed works in this survey publicly shared their code and related data and were accepted in world-leading Machine Learning venues. This work aims at helping researchers and practitioners accelerate their entrance into the field of human-centric neural language models, which might be a cornerstone of the contemporary and near-future industrial and societal revolution.},
 abstract_lang = {en},
 abstract_source = {crossref},
