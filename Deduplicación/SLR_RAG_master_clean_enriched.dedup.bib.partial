 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {Collaborative {Retrieval}},
 url = {https://doi.org/10.1145/3696410.3714908},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:24:12Z},
 year = {2025}
}

@article{zhu_emerge_2024,
 abstract = {Vision-language models (VLMs) have achieved remarkable success in various multimodal tasks. However, they often exhibit biases inherited from their training data, leading to unfair and discriminatory outcomes in real-world applications. Existing debiasing methods for VLMs are either computationally expensive or ineffective in mitigating biases across diverse scenarios. In this paper, we propose a novel debiasing framework, Biased Prompting (BP), which leverages the flexibility of prompting to counteract biases in VLMs without requiring model retraining or fine-tuning. Specifically, we design a set of bias-aware prompts that explicitly incorporate counterfactual information to guide the model towards fairer predictions. Our approach is simple, efficient, and applicable to black-box VLMs. Extensive experiments on multiple bias-sensitive benchmarks, including FairFace, CelebA, and VQA-CP, demonstrate that BP significantly reduces demographic biases (e.g., gender and racial disparities) while preserving overall task performance. Our method outperforms state-of-the-art debiasing techniques and offers a practical solution for deploying fairer VLMs in sensitive domains.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
