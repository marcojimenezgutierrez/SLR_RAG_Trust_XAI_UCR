}

@inproceedings{medeiros_tailoring_2025,
 abstract = {The rapid advancement of Industry 4.0 technologies has led to the integration of digital twins in manufacturing processes. This paper proposes a comprehensive digital twin framework for predictive maintenance in smart factories. The framework incorporates real-time data from IoT sensors, machine learning algorithms for anomaly detection, and simulation models for what-if analysis. Case studies demonstrate a 30% reduction in downtime and improved asset utilization. The proposed approach enhances operational efficiency and supports sustainable manufacturing practices.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
