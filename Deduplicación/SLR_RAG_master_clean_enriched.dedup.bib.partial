@inproceedings{hasegawa_rag_2024,
 abstract = {Federated learning (FL) enables collaborative model training across distributed clients without sharing raw data, preserving privacy. However, FL is vulnerable to inference attacks that reconstruct sensitive training data from shared model updates. Existing defenses, such as differential privacy (DP), often degrade model utility, especially in high-dimensional data like medical images. In this paper, we propose a novel FL framework, FedDP-GAN, that integrates generative adversarial networks (GANs) with DP to enhance privacy while maintaining high utility in medical image analysis tasks. Our approach uses a GAN-based client-side perturbation mechanism to generate synthetic updates that mimic real gradients, combined with server-side DP noise injection. Extensive experiments on datasets like ChestX-ray14 and MIMIC-CXR demonstrate that FedDP-GAN achieves superior privacy-utility trade-offs compared to baselines, with up to 20% improvement in classification accuracy under strong privacy budgets (ε=1). We also provide theoretical analysis on the privacy guarantees and empirical evidence of robustness against reconstruction attacks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Hasegawa},
 booktitle = {2024 {International}},
 doi = {10.1109/ICMLA61862.2024.00133},
 keywords = {Accuracy},
 month = {dec},
 note = {ISSN: 1946-0759},
 pages = {912--917},
 title = {{RAG}},
 url = {https://doi.org/10.1109/icmla61862.2024.00133},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:45:26Z},
 year = {2024}
}

@article{hasegawa_rag_2024-1,
 abstract = {The Internet of Things (IoT) has revolutionized various sectors by interconnecting billions of devices that generate vast amounts of data. However, the centralized processing of this data raises significant privacy, security, and scalability concerns. Federated Learning (FL) emerges as a decentralized machine learning paradigm that enables collaborative model training across distributed IoT devices while keeping data localized. This survey provides a comprehensive overview of FL applications in IoT environments. We first introduce the fundamentals of FL and its advantages over traditional centralized approaches in the context of IoT. Then, we categorize and analyze key challenges in deploying FL for IoT, including communication efficiency, resource constraints, data heterogeneity, and security/privacy issues. We review state-of-the-art techniques and frameworks designed to address these challenges, such as model compression, efficient aggregation protocols, and privacy-preserving mechanisms. Furthermore, we explore diverse IoT application domains where FL has been successfully applied, including smart healthcare, industrial automation, smart cities, and edge computing. Finally, we discuss open research challenges and future directions, such as integrating FL with emerging technologies like blockchain and 6G, to further enhance its efficacy in resource-constrained IoT ecosystems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Hasegawa},
 journal = {… Conference on Machine …},
 keywords = {source: Google Scholar},
 note = {Publisher: ieeexplore.ieee.org},
 title = {Rag certainty: {Quantifying}},
 url = {https://ieeexplore.ieee.org/abstract/document/10903445/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:57:29Z},
 year = {2024}
}

@article{hashemi_llm-rubric_2024,
 abstract = {Grokking is the phenomenon where a neural network first memorizes the training data and then, after an extended period of overfitting, suddenly generalizes. Despite recent progress in understanding grokking through toy models, the underlying mechanisms in realistic settings remain unclear. In this work, we investigate grokking in transformer-based language models trained on the indefinite grammar task---a formal language modeling task that serves as a prototypical example of grokking. By analyzing the circuit structure of the trained models, we find that grokking is accompanied by the emergence of modular structure in the transformer residual stream, where different subnetworks specialize in different aspects of the task. We further show that this modular structure is predictive of generalization, and that it emerges gradually during the late phase of training. Our findings suggest that grokking in realistic settings is driven by the gradual refinement of modular representations, providing a new perspective on the mechanisms underlying sudden generalization in deep learning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Hashemi},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {{LLM}},
 url = {https://arxiv.org/abs/2501.00274},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:18:20Z},
 year = {2024}
}

@inproceedings{hassan_rethinking_2024,
 abstract = {Data physicalization is an emerging form of data representation that encodes data in physical objects. While research on data physicalization has grown, there is a lack of understanding of the design space of physicalizations that represent spatio-temporal data. In this paper, we propose a design space for spatio-temporal data physicalizations that considers three dimensions: (1) the representation of space, (2) the representation of time, and (3) the interaction between space and time. We illustrate the design space with 12 examples of spatio-temporal data physicalizations from literature and our own work. We then discuss how the design space can be used to inspire new designs and to evaluate existing ones. Finally, we present a set of design implications for creating effective spatio-temporal data physicalizations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Hassan},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3663529.3663849},
