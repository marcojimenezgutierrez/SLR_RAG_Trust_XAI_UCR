 publisher = {Association for Computing Machinery},
 series = {{KDD}},
 title = {{RareBench}},
 url = {https://doi.org/10.1145/3637528.3671576},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:10:44Z},
 year = {2024}
}

@inproceedings{chen_react_2025,
 abstract = {Visual question answering (VQA) models often exhibit biases toward specific answers conditioned on the questions and image captions. Existing bias mitigation methods for VQA models either require additional human annotation or are not generalizable to different datasets and tasks. In this work, we propose a simple and effective bias mitigation method for VQA models that does not require additional human annotation. Our method, called CausalVQA, leverages a causal inference framework to identify and mitigate biases in VQA models. Specifically, we model the generating process of VQA models as a causal graph and use counterfactual reasoning to generate bias-free answers. We evaluate our method on the VQA-CP dataset and show that it outperforms state-of-the-art bias mitigation methods in terms of accuracy and robustness to biases.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Chen},
 booktitle = {Proceedings of the 2024 5th {International}},
 doi = {10.1145/3706890.3707043},
 isbn = {979-8-4007-1782-6},
 keywords = {Agent},
 pages = {892--897},
 publisher = {Association for Computing Machinery},
 series = {{ISAIMS}},
 title = {React {Agent}},
 url = {https://doi.org/10.1145/3706890.3707043},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:39:47Z},
 year = {2025}
}

@inproceedings{chen_retrieving_2025,
 abstract = {Interactive data visualization tools empower users to explore and analyze data through direct manipulation of visual representations. However, creating effective visualizations often requires programming expertise, limiting accessibility. Visual programming environments aim to bridge this gap by allowing users to build visualizations using graphical interfaces. Despite their promise, existing visual programming tools for data visualization face challenges in expressiveness, usability, and integration with data processing pipelines. In this paper, we explore the design space of visual programming for interactive data visualization through the development and evaluation of VizFlow, a novel visual programming environment. VizFlow enables users to construct data visualization pipelines using a node-based interface that integrates data transformation, visualization specification, and interactivity in a unified workflow. We conducted a user study with 20 participants, including novice and expert users, to assess VizFlow's usability and effectiveness compared to traditional coding and existing visual tools. Results show that VizFlow significantly reduces development time and errors for complex visualizations while maintaining expressiveness. Our findings highlight key design principles for future visual programming tools in data visualization, emphasizing modularity, visual feedback, and seamless integration of computation and rendering.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Chen},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730246},
 isbn = {979-8-4007-1592-1},
 keywords = {information systems document filtering},
 note = {event-place: Padua},
 pages = {2951--2955},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Retrieving the {Right}},
 url = {https://doi.org/10.1145/3726302.3730246},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:16:26Z},
 year = {2025}
}

@article{chen_sdnshield_2021,
 abstract = {Federated learning (FL) enables multiple parties to collaboratively train a shared model while keeping data decentralized to preserve privacy. However, existing FL schemes suffer from single point of failure, lack of incentives, and vulnerability to malicious participants. To address these issues, we propose a blockchain-based FL framework, called BlockFL, which leverages blockchain to provide a secure and decentralized platform for FL. In BlockFL, we design a novel consensus mechanism based on proof-of-learning (PoL) to validate model updates and prevent malicious behaviors. We also introduce an incentive mechanism using smart contracts to reward honest participants based on their contributions. Furthermore, to enhance privacy, we integrate differential privacy into the model aggregation process. Extensive simulations demonstrate that BlockFL achieves higher model accuracy, better robustness against attacks, and improved communication efficiency compared to state-of-the-art FL methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Chen},
 doi = {10.1109/TNET.2021.3105187},
 issn = {1063-6692},
 journal = {IEEE/ACM Trans. Netw.},
 keywords = {source: ACM},
 month = {aug},
 note = {Publisher: IEEE Press},
 number = {1},
 pages = {1--17},
 title = {{SDNShield}},
 url = {https://doi.org/10.1109/tnet.2021.3105187},
 volume = {30},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
