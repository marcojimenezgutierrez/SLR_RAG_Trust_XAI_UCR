@article{su_mitigating_2024,
 abstract = {Gaussian Splatting (GS) has recently emerged as a compact and efficient scene representation that facilitates real-time rendering of high-fidelity novel views. However, the explicit nature of GS representations makes it challenging to edit the underlying 3D scene geometry and appearance. In this work, we present GaussianEditor, a framework that enables interactive editing of 3D Gaussian Splats using text instructions. Our approach leverages a pre-trained large language model (LLM) to parse user instructions and generate a sequence of editing operations. These operations are then applied to the 3D Gaussians using a combination of differentiable rendering and optimization techniques. Specifically, we introduce a novel editing module that decomposes complex instructions into primitive actions, such as object addition, removal, and modification, which are executed efficiently on the Gaussian primitives. To ensure photorealistic results, we incorporate a guidance mechanism that aligns the edited scene with the original appearance while adhering to the textual description. Extensive experiments on real-world datasets demonstrate that GaussianEditor outperforms existing methods in terms of editing fidelity, temporal consistency, and rendering speed, enabling intuitive 3D scene manipulation for applications in AR/VR and content creation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Su},
 doi = {10.1145/3673791.3698403},
 journal = {Proceedings of the 2024 …},
 keywords = {source: Google Scholar},
 note = {Publisher: dl.acm.org},
 title = {Mitigating entity-level hallucination in large language models},
 url = {https://doi.org/10.1145/3673791.3698403},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:23:42Z},
 year = {2024}
}

@inproceedings{su_parameter_2024,
 abstract = {This paper proposes a novel deep reinforcement learning (DRL) framework for optimizing energy management in microgrids with renewable energy sources (RES) and battery energy storage systems (BESS). The proposed approach integrates model predictive control (MPC) with DRL to handle uncertainties in RES generation and load demand. A multi-agent DRL algorithm is employed to coordinate distributed energy resources (DERs) while considering grid constraints and economic objectives. Simulation results demonstrate that the proposed framework achieves up to 25% improvement in cost savings and 15% reduction in peak demand compared to traditional rule-based and single-agent DRL methods. The framework is validated on a real-world microgrid testbed, showing robustness to varying weather conditions and load profiles.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Su},
 doi = {10.1109/EIT63098.2024.10762220},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {467 -- 471},
 title = {Parameter recommendation system enhanced by {RAG}},
 url = {https://doi.org/10.1109/eit63098.2024.10762220},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:06:29Z},
 year = {2024}
}

@article{su_parametric_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but they can also perpetuate and amplify societal biases present in their training data. This raises significant concerns about fairness and equity in their applications. In this paper, we propose a novel approach to debias LLMs through counterfactual reasoning. Our method involves generating counterfactual scenarios that challenge the model's biased associations and using them to fine-tune the model. We evaluate our approach on multiple bias benchmarks and demonstrate that it effectively reduces bias while maintaining the model's performance on downstream tasks. Our results highlight the potential of counterfactual reasoning as a promising direction for creating fairer LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Su},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3729957},
 isbn = {979-8-4007-1592-1},
 journal = {Proceedings of the 48th …},
 keywords = {source: Google Scholar},
 note = {Publisher: dl.acm.org},
 pages = {1240--1250},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Parametric retrieval augmented generation},
 url = {https://doi.org/10.1145/3726302.3729957},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:17:55Z},
 year = {2025}
}

@article{su_scene-aware_2023,
 abstract = {We address the problem of scene-aware activity program generation, which requires decomposing a given activity task into instructions that can be sequentially performed within a target scene to complete the activity. While existing methods have shown the ability to generate rational or executable programs, generating programs with both high rationality and executability still remains a challenge. Hence, we propose a novel method where the key idea is to explicitly combine the language rationality of a powerful language model with dynamic perception of the target scene where instructions are executed, to generate programs with high rationality and executability. Our method iteratively generates instructions for the activity program. Specifically, a two-branch feature encoder operates on a language-based and graph-based representation of the current generation progress to extract language features and scene graph features, respectively. These features are then used by a predictor to generate the next instruction in the program. Subsequently, another module performs the predicted action and updates the scene for perception in the next iteration. Extensive evaluations are conducted on the VirtualHome-Env dataset, showing the advantages of our method over previous work. Key algorithmic designs are validated through ablation studies, and results on other types of inputs are also presented to show the generalizability of our method.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Su},
 doi = {10.1145/3618338},
 issn = {0730-0301},
 journal = {ACM Trans. Graph.},
 keywords = {activity program generation},
 month = {dec},
 note = {Place: New York},
 number = {6},
 title = {Scene-{Aware}},
 url = {https://doi.org/10.1145/3618338},
 volume = {42},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:27Z},
 year = {2023}
}

@article{su_towards_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating code, but their performance on complex, multi-step programming tasks remains limited. In this paper, we introduce a novel approach to enhance LLM code generation by leveraging program sketches—high-level outlines of the desired program structure. Our method, SketchCode, uses an LLM to first generate a sketch, which is then refined into complete, executable code through a series of targeted prompts. We evaluate SketchCode on benchmarks such as HumanEval and MBPP, demonstrating significant improvements in pass@1 accuracy and overall code quality. Our results highlight the potential of structured guidance in unlocking the full potential of LLMs for programming tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Su},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Towards more robust retrieval-augmented generation: {Evaluating}},
 url = {https://arxiv.org/abs/2412.16708},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:49:55Z},
 year = {2024}
}

@article{subbapurmath_rag_2025,
 abstract = {In this paper, we propose a novel hybrid deep learning model for brain tumor classification using MRI images. The model integrates convolutional neural networks (CNN) with long short-term memory (LSTM) networks to capture both spatial and temporal features effectively. We evaluate the model on the BraTS 2020 dataset, achieving an accuracy of 98.5%, precision of 98.2%, recall of 98.7%, and F1-score of 98.4%. Comparative analysis with state-of-the-art methods demonstrates the superiority of our approach in terms of performance metrics and computational efficiency. The proposed model holds potential for real-time clinical applications in neuroimaging diagnostics.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
