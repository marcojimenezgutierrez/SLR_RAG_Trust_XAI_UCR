 year = {2025}
}

@article{jing_when_2025,
 abstract = {This paper proposes a novel framework for multimodal AI-driven content generation in multimedia applications. We introduce a hybrid model combining transformer-based architectures with diffusion processes to enhance realism and coherence in generated videos and images. Experimental results on benchmark datasets demonstrate superior performance in terms of FID scores and user satisfaction metrics compared to existing methods. The framework is designed for scalability, supporting real-time applications in virtual reality and augmented environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
