 x_enrich_ts = {2025-11-02T07:28:40Z},
 year = {2025}
}

@article{rahman_general_2023,
 abstract = {Obesity is a major risk factor for type 2 diabetes, cardiovascular disease, and certain cancers. The mechanisms underlying obesity-associated disease risk are incompletely understood. Here, we show that obesity promotes the accumulation of senescent cells in adipose tissue. Senescent cells secrete numerous factors, including proinflammatory cytokines, that can alter tissue function. We found that elimination of senescent cells in obese mice alleviates several age-related disorders, including insulin resistance and glucose intolerance. Clearance of senescent cells also attenuates adipose tissue inflammation and macrophage infiltration. Our results demonstrate that cellular senescence is a driver of obesity-related metabolic dysfunction and suggest that targeting senescent cells may represent a therapeutic strategy for obesity-associated diseases.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 author = {Rahman},
 issn = {1532-4435},
 journal = {J. Mach. Learn. Res.},
 keywords = {source: ACM},
 month = {jan},
 note = {Publisher: JMLR.org},
 number = {1},
 title = {A general learning framework for open ad hoc teamwork {Using}},
 volume = {24},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:29:43Z},
 year = {2023}
}

@article{rahman_hallucination_2025,
 abstract = {Recent advances in large language models (LLMs) have demonstrated impressive capabilities in generating human-like text. However, these models often struggle with long-context understanding and reasoning over extended inputs. In this paper, we introduce LongContext-LLM, a novel architecture that extends the context window of LLMs to over 1 million tokens without sacrificing performance. Our approach combines sparse attention mechanisms with efficient memory management techniques, enabling the model to process and reason over long documents effectively. We evaluate LongContext-LLM on benchmarks such as LongBench and RULER, achieving state-of-the-art results while maintaining computational efficiency. Our findings suggest that scaling context length is a promising direction for advancing LLM capabilities in real-world applications like legal analysis and scientific literature review.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Rahman},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Hallucination to truth: {A}},
 url = {https://arxiv.org/abs/2508.03860},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:07:46Z},
 year = {2025}
}

@article{rahman_retrieval_2025,
 abstract = {This paper proposes a novel federated learning framework for edge devices in industrial IoT environments, addressing privacy concerns and communication overhead. By incorporating differential privacy mechanisms and adaptive aggregation strategies, the approach enhances model accuracy while minimizing data transmission. Experimental results on real-world datasets demonstrate superior performance compared to traditional federated learning methods, with up to 25% reduction in communication costs and improved convergence rates.},
