@article{mohsin_retrieval_2025,
 abstract = {This paper proposes a novel framework for enhancing security in IoT networks using blockchain and machine learning techniques. We address the challenges of data privacy and integrity by integrating federated learning with a distributed ledger system. Through extensive simulations, our approach demonstrates improved detection accuracy and reduced latency compared to traditional methods. The results indicate potential scalability for real-world deployments in smart cities and industrial applications.},
 abstract_lang = {en},
