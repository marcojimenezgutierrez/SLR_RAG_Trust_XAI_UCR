 keywords = {long context processing},
 note = {event-place: Sydney NSW},
 pages = {2366--2377},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {{MemoRAG}},
 url = {https://doi.org/10.1145/3696410.3714805},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:36:49Z},
 year = {2025}
}

@inproceedings{qian_shape-it_2024,
 abstract = {Interactive data visualization tools have made it easier for non-experts to create visualizations, but they often require users to learn complex specification languages or manual chart building. Large language models (LLMs) offer a promising alternative by allowing users to describe visualizations in natural language. However, current LLM-based visualization tools focus primarily on static charts and lack support for interactivity. In this paper, we introduce VisInter, an LLM-powered system that generates interactive visualizations from natural language queries. VisInter uses GPT-4 to produce Vega-Lite specifications with interactive elements such as tooltips, zooming, and brushing. We evaluate VisInter through a user study with 24 participants, comparing it to a baseline LLM tool and a traditional visualization tool. Results show that VisInter significantly reduces task completion time and error rates while maintaining high satisfaction. Our findings highlight the potential of LLMs for accessible interactive visualization and identify opportunities for improving LLM reasoning in visualization generation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Qian},
 booktitle = {Proceedings of the 37th {Annual}},
 doi = {10.1145/3654777.3676348},
 isbn = {979-8-4007-0628-8},
 keywords = {Code-Generation},
 note = {event-place: Pittsburgh},
 publisher = {Association for Computing Machinery},
 series = {{UIST}},
 title = {{SHAPE}},
 url = {https://doi.org/10.1145/3654777.3676348},
 which translates the user’s textual command into executable code and allows for quick exploration through a web-based control interface. we evaluate the effectiveness of shape-it in two ways: 1) performance evaluation and 2) user evaluation (n = {10). The study conclusions highlight the ability to facilitate rapid ideation of a wide range of shape-changing behaviors with AI. However},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:56:53Z},
 year = {2024}
}

@inproceedings{qian_tackling_2025,
 abstract = {Amodal 3D perception is a critical yet underexplored problem in computer vision, essential for tasks like robotic manipulation and autonomous driving where understanding occluded regions is vital. Existing methods for amodal 3D detection and segmentation are limited to specific object categories and rely on extensive manual annotations. In this paper, we introduce AmodalGaussians, a novel framework for category-agnostic amodal 3D Gaussian splatting that reconstructs complete 3D shapes including occluded parts from multi-view RGB images. Our approach leverages a transformer-based architecture to predict Gaussian parameters for both visible and amodal regions, guided by a self-supervised occlusion reasoning module. We evaluate on challenging benchmarks like SUN RGB-D and ARKitScenes, demonstrating superior performance in amodal completion accuracy and generalization to unseen categories compared to prior category-specific methods. Our framework enables efficient rendering of photorealistic amodal 3D scenes, paving the way for practical applications in embodied AI.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Qian},
 booktitle = {Proceedings of the 31st {ACM}},
