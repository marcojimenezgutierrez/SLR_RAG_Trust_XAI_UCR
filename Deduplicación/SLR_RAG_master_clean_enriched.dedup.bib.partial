 keywords = {domain-specific languages},
 note = {event-place: Linz},
 pages = {596--601},
 publisher = {Association for Computing Machinery},
 series = {{MODELS}},
 title = {On the use of {LLMs}},
 url = {https://doi.org/10.1145/3652620.3687808},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:12:40Z},
 year = {2024}
}

@inproceedings{diaz-de-arcaya_towards_2024,
 abstract = {Visual programming languages (VPLs) promise to make programming more accessible, especially for end-users who are not professional programmers. However, the design space of VPLs for interactive data processing tasks remains underexplored. In this paper, we systematically explore the design space of VPLs for data processing, focusing on three key dimensions: representation, interaction, and computation. We identify 12 design choices across these dimensions and implement five prototypes to evaluate their impact on usability and expressiveness. Through a user study with 24 participants, we find that certain design choices, such as node-based representations and direct manipulation interactions, significantly improve usability for data processing tasks. Our findings reveal important trade-offs and provide design guidelines for creating effective VPLs tailored to interactive data processing.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
