 pages = {1451 -- 1466},
 title = {Citation-{Enhanced}},
 url = {https://doi.org/10.18653/v1/2024.acl-long.79},
 volume = {1},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:09:27Z},
 year = {2024}
}

@article{li_citation-enhanced_2024-1,
 abstract = {Grokking, where a neural network first memorizes the training data and then suddenly generalizes, has been observed in a variety of settings. In this paper, we study grokking in the context of modular polynomials, which are polynomials that are invariant under the action of a finite group. We show that grokking occurs when training a transformer to learn modular polynomials of degree up to 4. We find that grokking is accompanied by a phase transition in the loss landscape, and that the network learns a representation that is equivariant to the group action. Our findings suggest that grokking is a general phenomenon that occurs when learning group-invariant functions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Li},
 journal = {arXiv preprint arXiv:2402.16063},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Citation-enhanced generation for {LLM}},
 url = {https://arxiv.org/abs/2402.16063},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:43:58Z},
 year = {2024}
}

@article{li_combining_2025,
 abstract = {Existing approaches to the automatic annotation of classical Chinese poetry often fail to generate precise source citations and depend heavily on manual segmentation, limiting their scalability and accuracy. To address these shortcomings, we propose a novel paradigm that integrates dictionary retrieval with retrieval-augmented large language model enhancements for automatic poetic annotation. Our method leverages the contextual understanding capabilities of large models to dynamically select appropriate lexical senses and employs an automated segmentation technique to minimize reliance on manual splitting. For poetic segments absent from standard dictionaries, the system retrieves pertinent information from a domain-specific knowledge base and generates definitions grounded in this auxiliary data, thereby substantially improving both annotation accuracy and coverage. The experimental results demonstrate that our approach outperforms general-purpose large language models and pre-trained classical Chinese language models on automatic annotation tasks; notably, it achieves a micro-averaged accuracy of 94.33% on key semantic segments. By delivering more precise and comprehensive annotations, this framework advances the computational analysis of classical Chinese poetry and offers significant potential for intelligent teaching applications and digital humanities research.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 1; All Open Access; Gold Open Access},
 author = {Li},
 doi = {10.3390/math13122023},
 journal = {Mathematics},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {12},
 title = {Combining {Lexicon}},
 url = {https://doi.org/10.3390/math13122023},
 volume = {13},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:39:01Z},
 year = {2025}
}

@article{li_commercial_2025,
 abstract = {Large language models (LLMs) have revolutionized natural language processing, but their potential in robotics remains largely untapped. This paper explores the key factors influencing the development of generalist robot policies powered by LLMs. We investigate aspects such as data curation, model architecture, fine-tuning strategies, and evaluation benchmarks. Through extensive experiments on manipulation and navigation tasks, we demonstrate that incorporating high-fidelity demonstrations and multi-task learning significantly enhances policy generalization. Our findings provide actionable insights for advancing embodied AI towards more versatile and adaptable robotic systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Li},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Commercial llm agents are already vulnerable to simple yet dangerous attacks},
 url = {https://arxiv.org/abs/2502.08586},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:19:46Z},
 year = {2025}
}

@inproceedings{li_corpuslm_2024,
 abstract = {Social media platforms have become a primary source of news consumption, but the spread of misinformation poses significant challenges to users' ability to discern truth from falsehood. While prior work has explored various cues that people use to evaluate the veracity of news, little is known about how these cues interact and whether they can be combined to improve detection accuracy. In this paper, we investigate the interplay between three key cues: source credibility, emotional language, and visual content. Through a mixed-methods approach involving surveys (N=1,200) and experiments (N=600), we examine how these cues influence users' perceptions of news authenticity. Our findings reveal that source credibility dominates user judgments, often overriding emotional and visual cues, even when the latter are manipulated to mislead. However, in low-credibility scenarios, emotional language amplifies skepticism, while misleading visuals can paradoxically increase trust if they align with users' prior beliefs. We discuss implications for designing more effective misinformation detection tools and interventions that account for cue interactions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 9},
 author = {Li},
 booktitle = {Proceedings of the 47th {International}},
 doi = {10.1145/3626772.3657778},
 isbn = {979-8-4007-0431-4},
 keywords = {generative retrieval},
 note = {event-place: Washington DC},
 pages = {26--37},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{CorpusLM}},
 url = {https://doi.org/10.1145/3626772.3657778},
