 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:30:55Z},
 year = {2025}
}

@inproceedings{dai_mitigating_2025,
 abstract = {Interactive data visualization tools empower non-experts to explore and communicate insights from data. However, creating custom visualizations often requires programming expertise, limiting accessibility. Visual programming languages (VPLs) offer a promising alternative by allowing users to construct visualizations through direct manipulation of graphical elements. Despite their potential, designing effective VPLs for data visualization remains underexplored. We investigate the design space of VPLs for interactive data visualization through a systematic literature review and expert interviews. Our analysis identifies key design dimensions, including representation strategies, interaction paradigms, and integration with data processing. We discuss trade-offs and opportunities, providing guidelines for future VPL development to enhance usability and expressiveness in data visualization authoring.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Dai},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730038},
