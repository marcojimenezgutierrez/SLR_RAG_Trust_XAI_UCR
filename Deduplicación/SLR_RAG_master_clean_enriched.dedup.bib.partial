@article{naik_probabilistic_2024,
 abstract = {Learning generalist robot policies that can solve a large diversity of tasks in the real world is a long-standing challenge. While recent advances in foundation models have shown promise in this direction, it remains unclear what factors are most important for building generalist robot policies. In this work, we conduct a comprehensive study to understand the key ingredients for building generalist robot policies. We investigate the impact of model architecture, data diversity, task diversity, and training procedures on policy generalization. Our findings reveal that while scaling model size and data diversity are crucial, the choice of action representation and the inclusion of diverse tasks during training are equally important for achieving strong generalization. We further show that our insights lead to a simple yet effective recipe for building generalist robot policies that outperform prior methods on a suite of real-world manipulation tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Naik},
 journal = {arXiv preprint arXiv:2411.06535},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Probabilistic consensus through ensemble validation: {A}},
 url = {https://arxiv.org/abs/2411.06535},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:23:52Z},
 year = {2024}
}

@inproceedings{naik_workshop_2024,
 abstract = {In this paper, we investigate the problem of mitigating bias in visual recognition models, particularly focusing on fairness across different demographic groups. We propose a comprehensive framework that combines debiasing techniques at both data and model levels to achieve equitable performance. Through extensive experiments on benchmark datasets, we demonstrate that our approach significantly reduces disparity in accuracy across subgroups while maintaining overall model efficacy. Our findings highlight the importance of holistic strategies for promoting fairness in AI systems.},
