@inproceedings{jayawardena_improving_2024,
 abstract = {This paper explores the design and evaluation of a novel haptic interface for virtual reality applications aimed at improving user engagement in therapeutic exercises. We conducted user studies with 30 participants to assess the effectiveness of vibrotactile feedback in simulating physical interactions. Results indicate a 25% increase in task completion rates and higher reported immersion levels compared to non-haptic conditions. Our findings contribute to the growing field of haptic technologies in VR, with implications for rehabilitation and gaming.},
