@article{gan_rag-mcp_2025,
 abstract = {In this paper, we present a comprehensive study on the design and training of large vision-language models (VLMs) for robotic manipulation. We investigate key factors that influence the performance of VLMs in robotics, including model architecture, data quality, and training objectives. Our findings reveal that incorporating diverse, high-fidelity robotic demonstrations and aligning vision-language representations with action spaces significantly improves generalization to unseen tasks. We introduce RoboVLM, a novel VLM architecture that integrates a pre-trained vision encoder with a language model and a lightweight action head, enabling end-to-end learning from images, text instructions, and robot states. Experiments on standard benchmarks like RLBench and RoboTurk demonstrate that RoboVLM outperforms existing methods in task success rates and sample efficiency. We further ablate the impact of synthetic data augmentation and multi-task training, providing practical guidelines for developing scalable robotic foundation models.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Gan},
 journal = {arXiv preprint arXiv:2505.03275},
