 note = {event-place: USA},
 pages = {20--25},
 publisher = {Association for Computing Machinery},
 series = {{WiseML}},
 title = {The {Dual}},
 url = {https://doi.org/10.1145/3733965.3733972},
 x_enrich_source = {x-ai/grok-4-fast},
