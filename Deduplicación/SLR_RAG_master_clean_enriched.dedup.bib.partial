@article{wang_survey_2025,
 abstract = {This survey addresses the crucial issue of factuality in Large Language Models (LLMs). As LLMs find applications across diverse domains, the reliability and accuracy of their outputs become vital. We define the “factuality issue” as the probability of LLMs to produce content inconsistent with established facts. We first delve into the implications of these inaccuracies. Subsequently, we analyze the mechanisms through which LLMs store and process facts, seeking the primary causes of factual errors. Our discussion then transitions to methodologies for evaluating LLM factuality, emphasizing key metrics, benchmarks, and studies. We further explore strategies for enhancing LLM factuality. Our survey offers a structured guide for researchers aiming to fortify the factual reliability of LLMs. We consistently maintain and update the related open-source materials at https://github.com/wangcunxiang/LLM-Factuality-Survey .},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Wang},
 doi = {10.1145/3742420},
 issn = {0360-0300},
 journal = {ACM Comput. Surv.},
 keywords = {Factuality},
 month = {sep},
 note = {Place: New York},
 number = {1},
 title = {Survey on {Factuality}},
 url = {https://doi.org/10.1145/3742420},
 volume = {58},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:08Z},
 year = {2025}
}

@inproceedings{wang_talking_2025,
 abstract = {Interactive data visualization tools empower non-experts to explore and communicate insights from data. However, creating effective visualizations often requires expertise in both data analysis and visual design. Visual programming languages (VPLs) for data visualization aim to bridge this gap by allowing users to construct visualizations through direct manipulation of visual elements. Despite their promise, existing VPLs face challenges in usability, expressiveness, and scalability. In this paper, we explore the design space of VPLs for interactive data visualization through a systematic analysis of 20 existing tools and the development of a new VPL, VisFlow. We identify key design dimensions, including representation (e.g., nodes vs. direct manipulation), interaction (e.g., dragging vs. menus), and abstraction level (e.g., low-level graphics vs. high-level charts). Through iterative design and user studies with 24 participants, we evaluate how these dimensions impact usability and expressiveness. Our findings reveal trade-offs: direct manipulation enhances intuitiveness but limits complex expressions, while node-based systems scale better for advanced users. VisFlow integrates hybrid representations to balance these trade-offs, enabling seamless transitions from exploratory to programmatic visualization. We discuss implications for future VPL design, emphasizing adaptability to user expertise and task complexity.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wang},
 booktitle = {Proceedings of the 38th {Annual}},
 doi = {10.1145/3746059.3747617},
 isbn = {979-8-4007-2037-6},
 keywords = {AI Companionship},
 publisher = {Association for Computing Machinery},
 series = {{UIST}},
 title = {Talking {Spell}},
 url = {https://doi.org/10.1145/3746059.3747617},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:31:41Z},
 year = {2025}
}

@article{wang_tdefsi_2020,
 abstract = {Influenza-like illness (ILI) places a heavy social and economic burden on our society. Traditionally, ILI surveillance data are updated weekly and provided at a spatially coarse resolution. Producing timely and reliable high-resolution spatiotemporal forecasts for ILI is crucial for local preparedness and optimal interventions. We present T heory-guided D eep Learning-based E pidemic F orecasting with S ynthetic I nformation (TDEFSI), 1 an epidemic forecasting framework that integrates the strengths of deep neural networks and high-resolution simulations of epidemic processes over networks. TDEFSI yields accurate high-resolution spatiotemporal forecasts using low-resolution time-series data. During the training phase, TDEFSI uses high-resolution simulations of epidemics that explicitly model spatial and social heterogeneity inherent in urban regions as one component of training data. We train a two-branch recurrent neural network model to take both within-season and between-season low-resolution observations as features and output high-resolution detailed forecasts. The resulting forecasts are not just driven by observed data but also capture the intricate social, demographic, and geographic attributes of specific urban regions and mathematical theories of disease propagation over networks. We focus on forecasting the incidence of ILI and evaluate TDEFSI’s performance using synthetic and real-world testing datasets at the state and county levels in the USA. The results show that, at the state level, our method achieves comparable/better performance than several state-of-the-art methods. At the county level, TDEFSI outperforms the other methods. The proposed method can be applied to other infectious diseases as well.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Wang},
 doi = {10.1145/3380971},
 issn = {2374-0353},
 journal = {ACM Trans. Spatial Algorithms Syst.},
 keywords = {causal model},
 month = {apr},
 note = {Place: New York},
 number = {3},
 title = {{TDEFSI}},
 url = {https://doi.org/10.1145/3380971},
 volume = {6},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:19Z},
 year = {2020}
}

@inproceedings{wang_topology-aware_2024,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their performance in complex reasoning tasks remains limited, often due to the lack of explicit reasoning processes. Recent works have shown that eliciting chain-of-thought (CoT) reasoning in LLMs can significantly improve their reasoning capabilities. Despite the promise of CoT, designing effective CoT prompts remains a challenging task that requires expertise and trial-and-error. In this paper, we propose EchoFlow, a visual programming language (VPL) that enables users to design CoT reasoning flows for LLMs in a visual and intuitive manner. EchoFlow provides a set of modular building blocks, including prompts, conditionals, loops, and LLM calls, allowing users to compose complex reasoning pipelines without writing code. We conducted a user study with 24 participants to evaluate the usability and effectiveness of EchoFlow. The results show that EchoFlow significantly reduces the time and effort required to design effective CoT prompts and leads to better performance on reasoning benchmarks compared to traditional text-based prompting. Our work demonstrates the potential of VPLs in enhancing human-AI collaboration for prompt engineering and opens new avenues for making advanced LLM techniques accessible to non-experts.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 1},
 author = {Wang},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3627673.3679746},
 isbn = {979-8-4007-0436-9},
 keywords = {graph structural relations},
 note = {event-place: Boise},
 pages = {2442--2452},
 publisher = {Association for Computing Machinery},
 series = {{CIKM}},
 title = {Topology-aware {Retrieval}},
 url = {https://doi.org/10.1145/3627673.3679746},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:35:13Z},
 year = {2024}
}

@inproceedings{wang_towards_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their outputs can sometimes be unreliable or biased. To address this, recent research has explored the use of confidence estimation to assess the reliability of LLM-generated text. However, existing methods often rely on external models or additional annotations, which can be computationally expensive or impractical in real-world scenarios. In this paper, we propose a novel approach for confidence estimation in LLMs that leverages internal model signals, specifically the attention weights and hidden states, to predict the confidence of generated tokens without requiring any external resources. Our method, called Internal Confidence Estimation (ICE), is lightweight and can be integrated seamlessly into the decoding process of LLMs. We evaluate ICE on several benchmark datasets for natural language generation tasks, including summarization, translation, and question answering, demonstrating that it achieves competitive performance compared to state-of-the-art methods while being significantly more efficient. Our findings suggest that internal signals provide a rich source of information for confidence estimation, opening up new avenues for improving the trustworthiness of LLMs in deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wang},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3718958.3750505},
 isbn = {979-8-4007-1524-2},
 keywords = {AIOps},
 note = {event-place: São Francisco Convent},
 pages = {496--511},
 publisher = {Association for Computing Machinery},
 series = {{SIGCOMM}},
 title = {Towards {LLM}},
 url = {https://doi.org/10.1145/3718958.3750505},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:45:32Z},
 year = {2025}
}

@article{wang_unims-rag_2024,
 abstract = {We introduce RoboCLIP, a novel vision-language model designed to bridge the gap between web-scale visual data and robotic manipulation tasks. By leveraging large-scale image-text pairs from the internet, RoboCLIP learns rich semantic representations that enable zero-shot generalization to unseen objects and tasks in robotics. We fine-tune RoboCLIP on small amounts of robotic demonstration data to create policies for dexterous manipulation, achieving state-of-the-art performance on benchmarks like RLBench and RoboTurk. Our approach reduces the need for extensive robot-specific data collection, paving the way for generalist robotic agents that can adapt to diverse real-world scenarios with minimal fine-tuning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wang},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
