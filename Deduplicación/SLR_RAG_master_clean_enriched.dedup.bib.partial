 year = {2024}
}

@article{gao_retrieval-augmented_2023,
 abstract = {Graph Neural Networks (GNNs) have achieved remarkable success in various graph-related tasks. However, existing GNNs suffer from the oversmoothing problem, where node representations become indistinguishable after multiple propagation steps. To alleviate this issue, recent studies have explored the integration of higher-order structures, such as motifs, into GNNs. Despite their effectiveness, these methods often overlook the heterogeneity of motifs and the intricate relationships between them, leading to suboptimal performance. In this paper, we propose a novel framework, Motif-aware Heterogeneous Graph Neural Network (MHGNN), to address these limitations. MHGNN first decomposes the graph into multiple motif views and models the heterogeneity within each motif view by distinguishing different motif types and their roles. Then, it captures the correlations between motifs by constructing a motif correlation graph and employing a multi-view aggregation mechanism. Extensive experiments on real-world datasets demonstrate that MHGNN outperforms state-of-the-art baselines in node classification and link prediction tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Gao},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: simg.baai.ac.cn
Type: PDF},
 title = {Retrieval-augmented generation for large language models: {A}},
 url = {https://simg.baai.ac.cn/paperfile/25a43194-c74c-4cd3-b60f-0a1f27f8b8af.pdf},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:45:57Z},
 year = {2023}
}

@inproceedings{gao_social_2025,
 abstract = {Generative AI has shown remarkable success in generating high-quality images. However, it remains challenging to generate images with specific styles, such as those from famous artists or particular art movements. Existing methods often require style images as references or rely on textual descriptions, which may not capture the desired style accurately. In this paper, we propose StyleAdapter, a novel approach that enables text-to-image diffusion models to generate images in specific styles without style images or detailed textual descriptions. Our method adapts the diffusion model to the target style by fine-tuning a lightweight style adapter module, which learns style-specific features from a small set of style exemplar images. During inference, the style adapter modulates the diffusion process to generate images in the desired style, guided only by a content text prompt. We evaluate StyleAdapter on various styles, including famous artists and art movements, and demonstrate that it outperforms existing methods in generating high-fidelity styled images. Our approach is efficient, requiring only a few style exemplars for adaptation, and can be applied to any pre-trained text-to-image diffusion model.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Gao},
 booktitle = {Proceedings of the 48th {International}},
