 pages = {2905--2909},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Retrieval-augmented generation with knowledge graphs for customer service question answering},
 url = {https://doi.org/10.1145/3626772.3661370},
