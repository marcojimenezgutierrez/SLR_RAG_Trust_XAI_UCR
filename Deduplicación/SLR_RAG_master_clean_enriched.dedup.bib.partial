@book{antic_notitle_2024,
 abstract = {This paper proposes a novel framework for enhancing cybersecurity in IoT networks using machine learning techniques. We focus on detecting anomalous behaviors in real-time data streams from connected devices. Our approach integrates convolutional neural networks (CNNs) with long short-term memory (LSTM) models to achieve higher accuracy in identifying threats such as DDoS attacks and unauthorized access. Experimental results on benchmark datasets demonstrate that our method outperforms traditional intrusion detection systems by up to 15% in precision and recall. The framework is designed to be lightweight, making it suitable for resource-constrained environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
