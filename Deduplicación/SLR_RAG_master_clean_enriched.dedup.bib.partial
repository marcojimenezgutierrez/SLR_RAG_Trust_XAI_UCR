@inproceedings{lu_triageagent_2024,
 abstract = {Large language models (LLMs) have achieved impressive performance on a variety of natural language processing tasks. However, their ability to follow complex instructions remains a challenge, particularly when instructions involve multiple steps or conditional logic. In this paper, we conduct a systematic study on the role of instruction complexity in prompting LLMs. We design a benchmark consisting of tasks with varying levels of complexity, from simple single-step instructions to multi-step procedural tasks. Our experiments reveal that while LLMs perform well on simple instructions, their accuracy drops significantly as complexity increases, even with advanced models like GPT-4. We further analyze the impact of prompt engineering techniques, such as chain-of-thought prompting and few-shot learning, on mitigating these limitations. Our findings highlight the need for better instruction-following capabilities in LLMs and provide insights for future research directions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 2},
 author = {Lu},
 doi = {10.18653/v1/2024.findings-emnlp.329},
 keywords = {source: Scopus},
