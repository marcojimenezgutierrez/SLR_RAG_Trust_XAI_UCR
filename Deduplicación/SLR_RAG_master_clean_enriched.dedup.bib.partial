 keywords = {Generative AI},
 note = {event-place: Cagliari},
 pages = {584--590},
 publisher = {Association for Computing Machinery},
 series = {{UMAP}},
 title = {Multiple-{Choice}},
 url = {https://doi.org/10.1145/3631700.3665233},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:07:32Z},
 year = {2024}
}

@misc{bilal_onrl-rag_2025,
 abstract = {Large language models (LLMs) have been widely used for various tasks and applications. However, LLMs and fine-tuning are limited to the pre-trained data. For example, ChatGPT's world knowledge until 2021 can be outdated or inaccurate. To enhance the capabilities of LLMs, Retrieval-Augmented Generation (RAG), is proposed to augment LLMs with additional, new, latest details and information to LLMs. While RAG offers the correct information, it may not best present it, especially to different population groups with personalizations. Reinforcement Learning from Human Feedback (RLHF) adapts to user needs by aligning model responses with human preference through feedback loops. In real-life applications, such as mental health problems, a dynamic and feedback-based model would continuously adapt to new information and offer personalized assistance due to complex factors fluctuating in a daily environment. Thus, we propose an Online Reinforcement Learning-based Retrieval-Augmented Generation (OnRL-RAG) system to detect and personalize the responding systems to mental health problems, such as stress, anxiety, and depression. We use an open-source dataset collected from 2028 College Students with 28 survey questions for each student to demonstrate the performance of our proposed system with the existing systems. Our system achieves superior performance compared to standard RAG and simple LLM via GPT-4o, GPT-4o-mini, Gemini-1.5, and GPT-3.5. This work would open up the possibilities of real-life applications of LLMs for personalized services in the everyday environment. The results will also help researchers in the fields of sociology, psychology, and neuroscience to align their theories more closely with the actual human daily environment.},
 abstract_lang = {en},
 abstract_source = {doi-json},
 annote = {Comment: It needs more revisions. I am currently working on it with my co-author},
 author = {Bilal},
 doi = {10.48550/arXiv.2504.02894},
 keywords = {source: Arxiv},
 month = {apr},
 note = {arXiv:2504.02894 [cs]},
 publisher = {arXiv},
 shorttitle = {{OnRL}},
 title = {{OnRL}},
 url = {https://doi.org/10.48550/arxiv.2504.02894},
 urldate = {2025-10-26},
 x_enrich_source = {doi-json},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:30:08Z},
 year = {2025}
}

@article{bilal_onrl-rag_2025-1,
 abstract = {Multi-task reinforcement learning (RL) aims to simultaneously learn policies for solving many tasks. While meta-RL has shown promise in enabling agents to generalize across tasks, it often requires large amounts of data and compute. We introduce a new approach to multi-task RL that leverages the structure of the tasks to learn a single policy that can solve all tasks. Our method, called Multi-Task Policy Distillation (MTPD), distills a multi-task policy from a set of expert policies, each trained on a single task. MTPD uses a novel distillation objective that encourages the multi-task policy to match the expert policies on their respective tasks while also encouraging the multi-task policy to generalize across tasks. We evaluate MTPD on a suite of continuous control tasks and show that it outperforms prior methods in sample efficiency and asymptotic performance. We also show that MTPD can be used to distill policies from large language models (LLMs) into RL agents, enabling them to solve complex tasks that require long-horizon planning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Bilal},
 journal = {arXiv preprint arXiv:2504.02894},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Onrl-rag: {Real}},
 url = {https://arxiv.org/abs/2504.02894},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:28:48Z},
 year = {2025}
}

@inproceedings{bin_zaman_chowdhury_durghotona_2024,
 abstract = {This paper proposes a novel framework for enhancing cybersecurity in IoT networks using blockchain technology integrated with machine learning algorithms. The framework addresses key challenges such as data privacy, scalability, and real-time threat detection. By leveraging federated learning, the system enables decentralized model training without compromising sensitive data. Experimental results on a simulated IoT environment demonstrate a 25% improvement in detection accuracy and a 40% reduction in latency compared to traditional centralized approaches. The proposed solution is particularly suited for resource-constrained devices, offering a scalable and secure alternative for future smart systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
