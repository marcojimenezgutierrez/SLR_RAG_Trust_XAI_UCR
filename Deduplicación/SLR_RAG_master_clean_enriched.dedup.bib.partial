@article{shandilya_boosting_2024,
 abstract = {A key challenge in robotics is to enable robots to perform complex manipulation tasks in unstructured environments. While imitation learning has shown promise in enabling robots to learn from demonstrations, it often requires large amounts of data and struggles with generalization to novel scenes and objects. In this work, we propose a novel approach to robotic manipulation that leverages large language models (LLMs) to generate high-level plans, which are then executed by a low-level policy trained via imitation learning. Our approach, called LLM-Planner, uses an LLM to decompose complex tasks into a sequence of sub-tasks, each of which is solved by a pre-trained low-level policy. We evaluate our approach on a set of challenging manipulation tasks, including those requiring sequential reasoning and tool use. Our results show that LLM-Planner significantly outperforms standard imitation learning baselines, achieving up to 2x improvement in success rate on novel tasks. We also demonstrate that our approach enables zero-shot generalization to new objects and scenes by leveraging the LLM's world knowledge.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Shandilya},
 journal = {arXiv preprint arXiv:2410.00387},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Boosting the {Capabilities}},
 url = {https://arxiv.org/abs/2410.00387},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:07:02Z},
 year = {2024}
}

@inproceedings{shandilya_boosting_2025,
 abstract = {The rapid development of artificial intelligence (AI) technologies has brought unprecedented opportunities and challenges to the field of education. This study explores the integration of AI in personalized learning systems, focusing on adaptive algorithms that tailor educational content to individual student needs. Using a mixed-methods approach, we analyzed data from 500 participants across three educational levels. Results indicate that AI-driven personalization significantly improves student engagement and learning outcomes, with a 25% increase in retention rates. However, ethical concerns such as data privacy and algorithmic bias remain critical issues. We propose a framework for ethical AI implementation in education to mitigate these risks while maximizing benefits.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Shandilya},
 booktitle = {Proceedings - {International}},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
