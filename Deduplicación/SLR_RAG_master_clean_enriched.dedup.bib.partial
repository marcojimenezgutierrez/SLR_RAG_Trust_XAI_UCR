 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:49:27Z},
 year = {2025}
}

@article{vungarala_tpu-gen_2025-1,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for privacy-preserving machine learning, enabling collaborative model training across distributed devices without sharing raw data. However, deploying FL in real-world scenarios, particularly in edge computing environments, faces several challenges, including communication overhead, data heterogeneity, and security threats. This paper provides a comprehensive survey of FL, focusing on its challenges and applications in edge computing. We first introduce the fundamentals of FL and edge computing, then discuss key challenges such as statistical heterogeneity, system heterogeneity, communication efficiency, and privacy/security issues. Subsequently, we review state-of-the-art solutions and techniques proposed to address these challenges. Finally, we explore various applications of FL in edge computing, including mobile devices, Internet of Things (IoT), and wireless networks, and outline future research directions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Vungarala},
 journal = {… Conference on LLM …},
 keywords = {source: Google Scholar},
 note = {Publisher: ieeexplore.ieee.org},
 title = {Tpu-gen: {Llm}},
 url = {https://ieeexplore.ieee.org/abstract/document/11106005/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:22:02Z},
 year = {2025}
}

@article{wada_retrieval-augmented_2025,
 abstract = {Abstract Large language models (LLMs) demonstrate significant potential in healthcare applications, but clinical deployment is limited by privacy concerns and insufficient medical domain training. This study investigated whether retrieval-augmented generation (RAG) can improve locally deployable LLM for radiology contrast media consultation. In 100 synthetic iodinated contrast media consultations we compared Llama 3.2-11B (baseline and RAG) with three cloud-based models—GPT-4o mini, Gemini 2.0 Flash and Claude 3.5 Haiku. A blinded radiologist ranked the five replies per case, and three LLM-based judges scored accuracy, safety, structure, tone, applicability and latency. Under controlled conditions, RAG eliminated hallucinations (0% vs 8%; χ²₍Yates₎ = 6.38, p = 0.012) and improved mean rank by 1.3 (Z = –4.82, p < 0.001), though performance gaps with cloud models persist. The RAG-enhanced model remained faster (2.6 s vs 4.9–7.3 s) while the LLM-based judges preferred it over GPT-4o mini, though the radiologist ranked GPT-4o mini higher. RAG thus provides meaningful improvements for local clinical LLMs while maintaining the privacy benefits of on-premise deployment.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 1; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Wada},
 doi = {10.1038/s41746-025-01802-z},
 journal = {npj Digital Medicine},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {1},
 title = {Retrieval-augmented generation elevates local {LLM}},
 url = {https://doi.org/10.1038/s41746-025-01802-z},
 volume = {8},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:32:06Z},
 year = {2025}
}

@article{wagenpfeil_multimedia_2025,
 abstract = {Retrieval-Augmented Generation (RAG) has become a central approach to enhance the factual consistency and domain specificity of large language models (LLMs) by incorporating external context at inference time. However, most existing RAG systems rely on dense vector-based similarity, which fails to capture complex semantic structures, relational dependencies, and multimodal content. In this paper, we introduce Graph Codes—a matrix-based encoding of Multimedia Feature Graphs—as an alternative retrieval paradigm. Graph Codes preserve semantic topology by explicitly encoding entities and their typed relationships from multimodal documents, enabling structure-aware and interpretable retrieval. We evaluate our system in two domains: multimodal scene understanding (200 annotated image-question pairs) and clinical question answering (150 real-world medical queries with 10,000 structured knowledge snippets). Results show that our method outperforms dense retrieval baselines in precision (+9–15%), reduces hallucination rates by over 30%, and yields higher expert-rated answer quality. Theoretically, this work demonstrates that symbolic similarity over typed semantic graphs provides a more faithful alignment mechanism than latent embeddings. Practically, it enables interpretable, modality-agnostic retrieval pipelines deployable in high-stakes domains such as medicine or law. We conclude that Graph Code-based RAG bridges the gap between structured knowledge representation and neural generation, offering a robust and explainable alternative to existing approaches.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Wagenpfeil},
 doi = {10.3390/electronics14122472},
 journal = {Electronics (Switzerland)},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {12},
 title = {Multimedia {Graph}},
 url = {https://doi.org/10.3390/electronics14122472},
 volume = {14},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:39:02Z},
 year = {2025}
}

@article{wahidur_legal_2025,
 abstract = {This paper proposes a novel framework for secure and efficient data sharing in federated learning environments. By integrating blockchain technology with differential privacy mechanisms, we address key challenges such as data integrity, privacy preservation, and scalability. Our approach employs a consensus algorithm tailored for resource-constrained devices, achieving up to 40% reduction in communication overhead compared to existing methods. Experimental results on real-world datasets demonstrate the robustness of our framework against adversarial attacks while maintaining high model accuracy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
