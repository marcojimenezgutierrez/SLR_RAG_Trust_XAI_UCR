}

@article{smith_strategic_2023,
 abstract = {Obesity is a major risk factor for type 2 diabetes, cardiovascular disease, and certain types of cancer. The mechanisms underlying obesity-associated insulin resistance and type 2 diabetes are not fully understood. Here we show that obesity leads to macrophage infiltration into adipose tissue and that these macrophages are an important source of inflammatory mediators implicated in the development of insulin resistance. We found that the percentage of macrophages in adipose tissue correlates with adiposity and that macrophage infiltration precedes the development of insulin resistance in mice fed a high-fat diet. Furthermore, we show that macrophage chemoattractant protein-1 (MCP-1) is upregulated in the adipose tissue of obese mice and humans and that MCP-1-deficient mice are protected from macrophage infiltration and insulin resistance induced by a high-fat diet. These results suggest that macrophage infiltration into adipose tissue is a key event in obesity-induced insulin resistance and that MCP-1 plays a critical role in this process.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 author = {Smith},
 issn = {1532-4435},
 journal = {J. Mach. Learn. Res.},
 keywords = {empirical game theoretic analysis},
 month = {jan},
 note = {Publisher: JMLR.org},
 number = {1},
 title = {Strategic knowledge transfer},
 volume = {24},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:30:16Z},
 year = {2023}
}

@inproceedings{sng_novel_2024,
 abstract = {The increasing use of large language models (LLMs) in causal discovery as a substitute for human domain experts highlights the need for optimal model selection. This paper presents the first hallucination survey of popular LLMs for causal discovery. We show that hallucinations exist when using LLMs in causal discovery so the choice of LLM is important. We propose using Retrieval Augmented Generation (RAG) to reduce hallucinations when quality data is available. Additionally},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Sng},
