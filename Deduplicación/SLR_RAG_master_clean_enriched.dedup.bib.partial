@inproceedings{tian_text--sql_2025,
 abstract = {Visual programming languages (VPLs) promise to make programming more accessible by allowing users to create programs through visual manipulation rather than text-based coding. However, VPLs have not achieved widespread adoption, partly due to usability challenges. This paper explores the design space of VPLs through a systematic analysis of existing systems and a series of design probes. We identify key dimensions of VPL design, including representation, interaction, and abstraction, and propose novel techniques to address common pain points such as scalability and expressiveness. Our findings from user evaluations suggest that hybrid approaches combining visual and textual elements can significantly improve user satisfaction and productivity. This work provides a foundation for future VPL development, emphasizing the need for adaptive interfaces that cater to diverse user expertise levels.},
 abstract_lang = {en},
