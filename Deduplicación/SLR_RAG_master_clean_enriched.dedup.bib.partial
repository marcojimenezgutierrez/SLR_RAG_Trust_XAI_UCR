 x_enrich_ts = {2025-11-02T06:21:00Z},
 year = {2025}
}

@inproceedings{fuchs_practical_2025,
 abstract = {Social virtual reality (VR) platforms enable users to interact with each other in immersive 3D environments. However, current social VR platforms lack support for non-verbal communication cues that are essential for natural social interactions. In this paper, we investigate the design and evaluation of a novel non-verbal communication system for social VR called EmoCues, which allows users to convey emotions through dynamic avatar animations. We conducted a user study with 24 participants to evaluate EmoCues in a collaborative task scenario. Our results show that EmoCues significantly improves users' sense of social presence and emotional expressiveness compared to a baseline VR platform without such cues. We discuss the implications of our findings for the design of future social VR systems and provide design guidelines for implementing non-verbal communication features.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 0},
