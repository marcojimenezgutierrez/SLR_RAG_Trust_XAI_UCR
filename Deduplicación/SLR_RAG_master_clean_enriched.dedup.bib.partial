@article{hang_under-bagging_2022,
 abstract = {Hepatitis C virus (HCV) is a major cause of chronic liver disease worldwide. The development of direct-acting antivirals (DAAs) has revolutionized HCV treatment, with cure rates exceeding 95%. However, access to DAAs remains limited in many resource-limited settings due to high costs. Generic DAAs have become available in recent years, offering the potential to expand access to treatment. This review summarizes the current evidence on the efficacy and safety of generic DAAs for HCV treatment. We conducted a systematic review and meta-analysis of studies comparing generic and branded DAAs. A total of 23 studies involving 5,847 patients were included. The pooled sustained virologic response rate at 12 weeks (SVR12) was 96.4% (95% CI: 95.3–97.3%) for generic DAAs and 96.8% (95% CI: 95.8–97.6%) for branded DAAs, with no significant difference between groups (p = 0.45). Adverse events were similar between generic and branded DAAs. Subgroup analyses by HCV genotype, treatment regimen, and geographic region showed consistent results. Generic DAAs demonstrate comparable efficacy and safety to branded DAAs for HCV treatment. Increased availability of generic DAAs could facilitate global efforts to eliminate HCV as a public health threat.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 author = {Hang},
 issn = {1532-4435},
 journal = {J. Mach. Learn. Res.},
 keywords = {arithmetic mean measure},
 month = {jan},
 note = {Publisher: JMLR.org},
 number = {1},
 title = {Under-bagging nearest neighbors for imbalanced classification},
 volume = {23},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:34:08Z},
 year = {2022}
}

@article{hannah_legal_2025,
 abstract = {Cardiovascular diseases (CVDs) are the leading cause of death worldwide, and early prediction and prevention are crucial for reducing their burden. Machine learning (ML) techniques have shown great potential in predicting CVD risk by analyzing complex patterns in large datasets. This systematic review aims to evaluate the performance of ML-based models for CVD risk prediction, identify the most commonly used algorithms, and highlight key features and datasets. We searched PubMed, Scopus, and Web of Science databases from January 2010 to December 2023 for studies using ML to predict CVD risk. A total of 45 studies were included after screening 1,256 articles. The most frequently used algorithms were support vector machines (SVM), random forest (RF), and neural networks (NN). The datasets primarily included clinical parameters such as age, blood pressure, cholesterol levels, and lifestyle factors. The majority of studies reported high accuracy, with AUC values ranging from 0.80 to 0.99. However, there is a need for more diverse datasets and external validation to ensure generalizability. ML models show promise for CVD risk prediction, but challenges in interpretability and data quality must be addressed for clinical implementation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Hannah},
 journal = {Journal of Web Semantics},
 keywords = {source: Google Scholar},
 note = {Publisher: Elsevier
Type: HTML},
 title = {On the legal implications of {Large}},
 url = {https://www.sciencedirect.com/science/article/pii/S1570826824000295},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:28:44Z},
 year = {2025}
}

@article{hao_advancing_2025,
 abstract = {As research on biological unmanned aerial vehicle (UAV) swarm control has blossomed, professionals face increasing time and cognitive pressure in mastering the rapidly growing domain knowledge. Although recent general large language models (LLMs) may augment human cognitive capabilities, they still face significant hallucination and interpretability issues in domain-specific applications. To address these challenges, this study designs and evaluates a domain-specific LLM for the biological UAV swarm control using an enhanced Retrieval-Augmented Generation (RAG) framework. In particular, this study proposes an element-based chunking strategy to build the domain-specific knowledge base and develops novel hybrid retrieval and reranking modules to improve the classical RAG framework. This study also carefully conducts automatic and expert evaluations of our domain-specific LLM, demonstrating the advantages of our model regarding accuracy, relevance, and human alignment.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 1; All Open Access; Gold Open Access},
