@article{zhou_preliminary_2024-1,
 abstract = {Abstract The objective of this paper is to develop EPChat, an industry-specific large language model tailored for the exploration and production (E&P) field through retrieval-augmented generation (RAG) and fine-tuning techniques. This novel EPChat model effectively mitigates the common issue of hallucinations inherent in generic LLMs, thereby enabling it to function as a reliable AI assistant in the oil and gas industry, providing accurate and contextually relevant responses.},
