@article{zhao_smart_2025,
 abstract = {Learning generalist robot policies in unstructured environments---ones that can perform a wide range of tasks without task-specific fine-tuning---is a long-standing challenge in robotics. While recent advances in representation learning have shown promise in enabling such generalization, the key ingredients for success remain unclear. In this work, we conduct a systematic study of representation learning for generalist robot policies. We evaluate a variety of visual and proprioceptive representations on a suite of simulated manipulation tasks, and find that the choice of representation has a significant impact on downstream policy performance. In particular, we show that representations that capture object-centric information and affordances are crucial for generalization to novel objects and tasks. We further demonstrate that these representations can be learned end-to-end with standard RL algorithms, without the need for explicit supervision. Our findings provide insights into the role of representation learning in enabling generalist robot policies, and suggest promising directions for future research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhao},
 journal = {arXiv preprint arXiv:2506.02470},
