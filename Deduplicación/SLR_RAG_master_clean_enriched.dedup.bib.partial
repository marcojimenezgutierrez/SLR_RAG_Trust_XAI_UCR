@article{neha_retrieval-augmented_2025,
 abstract = {Retrieval-Augmented Generation (RAG) enhances large language models (LLMs) by integrating external knowledge retrieval to improve factual consistency and reduce hallucinations. Despite growing interest, its use in healthcare remains fragmented. This paper presents a Systematic Literature Review (SLR) following PRISMA guidelines, synthesizing 30 peer-reviewed studies on RAG in clinical domains, focusing on three of its most prevalent and promising applications in diagnostic support, electronic health record (EHR) summarization, and medical question answering. We synthesize the existing architectural variants (naïve, advanced, and modular) and examine their deployment across these applications. Persistent challenges are identified, including retrieval noise (irrelevant or low-quality retrieved information), domain shift (performance degradation when models are applied to data distributions different from their training set), generation latency, and limited explainability. Evaluation strategies are compared using both standard metrics and clinical-specific metrics, FactScore, RadGraph-F1, and MED-F1, which are particularly critical for ensuring factual accuracy, medical validity, and clinical relevance. This synthesis offers a domain-focused perspective to guide researchers, healthcare providers, and policymakers in developing reliable, interpretable, and clinically aligned AI systems, laying the groundwork for future innovation in RAG-based healthcare solutions.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Neha},
 doi = {10.3390/ai6090226},
 journal = {AI (Switzerland)},
 keywords = {source: Scopus},
 note = {Type: Review},
 number = {9},
 title = {Retrieval-{Augmented}},
 url = {https://doi.org/10.3390/ai6090226},
 volume = {6},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:34:25Z},
 year = {2025}
}

@inproceedings{nelson_sensai_2025,
 abstract = {Large language models (LLMs) are increasingly used for complex tasks that require chaining together multiple prompts and intermediate results. However, existing interfaces for working with LLMs make it difficult to author, debug, and iterate on these workflows. We interviewed 13 LLM practitioners and found that they face challenges in managing the complexity of LLM chains, testing hypotheses about chain behavior, and sharing chains with others. To address these challenges, we developed ChainForge, a visual toolkit for building, debugging, and sharing LLM chains. ChainForge allows users to construct chains using a node-link diagram, execute chains with real-time feedback, and compare results across multiple runs. We evaluated ChainForge with 10 practitioners and found that it helped them more quickly understand and debug their chains, test hypotheses about chain behavior, and share chains with others. Our work contributes a set of design principles for LLM chain interfaces and a concrete implementation that demonstrates their utility.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Nelson},
 booktitle = {Proceedings of the 56th {ACM}},
