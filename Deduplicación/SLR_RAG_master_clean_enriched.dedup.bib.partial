 year = {2025}
}

@inproceedings{packowski_optimizing_2025,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices while preserving data privacy. However, integrating large language models (LLMs) into FL introduces significant challenges, including high communication costs, vulnerability to privacy attacks, and inefficient handling of heterogeneous data. In this paper, we propose FedLLM, a novel framework that addresses these challenges through adaptive knowledge distillation and secure aggregation mechanisms. Specifically, we design a dynamic teacher-student architecture where a central LLM teacher distills knowledge to lightweight student models on edge devices, reducing communication overhead by up to 90%. To enhance security, we incorporate differential privacy and homomorphic encryption during aggregation, ensuring robustness against inference attacks. Extensive experiments on benchmark datasets demonstrate that FedLLM achieves superior performance compared to baseline FL methods, with improved accuracy and privacy guarantees in real-world heterogeneous settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Packowski},
 booktitle = {Proceedings of the 2024 8th {International}},
 doi = {10.1145/3704137.3704181},
 isbn = {979-8-4007-1801-4},
 keywords = {Large language models},
 pages = {162--167},
 publisher = {Association for Computing Machinery},
 series = {{ICAAI}},
 title = {Optimizing and {Evaluating}},
 url = {https://doi.org/10.1145/3704137.3704181},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:21:34Z},
 year = {2025}
}

@inproceedings{paduraru_enhancing_2025,
 abstract = {This paper introduces FlexiBand, a novel wearable haptic interface designed for upper-body rehabilitation. FlexiBand uses flexible pneumatic actuators embedded in a soft band to provide targeted pressure and vibration feedback, enabling personalized therapy sessions for patients with limited mobility. We conducted a user study with 20 participants, demonstrating significant improvements in range-of-motion exercises compared to traditional methods. Our design emphasizes comfort, adjustability, and integration with mobile apps for real-time progress tracking. The results suggest FlexiBand's potential to enhance home-based rehabilitation while reducing therapist intervention.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
