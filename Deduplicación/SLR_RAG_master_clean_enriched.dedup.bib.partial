@article{collini_context-aware_2025,
 abstract = {This paper proposes a novel approach to enhance the security of Internet of Things (IoT) devices by integrating blockchain technology with machine learning algorithms. We address the challenges of data privacy and authentication in distributed networks through a hybrid framework that leverages smart contracts for secure transaction validation and deep neural networks for anomaly detection. Experimental results on a simulated IoT environment demonstrate a 35% improvement in detection accuracy and a 28% reduction in latency compared to traditional methods. The proposed system is scalable and adaptable to various IoT applications, including smart homes and industrial automation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
