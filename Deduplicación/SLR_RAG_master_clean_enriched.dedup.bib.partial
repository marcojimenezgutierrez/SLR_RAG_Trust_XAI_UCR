@article{alam_towards_2025,
 abstract = {This paper presents a formal approach to the verification of railway interlocking systems using model checking. We model the system behavior with timed automata and use UPPAAL to verify safety and liveness properties. The approach is applied to a case study of a Danish railway interlocking system, demonstrating its feasibility for industrial use. The results show that the model checker can handle the complexity of real-world systems while providing formal guarantees.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
