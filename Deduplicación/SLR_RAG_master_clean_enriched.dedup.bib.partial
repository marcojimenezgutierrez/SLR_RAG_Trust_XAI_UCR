@inproceedings{barzanji_expectations_2025,
 abstract = {This paper presents VoiceBox, a voice-based conversational agent that can control a robotic arm to perform physical tasks. We explore how voice interaction can be adapted for physical embodiment, focusing on challenges in spatial reasoning, action execution, and user feedback. Through a user study with 24 participants, we evaluate VoiceBox's performance in collaborative tasks compared to a baseline embodied agent. Results show that while voice control offers natural interaction, it struggles with precision in complex manipulations, highlighting the need for hybrid input modalities. Our findings contribute design implications for future voice-embodied systems in assistive robotics.},
