@inproceedings{sung_new_2024,
 abstract = {With the rapid development of the Internet of Things (IoT), the number of IoT devices has increased dramatically, and the data generated by these devices has also grown exponentially. However, due to the limitations of IoT devices in terms of computing power, storage capacity, and energy consumption, it is difficult for them to process and analyze massive amounts of data locally. Therefore, edge computing has emerged as a promising solution to address these challenges by processing data closer to the source. In this paper, we propose a novel edge computing framework for IoT devices based on federated learning (FL). Our framework enables multiple IoT devices to collaboratively train a shared model without exchanging their raw data, thereby preserving data privacy and reducing communication overhead. We also design an efficient model aggregation algorithm that takes into account the heterogeneity of IoT devices in terms of computing power and data distribution. Experimental results on real-world datasets demonstrate that our framework achieves higher accuracy and faster convergence compared to traditional centralized learning approaches, while maintaining strong privacy guarantees.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Sung},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/COMPSAC61105.2024.00371},
 keywords = {Accuracy},
 month = {jul},
 note = {ISSN: 2836-3795},
 pages = {2308--2312},
 title = {A {New}},
 url = {https://doi.org/10.1109/compsac61105.2024.00371},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:48:04Z},
 year = {2024}
}

@article{sung_new_2024-1,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices while preserving data privacy, making it suitable for Internet of Things (IoT) applications. However, resource-constrained IoT devices pose challenges due to limited computational power, memory, and communication bandwidth. This paper presents a comprehensive survey on FL for resource-constrained IoT devices, categorizing existing approaches based on model compression, communication efficiency, and handling device heterogeneity. We discuss key techniques such as quantization, pruning, knowledge distillation, and asynchronous FL protocols. Additionally, we analyze the trade-offs between accuracy, efficiency, and privacy. Finally, we identify open challenges and outline future research directions to enhance FL's practicality in IoT environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
