 keywords = {approximate nearest neighbor search},
 note = {event-place: Padua},
 pages = {2483--2492},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{WebANNS}},
 url = {https://doi.org/10.1145/3726302.3730115},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:04:21Z},
 year = {2025}
}

@inproceedings{liu_webglm_2023,
 abstract = {Social media platforms rely on user engagement to sustain their business models, but little is known about what happens when users are not engaged. In this paper, we analyze Twitter data to understand user behavior during periods of low engagement, which we term "silence." We find that silence is common, lasting from minutes to days, and is associated with reduced future engagement. We also find that silence is more likely to occur after negative events, such as account suspensions or controversial tweets. Our findings have implications for platform design, suggesting that interventions to reduce silence could increase engagement and revenue.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Liu},
 booktitle = {Proceedings of the 29th {ACM}},
 doi = {10.1145/3580305.3599931},
