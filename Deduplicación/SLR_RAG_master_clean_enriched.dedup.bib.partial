@inproceedings{danuarta_retrieval-augmented_2024,
 abstract = {The rapid growth of Internet of Things (IoT) devices has led to increased cybersecurity threats, particularly in smart grid environments where data privacy and integrity are paramount. Traditional centralized machine learning approaches for anomaly detection often compromise user privacy by requiring data aggregation. To address this, we propose a federated learning (FL) framework integrated with blockchain technology for privacy-preserving anomaly detection in IoT-enabled smart grids. Our approach enables collaborative model training across distributed devices without sharing raw data, while blockchain ensures secure and tamper-proof logging of model updates. We employ a lightweight convolutional neural network (CNN) as the base model for detecting anomalies such as cyber-attacks and faults. Extensive experiments on benchmark datasets, including the IEEE 39-bus system simulated with IoT traffic, demonstrate that our framework achieves 95.2% accuracy, outperforming centralized methods by 8% in privacy-sensitive scenarios, with minimal communication overhead. This work highlights the potential of FL-blockchain synergy for scalable and secure IoT cybersecurity.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
