 keywords = {heterogeneous data},
 note = {event-place: Sydney NSW},
 pages = {801--804},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {{Docs2KG}},
 url = {https://doi.org/10.1145/3701716.3715309},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:08:49Z},
 year = {2025}
}

@article{sun_exploring_2024,
 abstract = {Interactive storytelling is vital for preschooler development. While children's interactive partners have traditionally been their parents and teachers, recent advances in artificial intelligence (AI) have sparked a surge of AI-based storytelling and reading technologies. As these technologies become increasingly ubiquitous in preschoolers' lives, questions arise regarding how they function in practical storytelling and reading scenarios and, how parents, the most critical stakeholders, experience and perceive these technologies. This paper investigates these questions through a qualitative study with 17 parents of children aged 3-6. Our findings suggest that even though AI-based storytelling and reading technologies provide more immersive and engaging interaction, they still cannot meet parents' expectations due to a series of interactive and algorithmic challenges. We elaborate on these challenges and discuss the possible implications of future AI-based interactive storytelling technologies for preschoolers.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Sun},
 doi = {10.1145/3687035},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keywords = {source: ACM},
 month = {nov},
 note = {Place: New York},
 number = {CSCW2},
 title = {Exploring {Parent}},
 url = {https://doi.org/10.1145/3687035},
 volume = {8},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:02Z},
 year = {2024}
}

@inproceedings{sun_exploring_2025,
 abstract = {The rapid development of large language models (LLMs) has significantly advanced the field of natural language processing. However, their application to multimodal tasks, particularly video understanding, remains underexplored. In this paper, we introduce Video-LLaMA 2, a novel framework that extends the capabilities of LLMs to grounded video understanding. Video-LLaMA 2 integrates visual and textual information through a dual-encoder architecture, enabling the model to process video content at both frame and temporal levels. Our approach leverages a video tokenizer to convert visual data into discrete tokens, which are then aligned with textual tokens using a cross-modal attention mechanism. Furthermore, we incorporate a grounding module to link generated descriptions to specific video segments, facilitating fine-grained spatio-temporal reasoning. Extensive experiments on benchmarks such as MSRVTT, ActivityNet, and Ego4D demonstrate that Video-LLaMA 2 outperforms existing video-language models in tasks including video question answering, captioning, and temporal localization. Our work paves the way for more versatile and interpretable multimodal AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Sun},
 booktitle = {Proceedings of the 2024 {International}},
 doi = {10.1145/3735014.3735915},
