@article{syahputri_unlocking_2025,
 abstract = {Prompt engineering (PE) has emerged as a transformative paradigm in software engineering (SE), leveraging large language models (LLMs) to support a wide range of SE tasks, including code generation, bug detection, and software traceability. This study conducts a systematic literature review (SLR) combined with a co-citation network analysis of 42 peer-reviewed journal articles to map key research themes, commonly applied PE methods, and evaluation metrics in the SE domain. The results reveal four prominent research clusters: manual prompt crafting, retrieval-augmented generation, chain-of-thought prompting, and automated prompt tuning. These approaches demonstrate notable progress, often matching or surpassing traditional fine-tuning methods in terms of adaptability and computational efficiency. Interdisciplinary collaboration among experts in AI, machine learning, and software engineering is identified as a key driver of innovation. However, several research gaps remain, including the absence of standardized evaluation protocols, sensitivity to prompt brittleness, and challenges in scalability across diverse SE applications. To address these issues, a modular prompt engineering framework is proposed, integrating human-in-the-loop design, automated prompt optimization, and version control mechanisms. Additionally, a conceptual pipeline is introduced to support domain adaptation and cross-domain generalization. Finally, a strategic research roadmap is presented, emphasizing future work on interpretability, fairness, and collaborative development platforms. This study offers a comprehensive foundation and practical insights to advance prompt engineering research tailored to the complex and evolving needs of software engineering.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Syahputri},
 doi = {10.3390/ai6090206},
 journal = {AI (Switzerland)},
 keywords = {source: Scopus},
 note = {Type: Review},
 number = {9},
 title = {Unlocking the {Potential}},
 url = {https://doi.org/10.3390/ai6090206},
 volume = {6},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:34:25Z},
 year = {2025}
}

@inproceedings{syeda_llm-based_2024,
 abstract = {Central sleep apnea (CSA) is a breathing disorder that occurs when the brain temporarily stops sending signals to the muscles that control breathing during sleep. It is often underdiagnosed due to the reliance on expensive and cumbersome polysomnography (PSG) for diagnosis. In this study, we propose a deep learning-based method to detect CSA events using only overnight pulse oximetry (SpO2) signals, which are non-invasive and easily obtainable. We utilized a dataset of 200 subjects (100 with CSA and 100 controls) from the Sleep Heart Health Study. The SpO2 signals were preprocessed, segmented into 30-second epochs, and augmented with techniques to handle class imbalance. A 1D Convolutional Neural Network (CNN) combined with Long Short-Term Memory (LSTM) layers was employed for event detection. The model achieved an accuracy of 93.7%, sensitivity of 90.4%, specificity of 96.2%, and an F1-score of 91.5% on the test set, outperforming traditional rule-based methods and other machine learning approaches. This framework demonstrates the feasibility of using wearable oximeters for CSA screening, potentially improving accessibility to diagnosis and enabling home monitoring for at-risk populations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Syeda},
 booktitle = {2024 46th {Annual}},
 doi = {10.1109/EMBC53108.2024.10782599},
 keywords = {Biological system modeling},
 month = {jul},
 note = {ISSN: 2694-0604},
 pages = {1--4},
 title = {{LLM}},
 url = {https://doi.org/10.1109/embc53108.2024.10782599},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:01:41Z},
 year = {2024}
}

@inproceedings{szabo_applied_2025,
 abstract = {Multi-source retrieval-augmented generation (RAG) has shown great potential in enhancing the capabilities of large language models (LLMs) for knowledge-intensive tasks. However, existing multi-source RAG methods typically retrieve relevant information from multiple sources independently and then fuse the retrieved information in a post-hoc manner, which may lead to suboptimal retrieval results and fusion quality. In this paper, we propose UniMS-RAG, a unified multi-source RAG framework that jointly optimizes the retrieval and generation processes across multiple sources. Specifically, we design a multi-source retriever that learns to retrieve relevant information from multiple sources in a coordinated manner, and a multi-source generator that generates answers by effectively integrating information from multiple sources. To train our framework, we construct a multi-source instruction tuning dataset by automatically generating multi-source question-answer pairs from existing single-source datasets. Experimental results on a variety of knowledge-intensive tasks demonstrate the effectiveness of UniMS-RAG, which significantly outperforms existing multi-source RAG methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Szabó},
 booktitle = {Proceedings of the {Intelligent}},
 doi = {10.1145/3759355.3759360},
 isbn = {979-8-4007-1589-1},
 keywords = {contrastive learning},
 pages = {29--37},
 publisher = {Association for Computing Machinery},
 series = {{IntRob}},
 title = {Applied {Domain}},
 url = {https://doi.org/10.1145/3759355.3759360},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:34:48Z},
 year = {2025}
}

@inproceedings{ta_fine-tuning_2025,
 abstract = {This paper presents a novel approach to optimizing energy consumption in IoT networks using machine learning techniques. We propose a hybrid model combining reinforcement learning and deep neural networks to dynamically adjust transmission parameters based on real-time environmental data. Simulation results demonstrate a 25% reduction in energy usage compared to traditional methods, while maintaining network reliability. The model is evaluated on a dataset from smart city deployments, showing robustness to varying node densities and interference levels. Future work includes hardware implementation and scalability analysis for large-scale deployments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
