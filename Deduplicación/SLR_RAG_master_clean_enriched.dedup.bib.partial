@inproceedings{saeid_agentfusion_2024,
 abstract = {The rapid advancement of technology has significantly transformed the educational landscape, particularly in the realm of online learning. However, one persistent challenge in this domain is maintaining student engagement, which is crucial for effective learning outcomes. Gamification, the integration of game elements into non-game contexts, has emerged as a promising strategy to address this issue. This paper presents a systematic literature review (SLR) to explore how gamification enhances student engagement in online learning environments. Following the PRISMA guidelines, we analyzed 45 peer-reviewed articles published between 2018 and 2023, sourced from databases such as IEEE Xplore, Scopus, and Web of Science. The review identifies key gamification elements (e.g., points, badges, leaderboards) and their impact on behavioral, emotional, and cognitive engagement. Findings reveal that gamification significantly boosts motivation and participation, though challenges such as over-competition and design complexity persist. We propose a framework for effective gamification implementation and suggest future research directions, including personalized gamification approaches and long-term impact studies. This SLR provides educators and developers with evidence-based insights to design engaging online learning experiences.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
