 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:54:25Z},
 year = {2024}
}

@inproceedings{tang_this_2025,
 abstract = {Vision-language models (VLMs) have shown remarkable success in various visual tasks. However, they often inherit and amplify societal biases from their training data, leading to unfair outcomes. Existing debiasing methods for VLMs are limited in their effectiveness and generalizability. In this paper, we propose a simple yet effective debiasing approach, Biased Prompts (BP), which leverages the input flexibility of VLMs to mitigate biases without requiring model retraining or fine-tuning. BP generates counterfactual prompts by flipping the attributes of interest in the original prompts, thereby balancing the biased associations in the model's predictions. We evaluate BP on multiple VLM architectures and datasets, demonstrating significant bias reduction while maintaining overall performance. Our method is computationally efficient and adaptable to various bias types, offering a practical solution for fairer VLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Tang},
 booktitle = {Proceedings of the 38th {Annual}},
