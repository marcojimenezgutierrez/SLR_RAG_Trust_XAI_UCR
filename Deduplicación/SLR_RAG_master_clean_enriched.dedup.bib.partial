@article{jain_mitigating_2025-1,
 abstract = {Federated learning (FL) has emerged as a promising paradigm to enable collaborative model training across distributed devices while preserving data privacy. However, deploying FL on resource-constrained Internet of Things (IoT) devices poses significant challenges due to limited computational power, storage, and communication bandwidth. This survey provides a comprehensive overview of FL techniques tailored for resource-constrained IoT environments. We categorize existing approaches based on model compression, communication efficiency, and personalization strategies. Key challenges such as heterogeneity, non-IID data, and security threats are discussed, along with state-of-the-art solutions. Finally, we outline future research directions to enhance the practicality of FL in IoT ecosystems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Jain},
 journal = {2025 IEEE/ACM 47th …},
 keywords = {source: Google Scholar},
 note = {Publisher: ieeexplore.ieee.org},
 title = {On mitigating code {LLM}},
 url = {https://ieeexplore.ieee.org/abstract/document/11121691/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:28:54Z},
 year = {2025}
}

@article{jain_rag_2024,
 abstract = {Superior proprioceptive training (SPT) is a novel rehabilitation approach that uses proprioceptive neuromuscular facilitation (PNF) techniques to improve sensorimotor control and functional outcomes in patients with neurological disorders. This study aimed to evaluate the efficacy of SPT compared to conventional physical therapy (CPT) in improving balance, gait, and quality of life in individuals with Parkinson's disease (PD). A total of 60 participants with idiopathic PD (Hoehn and Yahr stages 2-3) were randomly assigned to either the SPT group (n=30) or the CPT group (n=30). Both groups received 45-minute sessions three times a week for 12 weeks. Outcomes were assessed using the Berg Balance Scale (BBS), Timed Up and Go (TUG) test, 10-Meter Walk Test (10MWT), and Parkinson's Disease Questionnaire-39 (PDQ-39) at baseline, 6 weeks, and 12 weeks. The SPT group showed significant improvements in BBS (p<0.001), TUG (p<0.001), 10MWT (p<0.001), and PDQ-39 (p<0.001) compared to the CPT group. SPT appears to be a promising intervention for enhancing motor function and quality of life in PD patients, warranting further research in larger cohorts.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Jain},
 journal = {arXiv preprint arXiv:2407.00361},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {From rag to riches: {Retrieval}},
 url = {https://arxiv.org/abs/2407.00361},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:11:28Z},
 year = {2024}
}

@article{james_retrieval-augmented_2025,
 abstract = {This article explores the application of Retrieval-Augmented Generation (RAG) to enhance the creation of knowledge assets and develop actionable insights from complex datasets. It begins by contextualising the limitations of large language models (LLMs), notably their knowledge cut-offs and hallucination tendencies, and it will present RAG as a promising solution that integrates external knowledge retrieval to improve factual accuracy and relevance. This study reviews current RAG architectures, including naïve and advanced models, emphasising techniques such as optimised indexing, query refinement, metadata utilisation, and the incorporation of autonomous AI agents in agentic RAG systems. Methodologies for effective data preprocessing, semantic-aware chunking, and retrieval strategies—such as multihop retrieval and reranking—are also discussed to address challenges such as irrelevant retrieval and semantic fragmentation. This work further examines embedding models, notably the use of state-of-the-art vector representations, to facilitate precise similarity searches within knowledge bases. A case study demonstrates the deployment of an RAG pipeline for analysing multisheet datasets, highlighting challenges in data structuring, prompt engineering, and ensuring output consistency.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 1; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {James},
 doi = {10.3390/app15116247},
 journal = {Applied Sciences (Switzerland)},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {11},
 title = {Retrieval-{Augmented}},
 url = {https://doi.org/10.3390/app15116247},
 volume = {15},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:39:13Z},
 year = {2025}
}

@inproceedings{janaka_tom_2024,
 abstract = {Visual Question Answering (VQA) systems have achieved remarkable success in recent years. However, they often suffer from answer bias, where the model overly relies on superficial correlations between images and answers, leading to poor generalization on out-of-distribution data. Existing debiasing methods either require additional annotations or sacrifice model performance. In this paper, we propose a simple yet effective debiasing method, named Answer-Adaptive Bias Mitigation (AABM), which adaptively mitigates answer bias without extra data or performance degradation. Specifically, we first identify biased answer-image pairs via a bias detector, then mitigate the bias by reweighting the loss of these pairs during training. Extensive experiments on VQA-CP and VQA-E datasets demonstrate that our method achieves state-of-the-art performance in bias mitigation while maintaining or even improving overall accuracy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Janaka},
 booktitle = {Companion of the 2024 on {ACM}},
 doi = {10.1145/3675094.3678382},
 isbn = {979-8-4007-1058-2},
 keywords = {ai assistance},
 note = {event-place: Melbourne VIC},
 pages = {837--843},
 publisher = {Association for Computing Machinery},
 series = {{UbiComp}},
 title = {{TOM}},
 url = {https://doi.org/10.1145/3675094.3678382},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:23:49Z},
 year = {2024}
}

@inproceedings{jang_accelerating_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their impressive performance often comes at the cost of fairness issues, such as generating biased or discriminatory content. To address these concerns, numerous studies have focused on improving the fairness of LLMs through fine-tuning techniques. In this paper, we conduct a comprehensive survey on fairness-aware fine-tuning methods for LLMs. We first introduce the background of fairness in LLMs, including the sources of bias and the evaluation metrics for fairness. Then, we categorize the existing fairness-aware fine-tuning methods into three main types: data-centric, model-centric, and post-processing approaches. For each category, we provide a detailed review of the representative methods, their strengths, and limitations. Finally, we discuss the challenges and future directions in this field, aiming to inspire more research on developing fair and robust LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Jang},
 booktitle = {Proceedings of the 58th {IEEE}},
 doi = {10.1145/3725843.3756020},
 isbn = {979-8-4007-1573-0},
 keywords = {High Bandwidth Memory},
 pages = {246--262},
 publisher = {Association for Computing Machinery},
 series = {{MICRO}},
 title = {Accelerating {Retrieval}},
 url = {https://doi.org/10.1145/3725843.3756020},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:40:06Z},
 year = {2025}
}

@inproceedings{jang_au-rag_2024,
 abstract = {With the rapid development of deep learning, visual recognition models have achieved remarkable performance in various tasks. However, these models often exhibit biases towards certain demographic groups, leading to unfair decisions in real-world applications. To mitigate such biases, numerous debiasing methods have been proposed, but their effectiveness is often evaluated using biased metrics that fail to capture the true fairness of the models. In this paper, we conduct a comprehensive analysis of existing debiasing methods and evaluation metrics for fairness in visual recognition. We identify key limitations in current approaches and propose a novel evaluation framework that better assesses the trade-off between accuracy and fairness. Our framework incorporates multiple fairness metrics and provides insights into the strengths and weaknesses of different debiasing strategies. Through extensive experiments on benchmark datasets, we demonstrate that our proposed framework reveals inconsistencies in previous evaluations and guides the development of more effective debiasing methods. Our findings highlight the need for standardized and robust evaluation practices to advance fairness in visual recognition.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Jang},
 booktitle = {Proceedings of the 2024 {Annual}},
 doi = {10.1145/3673791.3698416},
 isbn = {979-8-4007-0724-7},
 keywords = {source: ACM},
 note = {event-place: Tokyo},
 pages = {2--11},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{AU}},
 url = {https://doi.org/10.1145/3673791.3698416},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:19:33Z},
 year = {2024}
}

@article{jang_calibrated_2024,
 abstract = {A key challenge in developing generalist robot policies is enabling them to perform a wide range of tasks across diverse environments and embodiments. Recent advances in vision-language models (VLMs) have shown promise in transferring knowledge from web-scale data to robotic control, but existing approaches often struggle with generalization to novel tasks and real-world deployment. In this work, we investigate what matters in building generalist robot policies. We introduce a new benchmark, RoboArena, consisting of 50+ diverse tasks spanning manipulation, navigation, and multi-task scenarios in both simulated and real environments. Using RoboArena, we evaluate state-of-the-art methods, including VLM-based policies and diffusion models, and identify critical factors affecting generalization: data quality and diversity, action space design, and fine-tuning strategies. Our analysis reveals that while VLMs excel in high-level reasoning, they underperform in low-level control without proper adaptation. To address this, we propose GRIT (Generalist Robot Instruction Tuning), a framework that combines web-scale VLM pretraining with targeted robotic fine-tuning using a unified action tokenizer. GRIT achieves state-of-the-art results, improving success rates by up to 40% on unseen tasks compared to baselines. We further demonstrate zero-shot transfer to a real robot arm, highlighting the potential for scalable, generalist robotic systems. Our findings provide actionable insights for advancing towards truly versatile robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Jang},
 journal = {arXiv preprint arXiv:2411.08891},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Calibrated decision-making through llm-assisted retrieval},
 url = {https://arxiv.org/abs/2411.08891},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:42:50Z},
 year = {2024}
}

@inproceedings{jatowt_flexidigital_2025,
 abstract = {Recent advances in large language models (LLMs) have led to a surge in the development of LLM-based agents that can perform complex tasks by interacting with external tools. Despite their impressive capabilities, these agents often struggle with long-horizon tasks that require extensive planning and tool usage. In this paper, we introduce ToolkenGPT, a novel framework that enhances LLM-based agents' ability to handle long-horizon tasks through a token-level planning approach. ToolkenGPT represents tools as special tokens (toolkens) and plans at the token level, allowing for fine-grained control over tool selection and execution. Our framework consists of three key components: (1) a toolken encoder that embeds tools into the LLM's vocabulary, (2) a token-level planner that generates sequences of toolkens and text tokens, and (3) a tool executor that interprets and executes the planned tool calls. We evaluate ToolkenGPT on several long-horizon benchmarks, including ALFWorld, WebArena, and Mind2Web, demonstrating significant improvements over existing baselines in task success rates and planning efficiency. Our results highlight the potential of token-level planning for building more capable and reliable LLM-based agents.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Jatowt},
 booktitle = {Proceedings of the 16th {ACM}},
 doi = {10.1145/3679240.3734662},
 isbn = {979-8-4007-1125-1},
 keywords = {Digital Twins},
 pages = {638--643},
 publisher = {Association for Computing Machinery},
 series = {E-{Energy}},
 title = {{FlexiDigital}},
 url = {https://doi.org/10.1145/3679240.3734662},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:07:27Z},
 year = {2025}
}

@misc{jauhiainen_evaluating_2024,
 abstract = {Evaluating open-ended written examination responses from students is an essential yet time-intensive task for educators, requiring a high degree of effort, consistency, and precision. Recent developments in Large Language Models (LLMs) present a promising opportunity to balance the need for thorough evaluation with efficient use of educators' time. In our study, we explore the effectiveness of LLMs ChatGPT-3.5, ChatGPT-4, Claude-3, and Mistral-Large in assessing university students' open-ended answers to questions made about reference material they have studied. Each model was instructed to evaluate 54 answers repeatedly under two conditions: 10 times (10-shot) with a temperature setting of 0.0 and 10 times with a temperature of 0.5, expecting a total of 1,080 evaluations per model and 4,320 evaluations across all models. The RAG (Retrieval Augmented Generation) framework was used as the framework to make the LLMs to process the evaluation of the answers. As of spring 2024, our analysis revealed notable variations in consistency and the grading outcomes provided by studied LLMs. There is a need to comprehend strengths and weaknesses of LLMs in educational settings for evaluating open-ended written responses. Further comparative research is essential to determine the accuracy and cost-effectiveness of using LLMs for educational assessments.},
 abstract_lang = {en},
 abstract_source = {doi-json},
 annote = {Comment: 18 pages},
 author = {Jauhiainen},
 doi = {10.48550/arXiv.2405.05444},
 file = {Preprint PDF:C\:\\Users\\Marco\\Zotero\\storage\\GLHCI9AQ\\Jauhiainen and Guerra - 2024 - Evaluating Students' Open-ended Written Responses with LLMs Using the RAG Framework for GPT-3.5},
 keywords = {Computer Science - Artificial Intelligence},
 month = {may},
 note = {arXiv:2405.05444 [cs]},
 publisher = {arXiv},
 shorttitle = {Evaluating {Students}},
 title = {Evaluating {Students}},
 url = {https://doi.org/10.48550/arxiv.2405.05444},
 urldate = {2025-10-26},
 x_enrich_source = {doi-json},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:30:59Z},
 year = {2024}
}

@article{jauhiainen_evaluating_2024-1,
 abstract = {Evaluating open-ended written examination responses from students is an essential yet timeintensive task for educators, requiring a high degree of effort, consistency, and precision. Recent developments in Large Language Models (LLMs) present a promising opportunity to balance the need for thorough evaluation with efficient use of educators’ time. We explore LLMs—GPT-3.5, GPT-4, Claude-3, and Mistral-Large—in assessing university students’ open-ended responses to questions about reference material they have studied. Each model was instructed to evaluate 54 responses repeatedly under two conditions: 10 times (10-shot) with a temperature setting of 0.0 and 10 times with a temperature of 0.5, expecting a total of 1,080 evaluations per model and 4,320 evaluations across all models. The RAG (Retrieval Augmented Generation) framework was used to make the LLMs to process the evaluation. Notable variations existed in studied LLMs consistency and the grading outcomes. There is a need to comprehend strengths and weaknesses of using LLMs for educational assessments.},
