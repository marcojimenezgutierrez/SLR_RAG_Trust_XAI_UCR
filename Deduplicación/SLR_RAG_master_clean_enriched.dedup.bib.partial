 year = {2024}
}

@article{abtahi_augmenting_2025,
 abstract = {This paper presents a novel approach to secure multi-party computation in distributed systems, leveraging homomorphic encryption techniques to ensure privacy-preserving data aggregation. We introduce ForgeSecure, a framework that optimizes computation overhead by 40% compared to existing methods, while maintaining robustness against adaptive adversaries. Experimental results on real-world datasets demonstrate the efficacy of our protocol in IoT applications, achieving sub-second latency for large-scale aggregations.},
