 year = {2025}
}

@inproceedings{mridul_provakar_exploring_2025,
 abstract = {Vision-language models (VLMs) have achieved remarkable success in various vision tasks, but they often struggle with temporal reasoning in videos due to the lack of explicit temporal modeling. In this paper, we propose a novel approach to enhance the temporal reasoning capabilities of VLMs by incorporating a temporal graph structure that captures the dynamic evolution of visual concepts across video frames. Our method constructs a concept graph where nodes represent visual concepts detected in each frame, and edges model temporal transitions and dependencies between concepts. We then integrate this graph into the VLM's attention mechanism to guide the model in focusing on temporally coherent patterns. Extensive experiments on video question answering and temporal action localization benchmarks demonstrate that our approach significantly improves the model's ability to reason about temporal dynamics, outperforming state-of-the-art VLMs by up to 15% in accuracy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Mridul Provakar},
 booktitle = {Proceedings of the 3rd {International}},
 doi = {10.1145/3723178.3723244},
