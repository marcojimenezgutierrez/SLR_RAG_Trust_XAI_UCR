@inproceedings{boumber_llms_2024,
 abstract = {Recent advances in large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their application to interactive systems remains underexplored, particularly in health and wellness domains. In this paper, we present BreathGPT, a human-AI co-creation system that uses LLMs to collaboratively design personalized breathing exercises. Users describe their goals, mood, and constraints via natural language, and the LLM generates customized exercise scripts, which are then refined through iterative conversation. BreathGPT integrates with a mobile app that guides users through the exercises using audio and visual cues. Through a user study with 24 participants, we demonstrate that BreathGPT produces exercises perceived as more personalized and motivating compared to static templates, while maintaining safety and efficacy. Our findings highlight the potential of LLMs for accessible, adaptive health interventions and discuss design implications for co-creative AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
