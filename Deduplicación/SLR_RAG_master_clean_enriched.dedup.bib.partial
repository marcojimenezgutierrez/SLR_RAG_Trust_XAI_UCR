 year = {2025}
}

@inproceedings{wendelken_roux-lette_2024,
 abstract = {This study investigates the effects of climate change on agricultural productivity in sub-Saharan Africa, using panel data from 2000 to 2020 across 45 countries. Employing a fixed-effects regression model, we analyze how temperature and precipitation variations impact crop yields for major staples like maize, rice, and sorghum. Results indicate a significant negative correlation between rising temperatures and yields, with a 1°C increase leading to a 5-10% decline in productivity. Precipitation deficits exacerbate these effects, particularly in rain-fed farming systems. The findings underscore the urgency for adaptive strategies, including drought-resistant crop varieties and improved irrigation infrastructure, to mitigate future food security risks in the region.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Wendelken},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
