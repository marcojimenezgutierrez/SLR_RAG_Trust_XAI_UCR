@article{yin_chathpc_2024,
 abstract = {The U.S. Department of Energy (DOE) Office of Scientific and Technical Information (OSTI) is responsible for collecting, preserving, and disseminating scientific and technical information stemming from research supported by the Department. OSTI’s mission is to advance scientific discovery and innovation by making research results widely accessible. This report provides an overview of OSTI’s activities, achievements, and future directions in fulfilling this mission. Key areas of focus include the development and maintenance of world-class scientific databases, the implementation of innovative information tools and services, and the promotion of open science principles. OSTI continues to evolve its capabilities to meet the needs of the global research community, ensuring that DOE-funded research contributes to solving the nation’s most pressing challenges.},
