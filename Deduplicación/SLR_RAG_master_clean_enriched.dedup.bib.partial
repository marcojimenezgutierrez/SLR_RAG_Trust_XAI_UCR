@article{fan_why_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) has led to the development of various explainable AI (XAI) techniques to enhance the interpretability of black-box models. In the context of COVID-19 detection, where timely and accurate diagnosis is crucial, XAI methods can provide insights into the decision-making process of AI models, thereby increasing trust and facilitating clinical adoption. This paper reviews the state-of-the-art XAI approaches applied to COVID-19 detection using medical imaging, such as chest X-rays and CT scans. We categorize XAI techniques into model-agnostic and model-specific methods, discussing their strengths, limitations, and applications in explaining AI predictions for COVID-19 severity assessment, lesion localization, and prognosis prediction. Furthermore, we highlight challenges such as the trade-off between accuracy and explainability, ethical considerations, and the need for validation in diverse datasets. Finally, we outline future directions for integrating XAI in real-world clinical settings to combat pandemics effectively.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Fan},
 doi = {10.1007/978-3-031-98459-4_23},
 journal = {Lecture Notes in Computer Science},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {321 -- 335},
 title = {Why {Did}},
 url = {https://doi.org/10.1007/978-3-031-98459-4_23},
 volume = {15880 LNAI},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:52:58Z},
 year = {2025}
}

@inproceedings{fang_cross-cultural_2025,
 abstract = {Social media platforms have become a primary source of information for many users, but the spread of misinformation poses significant challenges. Detecting misinformation at scale requires reliable signals, yet human fact-checkers are limited in capacity. Automated detection methods often rely on content features or network propagation patterns, but these can be gamed or bypassed. In this work, we propose a novel approach to misinformation detection that leverages the temporal dynamics of user interactions on social media. Specifically, we model the evolution of engagement patterns around claims using a graph-based representation that captures both structural and temporal information. Our method, Temporal Interaction Graph (TIG), constructs dynamic graphs where nodes represent users and claims, and edges encode interaction types (e.g., shares, comments) over time windows. We then apply a graph neural network with temporal attention to learn embeddings that distinguish credible from misleading content. Experiments on real-world datasets from Twitter and Facebook demonstrate that TIG outperforms state-of-the-art baselines by up to 15% in AUC, particularly in early detection scenarios before widespread propagation. Our approach is robust to adversarial perturbations and requires minimal labeled data, making it suitable for real-time deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Fang},
 booktitle = {Proceedings of the 15th {International}},
 doi = {10.1145/3706468.3706528},
 isbn = {979-8-4007-0701-8},
 keywords = {Affective computing},
 pages = {473--483},
 publisher = {Association for Computing Machinery},
 series = {{LAK}},
 title = {A {Cross}},
 url = {https://doi.org/10.1145/3706468.3706528},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:46:00Z},
 year = {2025}
}

@inproceedings{fang_enhancing_2024,
 abstract = {While recent advances in large language models have made them capable of handling long contexts, it remains unclear whether these models can effectively utilize the information in the middle of long inputs. We investigate this question through carefully-designed experiments, and find that performance degrades substantially as information is moved to the middle of the input. We refer to this degradation as "lost-in-the-middle" and show that it is a general phenomenon across different model families and lengths of context. Our results suggest that language models may be better suited for tasks where relevant information is near the beginning or end of the input, rather than in the middle.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 3},
 author = {Fang},
