 title = {Research on the {Construction}},
 url = {https://doi.org/10.1109/dsit61374.2024.10881483},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:06:08Z},
 year = {2024}
}

@article{xu_retrieval-augmented_2024,
 abstract = {Face recognition systems have achieved remarkable success in various applications, yet they often exhibit significant biases, particularly against certain demographic groups such as women and people with darker skin tones. These biases can lead to unfair treatment and discrimination in real-world deployments. In this paper, we propose a novel approach to mitigate gender bias in face recognition by leveraging contrastive learning with fairness-aware augmentations. Specifically, we introduce a fairness-aware data augmentation strategy that generates balanced synthetic samples for underrepresented groups in the feature space. Our method integrates a contrastive loss with a fairness regularization term to encourage the model to learn equitable representations across genders. Extensive experiments on popular benchmarks like RFW and IJB-C demonstrate that our approach substantially reduces gender bias while preserving or even improving overall recognition accuracy. Our work provides a simple yet effective solution towards building fairer face recognition systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
