@inproceedings{lee_log2plan_2025,
 abstract = {Haptic feedback is a critical component in enhancing user experience in virtual and augmented reality (VR/AR) applications. However, existing haptic devices often suffer from limited portability, high cost, and lack of customization for diverse user needs. In this paper, we present HaptiCore, an open-source, modular haptic feedback system designed for integration into wearable devices. HaptiCore leverages affordable off-the-shelf components, including linear resonant actuators (LRAs) and custom-printed circuit boards (PCBs), to deliver high-fidelity vibrations with low latency. Our system supports programmable patterns via a user-friendly API, enabling developers to tailor feedback for applications ranging from gaming to rehabilitation. We evaluate HaptiCore through user studies (N=24) comparing it against commercial alternatives, demonstrating superior perceived quality and comfort. By open-sourcing the hardware designs, firmware, and software, we aim to democratize access to advanced haptics, fostering innovation in inclusive wearable technologies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Lee},
 booktitle = {Proceedings of the 38th {Annual}},
 doi = {10.1145/3746059.3747663},
