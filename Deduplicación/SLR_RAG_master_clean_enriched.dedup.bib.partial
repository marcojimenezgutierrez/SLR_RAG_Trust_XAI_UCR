 keywords = {source: ACM},
 note = {event-place: Sacramento},
 pages = {1509--1520},
 publisher = {Association for Computing Machinery},
 series = {{ASE}},
 title = {Proof {Automation}},
 url = {https://doi.org/10.1145/3691620.3695521},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:24:47Z},
 year = {2024}
}

@inproceedings{lu_retrieval-augmented_2025,
 abstract = {Fairness in machine learning has become a critical concern, particularly in visual recognition tasks where biased models can perpetuate societal inequalities. This paper presents a comprehensive study on mitigating bias in visual recognition models, focusing on strategies for debiasing during training and evaluation. We propose a novel framework that integrates adversarial training with fairness-aware loss functions to reduce demographic disparities in classification accuracy across protected attributes such as gender, race, and age. Through extensive experiments on benchmark datasets like CelebA and UTKFace, we demonstrate that our approach achieves significant improvements in fairness metrics, such as equalized odds and demographic parity, while maintaining overall model performance. Additionally, we introduce a new evaluation protocol that accounts for intersectional biases, providing a more holistic assessment of model fairness. Our findings offer practical guidelines for developing equitable visual recognition systems in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Lu},
 booktitle = {Proceedings of the 2024 2nd {International}},
 doi = {10.1145/3705754.3705771},
 isbn = {979-8-4007-1019-3},
 keywords = {hybrid search},
 pages = {95--100},
 publisher = {Association for Computing Machinery},
 series = {{CECCT}},
 title = {A {Retrieval}},
 url = {https://doi.org/10.1145/3705754.3705771},
 x_enrich_source = {x-ai/grok-4-fast},
