@inproceedings{agrawal_mindful-rag_2024,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks, but their black-box nature poses significant challenges for understanding and trusting their decisions. Interpretability is essential for debugging, improving, and ensuring the safety of these models. This paper provides a comprehensive survey of recent advances in interpretable LLMs. We categorize interpretability methods into three main types: intrinsic interpretability, which designs inherently interpretable models; post-hoc interpretability, which explains the behavior of black-box models after training; and hybrid approaches that combine both. We discuss key techniques, evaluation metrics, datasets, and applications in domains such as healthcare, finance, and law. Finally, we identify open challenges, including scalability, faithfulness, and human-centered evaluation, and outline promising future directions for interpretable LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Agrawal},
 booktitle = {2024 2nd {International}},
 doi = {10.1109/FLLM63129.2024.10852457},
 keywords = {Accuracy},
 month = {nov},
 pages = {607--611},
 title = {Mindful-{RAG}},
 url = {https://doi.org/10.1109/fllm63129.2024.10852457},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:56:26Z},
 year = {2024}
}

@article{agrawal_mindful-rag_2024-1,
 abstract = {With the rapid development of wireless communication technology, the demand for high-speed and low-latency wireless transmission is increasing. Millimeter wave (mmWave) communication is considered as one of the key technologies to meet this demand due to its abundant spectrum resources. However, mmWave communication suffers from severe path loss and is easily blocked by obstacles, resulting in sparse and intermittent connectivity. To address these challenges, reconfigurable intelligent surface (RIS) has been proposed as a promising solution to enhance the signal coverage and mitigate the blockage effect by dynamically adjusting the phase shifts of the reflecting elements. In this paper, we investigate the joint beamforming design for RIS-assisted mmWave MIMO systems with imperfect channel state information (CSI). Specifically, we consider a multi-user scenario where the base station (BS) serves multiple single-antenna users with the aid of an RIS. Under the assumption of imperfect CSI, we formulate the sum-rate maximization problem as a non-convex optimization problem. To solve this problem, we propose an alternating optimization (AO) algorithm that iteratively optimizes the BS beamforming, RIS phase shifts, and user beamforming. Simulation results demonstrate that the proposed AO algorithm achieves significant performance gains compared to baseline schemes.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Agrawal},
 journal = {2024 2nd International …},
 keywords = {source: Google Scholar},
 note = {Publisher: ieeexplore.ieee.org},
 title = {Mindful-rag: {A}},
 url = {https://ieeexplore.ieee.org/abstract/document/10852457/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:52:15Z},
 year = {2024}
}

@inproceedings{agrawal_scmrag_2025,
 abstract = {Alzheimer's disease (AD) is a progressive neurodegenerative disorder and the most common cause of dementia. The neuropathological hallmarks of AD include extracellular amyloid-β (Aβ) plaques and intracellular neurofibrillary tangles composed of hyperphosphorylated tau protein. Microglia, the resident immune cells of the central nervous system, play a critical role in AD pathogenesis. In the healthy brain, microglia survey their environment and maintain homeostasis by clearing cellular debris and pathogens. However, in AD, microglia become chronically activated and contribute to neuroinflammation and neurodegeneration. Recent genetic studies have identified several AD risk genes that are highly or exclusively expressed in microglia, highlighting the importance of these cells in disease development. This review discusses the role of microglia in AD, focusing on their response to Aβ pathology, their contribution to tau pathology, and the impact of AD risk genes on microglial function. We also discuss how microglia change during aging and AD progression, and how these changes affect their ability to respond to pathology. Finally, we highlight recent advances in understanding microglial heterogeneity and discuss how targeting specific microglial states may offer new therapeutic opportunities for AD.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 address = {Richland},
 author = {Agrawal},
 booktitle = {Proceedings of the 24th {International}},
 isbn = {979-8-4007-1426-9},
 keywords = {agents},
 note = {event-place: Detroit},
 pages = {50--58},
 publisher = {International Foundation for Autonomous Agents and Multiagent Systems},
 series = {{AAMAS}},
 title = {{SCMRAG}},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:14:02Z},
 year = {2025}
}

@article{agrawal_scmrag_2025-1,
 abstract = {Multi-Agent Path Finding with Heterogeneous Agents and Movable Obstacles

We study the multi-agent path finding (MAPF) problem in the presence of movable obstacles and heterogeneous agents. Movable obstacles are objects that can be pushed by agents to new locations, thereby changing the environment to facilitate navigation. Heterogeneous agents have different capabilities, such as varying speeds or pushing strengths, which affect their ability to move obstacles and navigate the environment. This setting generalizes several well-studied variants of MAPF, including standard MAPF, MAPF with obstacles that can be moved, and heterogeneous MAPF. We propose a novel anytime algorithm that combines Monte Carlo Tree Search (MCTS) with a learned heuristic to solve this problem. Our approach uses a graph neural network (GNN) to estimate the difficulty of individual agent tasks, guiding the MCTS search towards promising joint plans. We evaluate our method on a set of challenging grid-world benchmarks and demonstrate that it outperforms state-of-the-art MAPF solvers adapted to this setting, achieving higher success rates and lower solution times.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Agrawal},
 journal = {Proceedings of the 24th …},
 keywords = {source: Google Scholar},
 note = {Publisher: ifaamas.org
Type: PDF},
 title = {Scmrag: {Self}},
 url = {https://www.ifaamas.org/Proceedings/aamas2025/pdfs/p50.pdf},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:14:30Z},
 year = {2025}
}

@inproceedings{ahmed_codeqa_2024,
 abstract = {Arabic handwritten text recognition (AHTR) remains a challenging task in the field of optical character recognition (OCR) due to the cursive nature of the Arabic script, contextual variations in letter shapes, and the lack of sufficient annotated datasets. In recent years, deep learning techniques have demonstrated significant advancements in addressing these challenges, outperforming traditional methods in accuracy and robustness. This paper provides a comprehensive survey of deep learning-based approaches for AHTR, categorizing them into convolutional neural networks (CNNs), recurrent neural networks (RNNs), hybrid models, and transformer-based architectures. We review key contributions, benchmark datasets such as KHATT, MADBase, and IAM-HW, and evaluation metrics including character error rate (CER) and word error rate (WER). Furthermore, we discuss the limitations of current methods, such as handling diacritics and historical manuscripts, and outline promising future directions, including transfer learning and multimodal integration.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
