@article{garcia-carmona_leveraging_2025,
 abstract = {Background The digital transformation of health care has introduced both opportunities and challenges, particularly in managing and analyzing the vast amounts of unstructured medical data generated daily. There is a need to explore the feasibility of generative solutions in extracting data from medical reports, categorized by specific criteria. Objective This study aimed to investigate the application of large language models (LLMs) for the automated extraction of structured information from unstructured medical reports, using the LangChain framework in Python. Methods Through a systematic evaluation of leading LLMs—GPT-4o, Llama 3, Llama 3.1, Gemma 2, Qwen 2, and Qwen 2.5—using zero-shot prompting techniques and embedding results into a vector database, this study assessed the performance of LLMs in extracting patient demographics, diagnostic details, and pharmacological data. Results Evaluation metrics, including accuracy, precision, recall, and F1-score, revealed high efficacy across most categories, with GPT-4o achieving the highest overall performance (91.4% accuracy). Conclusions The findings highlight notable differences in precision and recall between models, particularly in extracting names and age-related information. There were challenges in processing unstructured medical text, including variability in model performance across data types. Our findings demonstrate the feasibility of integrating LLMs into health care workflows; LLMs offer substantial improvements in data accessibility and support clinical decision-making processes. In addition, the paper describes the role of retrieval-augmented generation techniques in enhancing information retrieval accuracy, addressing issues such as hallucinations and outdated data in LLM outputs. Future work should explore the need for optimization through larger and more diverse training datasets, advanced prompting strategies, and the integration of domain-specific knowledge to improve model generalizability and precision.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 1; All Open Access; Gold Open Access},
 author = {Garcia-Carmona},
 doi = {10.2196/68776},
 journal = {JMIR AI},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Leveraging {Large}},
 url = {https://doi.org/10.2196/68776},
 volume = {4},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:54:54Z},
 year = {2025}
}

@article{garcia_df-rag_2025,
 abstract = {Generative AI (GenAI) tools have become integral to software development, yet their impact on mobile app development remains underexplored. We investigate how developers use GenAI in mobile app workflows through a mixed-methods study involving 24 professional developers and analysis of 1,200+ GitHub repositories. Our findings reveal that GenAI accelerates prototyping but introduces challenges in code quality, integration, and debugging. Developers often "snap" UI ideas via image generation, "chat" for code snippets, and iteratively refine outputs. We identify key tensions, such as over-reliance on GenAI leading to technical debt, and propose design implications for GenAI tools tailored to mobile development, including better context awareness and validation mechanisms.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Garcia},
 booktitle = {2025 {IEEE}},
 doi = {10.1145/3721201.3725426},
 keywords = {source: Scopus},
 month = {jun},
