 year = {2025}
}

@inproceedings{liu_retrieval-augmented_2025,
 abstract = {Infrared small target detection (ISTD) is a fundamental task in infrared search and track systems, which is challenging due to the extremely small size and low signal-to-noise ratio (SNR) of targets. Traditional methods often suffer from high false alarm rates and miss detections in complex backgrounds. In this paper, we propose a novel deep learning-based super-resolution (SR) framework for ISTD, termed SR-ISTD, which leverages SR techniques to enhance target discriminability before detection. Specifically, we design an SR network based on the enhanced deep super-resolution (EDSR) architecture, tailored for infrared imagery by incorporating infrared-specific loss functions to preserve thermal details. The SR-enhanced images are then fed into a lightweight YOLOv5 detector fine-tuned for small object detection. Extensive experiments on public ISTD datasets demonstrate that our SR-ISTD achieves significant improvements in detection precision and recall, outperforming state-of-the-art methods by up to 15% in F1-score while maintaining real-time efficiency.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Liu},
 booktitle = {Proceedings of {SPIE}},
 doi = {10.1117/12.3073002},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 title = {A retrieval-augmented large language model hybrid framework for adaptive wireless resource allocation: design},
 url = {https://doi.org/10.1117/12.3073002},
 volume = {13661},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:56:47Z},
 year = {2025}
}

@article{liu_retrieval_2025,
 abstract = {In this paper, we propose a novel framework for enhancing the security of Internet of Things (IoT) devices using blockchain technology. The proposed system leverages smart contracts to enable secure and decentralized data sharing among IoT devices. We address key challenges such as data privacy, integrity, and scalability in IoT environments. Experimental results demonstrate that our approach significantly improves security while maintaining low latency, making it suitable for real-time IoT applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
