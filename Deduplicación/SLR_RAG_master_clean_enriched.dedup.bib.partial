@inproceedings{azimi_towards_2025,
 abstract = {In this paper, we explore the potential of large language models (LLMs) as autonomous agents capable of performing complex, multi-step tasks in dynamic environments. Unlike traditional approaches that rely on predefined scripts or rule-based systems, our framework enables LLMs to reason, plan, and execute actions through natural language interfaces. We introduce a novel prompting strategy that combines chain-of-thought reasoning with tool-use capabilities, allowing the model to interact with external APIs, databases, and sensors in real-time. Through extensive experiments on benchmark tasks such as web navigation, data analysis, and robotic control, we demonstrate that our LLM agents achieve superior performance, adaptability, and generalization compared to state-of-the-art baselines. Our findings highlight key challenges, including hallucination mitigation and safety considerations, paving the way for more reliable deployment of LLM-based agents in practical applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
