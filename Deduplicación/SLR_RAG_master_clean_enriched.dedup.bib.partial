@article{peng_graph_2024,
 abstract = {Learning generalist robot policies that can perform a variety of tasks in a range of environments is a longstanding goal in robotics. However, most existing approaches focus on learning policies for a single task or a small set of tasks, limiting their applicability to real-world scenarios where robots need to handle diverse and unforeseen situations. In this work, we propose a framework for learning generalist robot policies that can be applied to a wide range of manipulation tasks. Our approach leverages large-scale pre-training on diverse datasets, followed by fine-tuning on specific tasks. We evaluate our method on a suite of challenging manipulation tasks and demonstrate that our generalist policies outperform task-specific policies in terms of sample efficiency and generalization. Our results suggest that scaling up pre-training data and model size is key to achieving generalist robot capabilities.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
