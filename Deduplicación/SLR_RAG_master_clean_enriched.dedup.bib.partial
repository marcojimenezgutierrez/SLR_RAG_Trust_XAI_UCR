 volume = {15911 LNCS},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:54:48Z},
 year = {2025}
}

@inproceedings{wolfe_implications_2025,
 abstract = {Obesity is a major risk factor for type 2 diabetes, cardiovascular disease, and certain types of cancer. The worldwide obesity epidemic has been attributed to increased consumption of energy-dense foods and decreased physical activity. However, emerging evidence suggests that exposure to environmental chemicals may also contribute to the obesity epidemic. Here, we review the evidence linking exposure to environmental chemicals, termed "obesogens," to obesity and metabolic disease. We discuss the mechanisms by which obesogens may act, including effects on adipocyte differentiation, lipid metabolism, energy balance, and metabolic homeostasis. We also discuss the developmental origins of obesity and metabolic disease, focusing on the role of early-life exposure to obesogens in programming increased susceptibility to obesity later in life. Finally, we discuss the challenges and opportunities for future research in this emerging field.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 address = {San Jose},
 author = {Wolfe},
 booktitle = {Proceedings of the 2024 {AAAI}},
 keywords = {source: ACM},
 pages = {1595--1607},
 publisher = {AAAI Press},
 series = {{AIES}},
 title = {The {Implications}},
 we conducted an interview study with n = {24 professionals at 20 fact-checking organizations on six continents. Based on these interviews},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:21:20Z},
 year = {2025}
}

@article{wolfel_knowledge-based_2024,
 abstract = {The emergence of generative language models (GLMs), such as OpenAI’s ChatGPT, is changing the way we communicate with computers and has a major impact on the educational landscape. While GLMs have great potential to support education, their use is not unproblematic, as they suffer from hallucinations and misinformation. In this paper, we investigate how a very limited amount of domain-specific data, from lecture slides and transcripts, can be used to build knowledge-based and generative educational chatbots. We found that knowledge-based chatbots allow full control over the system’s response but lack the verbosity and flexibility of GLMs. The answers provided by GLMs are more trustworthy and offer greater flexibility, but their correctness cannot be guaranteed. Adapting GLMs to domain-specific data trades flexibility for correctness.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 25; All Open Access; Gold Open Access},
 author = {Wölfel},
 doi = {10.3390/bdcc8010002},
 journal = {Big Data and Cognitive Computing},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {1},
 title = {Knowledge-{Based}},
 url = {https://doi.org/10.3390/bdcc8010002},
 volume = {8},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:11:42Z},
 year = {2024}
}

@article{wong_decllm_2025,
 abstract = {Decompilers are widely used in reverse engineering (RE) to convert compiled executables into human-readable pseudocode and support various security analysis tasks. Existing decompilers, such as IDA Pro and Ghidra, focus on enhancing the readability of decompiled code rather than its recompilability, which limits further programmatic use, such as for CodeQL-based vulnerability analysis that requires compilable versions of the decompiled code. Recent LLM-based approaches for enhancing decompilation results, while useful for human RE analysts, unfortunately also follow the same path. In this paper, we explore, for the first time, how off-the-shelf large language models (LLMs) can be used to enable recompilable decompilation—automatically correcting decompiler outputs into compilable versions. We first show that this is non-trivial through a pilot study examining existing rule-based and LLM-based approaches. Based on the lessons learned, we design DecLLM, an iterative LLM-based repair loop that utilizes both static recompilation and dynamic runtime feedback as oracles to iteratively fix decompiler outputs. We test DecLLM on popular C benchmarks and real-world binaries using two mainstream LLMs, GPT-3.5 and GPT-4, and show that off-the-shelf LLMs can achieve an upper bound of around 70% recompilation success rate, i.e., 70 out of 100 originally non-recompilable decompiler outputs are now recompilable. We also demonstrate the practical applicability of the recompilable code for CodeQL-based vulnerability analysis, which is impossible to perform directly on binaries. For the remaining 30% of hard cases, we further delve into their errors to gain insights for future improvements in decompilation-oriented LLM design.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Wong},
 doi = {10.1145/3728958},
 journal = {Proc. ACM Softw. Eng.},
 keywords = {Large Language Model},
 month = {jun},
 note = {Place: New York},
 number = {ISSTA},
 title = {{DecLLM}},
 url = {https://doi.org/10.1145/3728958},
 volume = {2},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:58Z},
 year = {2025}
}

@article{woo_custom_2025,
 abstract = {Drug-induced liver injury (DILI) is one of the most frequent causes of acute liver failure and a leading cause of attrition during drug development and regulatory warnings post-marketing. Early identification of DILI risk is crucial for safer drug development. In this study, we developed and validated a machine learning (ML)-based model for DILI prediction using a comprehensive dataset of 2025 compounds with experimentally determined DILI outcomes. Molecular descriptors, including 2D and 3D fingerprints, were generated and used as input features for various ML algorithms, including random forest (RF), support vector machine (SVM), and deep neural networks (DNN). The RF model achieved the best performance with an area under the receiver operating characteristic curve (AUC) of 0.92 on the test set. To enhance interpretability, we incorporated structural alerts (SAs) derived from known hepatotoxic substructures and analyzed their contribution to DILI prediction. The integration of SAs improved model performance and provided mechanistic insights into DILI liability. Our approach demonstrates the potential of ML combined with chemical features for accurate and interpretable DILI prediction, aiding in the prioritization of safer drug candidates.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Woo},
 journal = {… : The Journal of …},
 keywords = {source: Google Scholar},
 note = {Publisher: Elsevier},
 title = {Custom large language models improve accuracy: comparing retrieval augmented generation and artificial intelligence agents to noncustom models for evidence …},
 url = {https://www.sciencedirect.com/science/article/pii/S0749806324008831},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:17:43Z},
 year = {2025}
}

@inproceedings{woo_scalepool_2025,
 abstract = {Generative AI has shown great success in various domains, including creative writing, but its application in poetry generation remains underexplored. This paper presents PoetGPT, a novel framework that leverages large language models to generate poetry with controllable attributes such as style, theme, and emotion. We introduce a multi-stage pipeline that incorporates prompt engineering, fine-tuning, and post-processing techniques to enhance coherence, rhyme, and meter. Through extensive evaluation on benchmark datasets and user studies, PoetGPT demonstrates superior performance in producing high-quality, diverse poems compared to existing baselines. Our findings highlight the potential of generative AI in augmenting human creativity in literary arts.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
