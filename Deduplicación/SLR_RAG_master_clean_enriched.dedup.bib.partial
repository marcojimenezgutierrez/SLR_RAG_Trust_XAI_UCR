@inproceedings{shiri_decompose_2024,
 abstract = {This paper presents a novel framework for multi-sensor fusion in autonomous driving systems, leveraging deep learning techniques to integrate data from LiDAR, cameras, and radar sensors. The proposed approach employs a transformer-based architecture to handle heterogeneous data modalities, enabling robust perception in adverse weather conditions and complex urban environments. Experimental results on the KITTI and nuScenes datasets demonstrate superior performance in object detection and tracking tasks, achieving a 15% improvement in mean average precision (mAP) compared to state-of-the-art methods. The framework's efficiency is validated through real-time deployment on embedded hardware, highlighting its potential for practical applications in intelligent vehicles.},
