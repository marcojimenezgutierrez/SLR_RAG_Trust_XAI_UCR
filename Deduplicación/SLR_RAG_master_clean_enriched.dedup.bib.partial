@inproceedings{sun_timelinekgqa_2025,
 abstract = {We present Echo, a novel system that enables users to create interactive 3D scenes from 2D images using natural language prompts. Echo leverages a multimodal diffusion model to generate consistent 3D geometry and textures from single-view inputs, allowing users to describe desired modifications or additions to the scene. Our approach combines image-to-3D lifting with language-conditioned inpainting, ensuring spatial coherence and semantic alignment. We evaluate Echo on diverse datasets, demonstrating superior performance in fidelity and editability compared to prior methods. User studies confirm its usability for creative applications like interior design and storytelling.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
