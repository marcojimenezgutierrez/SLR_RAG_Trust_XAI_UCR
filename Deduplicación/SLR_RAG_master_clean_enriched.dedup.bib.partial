@article{majumder_development_2025,
 abstract = {Early detection of diabetic retinopathy (DR) is crucial for preventing vision loss in diabetic patients. Traditional screening methods are time-consuming and require expert ophthalmologists. In this paper, we propose a deep learning-based approach for automated DR detection using fundus images. Our model employs a hybrid convolutional neural network (CNN) architecture combining ResNet and DenseNet to extract robust features from retinal images. The dataset used is the Indian Diabetic Retinopathy Image Dataset (IDRiD), which includes images labeled for DR severity and lesion presence. We incorporate attention mechanisms to focus on key regions such as microaneurysms and hemorrhages. Experimental results show that our model achieves an accuracy of 95.2%, sensitivity of 94.8%, and specificity of 96.1%, outperforming state-of-the-art methods. This approach enables efficient, scalable screening for DR in resource-limited settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Majumder},
 doi = {10.1007/978-981-96-5511-3_38},
 journal = {Lecture Notes in Mechanical Engineering},
 keywords = {source: Scopus},
