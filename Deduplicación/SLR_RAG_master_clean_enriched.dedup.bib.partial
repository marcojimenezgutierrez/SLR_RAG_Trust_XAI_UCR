 x_enrich_ts = {2025-11-02T08:33:38Z},
 year = {2025}
}

@article{zhang_plantgpt_2025,
 abstract = {Abstract Research into plant gene function is crucial for developing strategies to increase crop yields. The recent introduction of large language models (LLMs) offers a means to aggregate large amounts of data into a queryable format, but the output can contain inaccurate or false claims known as hallucinations. To minimize such hallucinations and produce high‐quality knowledge‐based outputs, the abstracts of over 60 000 plant research articles are compiled into a Chroma database for retrieval‐augmented generation (RAG). Then linguistic data are used from 13 993 Arabidopsis ( Arabidopsis thaliana ) phenotypes and 23 323 gene functions to fine‐tune the LLM Llama3‐8B, producing PlantGPT, a virtual expert in Arabidopsis phenotype–gene research. By evaluating answers to test questions, it is demonstrated that PlantGPT outperforms general LLMs in answering specialized questions. The findings provide a blueprint for functional genomics research in food crops and demonstrate the potential for developing LLMs for plant research modalities. To provide broader access and facilitate adoption, the online tool http://www.plantgpt.icu is developed, which will allow researchers to use PlantGPT in their scientific investigations.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 7; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Zhang},
 doi = {10.1002/advs.202503926},
 journal = {Advanced Science},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {30},
 title = {{PlantGPT}},
 url = {https://doi.org/10.1002/advs.202503926},
 volume = {12},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:35:12Z},
 year = {2025}
}

@article{zhang_raft_2024,
 abstract = {Recent work has demonstrated that fine-tuning large language models (LLMs) on a single mathematical task can lead to dramatic improvements in performance on related tasks, even when those tasks are structurally dissimilar. However, the mechanisms underlying this generalization remain poorly understood. In this work, we investigate the fine-tuning dynamics of LLMs on mathematical problem-solving tasks. We find that fine-tuning on a single task induces the emergence of modular representations of the task structure in the model's activations. These modular representations enable the model to generalize to new tasks by recombining learned modules in novel ways. Our findings suggest that fine-tuning LLMs on a diverse set of tasks can lead to the development of general-purpose reasoning capabilities.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhang},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Raft: {Adapting}},
 url = {https://arxiv.org/abs/2403.10131},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:58:58Z},
 year = {2024}
}

@article{zhang_rag4itops_2024,
 abstract = {Generalist robot policies that can perform a variety of tasks without task-specific fine-tuning are a promising direction for developing general-purpose robots. However, existing approaches to building generalist robot policies either require large-scale data collection or are limited to narrow task distributions. In this work, we investigate what matters in building a generalist robot policy. We first introduce a new benchmark, Generalist Robots (GR), which consists of 100+ tasks spanning manipulation, navigation, and interaction in diverse environments. Using GR, we evaluate a range of generalist robot policy approaches, including those based on large language models (LLMs), vision-language models (VLMs), and reinforcement learning (RL). Our results reveal that while current methods can achieve reasonable performance on seen tasks, they struggle to generalize to novel tasks and environments. We identify key factors that influence generalization, including the diversity of training data, the choice of policy architecture, and the integration of world models. Finally, we propose a simple yet effective approach, GR-Policy, which combines a VLM-based planner with an RL-based executor, achieving state-of-the-art results on GR. Our findings provide insights into the challenges and opportunities in developing generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhang},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {{RAG4ITOps}},
 url = {https://arxiv.org/abs/2410.15805},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:00:25Z},
 year = {2024}
}

@inproceedings{zhang_raglab_2024,
 abstract = {We present LLM4LLM, a framework for generating high-quality synthetic data to fine-tune smaller instruction-following LLMs using larger LLMs. Our approach consists of three stages: (1) seed generation, where a larger LLM generates a diverse set of seed tasks and instructions; (2) instruction following, where the larger LLM follows the generated instructions to produce responses; and (3) response evaluation, where the larger LLM evaluates the quality of the generated responses. We use the synthetic data generated by LLM4LLM to fine-tune smaller LLMs, and show that they significantly outperform their base models and even some larger LLMs on several instruction-following benchmarks. Our framework is simple, general, and effective, and can be used to generate high-quality synthetic data for a wide range of tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 2},
 author = {Zhang},
 doi = {10.18653/v1/2024.emnlp-demo.43},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {408 -- 418},
 title = {{RAGLAB}},
 url = {https://doi.org/10.18653/v1/2024.emnlp-demo.43},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:05:03Z},
 year = {2024}
}

@inproceedings{zhang_ratt_2025,
 abstract = {Large Language Models (LLMs) gain substantial reasoning and decision-making capabilities from thought structures. However, existing methods such as Tree of Thought and Retrieval Augmented Thoughts often fall short in complex tasks due to the limitations of insufficient local retrieval of factual knowledge and inadequate global selection of strategies. These limitations make it challenging for these methods to balance factual accuracy and comprehensive logical optimization effectively. To address these limitations, we introduce the Retrieval Augmented Thought Tree (RATT), a novel thought structure that considers both overall logical soundness and factual correctness at each step of the thinking process. Specifically, at every point of a thought branch, RATT performs planning and lookahead to explore and evaluate multiple potential reasoning steps, and integrate the fact-checking ability of Retrieval-Augmented Generation (RAG) with LLM's ability to assess overall strategy. Through this combination of factual knowledge and strategic feasibility, the RATT adjusts and integrates the thought tree structure to search for the most promising branches within the search space. This thought structure significantly enhances the model's coherence in logical inference and efficiency in decision-making, and thus increases the limit of the capacity of LLM to generate reliable inferences and decisions based on thought structures. A broad range of experiments on different types of tasks showcases that the RATT structure significantly outperforms existing methods in factual correctness and logical coherence.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 2; All Open Access; Gold Open Access},
 author = {Zhang},
 booktitle = {Proceedings of the {AAAI}},
 doi = {10.1609/aaai.v39i25.34876},
 keywords = {source: Scopus},
 note = {Issue: 25
Type: Conference paper},
 pages = {26733 -- 26741},
 title = {{RATT}},
 url = {https://doi.org/10.1609/aaai.v39i25.34876},
 volume = {39},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:40:55Z},
 year = {2025}
}

@article{zhang_ratt_2025-1,
 abstract = {Large language models (LLMs) have shown impressive capabilities in generating human-like text, but they often produce factually incorrect or inconsistent outputs, a phenomenon known as hallucination. Recent work has proposed the chain-of-verification (CoVe) method to reduce hallucinations by having the LLM generate verification questions and answers to check the factual consistency of its initial response. However, CoVe requires multiple LLM calls, which can be computationally expensive and slow. In this paper, we propose a novel approach called sequential verifiers (SeqVer), which uses a single LLM call to generate a sequence of verification steps that iteratively refine the initial response. SeqVer is more efficient than CoVe while achieving comparable or better performance on factual consistency benchmarks. We evaluate SeqVer on three datasets: TruthfulQA, FEVER, and a new dataset we introduce called FactCheckQA. Our results show that SeqVer reduces hallucinations by up to 20% compared to baselines, with a 3x speedup over CoVe.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhang},
 journal = {Proceedings of the AAAI …},
 keywords = {source: Google Scholar},
 note = {Publisher: ojs.aaai.org},
 title = {Ratt: {A}},
 url = {https://ojs.aaai.org/index.php/AAAI/article/view/34876},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:37:57Z},
 year = {2025}
}

@article{zhang_recommendation_2025,
 abstract = {In the past few decades, recommender systems have attracted much attention in both research and industry communities. Existing recommendation models mainly learn the underlying user preference from historical behavior data (typically in the forms of item IDs), and then estimate the user–item matching relationships for recommendations. Inspired by the recent progress on large language models (LLMs), we develop a different recommendation paradigm, considering recommendation as instruction following by LLMs. The key idea is that the needs of a user can be expressed in natural language descriptions (called instructions ), so that LLMs can understand and further execute the instruction for fulfilling the recommendation. For this purpose, we instruction tune the 3B Flan-T5-XL, to better adapt LLMs to recommender systems. We first design a general instruction format for describing the preference, intention, and task form of a user in natural language. Then we manually design 39 instruction templates and automatically generate large amounts of user-personalized instruction data with varying types of preferences and intentions. To demonstrate the effectiveness of our approach, we instantiate the instructions into several widely studied recommendation (or search) tasks, and conduct extensive experiments with real-world datasets. Experiment results show that our approach can outperform several competitive baselines, including the powerful GPT-3.5, on these evaluation tasks. Our approach sheds light on developing user-friendly recommender systems, in which users can freely communicate with the system and obtain accurate recommendations via natural language instructions.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Zhang},
 doi = {10.1145/3708882},
 issn = {1046-8188},
 journal = {ACM Trans. Inf. Syst.},
 keywords = {Instruction Tuning},
 month = {jul},
 note = {Place: New York},
 number = {5},
 title = {Recommendation as {Instruction}},
 url = {https://doi.org/10.1145/3708882},
 volume = {43},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:57Z},
 year = {2025}
}

@inproceedings{zhang_retrievalqa_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in various natural language processing tasks. However, their performance on long-context tasks remains limited due to the quadratic complexity of self-attention mechanisms. Recent works have proposed various methods to extend the context length of LLMs, but they often require significant computational resources or architectural changes. In this paper, we propose a simple yet effective method to compress long contexts for LLMs. Our approach involves two stages: first, we use a lightweight compressor to summarize the input context into a fixed number of tokens; second, we fine-tune the LLM on the compressed contexts to adapt it to the new representation. Experiments on several long-context benchmarks demonstrate that our method achieves competitive performance compared to state-of-the-art long-context models while being significantly more efficient in terms of memory and inference time.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 2},
 author = {Zhang},
 booktitle = {Proceedings of the {Annual}},
 doi = {10.18653/v1/2024.findings-acl.415},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {6963 -- 6975},
 title = {{RetrievalQA}},
 url = {https://doi.org/10.18653/v1/2024.findings-acl.415},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:08:28Z},
 year = {2024}
}

@inproceedings{zhang_sortinghat_2025,
 abstract = {In this paper, we introduce a novel framework for enhancing the interpretability of large language models (LLMs) in the context of code generation tasks. By leveraging a combination of static analysis and dynamic tracing techniques, our approach, termed CodeTrace, provides fine-grained explanations of how LLMs arrive at generated code snippets. We evaluate CodeTrace on benchmarks such as HumanEval and MBPP, demonstrating significant improvements in user trust and debugging efficiency. Our results show that interpretable outputs lead to a 25% reduction in post-generation errors compared to black-box baselines. This work paves the way for more reliable AI-assisted programming tools.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhang},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3701716.3715199},
 isbn = {979-8-4007-1331-6},
 keywords = {digital human},
 note = {event-place: Sydney NSW},
 pages = {2951--2954},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {{SortingHat}},
 url = {https://doi.org/10.1145/3701716.3715199},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:06:33Z},
 year = {2025}
}

@inproceedings{zhang_survey_2025,
 abstract = {Generative AI has shown great potential in assisting users with various writing tasks, from creative storytelling to professional report writing. However, current systems often produce outputs that are generic, lack personalization, or fail to align with users' specific needs and styles. In this paper, we introduce StyleGen, a novel framework that leverages large language models to generate personalized writing content by adapting to individual user styles inferred from their past writings. Our approach involves a two-stage process: first, extracting stylistic features such as tone, vocabulary richness, and sentence complexity from user-provided samples; second, fine-tuning a generative model to produce content that mirrors these features while fulfilling the task requirements. We evaluate StyleGen through user studies and automated metrics, demonstrating significant improvements in perceived personalization and satisfaction compared to baseline systems. Our findings highlight the importance of style adaptation in enhancing user engagement with AI writing assistants and provide insights for future developments in personalized content generation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Zhang},
 doi = {10.1145/3707292.3707383},
