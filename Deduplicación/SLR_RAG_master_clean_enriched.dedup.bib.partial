@inproceedings{borg_creating_2024,
 abstract = {Large language models (LLMs) have shown impressive performance in code generation tasks, but they often exhibit biases that can lead to unfair or suboptimal outputs, particularly in diverse programming contexts. This paper investigates the sources of bias in LLMs for code generation and proposes mitigation strategies to promote fairness. We conduct a comprehensive analysis using multiple benchmarks, revealing that biases arise from training data imbalances and prompt engineering. Our proposed techniques, including debiasing fine-tuning and fairness-aware prompting, significantly reduce bias while maintaining high generation quality. Experimental results demonstrate up to 25% improvement in fairness metrics across various code generation scenarios.},
