 year = {2025}
}

@inproceedings{cordioli_exploring_2025,
 abstract = {Visual programming languages (VPLs) enable users to create programs by manipulating visual elements rather than writing text-based code. Despite their promise, VPLs have not achieved widespread adoption. We hypothesize that one reason is that VPLs do not support the full range of programming tasks that users need to perform. To investigate this, we conducted a study with 20 professional programmers who used a VPL to complete a set of programming tasks. We found that participants frequently needed to perform tasks that were not supported by the VPL, such as debugging and refactoring code. We also found that participants developed a variety of strategies to work around these limitations, such as using external tools or switching to a text-based language. Our findings suggest that VPLs need to provide better support for a wider range of programming tasks in order to achieve broader adoption.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Cordioli},
 booktitle = {Proceedings of the 16th {Biannual}},
 doi = {10.1145/3750069.3750160},
