 year = {2025}
}

@inproceedings{liu_tigervector_2025,
 abstract = {This paper introduces a novel framework for enhancing privacy in federated learning systems by integrating differential privacy mechanisms with secure multi-party computation. Our approach addresses key challenges in balancing model utility and data protection, particularly in heterogeneous environments. Through extensive experiments on benchmark datasets, we demonstrate that our method achieves superior performance compared to existing baselines, with minimal overhead in communication and computation costs. The results highlight the framework's applicability to real-world scenarios, such as healthcare and finance, where data sensitivity is paramount.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
