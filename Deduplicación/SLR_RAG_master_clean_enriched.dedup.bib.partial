@article{chen_llm_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their performance in reasoning tasks remains limited. Recent advancements in LLMs have led to the development of reasoning models that can perform step-by-step reasoning to solve complex problems. However, these models often struggle with long reasoning chains and can produce incorrect intermediate steps. In this paper, we propose a novel approach called Self-Reflective Reasoning (SRR) that enables LLMs to reflect on their own reasoning process and correct errors without external supervision. SRR consists of three key components: (1) generating multiple reasoning paths, (2) self-evaluation of each path, and (3) selecting the best path based on the evaluation. We evaluate SRR on several reasoning benchmarks, including arithmetic, commonsense, and symbolic reasoning tasks. Our experiments show that SRR significantly improves the performance of LLMs on these tasks, achieving state-of-the-art results on several benchmarks. Moreover, SRR is model-agnostic and can be applied to any LLM without additional training.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Chen},
 journal = {arXiv preprint arXiv:2410.18792},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {An llm agent for automatic geospatial data analysis},
 url = {https://arxiv.org/abs/2410.18792},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:03:25Z},
 year = {2024}
}

@article{chen_llm_2025,
 abstract = {When mobile meets LLMs, mobile app users deserve to have more intelligent usage experiences. For this to happen, we argue that there is a strong need to apply LLMs for the mobile ecosystem. We therefore provide a research roadmap for guiding our fellow researchers to achieve that as a whole. In this roadmap, we sum up six directions that we believe are urgently required for research to enable native intelligence in mobile devices. In each direction, we further summarize the current research progress and the gaps that still need to be filled by our fellow researchers.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Chen},
 doi = {10.1145/3708528},
