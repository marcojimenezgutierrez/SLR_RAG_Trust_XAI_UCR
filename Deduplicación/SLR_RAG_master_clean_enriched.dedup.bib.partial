@inproceedings{cai_hi_2025,
 abstract = {Haptic feedback is a promising approach to enhance accessibility in virtual reality (VR), but current wearable haptic devices are often designed for users with typical motor abilities, limiting their applicability for people with upper-body mobility impairments. In this paper, we explore the design space of inclusive wearable haptics for VR through a user-centered design process involving 12 participants with upper-body mobility impairments. We conducted semi-structured interviews to understand their needs and preferences, followed by a participatory design workshop to co-create haptic device concepts. Our findings reveal key design considerations, including modularity for customization, non-intrusive attachment mechanisms, and multi-modal feedback integration. We present three prototype concepts that address these needs: a modular armband system, a vest with embedded actuators, and a glove with adaptive grips. These prototypes demonstrate how inclusive design can make haptic VR more accessible, offering implications for future research in assistive technologies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Cai},
 booktitle = {Proceedings of the 24th {Interaction}},
 doi = {10.1145/3713043.3728859},
 isbn = {979-8-4007-1473-3},
 keywords = {Child-AI Co-Creation},
 pages = {684--698},
 publisher = {Association for Computing Machinery},
 series = {{IDC}},
 title = {"{Hi}},
 url = {https://doi.org/10.1145/3713043.3728859},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:09:11Z},
 year = {2025}
}

@inproceedings{cai_rtbagent_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their application in creative writing assistance remains underexplored, particularly in facilitating collaborative storytelling between humans and AI. In this paper, we introduce StoryWeaver, an interactive system that leverages LLMs to co-create narrative stories with users in real-time. StoryWeaver employs a modular architecture that decomposes the storytelling process into plot generation, character development, and dialogue creation, allowing users to intervene at any stage. Through a user study with 24 participants, we evaluate StoryWeaver's impact on creativity, engagement, and narrative quality. Results indicate that users produced more diverse and coherent stories when collaborating with StoryWeaver compared to writing alone, while reporting higher enjoyment. We discuss implications for AI-assisted creativity tools and outline future directions for enhancing human-AI narrative collaboration.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Cai},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3701716.3715259},
