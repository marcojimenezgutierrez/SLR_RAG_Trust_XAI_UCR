@inproceedings{sun_creative_2025,
 abstract = {Haptic feedback is a promising modality for wearable interfaces, but its design for people with upper-body mobility impairments remains underexplored. We conducted a need-finding study with 12 participants with upper-body mobility impairments to understand their needs and challenges in using wearable haptics. Through semi-structured interviews and participatory design activities, we identified key themes, including the need for customizable and adaptive haptic patterns, integration with existing assistive technologies, and considerations for varying levels of impairment. Participants expressed interest in applications such as navigation, communication, and physical therapy. We also prototyped and evaluated three haptic glove designs to gather insights on form factor, placement, and intensity preferences. Our findings highlight the importance of inclusive design principles, such as user involvement and accessibility, in developing effective wearable haptics for this population. We discuss implications for future research and design guidelines to enhance accessibility and usability.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Sun},
 booktitle = {Proceedings of the 2025 {CHI}},
