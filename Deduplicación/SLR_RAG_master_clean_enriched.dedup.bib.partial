@article{an_vitality_2024,
 abstract = {Recent work has highlighted the phenomenon of "grokking", where a neural network initially memorizes training data and then suddenly generalizes. This behavior is often observed in the context of modular arithmetic tasks. In this paper, we propose an effective theory to understand grokking. We model the learning dynamics using a two-layer network and analyze the phase transitions in the loss landscape. Our theory predicts that grokking occurs due to a symmetry-breaking phase transition in the representations. We validate our theory with experiments on synthetic datasets.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {An},
