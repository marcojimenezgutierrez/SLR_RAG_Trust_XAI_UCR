@inproceedings{huang_disambiguate_2024,
 abstract = {Large language models (LLMs) have recently shown promise in a variety of domains, including software engineering. However, their use in prototyping remains underexplored. We conducted a study with 12 professional designers to understand how they use LLMs in prototyping and the challenges they face. Our findings reveal that designers use LLMs for idea generation, code generation, and evaluation, but encounter issues like hallucination, lack of control, and integration difficulties. We discuss opportunities for improving LLM support in prototyping, including better integration with design tools and more reliable outputs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
