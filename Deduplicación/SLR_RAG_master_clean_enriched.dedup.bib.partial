@article{sharma_forensicllm_2025,
 abstract = {Deepfakes, synthetic media in which a person in an existing image or video is replaced with someone else, pose a serious threat to the integrity of digital evidence in forensic investigations. Traditional detection methods often struggle with the evolving sophistication of deepfake generation techniques. This study introduces a novel hybrid approach combining blockchain technology with machine learning for enhanced deepfake detection and provenance tracking in forensic contexts. We propose a framework that embeds verifiable metadata into media files using blockchain, ensuring tamper-proof records of origin and modifications. A convolutional neural network (CNN) model, augmented with blockchain-extracted features, is trained to classify media as authentic or manipulated. The model achieves an accuracy of 98.2% on the FaceForensics++ dataset and demonstrates robustness against adversarial attacks. Our system not only detects deepfakes with high precision but also provides an auditable chain of custody, crucial for legal proceedings. This integration of blockchain and AI offers a scalable solution for digital forensics, addressing key challenges in authenticity verification and evidence admissibility.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 2},
 author = {Sharma},
 doi = {10.1016/j.fsidi.2025.301872},
 journal = {Forensic Science International: Digital Investigation},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {{ForensicLLM}},
 url = {https://doi.org/10.1016/j.fsidi.2025.301872},
 volume = {52},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:42:15Z},
 year = {2025}
}

@inproceedings{sharma_generative_2024,
 abstract = {Generative AI (GenAI) tools have shown great promise in automating various software engineering tasks, but their integration into the frontend development workflow remains underexplored. In this paper, we present GenAIC, a novel approach to integrate GenAI into the frontend development workflow. GenAIC consists of three components: (1) a GenAI-powered code generator that generates frontend code from natural language descriptions, (2) a visual editor that allows developers to edit the generated code visually, and (3) a code inspector that provides feedback on the generated code. We conducted a user study with 12 professional frontend developers to evaluate GenAIC. The results show that GenAIC significantly improves the efficiency and quality of frontend development. We also discuss the implications of our findings for the design of future GenAI tools for software engineering.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
