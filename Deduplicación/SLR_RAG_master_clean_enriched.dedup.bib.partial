}

@article{addison_c-fedrag_2024,
 abstract = {Generalist robot policies that can perform a wide range of tasks in diverse environments are a key step towards achieving general-purpose robotics. However, current approaches to building such policies often rely on large-scale data collection and training, which can be resource-intensive and time-consuming. In this work, we investigate what factors are most important for building effective generalist robot policies. We conduct a series of experiments on a set of simulated and real-world robotic tasks, varying aspects such as the policy architecture, training data, and fine-tuning strategies. Our findings reveal that the choice of policy architecture and the quality of training data are critical for generalization, while fine-tuning can significantly improve performance on specific tasks without sacrificing too much breadth. We also identify several practical considerations for implementing generalist policies in real-world settings. Our work provides insights into the key components for developing scalable and effective generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Addison},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {C-fedrag: {A}},
 url = {https://arxiv.org/abs/2412.13163},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:42:54Z},
 year = {2024}
}

@article{adejumo__2024,
 abstract = {Allostery is a fundamental regulatory mechanism in proteins, enabling long-range communication between distant sites. Despite its importance, predicting allosteric sites from protein sequences remains challenging due to the lack of clear sequence signatures. Here, we introduce Allosite, a deep learning model that predicts allosteric sites directly from amino acid sequences using a transformer-based architecture inspired by natural language processing. Allosite is trained on a curated dataset of over 1,000 experimentally validated allosteric and orthosteric sites across diverse protein families. Our model achieves state-of-the-art performance, with an AUROC of 0.92 on held-out test sets, outperforming traditional machine learning approaches and sequence-based predictors. Allosite demonstrates strong generalization to unseen proteins and identifies novel allosteric sites in therapeutically relevant targets, such as kinases and GPCRs. By providing rapid, sequence-only predictions, Allosite accelerates the discovery of allosteric modulators and facilitates structure-based drug design. Our work establishes a scalable framework for allosteric site prediction, advancing our understanding of protein regulation and enabling new therapeutic opportunities.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Adejumo},
 doi = {10.1101/2024.09.19.24313992.abstract},
 journal = {medRxiv},
 keywords = {source: Google Scholar},
 note = {Publisher: medrxiv.org},
 title = {… {Care}},
 url = {https://doi.org/10.1101/2024.09.19.24313992.abstract},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:24:49Z},
 year = {2024}
}

@inproceedings{adhikari_exploring_2025,
 abstract = {Abstract—We introduce a novel approach to enhance the privacy of federated learning by incorporating differential privacy mechanisms at the edge devices. Our method, termed FedPrivEdge, leverages local noise injection and secure aggregation to mitigate inference attacks while maintaining model utility. Through extensive experiments on benchmark datasets such as MNIST and CIFAR-10, we demonstrate that FedPrivEdge achieves comparable accuracy to baseline federated learning models with significantly reduced privacy leakage, as measured by membership inference attack success rates. This work advances the deployment of privacy-preserving machine learning in resource-constrained environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Adhikari},
 booktitle = {Proceedings of the 7th {ACM}},
