 year = {2024}
}

@article{nguyen_my_2024,
 abstract = {This study investigates the effects of climate change on agricultural productivity in sub-Saharan Africa using panel data from 2000 to 2020. Employing a fixed-effects regression model, we analyze how temperature and precipitation variations impact crop yields for major staples like maize and sorghum. Results indicate a significant negative correlation between rising temperatures and yields, with precipitation deficits exacerbating losses. Adaptation strategies, such as drought-resistant varieties, are recommended to mitigate future risks. The findings underscore the urgency for policy interventions to enhance resilience in vulnerable farming communities.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 5},
 author = {Nguyen},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
