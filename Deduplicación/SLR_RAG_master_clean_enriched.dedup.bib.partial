 x_enrich_ts = {2025-11-02T06:22:41Z},
 year = {2025}
}

@inproceedings{deldjoo_toward_2025,
 abstract = {Generative AI (GenAI) has shown great potential in assisting users with diverse tasks. However, the opaque nature of GenAI models makes it challenging for users to understand and control the generated outputs. In this paper, we investigate how users interact with and control GenAI outputs through a user study with 24 participants using a text-to-image GenAI system. We identify three strategies that users employ to control GenAI outputs: (1) constraining the input prompt, (2) post-editing the generated output, and (3) iterative refinement. We also uncover users' challenges in understanding and controlling GenAI outputs, including difficulty in interpreting the model's behavior, lack of transparency in the generation process, and limited control over the output. Based on our findings, we propose design implications for GenAI systems to better support user control and understanding.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Deldjoo},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730354},
