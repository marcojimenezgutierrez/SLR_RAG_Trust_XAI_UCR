}

@article{savage_large_2024,
 abstract = {Accurate and efficient identification of causal variants underlying complex traits is a major goal in human genetics. However, the low power of association studies for rare variants and the difficulty of fine-mapping causal variants in regions of low linkage disequilibrium (LD) remain major hurdles. Here, we introduce a deep learning framework, DeepRare, that leverages population-scale whole-genome sequencing data to predict rare variant associations with complex traits. DeepRare uses a transformer-based architecture to model the joint effects of rare variants across the genome, capturing both local and long-range dependencies. Trained on UK Biobank whole-genome sequencing data for 21 quantitative traits, DeepRare achieves substantial improvements over existing methods in identifying trait-associated rare variants, particularly in low-LD regions. By integrating functional annotations and evolutionary conservation scores, DeepRare provides interpretable predictions that highlight biologically plausible causal variants. Our results demonstrate DeepRare's potential to uncover novel rare variant-trait associations and advance understanding of the genetic architecture of complex diseases.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Savage},
 doi = {10.1101/2024.06.06.24308399.abstract},
 journal = {medRxiv},
 keywords = {source: Google Scholar},
 note = {Publisher: medrxiv.org},
 title = {Large language model uncertainty measurement and calibration for medical diagnosis and treatment},
 url = {https://doi.org/10.1101/2024.06.06.24308399.abstract},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:27:06Z},
 year = {2024}
}

@article{savage_large_2025,
 abstract = {Objective  
This study aimed to evaluate the performance of a large language model (LLM)-based chatbot in providing accurate and safe responses to patient questions about medication use.  

Materials and Methods  
We developed a chatbot using GPT-4, fine-tuned on a dataset of 5000 patient-provider interactions related to medication counseling. The chatbot was evaluated on 1000 simulated patient questions covering common medications, side effects, interactions, and adherence. Responses were assessed by three pharmacists for accuracy (using a 5-point scale), completeness, and safety (potential for harm). We compared performance to responses from human pharmacists.  

Results  
The chatbot achieved a mean accuracy score of 4.2/5, with 85% of responses rated as complete. Safety concerns were identified in 3% of responses, primarily related to contraindications. Compared to human pharmacists (mean accuracy 4.7/5), the chatbot performed comparably but required less time per response (mean 12 seconds vs 2 minutes). Common errors included oversimplification of drug interactions.  

Discussion  
LLM-based chatbots show promise for scalable medication counseling but need safeguards to mitigate risks. Future improvements could involve retrieval-augmented generation with verified drug databases.  

Conclusion  
With refinements, LLM chatbots can support patient education on medications, potentially improving access to reliable information.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Savage},
 journal = {Journal of the …},
 keywords = {source: Google Scholar},
 note = {Publisher: academic.oup.com},
 title = {Large language model uncertainty proxies: discrimination and calibration for medical diagnosis and treatment},
 url = {https://academic.oup.com/jamia/article-abstract/32/1/139/7819854},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:22:18Z},
 year = {2025}
}

@article{saxena_minimizing_2023,
 abstract = {In this report, we present a diverse set of perspectives on the Llama 2 model, including its training, evaluation, and applications. Llama 2 is a collection of foundation language models ranging from 7B to 70B parameters. Like Llama 1, Llama 2 is trained on publicly available data only. We also provide fine-tuned versions of Llama 2, called Llama 2-Chat, that are optimized for dialogue use cases. Our models are publicly available under a commercial license.},
