@article{toprani_llm_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly impacted various sectors, including healthcare. This paper explores the integration of AI in medical diagnosis, focusing on deep learning models for image analysis. We propose a novel convolutional neural network (CNN) architecture tailored for detecting anomalies in X-ray images, achieving an accuracy of 95% on benchmark datasets. The model incorporates attention mechanisms to enhance feature extraction, addressing challenges such as data imbalance and computational efficiency. Experimental results demonstrate superior performance compared to existing methods, with implications for real-time diagnostic tools in clinical settings. Future work will extend the framework to multi-modal data fusion.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
