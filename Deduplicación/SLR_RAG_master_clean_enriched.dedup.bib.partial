@inproceedings{chukwu_may_2025,
 abstract = {Visual Question Answering (VQA) systems have achieved remarkable performance in recent years, but they often exhibit biases towards certain answer categories, leading to unfair outcomes for underrepresented groups. In this paper, we investigate the fairness of VQA models across different demographic groups, focusing on gender and racial biases in the images. We propose a novel evaluation framework that disentangles the biases arising from the visual content (image bias) and the textual content (question bias). Our framework includes a bias mitigation strategy that fine-tunes the model using a balanced dataset constructed via counterfactual image generation. Experimental results on the VQA-CP dataset demonstrate that our approach significantly reduces bias while maintaining high accuracy, achieving up to 15% improvement in fairness metrics without substantial performance degradation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Chukwu},
 booktitle = {Proceedings of the 5th {Workshop}},
 doi = {10.1145/3721146.3721951},
 isbn = {979-8-4007-1538-9},
