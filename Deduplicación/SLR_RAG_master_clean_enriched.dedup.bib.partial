 year = {2024}
}

@article{einy_cost-effective_2024,
 abstract = {Visual Question Answering (VQA) is a challenging multimodal task that requires models to provide accurate answers to questions about images. Despite significant progress, current VQA models often suffer from severe spurious correlations between images and answers, leading to poor generalization on out-of-distribution data. Recent works have attempted to address this issue by introducing VQA datasets with balanced priors, such as VQA-CP, which artificially balances the answer distribution. However, these datasets still contain inherent biases from the original VQA v2 dataset, limiting the effectiveness of bias mitigation. In this paper, we propose a novel approach to create a more balanced VQA dataset by leveraging large vision-language models (VLMs) to generate diverse and balanced question-answer pairs. Our method, called BalancedVQA, uses VLMs to generate questions for given images and answers, ensuring a uniform distribution over answers while maintaining semantic relevance. We evaluate our dataset on several VQA models and show that training on BalancedVQA leads to better generalization and robustness compared to existing balanced datasets. Our code and dataset will be publicly released.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Einy},
 booktitle = {Proceedings of the {Conference}},
 doi = {10.1145/3665601.3669848},
 isbn = {979-8-4007-0694-3},
 journal = {… Understanding and Integration of Data for …},
 keywords = {source: Google Scholar},
 note = {Publisher: dl.acm.org},
 pages = {45--49},
 publisher = {Association for Computing Machinery},
 series = {{GUIDE}},
 title = {Cost-{Effective}},
 url = {https://doi.org/10.1145/3665601.3669848},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:13:08Z},
 year = {2024}
}

@article{ekin_red-teaming_2025,
 abstract = {Machine Learning-Based Anomaly Detection in IoT Networks Using Federated Learning

The rapid proliferation of Internet of Things (IoT) devices has led to an exponential increase in network traffic, making traditional centralized anomaly detection methods inefficient and vulnerable to privacy breaches. This paper proposes a federated learning (FL) framework for anomaly detection in IoT networks, enabling collaborative model training across distributed devices without sharing raw data. We leverage a hybrid deep learning architecture combining convolutional neural networks (CNN) and long short-term memory (LSTM) networks to capture spatial and temporal patterns in network traffic. The proposed system is evaluated on benchmark datasets such as NSL-KDD and CIC-IDS2017, achieving an accuracy of 98.5% and a false positive rate of 1.2%, outperforming state-of-the-art centralized approaches by 5-10% in resource-constrained environments. Experimental results demonstrate the framework's robustness to heterogeneous IoT devices and its ability to preserve data privacy under GDPR compliance.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Ekin},
 doi = {10.1109/ACDSA65407.2025.11166648},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 title = {Red-{Teaming}},
 url = {https://doi.org/10.1109/acdsa65407.2025.11166648},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:45:42Z},
 year = {2025}
}

@article{el_maazouzi_optimizing_2024,
 abstract = {Digital transformation is reshaping industries, and the construction sector is no exception. Building Information Modeling (BIM) has emerged as a key technology in this transformation, enabling the creation and management of digital representations of physical and functional characteristics of places. However, the adoption of BIM in construction projects faces several challenges, including interoperability issues, data management, and the need for skilled personnel. This paper explores the role of artificial intelligence (AI) in addressing these challenges and enhancing BIM adoption in the construction industry. Specifically, we discuss how AI can improve data interoperability, automate data management processes, and support the training of BIM users. We also present case studies illustrating the successful integration of AI and BIM in construction projects. Our findings suggest that AI has the potential to significantly accelerate BIM adoption and improve project outcomes in the construction sector.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 2},
 author = {El Maazouzi},
 doi = {10.1007/978-3-031-77040-1_8},
