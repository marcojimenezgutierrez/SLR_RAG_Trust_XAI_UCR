 x_enrich_ts = {2025-11-02T06:22:45Z},
 year = {2024}
}

@article{yu_empowering_2025,
 abstract = {Multimodal emotion recognition (MER) has gained significant attention in recent years due to its potential applications in human-computer interaction, healthcare, and education. Unlike unimodal emotion recognition, MER leverages complementary information from multiple modalities, such as audio, visual, and physiological signals, to achieve more robust and accurate emotion detection. Deep learning techniques have revolutionized MER by enabling effective feature extraction and fusion across modalities. This survey provides a comprehensive overview of deep learning-based MER, categorizing existing methods based on fusion strategies (early, late, and hybrid fusion), network architectures (e.g., CNNs, RNNs, Transformers), and datasets (e.g., IEMOCAP, DEAP, SEED). We discuss key challenges, including modality alignment, data scarcity, and cross-cultural variations, and highlight future directions such as self-supervised learning, federated learning, and real-time processing for practical deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Hybrid Gold Open Access},
