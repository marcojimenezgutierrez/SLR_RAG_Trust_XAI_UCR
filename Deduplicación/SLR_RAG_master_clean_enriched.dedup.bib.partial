@article{ding_retrieve_2024,
 abstract = {We study how vision-language models (VLM) can be used to transfer web knowledge to robotic control. We propose RT-2, a novel vision-language-action (VLA) model that learns to map both text and images directly to actions by fine-tuning a pretrained VLM on both vision-language tasks and end-to-end robotic manipulation trajectories. We demonstrate that RT-2 exhibits improved generalization capabilities, outperforming a separate vision-language model and a vision-only model in novel tasks, new objects, and new environments. Furthermore, RT-2 shows improved performance on tasks requiring reasoning, such as identifying and manipulating objects based on their properties. Notably, RT-2 can leverage web knowledge to solve tasks that require commonsense reasoning, such as picking up a specific type of fruit or sorting objects by color. Our results suggest that VLMs hold significant potential for enabling more general and capable robotic agents.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
