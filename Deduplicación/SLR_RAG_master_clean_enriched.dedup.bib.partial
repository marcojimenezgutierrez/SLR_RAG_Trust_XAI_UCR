@inproceedings{zhang_way_2025,
 abstract = {This paper introduces a novel framework for enhancing the reasoning capabilities of large language models (LLMs) through collaborative agent interactions. We propose Chain-of-Agents (CoA), a method where multiple LLM-based agents work sequentially on complex, long-context tasks, each building upon the previous agent's output to refine reasoning and reduce hallucinations. By leveraging agent specialization and iterative feedback, CoA achieves superior performance on benchmarks like HotpotQA and DROP, outperforming single-agent baselines by up to 15% in accuracy. Our approach is model-agnostic and scalable, demonstrating potential for real-world applications in multi-step problem-solving.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhang},
 booktitle = {Proceedings of the 31st {ACM}},
