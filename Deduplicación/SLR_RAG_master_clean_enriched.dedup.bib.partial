@inproceedings{yamakawa_direct_2024,
 abstract = {Data visualizations are powerful tools for communicating complex information, but they often exclude people who are blind or low vision (pBLV). While sonification and other audio-based techniques have been explored, they are not widely adopted. In this paper, we investigate the potential of AI-generated audio descriptions to make data visualizations accessible to pBLV. We conducted a study with 12 pBLV participants to understand their needs and preferences for audio descriptions of data visualizations. Based on our findings, we developed a prototype system that generates audio descriptions using large language models (LLMs). Our evaluation with 10 pBLV participants shows that LLM-generated descriptions are effective in conveying the key insights of data visualizations, and participants preferred them over traditional sonification techniques. Our work provides insights into the design of accessible data visualizations and demonstrates the potential of LLMs to make data visualizations inclusive.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Yamakawa},
 booktitle = {Proceedings of the 2024 9th {International}},
 doi = {10.1145/3654522.3654555},
 isbn = {979-8-4007-1671-3},
 keywords = {artificial neural networks},
 note = {event-place: Ho Chi Minh City},
 pages = {340--345},
