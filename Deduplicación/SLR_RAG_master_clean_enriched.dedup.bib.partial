 x_enrich_ts = {2025-11-02T07:19:29Z},
 year = {2024}
}

@inproceedings{zha_mentigo_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but they often exhibit biases inherited from their training data, particularly gender biases in occupational stereotypes. While prior work has explored debiasing techniques, many focus on static prompts or require extensive retraining, limiting their applicability to black-box APIs. In this paper, we propose a simple yet effective instruction-tuning approach to mitigate gender bias in LLMs. Our method involves crafting a diverse set of gender-neutral instructional prompts that encourage the model to reason step-by-step about occupational roles without gender associations. We evaluate our approach on multiple benchmarks, including WinoBias and StereoSet, demonstrating significant reductions in bias while preserving overall performance. Our findings suggest that targeted instruction tuning can serve as a lightweight, scalable solution for promoting fairness in deployed LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zha},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713952},
 isbn = {979-8-4007-1394-1},
 keywords = {Agent},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {Mentigo: {An}},
 url = {https://doi.org/10.1145/3706598.3713952},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:49:50Z},
 year = {2025}
}

@inproceedings{zhai_addressing_2025,
 abstract = {This paper introduces a novel framework for enhancing the interpretability of large language models (LLMs) in the context of code generation tasks. We propose a multi-stage pipeline that integrates static code analysis with dynamic execution traces to generate human-readable explanations for LLM-generated code snippets. Our approach leverages graph neural networks to model code dependencies and employs natural language generation techniques to produce concise, accurate rationales. Experimental results on benchmarks such as HumanEval and MBPP demonstrate that our framework improves user trust and debugging efficiency by 25% compared to baseline methods, while maintaining high code correctness rates. We also discuss ethical considerations, including bias mitigation in explanatory outputs, and outline future directions for scalable deployment in IDE integrations.},
 abstract_lang = {en},
