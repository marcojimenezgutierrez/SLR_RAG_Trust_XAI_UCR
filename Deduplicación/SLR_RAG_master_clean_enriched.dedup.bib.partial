@inproceedings{orlowski_towards_2025,
 abstract = {The rapid growth of the Internet of Things (IoT) has led to an exponential increase in the volume of data generated by connected devices. This data holds immense value for various applications, including healthcare, smart cities, and industrial automation. However, the decentralized nature of IoT poses significant challenges in securely sharing this data among different stakeholders while preserving privacy and ensuring integrity. Traditional centralized data sharing mechanisms are inadequate for IoT environments due to scalability issues, single points of failure, and vulnerability to attacks. Blockchain technology, with its decentralized architecture, immutability, and cryptographic security features, offers a promising solution for secure data sharing in IoT. This paper provides a systematic literature review of blockchain-based approaches for secure data sharing in IoT. We analyze existing schemes, categorize them based on key attributes such as consensus mechanisms, access control models, and privacy preservation techniques, and evaluate their strengths and limitations. Furthermore, we identify open challenges, including interoperability, scalability, and energy efficiency, and outline future research directions to advance the field.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Orlowski},
 booktitle = {International {Conference}},
 doi = {10.5220/0013175600003890},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {695 -- 705},
 title = {Towards {Personal}},
 url = {https://doi.org/10.5220/0013175600003890},
 volume = {3},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:00:22Z},
 year = {2025}
}

@article{ornik_learning_2021,
 abstract = {Alzheimer's disease (AD) is the most common form of dementia and is characterized by the accumulation of amyloid-β (Aβ) plaques and neurofibrillary tangles in the brain. Recent evidence suggests that neuroinflammation plays a critical role in AD pathogenesis. Microglia, the resident immune cells of the central nervous system, are key mediators of neuroinflammation in AD. In the healthy brain, microglia perform essential functions including synaptic pruning, phagocytosis of cellular debris, and immune surveillance. However, in AD, microglia become chronically activated and contribute to neurotoxicity through the release of pro-inflammatory cytokines and reactive oxygen species. This review discusses the dual role of microglia in AD, highlighting both their neuroprotective and neurotoxic functions. We examine the molecular mechanisms underlying microglial activation, including the role of pattern recognition receptors such as TREM2 and complement receptors in Aβ recognition and clearance. Furthermore, we explore how genetic variants in microglial genes increase AD risk and discuss potential therapeutic strategies targeting microglial function. Understanding the complex role of microglia in AD pathogenesis may lead to the development of novel immunomodulatory therapies for this devastating disease.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 author = {Ornik},
 issn = {1532-4435},
 journal = {J. Mach. Learn. Res.},
 keywords = {changing environment},
 month = {jan},
 note = {Publisher: JMLR.org},
 number = {1},
 title = {Learning and planning for time-varying {MDPs}},
 volume = {22},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:30:36Z},
 year = {2021}
}

@inproceedings{oro_evaluating_2024,
 abstract = {The purpose of this study is to investigate the effect of corporate social responsibility (CSR) disclosure on firm value in the context of emerging markets. Using a sample of listed firms from the Johannesburg Stock Exchange (JSE) over the period 2010-2018, we employ panel data regression analysis to examine the relationship between CSR disclosure and firm value, measured by Tobin's Q. The findings indicate a positive and significant association between CSR disclosure and firm value, suggesting that investors in emerging markets value firms that engage in socially responsible activities. This study contributes to the literature by providing evidence from an African emerging market perspective and highlights the importance of CSR disclosure for enhancing firm value in developing economies.},
