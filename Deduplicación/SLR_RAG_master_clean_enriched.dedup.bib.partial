@inproceedings{arabzadeh_human-ai_2025,
 abstract = {Generative AI has shown remarkable capabilities in creating human-like text, but its outputs often reflect biases and stereotypes present in training data. This paper investigates how generative AI perpetuates historical narratives, particularly those involving marginalized groups, by analyzing outputs from large language models prompted with historical scenarios. Through a mixed-methods approach, including qualitative content analysis and quantitative bias metrics, we examine AI-generated stories about events like the Civil Rights Movement and Indigenous histories. Our findings reveal that AI frequently reinforces dominant, Eurocentric perspectives while marginalizing or omitting voices from underrepresented communities. We discuss implications for AI ethics, education, and design, proposing mitigation strategies such as diverse training data and prompt engineering to foster more inclusive historical representations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Arabzadeh},
 booktitle = {Proceedings of the 48th {International}},
