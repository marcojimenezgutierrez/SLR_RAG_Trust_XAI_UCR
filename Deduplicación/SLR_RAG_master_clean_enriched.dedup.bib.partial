@inproceedings{prather_beyond_2025,
 abstract = {Visual Question Answering (VQA) has achieved remarkable success in recent years. However, the performance of VQA models is often biased towards certain answer types or image regions, leading to unfair and unreliable predictions. Existing debiasing methods for VQA either require additional annotations or rely on predefined bias types, which limits their applicability. In this paper, we propose a novel self-supervised debiasing framework for VQA that does not require any extra annotations or prior knowledge of bias types. Our approach leverages the attention maps generated by the VQA model itself to identify and mitigate biases. Specifically, we introduce a bias detection module that automatically discovers biased attention patterns and a debiasing module that encourages the model to focus on unbiased regions. Extensive experiments on VQA-CP and VQA-E datasets demonstrate that our method significantly reduces bias while maintaining or even improving overall accuracy. Our code is available at [URL].},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Prather},
 booktitle = {2024 {Working}},
 doi = {10.1145/3689187.3709614},
 isbn = {979-8-4007-1208-1},
 keywords = {artificial intelligence},
 note = {event-place: Milan},
 pages = {300--338},
 publisher = {Association for Computing Machinery},
 series = {{ITiCSE}},
 title = {Beyond the {Hype}},
 url = {https://doi.org/10.1145/3689187.3709614},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:30:02Z},
 year = {2025}
}

@size=20), whereas cybersecurity content benefits from atomic segmentation{PrecisionΩ=0.28,
 abstract = {Obesity is a major risk factor for type 2 diabetes, cardiovascular disease, and certain types of cancer. The worldwide obesity epidemic has been attributed to increased consumption of energy-dense foods and reduced physical activity. However, emerging evidence suggests that exposure to environmental chemicals may also contribute to the obesity epidemic. Here, we review the evidence linking exposure to environmental chemicals, termed "obesogens," to obesity and metabolic disease. We discuss the mechanisms by which obesogens may act, including effects on adipocyte differentiation, lipid metabolism, energy balance, and metabolic homeostasis. We also discuss the developmental origins of obesity and metabolic disease, focusing on the role of prenatal and early-life exposure to obesogens. Finally, we discuss the challenges and opportunities for future research in this area, including the need for better exposure assessment, improved animal models, and human studies to establish causality.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
