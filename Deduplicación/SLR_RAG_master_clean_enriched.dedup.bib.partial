@inproceedings{jia_structrag_2025,
 abstract = {Visual Question Answering (VQA) has seen significant progress, yet models often rely on superficial cues rather than genuine reasoning, leading to unreliable performance in real-world scenarios. To address this, we introduce a novel benchmark, VQA-Reason, designed to evaluate models' reasoning capabilities in VQA. VQA-Reason consists of 10,000 diverse questions spanning multiple domains, requiring multi-step reasoning over visual and textual information. Unlike existing benchmarks, it emphasizes logical inference, causal understanding, and commonsense knowledge integration. We evaluate state-of-the-art VQA models on VQA-Reason and reveal substantial gaps in their reasoning abilities, with even top-performing models achieving only 35% accuracy. To facilitate improvement, we propose a training framework that incorporates reasoning traces and reinforcement learning. Our experiments demonstrate that this approach boosts reasoning performance by up to 15%, paving the way for more robust VQA systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Jia},
