 x_enrich_ts = {2025-11-02T07:08:21Z},
 year = {2025}
}

@inproceedings{zinjad_resumeflow_2024,
 abstract = {Augmented reality (AR) has the potential to transform how we interact with data in physical spaces, but current tools often require users to switch between devices or interfaces, disrupting workflow. We explore visual programming languages (VPLs) as a means to enable seamless, in-situ data processing in AR. Through a design space analysis, we identify key dimensions including visual representations (e.g., nodes, blocks), interaction modalities (e.g., gestures, voice), and integration with AR environments (e.g., spatial anchoring, real-time visualization). Based on this, we prototype three VPL concepts for AR data processing tasks, such as filtering datasets overlaid on physical objects. User studies with 12 participants reveal preferences for gesture-based interactions and spatial layouts that mimic physical workflows. Our findings offer design implications for AR VPLs, emphasizing intuitiveness and context-awareness to support non-experts in data manipulation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
