@article{sacoransky_chatgpt_2024,
 abstract = {Digital transformation (DT) has become a key driver for firms to enhance their supply chain performance (SCP). However, the underlying mechanisms through which DT influences SCP remain underexplored. Drawing on the dynamic capabilities view and resilience theory, this study proposes a research model to examine the impact of DT on SCP and the mediating role of supply chain resilience (SCR). Using survey data from 312 supply chain managers in China, we find that DT positively affects SCP and SCR, and SCR fully mediates the relationship between DT and SCP. The results also reveal that the relationship between DT and SCR is stronger when firms have higher levels of supply chain collaboration (SCC). This study contributes to the literature by clarifying the DT–SCP relationship and providing practical implications for managers to leverage DT for superior SCP.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
