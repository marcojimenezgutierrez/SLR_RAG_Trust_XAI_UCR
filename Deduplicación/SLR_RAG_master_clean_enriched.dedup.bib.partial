 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:29:02Z},
 year = {2025}
}

@inproceedings{kim_conversational_2025,
 abstract = {This paper introduces PromptFlow, a novel framework for creating interactive, dynamic visualizations of large language model (LLM) outputs. PromptFlow enables users to explore and manipulate prompts in real-time, visualizing how changes in prompt structure affect model responses. By integrating natural language processing techniques with interactive graphics, we address key challenges in prompt engineering, such as debugging ambiguous instructions and evaluating response consistency. Our evaluation with 20 participants demonstrates that PromptFlow significantly improves prompt refinement efficiency, reducing iteration time by 40% compared to traditional text-based methods. We discuss implications for LLM usability in domains like education and content generation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
