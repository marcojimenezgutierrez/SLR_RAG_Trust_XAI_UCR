 year = {2025}
}

@inproceedings{wu_research_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating code from natural language descriptions. However, existing approaches often struggle with complex programming tasks that require multi-step reasoning and handling of intricate dependencies. In this paper, we introduce CodeChain, a novel framework that leverages chain-of-thought prompting augmented with structured code scaffolding to enhance LLM performance in code generation. By breaking down the problem into intermediate reasoning steps and providing partial code templates, CodeChain guides the LLM towards more accurate and complete solutions. We evaluate our approach on benchmarks such as HumanEval and MBPP, demonstrating significant improvements in pass@1 accuracy and code quality metrics compared to baseline methods. Our results highlight the potential of hybrid prompting strategies for advancing LLM-based software development tools.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
