 series = {{SIGIR}},
 title = {{CoSearchAgent}},
 url = {https://doi.org/10.1145/3626772.3657672},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:15:10Z},
 year = {2024}
}

