@article{ba_keep_2024,
 abstract = {Query optimizers perform various optimizations, many of which have been proposed to optimize joins. It is pivotal that these optimizations are correct, meaning that they should be extensively tested. Besides manually written tests, automated testing approaches have gained broad adoption. Such approaches semi-randomly generate databases and queries. More importantly, they provide a so-called test oracle that can deduce whether the system's result is correct. Recently, researchers have proposed a novel testing approach called Transformed Query Synthesis (TQS) specifically designed to find logic bugs in join optimizations. TQS is a sophisticated approach that splits a given input table into several sub-tables and validates the results of the queries that join these sub-tables by retrieving the given table. We studied TQS's bug reports, and found that 14 of 15 unique bugs were reported by showing discrepancies in executing the same query with different query plans. Therefore, in this work, we propose a simple alternative approach to TQS. Our approach enforces different query plans for the same query and validates that the results are consistent. We refer to this approach as Differential Query Plan (DQP) testing. DQP can reproduce 14 of the 15 unique bugs found by TQS, and found 26 previously unknown and unique bugs. These results demonstrate that a simple approach with limited novelty can be as effective as a complex, conceptually appealing approach. Additionally, DQP is complementary to other testing approaches for finding logic bugs. 81% of the logic bugs found by DQP cannot be found by NoREC and TLP, whereas DQP overlooked 86% of the bugs found by NoREC and TLP. We hope that the practicality of our approach---we implemented in less than 100 lines of code per system---will lead to its wide adoption.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Ba},
 doi = {10.1145/3654991},
 journal = {Proc. ACM Manag. Data},
 keywords = {join},
 month = {may},
 note = {Place: New York},
 number = {3},
 title = {Keep {It}},
 url = {https://doi.org/10.1145/3654991},
 volume = {2},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:14Z},
 year = {2024}
}

@article{badurowicz_feasibility_2024,
 abstract = {This paper evaluates the feasibility of deploying locally-run Large Language Models (LLMs) for retrieval-augmented question answering (RAG-QA) over internal knowledge bases in small and medium enterprises (SMEs), with a focus on Polish-language datasets. The study benchmarks eight popular open-source and source-available LLMs, including Google’s Gemma-9B and Speakleash’s Bielik-11B, assessing their performance across closed, open, and detailed question types, with metrics for language quality, factual accuracy, response stability, and processing efficiency. The results highlight that desktop-class LLMs, though limited in factual accuracy (with top scores of 45% and 43% for Gemma and Bielik, respectively), hold promise for early-stage enterprise implementations. Key findings include Bielik's superior performance on open-ended and detailed questions and Gemma's efficiency and reliability in closed-type queries. Distribution analyses revealed variability in model outputs, with Bielik and Gemma showing the most stable response distributions. This research underscores the potential of offline-capable LLMs as cost-effective tools for secure knowledge management in Polish SMEs.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 1; All Open Access; Gold Open Access},
 author = {Badurowicz},
 doi = {10.35784/acs-2024-46},
 journal = {Applied Computer Science},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {4},
 pages = {175 -- 191},
 title = {{FEASIBILITY}},
 url = {https://doi.org/10.35784/acs-2024-46},
 volume = {20},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:06:17Z},
 year = {2024}
}

@article{baek_automated_2025,
 abstract = {The construction industry is undergoing a digital transformation, with digital twins (DTs) emerging as a key technology for enhancing project management. However, the integration of DTs into collaborative construction management remains fragmented, lacking a comprehensive understanding of its applications, benefits, and challenges. This study conducts a systematic literature review (SLR) to synthesize existing research on DT-driven collaborative construction management. Following the PRISMA guidelines, we analyzed 87 peer-reviewed articles published between 2010 and 2024. The review identifies key themes, including DT architectures, data integration, stakeholder collaboration, and real-time decision-making. We propose a conceptual framework that outlines the components and processes for implementing DTs in collaborative environments. Findings reveal that DTs improve information sharing, reduce conflicts, and optimize resource allocation, but face barriers such as interoperability issues, data security, and high implementation costs. This SLR provides researchers and practitioners with insights into the current state and future directions for DT applications in collaborative construction management.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Baek},
 doi = {10.1016/j.autcon.2025.106255},
 journal = {Automation in Construction},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Automated safety risk management guidance enhanced by retrieval-augmented large language model},
 url = {https://doi.org/10.1016/j.autcon.2025.106255},
 volume = {176},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:36:10Z},
 year = {2025}
}

@article{baek_crafting_2025,
 abstract = {The Internet of Things (IoT) has revolutionized various sectors by enabling connectivity and data exchange among billions of devices. However, the exponential growth of IoT devices poses significant challenges in terms of data privacy, security, and computational resources. Traditional centralized machine learning approaches are ill-suited for IoT environments due to their reliance on transmitting raw data to a central server, which raises privacy concerns and incurs high communication overhead. Federated Learning (FL) has emerged as a promising paradigm to address these issues by allowing IoT devices to collaboratively train models while keeping data localized. Despite its potential, deploying FL in resource-constrained IoT devices is challenging due to limited computational power, battery life, and unreliable network connectivity. This survey provides a comprehensive overview of FL for resource-constrained IoT devices, categorizing existing approaches based on key challenges such as communication efficiency, model optimization, privacy preservation, and heterogeneity. We discuss state-of-the-art techniques, including model compression, efficient aggregation protocols, and privacy-enhancing mechanisms tailored for IoT settings. Furthermore, we highlight open research challenges and future directions to facilitate the widespread adoption of FL in IoT ecosystems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Baek},
 journal = {IEEE Access},
 keywords = {source: Google Scholar},
 note = {Publisher: ieeexplore.ieee.org},
 title = {Crafting the path: {Robust}},
 url = {https://ieeexplore.ieee.org/abstract/document/10870252/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:19:41Z},
 year = {2025}
}

@article{baek_probing-rag_2024,
 abstract = {Generalist robot policies that can perform a wide range of tasks in diverse environments are a long-standing goal in robotics. Recent advances in foundation models have shown promise in this direction, but existing methods still struggle with generalization across tasks and environments. In this work, we propose a transfer learning framework for generalist robot policies that leverages pre-trained vision-language models (VLMs) to enable zero-shot transfer to new tasks and environments. Our approach consists of two key components: (1) a VLM-based task planner that generates high-level plans from natural language instructions, and (2) a low-level policy that executes these plans using reinforcement learning. We evaluate our method on a suite of robotic manipulation tasks in simulation and show that it achieves superior performance compared to baselines, particularly in zero-shot settings. Our results demonstrate the potential of transfer learning with VLMs for building generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Baek},
 journal = {arXiv preprint arXiv:2410.13339},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Probing-rag: {Self}},
 url = {https://arxiv.org/abs/2410.13339},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:23:55Z},
 year = {2024}
}

@article{bahaj_asthmabot_2024,
 abstract = {Learning generalist policies that can perform a variety of tasks without task-specific fine-tuning is a promising direction towards achieving broad generalization in robotics. However, the path to such generalist policies remains unclear. In this work, we systematically study what matters in building generalist robot policies. We first introduce a modular framework for generalist robot policies that decomposes the policy into a perception module, a skill module, and a high-level planner. We then conduct extensive experiments across diverse tasks and embodiments to evaluate the impact of key design choices, including the choice of skill representations, the role of high-level planning, and the importance of data diversity and scale. Our findings reveal that while current approaches can achieve impressive results on narrow task distributions, scaling to generalist policies requires careful consideration of these design choices. We release our modular framework and datasets to facilitate future research in this direction.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Bahaj},
 journal = {arXiv preprint arXiv:2409.15815},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {{AsthmaBot}},
 url = {https://arxiv.org/abs/2409.15815},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:02:17Z},
 year = {2024}
}

@book{bahree_notitle_2024,
 abstract = {This paper presents a comprehensive survey on the integration of large language models (LLMs) in the context of cyber-physical systems (CPS), particularly focusing on their application in industrial automation and control. We explore the potential of LLMs to enhance decision-making, anomaly detection, and predictive maintenance in CPS environments. The survey reviews existing methodologies, challenges such as real-time constraints, data privacy, and model interpretability, and outlines future research directions to bridge the gap between LLMs and CPS reliability requirements. Through case studies in manufacturing and energy sectors, we demonstrate how LLMs can augment traditional control systems, improving efficiency and resilience against cyber threats.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Bahree},
 isbn = {978-1-63343-694-7},
 keywords = {architectural patterns},
 note = {Publication Title: Generative AI in Action},
 publisher = {Manning},
 url = {https://ieeexplore.proxyucr.elogim.com/document/10745288},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:36:27Z},
 year = {2024}
}

@inproceedings{bai_insight_2025,
 abstract = {We propose a novel approach to enhance the performance of large language models (LLMs) in code generation tasks by incorporating reflective reasoning. Our method, Echo, is an LLM-based agent that iteratively generates, evaluates, and refines code solutions through self-reflection. Unlike traditional one-shot generation, Echo simulates a reflective process where the agent critiques its own outputs and proposes improvements, drawing inspiration from human debugging practices. We evaluate Echo on benchmarks such as HumanEval and MBPP, demonstrating significant improvements in pass@1 accuracy and overall code quality. Our results show that reflective agents can outperform standard LLMs by up to 15% in complex programming tasks, with potential applications in automated software development and education.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
