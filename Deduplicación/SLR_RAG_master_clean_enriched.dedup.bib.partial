@inproceedings{tamascelli_academic_2025,
 abstract = {Interactive data visualization tools empower non-experts to create custom visualizations, but their interfaces often require users to learn complex syntax or rely on limited templates. Visual programming languages (VPLs) offer a promising alternative by allowing users to compose visualizations using visual elements, but existing VPLs for visualization are either too simplistic or too complex for non-experts. We explore the design space of VPLs for interactive data visualization through the creation of VisFlow, a novel VPL that balances expressiveness and simplicity. VisFlow uses a node-link diagram where nodes represent data transformations and visual encodings, and links represent dataflow. We conducted a user study with 12 participants to evaluate VisFlow's usability and expressiveness compared to a text-based tool (Observable) and a template-based tool (Flourish). Results show that VisFlow enables users to create more complex visualizations with fewer errors than Observable, while being more flexible than Flourish. Our findings inform the design of future VPLs for visualization authoring.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Tamascelli},
 doi = {10.1145/3696673.3723065},
 keywords = {academic advising},
 note = {Type: Conference paper},
 pages = {195 -- 202},
 title = {Academic {Advising}},
 url = {https://doi.org/10.1145/3696673.3723065},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:00:33Z},
 year = {2025}
}

@inproceedings{tamascelli_leveraging_2025,
 abstract = {This paper proposes a novel framework for integrating edge computing with industrial IoT devices to enhance real-time fault detection in automated manufacturing lines. By leveraging machine learning algorithms optimized for low-latency environments, the approach reduces downtime by up to 40% in simulated scenarios. Experimental results from a prototype implementation on a flexible manufacturing system demonstrate improved accuracy and scalability compared to traditional centralized methods. The framework addresses key challenges in data privacy and resource constraints, paving the way for more resilient Industry 4.0 applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
