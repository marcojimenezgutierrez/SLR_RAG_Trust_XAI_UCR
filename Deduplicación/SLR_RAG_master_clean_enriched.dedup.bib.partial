@article{nemeth_exploring_2025,
 abstract = {Background

Workplace safety is a critical concern in high-risk industries such as construction and manufacturing. This study investigates the effectiveness of digital twin technology in enhancing safety protocols through real-time monitoring and predictive analytics.

Methods

A case study approach was employed, involving the implementation of digital twins in three construction sites over a 12-month period. Data were collected via sensors, worker feedback surveys, and incident reports. Statistical analysis included regression modeling to assess correlations between technology adoption and safety outcomes.

Results

The integration of digital twins reduced incident rates by 35% and improved response times to hazards by 48%. Predictive models accurately forecasted 82% of potential risks, enabling proactive interventions.

Conclusion

Digital twin technology offers substantial benefits for workplace safety, with implications for policy and training. Future research should explore scalability across diverse industries.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Németh},
 doi = {10.1016/j.ssaho.2025.101751},
 journal = {Social Sciences and Humanities Open},
 keywords = {source: Scopus},
