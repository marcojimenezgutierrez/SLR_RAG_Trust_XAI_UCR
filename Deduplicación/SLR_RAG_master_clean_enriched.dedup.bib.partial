@inproceedings{oliveira_improving_2024,
 abstract = {Haptic feedback has been widely used in virtual reality (VR) to enhance immersion and interaction. However, its application in fitness tracking remains underexplored. In this paper, we present HaptiFit, a VR fitness system that integrates haptic feedback to improve user engagement and performance in physical exercises. We conducted a user study with 24 participants to evaluate the effectiveness of different haptic patterns (vibration intensity, duration, and location) during common fitness activities such as running and weightlifting simulations. Results show that adaptive haptic cues significantly increased motivation and accuracy in form correction, with a 25% improvement in exercise adherence compared to visual-only feedback. Our findings provide design guidelines for haptic integration in VR fitness applications, emphasizing personalization based on user exertion levels.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Oliveira},
 booktitle = {Proceedings of the 26th {Symposium}},
 doi = {10.1145/3691573.3691619},
