@inproceedings{parthasarathy_polymer_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their performance in low-resource languages remains limited. This paper surveys recent advances in multilingual and low-resource language support for LLMs, highlighting key challenges such as data scarcity, tokenization issues, and evaluation metrics. We categorize approaches into pre-training strategies, fine-tuning techniques, and augmentation methods, and discuss their effectiveness across diverse linguistic contexts. Our analysis reveals promising directions for more inclusive AI systems, emphasizing the need for community-driven datasets and ethical considerations in model deployment.},
