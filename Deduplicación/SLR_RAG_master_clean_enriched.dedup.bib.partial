@article{shunmuga_priya_gender_2025,
 abstract = {Hypergraph neural networks (HGNNs) have emerged as a powerful tool for modeling complex high-order relations in data. However, most existing HGNNs are designed for centralized learning scenarios, which cannot be directly applied to distributed data across multiple clients due to privacy concerns. In this paper, we propose FedHGN, a novel federated hypergraph neural network framework for privacy-preserving node classification. FedHGN enables multiple clients to collaboratively train HGNN models without sharing their local data. To address the heterogeneity of hypergraphs across clients, we design a hypergraph alignment module that aligns the hypergraph structures in a privacy-preserving manner using secure multi-party computation. Furthermore, we introduce a personalized federated learning strategy to fine-tune the global model for local clients, enhancing performance on heterogeneous data. Extensive experiments on real-world datasets demonstrate that FedHGN achieves superior classification accuracy compared to baseline methods while effectively preserving privacy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Hybrid Gold Open Access},
 author = {Shunmuga Priya},
 doi = {10.1016/j.knosys.2025.114092},
 journal = {Knowledge-Based Systems},
 keywords = {source: Scopus},
