@inproceedings{jiang_peatmoss_2024,
 abstract = {Social media platforms have become a primary source of news for many users, but the spread of misinformation poses significant risks to public discourse and decision-making. While prior work has explored how users perceive and respond to misinformation, less is known about how they engage with corrective information in social media contexts. In this paper, we investigate how users interact with and perceive fact-checks embedded in social media posts. Through a mixed-methods approach, including a large-scale survey (N=1,200) and in-depth interviews (N=30), we examine the effects of fact-check formats (e.g., labels, annotations, corrections) on user trust, sharing behavior, and belief change. Our findings reveal that subtle, integrated fact-checks are more effective at reducing misinformation sharing than prominent warnings, but they also risk being overlooked. Users express mixed attitudes toward automated vs. human-verified corrections, with concerns about bias and overreach. We discuss implications for platform design and the role of transparency in fostering informed online communities.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 and cross-cutting questions.our artifact is available at https://github.com/purduedualitylab/peatmoss-artifact. our dataset is available at https://transfer.rcac.purdue.edu/file-manager?origin\_id = {ff978999-16c2-4b50-ac7a-947ffdc3eb1d\&amp;origin\_path=\%2F.}},
