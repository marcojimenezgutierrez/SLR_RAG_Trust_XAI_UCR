 pages = {1--7},
 title = {Generating {Commit}},
 url = {https://doi.org/10.23919/cnsm62983.2024.10814636},
 year = {2024}
}

@inproceedings{belikova_data-efficient_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their performance can be hindered by the presence of biases in the training data, leading to unfair outcomes in downstream applications. Recent studies have shown that instruction tuning can help mitigate biases in LLMs, but the effectiveness of this approach remains underexplored, especially in terms of how different instruction formats and datasets impact fairness. In this paper, we conduct a comprehensive study on the role of instruction tuning in improving fairness for LLMs. We evaluate multiple instruction datasets and formats, including natural language instructions, code-like instructions, and chain-of-thought prompting. Our experiments reveal that instruction tuning with diverse and high-quality instructions significantly reduces bias across various fairness metrics, such as gender and racial stereotypes. Furthermore, we introduce a novel instruction generation method that leverages reinforcement learning to create fairness-aware instructions, achieving superior performance compared to existing baselines. Our findings provide valuable insights for developing fairer LLMs and highlight the importance of careful instruction design in bias mitigation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Belikova},
