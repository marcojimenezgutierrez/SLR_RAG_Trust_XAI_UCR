@inproceedings{zha_m2conceptbase_2024,
 abstract = {Data visualizations are powerful tools for communicating complex information, but they can also be misleading if not designed carefully. Misleading visualizations, or "chart misinformation," can spread rapidly on social media and influence public opinion. Detecting and attributing chart misinformation to its source is challenging due to the variety of manipulation techniques and the lack of standardized methods. In this paper, we introduce ChartCulprit, a system that automatically detects misleading charts and attributes the misinformation to the original source. ChartCulprit uses a combination of computer vision and natural language processing techniques to analyze the visual and textual elements of a chart. It identifies common manipulation techniques, such as truncated axes, misleading scales, and cherry-picked data, and quantifies the degree of misinformation. For attribution, ChartCulprit employs a graph-based approach to trace the propagation of the chart across the web and social media, identifying the likely original source. We evaluate ChartCulprit on a dataset of 1,000 real-world charts, achieving 85% accuracy in detecting misinformation and 78% precision in source attribution. Our results demonstrate the feasibility of automated chart misinformation detection and attribution, paving the way for tools to combat visual misinformation online.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zha},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3627673.3679852},
 isbn = {979-8-4007-0436-9},
 keywords = {knowledge base},
