 year = {2024}
}

@article{shi_fine-tuning_2025,
 abstract = {This study proposes a novel framework for integrating Building Information Modeling (BIM) with deep learning techniques to automate the detection and classification of construction defects from 3D point cloud data. The approach leverages a customized PointNet++ architecture enhanced with attention mechanisms to improve feature extraction and classification accuracy. Experimental results on a dataset of real-world construction sites demonstrate superior performance compared to traditional methods, achieving up to 95% accuracy in defect identification. The framework also includes a visualization module for intuitive defect reporting, facilitating timely corrective actions and enhancing project quality control.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
