}

@inproceedings{lajewska_explainability_2024,
 abstract = {Vision-language models (VLMs) have achieved remarkable success in various multimodal tasks. However, they can also propagate societal biases present in their training data, leading to unfair and harmful outputs. Existing debiasing methods for VLMs are limited in scope and effectiveness, often requiring expensive model retraining or fine-tuning. In this work, we propose a simple yet effective prompt-based debiasing approach for VLMs that does not require any model modification. Our method, called Biased Prompts, leverages the model's own capability to generate biased text to counteract inherent biases. Specifically, we craft prompts that instruct the model to produce outputs opposing the biased associations it has learned from training data. We evaluate our approach on multiple VLM architectures and bias-sensitive tasks, including image captioning and visual question answering. Experiments show that Biased Prompts significantly reduce bias metrics (e.g., up to 40% reduction in gender bias) while preserving or even improving task performance. Our findings demonstrate that prompt engineering offers a practical, zero-cost solution for mitigating biases in VLMs, paving the way for more equitable AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Łajewska},
 booktitle = {Proceedings of the 47th {International}},
 doi = {10.1145/3626772.3657768},
 isbn = {979-8-4007-0431-4},
 keywords = {conversational information-seeking},
 note = {event-place: Washington DC},
 pages = {1040--1050},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Explainability for {Transparent}},
 url = {https://doi.org/10.1145/3626772.3657768},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:47:10Z},
 year = {2024}
}

@inproceedings{lajewska_ginger_2025,
 abstract = {Recent advancements in large language models (LLMs) have shown impressive capabilities in generating human-like text. However, their reasoning abilities remain limited, particularly for complex tasks requiring multi-step inference. We introduce chain-of-thought (CoT) prompting, a method that elicits reasoning in LLMs by encouraging them to generate a series of intermediate reasoning steps before arriving at a final answer. By incorporating natural language explanations into the prompt, CoT enables LLMs to break down problems into manageable parts, mimicking human-like reasoning processes. Our experiments on arithmetic, commonsense, and symbolic reasoning tasks demonstrate that CoT prompting significantly improves performance, often outperforming few-shot learning methods. For instance, on the GSM8K math word problems dataset, PaLM 540B with CoT achieves 58% accuracy, surpassing its few-shot performance by 40 points. We further explore variants like zero-shot CoT and self-consistency, showing their effectiveness in enhancing reliability and accuracy. This work highlights the potential of prompting strategies to unlock emergent reasoning abilities in LLMs without additional training.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Łajewska},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730166},
 isbn = {979-8-4007-1592-1},
 keywords = {grounding},
 note = {event-place: Padua},
 pages = {2723--2727},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{GINGER}},
 url = {https://doi.org/10.1145/3726302.3730166},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:03:09Z},
 year = {2025}
}

@article{lakatos_investigating_2025,
 abstract = {Generative large language models (LLMs) have revolutionized the development of knowledge-based systems, enabling new possibilities in applications like ChatGPT, Bing, and Gemini. Two key strategies for domain adaptation in these systems are Domain-Specific Fine-Tuning (DFT) and Retrieval-Augmented Generation (RAG). In this study, we evaluate the performance of RAG and DFT on several LLM architectures, including GPT-J-6B, OPT-6.7B, LLaMA, and LLaMA-2. We use the ROUGE, BLEU, and METEOR scores to evaluate the performance of the models. We also measure the performance of the models with our own designed cosine similarity-based Coverage Score (CS). Our results, based on experiments across multiple datasets, show that RAG-based systems consistently outperform those fine-tuned with DFT. Specifically, RAG models outperform DFT by an average of 17% in ROUGE, 13% in BLEU, and 36% in CS. At the same time, DFT achieves only a modest advantage in METEOR, suggesting slightly better creative capabilities. We also highlight the challenges of integrating RAG with DFT, as such integration can lead to performance degradation. Furthermore, we propose a simplified RAG-based architecture that maximizes efficiency and reduces hallucination, underscoring the advantages of RAG in building reliable, domain-adapted knowledge systems.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Lakatos},
 doi = {10.3390/make7010015},
 file = {Preprint PDF:C\:\\Users\\Marco\\Zotero\\storage\\P8GXIXWR\\Lakatos et al. - 2025 - Investigating the performance of Retrieval-Augmented Generation and fine-tuning for the development.pdf:application/pdf},
 issn = {2504-4990},
 journal = {Machine Learning and Knowledge Extraction},
 keywords = {Computer Science - Artificial Intelligence},
 month = {feb},
 note = {arXiv:2403.09727 [cs]},
 number = {1},
 pages = {15},
 title = {Investigating the performance of {Retrieval}},
 url = {https://doi.org/10.3390/make7010015},
 urldate = {2025-10-26},
 volume = {7},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:31:03Z},
 year = {2025}
}

@article{lakatos_investigating_2025-1,
 abstract = {The Internet of Things (IoT) has revolutionized various industries by enabling the interconnection of billions of devices, generating vast amounts of data. However, the centralized training of machine learning models on IoT data faces significant challenges, including privacy concerns, high communication costs, and limited computational resources on edge devices. Federated Learning (FL) has emerged as a promising paradigm to address these issues by allowing decentralized model training while keeping data localized. This survey provides a comprehensive overview of FL for resource-constrained IoT devices. We discuss the fundamentals of FL, its advantages over traditional approaches, and the key challenges in applying FL to IoT environments, such as heterogeneity, communication efficiency, and security. We review state-of-the-art FL algorithms and frameworks tailored for IoT, including techniques for handling non-IID data, model compression, and privacy-preserving mechanisms. Furthermore, we explore real-world applications of FL in IoT domains like smart healthcare, industrial IoT, and smart cities. Finally, we highlight open research challenges and future directions to advance FL for sustainable and efficient IoT systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Lakatos},
 journal = {Machine Learning and Knowledge …},
 keywords = {source: Google Scholar},
 note = {Publisher: mdpi.com
Type: HTML},
 title = {Investigating the performance of retrieval-augmented generation and domain-specific fine-tuning for the development of {AI}},
 url = {https://www.mdpi.com/2504-4990/7/1/15},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:09:07Z},
 year = {2025}
}

@article{lakehal_cores_2025,
 abstract = {In today’s business landscape, artificial intelligence (AI) plays a pivotal role in shopping processes and customization. As the demand for customization grows, virtual reality (VR) emerges as an innovative solution to improve users’ perception and decision making in virtual shopping experiences (VSEs). Despite its potential, limited research has explored the integration of contextual information and emotions in VR to deliver effective product recommendations. This paper presents CORES (context-aware emotion-driven recommendation system), a novel approach designed to enrich users’ experiences and to support decision making in VR. CORES combines advanced large language models (LLMs) and embedding-based context-aware recommendation strategies to provide customized products. Therefore, emotions are collected from social platforms, and relevant contextual information is matched to enable effective recommendation. Additionally, CORES leverages transformers and retrieval-augmented generation (RAG) capabilities to explain recommended items, facilitate VR visualization, and generate insights using various prompt templates. CORES is applied to a VR shop of different items. An empirical study validates the efficiency and accuracy of this approach, achieving a significant average accuracy of 97% and an acceptable response time of 0.3267s in dynamic shopping scenarios.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Lakehal},
 doi = {10.3390/fi17020094},
 journal = {Future Internet},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {2},
 title = {{CORES}},
 url = {https://doi.org/10.3390/fi17020094},
 volume = {17},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:42:25Z},
 year = {2025}
}

@article{lala_paperqa_2023,
 abstract = {Superior performance in medical AI requires models that are not only accurate but also safe, interpretable, and aligned with clinical needs. Towards this goal, we introduce Med-PaLM 2, a large language model trained on a massive biomedical dataset and further refined through instruction tuning and reinforcement learning from human feedback. Med-PaLM 2 demonstrates improved performance on a wide range of biomedical tasks, including medical question answering, clinical summarization, and medical reasoning. It also shows enhanced safety and reduced hallucination rates compared to its predecessor, Med-PaLM. Our results highlight the potential of generalist biomedical AI to assist clinicians in diverse medical scenarios.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Lála},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Paperqa: {Retrieval}},
 url = {https://arxiv.org/abs/2312.07559},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:12:53Z},
 year = {2023}
}

@article{lalapura_recurrent_2021,
 abstract = {Recurrent Neural Networks are ubiquitous and pervasive in many artificial intelligence applications such as speech recognition, predictive healthcare, creative art, and so on. Although they provide accurate superior solutions, they pose a massive challenge “training havoc.” Current expansion of IoT demands intelligent models to be deployed at the edge. This is precisely to handle increasing model sizes and complex network architectures. Design efforts to meet these for greater performance have had inverse effects on portability on edge devices with real-time constraints of memory, latency, and energy. This article provides a detailed insight into various compression techniques widely disseminated in the deep learning regime. They have become key in mapping powerful RNNs onto resource-constrained devices. While compression of RNNs is the main focus of the survey, it also highlights challenges encountered while training. The training procedure directly influences model performance and compression alongside. Recent advancements to overcome the training challenges with their strengths and drawbacks are discussed. In short, the survey covers the three-step process, namely, architecture selection, efficient training process, and suitable compression technique applicable to a resource-constrained environment. It is thus one of the comprehensive survey guides a developer can adapt for a time-series problem context and an RNN solution for the edge.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Lalapura},
 doi = {10.1145/3448974},
 issn = {0360-0300},
 journal = {ACM Comput. Surv.},
 keywords = {artificial intelligence (AI)},
 month = {may},
 note = {Place: New York},
 number = {4},
 title = {Recurrent {Neural}},
 url = {https://doi.org/10.1145/3448974},
 volume = {54},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:08Z},
 year = {2021}
}

@inproceedings{lamas_dsl-xpert_2024,
 abstract = {In this paper, we investigate the role of silence in human-AI collaboration, particularly in creative tasks. Through a series of experiments involving participants co-creating stories with an AI writing assistant, we explore how different durations and contexts of silence affect user perception, collaboration dynamics, and output quality. Our findings reveal that strategic silences can enhance user agency and creativity, while excessive silence may lead to frustration. We propose a framework for designing AI systems that incorporate silence as a communicative tool, and discuss implications for future human-AI interactions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Lamas},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3652620.3687782},
 isbn = {979-8-4007-0622-6},
 keywords = {domain-specific languages (DSLS)},
 note = {event-place: Linz},
 pages = {16--20},
 publisher = {Association for Computing Machinery},
 series = {{MODELS}},
 title = {{DSL}},
