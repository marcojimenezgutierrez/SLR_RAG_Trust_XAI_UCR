 year = {2025}
}

@article{raza_improving_2023,
 abstract = {Molecular interaction networks are powerful resources for annotating gene functions and predicting phenotypes. However, the construction of high-quality networks remains challenging due to the sparsity and noise in high-throughput experimental data. Here, we develop a deep learning framework, DeepProbLog, to integrate multi-omics data and prior knowledge for probabilistic network inference. DeepProbLog combines neural networks with probabilistic logic programming to learn latent representations of molecular interactions while incorporating domain knowledge as logical constraints. We apply DeepProbLog to infer protein-protein interaction (PPI) networks from mass spectrometry-based proteomics data in yeast. The resulting network achieves higher precision and recall compared to state-of-the-art methods. Furthermore, DeepProbLog uncovers novel interactions that are validated by orthogonal experiments. Our framework is generalizable to other types of molecular networks and omics data, enabling scalable and interpretable network inference.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Raza},
 doi = {10.1109/TCBB.2023.3318209},
 issn = {1545-5963},
 journal = {IEEE/ACM Trans. Comput. Biol. Bioinformatics},
 keywords = {source: ACM},
