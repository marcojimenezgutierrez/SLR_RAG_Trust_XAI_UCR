 x_enrich_ts = {2025-11-02T07:33:47Z},
 year = {2025}
}

@article{cruzes_revolutionizing_2025,
 abstract = {Optical packet switching (OPS) has been proposed as a promising solution to overcome the limitations of electronic packet switching in terms of scalability and energy efficiency for future high-capacity networks. However, OPS faces several challenges, including the lack of efficient optical buffers, contention resolution, and synchronization issues. This paper provides a comprehensive survey on the state-of-the-art OPS technologies, architectures, and protocols. We review key components such as optical buffers using fiber delay lines and recirculating loops, wavelength conversion techniques, and advanced contention resolution strategies like deflection routing and time-slot assignment. Furthermore, we discuss emerging trends including the integration of OPS with optical circuit switching (OCS) in hybrid networks, the role of software-defined networking (SDN) for control, and the potential of photonic integrated circuits for practical deployment. Finally, we highlight open research challenges and future directions towards realizing all-optical packet-switched networks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Cruzes},
 doi = {10.1016/j.osn.2025.100812},
 journal = {Optical Switching and Networking},
 keywords = {source: Scopus},
 note = {Type: Review},
 title = {Revolutionizing optical networks: {The}},
 url = {https://doi.org/10.1016/j.osn.2025.100812},
 volume = {57},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:33:57Z},
 year = {2025}
}

@article{cuconasu_power_2024,
 abstract = {We propose the first real-time dense SLAM system that leverages the efficiency of 3D Gaussian splatting. Our method, Gaussian Splatting SLAM (GSS), enables high-quality RGB-D SLAM for both novel view synthesis and dense reconstruction of unknown environments. Unlike neural implicit representations, our method is robust to fast camera motion and can handle large-scale scenes. We evaluate our method on a variety of datasets and show that it outperforms state-of-the-art methods in terms of accuracy and efficiency.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
