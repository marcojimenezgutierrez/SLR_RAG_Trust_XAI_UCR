}

@article{miladi_leveraging_2024,
 abstract = {Diabetic retinopathy (DR) is one of the major complications of diabetes and a leading cause of blindness among working-age adults. Early detection and timely treatment are essential to prevent vision loss. Traditional screening methods rely on manual examination by ophthalmologists, which is time-consuming and prone to human error. In this paper, we propose a novel deep learning-based approach for the automated detection and severity grading of DR using fundus images. Our model integrates a hybrid convolutional neural network (CNN) architecture with transfer learning from pre-trained models like ResNet and EfficientNet, enhanced by attention mechanisms to focus on key retinal features such as microaneurysms, hemorrhages, and exudates. The proposed system is evaluated on the APTOS 2019 Blindness Detection dataset, achieving an accuracy of 95.2%, sensitivity of 94.8%, and specificity of 96.1% for multi-class classification of DR severity levels. Comparative analysis with state-of-the-art methods demonstrates the superiority of our approach in terms of performance metrics and computational efficiency, making it suitable for deployment in resource-constrained clinical settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
