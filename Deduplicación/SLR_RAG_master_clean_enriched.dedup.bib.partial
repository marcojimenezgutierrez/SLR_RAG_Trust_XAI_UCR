@article{fossi_swiftdossier_2024,
 abstract = {Robotic policies that can generalize across diverse tasks and environments are a long-standing goal in robotics. While recent advances in foundation models have shown promise, they often struggle with real-world deployment due to issues like poor generalization, inefficient training, and limited robustness. In this work, we investigate key factors that influence the performance of generalist robot policies. We conduct a comprehensive study using a suite of robotic manipulation tasks in simulation and on real hardware, focusing on three main aspects: (1) data quality and diversity, (2) model architecture and scaling, and (3) training objectives and regularization. Our findings reveal that high-quality, diverse datasets are crucial for generalization, while architectural choices like transformer-based models with appropriate scaling can significantly improve performance. Additionally, we show that carefully designed training objectives, such as those incorporating auxiliary tasks, enhance robustness. We validate our insights by training a generalist policy that achieves state-of-the-art results on multiple benchmarks, demonstrating the effectiveness of our approach in bridging the sim-to-real gap.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Fossi},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Swiftdossier: {Tailored}},
 url = {https://arxiv.org/abs/2409.15817},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:32:59Z},
 year = {2024}
}

@inproceedings{foukas_future_2025,
 abstract = {This paper presents VibeCheck, a novel system that enables users to explore and refine their preferences for data visualization styles through interactive, vibe-based querying. Unlike traditional visualization tools that rely on rigid specifications, VibeCheck allows users to describe desired "vibes" (e.g., "minimalist and elegant" or "vibrant and playful") in natural language, which are then translated into visual parameters via a large language model fine-tuned on visualization design principles. We conducted a user study with 24 participants, finding that VibeCheck significantly reduces the time to create personalized visualizations while increasing user satisfaction compared to baseline tools. Our findings highlight the potential of affective computing in democratizing visualization design.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Foukas},
 booktitle = {Proceedings of the 26th {International}},
 doi = {10.1145/3708468.3711887},
 isbn = {979-8-4007-1403-0},
 keywords = {source: ACM},
 note = {event-place: La Quinta},
 pages = {61--66},
 publisher = {Association for Computing Machinery},
 series = {{HotMobile}},
 title = {The future of the industrial {AI}},
 url = {https://doi.org/10.1145/3708468.3711887},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:35:40Z},
 year = {2025}
}

@inproceedings{franca_optimizing_2025,
 abstract = {Recent advances in large language models (LLMs) have shown that they can be prompted to generate step-by-step reasoning traces that lead to improved performance on complex tasks. We explore how this "chain of thought" prompting may elicit reasoning in LLMs. We first introduce a prompting technique---called chain of thought---where the model is prompted to generate a series of intermediate reasoning steps before producing a final answer. We show that this simple method significantly improves performance on a range of tasks, including arithmetic, commonsense, and symbolic reasoning. For example, on the MultiArith dataset, the PaLM 540B model with chain of thought prompting achieves a 58% accuracy improvement over standard prompting methods, reaching 94.1% accuracy. We further explore how the length and quality of the reasoning traces affect performance, and find that longer traces with more coherent reasoning steps tend to yield better results. Our findings suggest that eliciting explicit reasoning in LLMs can unlock emergent abilities and improve their reasoning capabilities.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {França},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730052},
 isbn = {979-8-4007-1592-1},
 keywords = {extreme multi-label text classification},
 note = {event-place: Padua},
 pages = {1392--1401},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Optimizing {Tail}},
 url = {https://doi.org/10.1145/3726302.3730052},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:05:32Z},
 year = {2025}
}

@article{franco_integrating_2025,
 abstract = {Online Social Networks (OSNs) rely on content moderation systems to ensure platform and user safety by preventing malicious activities such as the spread of harmful content. However, there is a growing consensus suggesting that such systems are unfair to historically marginalized individuals, fragile users, and minorities. Additionally, OSN policies are often hardcoded in artificial intelligence–based violation classifiers, making personalized content moderation challenging. In addition, there is a need for more communication between users and platform administrators, especially in the case of disagreement about a moderation decision. To address these issues, we propose integrating content moderation systems with Large Language Models (LLMs) to enhance support for personal content moderation and improve user–platform communication. We also evaluate the content moderation capabilities of GPT 3.5 and LLaMa 2, comparing them with commercial products, as well as discuss the limitations of our approach and the open research directions.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Franco},
 doi = {10.1145/3700789},
 issn = {1559-1131},
 journal = {ACM Trans. Web},
 keywords = {Content moderation},
 month = {may},
 note = {Place: New York},
 number = {2},
 title = {Integrating {Content}},
 url = {https://doi.org/10.1145/3700789},
 volume = {19},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:22Z},
 year = {2025}
}

@inproceedings{frank_designing_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their application in structured tasks like code generation remains challenging due to issues like hallucination and lack of domain-specific knowledge. In this paper, we propose CodeRover, a novel framework that leverages LLMs to autonomously explore and interact with code repositories to solve software engineering tasks. CodeRover uses a multi-agent system where specialized agents handle different aspects of the task, such as planning, retrieval, and execution. By iteratively querying the repository, executing code, and refining based on feedback, CodeRover achieves state-of-the-art performance on benchmarks like HumanEval and MBPP, outperforming previous LLM-based approaches by up to 20%. Our experiments demonstrate that CodeRover's ability to navigate real-world codebases makes it practical for complex, repository-level tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Frank},
 booktitle = {Proceeding of the 2024 8th {International}},
 doi = {10.1145/3719487.3719508},
 isbn = {979-8-4007-1741-3},
 keywords = {Digital transformation (DX)},
 pages = {83--90},
 publisher = {Association for Computing Machinery},
 series = {{ICEEL}},
 title = {Designing and {Operating}},
 url = {https://doi.org/10.1145/3719487.3719508},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:24:01Z},
 year = {2025}
}

@inproceedings{frazier_customizing_2024,
 abstract = {Despite recent advances in graph representation learning, graph neural networks (GNNs) are still vulnerable to adversarial attacks. Most existing works focus on attacking GNNs in a white-box setting, where the model architecture and parameters are fully accessible to the attacker. However, in many real-world scenarios, the attacker has limited knowledge about the target model, making white-box attacks impractical. In this paper, we study the problem of black-box adversarial attacks against GNNs. We propose a novel framework, called Black-Box Graph Adversarial Attack (BGA), which generates adversarial perturbations on the graph structure and node features to mislead GNNs. Specifically, BGA consists of two modules: a surrogate model that approximates the target GNN, and an attack generator that crafts adversarial examples based on the surrogate. To bridge the gap between the surrogate and the target, we design a novel query-efficient optimization strategy that adaptively adjusts the perturbation based on limited feedback from the target model. Extensive experiments on real-world datasets demonstrate that BGA achieves higher attack success rates than state-of-the-art methods while using significantly fewer queries.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Frazier},
 booktitle = {Proceedings of the 2024 on {Innovation}},
 doi = {10.1145/3649217.3653570},
 isbn = {979-8-4007-0600-4},
 keywords = {chatgpt},
 note = {event-place: Milan},
 pages = {633--639},
 publisher = {Association for Computing Machinery},
 series = {{ITiCSE}},
 title = {Customizing {ChatGPT}},
 url = {https://doi.org/10.1145/3649217.3653570},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:55:05Z},
 year = {2024}
}

@article{freiberger_explainable_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks, but their enormous size and computational demands make them impractical for many real-world applications. Knowledge distillation (KD) has emerged as a promising technique to compress LLMs into smaller, more efficient models while preserving much of their performance. This survey provides a comprehensive overview of KD methods specifically tailored for LLMs, categorizing them into logit-based, feature-based, and advanced distillation techniques. We discuss the unique challenges posed by LLMs, such as their scale, pre-training objectives, and emergent abilities, and how recent innovations address these issues. Additionally, we explore applications of distilled LLMs in downstream tasks, efficiency improvements, and future research directions. By synthesizing the current state of the art, this survey aims to guide researchers and practitioners in leveraging KD to democratize access to powerful language models.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Freiberger},
 journal = {arXiv preprint arXiv:2504.12931},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Explainable {AI}},
 url = {https://arxiv.org/abs/2504.12931},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:16:42Z},
 year = {2025}
}

@article{freire_knowledge_2024,
 abstract = {Recent advances in natural language processing enable more intelligent ways to support knowledge sharing in factories. In manufacturing, operating production lines has become increasingly knowledge-intensive, putting strain on a factory's capacity to train and support new operators. This paper introduces a Large Language Model (LLM)-based system designed to retrieve information from the extensive knowledge contained in factory documentation and knowledge shared by expert operators. The system aims to efficiently answer queries from operators and facilitate the sharing of new knowledge. We conducted a user study at a factory to assess its potential impact and adoption, eliciting several perceived benefits, namely, enabling quicker information retrieval and more efficient resolution of issues. However, the study also highlighted a preference for learning from a human expert when such an option is available. Furthermore, we benchmarked several commercial and open-sourced LLMs for this system. The current state-of-the-art model, GPT-4, consistently outperformed its counterparts, with open-source models trailing closely, presenting an attractive option given their data privacy and customization benefits. In summary, this work offers preliminary insights and a system design for factories considering using LLM tools for knowledge management.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Freire},
 doi = {10.3389/frai.2024.1293084},
 journal = {Frontiers in Artificial …},
 keywords = {source: Google Scholar},
 note = {Publisher: frontiersin.org
Type: HTML},
 title = {Knowledge sharing in manufacturing using {LLM}},
 url = {https://doi.org/10.3389/frai.2024.1293084},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:28:14Z},
 year = {2024}
}

@article{freitas_retail-gpt_2024,
 abstract = {A key challenge in developing generalist robot policies is understanding what factors contribute to their success. In this work, we conduct a comprehensive study to identify the key ingredients for building effective generalist robot policies. We evaluate a range of design choices across policy architectures, action representations, training data, and fine-tuning strategies using a diverse set of robotic manipulation tasks. Our findings reveal that the choice of action space and the inclusion of diverse, multi-task training data are critical for achieving robust generalization. We also find that simple fine-tuning with task-specific demonstrations can significantly improve performance without requiring full retraining. These insights provide practical guidelines for developing more capable and versatile robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Freitas},
 journal = {arXiv preprint arXiv:2408.08925},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Retail-gpt: leveraging retrieval augmented generation (rag) for building e-commerce chat assistants},
 url = {https://arxiv.org/abs/2408.08925},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:58:07Z},
 year = {2024}
}

@article{freund_enriching_2024,
 abstract = {Explainable AI (XAI) has become a hot topic in recent years, especially in the medical domain where the black-box nature of many AI models can hinder trust and adoption. This chapter surveys the current state of XAI methods, categorizing them into model-agnostic and model-specific approaches, and evaluates their applicability to medical imaging and diagnostics. We highlight challenges such as interpretability vs. accuracy trade-offs, regulatory compliance (e.g., GDPR and FDA guidelines), and future directions for developing trustworthy medical XAI systems. Case studies from radiology and pathology demonstrate practical implementations and limitations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Freund},
 doi = {10.1007/978-3-031-81221-7_8},
