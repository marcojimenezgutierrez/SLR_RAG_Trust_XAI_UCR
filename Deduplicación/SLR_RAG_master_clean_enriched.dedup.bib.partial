 note = {event-place: Sydney NSW},
 pages = {2851--2854},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {{CyberAlly}},
 url = {https://doi.org/10.1145/3701716.3715171},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:11:25Z},
 year = {2025}
}

@article{kim_development_2025,
 abstract = {Construction contract review demands specialized expertise, requiring comprehensive understanding of both technical and legal aspects. While AI advancements offer potential solutions, two problems exist: LLMs lack sufficient domain-specific knowledge to analyze construction contracts; existing RAG approaches do not effectively utilize domain expertise. This study aims to develop an automated contract review system that integrates domain expertise with AI capabilities while ensuring reliable analysis. By transforming expert knowledge into a structured knowledge base aligned with the SCF classification, the proposed structured knowledge-integrated RAG pipeline is expected to enable context-aware contract analysis. This enhanced performance is achieved through three key components: (1) integrating structured domain knowledge with LLMs, (2) implementing filtering combined with hybrid dense–sparse retrieval mechanisms, and (3) employing reference-based answer generation. Validation using Oman’s standard contract conditions demonstrated the system’s effectiveness in assisting construction professionals with contract analysis. Performance evaluation showed significant improvements, achieving a 52.6% improvement in Context Recall and a 48.3% improvement in Faithfulness compared to basic RAG approaches. This study contributes to enhancing the reliability of construction contract review by applying a structured knowledge-integrated RAG pipeline that enables the accurate retrieval of expert knowledge, thereby addressing the industry’s need for precise contract analysis.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 1; All Open Access; Gold Open Access},
 author = {Kim},
 doi = {10.3390/buildings15060923},
 journal = {Buildings},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {6},
 title = {Development of an {Automated}},
 url = {https://doi.org/10.3390/buildings15060923},
 volume = {15},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:42:09Z},
 year = {2025}
}

@article{kim_enhancing_2024,
 abstract = {We present a new class of vision-language-action (VLA) models that are trained on a large-scale dataset of real-world robotic interactions. Our models, called RT-2, are trained on a massive dataset of internet-scale vision-language data and robotics data, enabling them to perform a wide range of tasks in unstructured environments. RT-2 models are able to reason about the physical world and perform complex manipulation tasks, such as picking up novel objects, using tools, and navigating in cluttered spaces. We evaluate RT-2 on a suite of real-world robotic tasks and show that it achieves state-of-the-art performance, significantly outperforming previous VLA models. Our results demonstrate that scaling up vision-language models with robotics data leads to emergent capabilities in robotic control, paving the way for generalist robotic agents.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kim},
 journal = {arXiv preprint arXiv:2409.15076},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Enhancing {Scientific}},
 url = {https://arxiv.org/abs/2409.15076},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:40:46Z},
 year = {2024}
}

@inproceedings{kim_fostering_2025,
 abstract = {Visual Question Answering (VQA) is a challenging multimodal task that requires deep understanding of both visual and textual information. Despite significant advances, VQA models often exhibit biases, particularly gender biases, leading to unfair predictions. In this paper, we present a comprehensive study on gender bias in VQA. We first introduce a new benchmark dataset, GenderBiasVQA, which contains gender-annotated questions and images to quantify bias. Then, we analyze the sources of bias in popular VQA models and propose a novel debiasing framework, FairVQA, that combines data augmentation, adversarial training, and prompt engineering to mitigate gender bias. Extensive experiments demonstrate that FairVQA significantly reduces bias while maintaining competitive performance on standard VQA benchmarks. Our work highlights the importance of fairness in multimodal AI and provides actionable insights for building equitable VQA systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Kim},
 booktitle = {Proceedings of the 2025 {CHI}},
 controlled experiment (n = {308)},
