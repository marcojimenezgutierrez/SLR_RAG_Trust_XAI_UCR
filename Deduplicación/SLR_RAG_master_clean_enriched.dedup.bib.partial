 year = {2025}
}

@article{miladi_comparative_2024,
 abstract = {This paper presents a novel approach to enhancing the robustness of federated learning systems against adversarial attacks. We propose a defense mechanism that integrates differential privacy with model ensemble techniques, ensuring both privacy preservation and improved accuracy under poisoned data scenarios. Through extensive simulations on benchmark datasets like CIFAR-10 and MNIST, our method demonstrates a significant reduction in attack success rates while maintaining model performance comparable to baseline federated learning. The results highlight the efficacy of our hybrid strategy in real-world distributed learning environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
