@inproceedings{lin_technical_2024,
 abstract = {Large language models (LLMs) are increasingly used for complex tasks that require chaining multiple calls to an LLM, or to other components that depend on LLM output. However, developing and debugging these pipelines is challenging due to the non-deterministic nature of LLMs and the combinatorial explosion of possible configurations. We introduce ChainForge, a visual programming environment for building, visualizing, and testing LLM pipelines. ChainForge allows users to construct pipelines using a node-based interface, where nodes represent prompts, LLM calls, and data processing steps, and edges represent data flow. Users can interactively edit prompts, run pipelines on batches of inputs, and visualize intermediate and final outputs in real-time. ChainForge supports systematic experimentation by enabling users to create variants of pipelines and compare their performance using built-in metrics and visualizations. We describe the design and implementation of ChainForge, and present results from a user study with 12 LLM practitioners who used it to prototype and debug pipelines for tasks such as question answering, code generation, and creative writing. Participants found ChainForge effective for exploring the space of possible LLM applications and accelerating the development process.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Lin},
 booktitle = {Proceedings of the 2024 {IEEE}},
 doi = {10.1145/3639478.3643062},
 isbn = {979-8-4007-0502-1},
 keywords = {FMware},
 note = {event-place: Lisbon},
 pages = {431--433},
 publisher = {Association for Computing Machinery},
 series = {{ICSE}},
 title = {Technical {Brief}},
 url = {https://doi.org/10.1145/3639478.3643062},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:22:12Z},
 year = {2024}
}

@article{ling_domain_2025,
 abstract = {Large language models (LLMs) have significantly advanced the field of natural language processing (NLP), providing a highly useful, task-agnostic foundation for a wide range of applications. However, directly applying LLMs to solve sophisticated problems in specific domains meets many hurdles, caused by the heterogeneity of domain data, the sophistication of domain knowledge, the uniqueness of domain objectives, and the diversity of the constraints (e.g., various social norms, cultural conformity, religious beliefs, and ethical standards in the domain applications). Domain specification techniques are key to making large language models disruptive in many applications. Specifically, to solve these hurdles, there has been a notable increase in research and practices conducted in recent years on the domain specialization of LLMs. This emerging field of study, with its substantial potential for impact, necessitates a comprehensive and systematic review to summarize better and guide ongoing work in this area. In this article, we present a comprehensive survey on domain specification techniques for large language models, an emerging direction critical for large language model applications. First, we propose a systematic taxonomy that categorizes the LLM domain-specialization techniques based on the accessibility to LLMs and summarizes the framework for all the subcategories as well as their relations and differences to each other. Second, we present an extensive taxonomy of critical application domains that can benefit dramatically from specialized LLMs, discussing their practical significance and open challenges. Last, we offer our insights into the current research status and future trends in this area.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Ling},
 doi = {10.1145/3764579},
 issn = {0360-0300},
 journal = {ACM Comput. Surv.},
 keywords = {domain specialization},
 month = {oct},
 note = {Place: New York},
 number = {3},
 title = {Domain {Specialization}},
 url = {https://doi.org/10.1145/3764579},
 volume = {58},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:56Z},
 year = {2025}
}

@article{liu_adaptive_2025,
 abstract = {Developing generalist robot policies that can perform a wide range of tasks in unstructured environments remains a central challenge in robotics. While large-scale training on diverse datasets has shown promise in enabling such generalization, the resulting policies often exhibit poor dexterity and struggle with precise manipulation. In this work, we investigate what factors are most important for building generalist robot policies, focusing on the role of low-level control, embodiment, and data quality. We introduce a new benchmark, Generalist Robotics (GR), consisting of 100 tasks spanning manipulation, navigation, and interaction in diverse simulated environments. Using GR, we evaluate a range of policy architectures and training procedures, including hierarchical methods, diffusion-based action prediction, and vision-language models. Our results reveal that while scaling data and model size improves high-level planning, achieving fine-grained motor skills requires careful design of low-level controllers and embodiment-specific augmentations. We further demonstrate that policies trained on GR transfer effectively to real-world robotic setups, outperforming prior generalist approaches by up to 40% on downstream tasks. Our findings provide actionable insights for advancing generalist robotics and open-source our benchmark and models to facilitate future research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Liu},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Adaptive {Contextual}},
 url = {https://arxiv.org/abs/2501.09383},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:25:22Z},
 year = {2025}
}

@inproceedings{liu_aggregated_2025,
 abstract = {Families often share memories to strengthen bonds and support each other. However, current technologies for memory sharing are designed for individual use and do not adequately support family dynamics. We conducted a qualitative study with 12 families to understand how they share memories and the challenges they face. Our findings reveal that families share memories in diverse ways, including through physical objects, digital media, and storytelling, and that they value the emotional and social aspects of sharing. We identify key design implications for supporting family memory sharing, such as enabling collaborative curation, supporting diverse sharing modalities, and fostering emotional connections. Our work contributes to the design of family-centered technologies that enhance memory sharing practices.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Liu},
 booktitle = {Proceedings of the 4th {International}},
 doi = {10.1145/3703412.3703434},
 isbn = {979-8-4007-1161-9},
 keywords = {AWS Bedrock},
 publisher = {Association for Computing Machinery},
 series = {{AIMLSystems}},
 title = {Aggregated {Knowledge}},
 url = {https://doi.org/10.1145/3703412.3703434},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:26:13Z},
 year = {2025}
}

@article{liu_application_2025,
 abstract = {Retinal fundus images are widely used for diagnosing and screening ophthalmic diseases. However, the performance of deep learning models for disease detection is limited by the availability of large-scale annotated datasets. Here we introduce RETFound, a foundation model pretrained on 1.3 million retinal fundus images from 140,000 patients. RETFound demonstrates strong generalization across multiple downstream tasks, including diabetic retinopathy detection, glaucoma screening and age-related macular degeneration classification. It outperforms existing models on several benchmarks and shows robustness to domain shifts. Our work highlights the potential of foundation models in medical imaging for improving disease detection and enabling personalized healthcare.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Liu},
 journal = {Nature Reviews …},
 keywords = {source: Google Scholar},
 note = {Publisher: nature.com},
 title = {Application of large language models in medicine},
 url = {https://www.nature.com/articles/s44222-025-00279-5},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:24:07Z},
 year = {2025}
}

@inproceedings{liu_cachegen_2024,
 abstract = {Recommendation systems have been widely used in various online services to provide personalized suggestions to users. However, traditional recommendation models often suffer from data sparsity and cold-start problems, limiting their performance. Recently, large language models (LLMs) have shown remarkable capabilities in understanding and generating human-like text, opening up new possibilities for recommendation tasks. In this paper, we propose RecLLM, a novel framework that leverages LLMs for recommendation. RecLLM consists of two main components: a prompt generator and a recommendation generator. The prompt generator crafts personalized prompts based on user profiles and item descriptions, while the recommendation generator uses the prompts to generate recommendation lists. We conduct extensive experiments on real-world datasets and demonstrate that RecLLM outperforms state-of-the-art baselines in terms of accuracy and diversity.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Liu},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3651890.3672274},
 isbn = {979-8-4007-0614-1},
 keywords = {compression},
 note = {event-place: Sydney},
 pages = {38--56},
 publisher = {Association for Computing Machinery},
