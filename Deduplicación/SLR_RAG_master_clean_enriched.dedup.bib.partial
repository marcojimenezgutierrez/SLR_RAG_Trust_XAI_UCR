 year = {2024}
}

@article{han_rag-qa_2024,
 abstract = {Vision-language models (VLMs) have achieved remarkable success in aligning visual and textual modalities. However, the discretization of visual tokens in these models remains under-explored. In this paper, we investigate the role of token discretization in VLM alignment. We propose a simple yet effective method, TokenDisalign, to disentangle the effects of token discretization from other factors in VLM alignment. Our experiments reveal that token discretization significantly impacts VLM performance, particularly in tasks requiring fine-grained visual understanding. We further demonstrate that adjusting the granularity of token discretization can improve VLM alignment without additional training. Our findings provide new insights into the design of VLMs and suggest that token discretization is a critical yet overlooked factor in VLM alignment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Han},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {{RAG}},
