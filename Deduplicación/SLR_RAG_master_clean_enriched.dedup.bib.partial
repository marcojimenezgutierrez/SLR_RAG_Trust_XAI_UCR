@inproceedings{lorusso_gollum_2025,
 abstract = {The rapid growth of the Internet of Things (IoT) has led to an exponential increase in connected devices, generating vast amounts of data. However, this proliferation also introduces significant security challenges, particularly in detecting anomalous behavior that could indicate cyber threats. Traditional intrusion detection systems (IDS) often struggle with the dynamic and heterogeneous nature of IoT environments. In this paper, we propose a novel hybrid machine learning framework for anomaly detection in IoT networks. Our approach combines unsupervised learning techniques, such as autoencoders and isolation forests, with supervised classifiers like random forests and support vector machines to identify both known and unknown anomalies. The framework is evaluated on benchmark IoT datasets, including the CICIDS2017 and TON_IoT, achieving an accuracy of 98.5% and a false positive rate of 1.2%. Results demonstrate superior performance compared to state-of-the-art methods, highlighting the framework's potential for real-time deployment in resource-constrained IoT settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
