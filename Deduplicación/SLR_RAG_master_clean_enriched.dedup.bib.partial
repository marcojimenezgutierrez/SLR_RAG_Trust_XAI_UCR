@article{uhm_effectiveness_2025,
 abstract = {This study proposes a novel approach for optimizing precast concrete (PC) production scheduling using digital twin (DT) technology. The proposed approach integrates real-time data from production processes with simulation models to dynamically adjust schedules, minimizing delays and resource waste. A case study on a PC factory demonstrates the effectiveness, showing a 25% reduction in production time and improved resource utilization. The framework includes modules for data acquisition, DT modeling, optimization algorithms, and visualization, providing a scalable solution for the construction industry.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
