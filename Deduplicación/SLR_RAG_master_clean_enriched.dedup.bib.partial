 pages = {847--852},
 title = {{RAG}},
 url = {https://doi.org/10.1109/cai64502.2025.00150},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:08:41Z},
 year = {2025}
}

@article{grislain_rag_2025-1,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for training machine learning models in a distributed manner while preserving data privacy. However, its application in resource-constrained Internet of Things (IoT) devices faces significant challenges due to limited computational power, memory, and communication bandwidth. This survey provides a comprehensive overview of FL techniques tailored for IoT environments, categorizing them based on key aspects such as model compression, communication efficiency, and privacy enhancement. We discuss state-of-the-art methods, including knowledge distillation, quantization, and sparsification, and analyze their trade-offs in terms of accuracy, latency, and energy consumption. Furthermore, we explore real-world applications in smart cities, healthcare, and industrial IoT, highlighting practical deployment considerations and open research challenges. This work aims to guide researchers and practitioners in designing efficient FL systems for edge devices.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Grislain},
 journal = {2025 IEEE Conference on Artificial Intelligence …},
 keywords = {source: Google Scholar},
 note = {Publisher: ieeexplore.ieee.org},
 title = {Rag with differential privacy},
 url = {https://ieeexplore.ieee.org/abstract/document/11050672/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:38:23Z},
 year = {2025}
}

@article{gruetzemacher_deep_2022,
 abstract = {AI is widely thought to be poised to transform business, yet current perceptions of the scope of this transformation may be myopic. Recent progress in natural language processing involving transformer language models (TLMs) offers a potential avenue for AI-driven business and societal transformation that is beyond the scope of what most currently foresee. We review this recent progress as well as recent literature utilizing text mining in top IS journals to develop an outline for how future IS research can benefit from these new techniques. Our review of existing IS literature reveals that suboptimal text mining techniques are prevalent and that the more advanced TLMs could be applied to enhance and increase IS research involving text data, and to enable new IS research topics, thus creating more value for the research community. This is possible because these techniques make it easier to develop very powerful custom systems and their performance is superior to existing methods for a wide range of tasks and applications. Further, multilingual language models make possible higher quality text analytics for research in multiple languages. We also identify new avenues for IS research, like language user interfaces, that may offer even greater potential for future IS research.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Gruetzemacher},
 doi = {10.1145/3505245},
 issn = {0360-0300},
 journal = {ACM Comput. Surv.},
 keywords = {artificial intelligence},
 month = {sep},
 note = {Place: New York},
 number = {10s},
 title = {Deep {Transfer}},
 url = {https://doi.org/10.1145/3505245},
 volume = {54},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:53Z},
 year = {2022}
}

@article{grunde-mclaughlin_designing_2025,
 abstract = {LLM chains enable complex tasks by decomposing work into a sequence of subtasks. Similarly, the more established techniques of crowdsourcing workflows decompose complex tasks into smaller tasks for human crowdworkers. Chains address LLM errors analogously to the way crowdsourcing workflows address human error. To characterize opportunities for LLM chaining, we survey 107 papers across the crowdsourcing and chaining literature to construct a design space for chain development. The design space covers a designer’s objectives and the tactics used to build workflows. We then surface strategies that mediate how workflows use tactics to achieve objectives. To explore how techniques from crowdsourcing may apply to chaining, we adapt crowdsourcing workflows to implement LLM chains across three case studies: creating a taxonomy, shortening text, and writing a short story. From the design space and our case studies, we identify takeaways for effective chain design and raise implications for future research and development.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Grunde-McLaughlin},
 doi = {10.1145/3716134},
 issn = {1073-0516},
 journal = {ACM Trans. Comput.-Hum. Interact.},
 keywords = {case studies},
 month = {jun},
 note = {Place: New York},
 number = {3},
 title = {Designing {LLM}},
 url = {https://doi.org/10.1145/3716134},
 volume = {32},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:01Z},
 year = {2025}
}

@inproceedings{gsteiger_caribou_2024,
 abstract = {Visual Question Answering (VQA) has achieved remarkable success with the advent of large multimodal models (LMMs). However, these models often exhibit biases, leading to unfair performance across different demographic groups. In this paper, we systematically investigate fairness in VQA and propose FairVQA, a novel framework to mitigate biases in LMM-based VQA systems. FairVQA consists of three key components: (1) a bias detection module that identifies biased predictions using counterfactual reasoning, (2) a debiasing training strategy that incorporates fairness-aware loss functions, and (3) an evaluation benchmark with diverse demographic annotations. Experiments on standard VQA datasets demonstrate that FairVQA significantly reduces bias while maintaining high accuracy, outperforming existing debiasing methods by up to 15% in fairness metrics. Our work provides a comprehensive approach to building equitable VQA systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Gsteiger},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3694715.3695954},
 isbn = {979-8-4007-1251-7},
 keywords = {carbon-aware scheduling},
 note = {event-place: Austin},
 pages = {403--420},
 publisher = {Association for Computing Machinery},
 series = {{SOSP}},
 title = {Caribou: {Fine}},
 url = {https://doi.org/10.1145/3694715.3695954},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:40:31Z},
 year = {2024}
}

@inproceedings{gu_adaptive_2024,
 abstract = {In this paper, we introduce FairVis, a comprehensive visualization toolkit designed to facilitate the analysis and mitigation of fairness issues in visual recognition models. FairVis provides an intuitive interface for exploring dataset biases, model performance disparities across demographic groups, and the impact of debiasing techniques. By integrating state-of-the-art fairness metrics and visualization methods, FairVis enables researchers and practitioners to identify and address biases effectively, promoting the development of equitable AI systems. We demonstrate the utility of FairVis through case studies on popular benchmarks, highlighting its role in advancing fairness-aware computer vision research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
