 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:31:21Z},
 year = {2025}
}

@inproceedings{weber_perses_2025,
 abstract = {The recent ubiquity of large language models (LLMs) in natural language processing (NLP) has led to an increase in research exploring their capabilities and limitations. However, evaluating LLMs is challenging due to their stochasticity, the need for diverse prompts, and the difficulty of interpreting results. We introduce ChainForge, a visual toolkit for building, running, and analyzing LLM pipelines. ChainForge provides a graphical interface for constructing complex prompt chains, running them on various LLMs, and visualizing the results. It supports hypothesis testing by allowing users to systematically vary prompts and model parameters. We demonstrate ChainForge's utility through case studies in prompt engineering, bias detection, and chain-of-thought reasoning. By lowering the barrier to LLM experimentation, ChainForge enables researchers and practitioners to more effectively explore the space of possible LLM behaviors.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
