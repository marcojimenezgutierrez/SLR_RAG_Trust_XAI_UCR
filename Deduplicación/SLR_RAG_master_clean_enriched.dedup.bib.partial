@article{jauhiainen_generative_2025,
 abstract = {This study explores the role of peer feedback in enhancing student engagement and learning outcomes in higher education. Drawing on a mixed-methods approach, data were collected from 150 undergraduate students across three disciplines. Quantitative analysis revealed a significant positive correlation between the frequency and quality of peer feedback and improvements in academic performance, while qualitative findings highlighted increased motivation and collaborative skills. The results suggest that structured peer feedback mechanisms can foster deeper learning, with implications for curriculum design and faculty development.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
