 series = {{ASE}},
 title = {Enabling {Cost}},
 url = {https://doi.org/10.1145/3691620.3695260},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:33:11Z},
 year = {2024}
}

@inproceedings{feng_forage_2025,
 abstract = {People with upper-body mobility impairments often face challenges in interacting with everyday objects and digital interfaces due to limited dexterity and strength. Wearable haptic devices can provide tactile feedback to enhance interaction capabilities, but existing designs rarely accommodate the diverse needs of this population. In this paper, we present a user-centered approach to designing personalized 3D-printed wearable haptic devices for individuals with upper limb mobility impairments. Through iterative workshops and co-design sessions with 15 participants, we identified critical design requirements, including modularity for customization, lightweight construction for comfort, and intuitive actuation mechanisms. We developed and evaluated prototypes that integrate vibration motors and pneumatic actuators, fabricated using accessible 3D printing techniques. User testing revealed high satisfaction with the devices' adaptability and effectiveness in tasks like object manipulation and gesture recognition. Our contributions include a set of design guidelines, open-source prototypes, and a framework for inclusive haptic device development, emphasizing accessibility and personalization to empower users in their daily activities.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
