@inproceedings{xu_generative_2025,
 abstract = {Virtual reality (VR) offers unique opportunities for collaborative creativity, yet understanding how teams ideate over multiple sessions in VR remains underexplored. We conducted a three-week field study with 12 dyads (N=24) who brainstormed ideas for a product design task across three sessions in either multi-session VR, single-session VR, or single-session desktop conditions. Our findings reveal that multi-session VR led to significantly more novel ideas compared to single-session conditions, with participants reporting higher engagement and immersion. However, it also induced greater fatigue and required more effort to maintain momentum across sessions. Through thematic analysis of session recordings and interviews, we identify key challenges, including cognitive load from re-immersion and idea continuity. We contribute design guidelines for supporting multi-session collaborative ideation in VR, such as adaptive onboarding, session bridging tools, and fatigue mitigation strategies, to enhance long-term creative collaboration in immersive environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Xu},
 booktitle = {Proceedings of the 2024 3rd {International}},
 doi = {10.1145/3722237.3722377},
 isbn = {979-8-4007-1269-2},
 keywords = {Digital Textbooks},
 pages = {802--806},
 publisher = {Association for Computing Machinery},
 series = {{ICAIE}},
 title = {Generative {Artificial}},
 url = {https://doi.org/10.1145/3722237.3722377},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:42:47Z},
 year = {2025}
}

@article{xu_generative_2025-1,
 abstract = {This chapter examines the role of blockchain technology in enhancing supply chain transparency and efficiency. Drawing on case studies from various industries, it discusses implementation challenges, benefits, and future implications for digital transformation in logistics. The analysis highlights how decentralized ledgers can mitigate risks associated with traditional supply chain models, fostering greater trust and sustainability.},
