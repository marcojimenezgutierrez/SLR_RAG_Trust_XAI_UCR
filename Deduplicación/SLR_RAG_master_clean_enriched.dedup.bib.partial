 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:17:19Z},
 year = {2025}
}

@article{kahl_evaluating_2024,
 abstract = {This chapter surveys recent advancements in explainable artificial intelligence (XAI) methods specifically tailored for tabular data, which remains a dominant data format in many real-world applications despite the prevalence of image and text data in XAI research. We categorize XAI approaches for tabular data into model-agnostic and model-specific methods, highlighting key techniques such as LIME, SHAP, and counterfactual explanations. Challenges unique to tabular data, including heterogeneity, missing values, and high dimensionality, are discussed, along with evaluation metrics and benchmarks. We also explore emerging trends like hybrid methods and integration with privacy-preserving techniques. The survey concludes with open research directions to enhance the interpretability and trustworthiness of AI models on tabular datasets.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
