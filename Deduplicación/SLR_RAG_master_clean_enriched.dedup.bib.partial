@inproceedings{shi_you_2025,
 abstract = {3D Gaussian Splatting (3DGS) has recently emerged as a promising approach for real-time neural rendering, offering high-quality view synthesis and fast training. However, current 3DGS-based methods face two critical limitations: 1) they are tailored for specific object categories, hindering generalization to arbitrary objects; 2) they are computationally intensive, impeding their use in real-time applications. To address these challenges, we propose GaussianFlow, a novel framework that enables generalizable and efficient 3DGS. Specifically, we introduce a flow-based 3D Gaussian representation that disentangles the 3D shape and appearance of objects, allowing for category-agnostic modeling. Furthermore, we design a lightweight neural renderer that leverages the flow representation to achieve real-time rendering speeds. Extensive experiments on diverse datasets demonstrate that GaussianFlow outperforms state-of-the-art methods in both generalization and efficiency, paving the way for practical 3DGS applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Shi},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730118},
