 keywords = {ChatGPT},
 note = {event-place: Lisbon},
 pages = {38--45},
 publisher = {Association for Computing Machinery},
 series = {{LLM4Code}},
 title = {{LLM}},
 url = {https://doi.org/10.1145/3643795.3648385},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:02:33Z},
 year = {2024}
}

@inproceedings{kraft_knowledge-enhanced_2024,
 abstract = {Human-AI collaboration is increasingly common, yet the role of silence in these interactions remains underexplored. In this paper, we investigate how silence affects user perceptions and behaviors in human-AI collaboration. Through a mixed-methods study involving 120 participants interacting with an AI collaborator in a creative task, we examine the effects of different types and durations of silence (e.g., short pauses, extended silences, and no silence). Our findings reveal that appropriate silences enhance user trust and perceived competence of the AI, while excessive silence leads to frustration and disengagement. Qualitative analysis highlights themes such as anticipation, reflection, and discomfort associated with silence. We discuss implications for designing more natural and effective AI systems that leverage silence strategically to improve collaboration outcomes.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Kraft},
 booktitle = {Proceedings of the 2024 {ACM}},
 doi = {10.1145/3630106.3658981},
 isbn = {979-8-4007-0450-5},
