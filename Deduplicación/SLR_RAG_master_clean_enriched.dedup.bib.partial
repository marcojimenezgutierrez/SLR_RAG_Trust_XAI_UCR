 note = {Type: Conference paper},
 title = {{IHILLM}},
 url = {https://doi.org/10.1117/12.3056789},
 volume = {13542},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:01:19Z},
 year = {2025}
}

@inproceedings{zhou_img2loc_2024,
 abstract = {Large language models (LLMs) have shown impressive abilities in generating code, but they often struggle with tasks requiring complex reasoning or multi-step planning. We introduce chain-of-thought (CoT) prompting, a method that elicits reasoning in LLMs by incorporating a few exemplars in the prompt that demonstrate step-by-step reasoning. On three arithmetic reasoning tasks, CoT prompting improves performance on all tasks by 10-40 percentage points, achieving state-of-the-art results on the GSM8K benchmark. Our analysis shows that CoT enables LLMs to explore and self-correct reasoning paths, leading to more accurate final answers. We further show that CoT works even with small models, and that scaling up the model size further amplifies the benefits of CoT.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhou},
 booktitle = {Proceedings of the 47th {International}},
 doi = {10.1145/3626772.3657673},
 img2loc not only surpasses the performance of previous state-of-the-art models but does so without any model training. a video demonstration of the system can be accessed via this link https://drive.google.com/file/d/16a6a-mc7ayuokhrh3\_wbrtorc13sn7tu/view?usp = {sharing}},
 isbn = {979-8-4007-0431-4},
 keywords = {image localization},
 note = {event-place: Washington DC},
 pages = {2749--2754},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{Img2Loc}},
 url = {https://doi.org/10.1145/3626772.3657673},
 x_enrich_source = {x-ai/grok-4-fast},
