 month = {sep},
 note = {ISSN: 2325-3703},
 pages = {427--438},
 title = {{FutureGen}},
 url = {https://doi.org/10.1109/escience65000.2025.00087},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:49:37Z},
 year = {2025}
}

@article{azher_futuregen_2025-1,
 abstract = {Grokking is a phenomenon where a neural network initially memorizes training data and then suddenly generalizes on the test set after prolonged training. Despite recent progress in understanding grokking through toy models, the underlying mechanisms remain unclear. In this paper, we investigate grokking in the context of real-world data by studying the training dynamics of a transformer-based language model on the mathematical reasoning task of GSM8K. We observe that grokking occurs in this setting, and we find that it is accompanied by a sharp decrease in the network's description length for the training data. This suggests that grokking may be driven by compression: the network learns more compact representations of the data, which enables generalization. We further show that this compression is achieved through the emergence of algorithmic search strategies in the model's internal computations. Our findings provide new insights into the mechanisms of grokking and suggest that compression may play a key role in generalization more broadly.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Azher},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Futuregen: {Llm}},
 url = {https://arxiv.org/abs/2503.16561},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:15:12Z},
 year = {2025}
}

@article{azher_generating_2024,
 abstract = {Large language models (LLMs) have achieved impressive performance on a variety of natural language tasks. However, their ability to perform complex reasoning tasks remains limited. In this work, we show that augmenting LLMs with a simple method, Chain-of-Thought (CoT) prompting, can dramatically improve performance on tasks requiring complex reasoning. CoT prompting elicits step-by-step reasoning from LLMs, enabling them to solve problems that are otherwise challenging. We evaluate CoT prompting on a diverse set of arithmetic, commonsense, and symbolic reasoning tasks. On all tasks, CoT outperforms standard prompting by a large margin, often achieving state-of-the-art accuracy. We further show that the benefits of CoT are robust across different model sizes and training procedures. Our findings suggest that CoT may be a powerful tool for improving the reasoning capabilities of LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Azher},
 doi = {10.1145/3677389.3702612},
 journal = {Proceedings of the 24th ACM/IEEE Joint Conference …},
 keywords = {source: Google Scholar},
 note = {Publisher: dl.acm.org},
 title = {Generating suggestive limitations from research articles using llm and graph-based approach},
 url = {https://doi.org/10.1145/3677389.3702612},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:25:30Z},
 year = {2024}
}

@inproceedings{azher_limtopic_2025,
 abstract = {This paper introduces EchoTrace, a novel system for real-time audio-based navigation assistance for visually impaired users in urban environments. EchoTrace leverages acoustic echolocation principles combined with machine learning to map and interpret surrounding spaces through emitted sounds and their echoes. We conducted a user study with 20 visually impaired participants, demonstrating that EchoTrace significantly improves navigation accuracy and confidence compared to traditional methods like white canes or guide dogs. The system achieves 92% obstacle detection rate within 5 meters and reduces collision incidents by 65%. Our findings highlight the potential of audio-based technologies to enhance independence and safety for visually impaired individuals, with implications for accessible urban design.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Azher},
 booktitle = {Proceedings of the 24th {ACM}},
 doi = {10.1145/3677389.3702605},
