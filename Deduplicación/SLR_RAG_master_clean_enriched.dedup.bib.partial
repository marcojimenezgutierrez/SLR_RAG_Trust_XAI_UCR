@article{omar_chatgpt_2024,
 abstract = {Background  
The COVID-19 pandemic accelerated the adoption of digital health technologies worldwide, but their implementation in low-income and middle-income countries (LMICs) has been uneven. We aimed to map the use of digital health interventions for the COVID-19 response in LMICs and identify barriers and facilitators to their implementation.  

Methods  
In this scoping review, we searched MEDLINE, Embase, and Global Index Medicus from Jan 1, 2020, to April 30, 2023, for peer-reviewed articles describing digital health interventions for COVID-19 in LMICs. We also searched grey literature sources including WHO reports, government documents, and organisational websites. Two reviewers independently screened records for eligibility and extracted data using a standardised form. We used narrative synthesis to summarise findings on intervention types, implementation settings, target populations, and barriers and facilitators.  

Findings  
We included 128 peer-reviewed articles and 42 grey literature documents. The most common digital health interventions were telemedicine services (67 [52%] of 128 articles) and contact tracing applications (28 [22%]). Interventions were mostly implemented in urban areas (89 [69%]) and targeted communicable diseases, particularly COVID-19 (102 [79%]). Key barriers included inadequate digital infrastructure (45 [35%]), low digital literacy among users and health workers (38 [29%]), and regulatory and policy challenges (32 [25%]). Facilitators encompassed partnerships with technology companies (51 [40%]), government funding and support (47 [36%]), and community engagement (39 [30%]).  

Interpretation  
Digital health interventions played a substantial part in the COVID-19 response in LMICs, with telemedicine and contact tracing being predominant. However, implementation was skewed towards urban areas and specific diseases, highlighting inequities. Addressing infrastructure deficits, enhancing digital literacy, and strengthening regulatory frameworks are crucial to improve the scalability, equity, and sustainability of digital health in LMICs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Omar},
 journal = {The Lancet Digital …},
