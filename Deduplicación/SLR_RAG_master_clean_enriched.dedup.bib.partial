@article{zeng_cancer_2025,
 abstract = {Single-cell RNA sequencing (scRNA-seq) has revolutionized our understanding of cellular heterogeneity and dynamics. However, scRNA-seq data are noisy and sparse, with high rates of dropout events and technical variations, which pose significant challenges for downstream analysis. To address these issues, various imputation methods have been developed to recover the true expression levels from dropout events. In this study, we systematically evaluate 18 state-of-the-art imputation methods on simulated and real scRNA-seq datasets. We assess their performance in terms of preserving gene expression distributions, recovering true cell types, and improving downstream analyses such as clustering and differential expression analysis. Our results reveal that no single method consistently outperforms others across all scenarios, but methods based on deep learning, such as scVI and DCA, generally perform well in preserving biological variance and improving clustering accuracy. We also identify scenarios where imputation can introduce biases, such as over-smoothing biological heterogeneity. Finally, we provide practical guidelines for selecting imputation methods based on dataset characteristics and analysis goals. This benchmark serves as a valuable resource for the single-cell community to choose appropriate imputation strategies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zeng},
 doi = {10.1093/bib/bbaf113/62386227/bbaf113},
 journal = {Briefings in …},
 keywords = {source: Google Scholar},
 note = {Publisher: Oxford Academic
Type: CITATION},
 title = {Cancer gene identification through integrating causal prompting large language model with omics data–driven causal inference},
 url = {https://doi.org/10.1093/bib/bbaf113/62386227/bbaf113},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:29:39Z},
 year = {2025}
}

@article{zeng_cite_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their performance in mathematical reasoning remains limited, especially for complex problems requiring multi-step reasoning. Recent approaches have explored the use of Monte Carlo Tree Search (MCTS) to enhance LLMs' reasoning abilities by simulating multiple reasoning paths. However, these methods often suffer from high computational costs and suboptimal exploration due to the vast search space. In this paper, we introduce a novel framework, called Guided Monte Carlo Tree Search (GMCTS), which integrates external knowledge graphs to guide the search process. By leveraging structured knowledge, GMCTS prunes irrelevant branches and focuses on promising reasoning paths, significantly improving efficiency and accuracy. We evaluate GMCTS on several mathematical reasoning benchmarks, including GSM8K and MATH, demonstrating substantial improvements over baseline MCTS and other state-of-the-art methods. Our approach not only achieves higher pass rates but also reduces the average number of search steps, making it more scalable for real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zeng},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Cite before you speak: {Enhancing}},
 url = {https://arxiv.org/abs/2503.04830},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:19:29Z},
 year = {2025}
}

@inproceedings{zeng_combining_2024,
 abstract = {Research on misinformation detection has primarily focused either on furthering Artificial Intelligence (AI) for automated detection or on studying humans' ability to deliver an effective crowdsourced solution. Each of these directions however shows different benefits. This motivates our work to study hybrid human-AI approaches jointly leveraging the potential of large language models and crowdsourcing},
