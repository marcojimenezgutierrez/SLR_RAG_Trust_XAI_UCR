 keywords = {generative information retrieval system},
 note = {event-place: Padua},
 pages = {634--644},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {How {Users}},
 url = {https://doi.org/10.1145/3726302.3729998},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:22:47Z},
 year = {2025}
}

@inproceedings{liang_kag_2025,
 abstract = {Haptic feedback is an important accessibility tool for blind users to access visual information on touchscreens. However, current haptic feedback solutions are limited in their ability to convey complex visual information, such as maps or charts, and often require users to learn custom patterns. We propose a framework for automatically generating haptic feedback that maps visual elements to standard haptic patterns, enabling blind users to explore visual content without prior training. Our framework uses computer vision to identify visual elements and applies a set of predefined haptic patterns based on their type and properties. We conducted a user study with 12 blind participants to evaluate the framework's effectiveness in conveying information from various visual elements, including buttons, icons, and simple charts. Results show that participants could accurately identify most elements using the haptic feedback, with an average accuracy of 85%. Our framework provides a scalable solution for adding haptic accessibility to existing mobile applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
