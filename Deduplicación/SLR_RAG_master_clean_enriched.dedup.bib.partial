 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:41:11Z},
 year = {2024}
}

@inproceedings{saha_ir_explain_2025,
 abstract = {Generative AI (GenAI) tools are increasingly integrated into software development workflows, yet their impact on developers' productivity and code quality remains underexplored. This paper presents a large-scale user study (N=4,071) of an AI-powered code editor, GitHub Copilot, in a real-world software engineering environment. We analyze usage patterns, productivity metrics, and code quality outcomes over a 12-week period, comparing AI-assisted and non-assisted coding sessions. Our findings reveal that Copilot users complete tasks 55% faster on average, with a 20% reduction in code errors, but also highlight challenges such as over-reliance on AI suggestions leading to subtle bugs in 15% of cases. We discuss implications for tool design, developer training, and future research on human-AI collaboration in software engineering.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
