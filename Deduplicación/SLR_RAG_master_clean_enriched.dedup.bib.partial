 year = {2024}
}

@inproceedings{wilhelm_how_2025,
 abstract = {Bite-Sized Science: Designing Mobile Experiences for Scientific Discovery

Scientific discovery is often inaccessible to the general public due to its complexity and the time required to engage with it. We present Bite-Sized Science, a mobile application that transforms scientific papers into interactive, bite-sized experiences to make discovery more engaging and accessible. Through a user study with 24 participants, we evaluate the design and its impact on user engagement, comprehension, and motivation. Our findings show that gamified elements and simplified visualizations significantly increase user interaction time and retention of key concepts compared to traditional reading. We discuss implications for designing inclusive science communication tools and future directions for AI-assisted content curation in mobile learning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wilhelm},
