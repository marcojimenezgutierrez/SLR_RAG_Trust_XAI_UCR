@article{ng_rag_2025,
 abstract = {Background: The design of clinical trials is a complex process that requires expertise across multiple domains, including medicine, statistics, ethics, and regulatory affairs. Generative artificial intelligence (AI) models have shown promise in assisting with various aspects of scientific research, but their application to clinical trial design remains underexplored.

Methods: We developed TrialGen, a generative AI system based on large language models fine-tuned on a corpus of clinical trial protocols. TrialGen generates complete trial protocols from high-level descriptions of the research question, population, intervention, and outcomes. We evaluated TrialGen on 50 de-identified real-world clinical trial protocols across diverse therapeutic areas (oncology, cardiology, neurology, and infectious diseases). Expert clinicians and trial designers (n=20) blindly assessed the generated protocols for completeness, scientific validity, ethical considerations, and feasibility using a standardized scoring rubric. We also measured efficiency by comparing the time required for human versus AI-assisted protocol development.

Results: TrialGen produced protocols that achieved a mean score of 8.2 out of 10 for overall quality, compared with 8.5 for human-written protocols (P=0.12). Strengths included rapid generation (average 15 minutes per protocol vs. 20-40 hours for humans) and comprehensive coverage of standard sections (e.g., inclusion/exclusion criteria, statistical analysis plans). Weaknesses were occasional inaccuracies in regulatory details and underemphasis on rare adverse events. Human-AI collaboration improved scores to 9.1 (P<0.001 vs. AI alone).

Conclusions: Generative AI, as exemplified by TrialGen, can substantially accelerate and enhance clinical trial protocol design, with potential to reduce costs and improve standardization. Further validation in prospective settings and integration with domain-specific knowledge bases are needed to address limitations and ensure safety. (Funded by the National Institutes of Health.)},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Ng},
 doi = {10.1056/AIra2400380},
 journal = {Nejm Ai},
 keywords = {source: Google Scholar},
 note = {Publisher: ai.nejm.org},
 title = {{RAG}},
 url = {https://doi.org/10.1056/aira2400380},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:22:14Z},
 year = {2025}
}

@article{ngandu_juro_2025,
 abstract = {Federated learning (FL) has emerged as a promising approach to enable collaborative machine learning across distributed devices while preserving data privacy. In this paper, we provide a comprehensive survey on FL, with a particular focus on its applications and challenges in the mobile era. We first introduce the basic concepts and architectures of FL, including horizontal, vertical, and federated transfer learning. Then, we discuss key challenges such as communication efficiency, data heterogeneity, model personalization, and privacy/security issues. To address these challenges, we review state-of-the-art techniques, including communication compression, heterogeneous model aggregation, and differential privacy mechanisms. Furthermore, we explore emerging applications of FL in mobile scenarios, such as mobile health, edge AI, and Internet of Things (IoT). Finally, we highlight open research directions and future trends in FL for mobile environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Ngandu},
 doi = {10.1007/978-3-031-94439-0_15},
