}

@inproceedings{ailapuram_development_2025,
 abstract = {Quick and accurate access to medical information is crucial for patients and healthcare professionals alike. Traditional search engines often fail to concise and context-specific responses to medical queries. This paper introduces a medical chatbot that combines large language models (LLMs) with retrieval-augmented generation (RAG) techniques to generate reliable and contextually relevant answers. The system integrates the Mistral-7B-Instructv0.3 model hosted on Hugging Face and uses Pinecone},
 author = {Ailapuram},
 booktitle = {2025 12th {International}},
 doi = {10.1109/FiCloud66139.2025.00068},
