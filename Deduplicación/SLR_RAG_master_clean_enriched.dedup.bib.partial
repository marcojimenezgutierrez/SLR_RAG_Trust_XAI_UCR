@inproceedings{khanal_fathomgpt_2024,
 abstract = {Visual Question Answering (VQA) is a challenging multimodal task that requires models to provide accurate answers to questions about images. Despite significant progress, current VQA models often exhibit biases, particularly in scenarios involving social attributes such as gender, race, and profession. These biases can lead to unfair and unreliable predictions, limiting the applicability of VQA in real-world settings. In this paper, we conduct a systematic analysis of bias in VQA models across multiple datasets and attribute categories. We identify key sources of bias and propose a novel framework, FairVQA, which integrates adversarial training and attribute-aware contrastive learning to mitigate these issues. Our approach not only reduces bias but also preserves or even improves overall VQA performance. Extensive experiments on benchmark datasets demonstrate the effectiveness of FairVQA in achieving fairer and more robust visual question answering.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Khanal},
 booktitle = {Proceedings of the 37th {Annual}},
 doi = {10.1145/3654777.3676462},
