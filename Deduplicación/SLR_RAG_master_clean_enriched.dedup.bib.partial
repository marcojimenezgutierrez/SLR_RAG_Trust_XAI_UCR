}

@inproceedings{xu_ckgfuzzer_2025,
 abstract = {Large Language Models (LLMs) have recently demonstrated remarkable capabilities in generating code. This has led to a surge in the usage of AI-generated code in software development. However, the implications of using such code are not yet fully understood. In this paper, we present a survey of 94 professional software developers to understand their experiences with AI-generated code. We find that developers are using AI-generated code for a variety of tasks, including code completion, bug fixing, and code review. However, they also report several challenges, such as the code being incorrect, inefficient, or not following best practices. Our findings suggest that while AI-generated code can be a valuable tool for developers, it is important to carefully review and test the code before using it in production.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
