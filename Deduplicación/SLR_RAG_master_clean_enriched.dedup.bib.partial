 keywords = {large language models (LLMs)},
 note = {event-place: São Francisco Convent},
 pages = {347--362},
 publisher = {Association for Computing Machinery},
 series = {{SIGCOMM}},
 title = {Intent-{Driven}},
 url = {https://doi.org/10.1145/3718958.3750537},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:40:19Z},
 year = {2025}
}

@inproceedings{wang_international_2024,
 abstract = {Data-centric AI has shown great progress in improving model performance. However, the improvements are often marginal and inconsistent across different datasets. In this paper, we propose a new perspective on data-centric AI: instead of focusing on improving individual data points, we focus on improving the overall data quality by identifying and removing low-quality data. We introduce a novel framework called DataPruner, which uses a learnable scoring function to identify and prune low-quality data points. DataPruner consists of two components: (1) a data scorer that learns to score data points based on their contribution to model performance, and (2) a pruner that removes the lowest-scoring data points. We evaluate DataPruner on several benchmarks and show that it consistently improves model performance by removing only a small fraction of the data. Our results suggest that data pruning is a promising direction for data-centric AI.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wang},
 booktitle = {Proceedings of the 33rd {ACM}},
