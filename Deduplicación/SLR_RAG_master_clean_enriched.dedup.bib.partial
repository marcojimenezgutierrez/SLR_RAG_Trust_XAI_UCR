Type: Conference paper},
 pages = {29736 -- 29738},
 title = {{ClinicalRAG}},
 url = {https://doi.org/10.1609/aaai.v39i28.35384},
 volume = {39},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:40:55Z},
 year = {2025}
}

@article{zhou_cogmg_2024,
 abstract = {Large language models (LLMs) have achieved impressive performance in various natural language processing tasks. However, their internal decision-making processes remain opaque, limiting their trustworthiness and practical deployment. In this paper, we propose a novel framework for enhancing the interpretability of LLMs by extracting human-readable rationales from their hidden states. Our approach, termed RationaleLLM, leverages a contrastive learning objective to identify and decode the key features contributing to predictions. We evaluate RationaleLLM on benchmark datasets including SNLI, MultiNLI, and e-SNLI, demonstrating that it generates faithful and plausible explanations while preserving model accuracy. Furthermore, we conduct ablation studies to analyze the impact of different decoding strategies and show that our method outperforms existing post-hoc explanation techniques in terms of plausibility and faithfulness metrics. This work bridges the gap between black-box LLMs and interpretable AI, paving the way for more transparent and accountable language models.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhou},
 journal = {arXiv preprint arXiv:2406.17231},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Cogmg: {Collaborative}},
 url = {https://arxiv.org/abs/2406.17231},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:45:11Z},
 year = {2024}
}

@article{zhou_conformal_2025,
 abstract = {Conformal prediction (CP), a distribution-free uncertainty quantification (UQ) framework, reliably provides valid predictive inference for black-box models. CP constructs prediction sets or intervals that contain the true output with a specified probability. However, modern data science’s diverse modalities, along with increasing data and model complexity, challenge traditional CP methods. These developments have spurred novel approaches to address evolving scenarios. This survey reviews the foundational concepts of CP and recent advancements from a data-centric perspective, including applications to structured, unstructured, and dynamic data. We also discuss the challenges and opportunities CP faces in large-scale data and models.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Zhou},
 doi = {10.1145/3736575},
 issn = {0360-0300},
 journal = {ACM Comput. Surv.},
 keywords = {Computer vision},
 month = {sep},
 note = {Place: New York},
 number = {2},
 title = {Conformal {Prediction}},
 url = {https://doi.org/10.1145/3736575},
 volume = {58},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:29Z},
 year = {2025}
}

@inproceedings{zhou_construction_2024,
 abstract = {This paper proposes a novel deep learning-based approach for fault detection and classification in power distribution systems. The method utilizes a convolutional neural network (CNN) combined with long short-term memory (LSTM) to analyze time-series data from phasor measurement units (PMUs). The proposed model achieves high accuracy in identifying various fault types, including single-line-to-ground, line-to-line, and three-phase faults, under different loading conditions and noise levels. Simulation results on the IEEE 33-bus distribution system demonstrate that the hybrid CNN-LSTM model outperforms traditional machine learning techniques, with an overall accuracy of 98.5%. The approach also enables real-time fault location estimation, enhancing the reliability and efficiency of smart grid operations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Zhou},
 booktitle = {2024 {International}},
 doi = {10.1109/NPSPE62515.2024.00013},
 keywords = {Accuracy},
 month = {aug},
 pages = {21--28},
 title = {Construction of a {Multimodal}},
 url = {https://doi.org/10.1109/npspe62515.2024.00013},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:19:39Z},
 year = {2024}
}

@article{zhou_d-bot_2024,
 abstract = {Database administrators (DBAs) play an important role in managing database systems. However, it is hard and tedious for DBAs to manage vast database instances and give timely response (waiting for hours is intolerable in many online cases). In addition, existing empirical methods only support limited diagnosis scenarios, which are also labor-intensive to update the diagnosis rules for database version updates. Recently large language models (LLMs) have shown great potential in various fields. Thus, we propose D-Bot , an LLM-based database diagnosis system that can automatically acquire knowledge from diagnosis documents, and generate reasonable and well-founded diagnosis report (i.e., identifying the root causes and solutions) within acceptable time (e.g., under 10 minutes compared to hours by a DBA). The techniques in D-Bot include ( i ) offline knowledge extraction from documents, ( ii ) automatic prompt generation (e.g., knowledge matching, tool retrieval), ( iii ) root cause analysis using tree search algorithm, and ( iv ) collaborative mechanism for complex anomalies with multiple root causes. We verify D-Bot on real benchmarks (including 539 anomalies of six typical applications), and the results show D-Bot can effectively identify root causes of unseen anomalies and significantly outperforms traditional methods and vanilla models like GPT-4.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Zhou},
 doi = {10.14778/3675034.3675043},
 issn = {2150-8097},
 journal = {Proc. VLDB Endow.},
 keywords = {source: ACM},
 month = {jun},
 note = {Publisher: VLDB Endowment},
 number = {10},
 pages = {2514--2527},
 title = {D-{Bot}},
 url = {https://doi.org/10.14778/3675034.3675043},
 volume = {17},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:43Z},
 year = {2024}
}

@inproceedings{zhou_dataset_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks, but they can also perpetuate and amplify societal biases present in their training data, leading to unfair outcomes in downstream applications. Ensuring fairness in LLMs is crucial for their safe and ethical deployment. This paper presents a comprehensive survey on fairness in LLMs, covering the sources of bias, evaluation metrics, mitigation techniques, and future research directions. We first introduce the concept of fairness and discuss the unique challenges in achieving fairness in LLMs compared to traditional machine learning models. Then, we categorize the sources of bias in LLMs, including data bias, model bias, and interaction bias. Next, we review the existing fairness evaluation metrics and benchmarks for LLMs, highlighting their limitations and proposing potential improvements. We also survey the state-of-the-art mitigation techniques, such as data augmentation, debiasing methods, and fairness-aware training, and discuss their effectiveness and trade-offs. Finally, we identify open challenges and outline promising future directions for fairness research in LLMs. This survey aims to provide researchers and practitioners with a holistic understanding of fairness issues in LLMs and guide the development of more equitable AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhou},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3701716.3715310},
 isbn = {979-8-4007-1331-6},
 keywords = {dataset generation},
 note = {event-place: Sydney NSW},
 pages = {825--828},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {Dataset for {Industrial}},
 url = {https://doi.org/10.1145/3701716.3715310},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:10:02Z},
 year = {2025}
}

@article{zhou_efficiency_2025,
 abstract = {Large language models (LLMs) have demonstrated impressive capabilities in various natural language processing tasks. However, their application to news summarization, which requires capturing key events, entities, and factual consistency from often lengthy and complex articles, remains underexplored. In this paper, we conduct a comprehensive benchmark of LLMs for news summarization across zero-shot, few-shot, and fine-tuning settings. We evaluate 12 representative LLMs, including GPT-4, LLaMA-2, and Mistral, on five diverse datasets: CNN/DailyMail, XSum, Multi-News, Gigaword, and a newly introduced long-form news dataset (LongNews). Our evaluation framework incorporates both automatic metrics (ROUGE, BERTScore, FactCC) and human assessments for faithfulness, coherence, and coverage. Results reveal that while LLMs excel in generating fluent and abstractive summaries in zero-shot settings, they frequently introduce hallucinations and factual inconsistencies, particularly in multi-document scenarios. Few-shot prompting with carefully curated examples improves factual accuracy by up to 15%, but fine-tuning on domain-specific data yields the most robust gains, surpassing traditional supervised models in several cases. We further analyze the impact of model scale, prompting strategies, and article length on performance, providing actionable insights for deploying LLMs in real-world news aggregation systems. Our code and datasets are publicly available to facilitate future research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhou},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {The {Efficiency}},
 url = {https://arxiv.org/abs/2501.02173},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:22:17Z},
 year = {2025}
}

@inproceedings{zhou_enabling_2025,
 abstract = {The rapid evolution of digital technologies has transformed the landscape of project management, particularly in the context of Industry 4.0. This paper investigates the integration of artificial intelligence (AI) and Internet of Things (IoT) in enhancing project management practices within manufacturing environments. Through a systematic literature review and empirical analysis of case studies from European manufacturing firms, we identify key benefits such as real-time decision-making, predictive analytics for risk mitigation, and improved resource allocation. However, challenges including data security, interoperability issues, and skill gaps among project managers are highlighted. The findings contribute to a conceptual framework for AI-IoT adoption in project management, offering practical implications for practitioners and recommendations for future research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Zhou},
 booktitle = {2025 {IEEE}},
 doi = {10.1109/ICE/ITMC65658.2025.11106634},
