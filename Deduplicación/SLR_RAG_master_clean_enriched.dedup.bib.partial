 title = {Enhancing {Automated}},
 url = {https://doi.org/10.1145/3691620.3695537},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:36:16Z},
 year = {2024}
}

@inproceedings{zhao_explainable_2025,
 abstract = {Visual programming languages (VPLs) have long been proposed as a way to make programming more accessible to non-programmers. However, their adoption has been limited, particularly in the context of interactive data visualization (IDV), where the complexity of visual encodings and interactions poses unique challenges. In this paper, we explore the design space of VPLs for IDV through the development and evaluation of VisFlow, a novel VPL that integrates visual programming with direct manipulation of visualizations. We conducted a user study with 24 participants, including both novices and experts in data visualization, to assess VisFlow's usability, expressiveness, and effectiveness compared to traditional coding and existing VPLs. Our findings reveal that VisFlow significantly reduces the cognitive load for creating complex visualizations while maintaining the flexibility needed for expert users. We discuss implications for the design of future VPLs in IDV and provide guidelines for balancing accessibility and power in visual programming environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhao},
 booktitle = {Companion {Proceedings}},
