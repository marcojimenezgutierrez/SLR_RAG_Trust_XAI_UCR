}

@inproceedings{mahalingam_sketch_2025,
 abstract = {The rapid development of information technology has led to the generation of massive amounts of data, which brings new opportunities and challenges to various fields. In the field of education, educational data mining (EDM) has become an important research direction. This paper proposes a personalized learning recommendation system based on deep learning and knowledge graph. First, we construct a knowledge graph of educational resources, which includes the knowledge points, difficulty levels, and learner profiles. Then, we use a deep neural network to learn the embedding representations of learners and resources from the interaction data. Finally, we design a recommendation model that combines the attention mechanism and graph convolutional network to generate personalized recommendations. Experimental results on real datasets show that our system outperforms the baseline methods in terms of accuracy, recall, and F1-score.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
