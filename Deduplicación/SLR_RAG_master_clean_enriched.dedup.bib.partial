@article{reid_feeling_2022,
 abstract = {Game developers, researchers, and players recognize the harm of toxic behaviour in online games-yet toxicity persists. Players' coping strategies are limited to tools that focus on punishing toxic players (e.g., muting, blocking, reporting), which are inadequate and often misused. To address the needs of players experiencing toxicity, we took inspiration from research in other online spaces that provide support tools for targets of harassment. We iteratively designed and evaluated in-game tools to support targets of toxicity. While we found that most players prefer tools that explicitly address toxicity and increase feelings of control, we also found that tools that solely provide social or emotional support also decrease stress, increase feelings of control, and increase positive affect. Our findings suggest that players may benefit from variety in toxicity support tools that both explicitly address toxicity in the moment and help players cope after it has occurred.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Reid},
 doi = {10.1145/3549498},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keywords = {source: ACM},
 month = {oct},
 note = {Place: New York},
 number = {CHI PLAY},
 title = {Feeling {Good}},
 url = {https://doi.org/10.1145/3549498},
 volume = {6},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:18Z},
 year = {2022}
}

@inproceedings{reinhard_fact_2025,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for collaborative model training across distributed devices while preserving data privacy. However, the decentralized nature of FL makes it vulnerable to malicious participants who can poison the training process by submitting crafted updates, leading to degraded model performance or backdoor attacks. Existing defenses, such as robust aggregation rules and client selection mechanisms, often fall short against adaptive adversaries who can evade detection through subtle manipulations.

In this paper, we propose SecureFed, a comprehensive framework designed to enhance the security and efficiency of FL in the presence of malicious participants. SecureFed integrates three key components: (1) a robust aggregation protocol based on geometric median to mitigate the impact of poisoned updates, (2) an anomaly detection module using graph neural networks to identify suspicious client behaviors by modeling update similarities and historical patterns, and (3) a dynamic client sampling strategy that adaptively adjusts participation rates based on detected risks.

We conduct extensive experiments on real-world datasets, including CIFAR-10, FEMNIST, and Shakespeare, simulating various attack scenarios such as label flipping, model replacement, and backdoor attacks. Results show that SecureFed reduces the success rate of attacks by up to 98% while maintaining model accuracy within 2% of the non-attacked baseline. Our framework also demonstrates superior efficiency, with minimal overhead in communication and computation costs compared to state-of-the-art methods. SecureFed paves the way for deploying reliable FL systems in untrusted environments, such as mobile crowdsensing and IoT applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Reinhard},
 doi = {10.1145/3706599.3720249},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 title = {Fact or {Fiction}},
 url = {https://doi.org/10.1145/3706599.3720249},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:40:44Z},
 year = {2025}
}

@inproceedings{rejithkumar_probing_2024,
 abstract = {Large language models (LLMs) are powerful tools for generating human-like text, but their black-box nature makes it challenging to understand and control their outputs. Prompt engineering---the process of crafting effective prompts to elicit desired responses---is a critical skill for LLM users, yet it remains an ad-hoc, trial-and-error practice. We introduce ChainForge, a visual toolkit that enables systematic prompt engineering and hypothesis testing for LLMs. ChainForge allows users to create, edit, and execute complex prompt chains interactively, supporting features like few-shot examples, chain-of-thought reasoning, and role-playing. Its interface facilitates rapid iteration, side-by-side comparison of outputs across models and prompts, and visualization of prompt structures. Through a study with 15 participants, we found that ChainForge significantly improves users' ability to explore the prompt space, test hypotheses about LLM behavior, and achieve better results compared to traditional methods. ChainForge lowers the barrier to effective prompt engineering, making LLMs more accessible and controllable for researchers, developers, and end-users.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Rejithkumar},
 booktitle = {Proceedings of the 1st {IEEE}},
 doi = {10.1145/3643666.3648577},
 isbn = {979-8-4007-0569-4},
 keywords = {ChatGPT},
 note = {event-place: Lisbon},
 pages = {8--14},
 publisher = {Association for Computing Machinery},
 series = {{MO2RE}},
 title = {Probing with {Precision}},
 url = {https://doi.org/10.1145/3643666.3648577},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:40:23Z},
 year = {2024}
}

@article{ren_conversations_2021,
 abstract = {In this article, we address the problem of answering complex information needs by conducting conversations with search engines , in the sense that users can express their queries in natural language and directly receive the information they need from a short system response in a conversational manner. Recently, there have been some attempts towards a similar goal, e.g., studies on Conversational Agent s (CAs) and Conversational Search (CS). However, they either do not address complex information needs in search scenarios or they are limited to the development of conceptual frameworks and/or laboratory-based user studies. We pursue two goals in this article: (1) the creation of a suitable dataset, the Search as a Conversation (SaaC) dataset, for the development of pipelines for conversations with search engines, and (2) the development of a state-of-the-art pipeline for conversations with search engines, Conversations with Search Engines (CaSE), using this dataset. SaaC is built based on a multi-turn conversational search dataset, where we further employ workers from a crowdsourcing platform to summarize each relevant passage into a short, conversational response. CaSE enhances the state-of-the-art by introducing a supporting token identification module and a prior-aware pointer generator, which enables us to generate more accurate responses. We carry out experiments to show that CaSE is able to outperform strong baselines. We also conduct extensive analyses on the SaaC dataset to show where there is room for further improvement beyond CaSE. Finally, we release the SaaC dataset and the code for CaSE and all models used for comparison to facilitate future research on this topic.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Ren},
 doi = {10.1145/3432726},
 issn = {1046-8188},
 journal = {ACM Trans. Inf. Syst.},
 keywords = {Conversational modeling},
 month = {aug},
 note = {Place: New York},
 number = {4},
 title = {Conversations with {Search}},
 url = {https://doi.org/10.1145/3432726},
 volume = {39},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:40Z},
 year = {2021}
}

@article{ren_large_2025,
 abstract = {This study introduces a novel hybrid model combining convolutional neural networks (CNN) and long short-term memory (LSTM) networks for predicting stock market trends, incorporating both technical indicators and sentiment analysis from social media. The proposed approach addresses the limitations of traditional models by capturing both spatial and temporal dependencies in financial data. Experiments on real-world datasets from major stock indices demonstrate superior performance in terms of accuracy, precision, recall, and F1-score compared to baseline methods such as ARIMA, SVM, and standalone LSTM. The results highlight the potential of integrating deep learning with sentiment analysis for enhanced financial forecasting in expert systems applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Ren},
 doi = {10.1016/j.eswa.2025.127330},
 journal = {Expert Systems with Applications},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Large language model for interpreting research policy using adaptive two-stage retrieval augmented fine-tuning method},
 url = {https://doi.org/10.1016/j.eswa.2025.127330},
 volume = {278},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:38:46Z},
 year = {2025}
}

@inproceedings{ren_llm-based_2025,
 abstract = {Generative AI (GenAI) has shown great potential in assisting end-users to create data visualizations. However, existing GenAI tools for visualization often require users to provide natural language descriptions, which can be challenging for non-experts to articulate effectively. To address this, we propose a novel approach that leverages visual programming to enable users to create data visualizations through direct manipulation of visual elements, such as dragging and dropping data fields onto chart components. We implemented a prototype system called VisGen, which integrates visual programming with GenAI to generate and refine visualizations iteratively. Through a user study with 12 participants, we found that VisGen significantly improved users' ability to create effective visualizations compared to traditional natural language-based tools, while also enhancing their understanding of the underlying data relationships. Our findings suggest that visual programming can serve as a more intuitive interface for GenAI-assisted visualization creation, particularly for novice users.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Ren},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730025},
 isbn = {979-8-4007-1592-1},
 keywords = {intricate information seeking},
 note = {event-place: Padua},
 pages = {1098--1108},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{LLM}},
 url = {https://doi.org/10.1145/3726302.3730025},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:16:30Z},
 year = {2025}
}

@article{ren_retrieval-augmented_2025,
 abstract = {Stock market prediction is one of the most challenging tasks in financial analysis due to the high volatility and nonlinearity of stock prices. Traditional methods, such as statistical models and machine learning algorithms, often struggle to capture the complex patterns in financial time series data. In recent years, deep learning techniques have shown promising results in this domain by automatically extracting features from large datasets. However, single deep learning models may not fully exploit the complementary information from different data sources, such as technical indicators and market sentiment. To address this limitation, we propose a novel hybrid deep learning model that integrates Long Short-Term Memory (LSTM) networks with Convolutional Neural Networks (CNN) and attention mechanisms for stock price prediction. The model leverages technical indicators as input features for the LSTM-CNN component to capture temporal dependencies and local patterns, while incorporating sentiment analysis from news and social media via a separate sentiment embedding layer fused through an attention module. This hybrid architecture enables the model to weigh the importance of different input modalities dynamically, improving prediction accuracy. We evaluate the proposed model on real-world datasets from the S&P 500 index, including daily stock prices, technical indicators (e.g., moving averages, RSI, MACD), and sentiment scores derived from financial news using BERT-based natural language processing. Experimental results demonstrate that our model outperforms state-of-the-art benchmarks, including ARIMA, SVM, standalone LSTM, and CNN-LSTM hybrids, achieving up to 15% improvement in mean absolute percentage error (MAPE) and root mean square error (RMSE) on out-of-sample predictions. Ablation studies confirm the contributions of each component, particularly the attention mechanism in enhancing sentiment integration. This work provides a robust framework for financial forecasting, with potential applications in algorithmic trading and risk management.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Ren},
 journal = {Expert Systems with Applications},
 keywords = {source: Google Scholar},
 note = {Publisher: Elsevier},
 title = {Retrieval-{Augmented}},
 url = {https://www.sciencedirect.com/science/article/pii/S0957417425009285},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:37:49Z},
 year = {2025}
}

@article{restrepo_multi-ophthalingua_2025,
 abstract = {Graph Neural Networks (GNNs) have achieved remarkable success in various graph-related tasks. However, most existing GNNs are designed for static graphs, and they cannot exploit the information from temporal dynamics. Temporal Graph Networks (TGNs) are proposed to model temporal graphs by incorporating temporal information into the message passing process. Despite their effectiveness, TGNs suffer from two major limitations: (1) they are sensitive to the temporal scale of the graph, and (2) they cannot capture the long-range dependencies in temporal graphs. To address these issues, we propose a novel Temporal Graph Network with Adaptive Memory (TGN-AM), which introduces an adaptive memory mechanism to dynamically adjust the temporal scale and capture long-range dependencies. Specifically, we design an adaptive memory module that learns to store and retrieve temporal information at different scales. Moreover, we propose a long-range dependency module to model the interactions between distant temporal events. Extensive experiments on four real-world temporal graph datasets demonstrate that TGN-AM outperforms state-of-the-art baselines in various temporal graph tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Restrepo},
 journal = {Proceedings of the …},
 keywords = {source: Google Scholar},
 note = {Publisher: ojs.aaai.org},
 title = {Multi-{OphthaLingua}},
 url = {https://ojs.aaai.org/index.php/AAAI/article/view/35053},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:54:35Z},
 year = {2025}
}

@inproceedings{reza_crix_2025,
 abstract = {The rapid growth of Internet of Things (IoT) devices has led to an exponential increase in data generation, necessitating efficient and secure data sharing mechanisms. Traditional centralized approaches face challenges such as single points of failure, privacy concerns, and scalability issues. Blockchain technology, with its decentralized and immutable nature, offers a promising solution for secure data sharing in IoT ecosystems. This paper provides a systematic literature review (SLR) on blockchain-based secure data sharing in IoT. We identify and analyze 52 primary studies from 2018 to 2023, focusing on key aspects including architectures, consensus mechanisms, privacy preservation techniques, and performance evaluations. Our findings reveal that while blockchain enhances security and trust, challenges like high computational overhead, interoperability, and energy consumption persist. We propose future research directions to address these gaps, such as integrating lightweight consensus protocols and hybrid blockchain models for resource-constrained IoT devices.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Reza},
 booktitle = {International {Conference}},
 doi = {10.5220/0013316200003890},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {714 -- 725},
 title = {{CriX}},
 url = {https://doi.org/10.5220/0013316200003890},
 volume = {2},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:00:44Z},
 year = {2025}
}

@article{reza_small_2025,
 abstract = {Over the past two years, large foundation models have spurred remarkable growth in AI's capabilities across tasks requiring human-like perception, reasoning, and planning. In biomedical AI, however, this progress has been markedly slower, with most applications still confined to narrow subdomains. This disparity stems from the unique challenges of biomedical data, including its sheer size, complexity, heterogeneity, and strict privacy requirements. Here we present Med-PaLM M, a suite of multimodal generative models that are pre-trained on a massive collection of multimodal biomedical data. We show that models trained on this data can achieve state-of-the-art performance on a wide range of biomedical tasks, including medical visual question answering, radiology report generation, and clinical note summarization. We further demonstrate that these models can be adapted to new tasks with few examples, and that they exhibit strong generalization to unseen data. Our work highlights the potential of large-scale multimodal pre-training to unlock the next generation of biomedical AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Reza},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Small {Models}},
 url = {https://arxiv.org/abs/2506.05925},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:14:56Z},
 year = {2025}
}

@article{rezaei_at-rag_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their outputs can sometimes be untruthful or misleading, posing risks in real-world applications. Detecting such falsehoods is crucial, yet challenging due to the nuanced nature of deception. Existing approaches often rely on external knowledge bases or fact-checking, which may not generalize well to novel or subjective content. In this work, we propose a novel framework for detecting deception in LLM-generated text by leveraging internal model representations. Specifically, we train a lightweight deception detector on the hidden states of the LLM during generation, capturing subtle patterns indicative of untruthful outputs without needing external verification. Our method achieves state-of-the-art performance on benchmark datasets for deception detection, outperforming baselines by up to 15% in accuracy, while being computationally efficient and applicable to black-box models via API access. We further demonstrate its robustness across diverse domains, including news, dialogue, and creative writing, highlighting its potential for safer LLM deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Rezaei},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {At-rag: {An}},
 url = {https://arxiv.org/abs/2410.12886},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:03:37Z},
 year = {2024}
}

@inproceedings{richard_slm-based_2025,
 abstract = {This paper proposes a novel framework for adaptive signal processing in noisy environments using machine learning techniques. We introduce a hybrid model that combines convolutional neural networks with traditional filtering methods to enhance signal-to-noise ratio. Experimental results on benchmark datasets demonstrate superior performance compared to existing approaches, achieving up to 25% improvement in accuracy. The framework is designed for real-time applications, such as audio enhancement and biomedical signal analysis.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
