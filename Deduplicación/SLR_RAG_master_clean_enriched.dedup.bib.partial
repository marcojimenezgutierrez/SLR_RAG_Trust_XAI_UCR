@article{al-qatf_rag4ds_2025,
 abstract = {This paper proposes a novel framework for enhancing cybersecurity in IoT environments using machine learning techniques. We introduce a hybrid model that combines convolutional neural networks (CNNs) with long short-term memory (LSTM) networks to detect anomalous behaviors in real-time. The proposed approach is evaluated on benchmark datasets, demonstrating superior performance in terms of accuracy, precision, and recall compared to existing methods. Experimental results show a detection rate of 98.5% with minimal false positives, making it suitable for resource-constrained IoT devices.},
