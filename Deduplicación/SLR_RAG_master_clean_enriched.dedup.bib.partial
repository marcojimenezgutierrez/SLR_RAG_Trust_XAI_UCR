@inproceedings{lin_knowledge-injected_2024,
 abstract = {Visual programming languages (VPLs) promise to make programming more accessible, especially for tasks like data processing. However, their design space for interactive data processing remains underexplored. We present a design framework that identifies key dimensions of VPL design for data processing, including data representation, interaction techniques, and computation models. Using this framework, we analyze 12 existing VPLs and prototype three new VPLs that explore novel points in the design space. Through a user study with 24 participants, we evaluate these prototypes and find that designs emphasizing direct manipulation and visual feedback improve task performance and user satisfaction. Our work contributes a structured approach to VPL design and highlights opportunities for future systems that better support interactive data processing.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
