 year = {2025}
}

@inproceedings{mestre_ragnar_2024,
 abstract = {With the rapid development of artificial intelligence technology, the application of deep learning in various fields has become more and more extensive. However, deep learning models are often faced with the problem of insufficient training data. Data augmentation is an effective method to solve this problem. In this paper, we propose a novel data augmentation method based on generative adversarial networks (GANs) for image classification tasks. Our method generates high-quality synthetic images that are diverse and realistic, which can effectively improve the performance of deep learning models. Experimental results on several benchmark datasets demonstrate the effectiveness of our proposed method.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
