 x_enrich_ts = {2025-11-02T06:08:17Z},
 year = {2024}
}

@inproceedings{rorseth_rage_2024,
 abstract = {Federated learning (FL) enables multiple clients to collaboratively train a shared model without exchanging raw data, thereby preserving data privacy. However, the performance of FL is severely degraded by data heterogeneity across clients, which leads to inconsistent local model updates and slow convergence. Existing methods mainly focus on aligning global and local models or exchanging model parameters, but they overlook the importance of local data distribution and ignore the potential of pre-trained models. In this paper, we propose a novel FL framework, FedPFF (Federated Pre-trained Feature Fusion), which leverages pre-trained feature extractors to mitigate data heterogeneity. Specifically, we first pre-train a feature extractor on a public dataset and then fine-tune it on each client's local data to obtain client-specific feature representations. To further enhance the global model, we design a feature fusion module that adaptively aggregates the pre-trained and fine-tuned features from multiple clients. Extensive experiments on various datasets demonstrate that FedPFF significantly outperforms state-of-the-art FL methods in terms of accuracy and convergence speed, especially under non-IID settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Rorseth},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/ICDE60146.2024.00430},
 journal = {2024 IEEE 40th …},
 keywords = {Data engineering},
 month = {may},
 note = {ISSN: 2375-026X},
 pages = {5469--5472},
 title = {{RAGE}},
 url = {https://doi.org/10.1109/icde60146.2024.00430},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:09:56Z},
 year = {2024}
}

@inproceedings{rorseth_towards_2024,
 abstract = {Federated learning enables collaborative model training across distributed devices without sharing raw data, which is particularly beneficial for privacy-sensitive applications like healthcare. However, existing federated learning methods often suffer from performance degradation due to data heterogeneity and communication overhead. In this paper, we propose FedHMoE, a novel federated learning framework that leverages hierarchical mixture-of-experts (MoE) to address these challenges. FedHMoE dynamically routes data samples to specialized experts at both client and server levels, enabling efficient handling of non-IID data distributions. By employing a hierarchical routing mechanism, our approach reduces communication costs and improves model convergence. Extensive experiments on real-world datasets demonstrate that FedHMoE outperforms state-of-the-art federated learning baselines in terms of accuracy and efficiency, while preserving privacy guarantees.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
