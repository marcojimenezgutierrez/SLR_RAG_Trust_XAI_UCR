 keywords = {generative ai search},
 note = {event-place: Padua},
 pages = {3922--3931},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{NExT}},
 url = {https://doi.org/10.1145/3726302.3730353},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:22:32Z},
 year = {2025}
}

@article{dakshit_faculty_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their performance can be inconsistent across diverse tasks and domains. To address this, we propose a novel framework called LLM-Augmented Ensemble (LAE), which leverages the strengths of multiple LLMs to enhance overall performance. LAE integrates predictions from several LLMs using a dynamic weighting mechanism that adapts based on task-specific confidence scores. Our approach not only improves accuracy but also reduces variance in outputs, making it particularly suitable for real-world applications where reliability is crucial. Experimental results on benchmark datasets demonstrate that LAE outperforms individual LLMs and traditional ensemble methods, achieving up to 15% improvement in key metrics.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
