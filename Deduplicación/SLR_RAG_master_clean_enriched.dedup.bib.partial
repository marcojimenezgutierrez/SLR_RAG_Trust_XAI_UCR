 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:04:52Z},
 year = {2024}
}

@article{song_travelrag_2024,
 abstract = {A novel framework called TravelRAG is introduced in this paper, which is built upon a large language model (LLM) and integrates Retrieval-Augmented Generation (RAG) with knowledge graphs to create a retrieval system framework designed for the tourism domain. This framework seeks to address the challenges LLMs face in providing precise and contextually appropriate responses to domain-specific queries in the tourism field. TravelRAG extracts information related to tourist attractions from User-Generated Content (UGC) on social media platforms and organizes it into a multi-layer knowledge graph. The travel knowledge graph serves as the core retrieval source for the LLM, enhancing the accuracy of information retrieval and significantly reducing the generation of erroneous or fabricated responses, often termed as “hallucinations”. As a result, the accuracy of the LLM’s output is enhanced. Comparative analyses with traditional RAG pipelines indicate that TravelRAG significantly boosts both the retrieval efficiency and accuracy, while also greatly reducing the computational cost of model fine-tuning. The experimental results show that TravelRAG not only outperforms traditional methods in terms of retrieval accuracy but also better meets user needs for content generation.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 6; All Open Access; Gold Open Access},
 author = {Song},
 doi = {10.3390/ijgi13110414},
 journal = {ISPRS International Journal of Geo-Information},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {11},
 title = {{TravelRAG}},
 url = {https://doi.org/10.3390/ijgi13110414},
 volume = {13},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:02:05Z},
 year = {2024}
}

@inproceedings{song_urag_2025,
 abstract = {Multimodal sentiment recognition (MSR) aims to understand human sentiments from multiple modalities, such as text, audio, and visual. Existing methods typically focus on capturing intra-modal and inter-modal interactions, but they often overlook the fine-grained alignment between modalities and the global context of the entire video. To address these issues, we propose a Unified Multimodal Sentiment Recognition framework (UniMSR), which consists of two key components: a Modality Alignment Module (MAM) and a Global Context Module (GCM). The MAM employs a cross-modal attention mechanism to align the representations of different modalities at the feature level, ensuring that the sentiment-relevant information is effectively captured and fused. The GCM utilizes a transformer-based architecture to model the global dependencies across the entire video sequence, enabling the model to understand the contextual relationships between different parts of the video. Experimental results on three benchmark datasets demonstrate that UniMSR outperforms state-of-the-art methods, achieving improvements of up to 3.5% in terms of accuracy and F1-score. Our code is available at https://github.com/UniMSR.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 0},
