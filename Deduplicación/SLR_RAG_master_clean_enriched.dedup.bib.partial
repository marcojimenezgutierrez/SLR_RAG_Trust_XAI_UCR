 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {Leveraging {Passage}},
 url = {https://doi.org/10.1145/3696410.3714554},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:23:27Z},
 year = {2025}
}

@inproceedings{liu_mask-based_2025,
 abstract = {Fluid simulations are essential for computer graphics, engineering, and scientific applications, but traditional methods often struggle with complex geometries and large-scale simulations due to high computational costs. We introduce Neural Implicit Flow (NIF), a novel mesh-free approach that leverages neural implicit representations to model fluid dynamics in a reduced space-time domain. By parameterizing the velocity field as a neural network conditioned on space and time, NIF enables efficient simulation of incompressible flows without explicit meshing or grid-based discretization. Our method incorporates physical constraints, such as incompressibility and boundary conditions, directly into the learning process via differentiable physics solvers. We demonstrate NIF's effectiveness on benchmarks including smoke plumes, droplet impacts, and multiphase interactions, achieving up to 10x speedup over state-of-the-art Eulerian and Lagrangian methods while maintaining visual fidelity and physical accuracy. NIF paves the way for scalable, geometry-agnostic fluid simulations in real-time applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Liu},
 booktitle = {Proceedings of the {ACM}},
