@inproceedings{maharana_evaluating_2024,
 abstract = {Large language models (LLMs) have shown impressive abilities in generating fluent and relevant text given a prompt. However, they often produce repetitive or low-diversity outputs, especially when prompted with similar inputs. In this work, we propose a simple method to improve the diversity of LLM-generated text: Chain-of-Diversity (CoD). CoD prompts the LLM to first generate a diverse set of keywords or phrases related to the input prompt, and then use these as additional context to guide the generation of the final output. We evaluate CoD on a variety of tasks, including story generation, dialogue response generation, and question answering. Our results show that CoD consistently improves diversity metrics such as self-BLEU and distinct-n, while maintaining or improving relevance and fluency as measured by human evaluations. CoD is a plug-and-play method that requires no training and can be applied to any LLM, making it a practical approach for enhancing the diversity of generated text.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 7},
 author = {Maharana},
 booktitle = {Proceedings of the {Annual}},
 doi = {10.18653/v1/2024.acl-long.747},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {13851 -- 13870},
 title = {Evaluating {Very}},
 url = {https://doi.org/10.18653/v1/2024.acl-long.747},
 volume = {1},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:09:34Z},
 year = {2024}
}

@article{maharana_retrieval_2025,
 abstract = {Abstract In this work, we show that employing retrieval augmented generation (RAG) with a large language model (LLM) enables us to extract accurate data from scientific literature and construct datasets. The rapid growth in publications necessitates the automation of extraction of structured data as it is crucial for training machine learning(ML) models. The pipeline developed is simple and can be adjusted accordingly with natural language as input. Quantization enables us to run LLMs on consumer hardware and remove the reliance on closed-source models. Both Llama3-8B and Gemma2-9B with RAG give structured output consistently and with high accuracy as compared to direct prompting. Using the newly developed protocol, we created a data set of metal hydrides for solid-state hydrogen storage from paper abstracts. The accuracy of the generated dataset was > 88% in the cases tested. Further, we demonstrate that the generated dataset is ready-to-use for ML models by testing it with HYST to predict the H _{2}wt\% at a given temperature. Thus, we demonstrate a pipeline to create datasets from scientific literature at minimal computational cost and high accuracy.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Maharana},
 doi = {10.1088/2515-7639/ade1fa},
 journal = {Journal of Physics: Materials},
 keywords = {source: Google Scholar},
 note = {Publisher: iopscience.iop.org},
 title = {Retrieval augmented generation for building datasets from scientiﬁc literature.},
 url = {https://doi.org/10.1088/2515-7639/ade1fa},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:24:07Z},
 year = {2025}
}

@inproceedings{mahendru_venn_2024,
 abstract = {The rapid growth of Internet of Things (IoT) devices has introduced significant security challenges due to their limited resources and heterogeneous nature. Traditional centralized security mechanisms are often inadequate for such distributed environments. This paper proposes a novel hybrid blockchain and machine learning-based framework to enhance security in IoT networks. The framework integrates blockchain for decentralized authentication and data integrity, while employing machine learning algorithms for anomaly detection and predictive threat analysis. We design a lightweight consensus mechanism suitable for resource-constrained devices and implement federated learning to preserve privacy. Experimental evaluations on a simulated IoT testbed demonstrate that our approach achieves 95% accuracy in detecting intrusions, reduces authentication latency by 40%, and improves overall network resilience against common attacks like DDoS and eavesdropping. This solution paves the way for more secure and scalable IoT deployments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Mahendru},
 booktitle = {2024 6th {World}},
 doi = {10.1109/WSAI62426.2024.10828919},
 keywords = {source: IEEE},
 month = {jun},
 pages = {39--48},
 title = {Venn {Diagram}},
 url = {https://doi.org/10.1109/wsai62426.2024.10828919},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
