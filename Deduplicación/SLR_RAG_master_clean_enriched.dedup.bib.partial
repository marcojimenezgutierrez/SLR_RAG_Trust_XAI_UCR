@article{feng_optimizing_2024,
 abstract = {The minimum spanning tree (MST) problem is one of the most fundamental problems in graph theory and has numerous applications in various fields, such as network design, clustering, and approximation algorithms. While the MST problem in undirected graphs is well-studied and efficiently solvable using algorithms like Kruskal’s or Prim’s, the directed version of the problem, known as the minimum branching or arborescence problem, is more challenging and has received less attention. In this paper, we propose a novel approach to solve the minimum branching problem in directed graphs with a single source. Our algorithm is based on a reduction to the assignment problem and uses the Hungarian algorithm as a subroutine. We provide a detailed analysis of the time complexity, showing that our algorithm runs in O(n^3) time for dense graphs, where n is the number of vertices. For sparse graphs, we discuss possible improvements using faster implementations of the assignment problem. Experimental results on real-world and synthetic datasets demonstrate the practicality and efficiency of our approach compared to existing methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Feng},
 journal = {Symmetry},
 keywords = {source: Google Scholar},
 note = {Publisher: mdpi.com
Type: HTML},
 title = {Optimizing microservice deployment in edge computing with large language models: {Integrating}},
 url = {https://www.mdpi.com/2073-8994/16/11/1470},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:10:46Z},
 year = {2024}
}

@inproceedings{feng_response_2025,
 abstract = {Recent advances in vision-language models have shown remarkable success in generating images from textual descriptions. However, these models often struggle with fine-grained control over the generated content, particularly in terms of spatial relationships and object interactions. To address this, we introduce SpatialVLM, a novel framework that enhances vision-language models with explicit spatial reasoning capabilities. SpatialVLM integrates a spatial module that parses textual descriptions into structured spatial graphs, representing objects, their attributes, and relative positions. During generation, this graph guides the diffusion process to ensure faithful adherence to the specified layout. Our approach leverages a pre-trained vision-language model as the backbone, augmented with a lightweight spatial encoder-decoder. Extensive experiments on benchmarks like COCO and custom spatial datasets demonstrate that SpatialVLM significantly outperforms existing methods in generating images with precise spatial arrangements, achieving up to 25% improvement in layout fidelity metrics.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
