@inproceedings{jiang_retrieve_2025,
 abstract = {The rapid advancement of AI technologies has significantly impacted the field of human-computer interaction (HCI), particularly in the design of assistive technologies for people with disabilities. This paper explores the intersection of AI and HCI in the context of hearing aids, focusing on how machine learning algorithms can enhance audio processing to improve speech intelligibility in noisy environments. We present a novel framework that integrates deep neural networks for real-time noise suppression and speaker diarization, evaluated through user studies with hearing-impaired participants. Our results demonstrate a 25% improvement in word recognition accuracy compared to traditional digital signal processing methods. Furthermore, we discuss ethical considerations, including data privacy and bias mitigation in AI models trained on diverse acoustic datasets. This work contributes to more inclusive HCI design by bridging the gap between advanced AI capabilities and user-centered accessibility needs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Jiang},
