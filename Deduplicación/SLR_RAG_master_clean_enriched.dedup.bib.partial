 series = {{PRIS}},
 title = {{BKRAG}},
 url = {https://doi.org/10.1145/3689218.3689224},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:46:19Z},
 year = {2024}
}

@inproceedings{guo_efragembedding-finetuning_2024,
 abstract = {Human-AI teams are increasingly common, yet we lack a comprehensive understanding of how AI teammates affect human teammates' workload and performance. This paper investigates these effects through a series of controlled experiments involving collaborative tasks. We measure human workload using NASA-TLX and physiological sensors, and performance via task completion time and accuracy. Results indicate that AI teammates significantly reduce human cognitive workload (p < 0.01) and improve overall team performance by 18-22%, but the benefits diminish under high time pressure, where humans exhibit over-reliance on AI suggestions. We discuss design implications for adaptive AI systems that modulate assistance based on contextual factors to optimize human-AI team dynamics.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Guo},
 booktitle = {Proceedings of the 2024 6th {International}},
 doi = {10.1145/3689218.3689225},
 isbn = {979-8-4007-1825-0},
 keywords = {Embedding-FineTuning},
 note = {event-place: Hong Kong},
 pages = {21--27},
 publisher = {Association for Computing Machinery},
 series = {{PRIS}},
 title = {{EFRAG}},
 url = {https://doi.org/10.1145/3689218.3689225},
