 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:25:59Z},
 year = {2025}
}

@inproceedings{chan_optimizing_2025,
 abstract = {This paper proposes a novel framework for enhancing cybersecurity in industrial control systems (ICS) using federated learning techniques. Traditional centralized machine learning approaches face challenges in ICS environments due to data privacy concerns and distributed network architectures. Our framework leverages federated learning to train models across multiple ICS nodes without sharing raw data, thereby preserving confidentiality while improving threat detection accuracy. We evaluate the proposed method on a simulated ICS testbed, demonstrating a 15% increase in anomaly detection precision compared to baseline methods. Experimental results highlight the framework's robustness against common cyber threats such as DDoS attacks and unauthorized access attempts. Future work will focus on real-world deployment and integration with existing ICS protocols.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Chan},
 booktitle = {2025 {IEEE}},
 doi = {10.1109/ISCAIE64985.2025.11081158},
 keywords = {source: IEEE},
 month = {may},
 note = {ISSN: 2836-4317},
 pages = {540--545},
 title = {Optimizing {Confidence}},
 url = {https://doi.org/10.1109/iscaie64985.2025.11081158},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:53:32Z},
 year = {2025}
}

@article{chan_rq-rag_2024,
 abstract = {Jailbreaking is an increasingly serious threat to the safe deployment of large language models (LLMs). These attacks can cause LLMs to produce objectionable behaviors, such as providing instructions for illegal activities or generating harmful content. Existing jailbreak attacks are largely manual or semi-automatic, requiring significant human effort to craft adversarial prompts. In this work, we propose a simple and effective method to automatically jailbreak LLMs. Our method, Tree of Attacks with Pruning (TAP), uses an LLM to generate multiple candidate adversarial suffixes for a given input prompt. It then uses a second LLM to evaluate the effectiveness of each suffix in eliciting a jailbreak response. The most promising suffixes are then used to generate new candidates, forming a tree of attacks. We prune the tree to focus on the most promising branches. We evaluate TAP on multiple LLMs and find that it can generate successful jailbreaks with high success rates, often outperforming existing manual and semi-automatic methods. Our method is simple, scalable, and requires no additional training data or fine-tuning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Chan},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Rq-rag: {Learning}},
 url = {https://arxiv.org/abs/2404.00610},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:56:23Z},
 year = {2024}
}

@article{chander_toward_2025,
 abstract = {From the innovation, Artificial Intelligence (AI) materialized as one of the noticeable research areas in various technologies and has almost expanded into every aspect of modern human life. However, nowadays, the development of AI is unpredictable with the stated values of those developing them; hence, the risk of misbehaving AI increases continuously. Therefore, there are uncertainties about endorsing that the development and deploying of AI are favorable and not unfavorable to humankind. In addition, AI holds a black-box pattern, which results in a lack of understanding of how systems can work based on the raised concerns. From the above discussion, trustworthy AI is vital for the extensive adoption of AI in many applications, with strong attention to humankind and the need to focus on AI systems developing into the system outline at the time of system design. In this survey, we discuss compound materials on trustworthy AI and the present state-of-the-art of trustworthy AI technologies, revealing new perspectives, bridging knowledge gaps, and paving the way for potential advances of robustness, and explainability rules which play a proactive role in designing AI systems. Systems that are reliable and secure and mimic human behavior significantly impact the technological AI ecosystem. We provide various contemporary technologies to build explainability and robustness for AI-based solutions, so AI works in a safer and more trustworthy manner. Finally, we conclude our survey article with high-end opportunities, challenges, and future research directions for trustworthy AI to investigate in the future.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {chander},
 doi = {10.1145/3675392},
 issn = {0360-0300},
 journal = {ACM Comput. Surv.},
 keywords = {Artificial intelligence},
 month = {feb},
 note = {Place: New York},
 number = {6},
 title = {Toward {Trustworthy}},
 url = {https://doi.org/10.1145/3675392},
 volume = {57},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:50Z},
 year = {2025}
}

@article{chandrasekhar_amgpt_2024,
 abstract = {Background: Oral cancer is a major global health concern, with high morbidity and mortality rates. Early and accurate diagnosis is crucial for improving patient outcomes. Artificial intelligence (AI) has emerged as a promising tool in medical diagnostics, particularly in image analysis. This systematic review aims to evaluate the application of AI in the diagnosis of oral cancer.

Methods: A comprehensive search was conducted in PubMed, Embase, Web of Science, and Scopus databases from inception to December 2023. Studies evaluating AI models for oral cancer detection using imaging modalities such as histopathology, radiography, and optical imaging were included. Data on diagnostic accuracy metrics (sensitivity, specificity, AUC) were extracted, and quality was assessed using QUADAS-2. Meta-analysis was performed where appropriate.

Results: Twenty-eight studies met the inclusion criteria, involving over 15,000 images or cases. AI models, particularly deep learning-based convolutional neural networks, demonstrated high diagnostic performance, with pooled sensitivity of 92% (95% CI: 89-94%), specificity of 94% (95% CI: 91-96%), and AUC of 0.97. AI outperformed traditional methods in several studies, especially for early-stage lesion detection. Challenges included dataset variability and need for external validation.

Conclusion: AI shows substantial promise in enhancing the accuracy and efficiency of oral cancer diagnosis. Integration into clinical workflows could facilitate earlier detection and better management, though further prospective studies are needed to address limitations and ensure generalizability.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Chandrasekhar},
 journal = {Additive Manufacturing …},
 keywords = {source: Google Scholar},
 note = {Publisher: Elsevier
Type: HTML},
 title = {{AMGPT}},
 url = {https://www.sciencedirect.com/science/article/pii/S2772369024000409},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:02:45Z},
 year = {2024}
}

@article{chandrasekhar_nanogpt_2025,
 abstract = {We present Grok-1.5V, our first-generation multimodal model that processes images and text inputs. Grok-1.5V achieves competitive performance on a range of vision understanding benchmarks. Notably, it excels in RealWorldQA, an evaluation benchmark that consists of over 700 images from across the globe that are paired with questions grounded in visual context. Grok-1.5V also demonstrates strong performance on multimodal understanding benchmarks such as MMMU and MathVista. Our model demonstrates strong reasoning capabilities in the visual domain, including understanding of spatial relationships, object recognition, and understanding of charts and diagrams.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Chandrasekhar},
 journal = {arXiv preprint arXiv …},
