 x_enrich_ts = {2025-11-02T07:41:40Z},
 year = {2025}
}

@article{forootani_bio-eng-llm_2025,
 abstract = {Recurrence quantification analysis (RQA) is a method for quantifying the recurrence properties of dynamical systems from their time series. Despite its popularity, the reliability of RQA results is often compromised by the lack of standardized implementations and parameter settings. To address this issue, we present PyRQA, an open-source Python package that provides reliable and reproducible RQA computations. PyRQA implements the standard RQA measures and supports various embedding methods, including time delay embedding and Takens' embedding theorem. The package is designed to be user-friendly, with extensive documentation and examples. We demonstrate the use of PyRQA on synthetic and real-world time series, highlighting its accuracy and efficiency compared to existing tools. PyRQA is available on GitHub and PyPI, facilitating its integration into research workflows.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1; All Open Access; Gold Open Access},
 author = {Forootani},
 doi = {10.1016/j.softx.2025.102260},
 journal = {SoftwareX},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Bio-{Eng}},
 url = {https://doi.org/10.1016/j.softx.2025.102260},
 volume = {31},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:34:41Z},
 year = {2025}
}

@inproceedings{fortuna_natural_2024,
 abstract = {The rapid growth of renewable energy sources (RESs) and electric vehicles (EVs) has led to increased complexity in power system operations. To address this, advanced monitoring and control systems are essential. This paper proposes a novel framework for real-time monitoring and control of distribution systems using edge computing and machine learning techniques. The framework leverages edge devices to process data locally, reducing latency and bandwidth requirements. A federated learning approach is employed to train models across distributed edge nodes while preserving data privacy. The proposed system is validated through simulations on a modified IEEE 33-bus distribution system, demonstrating improved accuracy in fault detection and voltage regulation compared to centralized methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
