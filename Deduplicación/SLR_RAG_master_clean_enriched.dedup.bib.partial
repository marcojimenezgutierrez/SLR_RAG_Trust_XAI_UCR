@inproceedings{hachicha_recommendation_2024,
 abstract = {This paper proposes a novel framework for enhancing the security of Internet of Things (IoT) devices using blockchain technology integrated with artificial intelligence (AI). The framework addresses key challenges such as data integrity, privacy, and scalability in decentralized IoT networks. By leveraging smart contracts for automated access control and machine learning algorithms for anomaly detection, our approach ensures robust protection against common cyber threats like DDoS attacks and unauthorized data access. Simulation results on a prototype IoT ecosystem show a 35% reduction in response time to security incidents and improved throughput compared to traditional methods. The proposed solution is particularly suited for smart city applications, offering a scalable and efficient security model for resource-constrained devices.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
