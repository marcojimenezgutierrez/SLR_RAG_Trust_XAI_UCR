 year = {2025}
}

@inproceedings{mou_unifying_2024,
 abstract = {Visual question answering (VQA) models tend to rely on language priors and exhibit severe gender bias when answering questions that involve people. Existing works on bias mitigation in VQA models either focus on debiasing the model or the dataset. However, these methods are not generalizable to other domains and require expensive retraining. In this work, we propose a simple yet effective method to mitigate gender bias in VQA models by generating counterfactual images using text-to-image diffusion models. Specifically, we first identify biased samples in the VQA dataset using a state-of-the-art gender classifier. Then, we generate counterfactual images by swapping the gender of the person in the image using a text-to-image diffusion model. Finally, we fine-tune the VQA model on the debiased dataset. Our method is simple, effective, and generalizable to other domains. We evaluate our method on the VQA-CP dataset and show that it significantly reduces gender bias while maintaining high accuracy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Mou},
