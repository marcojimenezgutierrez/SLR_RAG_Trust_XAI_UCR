 pages = {3286--3295},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{RARR}},
 url = {https://doi.org/10.1145/3726302.3730337},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:36:32Z},
 year = {2025}
}

@inproceedings{rosset_researchy_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating code, but their potential for visual programming—where users construct programs through graphical interfaces—remains underexplored. We investigate how visual programming interfaces can empower non-programmers to create interactive data exploration tools using LLMs. Through a design study with 12 participants, we explored the design space of LLM-powered visual programming for data exploration. Our findings reveal key tensions in balancing expressiveness, usability, and trust, particularly around handling ambiguity in natural language descriptions and ensuring reliable program execution. Based on these insights, we contribute design guidelines for LLM-powered visual programming interfaces and introduce VizLLM, a prototype system that implements these guidelines to support iterative data exploration. Our work highlights the opportunities and challenges of integrating LLMs into visual programming paradigms, paving the way for more accessible data analysis tools.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Rosset},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730275},
