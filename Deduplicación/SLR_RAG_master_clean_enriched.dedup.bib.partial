@article{shethiya_llm-powered_2023,
 abstract = {This study investigates the role of blockchain technology in enhancing supply chain transparency and efficiency. Drawing on a comprehensive review of existing literature and case studies from various industries, the research highlights how blockchain's decentralized ledger can mitigate issues such as fraud, counterfeiting, and information asymmetry. The findings suggest that while implementation challenges like scalability and regulatory hurdles persist, the potential benefits in terms of cost reduction and trust-building are substantial. Recommendations for future adoption strategies are provided, emphasizing the need for interdisciplinary collaboration between technologists, policymakers, and business leaders.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
