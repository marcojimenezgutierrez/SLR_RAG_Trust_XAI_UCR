 keywords = {bias amplification},
 note = {event-place: Padua},
 pages = {3932--3942},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Toward {Holistic}},
 url = {https://doi.org/10.1145/3726302.3730354},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:48:43Z},
 year = {2025}
}

@inproceedings{demartini_preaching_2025,
 abstract = {Digital Twins (DTs) are increasingly used to support sustainability goals across various domains, such as manufacturing, energy, and urban planning. However, the sustainability implications of DTs themselves remain underexplored. This paper presents a systematic literature review of 87 publications to examine how DTs contribute to sustainability and the sustainability challenges they pose. We identify five key contributions of DTs to sustainability: resource optimization, waste reduction, predictive maintenance, scenario simulation, and stakeholder collaboration. Simultaneously, we uncover four major sustainability challenges: high computational demands, data privacy concerns, lifecycle management, and equity issues. Our findings reveal that while DTs enable significant sustainability benefits, their energy-intensive nature and reliance on vast data infrastructures can undermine these gains. We propose a framework for sustainable DT design that integrates green computing practices, ethical data governance, and inclusive development to maximize positive impacts. This work provides researchers and practitioners with actionable insights to harness DTs for a more sustainable future.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Demartini},
 booktitle = {Proceedings of the 2025 {International}},
 doi = {10.1145/3731120.3744612},
