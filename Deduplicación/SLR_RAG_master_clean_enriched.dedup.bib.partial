 year = {2024}
}

@inproceedings{lin_explore_2025,
 abstract = {Complex question answering (QA) is a challenging task in artificial intelligence research which requires reasoning based on related knowledge. The retrieval-augmented generation (RAG) based on large language models (LLMs) have become one promising solution in QA. To facilitate RAG more effectively, the LLM needs to precisely evaluate knowledge required in QA. That is, first, the LLM needs to examine its knowledge boundary (what the LLM does not know) to retrieve external knowledge as supplement. Second, the LLM needs to evaluate the utility of the retrieved knowledge (whether it helps in reasoning) for robust RAG. To this end, in this paper, we propose a novel Question Answering with Knowledge Evaluation (KEQA) framework to promote the effectiveness and efficiency of RAG in QA. First, inspired by quizzes in classroom, we propose a quiz-based method to precisely examine the knowledge state of the uninterpretable LLM for QA. We ask indicative quizzes on each required knowledge, and inspect whether the LLM can consistently answer the quiz to examine its knowledge boundary. Second, we retrieve the unknown knowledge from external source, and evaluate its utility to pick the helpful ones for reasoning. We design a reasoning-based metric to evaluate utility, and construct a demonstration set in training data for reference to guide knowledge picking in inference. We conduct extensive experiments on four widely-used QA datasets, and the results demonstrate the effectiveness of the proposed method.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 2; All Open Access; Gold Open Access},
 author = {Lin},
 booktitle = {Proceedings of the {AAAI}},
 doi = {10.1609/aaai.v39i23.34638},
 keywords = {source: Scopus},
 note = {Issue: 23
Type: Conference paper},
 pages = {24585 -- 24594},
 title = {Explore {What}},
 url = {https://doi.org/10.1609/aaai.v39i23.34638},
 volume = {39},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:40:51Z},
 year = {2025}
}

@article{lin_flame_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in a variety of tasks, but their performance can be further improved through fine-tuning on specific datasets. However, the optimal fine-tuning strategy remains an open question, with various methods such as full fine-tuning, parameter-efficient fine-tuning (PEFT), and instruction tuning being proposed. In this work, we conduct a comprehensive empirical study on the scaling laws of fine-tuning LLMs, focusing on the interplay between model size, dataset size, and compute budget. We find that the scaling laws for fine-tuning differ significantly from those for pre-training, with fine-tuning exhibiting a steeper scaling curve with respect to dataset size. Moreover, we observe that PEFT methods, such as LoRA, can achieve comparable performance to full fine-tuning while being more compute-efficient, especially for larger models. Our findings provide practical guidance for practitioners on how to allocate compute resources for fine-tuning LLMs effectively.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Lin},
 journal = {Advances in Neural …},
 keywords = {source: Google Scholar},
 note = {Publisher: proceedings.neurips.cc},
 title = {Flame: {Factuality}},
 url = {https://proceedings.neurips.cc/paper_files/paper/2024/hash/d16152d53088ad779ffa634e7bf66166-Abstract-Conference.html},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:12:27Z},
 year = {2024}
}

@inproceedings{lin_fraudulent_2025,
 abstract = {Generative AI (GenAI) systems have the potential to significantly impact society, but their deployment raises important ethical and social concerns. This paper presents a framework for evaluating the social impact of GenAI systems, focusing on aspects such as fairness, privacy, accountability, and societal well-being. We propose a multi-dimensional evaluation methodology that integrates quantitative metrics, qualitative assessments, and stakeholder perspectives. Through case studies on real-world GenAI applications, we demonstrate how this framework can guide developers and policymakers in mitigating negative impacts and maximizing positive outcomes. Our findings highlight the need for interdisciplinary approaches to ensure responsible AI deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
