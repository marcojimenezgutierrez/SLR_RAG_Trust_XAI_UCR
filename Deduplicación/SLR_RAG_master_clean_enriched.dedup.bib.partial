@inproceedings{wang_evaluating_2025,
 abstract = {Federated learning enables collaborative model training across distributed devices while keeping data localized, enhancing privacy. However, it is vulnerable to inference attacks that reconstruct private data from model updates. To address this, we propose a novel framework that integrates differential privacy (DP) with adaptive noise injection tailored to the federated setting. Our approach dynamically adjusts noise levels based on client heterogeneity and model convergence, balancing utility and privacy. Extensive experiments on benchmark datasets demonstrate that our method achieves superior privacy guarantees with minimal accuracy degradation compared to standard DP baselines.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
