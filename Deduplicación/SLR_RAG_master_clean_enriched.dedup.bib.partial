 keywords = {large language models},
 note = {event-place: Lotte Hotel World},
 pages = {655--669},
 publisher = {Association for Computing Machinery},
 series = {{SOSP}},
 title = {{KNighter}},
 url = {https://doi.org/10.1145/3731569.3764827},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:05:38Z},
 year = {2025}
}

@article{yang_knowing_2025,
 abstract = {Haptic feedback is a promising modality for accessible user interfaces, but current wearable haptic devices are often designed for users with typical motor abilities, limiting their applicability for people with upper-body mobility impairments. To address this, we conducted a co-design study with 12 participants with upper-body mobility impairments to explore design requirements for inclusive wearable haptics. Through workshops and iterative prototyping, we identified key challenges, including device placement, actuation mechanisms, and feedback modalities that accommodate diverse motor capabilities. Our findings reveal the need for modular, customizable designs that support varied attachment methods (e.g., straps, adhesives) and multi-modal feedback (vibrotactile, electrodermal, thermal) to ensure usability across impairment levels. We contribute design guidelines and a prototype system, Haptics4All, demonstrating how inclusive principles can enhance accessibility in wearable interfaces.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
