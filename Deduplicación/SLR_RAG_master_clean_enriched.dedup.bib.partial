 keywords = {Large language models},
 note = {event-place: Brooklyn},
 pages = {711--718},
 publisher = {Association for Computing Machinery},
 series = {{ICAIF}},
 title = {Online {Personalizing}},
 url = {https://doi.org/10.1145/3677052.3698651},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:09:49Z},
 year = {2024}
}

@article{chen_ontology_2024,
 abstract = {Despite the impressive advancements in Large Language Models (LLMs), their ability to perform reasoning and provide explainable outcomes remains a challenge, underscoring the continued relevance of ontologies in certain areas, particularly due to the reasoning and validation capabilities of ontologies. Ontology modelling and semantic search, due to their inherent complexity, still demand considerable human effort and expertise. Addressing this gap, our paper introduces the problem of ontology text alignment, which involves finding the most relevant axioms with respect to the given reference text. We propose an advanced Retrieval Augmented Generation framework that leverages BERT models and generative LLMs, together with ontology semantic enhancement based on atomic decomposition. Additionally, we have developed benchmarks in geology and biomedical areas. Our evaluation demonstrates the positive impact of our framework.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Green Accepted Open Access; Green Open Access; Hybrid Gold Open Access},
