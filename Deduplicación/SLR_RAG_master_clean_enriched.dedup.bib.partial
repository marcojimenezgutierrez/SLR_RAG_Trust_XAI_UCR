 keywords = {parameter-efficient fine-tuning},
 note = {event-place: Padua},
 pages = {286--296},
 publisher = {Association for Computing Machinery},
 series = {{ICTIR}},
 title = {Comparing {Retrieval}},
 url = {https://doi.org/10.1145/3731120.3744595},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:35:02Z},
 year = {2025}
}

@article{salemi_evaluating_2024,
 abstract = {Mobile health (mHealth) applications have become popular tools for supporting self-management among people with chronic conditions. However, little is known about how these individuals use mHealth apps in their everyday lives and the challenges they encounter. Through a qualitative study involving 20 participants with chronic conditions who use mHealth apps, we identify four key challenges: (1) managing multiple apps and fragmented data, (2) dealing with unreliable or incomplete data, (3) navigating privacy and data sharing concerns, and (4) sustaining long-term engagement. Our findings reveal that these challenges often lead to app abandonment or suboptimal use. We discuss design implications, including the need for better app integration, improved data reliability, enhanced privacy controls, and strategies to foster sustained engagement, to better support self-management for people with chronic conditions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Salemi},
 booktitle = {Proceedings of the 47th {International}},
