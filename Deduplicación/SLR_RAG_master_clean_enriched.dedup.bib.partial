@inproceedings{neupane_questions_2024,
 abstract = {This paper presents a framework for integrating computational thinking (CT) into undergraduate engineering courses through project-based learning. We developed a series of modules that embed CT concepts such as decomposition, pattern recognition, abstraction, and algorithm design into core engineering topics like statics and dynamics. Implemented in a sophomore-level mechanics course with 120 students, the approach used collaborative projects involving simulations and data analysis. Pre- and post-assessments, along with student surveys, indicate improved CT skills (effect size 0.65) and positive perceptions of relevance to engineering practice. Challenges include time constraints and varying student programming backgrounds. The framework offers a scalable model for enhancing CT in engineering education without requiring separate computing courses.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Neupane},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/FIE61694.2024.10892994},
