@inproceedings{krishna_echoswift_2024,
 abstract = {Time series data is ubiquitous in various domains, such as finance, healthcare, and climate science. However, high-dimensional time series data poses significant challenges for visual exploration due to the curse of dimensionality and the temporal aspect. Existing visualization techniques often struggle to effectively reveal patterns and anomalies in such data. In this paper, we propose a novel interactive visualization system, TimeLens, that enables users to explore high-dimensional time series data through a combination of dimensionality reduction, temporal aggregation, and interactive filtering. TimeLens employs a multi-view approach, integrating parallel coordinates for attribute exploration, a timeline view for temporal navigation, and a scatterplot matrix enhanced with temporal heatmaps for pattern detection. Our system supports dynamic brushing and linking across views, allowing users to drill down into interesting subsets of the data. We demonstrate the effectiveness of TimeLens through case studies on real-world datasets and provide preliminary user feedback indicating its utility in uncovering hidden insights.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Krishna},
 booktitle = {Companion of the 15th {ACM}},
 doi = {10.1145/3629527.3652273},
