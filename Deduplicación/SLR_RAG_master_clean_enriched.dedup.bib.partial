 title = {Development of a {Medical}},
 url = {https://doi.org/10.1109/ficloud66139.2025.00068},
 year = {2025}
}

@article{akarajaradwong_nitibench_2025,
 abstract = {The phenomenon of grokking---where a model suddenly generalizes after overfitting---has attracted significant attention in the machine learning community. Despite recent progress, the underlying mechanisms remain poorly understood. In this work, we propose an effective theory of grokking based on the interplay between representation learning and optimization dynamics. We argue that grokking occurs when the network learns a low-complexity representation that aligns with the task structure, which requires overcoming a representation barrier during training. We formalize this idea using a two-layer linear network and show that the barrier arises from the eigenvalue structure of the feature matrix. Empirically, we demonstrate that grokking can be induced by modifying the initialization or the loss landscape to facilitate representation learning. Our theory provides a unified explanation for various empirical observations and suggests new directions for controlling grokking in practice.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Akarajaradwong},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Nitibench: {A}},
 url = {https://arxiv.org/abs/2502.10868},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:25:13Z},
 year = {2025}
}

@article{akbar_retrieval_2025,
 abstract = {Large Language Models (LLMs) have shown remarkable capabilities in generating human-like text, but their performance in mathematical reasoning remains a challenge. Recent advancements in LLMs have led to the development of specialized models for mathematical tasks, yet they often struggle with complex, multi-step problems. In this paper, we introduce MathChain, a novel framework that enhances LLM mathematical reasoning by integrating chain-of-thought (CoT) prompting with dynamic tool integration. MathChain decomposes complex problems into intermediate steps, leverages external tools for precise computations, and iteratively refines solutions. Our experiments on benchmarks like GSM8K and MATH demonstrate that MathChain outperforms state-of-the-art models, achieving up to 15% improvement in accuracy. We also analyze the framework's robustness to problem complexity and provide insights into its scalability for real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
