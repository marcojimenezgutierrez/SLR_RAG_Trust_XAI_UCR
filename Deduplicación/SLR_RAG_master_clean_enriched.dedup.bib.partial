 year = {2024}
}

@article{gulden_leveraging_2024,
 abstract = {The rapid advancement of artificial intelligence (AI) in medical imaging has revolutionized diagnostic processes, enabling faster and more accurate interpretations of complex medical images. However, the "black box" nature of many AI models poses significant challenges in clinical adoption, as healthcare professionals require transparency to trust and validate AI-driven decisions. Explainable AI (XAI) emerges as a critical solution to bridge this gap, providing interpretable insights into AI predictions. This chapter explores the principles, techniques, and applications of XAI in medical imaging, focusing on methods such as saliency maps, attention mechanisms, and counterfactual explanations. We discuss their implementation in tasks like tumor detection in MRI scans and pneumonia identification in chest X-rays, highlighting benefits for clinical workflows and regulatory compliance. Challenges, including computational overhead and interpretability trade-offs, are addressed, alongside future directions for robust, user-centric XAI frameworks in healthcare.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Gulden},
 doi = {10.1007/978-3-031-64193-0_18},
 journal = {Springer Proceedings in Complexity},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {272 -- 283},
 title = {Leveraging {Large}},
 url = {https://doi.org/10.1007/978-3-031-64193-0_18},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:07:12Z},
 year = {2024}
}

@article{gumaan_expertrag_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating code. However, they often produce incomplete or incorrect code snippets that require further refinement. In this paper, we introduce CodeFixer, a novel framework that leverages LLMs to iteratively fix and improve code generated by other LLMs. CodeFixer consists of three key components: (1) a code analyzer that identifies errors and missing parts in the generated code, (2) a prompt engineer that crafts targeted prompts for fixing specific issues, and (3) an iterative fixer that applies the LLM to refine the code step by step. We evaluate CodeFixer on benchmarks such as HumanEval and MBPP, demonstrating significant improvements in code correctness and functionality over baseline LLM-generated code. Our approach not only enhances the quality of generated code but also reduces the need for human intervention in software development tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Gumaan},
 journal = {arXiv preprint arXiv:2504.08744},
 keywords = {source: Google Scholar},
