}

@inproceedings{dong_reasoning_2025,
 abstract = {In this paper, we investigate the design and evaluation of a novel haptic feedback system for virtual reality (VR) environments, focusing on enhancing user immersion through multi-modal sensory integration. We developed a wearable device that delivers localized vibrotactile cues synchronized with visual and auditory stimuli in VR applications. Through a series of user studies involving 48 participants, we assessed the system's impact on presence, task performance, and user comfort. Results indicate significant improvements in perceived realism and interaction efficiency compared to audio-visual-only VR setups, with minimal reported discomfort. Our findings contribute to the advancement of accessible and intuitive haptic technologies for immersive computing.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
