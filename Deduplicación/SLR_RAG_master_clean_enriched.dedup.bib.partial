 x_enrich_ts = {2025-11-02T07:39:39Z},
 year = {2024}
}

@inproceedings{kim_legisflow_2025,
 abstract = {Interactive data visualization tools have become essential for exploring and communicating insights from complex datasets. However, creating effective visualizations often requires significant expertise in both data analysis and visual design. To democratize this process, we introduce VizGen, a generative AI system that enables users to create custom data visualizations through natural language descriptions. VizGen leverages large language models (LLMs) combined with visualization-specific prompting strategies to interpret user intents and generate Vega-Lite specifications. Our user study (N=24) demonstrates that VizGen significantly outperforms traditional tools in usability and expressiveness, allowing non-experts to produce high-quality visualizations efficiently. We also discuss ethical considerations and future directions for AI-assisted visualization design.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
