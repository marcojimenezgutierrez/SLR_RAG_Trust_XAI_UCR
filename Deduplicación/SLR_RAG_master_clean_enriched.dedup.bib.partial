@article{pan_raglog_2024-1,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for collaborative model training across distributed devices while preserving data privacy. However, the advent of large models, such as large language models (LLMs), introduces new challenges to FL due to their massive parameter sizes and computational demands. This survey provides a comprehensive overview of FL in the context of large models, highlighting key challenges and recent advancements. We first discuss the fundamental principles of FL and its adaptation to large models. Then, we delve into critical challenges, including communication efficiency, model personalization, privacy preservation, and incentive mechanisms. Furthermore, we explore emerging applications of FL with large models in domains such as healthcare, finance, and edge computing. Finally, we outline future research directions to address the evolving needs of FL in the era of large models.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
