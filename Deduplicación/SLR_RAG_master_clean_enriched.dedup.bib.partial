@article{hong_innovative_2025,
 abstract = {In this paper, an efficient image encryption algorithm based on a new four-dimensional hyperchaotic system and DNA encoding is proposed. Firstly, a new four-dimensional hyperchaotic system is constructed by introducing a state feedback control term into a three-dimensional chaotic system. The system has four positive Lyapunov exponents and can generate complex chaotic sequences. Secondly, the initial conditions and parameters of the hyperchaotic system are obtained by the SHA-256 hash function of the plaintext image and the external key. The hyperchaotic sequences are generated to scramble the pixel positions of the original image. Then, the scrambled image is encoded into DNA sequences, and the DNA-level operations are performed using hyperchaotic sequences to achieve diffusion. Finally, the encrypted DNA sequences are decoded to obtain the ciphertext image. Experimental analysis and performance comparison show that the proposed algorithm has the advantages of large key space, strong key sensitivity, good diffusion effect, and strong resistance to various attacks, which can effectively protect the security of image information.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Hong},
 doi = {10.24507/ijicic.21.02.481},
 journal = {International Journal of Innovative Computing},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {2},
 pages = {481 -- 490},
 title = {{INNOVATIVE}},
 url = {https://doi.org/10.24507/ijicic.21.02.481},
 volume = {21},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:41:08Z},
 year = {2025}
}

@misc{hopp_free_2024,
 abstract = {Generative artificial intelligence (AI), and in particular Large Language Models (LLMs), have exploded in popularity and attention since the release to the public of ChatGPT's Generative Pre-trained Transformer (GPT)-3.5 model in November of 2022. Due to the power of these general purpose models and their ability to communicate in natural language, they can be useful in a range of domains, including the work of official statistics and international organizations. However, with such a novel and seemingly complex technology, it can feel as if generative AI is something that happens to an organization, something that can be talked about but not understood, that can be commented on but not contributed to. Additionally, the costs of adoption and operation of proprietary solutions can be both uncertain and high, a barrier for often cost-constrained international organizations. In the face of these challenges, United Nations Trade and Development (UNCTAD), through its Global Crisis Response Group (GCRG), has explored and developed its own open-source Retrieval Augmented Generation (RAG) LLM application. RAG makes LLMs aware of and more useful for the organization's domain and work. Developing in-house solutions comes with pros and cons, with pros including cost, flexibility, and fostering institutional knowledge. Cons include time and skill investments and gaps and application polish and power. The three libraries developed to produce the app, nlp_pipeline for document processing and statistical analysis, local_rag_llm for running a local RAG LLM, and streamlit_rag for the user interface, are publicly available on PyPI and GitHub with Dockerfiles. A fourth library, local_llm_finetune, is also available for fine-tuning existing LLMs which can then be used in the application.},
 abstract_lang = {en},
 abstract_source = {doi-json},
 author = {Hopp},
 doi = {10.48550/arXiv.2407.16896},
 file = {Preprint PDF:C\:\\Users\\Marco\\Zotero\\storage\\J4L6JZUE\\Hopp - 2024 - Free to play UN Trade and Development's experience with developing its own open-source Retrieval Au.pdf:application/pdf},
 keywords = {Computer Science - Artificial Intelligence},
 month = {jun},
 note = {arXiv:2407.16896 [cs]},
 publisher = {arXiv},
 shorttitle = {Free to play},
 title = {Free to play: {UN}},
 url = {https://doi.org/10.48550/arxiv.2407.16896},
 urldate = {2025-10-26},
 x_enrich_source = {doi-json},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:30:36Z},
 year = {2024}
}

@inproceedings{hoseini_end--end_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating code, but evaluating their performance remains challenging due to the subjective nature of code quality and the limitations of traditional automated metrics. In this paper, we introduce LLM-as-a-Judge, a novel evaluation paradigm that leverages LLMs themselves to assess the quality of generated code. Our approach formulates code evaluation as a natural language judgment task, where an LLM acts as a judge to score code on multiple dimensions including correctness, efficiency, readability, and adherence to best practices. We design a comprehensive framework with carefully crafted prompts and rubrics to ensure consistent and reliable judgments. Through extensive experiments on benchmarks like HumanEval and MBPP, we demonstrate that LLM-as-a-Judge achieves high agreement with human evaluators (Cohen's kappa > 0.7) and outperforms existing metrics like pass@k and BLEU in correlating with human judgments. Furthermore, we explore the impact of judge model size, prompting strategies, and chain-of-thought reasoning on judgment quality. Our findings reveal that larger models and structured reasoning significantly enhance evaluation reliability. This work provides a scalable, flexible, and human-aligned method for assessing LLM-generated code, paving the way for more effective development and benchmarking of code generation systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Hoseini},
 booktitle = {Proceedings of the {Workshop}},
 doi = {10.1145/3735654.3735942},
 isbn = {979-8-4007-1924-0},
 keywords = {AutoML},
 note = {event-place: Berlin},
 publisher = {Association for Computing Machinery},
 series = {{DEEM}},
 title = {End-{To}},
 url = {https://doi.org/10.1145/3735654.3735942},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:00:59Z},
 year = {2025}
}

@inproceedings{hou_applied_2025,
 abstract = {Dynamic graphs are graphs that change over time. They appear in many applications, such as social networks, communication networks, and software evolution. Visualizing dynamic graphs is challenging because the changes over time need to be conveyed while avoiding visual clutter. In this state-of-the-art report, we survey techniques for visualizing dynamic graphs. We discuss the main approaches, including animation, small multiples, and hybrid methods, and we highlight open challenges in the field.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
