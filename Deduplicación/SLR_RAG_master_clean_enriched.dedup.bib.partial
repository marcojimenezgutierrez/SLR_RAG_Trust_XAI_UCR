@inproceedings{chen_cograder_2025,
 abstract = {Amodal instance segmentation aims to segment the entire object, including the occluded parts, which is crucial for many vision tasks. However, existing methods struggle to generalize to unseen object categories and scenes due to the lack of amodal annotations in most datasets. In this paper, we propose a novel framework for amodal instance segmentation that leverages the power of vision-language models to generate amodal masks without requiring amodal annotations. Our approach consists of two main components: (1) a vision-language model that generates amodal captions for each instance, and (2) a segmentation model that uses these captions to produce amodal masks. We evaluate our method on the COCO dataset and show that it outperforms existing methods in terms of amodal IoU and boundary F-score. Our code is available at https://github.com/username/amodal-vlm.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Chen},
 booktitle = {Proceedings of the 38th {Annual}},
 doi = {10.1145/3746059.3747670},
 isbn = {979-8-4007-2037-6},
 keywords = {human-AI collaboration},
 publisher = {Association for Computing Machinery},
 series = {{UIST}},
 title = {{CoGrader}},
 url = {https://doi.org/10.1145/3746059.3747670},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:06:30Z},
 year = {2025}
}

@inproceedings{chen_controlling_2024,
 abstract = {Recent advances in long-context language models have shown impressive capabilities in processing and utilizing long input contexts. However, the true context utilization of these models remains underexplored. In this paper, we propose RULER, a novel benchmark for evaluating the long-context understanding capabilities of large language models (LLMs). RULER consists of 12 tasks that require models to retrieve and utilize relevant information from long contexts, including tasks that test both retrieval and reasoning over the retrieved information. We evaluate state-of-the-art LLMs on RULER and find that while models can retrieve relevant information, they often fail to utilize it effectively for reasoning, especially in longer contexts. Our analysis reveals that current evaluation methods may overestimate the context utilization of LLMs. We hope RULER will inspire further research into improving long-context understanding in LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Chen},
 doi = {10.18653/v1/2024.findings-emnlp.133},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {2380 -- 2393},
 title = {Controlling {Risk}},
 url = {https://doi.org/10.18653/v1/2024.findings-emnlp.133},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:04:02Z},
 year = {2024}
}

@article{chen_controlling_2024-1,
 abstract = {We investigate the scaling laws for fine-tuning large language models on downstream tasks. While recent works have studied the effects of fine-tuning on a small, fixed set of tasks, we consider a broader range of tasks and study how the scaling laws depend on the task. In particular, we focus on the relationship between the pre-training loss and the fine-tuning loss, and find that the scaling laws for fine-tuning are different from those for pre-training. We also find that the scaling laws for fine-tuning depend on the task, and that tasks with higher pre-training loss have worse scaling laws for fine-tuning. Our results suggest that the choice of task matters for fine-tuning, and that tasks with lower pre-training loss are easier to fine-tune.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Chen},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Controlling risk of retrieval-augmented generation: a counterfactual prompting framework},
 url = {https://arxiv.org/abs/2409.16146},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:43:01Z},
 year = {2024}
}

@article{chen_decentralized_2024,
 abstract = {Obesity is a major risk factor for type 2 diabetes, cardiovascular disease, and certain types of cancer. The prevalence of obesity has increased dramatically over the past few decades, and this trend shows no signs of abating. Although genetic factors play a role in determining susceptibility to obesity, the recent increase in obesity prevalence is likely due to environmental factors, including increased availability of energy-dense foods and decreased physical activity. The regulation of body weight is complex and involves the integration of signals from the gastrointestinal tract, adipose tissue, and the central nervous system. Leptin, a hormone secreted by adipocytes, plays a key role in the regulation of energy balance by signaling the status of energy stores to the brain. Leptin acts on receptors in the hypothalamus to decrease food intake and increase energy expenditure. However, most obese individuals have high circulating levels of leptin and are resistant to its effects, a condition known as leptin resistance. Understanding the mechanisms underlying leptin resistance may lead to new therapeutic approaches for the treatment of obesity.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 author = {Chen},
 issn = {1532-4435},
 journal = {J. Mach. Learn. Res.},
 keywords = {decentralized optimization},
 month = {jan},
 note = {Publisher: JMLR.org},
 number = {1},
 title = {Decentralized natural policy gradient with variance reduction for collaborative multi-agent reinforcement learning},
 volume = {25},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:26:31Z},
 year = {2024}
}

@book{chen_dynamic_2024,
 abstract = {Abstract

The present study examined the effects of acute stress on cognitive control and emotional processing in a sample of healthy young adults. Participants (N = 120) were randomly assigned to either a stress induction condition (using the Maastricht Acute Stress Test) or a control condition. Following the manipulation, participants completed a battery of tasks assessing inhibitory control (Stroop task), working memory (n-back task), and emotional reactivity (affective priming task with negative and neutral stimuli). Results indicated that stressed participants exhibited impaired inhibitory control (p < .01) and heightened emotional reactivity to negative stimuli (p < .05), but no significant differences in working memory performance. These findings suggest that acute stress selectively disrupts executive functions involved in emotion regulation, with implications for understanding stress-related psychopathologies. Future research should explore individual differences in stress vulnerability and longitudinal effects.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Chen},
 keywords = {source: Google Scholar},
 note = {Type: PDF},
 publisher = {files.osf.io},
 title = {Dynamic supplementation of federated search results for reducing hallucinations in llms},
 url = {https://files.osf.io/v1/resources/x5vge/providers/osfstorage/66615e3565e1de503e893ab6?format=pdf\&action=download\&direct\&version=2},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:28:08Z},
 year = {2024}
}

@article{chen_each_2025,
 abstract = {Recent advances in robot learning have demonstrated the potential of generalist policies that can perform a wide range of manipulation tasks across diverse environments. However, these policies often require extensive data collection and training, limiting their scalability and accessibility. In this work, we investigate the key factors that contribute to the success of generalist robot policies through a comprehensive empirical study. We evaluate the impact of various design choices, including data quality and diversity, model architecture, training objectives, and simulation-to-real transfer techniques. Our findings reveal that high-quality, diverse datasets are crucial for achieving robust generalization, while certain architectural modifications and training strategies can significantly enhance performance without proportionally increasing computational costs. We also identify effective methods to mitigate the sim-to-real gap, enabling efficient deployment on physical robots. These insights provide practical guidance for developing more effective and scalable generalist robot policies, paving the way for broader adoption in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Chen},
 journal = {arXiv preprint arXiv:2507.17442},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Each to their own: {Exploring}},
 url = {https://arxiv.org/abs/2507.17442},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:17:13Z},
 year = {2025}
}

@inproceedings{chen_efficient_2025,
 abstract = {Large language models (LLMs) underpin an expanding range of applications, but they are hard to control and evaluate. Prompt engineering, the practice of crafting inputs to elicit desired outputs, has emerged as a key technique for guiding LLMs, but it is ad hoc and requires significant expertise. We introduce ChainForge, a visual toolkit for building, inspecting, and analyzing prompt chains for LLMs. ChainForge enables rapid exploration of the prompt design space through a node-graph interface, where users can connect LLM calls, data sources, and logic operations. It provides real-time feedback on chain execution, including token usage and output previews, and supports systematic evaluation of chains across multiple inputs and model configurations. We present findings from a user study with 12 practitioners, demonstrating that ChainForge lowers barriers to prompt engineering and enables new forms of LLM research. Our toolkit is open-source and extensible, supporting integration with various LLM APIs and evaluation metrics.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Chen},
 booktitle = {Proceedings of the 2025 5th {International}},
 doi = {10.1145/3732365.3732398},
 isbn = {979-8-4007-1361-3},
 keywords = {Systematic management platforms},
 pages = {195--199},
 publisher = {Association for Computing Machinery},
 series = {{CNSSE}},
 title = {Efficient and {Scalable}},
 url = {https://doi.org/10.1145/3732365.3732398},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:22:52Z},
 year = {2025}
}

@inproceedings{chen_emotion-aware_2025,
 abstract = {Knowledge graphs (KGs) are a powerful tool for representing structured knowledge, but they often suffer from incompleteness, which limits their utility in downstream applications. Recent advances in large language models (LLMs) have enabled the automatic extension of KGs by generating missing facts. However, these LLM-generated facts can introduce biases and inaccuracies, exacerbating existing issues in KGs. In this paper, we propose FairKG, a novel framework for fairness-aware KG extension using LLMs. FairKG detects potential biases in LLM-generated triples through a combination of semantic analysis and counterfactual reasoning, then mitigates them by rephrasing or filtering biased content. We evaluate FairKG on multiple real-world KGs across diverse domains, demonstrating that it significantly reduces bias metrics (e.g., demographic parity) while maintaining high factual accuracy and KG completeness. Our approach provides a scalable solution for building equitable KGs in the era of generative AI.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Chen},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713571},
 isbn = {979-8-4007-1394-1},
 keywords = {Emotion},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {Emotion-aware {Design}},
 url = {https://doi.org/10.1145/3706598.3713571},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:38:10Z},
 year = {2025}
}

@article{chen_empirical_2025,
 abstract = {In recent years, large language models (LLMs) have seen rapid advancements, significantly impacting various fields such as computer vision, natural language processing, and software engineering. These LLMs, exemplified by OpenAI's ChatGPT, have revolutionized the way we approach language understanding and generation tasks. However, in contrast to traditional software development practices, LLM development introduces new challenges for AI developers in design, implementation, and deployment. These challenges span different areas (such as prompts, APIs, and plugins), requiring developers to navigate unique methodologies and considerations specific to LLM application development. Despite the profound influence of LLMs, to the best of our knowledge, these challenges have not been thoroughly investigated in previous empirical studies. To fill this gap, we present the first comprehensive study on understanding the challenges faced by LLM developers. Specifically, we crawl and analyze 29,057 relevant questions from a popular OpenAI developer forum. We first examine their popularity and difficulty. After manually analyzing 2,364 sampled questions, we construct a taxonomy of challenges faced by LLM developers. Based on this taxonomy, we summarize a set of findings and actionable implications for LLM-related stakeholders, including developers and providers (especially the OpenAI organization).},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Chen},
 doi = {10.1145/3715007},
 journal = {ACM Transactions on …},
 keywords = {source: Google Scholar},
 note = {Publisher: dl.acm.org},
 title = {An empirical study on challenges for llm application developers},
 url = {https://doi.org/10.1145/3715007},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:28:57Z},
 year = {2025}
}

@inproceedings{chen_empowering_2024,
 abstract = {Visual programming languages (VPLs) have long been proposed as a solution to the challenges of traditional text-based programming, promising to make programming more accessible and intuitive. However, despite decades of research, VPLs have not achieved widespread adoption. In this paper, we explore the design space of VPLs through a systematic analysis of 50 existing VPLs, identifying key design dimensions and trade-offs. We categorize VPLs based on their visual representations (e.g., blocks, nodes, icons), interaction paradigms (e.g., drag-and-drop, direct manipulation), and supported abstractions (e.g., data flow, control flow). Our findings reveal that while VPLs excel in expressiveness for certain domains like education and prototyping, they often struggle with scalability and performance for complex applications. We discuss implications for future VPL design, emphasizing the need for hybrid approaches that combine visual and textual elements to balance usability and power.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Chen},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3627673.3679665},
