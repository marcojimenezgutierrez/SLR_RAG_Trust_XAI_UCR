@article{yang_agrigpt_2025,
 abstract = {Large language models (LLMs) have achieved impressive performance on a variety of natural language processing tasks. However, their ability to perform complex reasoning, especially in low-resource settings, remains a significant challenge. In this paper, we introduce a novel framework called Chain-of-Thought Prompting with External Verifier (COT-EV), which enhances the reasoning capabilities of LLMs by integrating an external verifier module during the inference process. The verifier dynamically assesses intermediate reasoning steps generated by the LLM and provides feedback to refine the output, ensuring logical consistency and factual accuracy. We evaluate our approach on several reasoning benchmarks, including arithmetic, commonsense, and symbolic reasoning tasks, demonstrating substantial improvements over standard chain-of-thought prompting, particularly in scenarios with limited training data. Our results highlight the potential of hybrid systems that combine the generative power of LLMs with structured verification mechanisms to push the boundaries of AI reasoning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Yang},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
