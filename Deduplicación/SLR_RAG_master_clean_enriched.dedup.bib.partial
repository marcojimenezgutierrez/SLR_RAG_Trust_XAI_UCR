@article{clop_backdoored_2024,
 abstract = {Robotic policies that can generalize across diverse tasks and environments are a key step toward achieving broad robot autonomy. However, current approaches to training such policies are limited in their ability to generalize to new tasks and environments. In this work, we investigate what factors contribute to the generalization of generalist robot policies. We conduct a series of experiments on a set of simulated robotic manipulation tasks and find that the choice of data augmentation, the diversity of the training data, and the architecture of the policy network all play important roles in enabling generalization. Our findings provide insights into how to design more robust and generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Clop},
 journal = {arXiv preprint arXiv:2410.14479},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Backdoored retrievers for prompt injection attacks on retrieval augmented generation of large language models},
 url = {https://arxiv.org/abs/2410.14479},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:06:58Z},
 year = {2024}
}

@article{cohen_this_2024,
 abstract = {Moving operations to the cloud has become a way of life for many educational institutions. Much of the information these institutions store in the cloud is protected by the Family Educational Rights and Privacy Act (FERPA), which was last amended in 2002, well before cloud computing became ubiquitous. The application of a 1974 law to 21st-century technology presents a plethora of legal and technical questions. In this article, we present an interdisciplinary analysis of these issues. We examine both existing statutes and case law and contemporary research into cloud security, focusing on the impact of the latter on the former. We find that FERPA excludes information that students and faculty often believe is protected and that lower-court decisions have created further ambiguity. We additionally find that given current technology, the statute is no longer sufficient to protect student data, and we present recommendations for revisions.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Cohen},
 doi = {10.1145/3675230},
 journal = {ACM J. Responsib. Comput.},
 keywords = {cloud computing},
 month = {aug},
 note = {Place: New York},
 number = {3},
 title = {This {Is}},
 url = {https://doi.org/10.1145/3675230},
 volume = {1},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:26Z},
 year = {2024}
}

@article{cohen_wixqa_2025,
 abstract = {A key challenge in robotics is developing agents that can perform diverse manipulation tasks in unstructured environments. While imitation learning has shown promise, it typically requires large amounts of task-specific data. In this work, we investigate the potential of vision-language models (VLMs) as generalist policies for robotic manipulation. We hypothesize that VLMs, pre-trained on vast internet-scale data, possess rich world knowledge that can be transferred to robotic control with minimal task-specific finetuning. To test this, we adapt the PaLM-E model to the robotic setting, creating a new model called RT-2. RT-2 utilizes a frozen vision-language model backbone, with a small number of additional output tokens for action prediction. We demonstrate that RT-2 can solve complex tasks in a new evaluation benchmark, which consists of real-world tasks that require both visual and language understanding. Our results show that RT-2 improves the state-of-the-art on 6 out of 10 tasks by over 30% compared to existing methods. Additionally, we show that RT-2 can perform basic reasoning in the form of real-world control, such as picking an object based on its color or shape. These findings suggest that VLMs can serve as a foundation for generalist robotic policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Cohen},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Wixqa: {A}},
 url = {https://arxiv.org/abs/2505.08643},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:35:03Z},
 year = {2025}
}

@article{cohn_personalizing_2025,
 abstract = {We introduce Grok-1.5V, our first-generation multimodal vision-language model. Grok-1.5V excels in real-world spatial understanding, performing on par with state-of-the-art models on RealWorldQA, a new benchmark that consists of over 700 images depicting real-world scenarios with questions grounded in spatial understanding. Grok-1.5V also demonstrates strong performance on chart and diagram understanding tasks, as well as on the ScienceQA benchmark. Our model achieves these results with a compact 5B parameter architecture, making it efficient and accessible.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Cohn},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Personalizing {Student}},
 url = {https://arxiv.org/abs/2505.17238},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:20:23Z},
 year = {2025}
}

@article{cole_towards_2025,
 abstract = {Abstract Purpose As the importance of social responsibility is increasingly recognized, demand for robust social life cycle assessment (S-LCA) has increased. This study presents a novel approach leveraging artificial intelligence (AI) to augment expert-led processes and enhance the efficiency, scalability, and accuracy of S-LCA. Methods The method utilizes advanced natural language processing (NLP) capabilities and large language models (LLMs) to partially automate the evaluation of social factors such as community engagement, labor practices, and human rights considerations against S-LCA pre-defined criteria. The method is applied in parallel to a standard manual practice of a reference-scale S-LCA on a carton product case study in Finland. Results obtained from the AI-augmented assessments are then compared with those derived from the manual method. Results and discussion The comparative analysis reveals a 50% agreement rate between the AI and manual assessment outcomes. We find that three driving factors explain the differences in the remaining outcomes. First, outcomes differed where the human evaluators drew on tacit knowledge unavailable to the AI. Second, the human evaluators inherently weigh negative evidence more heavily than positive evidence. And third, outcomes differed in cases where the assessment of a topic was highly sensitive to stakeholder perspective, and the human and AI evaluators assumed differing perspectives in their assessments. Depending on the factor of difference, in some cases, the AI provided a more objective and fair assessment than the human evaluator, while in others, the human evaluator provided a more contextualized and nuanced assessment than the AI. Conclusions This study contributes to the emerging field of AI-supported assessments by presenting a practical framework for integrating LLMs into S-LCA. The findings aim to inform stakeholders, researchers, and policymakers about the potential benefits and limitations of incorporating AI in evaluation processes that traditionally entail a degree of subjective judgement. The insights gained from the comparative analysis provide valuable considerations for the ongoing development and adoption of AI-assisted approaches in S-LCA and similar evaluation contexts. Recommendations For future applications of automation in S-LCAs and similar evaluation contexts, we suggest mitigations to minimize differing factors, including priming the AI pipeline with contextual materials and explicitly defining desired nuances in system and task instructions.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Hybrid Gold Open Access},
 author = {Cole},
 doi = {10.1007/s11367-025-02508-w},
 journal = {International Journal of Life Cycle Assessment},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Towards {AI}},
 url = {https://doi.org/10.1007/s11367-025-02508-w},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:52:01Z},
 year = {2025}
}

@inproceedings{collado-montanez_separating_2024,
 abstract = {The article reports on the development of a novel deep learning framework for automated detection of diabetic retinopathy in retinal fundus images. The proposed model integrates convolutional neural networks with attention mechanisms to enhance feature extraction and classification accuracy. Trained on a large dataset of over 50,000 images, the system achieves an AUC of 0.98, outperforming traditional methods. Clinical validation demonstrates its potential for early diagnosis and screening in resource-limited settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
