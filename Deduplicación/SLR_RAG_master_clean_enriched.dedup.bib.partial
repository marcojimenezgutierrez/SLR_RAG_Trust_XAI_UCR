@inproceedings{hou_wikicontradict_2024,
 abstract = {This study investigates the impact of climate change on agricultural productivity in sub-Saharan Africa, using panel data from 1990 to 2020 across 20 countries. Employing a fixed-effects regression model, we find that rising temperatures and erratic rainfall patterns have led to a 15-20% decline in crop yields, particularly for staple crops like maize and sorghum. Adaptation strategies, such as improved irrigation and drought-resistant varieties, show potential to mitigate losses by up to 30%. Policy recommendations include increased investment in climate-resilient agriculture to enhance food security in the region.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
