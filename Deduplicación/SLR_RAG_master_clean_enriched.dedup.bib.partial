@article{yang_im-rag_2024,
 abstract = {Large language models (LLMs) can produce biased outputs, raising concerns about their fairness and safety. While prior work has focused on debiasing methods that operate on the model's output, we introduce a novel approach that intervenes during the model's generation process to prevent biased outputs from being produced in the first place. Our method, called Steering, uses a lightweight steering module that is trained to guide the model's hidden states away from biased directions, without requiring access to the model's parameters or retraining. We evaluate Steering on a range of bias benchmarks, including toxicity, gender bias, and political bias, and show that it reduces bias by up to 50% compared to baselines, while preserving the model's performance on downstream tasks. Our approach is model-agnostic, efficient, and easy to deploy, making it a practical solution for mitigating bias in LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
