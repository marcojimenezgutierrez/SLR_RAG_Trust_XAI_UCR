@inproceedings{zachariah_multi-model_2025,
 abstract = {Large language models (LLMs) have demonstrated impressive capabilities in generating human-like responses, but their application in interactive systems, particularly for creative tasks, remains underexplored. In this paper, we investigate how LLMs can facilitate collaborative storytelling between humans and AI. We present StoryWeaver, a prototype system that leverages LLMs to co-create narratives with users in real-time. Through a user study with 24 participants, we evaluate the system's effectiveness in enhancing creativity, engagement, and narrative coherence. Our findings reveal that LLM-assisted storytelling significantly improves user satisfaction and output quality compared to traditional writing tools, while highlighting challenges such as maintaining narrative consistency and handling user intent. We discuss design implications for future human-AI creative collaborations and provide guidelines for integrating LLMs into interactive narrative systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zachariah},
