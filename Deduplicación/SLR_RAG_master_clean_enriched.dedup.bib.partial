@inproceedings{seo_prompt_2025,
 abstract = {Visual Question Answering (VQA) has achieved remarkable progress in recent years, but the fairness issue in VQA has been largely unexplored. In this paper, we conduct a comprehensive study on fairness in VQA. We first build a new VQA dataset with rich fairness annotations, named FairVQA, which contains 12,000 images and 120,000 questions covering different genders, races, and occupations. Then, we propose a fairness-aware VQA framework, which consists of a fairness-aware visual encoder and a fairness-aware question encoder. The visual encoder is designed to extract fairness-related visual features, while the question encoder is designed to extract fairness-related question features. Extensive experiments on FairVQA demonstrate the effectiveness of our framework in improving fairness in VQA.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
