 x_enrich_ts = {2025-11-02T09:30:49Z},
 year = {2025}
}

@article{zhu_halueval-wild_2024,
 abstract = {Generalist robot policies are emerging as a promising paradigm for robot learning, offering the potential to handle diverse tasks with a single policy. However, current approaches often rely on large-scale data collection and compute-intensive training, limiting their accessibility. In this work, we explore transfer learning as a means to develop generalist robot policies more efficiently. We propose a framework that leverages pre-trained vision-language models (VLMs) to guide the learning of robot policies through a two-stage process: (1) a pre-training stage where the policy learns to predict actions from visual observations using VLM-generated pseudo-labels, and (2) a fine-tuning stage where the policy is adapted to specific robotic tasks using real robot data. Our approach enables the policy to acquire broad capabilities from simulation data and transfer them to real-world robotics with minimal fine-tuning. We evaluate our method on a suite of manipulation tasks and demonstrate significant improvements in sample efficiency and generalization compared to baselines. Our results suggest that transfer learning from VLMs can pave the way for more accessible and capable generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhu},
