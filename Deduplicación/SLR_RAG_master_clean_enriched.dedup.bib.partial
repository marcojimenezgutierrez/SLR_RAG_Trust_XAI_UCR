 x_enrich_ts = {2025-11-02T07:54:54Z},
 year = {2024}
}

@article{gu_radalign_2025,
 abstract = {Brain tumor detection at an early stage plays a vital role in saving human lives. Manual detection of brain tumor from MRI images is a very tedious and time-consuming job. In this paper, we propose an efficient method for brain tumor detection using deep learning. The proposed method uses a pre-trained VGG16 model as a feature extractor and a custom classifier for tumor detection. The model is trained on a dataset of brain MRI images and achieves an accuracy of 98.5%. The results show that the proposed method outperforms existing methods in terms of accuracy and computational efficiency.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
