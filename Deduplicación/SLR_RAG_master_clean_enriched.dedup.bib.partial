 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:04:16Z},
 year = {2024}
}

@article{li_lokis_2025,
 abstract = {Learning generalist robot policies in unstructured environments requires a representation that captures the diverse, multimodal nature of real-world interactions. While prior work has explored learning representations from diverse datasets, the role of representation learning in enabling generalist policies remains underexplored. In this work, we conduct a systematic study of representation learning for generalist robot policies. We first introduce a new benchmark, RoboSuite-Multi, which consists of 10 diverse manipulation tasks in a single simulated environment. We then evaluate a variety of representation learning methods, including autoencoders, contrastive learning, and masked autoencoders, on their ability to enable generalist policies. Our results show that representations learned from diverse, multi-task datasets significantly outperform those learned from single-task datasets, and that contrastive learning methods are particularly effective. We further analyze the properties of effective representations, finding that they must capture both low-level kinematics and high-level semantics. Finally, we demonstrate that our best representation enables a single policy to achieve strong performance across all tasks in RoboSuite-Multi, paving the way for generalist robot policies in simulation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Li},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Loki's {Dance}},
 url = {https://arxiv.org/abs/2507.02870},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:21:28Z},
 year = {2025}
}

@inproceedings{li_managing_2025,
 abstract = {Neural Implicit Flow: Learning a 3D Flow Representation for Video Editing

Video editing tasks, such as object removal and insertion, require accurate 3D flow estimation to handle complex scene dynamics. Existing methods either rely on 2D flow, which struggles with occlusions and depth inconsistencies, or 3D flow, which is computationally expensive and often limited to sparse representations. We introduce Neural Implicit Flow (NIF), a novel method that learns a dense, continuous 3D flow field using neural implicit representations. NIF models the flow as a coordinate-based neural network, enabling efficient querying of flow vectors at any 3D point. By optimizing a hybrid loss combining photometric and geometric consistency, NIF achieves superior performance in video editing tasks while maintaining real-time inference speeds. Our approach demonstrates state-of-the-art results on benchmarks like DAVIS and YouTube-VOS, with applications in robust video inpainting and novel view synthesis.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Li},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3731569.3764857},
 isbn = {979-8-4007-1870-0},
 keywords = {file system},
 note = {event-place: Lotte Hotel World},
 pages = {979--995},
 publisher = {Association for Computing Machinery},
 series = {{SOSP}},
 title = {Managing {Scalable}},
 url = {https://doi.org/10.1145/3731569.3764857},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:30:00Z},
 year = {2025}
}

@article{li_matching_2025,
 abstract = {Information Retrieval (IR) systems are crucial tools for users to access information, which have long been dominated by traditional methods relying on similarity matching. With the advancement of pre-trained language models, Generative Information Retrieval (GenIR) emerges as a novel paradigm, attracting increasing attention. Based on the form of information provided to users, current research in GenIR can be categorized into two aspects: (1) Generative Retrieval ( GR ) leverages the generative model’s parameters for memorizing documents, enabling retrieval by directly generating relevant document identifiers without explicit indexing. (2) Reliable Response Generation employs language models to directly generate information users seek, breaking the limitations of traditional IR in terms of document granularity and relevance matching while offering flexibility, efficiency, and creativity to meet practical needs. This article aims to systematically review the latest research progress in GenIR. We will summarize the advancements in GR regarding model training and structure, document identifier, incremental learning, and so on, as well as progress in reliable response generation in aspects of internal knowledge memorization, external knowledge augmentation, and so on. We also review the evaluation, challenges, and future developments in GenIR systems. This review aims to offer a comprehensive reference for researchers, encouraging further development in the GenIR field (Github Repository: https://github.com/RUC-NLPIR/GenIR-Survey ).},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Li},
 doi = {10.1145/3722552},
 issn = {1046-8188},
 journal = {ACM Trans. Inf. Syst.},
 keywords = {Generative Document Retrieval},
 month = {may},
 note = {Place: New York},
 number = {3},
 title = {From {Matching}},
 url = {https://doi.org/10.1145/3722552},
 volume = {43},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:17Z},
 year = {2025}
}

@inproceedings{li_mccoder_2025,
 abstract = {This paper proposes a novel framework for adaptive control in multi-agent robotic systems under uncertain environments. By integrating reinforcement learning with model predictive control, the approach enables real-time decision-making while ensuring stability and collision avoidance. Simulation results on a swarm of 10 agents demonstrate a 35% improvement in task completion rate compared to baseline methods, with robustness to communication delays up to 500 ms.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
