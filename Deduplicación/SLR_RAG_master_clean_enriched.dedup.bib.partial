@inproceedings{wei_large_2025,
 abstract = {Graph Neural Networks (GNNs) have shown great success in various graph-related tasks. However, the black-box nature of GNNs makes it challenging for users to understand and trust their predictions. In this paper, we propose a visual analytics system, GNN-VIS, to help users interpret GNN models for node classification tasks. GNN-VIS integrates multiple visualization techniques to provide insights into the model's predictions at both the global and local levels. Specifically, it offers an overview of the model's performance, a detailed view of individual predictions, and interactive exploration of the graph structure and node features. We evaluate GNN-VIS with real-world datasets and conduct a user study to demonstrate its effectiveness in enhancing model interpretability and user trust. Our results show that GNN-VIS significantly improves users' understanding of GNN predictions compared to baseline methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wei},
