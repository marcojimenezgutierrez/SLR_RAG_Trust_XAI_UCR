@article{shokrnezhad_autonomous_2025,
 abstract = {Generative artificial intelligence (GenAI) has shown great potential in various fields, including communications. In this article, we provide a comprehensive overview of the applications of GenAI in physical layer communications. We first introduce the fundamentals of GenAI and its key models, such as generative adversarial networks (GANs), variational autoencoders (VAEs), and diffusion models. Then, we discuss the potential applications of GenAI in physical layer communications, including channel modeling, signal processing, and resource allocation. We also highlight the challenges and future research directions in this area.},
