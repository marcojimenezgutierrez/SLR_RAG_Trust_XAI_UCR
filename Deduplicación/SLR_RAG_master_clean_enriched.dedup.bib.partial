@article{wilcock_new_2024,
 abstract = {This paper introduces a novel approach to automatic speech recognition (ASR) error correction using large language models (LLMs). We leverage the capabilities of LLMs to correct ASR transcripts by treating the correction task as a text generation problem. Our method involves prompting the LLM with the original ASR output and additional context, such as the audio transcript or related text, to generate corrected versions. Experiments on benchmark datasets demonstrate significant improvements in word error rate (WER) reduction, outperforming traditional post-processing techniques. We also explore the impact of different prompting strategies and model sizes on correction performance.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
