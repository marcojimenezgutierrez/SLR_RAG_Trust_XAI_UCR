@inproceedings{nadel_enabling_2024,
 abstract = {Recent advances in vision-language models (VLMs) have shown remarkable success in various visual tasks. However, these models often inherit and amplify societal biases present in their training data, leading to unfair outcomes in real-world applications. Existing debiasing methods for VLMs are limited in scope and effectiveness, often focusing on specific biases or requiring extensive retraining. In this paper, we propose a novel prompt-based debiasing approach that leverages biased prompts to mitigate bias in VLMs without modifying the model parameters. Our method identifies and generates counterfactual prompts that counteract biased associations in the model's learned representations. We evaluate our approach on multiple benchmarks for gender and racial bias in image captioning and visual question answering tasks. Experimental results demonstrate that our method significantly reduces bias while maintaining overall model performance, outperforming existing debiasing techniques. Our work provides a practical and efficient solution for deploying fairer VLMs in sensitive applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Nadel},
 booktitle = {Practice and {Experience}},
 doi = {10.1145/3626203.3670577},
 isbn = {979-8-4007-0419-2},
 keywords = {High-Performance Computing (HPC)},
 note = {event-place: Providence},
 publisher = {Association for Computing Machinery},
 series = {{PEARC}},
 title = {Enabling access to large-language models ({LLMs}},
 url = {https://doi.org/10.1145/3626203.3670577},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:11:02Z},
