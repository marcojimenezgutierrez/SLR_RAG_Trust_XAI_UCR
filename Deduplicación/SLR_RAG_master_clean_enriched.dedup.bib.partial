 title = {Putting {Things}},
 url = {https://doi.org/10.1145/3613904.3642393},
 we conducted a between-subjects online study (n = {272) featuring different variations of a generative AI vocabulary learning app that enables users to personalize their learning examples. Participants were randomly assigned to control (sentence sourced from pre-existing text) or experimental conditions (generated sentence or short story based on users’ text input). While we did not observe a difference in learning performance between the conditions},
 x_enrich_source = {x-ai/grok-4-fast},
