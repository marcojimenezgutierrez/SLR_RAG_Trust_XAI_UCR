 year = {2024}
}

@inproceedings{kamra_evaluating_2025,
 abstract = {This paper proposes a novel framework for robust inference in networked systems under adversarial conditions. We introduce a distributed optimization algorithm that leverages graph neural networks to enhance resilience against node failures and data poisoning attacks. Through extensive simulations on synthetic and real-world datasets, our approach demonstrates superior performance in terms of convergence speed and accuracy compared to state-of-the-art methods. The results highlight the potential of our framework for applications in IoT and smart grids.},
