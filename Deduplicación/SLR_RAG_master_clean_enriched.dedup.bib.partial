 note = {Publisher: Springer},
 title = {Automatic question answering for the linguistic domain–an evaluation of {LLM}},
 url = {https://doi.org/10.1007/978-3-031-70242-6_16},
 x_enrich_source = {x-ai/grok-4-fast},
