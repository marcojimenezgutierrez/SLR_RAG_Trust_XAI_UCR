 keywords = {large language models},
 note = {event-place: Washington DC},
 pages = {2765--2770},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{MeMemo}},
 url = {https://doi.org/10.1145/3626772.3657662},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:14:33Z},
 year = {2024}
}

@inproceedings{wang_metmap_2024,
 abstract = {Visual recognition models trained on imbalanced datasets often exhibit biased behavior, particularly in gender-related tasks, where performance disparities across demographic groups are common. While prior work has focused on mitigating bias through adversarial training or data augmentation, these methods often compromise overall model accuracy or fail to address the root causes of bias in the training data. In this paper, we propose a comprehensive framework for bias mitigation in visual recognition that combines dataset-level interventions with model-level debiasing techniques. Specifically, we introduce a novel data rebalancing strategy that generates synthetic samples to equalize representation across genders, coupled with a fairness-aware loss function that penalizes biased predictions during training. Our approach is evaluated on standard benchmarks such as CelebA and UTKFace, demonstrating significant reductions in gender bias metrics (e.g., Equalized Odds) while preserving or even improving classification accuracy. We further provide an in-depth analysis of bias sources and ablation studies to highlight the contributions of each component, offering practical insights for deploying fair visual recognition systems in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wang},
