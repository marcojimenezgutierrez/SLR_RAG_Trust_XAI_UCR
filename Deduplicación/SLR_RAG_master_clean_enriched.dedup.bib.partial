 year = {2024}
}

@article{mohammadjafari_natural_2024,
 abstract = {A key challenge in robotics is developing agents that can perform diverse manipulation tasks in unstructured environments. While prior work has explored using large language models (LLMs) for high-level planning, these approaches often struggle with low-level control and real-time execution. In this work, we investigate the use of vision-language models (VLMs) as end-to-end controllers for robotic manipulation. We propose RoboVLM, a framework that fine-tunes open-source VLMs to directly output actions from visual observations and language instructions. By leveraging the rich world knowledge encoded in VLMs, RoboVLM enables zero-shot generalization to novel objects, scenes, and tasks without any robot-specific training data. We evaluate our approach on a range of simulated and real-world manipulation benchmarks, including bin picking, tool use, and multi-step tasks. Our results show that RoboVLM outperforms traditional imitation learning baselines and achieves state-of-the-art performance in zero-shot settings, demonstrating the potential of VLMs for building generalist robotic policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Mohammadjafari},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {From natural language to sql: {Review}},
 url = {https://arxiv.org/abs/2410.01066},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:11:38Z},
 year = {2024}
}

@article{mohammed_aftina_2025,
 abstract = {Abstract Question–answering (QA) systems face considerable challenges when involved in Islamic fatwas due to the complexity and sensitivity of the data. Such problems involve providing accurate and reliable responses, managing hallucinations and inaccurate responses, and maintaining the stability of the generated responses. Prior studies have concentrated mainly on collecting and preprocessing Islamic datasets or developing retrieval-based QA systems, overlooking the precision and reliability required for fatwa issuance. To address this issue, we propose a QA approach utilizing advanced retrieval-augmented generation (RAG), which is enhanced by a re-ranker to increase response stability, eliminate hallucinations, and prioritize the most appropriate and exact answer. This enhancement significantly improves response stability and reduces hallucinations by improving the data used for answer generation. We conducted experiments across three setups: (1) base LLM, (2) LLM with RAG, and (3) LLM with RAG and re-ranker. The third method of LLM with RAG includes a re-ranker for knowledge retrieval, which improves the process and ensures relevant and trustworthy data. This differentiates it from the second method, which uses a retrieval model. The Flash re-ranker retrieves the most relevant data, which increases the response stability and trustworthiness. Evaluations using BERTScore, hallucination, completeness, and irrelevance metrics demonstrated that the third experiment LLM with RAG and re-ranker outperformed other setups, providing precise, stable, and dependable answers. This research contributes a robust methodology to improve AI-driven fatwa systems, guaranteeing higher precision and trustworthiness in Islamic QA systems.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Mohammed},
 doi = {10.1007/s00521-025-11229-y},
 journal = {Neural Computing and Applications},
 keywords = {source: Google Scholar},
 note = {Type: Article},
 number = {25},
 pages = {20957 -- 20982},
 title = {Aftina: enhancing stability and preventing hallucination in {AI}},
 url = {https://doi.org/10.1007/s00521-025-11229-y},
 volume = {37},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:21:05Z},
 year = {2025}
}

@article{mohammed_diabetiq_nodate,
 abstract = {Diabetes management is a complex and ongoing challenge that requires personalized monitoring, timely interventions, and accessible educational resources. Traditional approaches often fall short in providing real-time, adaptive support to patients. To address this, we present DiabetIQ, an intelligent diabetes management application that integrates advanced artificial intelligence technologies for enhanced user experience and health outcomes. At its core, DiabetIQ features a Retrieval-Augmented Generation (RAG) chatbot powered by Large Language Models (LLMs), which retrieves relevant medical knowledge from trusted databases and generates contextually accurate responses to user queries on topics such as insulin dosing, dietary recommendations, symptom management, and complication prevention. This LLM-augmented RAG system ensures responses are both informative and reliable, minimizing hallucinations common in standalone LLMs. Complementing the chatbot, DiabetIQ incorporates machine learning (ML) models for early risk prediction, utilizing user-input data—including blood glucose readings, physical activity logs, dietary habits, and vital signs—to forecast potential risks like hypoglycemia, hyperglycemia, or long-term complications such as neuropathy or cardiovascular events. The ML pipeline employs ensemble techniques, including Random Forest and Gradient Boosting Machines, trained on diverse datasets to achieve high predictive accuracy (AUC > 0.92). Through a user-friendly interface, DiabetIQ promotes proactive self-management, seamless integration with wearable devices, and personalized alerts. Preliminary user studies with 50 diabetic participants showed a 35% improvement in adherence to management protocols and a 28% reduction in unplanned medical visits. DiabetIQ represents a step forward in AI-driven healthcare, offering scalable, empathetic support for diabetes care in resource-limited settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Mohammed},
 journal = {researchgate.net},
 keywords = {source: Google Scholar},
 note = {Type: PDF},
 title = {{DiabetIQ}},
 url = {https://www.researchgate.net/profile/Saif-Mohammed-18/publication/391479329_DiabetIQ_An_Intelligent_Diabetes_Management_Application_with_an_Integrated_LLM-Augmented_RAG_Chatbot_and_ML-Based_Risk_Early_Prediction/links/6819c216df0e3f544f52211e/DiabetIQ-An-Intelligent-Diabetes-Management-Application-with-an-Integrated-LLM-Augmented-RAG-Chatbot-and-ML-Based-Risk-Early-Prediction.pdf},
