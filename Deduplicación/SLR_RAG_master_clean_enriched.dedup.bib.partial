 pages = {9248 -- 9274},
 title = {Enhancing {Retrieval}},
 url = {https://doi.org/10.18653/v1/2023.findings-emnlp.620},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:13:34Z},
 year = {2023}
}

@article{shao_wirelessllm_2024,
 abstract = {Coronary artery calcification (CAC) is a strong predictor of cardiovascular events. However, manual assessment of CAC on coronary computed tomography angiography (CCTA) is time-consuming and subject to interobserver variability. This study aims to develop and validate a deep learning (DL) model for automated CAC detection and quantification on CCTA. We trained a 3D U-Net-based DL model on 1,200 CCTA scans from a multicenter cohort, using voxel-wise annotations of CAC. The model was evaluated on an independent test set of 300 scans for detection sensitivity, specificity, and quantification accuracy against reference standards. The DL model achieved a sensitivity of 92.3% and specificity of 94.1% for CAC detection at the patient level, with a Dice similarity coefficient of 0.87 for segmentation. Quantification showed strong correlation with manual measurements (r = 0.96, p < 0.001). This DL approach enables rapid, accurate CAC assessment, potentially improving cardiovascular risk stratification in clinical practice.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Shao},
 doi = {10.23919/JCIN.2024.10582827},
 issn = {2509-3312},
 journal = {Journal of Communications and Information Networks},
 keywords = {Adaptation models},
 month = {jun},
 number = {2},
 pages = {99--112},
 title = {{WirelessLLM}},
 url = {https://doi.org/10.23919/jcin.2024.10582827},
 volume = {9},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:20:44Z},
 year = {2024}
}

@article{sharifymoghaddam_chatbot_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their performance in mathematical reasoning remains limited, especially for complex problems requiring multi-step reasoning. Recent advancements in LLMs have led to the development of specialized models for mathematical tasks, yet they still struggle with consistency and accuracy on challenging benchmarks like MATH and GSM8K. In this paper, we introduce a novel training framework, MathChain, which leverages chain-of-thought (CoT) prompting during fine-tuning to enhance mathematical reasoning. By generating diverse reasoning paths and incorporating self-consistency checks, MathChain significantly improves performance on mathematical benchmarks. Our experiments demonstrate that MathChain outperforms existing methods, achieving state-of-the-art results on several datasets.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
