@article{seabra_enhancing_2025,
 abstract = {This paper proposes a novel framework for enhancing the interpretability of deep learning models in medical image analysis, specifically for chest X-ray interpretation in the context of COVID-19 diagnosis. We integrate attention mechanisms with gradient-based visualization techniques to provide both global and local explanations of model predictions. The framework is evaluated on the COVID-19 Radiography Database, demonstrating improved accuracy and user trust compared to black-box models. Our approach not only aids clinicians in decision-making but also facilitates regulatory compliance in AI-driven healthcare applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
