@inproceedings{ranade_fabula_2024,
 abstract = {Deep learning models for vision tasks have achieved remarkable performance in recent years. However, they often exhibit biases toward certain demographic groups, leading to unfair outcomes in real-world applications. Existing debiasing methods for vision-language models (VLMs) typically require access to the model's parameters or training data, which is impractical for large-scale proprietary models. In this paper, we propose a simple yet effective debiasing method for VLMs that only requires a small number of biased prompts. Our method, termed Biased Prompts Debiasing (BPD), identifies biased prompts by analyzing the model's attention maps and then fine-tunes the model using a contrastive loss to reduce the bias. Extensive experiments on multiple VLMs and datasets demonstrate that BPD significantly reduces bias while maintaining the model's performance on downstream tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Ranade},
 booktitle = {Proceedings of the 2023 {IEEE}},
 doi = {10.1145/3625007.3627505},
