@inproceedings{rahimi_user-vlm_2025,
 abstract = {Visual programming languages (VPLs) have long promised to make programming more accessible by allowing users to create programs visually, without writing code. Despite their potential, VPLs have not achieved widespread adoption. We hypothesize that this is due to a lack of understanding of the design space of VPLs and the needs of their users. To address this, we conducted a systematic literature review of 50 VPLs and a user study with 20 participants to understand the design space and user needs. We identified key design dimensions, including representation, interaction, and abstraction, and found that users value expressiveness, learnability, and error handling. Based on our findings, we propose a set of design guidelines for VPLs and discuss implications for future research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Rahimi},
 booktitle = {Proceedings of the 27th {International}},
