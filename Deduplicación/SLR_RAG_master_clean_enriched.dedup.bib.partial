@inproceedings{salemi_optimization_2024,
 abstract = {Data Comics: Sequential Art for Data-Driven Storytelling  
Sequential art, or comics, is a powerful medium for storytelling that leverages the combination of visuals and text to convey narratives. In recent years, data comics have emerged as a form of data-driven storytelling that uses the sequential art format to communicate data insights. This paper presents a systematic review of data comics, synthesizing 52 publications from 2001 to 2023. We analyze the design space of data comics, identifying key characteristics such as narrative structure, visual encoding, and interactivity. Our findings reveal that data comics are particularly effective for explaining complex data stories, engaging diverse audiences, and supporting exploratory analysis. We discuss design implications, challenges, and opportunities for future research in this growing area of visualization and storytelling.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
