@inproceedings{zaslavsky_enhancing_2024,
 abstract = {Neural Radiance Fields (NeRFs) have shown remarkable success in novel view synthesis and 3D reconstruction from multi-view images. However, they require dense input views for high-quality results and often fail to generalize to new scene categories. In this work, we present a method for learning category-level NeRF priors from a large collection of 3D scans of objects from a specific category. Our approach leverages a neural network to predict a continuous volumetric radiance field from a single input view, enabling high-quality 3D reconstruction and novel view synthesis for objects in the category. We demonstrate that our method can generalize to unseen objects, producing realistic 3D models and novel views even from a single image. Our approach significantly outperforms existing methods in terms of reconstruction quality and generalization ability.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
