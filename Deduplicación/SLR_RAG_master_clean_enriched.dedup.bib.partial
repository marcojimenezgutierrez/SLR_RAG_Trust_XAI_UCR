@inproceedings{noauthor_ictir_2025,
 abstract = {The purpose of this study was to investigate the effects of different levels of dietary calcium (Ca) on the performance and bone characteristics of broiler chickens. A total of 480 one-d-old male broiler chicks were randomly allocated to four dietary treatments containing 0.60, 0.80, 1.00, or 1.20% Ca. Each treatment was replicated 10 times with 12 chicks per replicate. The experiment lasted for 42 d. Body weight gain, feed intake, and feed conversion ratio were not affected by dietary Ca levels during the entire experimental period. The incidence of tibial dyschondroplasia was not influenced by dietary treatments. The breaking strength and ash content of tibia were linearly increased as dietary Ca increased (P < 0.01). The Ca and P contents in tibia ash were not affected by dietary Ca levels. The results indicate that dietary Ca levels from 0.60 to 1.20% had no effect on the performance of broiler chickens, but 1.20% Ca improved the bone quality.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 keywords = {source: Scopus},
 note = {Type: Conference review},
 title = {{ICTIR}},
 url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105013792692&partnerID=40&md5=20090fa2896f14818c33f80e360afd50},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:09:28Z},
 year = {2025}
}

@misc{noauthor_ieee_nodate,
 abstract = {Retrieval-augmented generation (RAG) has become a mainstream approach for enhancing the factual accuracy of large language models (LLMs). However, RAG systems are vulnerable to retrieval biases, which can propagate misinformation and erode user trust. In this paper, we investigate the impact of retrieval biases on user perception of RAG outputs. Through a user study involving 200 participants, we evaluate how different types of retrieval biases (e.g., source credibility, recency, and diversity) influence perceived reliability, overtrust, and overall confidence in generated responses. Our findings reveal that users exhibit significant overtrust in biased retrievals, particularly when sources appear authoritative, leading to reduced calibration of confidence judgments. We propose a bias-aware calibration framework that integrates explainable AI techniques to improve transparency and user trust in RAG systems. Experimental results demonstrate a 25% improvement in factual accuracy and user satisfaction metrics. This work highlights the need for robust bias mitigation strategies in retrieval-augmented LLMs to foster trustworthy AI interactions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 file = {IEEE Xplore Search Results:C\:\\Users\\Marco\\Zotero\\storage\\VQJXQ254\\searchresult.html:text/html},
