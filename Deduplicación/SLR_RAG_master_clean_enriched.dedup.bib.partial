@article{yu_evaluating_2025,
 abstract = {This article presents a bibliometric analysis of the intersection between cybersecurity and development, focusing on academic literature from 2000 to 2023. Using data from Scopus and Web of Science, we identify key trends, influential authors, institutions, and countries contributing to this field. The analysis reveals a growing interest in topics such as digital security in developing economies, cyber threats to sustainable development goals, and policy frameworks for inclusive cybersecurity. Network visualizations highlight clusters around human-centric approaches, technological innovations, and governance issues. Findings underscore the need for more interdisciplinary research to address global disparities in cybersecurity capacity, particularly in the Global South. This study provides a foundational overview for scholars and policymakers aiming to advance equitable digital development.},
