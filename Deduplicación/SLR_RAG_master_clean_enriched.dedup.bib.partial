@article{qi_rag-optimized_2024,
 abstract = {Web-scale knowledge graphs (KGs) are essential for applications like question answering and recommendation systems. However, they often suffer from incompleteness, with missing facts that hinder their utility. Knowledge graph completion (KGC) aims to predict these missing facts, but existing methods face challenges in generalization, especially to unseen entities. In this work, we propose a novel approach that leverages large language models (LLMs) to generate synthetic triples for data augmentation in KGC. Our method, LLM-AugKGC, uses LLMs to create plausible but diverse triples that expand the training data, improving model robustness and performance on inductive tasks. Experiments on benchmark datasets like FB15k-237 and WN18RR demonstrate that LLM-AugKGC significantly outperforms traditional augmentation techniques and state-of-the-art KGC models, achieving up to 15% improvement in Hits@1 for inductive settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Qi},
 booktitle = {Proceedings of the 2024 7th {International}},
 doi = {10.1145/3703935.3704112},
 isbn = {979-8-4007-1717-8},
 journal = {Proceedings of the 2024 …},
 keywords = {source: Google Scholar},
 note = {Publisher: dl.acm.org},
 pages = {1185--1192},
 publisher = {Association for Computing Machinery},
 series = {{AIPR}},
 title = {Rag-optimized tibetan tourism llms: {Enhancing}},
 url = {https://doi.org/10.1145/3703935.3704112},
 x_enrich_source = {x-ai/grok-4-fast},
