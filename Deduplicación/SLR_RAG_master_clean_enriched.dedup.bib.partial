 keywords = {Food Recommendation},
 note = {event-place: Bari},
 pages = {1057--1061},
 publisher = {Association for Computing Machinery},
 series = {{RecSys}},
 title = {Recommending {Healthy}},
 url = {https://doi.org/10.1145/3640457.3688193},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:14:10Z},
 year = {2024}
