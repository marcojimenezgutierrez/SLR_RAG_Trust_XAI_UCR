@article{wang_financial_2025,
 abstract = {We introduce a new benchmark for evaluating the ability of vision-language models (VLMs) to perform visual reasoning. Our benchmark, Visual Reasoning Evaluation (VRE), consists of a diverse set of visual reasoning tasks that require understanding complex spatial relationships, counting, and logical inference. Unlike existing benchmarks that focus primarily on simple image captioning or visual question answering, VRE emphasizes multi-step reasoning over visual content. We evaluate several state-of-the-art VLMs on VRE and find that while they excel at basic perception, their performance on advanced reasoning tasks remains limited. To address this, we propose a novel training approach that incorporates synthetic visual reasoning data generated via procedural rendering. Our method improves VLM performance on VRE by up to 15% without requiring additional real-world data. We release the VRE benchmark and our synthetic dataset to facilitate further research in visual reasoning for VLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wang},
 journal = {arXiv preprint arXiv:2504.06279},
 keywords = {source: Google Scholar},
