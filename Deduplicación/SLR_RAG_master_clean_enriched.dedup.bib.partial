@inproceedings{yang_evaluation_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but they often exhibit biases that can lead to unfair or harmful outputs. Fine-tuning LLMs on specific datasets can amplify these biases, particularly when the data is imbalanced or reflects societal prejudices. In this paper, we propose a novel framework for fair fine-tuning of LLMs that integrates debiasing techniques during the adaptation process. Our approach combines adversarial training with fairness-aware loss functions to mitigate biases related to gender, race, and other protected attributes. We evaluate our method on benchmark datasets such as GLUE and SuperGLUE, demonstrating significant improvements in fairness metrics while maintaining or enhancing overall performance. Our results highlight the importance of incorporating fairness considerations early in the fine-tuning pipeline to ensure equitable AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Yang},
