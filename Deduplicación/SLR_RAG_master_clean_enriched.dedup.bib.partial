@inproceedings{li_knowledge_2025-1,
 abstract = {This paper proposes a novel framework for enhancing security in Internet of Things (IoT) devices using artificial intelligence techniques. We address the challenges of resource-constrained environments by integrating lightweight machine learning models with blockchain for secure data transmission. Experimental results on a simulated IoT network demonstrate a 30% improvement in detection accuracy for cyber threats compared to traditional methods, while maintaining low computational overhead. The framework is evaluated across various attack scenarios, showing robustness and scalability for real-world deployment.},
