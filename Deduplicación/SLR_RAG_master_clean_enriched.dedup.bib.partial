@article{kamra_evaluating_2025-1,
 abstract = {This paper proposes a novel federated learning framework for Internet of Things (IoT) devices, addressing the challenges of data privacy and communication efficiency in edge computing environments. We introduce a differential privacy mechanism integrated with a lightweight aggregation protocol to mitigate the risks of data leakage while reducing the communication overhead. Extensive simulations on real-world IoT datasets demonstrate that our approach achieves up to 30% improvement in model accuracy compared to baseline federated learning methods, with minimal privacy loss. The framework is designed to be deployable on resource-constrained devices, making it suitable for practical IoT applications such as smart homes and industrial monitoring.},
