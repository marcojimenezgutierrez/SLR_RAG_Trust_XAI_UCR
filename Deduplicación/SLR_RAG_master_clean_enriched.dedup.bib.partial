@article{dehbozorgi_personalized_2024,
 abstract = {This chapter introduces a novel framework for enhancing the interpretability of deep learning models in the context of cybersecurity threat detection. By integrating attention mechanisms with post-hoc explanation techniques, our approach provides both global and local explanations for model predictions on network traffic data. Experimental results on benchmark datasets demonstrate improved accuracy and user trust compared to traditional black-box models. We discuss implications for real-world deployment in intrusion detection systems and outline future research directions toward fully explainable AI in security applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
