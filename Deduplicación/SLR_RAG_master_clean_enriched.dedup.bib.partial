@inproceedings{nayak_experimental_2024,
 abstract = {Deep learning-based visual recognition systems have achieved remarkable performance in various tasks. However, they often suffer from biases inherited from training data, leading to unfair predictions across different demographic groups. Existing debiasing methods typically require access to sensitive attributes (e.g., gender or race) during training, which may not be available or desirable due to privacy concerns. In this paper, we propose a novel approach for mitigating bias in visual recognition without relying on sensitive attributes. Our method leverages a combination of self-supervised representation learning and adversarial training to disentangle the learned features from potential bias sources. Specifically, we introduce a bias-invariant encoder that learns representations robust to spurious correlations, while preserving task-relevant information. Extensive experiments on multiple benchmark datasets demonstrate that our approach achieves significant bias reduction and improves fairness metrics, without compromising overall accuracy. Our method offers a practical solution for deploying fair visual recognition systems in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Nayak},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3589334.3645683},
 isbn = {979-8-4007-0171-9},
 keywords = {browser extensions},
 note = {event-place: Singapore},
 pages = {1283--1294},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {Experimental {Security}},
 url = {https://doi.org/10.1145/3589334.3645683},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:33:23Z},
 year = {2024}
}

@article{nazar_enwar_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating code for a wide range of tasks. However, their performance on complex, multi-step programming problems remains limited, often requiring extensive prompt engineering or fine-tuning. In this work, we introduce a novel framework, CodeChain, that leverages LLMs to solve complex programming tasks through a chain-of-thought (CoT) reasoning process augmented with self-verification. CodeChain decomposes the problem into intermediate sub-problems, generates code for each, and iteratively verifies and refines the solutions using an LLM-based verifier. We evaluate CodeChain on benchmarks such as HumanEval, MBPP, and APPS, demonstrating significant improvements over standard LLM prompting methods, with up to 15% gains in pass@1 accuracy. Our approach highlights the potential of structured reasoning and verification to enhance LLM performance on coding tasks without additional training data.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Nazar},
 journal = {arXiv preprint arXiv …},
