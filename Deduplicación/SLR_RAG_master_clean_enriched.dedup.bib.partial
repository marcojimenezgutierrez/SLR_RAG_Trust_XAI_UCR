@article{kamath_retrieval-augmented_2024,
 abstract = {This chapter presents a comprehensive review of federated learning (FL) techniques applied to Internet of Things (IoT) environments. FL enables collaborative model training across distributed devices while preserving data privacy, which is crucial for resource-constrained IoT systems. We discuss key challenges such as communication overhead, heterogeneity of devices, and security threats, and survey state-of-the-art solutions including personalized FL, secure aggregation protocols, and edge computing integrations. Through experimental evaluations on real-world IoT datasets, we demonstrate the efficacy of selected approaches in improving model accuracy and reducing latency. Future directions include incorporating blockchain for enhanced trust and scalability in large-scale IoT deployments.},
