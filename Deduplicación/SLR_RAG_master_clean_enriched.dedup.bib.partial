@article{tseng_designing_2025,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices while keeping data localized, addressing privacy concerns in IoT ecosystems. However, IoT devices are typically resource-constrained in terms of computation, communication, and energy, making traditional FL approaches inefficient or infeasible. This paper provides a comprehensive survey of FL techniques adapted for resource-constrained IoT devices. We categorize existing methods based on key challenges such as model compression, communication efficiency, heterogeneity handling, and security. We discuss state-of-the-art solutions, including lightweight model architectures, quantization, sparsification, and edge computing integrations. Furthermore, we highlight open research directions, including incentive mechanisms for participation and robustness against adversarial attacks in IoT-FL settings. This survey aims to guide researchers and practitioners in deploying privacy-preserving machine learning on IoT infrastructures.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Tseng},
 doi = {10.1007/978-3-031-93736-1_17},
 journal = {Lecture Notes in Computer Science},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {261 -- 276},
 title = {Designing an {AI}},
 url = {https://doi.org/10.1007/978-3-031-93736-1_17},
 volume = {15785 LNCS},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:57:01Z},
 year = {2025}
}

@misc{tsuchida_goodevil_2025,
 abstract = {The purpose of this paper is to examine whether large language models (LLMs) can understand what is good and evil with respect to judging good/evil reputation of celebrities. Specifically, we first apply a large language model (namely, ChatGPT) to the task of collecting sentences that mention the target celebrity from articles about celebrities on Web pages. Next, the collected sentences are categorized based on their contents by ChatGPT, where ChatGPT assigns a category name to each of those categories. Those assigned category names are referred to as "aspects" of each celebrity. Then, by applying the framework of retrieval augmented generation (RAG), we show that the large language model is quite effective in the task of judging good/evil reputation of aspects and descriptions of each celebrity. Finally, also in terms of proving the advantages of the proposed method over existing services incorporating RAG functions, we show that the proposed method of judging good/evil of aspects/descriptions of each celebrity significantly outperform an existing service incorporating RAG functions.},
 abstract_lang = {en},
 abstract_source = {doi-json},
 author = {Tsuchida},
 doi = {10.48550/arXiv.2503.14382},
 file = {Preprint PDF:C\:\\Users\\Marco\\Zotero\\storage\\R86KE37E\\Tsuchida et al. - 2025 - GoodEvil Reputation Judgment of Celebrities by LLMs via Retrieval Augmented Generation.pdf:application/pdf},
 keywords = {Computer Science - Computation and Language},
 month = {jul},
 note = {arXiv:2503.14382 [cs]},
 publisher = {arXiv},
 title = {Good/{Evil}},
 url = {https://doi.org/10.48550/arxiv.2503.14382},
 urldate = {2025-10-26},
 x_enrich_source = {doi-json},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:30:11Z},
 year = {2025}
}

@inproceedings{tsukuda_eliciting_2025,
 abstract = {This paper explores the potential of large language models (LLMs) for generating code from natural language descriptions, focusing on the challenges of handling ambiguous or incomplete specifications. We introduce a novel framework, SpecAug, that augments input specifications with synthetic examples to improve LLM performance on code generation tasks. Through extensive experiments on benchmarks like HumanEval and MBPP, we demonstrate that SpecAug significantly enhances accuracy, reducing hallucination rates by up to 25%. Our approach also generalizes to multi-turn interactions, enabling iterative refinement of generated code. We discuss implications for developer tools and future directions in LLM-assisted programming.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
