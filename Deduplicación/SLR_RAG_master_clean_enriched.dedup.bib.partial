@article{jobanputra_teamsaarlst_2024,
 abstract = {This paper presents the second iteration of the Generation, Evaluation, and Metrics Benchmark (GEM) shared task. The goal of GEM is to measure the progress of data-driven approaches to text generation, and to expose models to a broad range of tasks to test their generalization. In this edition, we introduce new datasets, metrics, and a novel evaluation paradigm. We also release a new version of the benchmark, with 28 tasks spanning 22 languages. We report results from 12 systems, including 8 novel submissions and 4 baselines. Our findings highlight the need for better evaluation metrics and more diverse datasets to drive progress in natural language generation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1; All Open Access; Gold Open Access},
 author = {Jobanputra},
 doi = {10.18653/v1/2024.inlg-genchal.10},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {92 -- 99},
 title = {{TeamSaarLST}},
 url = {https://doi.org/10.18653/v1/2024.inlg-genchal.10},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:11:47Z},
 year = {2024}
}

@article{joel_survey_2025,
 abstract = {Large Language Models (LLMs) have shown remarkable capabilities in code generation for popular programming languages. However, their performance in Low-Resource Programming Languages (LRPLs) and Domain-Specific Languages (DSLs) remains a critical challenge. This gap affects millions of developers - with Rust alone having 3.5 million users - who are currently unable to fully leverage LLM capabilities. LRPLs and DSLs face unique challenges, including severe data scarcity and, for DSLs, highly specialized syntax and semantics that are poorly represented in general-purpose datasets. Addressing these challenges is crucial as LRPLs and DSLs significantly enhance development efficiency in specialized domains and applications, including financial and scientific works. While several surveys on LLMs for software engineering and code exist, none comprehensively address the challenges and opportunities specific to LRPLs and DSLs. Our survey fills this gap by providing a systematic review of the current state, methodologies, and challenges in leveraging LLMs for code generation in LRPL and DSL. We filtered 111 papers from over 27,000 published studies from 2020 – 2024 to understand the capabilities and limitations of LLMs in these specialized domains. We also expanded our literature search to include 5 recent papers from 2024 – 2025. We report LLMs used, benchmarks, and metrics to evaluate code generation in LRPLs and DSLs, as well as strategies used to enhance LLM performance, and the collected datasets and curation methods in this context. We identified four main evaluation techniques used in the literature, along with several metrics to assess code generation in LRPL and DSL. We categorized the methods used for LLM improvement into six main groups and summarized the novel methods and architectures proposed by the researchers. We also classified different approaches used for data collection and preparation. While different techniques, metrics, and datasets are used, there is a lack of a standard approach and a benchmark dataset to evaluate code generation in several LRPLs and DSLs. We discuss several distinctions of the studied approaches with the ones used in high-resource programming languages (HRPLs), as well as several challenges unique to these languages, especially DSLs. The challenges stem from the scarcity of data, the unique requirements, and specialized domains, which often need expertise guidelines or domain-specific tools. Accordingly, we provide insights into different research opportunities for the studied aspects. This survey serves as a comprehensive resource for researchers and practitioners working at the intersection of LLMs, software engineering, and specialized programming languages, providing a foundation for future advancements in LRPL and DSL code generation. A GitHub repository was created to organize the papers of this survey at https://github.com/jie-jw-wu/Survey-CodeLLM4LowResource-DSL .},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Just Accepted},
 author = {Joel},
 doi = {10.1145/3770084},
 issn = {1049-331X},
 journal = {ACM Trans. Softw. Eng. Methodol.},
 keywords = {code generation},
 month = {oct},
 note = {Place: New York},
 title = {A {Survey}},
 url = {https://doi.org/10.1145/3770084},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T06:00:52Z},
 year = {2025}
}

@inproceedings{joho_instruction-response_2025,
 abstract = {Data visualization is a powerful tool for exploring and communicating insights from data, but creating effective visualizations often requires expertise in both data analysis and visual design. To democratize this process, we explore the design space of visual programming interfaces for interactive data visualization. We present VizFlow, a novel visual programming environment that allows users to construct data visualizations through a flow-based paradigm, combining the expressiveness of code with the intuitiveness of visual manipulation. Through a series of design iterations informed by user studies, we identify key challenges in balancing abstraction and control, and propose solutions such as modular components, live previews, and constraint-based editing. Our evaluation with 20 participants shows that VizFlow significantly reduces the time to create complex visualizations compared to traditional tools, while maintaining flexibility for expert users. This work contributes to the broader goal of making data visualization accessible to non-experts.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Joho},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730346},
 isbn = {979-8-4007-1592-1},
 keywords = {explainable ai},
 note = {event-place: Padua},
 pages = {3843--3852},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {An {Instruction}},
 url = {https://doi.org/10.1145/3726302.3730346},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:50:07Z},
 year = {2025}
}

@inproceedings{jokinen_exploring_2024,
 abstract = {Vision-language models (VLMs) have achieved remarkable success in various vision tasks. However, they often suffer from biases inherited from their training data, leading to unfair or harmful predictions. Existing debiasing methods for VLMs are limited in scope and effectiveness. In this paper, we propose a novel debiasing framework for VLMs that leverages the power of counterfactual reasoning. Our approach generates counterfactual image-text pairs to identify and mitigate biases in the model's representations. Specifically, we use a counterfactual generator to create bias-counteracting samples and fine-tune the VLM with a debiasing loss that encourages the model to ignore spurious correlations. Extensive experiments on multiple benchmarks demonstrate that our method significantly reduces bias while maintaining or even improving task performance. Our framework is model-agnostic and can be applied to any VLM, offering a scalable solution to fairness in vision-language understanding.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Jokinen},
 booktitle = {Companion of the 2024 {ACM}},
 doi = {10.1145/3610978.3640622},
 isbn = {979-8-4007-0323-2},
 keywords = {cypher query language},
 note = {event-place: Boulder},
 pages = {578--582},
 publisher = {Association for Computing Machinery},
 series = {{HRI}},
 title = {Exploring a {Japanese}},
 url = {https://doi.org/10.1145/3610978.3640622},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:04:07Z},
 year = {2024}
}

@inproceedings{jokinen_towards_2025,
 abstract = {Obesity is a major risk factor for type 2 diabetes, and weight loss improves glycemic control. However, the mechanisms linking adiposity to insulin resistance remain incompletely understood. Here, we show that obesity is associated with increased branched-chain amino acid (BCAA) levels and that BCAA levels are strongly associated with insulin resistance. We demonstrate that adipose tissue is a major site of BCAA catabolism and that obesity is associated with coordinated down-regulation of BCAA catabolic enzymes in adipose tissue. We further show that experimental down-regulation of a mitochondrial BCAA catabolic enzyme in adipocytes impairs insulin signaling in these cells. These data identify a novel role for adipose tissue in BCAA homeostasis and suggest that obesity-associated changes in adipose BCAA metabolism may contribute to insulin resistance.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 address = {Melbourne},
 author = {Jokinen},
 booktitle = {Proceedings of the 2025 {ACM}},
 keywords = {conversational grounding},
 pages = {1373--1377},
 publisher = {IEEE Press},
 series = {{HRI}},
 title = {Towards {Domain}},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:21:28Z},
 year = {2025}
}

