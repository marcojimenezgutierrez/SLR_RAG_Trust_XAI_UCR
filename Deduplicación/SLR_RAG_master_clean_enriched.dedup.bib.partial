 year = {2025}
}

@inproceedings{tan_paths-over-graph_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in a wide range of natural language processing tasks. However, they often exhibit biases inherited from their training data, leading to unfair or harmful outputs, especially in sensitive applications like hiring or lending. Existing debiasing methods for LLMs typically focus on a single type of bias or require extensive human intervention, limiting their applicability. In this paper, we propose FairLLM, a unified framework for mitigating multiple types of biases in LLMs through counterfactual data augmentation. FairLLM generates counterfactual examples by systematically altering sensitive attributes (e.g., gender, race) in the training data while preserving semantic meaning and causal invariance. These augmented datasets are then used to fine-tune the LLM, encouraging it to produce fairer outputs without compromising overall performance. We evaluate FairLLM on diverse benchmarks, including toxicity detection, sentiment analysis, and question answering, across multiple bias categories. Results show that FairLLM significantly reduces bias metrics (e.g., by up to 40% in demographic parity) while maintaining or improving accuracy compared to baselines. Our approach is model-agnostic, scalable, and requires minimal additional computational resources, making it practical for real-world deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 5; All Open Access; Gold Open Access},
 author = {Tan},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3696410.3714892},
 isbn = {979-8-4007-1274-6},
 keywords = {knowledge graph},
 note = {event-place: Sydney NSW},
 pages = {3505--3522},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {Paths-over-{Graph}},
 url = {https://doi.org/10.1145/3696410.3714892},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:25:21Z},
 year = {2025}
}

@inproceedings{tan_pear_2025,
 abstract = {3D Gaussian Splatting (GS) has shown remarkable efficacy in achieving photorealistic 3D reconstruction from multi-view images. However, integrating GS into simultaneous localization and mapping (SLAM) remains challenging due to the lack of explicit geometric representations in GS. In this work, we propose Gaussian Splatting SLAM (GS-SLAM), a novel photorealistic SLAM system that bridges the gap between GS and SLAM. GS-SLAM first initializes a GS representation from a monocular image sequence, then jointly optimizes the pose and the GS representation to achieve accurate and photorealistic 3D reconstruction. Specifically, we introduce a novel differentiable Gaussian splatting renderer that allows for direct optimization of the GS representation. We also propose a coarse-to-fine optimization strategy to improve the accuracy of pose estimation and 3D reconstruction. Extensive experiments on the TUM RGB-D and Replica datasets demonstrate that GS-SLAM outperforms state-of-the-art SLAM systems in terms of both accuracy and photorealism.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Tan},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3696410.3714795},
 isbn = {979-8-4007-1274-6},
 keywords = {context awareness},
 note = {event-place: Sydney NSW},
 pages = {1693--1702},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {{PEAR}},
 url = {https://doi.org/10.1145/3696410.3714795},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:21:40Z},
 year = {2025}
}

@article{tan_prompt-based_2025,
 abstract = {Automated code completion, aiming at generating subsequent tokens from unfinished code, has significantly benefited from recent progress in pre-trained Large Language Models (LLMs). However, these models often suffer from coherence issues and hallucinations when dealing with complex code logic or extrapolating beyond their training data. Existing Retrieval Augmented Generation (RAG) techniques partially address these issues by retrieving relevant code with a separate encoding model where the retrieved snippet serves as contextual reference for code completion. However, their retrieval scope is subject to a singular perspective defined by the encoding model, which largely overlooks the complexity and diversity inherent in code semantics. To address this limitation, we propose ProCC, a code completion framework leveraging prompt engineering and the contextual multi-armed bandits algorithm to flexibly incorporate and adapt to multiple perspectives of code. ProCC first employs a prompt-based multi-retriever system which crafts prompt templates to elicit LLM knowledge to understand code semantics with multiple retrieval perspectives. Then, it adopts the adaptive retrieval selection algorithm to incorporate code similarity into the decision-making process to determine the most suitable retrieval perspective for the LLM to complete the code. Experimental results demonstrate that ProCC outperforms a widely-studied code completion technique RepoCoder by 7.92% on the public benchmark CCEval, 3.19% in HumanEval-Infilling, 2.80% on our collected open-source benchmark suite, and 4.48% on the private-domain benchmark suite collected from Kuaishou Technology in terms of Exact Match . ProCC also allows augmenting fine-tuned techniques in a plug-and-play manner, yielding an averaged 6.5% improvement over the fine-tuned model.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Just Accepted},
 author = {Tan},
 doi = {10.1145/3725812},
 issn = {1049-331X},
 journal = {ACM Trans. Softw. Eng. Methodol.},
 keywords = {Code Completion},
 month = {mar},
 note = {Place: New York},
 title = {Prompt-based {Code}},
 url = {https://doi.org/10.1145/3725812},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:40:59Z},
 year = {2025}
}

@article{tan_revprag_2024,
 abstract = {Large language models (LLMs) have demonstrated remarkable capabilities in generating human-like text and reasoning, but their application to robotics remains underexplored. We present RoboCat, a foundation model for robotics that is trained on a large-scale dataset of diverse robotic interactions. By leveraging self-supervised learning and a transformer architecture, RoboCat learns generalizable representations from raw visual and proprioceptive data. Our model exhibits strong zero-shot generalization to unseen tasks and environments, outperforming prior methods in manipulation and navigation benchmarks. We further demonstrate that fine-tuning RoboCat on task-specific data leads to rapid adaptation with minimal samples. This work highlights the potential of foundation models to unify perception, planning, and control in robotics, paving the way for more capable and versatile robotic systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Tan},
 journal = {arXiv preprint arXiv …},
