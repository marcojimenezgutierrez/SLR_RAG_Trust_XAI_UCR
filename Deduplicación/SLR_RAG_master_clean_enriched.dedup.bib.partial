@misc{munir_towards_2024,
 abstract = {Large Language Models (LLMs) are revolutionizing the landscape of Generative Artificial Intelligence (GenAI), with innovative LLM-backed solutions emerging rapidly. However, when applied to database technologies, specifically query generation for graph databases and Knowledge Graphs (KGs), LLMs still face significant challenges. While research on LLM-driven query generation for Structured Query Language (SQL) exists, similar systems for graph databases remain underdeveloped. This paper presents a comparative study addressing the challenge of generating Cypher queries a powerful language for interacting with graph databases using open-access LLMs. We rigorously evaluate several LLM agents (OpenAI ChatGPT 4o, Claude Sonnet 3.5, Google Gemini Pro 1.5, and a locally deployed Llama 3.1 8B) using a designed few-shot learning prompt and Retrieval Augmented Generation (RAG) backed by Chain-of-Thoughts (CoT) reasoning. Our empirical analysis of query generation accuracy reveals that Claude Sonnet 3.5 outperforms its counterparts in this specific domain. Further, we highlight promising future research directions to address the identified limitations and advance LLM-driven query generation for graph databases.},
 abstract_lang = {en},
 abstract_source = {doi-json},
 annote = {Comment: Paper accepted and will be presented at CSCI2024 in December 2024},
 author = {Munir},
 doi = {10.48550/arXiv.2411.08449},
 file = {Preprint PDF:C\:\\Users\\Marco\\Zotero\\storage\\JCGHXKF9\\Munir and Aldini - 2024 - Towards Evaluating Large Language Models for Graph Query Generation.pdf:application/pdf},
 keywords = {Computer Science - Computation and Language},
 month = {nov},
 note = {arXiv:2411.08449 [cs]},
 publisher = {arXiv},
 title = {Towards {Evaluating}},
 url = {https://doi.org/10.48550/arxiv.2411.08449},
 urldate = {2025-10-26},
 x_enrich_source = {doi-json},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:30:20Z},
 year = {2024}
}

@inproceedings{murata_effectiveness_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly transformed various sectors, including healthcare, where AI-driven systems are increasingly integrated to enhance diagnostic accuracy, personalize treatment plans, and streamline administrative processes. However, the deployment of AI in healthcare raises critical ethical concerns, particularly regarding data privacy, algorithmic bias, and accountability. This paper explores the ethical implications of AI adoption in healthcare through a comprehensive review of existing literature and case studies. We examine key challenges such as ensuring fairness in AI models to mitigate biases that disproportionately affect marginalized populations, protecting patient data under regulations like GDPR and HIPAA, and establishing clear liability frameworks when AI systems err. Furthermore, we propose a multi-stakeholder ethical framework that incorporates principles of transparency, inclusivity, and continuous oversight to guide responsible AI implementation. By addressing these issues, this study aims to foster trust in AI technologies and promote equitable healthcare outcomes.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Murata},
 booktitle = {2025 10th {International}},
 doi = {10.1109/ICBIR65229.2025.11163304},
 keywords = {Business},
 month = {may},
 pages = {472--475},
 title = {On the {Effectiveness}},
 url = {https://doi.org/10.1109/icbir65229.2025.11163304},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:10:39Z},
 year = {2025}
}

@article{murugan_empowering_2024,
 abstract = {Abstract Objective This study evaluates an AI assistant developed using OpenAI’s GPT-4 for interpreting pharmacogenomic (PGx) testing results, aiming to improve decision-making and knowledge sharing in clinical genetics and to enhance patient care with equitable access. Materials and Methods The AI assistant employs retrieval-augmented generation (RAG), which combines retrieval and generative techniques, by harnessing a knowledge base (KB) that comprises data from the Clinical Pharmacogenetics Implementation Consortium (CPIC). It uses context-aware GPT-4 to generate tailored responses to user queries from this KB, further refined through prompt engineering and guardrails. Results Evaluated against a specialized PGx question catalog, the AI assistant showed high efficacy in addressing user queries. Compared with OpenAI’s ChatGPT 3.5, it demonstrated better performance, especially in provider-specific queries requiring specialized data and citations. Key areas for improvement include enhancing accuracy, relevancy, and representative language in responses. Discussion The integration of context-aware GPT-4 with RAG significantly enhanced the AI assistant’s utility. RAG’s ability to incorporate domain-specific CPIC data, including recent literature, proved beneficial. Challenges persist, such as the need for specialized genetic/PGx models to improve accuracy and relevancy and addressing ethical, regulatory, and safety concerns. Conclusion This study underscores generative AI’s potential for transforming healthcare provider support and patient accessibility to complex pharmacogenomic information. While careful implementation of large language models like GPT-4 is necessary, it is clear that they can substantially improve understanding of pharmacogenomic data. With further development, these tools could augment healthcare expertise, provider productivity, and the delivery of equitable, patient-centered healthcare services.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 23; All Open Access; Green Accepted Open Access; Green Open Access},
 author = {Murugan},
 doi = {10.1093/jamia/ocae039},
 journal = {Journal of the American Medical Informatics Association},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {6},
 pages = {1356 -- 1366},
 title = {Empowering personalized pharmacogenomics with generative {AI}},
 url = {https://doi.org/10.1093/jamia/ocae039},
 volume = {31},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:02:47Z},
 year = {2024}
}

@article{musumeci_llm_2024,
 abstract = {Graph neural networks (GNNs) have emerged as a powerful tool for modeling relational data, with applications spanning social networks, molecular chemistry, and recommendation systems. However, their application to time series data, which inherently involves sequential dependencies and temporal dynamics, remains underexplored. This chapter provides a comprehensive survey of GNN-based methods for time series analysis, focusing on forecasting and classification tasks. We categorize existing approaches based on how they incorporate temporal information into graph structures, including dynamic graphs, temporal embeddings, and hybrid models combining GNNs with recurrent or transformer architectures. Key challenges such as scalability, handling irregular sampling, and interpretability are discussed, along with promising future directions like integrating causal inference and multi-modal data fusion.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
