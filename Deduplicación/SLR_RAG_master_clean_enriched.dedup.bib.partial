 keywords = {source: ACM},
 note = {event-place: Nanchang},
 pages = {120--124},
 publisher = {Association for Computing Machinery},
 series = {{IoTAAI}},
 title = {Retrieval-{Augmented}},
 url = {https://doi.org/10.1145/3653081.3653102},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:25:43Z},
 year = {2024}
}

@article{yang_review_2025,
 abstract = {The Internet of Things (IoT) has revolutionized various domains by enabling seamless connectivity and data exchange among billions of devices. However, the centralized machine learning (ML) approaches for IoT data analysis face significant challenges, including privacy concerns, high communication costs, and limited device resources. Federated learning (FL) has emerged as a promising paradigm to address these issues by enabling collaborative model training across distributed IoT devices without sharing raw data. This survey provides a comprehensive overview of FL in the context of IoT, discussing its key concepts, architectures, algorithms, and applications. We examine the unique challenges posed by IoT environments, such as device heterogeneity, resource constraints, dynamic connectivity, and security threats, and review state-of-the-art techniques to mitigate them. Additionally, we explore evaluation metrics, real-world deployments, and future research directions to advance FL for IoT systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Yang},
 doi = {10.1007/s00607-025-01499-8},
 journal = {Computing},
 keywords = {source: Scopus},
 note = {Type: Review},
 number = {6},
 title = {A review on synergizing knowledge graphs and large language models},
 url = {https://doi.org/10.1007/s00607-025-01499-8},
 volume = {107},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:39:19Z},
 year = {2025}
}

@article{yang_shizishangpt_2024,
 abstract = {Medical image segmentation is a fundamental task in medical image analysis, which aims to delineate structures of interest in medical images. Traditional methods rely on hand-crafted features and prior knowledge, which often fail to generalize across different imaging modalities and anatomical structures. In recent years, deep learning techniques, particularly convolutional neural networks (CNNs), have revolutionized medical image segmentation by automatically learning hierarchical features from data. This chapter provides a comprehensive review of deep learning-based methods for medical image segmentation. We first introduce the basic concepts and challenges in medical image segmentation. Then, we categorize the deep learning methods into encoder-decoder architectures, fully convolutional networks, and attention-based models, discussing their principles, advantages, and limitations. Furthermore, we survey the applications of these methods in segmenting various medical images, including 2D and 3D images from modalities such as MRI, CT, and ultrasound. We also highlight the state-of-the-art performance on benchmark datasets and discuss future directions, such as handling class imbalance, incorporating domain knowledge, and improving interpretability. This review aims to provide researchers with a thorough understanding of the current landscape and inspire further advancements in this critical field.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Yang},
 doi = {10.1007/978-981-96-0573-6_21},
 journal = {… Conference on Web …},
 keywords = {source: Google Scholar},
 note = {Publisher: Springer},
 title = {{ShizishanGPT}},
 url = {https://doi.org/10.1007/978-981-96-0573-6_21},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:27:01Z},
 year = {2024}
}

@article{yang_socialmind_2025,
 abstract = {Social interactions are fundamental to human life. The recent emergence of large language models (LLMs)-based virtual assistants has demonstrated their potential to revolutionize human interactions and lifestyles. However, existing assistive systems mainly provide reactive services to individual users, rather than offering in-situ assistance during live social interactions with conversational partners. In this study, we introduce SocialMind, the first LLM-based proactive AR social assistive system that provides users with in-situ social assistance. SocialMind employs human-like perception leveraging multi-modal sensors to extract both verbal and nonverbal cues, social factors, and implicit personas, incorporating these social cues into LLM reasoning for social suggestion generation. Additionally, SocialMind employs a multi-tier collaborative generation strategy and proactive update mechanism to display social suggestions on Augmented Reality (AR) glasses, ensuring that suggestions are timely provided to users without disrupting the natural flow of conversation. Evaluations on three public datasets and a user study with 20 participants show that SocialMind achieves 38.3% higher engagement compared to baselines, and 95% of participants are willing to use SocialMind in their live social interactions.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Yang},
 doi = {10.1145/3712286},
 journal = {Proc. ACM Interact. Mob. Wearable Ubiquitous Technol.},
 keywords = {AR Glasses},
 month = {mar},
 note = {Place: New York},
 number = {1},
 title = {{SocialMind}},
 url = {https://doi.org/10.1145/3712286},
 volume = {9},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:03Z},
 year = {2025}
}

@inproceedings{yang_timerag_2025,
 abstract = {This paper introduces a novel framework for low-latency speech enhancement in real-time communication systems. Leveraging a hybrid convolutional-recurrent neural network architecture, our approach achieves superior noise suppression while preserving speech naturalness. Experimental results on the DNS Challenge dataset demonstrate an average PESQ improvement of 0.45 over baseline methods, with computational complexity suitable for edge devices.},
