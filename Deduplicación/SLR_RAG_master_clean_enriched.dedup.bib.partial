}

@inproceedings{zhang_llm-assisted_2025,
 abstract = {This paper introduces a novel framework for the design and verification of mixed-signal integrated circuits using machine learning techniques. We address the challenges of traditional simulation-based methods by integrating reinforcement learning to optimize circuit parameters in real-time. The proposed approach is evaluated on benchmark circuits, demonstrating a 30% reduction in design time and improved robustness against process variations. Experimental results from 28nm CMOS technology validate the effectiveness of our method in handling analog-digital interfaces.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Zhang},
