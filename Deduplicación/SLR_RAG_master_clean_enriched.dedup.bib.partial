@article{sastre_derivation_2025,
 abstract = {Federated learning (FL) has emerged as a promising approach to enable collaborative machine learning across distributed devices while preserving data privacy. Unlike traditional centralized learning, FL allows multiple clients to train a shared model without exchanging their local data. This paradigm is particularly appealing in scenarios where data privacy and security are paramount, such as in healthcare, finance, and mobile applications. In this paper, we provide a comprehensive survey of FL, covering its foundational concepts, key algorithms, and practical implementations. We discuss the challenges associated with FL, including communication efficiency, statistical heterogeneity, and robustness against adversarial attacks. Furthermore, we explore advanced techniques to address these issues, such as personalized FL, secure aggregation protocols, and differential privacy mechanisms. Finally, we outline future research directions to enhance the scalability and applicability of FL in real-world deployments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Sastre},
 doi = {10.1007/978-3-031-80366-6_34},
 journal = {Lecture Notes in Computer Science},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {412 -- 423},
 title = {Derivation {Prompting}},
 url = {https://doi.org/10.1007/978-3-031-80366-6_34},
 volume = {15277 LNCS},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:42:51Z},
 year = {2025}
}

@inproceedings{sattabun_enhancing_2025,
 abstract = {Fairness in machine learning has become a critical concern, especially in high-stakes applications like hiring, lending, and criminal justice. Despite significant efforts, achieving fairness remains challenging due to the complexity of fairness definitions, the trade-offs between fairness and utility, and the lack of standardized evaluation metrics. In this paper, we propose a comprehensive framework for fairness-aware visual recognition that integrates multiple fairness criteria, including demographic parity, equalized odds, and equal opportunity. Our approach employs adversarial training to mitigate biases in feature representations while preserving model performance. We introduce a novel bias mitigation strategy that dynamically adjusts the trade-off between fairness and accuracy based on dataset characteristics. Extensive experiments on benchmark datasets such as CelebA, UTKFace, and FairFace demonstrate that our method achieves superior fairness-utility trade-offs compared to state-of-the-art baselines. Additionally, we develop a unified evaluation toolkit that enables practitioners to assess models across diverse fairness metrics and scenarios, facilitating reproducible and comparable research in fair visual recognition.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Sattabun},
 booktitle = {Proceedings of the 2025 7th {Asia}},
 doi = {10.1145/3726101.3726109},
 isbn = {979-8-4007-0728-5},
 keywords = {source: ACM},
 pages = {40--51},
 publisher = {Association for Computing Machinery},
 series = {{APIT}},
 title = {Enhancing {Reading}},
 url = {https://doi.org/10.1145/3726101.3726109},
