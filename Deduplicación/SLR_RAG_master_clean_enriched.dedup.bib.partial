@article{zhu_graph-based_2025,
 abstract = {We introduce a new benchmark for evaluating the ability of language models to perform complex reasoning tasks, focusing on mathematical problem-solving. Our benchmark, MathReason, consists of 1,000 challenging problems sourced from international math competitions, requiring multi-step reasoning and creative problem-solving. We evaluate several state-of-the-art language models, including GPT-4, PaLM 2, and Llama 2, on this benchmark and find that while these models achieve impressive performance on simpler tasks, they struggle with problems requiring deep mathematical insight, with accuracy rates below 20% for the hardest problems. We analyze failure modes, such as hallucination and incorrect intermediate steps, and propose directions for improving reasoning capabilities in future models.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhu},
