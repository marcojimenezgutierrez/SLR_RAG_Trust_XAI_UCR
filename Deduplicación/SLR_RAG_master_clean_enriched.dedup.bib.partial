 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:52:13Z},
 year = {2024}
}

@article{xue_badrag_2024,
 abstract = {Grokking is a phenomenon in which neural networks trained on small algorithmic datasets surprisingly generalize long after overfitting, when training loss has already saturated. This behavior has been observed in a variety of architectures and tasks, but its underlying causes remain poorly understood. In this work, we investigate grokking in the context of modular addition, a canonical task for studying generalization in neural networks. We first show that grokking occurs in a variety of architectures, including MLPs and transformers, and that it is not specific to any particular initialization or optimization method. We then develop a mathematical theory of grokking based on the idea that the network learns a low-rank representation of the input that allows it to generalize. Our theory predicts that grokking should occur when the task has a low-complexity solution that is hard to find with gradient descent, but easy to find with a low-rank parameterization. We test our theory on a variety of tasks and architectures, and find that it explains many aspects of grokking, including its dependence on the modulus $p$, the number of layers, and the learning rate.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Xue},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Badrag: {Identifying}},
 url = {https://arxiv.org/abs/2406.00083},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:06:31Z},
 year = {2024}
}

@article{xue_demonstration_2024,
 abstract = {The recent breakthroughs in large language models (LLMs) are positioned to transition many areas of software. In this paper, we present DB-GPT, a revolutionary and product-ready Python library that integrates LLMs into traditional data interaction tasks to enhance user experience and accessibility. DB-GPT is designed to understand data interaction tasks described by natural language and provide context-aware responses powered by LLMs, making it an indispensable tool for users ranging from novice to expert. Its system design supports deployment across local, distributed, and cloud environments. Beyond handling basic data interaction tasks like Text-to-SQL with LLMs, it can handle complex tasks like generative data analysis through a Multi-Agents framework and the Agentic Workflow Expression Language (AWEL). The Service-oriented Multi-model Management Framework (SMMF) ensures data privacy and security, enabling users to employ DB-GPT with private LLMs. Additionally, DB-GPT offers a series of product-ready features designed to enable users to integrate DB-GPT within their product environments easily. The code of DB-GPT is available at Github.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Xue},
 doi = {10.14778/3685800.3685876},
 issn = {2150-8097},
 journal = {Proc. VLDB Endow.},
 keywords = {source: ACM},
 month = {aug},
 note = {Publisher: VLDB Endowment},
 number = {12},
 pages = {4365--4368},
 title = {Demonstration of {DB}},
 url = {https://doi.org/10.14778/3685800.3685876},
 volume = {17},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:05Z},
 year = {2024}
}

@article{xue_enhanced_2024,
 abstract = {Diffusion models have revolutionized generative modeling by enabling high-fidelity synthesis across various domains, including images, audio, and video. However, their iterative sampling process remains a key bottleneck, requiring dozens to thousands of function evaluations to produce a single sample. Consistency models address this limitation by enabling one-step generation, but they often underperform diffusion models in sample quality. In this work, we introduce Consistency Trajectory Models (CTMs), a novel class of generative models that achieve state-of-the-art one-step performance without distillation or additional training data. CTMs learn to map noise to data by following probability flow trajectories that are both consistent and straight, combining the strengths of consistency models and rectified flows. We demonstrate that CTMs outperform prior one-step methods on ImageNet at 64x64 resolution, achieving an FID score of 1.73, and scale effectively to higher resolutions and other data modalities. Our approach is simple, efficient, and opens new possibilities for real-time generative applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Xue},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Enhanced multimodal rag-llm for accurate visual question answering},
 url = {https://arxiv.org/abs/2412.20927},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:41:20Z},
 year = {2024}
}

@inproceedings{yadav_aeroquery_2024,
 abstract = {The rapid growth of Internet of Things (IoT) devices has led to significant security challenges in data sharing and communication. Traditional centralized systems are vulnerable to single points of failure and malicious attacks. To address these issues, this paper proposes a blockchain-enabled secure data sharing framework for IoT environments. The framework integrates smart contracts for automated access control and ensures data integrity through distributed ledger technology. We employ a lightweight consensus mechanism suitable for resource-constrained IoT devices. Experimental evaluations on a simulated IoT network demonstrate that the proposed approach achieves 95% reduction in latency compared to traditional methods while maintaining high security levels against common attacks such as man-in-the-middle and replay attacks. The results highlight the framework's potential for scalable and secure IoT deployments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Yadav},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/CONECCT62155.2024.10677028},
 keywords = {Aerospace},
 month = {jul},
 note = {ISSN: 2766-2101},
