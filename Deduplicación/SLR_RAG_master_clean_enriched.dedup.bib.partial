@article{ni_tp-rag_2025,
 abstract = {We introduce a new paradigm for robot learning that leverages the strengths of vision-language models (VLMs) to enable generalist robot policies that can perform diverse tasks across different embodiments and environments. Our approach, called RoboVLMs, builds on the success of VLMs in vision and language tasks by extending them to the robotics domain. Specifically, we train a VLM on a large-scale dataset of robot interactions, enabling it to reason about actions in a zero-shot manner. We evaluate our model on a variety of robotic tasks, including manipulation, navigation, and multi-task settings, and demonstrate significant improvements over prior methods. Our results suggest that VLMs hold promise for developing generalist robot policies that can adapt to new tasks with minimal fine-tuning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
