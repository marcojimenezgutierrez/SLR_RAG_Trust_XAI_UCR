@inproceedings{agrawal_llm_2025,
 abstract = {This paper proposes a novel framework for enhancing cybersecurity in industrial control systems using federated learning. Traditional centralized machine learning approaches face challenges in data privacy and scalability within distributed industrial environments. Our federated learning model enables collaborative training across edge devices without sharing raw data, thereby preserving sensitive information. We evaluate the framework on a simulated industrial IoT network, demonstrating improved anomaly detection accuracy by 25% compared to baseline methods, while reducing communication overhead. The results highlight the potential of federated learning for secure and efficient AI deployment in critical infrastructure.},
