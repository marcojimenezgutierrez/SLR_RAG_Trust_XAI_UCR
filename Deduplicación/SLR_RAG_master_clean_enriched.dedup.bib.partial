@article{abras_can_2025,
 abstract = {This chapter introduces the concept of Human-Centered Artificial Intelligence (HCAI) as a framework for designing AI systems that prioritize human values, needs, and capabilities. Drawing on principles from human-computer interaction (HCI), the authors argue that HCAI extends traditional HCI by integrating AI's potential to augment human intelligence while mitigating risks such as bias, opacity, and loss of agency. Key components of HCAI include transparency, accountability, and inclusivity, illustrated through case studies in healthcare and education. The chapter concludes with recommendations for interdisciplinary collaboration to realize HCAI's promise in creating beneficial AI technologies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
