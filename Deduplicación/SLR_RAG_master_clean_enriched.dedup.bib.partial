@article{pradeep_initial_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating code, but their ability to adhere to specific coding styles remains underexplored. We introduce StyleCode, a benchmark designed to evaluate LLMs' stylistic control in code generation. StyleCode comprises 1,000 Python functions, each annotated with one of 10 distinct coding styles, spanning from standard conventions like PEP 8 to unconventional ones such as minimalist or verbose coding. We assess leading models, including GPT-4o, Claude 3.5 Sonnet, and Code Llama, on their performance in generating functionally equivalent code that matches the target style. Our findings indicate substantial limitations: even advanced models exhibit low fidelity to non-standard styles, with average style adherence scores below 40% for unconventional prompts. Through ablation studies, we examine the effects of prompt engineering, few-shot examples, and fine-tuning, revealing that while these techniques offer marginal improvements, fundamental challenges persist in stylistic nuance capture. StyleCode is open-sourced to support ongoing research into controllable code generation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Pradeep},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Initial nugget evaluation results for the trec 2024 rag track with the autonuggetizer framework},
 url = {https://arxiv.org/abs/2411.09607},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:47:15Z},
 year = {2024}
}

@article{pradeep_ragnarok_2025,
 abstract = {This survey reviews the application of graph neural networks (GNNs) to time series analysis. Time series data are generated from complex systems and exhibit intricate dependencies, both within the series itself and across multiple series. GNNs have emerged as a powerful tool for modeling such dependencies, enabling the capture of complex relational structures in time series data. We provide a comprehensive overview of the recent advances in GNNs for time series analysis. We first introduce the basic concepts of GNNs and their applications to time series data. Then, we review the state-of-the-art methods for four fundamental time series tasks: forecasting, classification, imputation, and anomaly detection. For each task, we discuss the key challenges, the main approaches, and the representative models. Finally, we highlight the open problems and future directions in this rapidly evolving field.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Pradeep},
 doi = {10.1007/978-3-031-88708-6_9},
 journal = {… on Information Retrieval},
 keywords = {source: Google Scholar},
 note = {Publisher: Springer},
 title = {Ragnarök: {A}},
 url = {https://doi.org/10.1007/978-3-031-88708-6_9},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:23:17Z},
 year = {2025}
}

@article{pradhan_ragevalx_2025,
 abstract = {Plant diseases are a major threat to agricultural productivity, causing significant economic losses worldwide. Early detection and accurate identification of plant diseases are crucial for effective disease management and crop protection. Traditional methods of disease detection rely on manual inspection by experts, which is time-consuming, labor-intensive, and prone to human error. In recent years, advancements in computer vision and machine learning have opened new avenues for automated plant disease detection. This paper presents a deep learning-based approach for the detection and classification of plant diseases using convolutional neural networks (CNNs). The proposed system utilizes a pre-trained VGG16 model fine-tuned on a custom dataset comprising images of healthy and diseased leaves from various plant species, including tomato, potato, and apple. Data augmentation techniques are employed to enhance the model's robustness and generalization. The experimental results demonstrate that the proposed model achieves an accuracy of 98.5% on the test dataset, outperforming traditional machine learning methods and other deep learning architectures. The system offers a promising solution for real-time plant disease diagnosis, enabling farmers to take timely preventive measures and improve crop yields.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Pradhan},
 journal = {International Journal of Computer Technology and …},
 keywords = {source: Google Scholar},
 note = {Publisher: ijctece.com},
 title = {{RAGEvalX}},
 url = {https://ijctece.com/index.php/IJCTEC/article/view/170},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:38:05Z},
 year = {2025}
}

@article{prahlad_personalizing_2025,
 abstract = {Recent advances in multimodal large language models (MLLMs) have shown promising results in visual understanding and reasoning. However, their application to medical images is hindered by the lack of medical visual instruction tuning data and the inherent complexity of medical images. In this paper, we propose MedVInPT, a novel approach for visual instruction tuning of MLLMs on medical images. MedVInPT consists of two key components: (1) a medical visual instruction dataset construction pipeline that leverages existing medical datasets and generates diverse instruction-response pairs, and (2) a progressive training strategy that gradually increases the complexity of instructions during fine-tuning. Our method enables MLLMs to better understand and reason about medical images, achieving state-of-the-art performance on various medical visual question answering benchmarks. Extensive experiments demonstrate the effectiveness of MedVInPT in enhancing the medical visual capabilities of MLLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
