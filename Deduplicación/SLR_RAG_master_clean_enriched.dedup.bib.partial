 keywords = {data fusion},
 note = {event-place: Tokyo},
 pages = {274--279},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Data {Fusion}},
 url = {https://doi.org/10.1145/3673791.3698423},
