 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:12:59Z},
 year = {2025}
}

@article{zhang_ai-driven_2025,
 abstract = {The Internet of Things (IoT) has revolutionized various sectors by enabling connectivity and data exchange among billions of devices. However, the exponential growth of IoT devices poses significant challenges in terms of data privacy, communication overhead, and computational resources. Federated Learning (FL) has emerged as a promising paradigm to address these challenges by enabling collaborative model training across distributed devices without sharing raw data. Despite its potential, applying FL to resource-constrained IoT devices remains challenging due to limited computational power, energy constraints, and heterogeneous data distributions. This survey provides a comprehensive overview of FL for resource-constrained IoT devices, highlighting key challenges, recent advancements, and future research directions. We discuss various FL frameworks tailored for IoT environments, including communication-efficient algorithms, privacy-preserving techniques, and strategies for handling non-IID data. Furthermore, we explore real-world applications of FL in IoT domains such as smart healthcare, intelligent transportation, and industrial automation. By synthesizing the current state-of-the-art, this survey aims to guide researchers and practitioners in developing efficient and scalable FL solutions for next-generation IoT systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhang},
 journal = {IEEE …},
 keywords = {source: Google Scholar},
