 year = {2024}
}

@inproceedings{sun_adaptive_2024,
 abstract = {Visual programming languages (VPLs) have been proposed as a promising approach to enable end-users to create data visualizations without writing code. However, the design space of VPLs for data visualization has not been systematically explored. In this paper, we present a design space analysis of 20 existing VPLs for data visualization. We identify five key design dimensions: representation, composition, abstraction, interaction, and execution. Based on our analysis, we derive a set of design implications for future VPLs. To demonstrate the utility of our design space, we developed a prototype VPL that incorporates several novel design choices informed by our analysis. Our work contributes to the understanding of VPL design for data visualization and provides guidance for future research and development in this area.},
