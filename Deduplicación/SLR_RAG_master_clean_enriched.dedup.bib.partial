}

@inproceedings{liu_robust-ir_2025,
 abstract = {Data visualization is a powerful tool for exploring and communicating insights from complex datasets. However, creating effective visualizations often requires significant expertise in both data analysis and graphic design. To address this challenge, we introduce VisKit, a novel visual programming interface that enables users to create interactive data visualizations through a drag-and-drop paradigm. VisKit integrates data processing, visualization design, and interactivity in a unified canvas, allowing users to iteratively refine their visualizations without writing code. We evaluate VisKit through a user study with 20 participants, comparing it to traditional tools like Tableau and D3.js. Results show that VisKit significantly reduces task completion time for novice users while maintaining comparable expressiveness for experts. Our findings highlight the potential of visual programming to democratize data visualization creation and inform future tool design.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Liu},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730355},
