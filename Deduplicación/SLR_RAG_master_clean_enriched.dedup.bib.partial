@inproceedings{bhuva_interviewedge_2025,
 abstract = {This paper introduces a novel approach to enhancing energy efficiency in edge computing devices for IoT applications in smart cities. We propose an adaptive resource allocation algorithm that dynamically optimizes power consumption based on real-time workload predictions using machine learning models. Experimental results on a prototype system demonstrate a 25% reduction in energy usage compared to traditional methods, while maintaining performance levels. The framework is scalable and integrates seamlessly with existing 5G infrastructure, paving the way for sustainable urban computing ecosystems.},
