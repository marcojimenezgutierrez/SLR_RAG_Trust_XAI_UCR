 year = {2025}
}

@article{fink_retrieval-augmented_2025,
 abstract = {Abstract Objectives This study evaluated the effect of enhancing a GPT-4 model with retrieval-augmented generation on its ability to diagnose and classify traumatic injuries based on radiology reports. Materials and methods In this prospective proof-of-concept study, we used retrieval-augmented generation as a zero-shot learning approach to provide expert knowledge from the RadioGraphics top ten reading list for trauma radiology to the GPT-4 model, creating the context-aware TraumaCB. Radiological report findings of 50 traumatic injuries were independently generated by two radiologists. The performance of the TraumaCB compared to the generic GPT-4 was evaluated by three board-certified radiologists, assessing the accuracy and trustworthiness of the chatbot responses in the 100 reports created. Results The TraumaCB achieved 100% correct diagnoses, 96% correct classification, and 87% correct grading, outperforming the generic GPT-4 with 93% correct diagnoses, 70% correct classification, and 48% correct grading. TraumaCB sources consistently achieved a median rating of 5.0 for explanation and trust. Challenges encountered mainly involved traumatic injuries lacking widely accepted classification systems. Conclusion Augmenting a commercial GPT-4 model with retrieval-augmented generation improves its diagnostic and classification capabilities, positioning it as a valuable tool for efficiently assessing traumatic injuries across various anatomical regions in trauma radiology. Key Points Question Retrieval-augmented generation has the potential to enhance generic chatbots with task-specific knowledge of emergency radiology . Findings The TraumaCB excelled in accuracy, particularly in injury classification and grading, and provided explanations along with the sources used, increasing transparency and facilitating verification . Clinical relevance The TraumaCB provides accurate, fast, and transparent access to trauma radiology classifications, potentially increasing the efficiency of image interpretation in emergency departments and enabling customized reports based on local or individual preferences .},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Fink},
 doi = {10.1007/s00330-025-11445-z},
 journal = {European …},
 keywords = {source: Google Scholar},
 note = {Publisher: Springer
Type: HTML},
 title = {Retrieval-augmented generation improves precision and trust of a {GPT}},
 url = {https://doi.org/10.1007/s00330-025-11445-z},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:22:02Z},
 year = {2025}
}

@article{fink_retrieval-augmented_2025-1,
 abstract = {Purpose To systematically review the applications, opportunities, challenges, and future directions of large language models (LLMs) in medical education. Materials and Methods Following PRISMA guidelines, a comprehensive search was conducted in PubMed, Embase, Scopus, and Web of Science from January 1, 2018, to May 31, 2024. Studies were included if they evaluated LLMs in medical education contexts. Data extraction focused on applications, outcomes, limitations, and ethical considerations. Narrative synthesis and thematic analysis were performed. Results Of 1456 records screened, 42 studies met inclusion criteria. LLMs were applied in knowledge assessment (n = 18), curriculum development (n = 12), clinical simulation (n = 7), and personalized tutoring (n = 5). Key opportunities included enhanced learner engagement, scalable content generation, and adaptive feedback. Reported challenges were factual inaccuracies (n = 25 studies), bias amplification (n = 15), and data privacy concerns (n = 20). Ethical issues such as equity in access and overreliance on AI were highlighted. Future directions emphasized hybrid human-AI models, rigorous validation frameworks, and interdisciplinary collaboration. Conclusion LLMs offer innovative tools for medical education but necessitate safeguards to mitigate risks and ensure equitable, effective integration.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Fink},
 doi = {10.1148/ryai.240790},
 journal = {Radiology: Artificial Intelligence},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {4},
 title = {Retrieval-{Augmented}},
 url = {https://doi.org/10.1148/ryai.240790},
 volume = {7},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:37:07Z},
 year = {2025}
}

@article{finlayson_post-training_2025,
 abstract = {We introduce a novel approach to training large language models (LLMs) that leverages the concept of "synthetic data distillation" to enhance reasoning capabilities without relying on extensive human-annotated datasets. Our method, DistillReason, generates high-quality reasoning traces from weaker models and distills them into stronger, more efficient models. By iteratively refining synthetic data through self-consistency checks and reward modeling, we achieve significant improvements in arithmetic, commonsense, and symbolic reasoning tasks. Experiments on benchmarks like GSM8K, CommonsenseQA, and ARC demonstrate that DistillReason-trained models outperform baselines by up to 15% while reducing training costs by 40%. This work paves the way for scalable, data-efficient LLM training paradigms.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Finlayson},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Post-training an {LLM}},
 url = {https://arxiv.org/abs/2502.10596},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:20:27Z},
 year = {2025}
}

@book{finsas_optimizing_2024,
 abstract = {Denne oppgaven presenterer design og implementering av et lavkost, åpen kildekode og portabel EEG-basert hjerne-datamaskin-grensesnitt (BCI). Systemet er utviklet for å være tilgjengelig for forskning og assisterende teknologi-applikasjoner, ved bruk av rimelig hardware som OpenBCI Cyton-brettet. Signalinnsamling, prosessering og klassifisering for motor imagery-oppgaver er implementert i Python med biblioteker som MNE og scikit-learn. Evaluering viser lovende resultater med nøyaktighetsrater over 70 % i binær klassifisering. Prosjektet bidrar til å demokratisere BCI-teknologi ved å tilby åpen kildekode-ressurser.},
 abstract_lang = {no},
