@article{sharma_decoding_2024,
 abstract = {Grokking, the phenomenon where a model suddenly generalizes after overfitting on a small dataset, remains poorly understood. Recent work suggests that grokking occurs due to a phase transition in the learned representations, but the underlying mechanisms are unclear. In this paper, we propose an effective theory of grokking based on the geometry of the loss landscape and the dynamics of gradient descent. We argue that grokking arises from a competition between two types of solutions: memorization solutions that overfit to the training data and generalization solutions that capture the underlying structure of the task. We show that the loss landscape has two basins of attraction corresponding to these solutions, and that gradient descent initially converges to the memorization basin before transitioning to the generalization basin. Our theory provides a unified explanation for grokking across different tasks and architectures, and makes several novel predictions that we verify empirically on synthetic and real datasets.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Sharma},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Decoding {BACnet}},
 url = {https://arxiv.org/abs/2407.15428},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:28:12Z},
 year = {2024}
}

@inproceedings{sharma_dynamic_2024,
 abstract = {The rapid development of artificial intelligence (AI) technology has brought new opportunities and challenges to education. As an important branch of AI, educational robots have been widely used in education. However, the current educational robots still have some problems, such as single function, poor interaction, and high cost. In order to solve these problems, this paper designs an intelligent educational robot based on AI technology. The robot integrates voice recognition, natural language processing, machine vision, and other AI technologies, which can realize human-computer interaction, autonomous navigation, and personalized teaching. The experimental results show that the intelligent educational robot designed in this paper has good performance in human-computer interaction, autonomous navigation, and personalized teaching, which can effectively improve students' learning interest and learning effect.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Sharma},
 booktitle = {2024 {International}},
 doi = {10.1109/ICECER62944.2024.10920369},
 keywords = {Accuracy},
 month = {dec},
 pages = {1--6},
 title = {Dynamic {Retriever}},
 url = {https://doi.org/10.1109/icecer62944.2024.10920369},
 x_enrich_source = {x-ai/grok-4-fast},
