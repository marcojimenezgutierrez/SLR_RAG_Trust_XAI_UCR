@inproceedings{al_haque_evolution_2025,
 abstract = {Visual Question Answering (VQA) systems have achieved remarkable performance in recent years, yet they often exhibit biases towards certain answer classes or image regions, leading to unfair outcomes for underrepresented groups. In this paper, we investigate fairness in VQA through the lens of demographic parity and equalized odds, focusing on gender and racial biases in the VQA-CP dataset. We propose a novel debiasing framework that integrates counterfactual fairness with attention mechanisms to mitigate spurious correlations. Our approach involves generating counterfactual image-question pairs and fine-tuning the model to balance predictions across protected attributes. Experiments demonstrate significant improvements in fairness metrics while maintaining competitive accuracy, highlighting the trade-offs between performance and equity in multimodal AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
