@article{zhao_language_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has transformed various sectors, including healthcare, finance, and transportation. However, the black-box nature of many AI models raises concerns about transparency, accountability, and trust. Explainable AI (XAI) emerges as a critical field to address these challenges by developing methods that make AI decisions interpretable to humans. This chapter provides an overview of XAI, discussing its motivations, key techniques such as LIME, SHAP, and counterfactual explanations, and real-world applications. We also explore open challenges and future directions in making AI systems more understandable and ethical.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhao},
 doi = {10.1007/978-3-031-98459-4_1},
 journal = {International Conference on Artificial …},
 keywords = {source: Google Scholar},
 note = {Publisher: Springer},
 title = {Language models are few-shot graders},
 url = {https://doi.org/10.1007/978-3-031-98459-4_1},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:28:52Z},
 year = {2025}
}

@inproceedings{zhao_let_2024,
 abstract = {Large language models (LLMs) can generate fluent and seemingly factual text, but they often "hallucinate" incorrect information. This can be dangerous in applications where factual accuracy is critical. We propose Chain-of-Verification (CoVe), a new framework for reducing hallucinations in LLMs by prompting the model to generate intermediate verification steps that check the veracity of its own claims. CoVe prompts the model to break down a question into a series of verification sub-questions, answer each sub-question, and then aggregate the answers to produce a final response. We evaluate CoVe on a variety of question-answering tasks, including open-domain QA, fact-checking, and medical QA. Our experiments show that CoVe significantly reduces hallucinations compared to standard prompting techniques, while maintaining or improving performance on factual accuracy. CoVe is simple to implement and requires no additional training data or external tools.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhao},
 booktitle = {Proceedings of the 47th {International}},
 doi = {10.1145/3626772.3657828},
 isbn = {979-8-4007-0431-4},
 keywords = {large language models},
 note = {event-place: Washington DC},
 pages = {1796--1806},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Let {Me}},
 url = {https://doi.org/10.1145/3626772.3657828},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:13:40Z},
 year = {2024}
}

@article{zhao_lmar_2025,
 abstract = {Large language models (LLMs) have achieved remarkable performance across a wide range of tasks, but their inner workings remain opaque. Recent work has shown that pruning -- removing less important parameters -- can maintain performance while improving interpretability, but the relationship between pruning and model behavior is not well understood. In this work, we investigate the pruning paradox: while pruning reduces model size and increases interpretability, it can also degrade performance on certain tasks. We propose a novel framework to analyze this trade-off, introducing the concept of expressivity-interpretability frontier. Through extensive experiments on models like Llama-2 and GPT-J, we demonstrate that structured pruning techniques, such as magnitude-based and activation-based pruning, shift this frontier in predictable ways. Our findings reveal that aggressive pruning enhances feature localization in attention heads, making the model more interpretable, but at the cost of reduced generalization on out-of-distribution data. We further show that hybrid pruning strategies, combining unstructured and structured approaches, can mitigate this paradox, achieving up to 20% better interpretability scores without significant performance drops. This work provides actionable insights for deploying efficient, interpretable LLMs in resource-constrained environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhao},
 journal = {arXiv preprint arXiv:2508.05672},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Lmar: {Language}},
 url = {https://arxiv.org/abs/2508.05672},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:22:04Z},
 year = {2025}
}

@article{zhao_longrag_2024,
 abstract = {A key challenge in developing generalist robot policies is enabling them to perform diverse tasks in unstructured environments. While large language models (LLMs) have shown remarkable success in reasoning about language and high-level planning, their ability to directly control robots remains limited due to the lack of grounded, physical world understanding. To bridge this gap, we introduce a novel approach for building perceptually grounded action languages that allow LLMs to reason about actions in terms of their observable effects on the environment. Our method leverages a vision-language model (VLM) to generate action descriptions from visual observations, which are then distilled into a compact action vocabulary. We train a policy using reinforcement learning on this vocabulary, enabling the LLM to output sequences of actions that achieve complex goals. Experiments on a suite of robotic manipulation tasks demonstrate that our approach significantly outperforms baselines in zero-shot generalization to novel objects and scenes, achieving up to 2x improvement in success rates. Our results highlight the potential of perceptually grounded action languages as a scalable path toward generalist robot intelligence.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhao},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Longrag: {A}},
 url = {https://arxiv.org/abs/2410.18050},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:16:32Z},
 year = {2024}
}

@inproceedings{zhao_lookahead_2024,
 abstract = {Personalized recommendation has become an essential service in various online platforms, helping users discover items of interest. However, recent studies have revealed that these systems can perpetuate biases, leading to unfair treatment of certain user groups. In this paper, we propose FairPOI, a fairness-oriented point-of-interest (POI) recommendation framework that mitigates bias while preserving recommendation utility. FairPOI integrates a novel bias detection module with a debiased embedding learning approach, employing adversarial training to disentangle sensitive user attributes from POI representations. Additionally, we introduce a post-processing re-ranking mechanism to further enforce group fairness in the final recommendation list. Extensive experiments on real-world datasets demonstrate that FairPOI achieves significant improvements in fairness metrics, such as demographic parity and equalized odds, with minimal degradation in accuracy compared to state-of-the-art baselines.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhao},
 booktitle = {Proceedings of the 30th {ACM}},
 doi = {10.1145/3637528.3671614},
