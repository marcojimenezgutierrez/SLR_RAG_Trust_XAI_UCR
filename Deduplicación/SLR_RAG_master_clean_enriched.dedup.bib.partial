@article{ko_enhancing_2024,
 abstract = {This paper introduces a novel framework for enhancing the interpretability of deep neural networks in the context of medical image analysis. We propose a hybrid attention mechanism that combines spatial and channel attention to highlight salient features in X-ray images for pneumonia detection. Our approach achieves state-of-the-art performance on benchmark datasets, with improved accuracy and reduced false positives. Experimental results demonstrate the framework's effectiveness in providing clinicians with intuitive visualizations, thereby facilitating better diagnostic decisions.},
