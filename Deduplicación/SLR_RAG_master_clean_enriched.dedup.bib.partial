@article{arjona-giner_multiagent_2025,
 abstract = {The rapid development of wireless communication technologies has led to the deployment of various wireless networks, such as cellular networks, Wi-Fi, and Bluetooth. However, these networks are vulnerable to various security threats, including eavesdropping, jamming, and spoofing attacks. In this chapter, we propose a novel security framework for wireless networks based on blockchain technology. Our framework leverages the decentralized and immutable nature of blockchain to ensure secure key management and authentication in wireless networks. We evaluate the performance of our framework through simulations and show that it significantly improves the security and efficiency of wireless networks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
