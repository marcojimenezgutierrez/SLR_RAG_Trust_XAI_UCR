 title = {Analyzing {Pedagogical}},
 url = {https://doi.org/10.1145/3641554.3701965},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:28:46Z},
 year = {2025}
}

@inproceedings{mishra_daignostic-_2025,
 abstract = {This paper proposes a novel approach for detecting anomalies in medical imaging using deep learning techniques. We introduce a hybrid model combining convolutional neural networks (CNNs) and generative adversarial networks (GANs) to improve the accuracy of anomaly detection in X-ray images. The model is trained on a dataset of 10,000 labeled images, achieving a precision of 95% and recall of 92%. Experimental results demonstrate superior performance compared to traditional methods, with potential applications in early disease diagnosis.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
