 x_enrich_ts = {2025-11-02T09:17:03Z},
 year = {2025}
}

@inproceedings{galitsky_truth-o-meter_2024,
 abstract = {We present ChainForge, a browser-based visual programming environment for building, testing, and debugging LLM pipelines. ChainForge allows users to construct complex LLM workflows using a node-based interface, where each node represents a prompt, LLM call, or data transformation. Users can iteratively test and refine their pipelines, visualizing the flow of data and model outputs at each step. To support hypothesis testing, ChainForge provides tools for systematic evaluation, including batch processing, A/B testing, and integration with external evaluation metrics. We discuss the design principles behind ChainForge, including modularity, transparency, and extensibility, and present case studies demonstrating its use in prompt engineering, chain-of-thought reasoning, and agent-based systems. Our work aims to democratize access to advanced LLM techniques, enabling researchers and practitioners to experiment more effectively with these powerful models.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Galitsky},
