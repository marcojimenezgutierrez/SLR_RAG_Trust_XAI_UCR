 x_enrich_ts = {2025-11-02T09:11:17Z},
 year = {2024}
}

@inproceedings{wen_6g-xsec_2024,
 abstract = {We present MuseCrafter, a novel system for controllable story visualization that generates a sequence of images from a story text, allowing users to specify visual styles and edit individual images. Unlike prior works that generate all images jointly, MuseCrafter decouples the process into two stages: first, it generates a sequence of draft images with a pre-trained diffusion model; second, it refines each image individually using a customized diffusion model conditioned on the story context and user-specified controls. To enable flexible editing, we introduce a new image editing method that allows users to modify specific regions of an image while preserving the overall composition. Our user studies show that MuseCrafter produces more coherent and visually appealing story visualizations compared to baselines, and supports a wider range of creative controls.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wen},
 booktitle = {Proceedings of the 23rd {ACM}},
 doi = {10.1145/3696348.3696881},
