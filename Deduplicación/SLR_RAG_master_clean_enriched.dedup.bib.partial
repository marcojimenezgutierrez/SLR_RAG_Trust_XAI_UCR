 keywords = {ai persona},
 note = {event-place: Washington DC},
 pages = {2781--2785},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 thus requiring no fine-tuning. we demonstrate the effectiveness of our tool via a https://www.youtube.com/watch?v = {Agl7ugyu1N4 and propose novel task-specific evaluation metrics to control for alignment and hallucination. Our tool is available at https://job-aligned-resume.streamlit.app.}},
 title = {{ResumeFlow}},
 url = {https://doi.org/10.1145/3626772.3657680},
