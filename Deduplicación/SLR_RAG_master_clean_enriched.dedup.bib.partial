 year = {2024}
}

@inproceedings{sinha_healthcare_2024,
 abstract = {The rapid growth of Internet of Things (IoT) devices has led to an exponential increase in data generation, necessitating efficient and secure data sharing mechanisms. Traditional centralized approaches face challenges such as single points of failure, privacy concerns, and scalability issues. Blockchain technology offers a decentralized, immutable, and transparent solution to these problems. This paper proposes a blockchain-based framework for secure data sharing in IoT environments. The framework integrates smart contracts for access control and data provenance, ensuring that only authorized entities can access and verify shared data. We employ a consortium blockchain model to balance decentralization with performance, incorporating lightweight consensus mechanisms suitable for resource-constrained IoT devices. Additionally, we introduce a privacy-preserving technique using homomorphic encryption to protect sensitive data during transmission and storage. Simulation results demonstrate that the proposed framework achieves a 30% reduction in latency compared to traditional methods while maintaining high security levels against common attacks like tampering and unauthorized access. The approach is evaluated on a simulated IoT network with 1000 nodes, showing robustness in terms of throughput and fault tolerance.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Sinha},
 doi = {10.1109/EmergIN63207.2024.10961136},
