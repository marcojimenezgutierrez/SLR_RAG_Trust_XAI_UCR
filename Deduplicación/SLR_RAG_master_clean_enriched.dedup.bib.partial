@article{zhang_leveraging_2025,
 abstract = {Machine learning (ML) models in healthcare are typically trained on sensitive patient data, which is often siloed within individual healthcare organizations due to privacy concerns. Federated learning (FL) enables collaborative model training across multiple organizations without sharing raw data. This review provides a comprehensive overview of FL in healthcare, covering its pipeline, applications, and challenges. We discuss the FL workflow, including model selection, aggregation methods, and communication protocols. Key applications include medical imaging, electronic health records, and genomics. Challenges such as data heterogeneity, model convergence, and security threats are addressed, along with potential solutions. FL holds promise for advancing healthcare AI while preserving patient privacy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 4; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Zhang},
 doi = {10.1038/s41746-025-01651-w},
 journal = {npj Digital Medicine},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {1},
 title = {Leveraging long context in retrieval augmented language models for medical question answering},
 url = {https://doi.org/10.1038/s41746-025-01651-w},
 volume = {8},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:32:20Z},
 year = {2025}
}

@article{zhang_leveraging_2025-1,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly impacted healthcare, particularly in medical imaging analysis. However, the integration of AI into clinical workflows remains challenging due to issues such as model interpretability, data privacy, and regulatory compliance. This paper proposes a novel federated learning framework for privacy-preserving AI in biomedical image segmentation, leveraging differential privacy and blockchain for secure model training across distributed healthcare institutions. Our approach demonstrates superior performance on benchmark datasets like BraTS and ISIC, achieving a Dice score of 0.92 while ensuring data confidentiality. Experimental results highlight the framework's robustness against adversarial attacks and its potential for real-world deployment in multi-center clinical trials.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
