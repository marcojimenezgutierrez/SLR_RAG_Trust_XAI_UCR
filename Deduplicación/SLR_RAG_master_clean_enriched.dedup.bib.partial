 x_enrich_ts = {2025-11-02T06:53:22Z},
 year = {2025}
}

@article{hodges_using_2025,
 abstract = {Federated learning (FL) is a distributed machine learning paradigm that enables collaborative model training across multiple devices or servers while keeping data localized, thereby addressing privacy concerns. However, deploying FL in real-world scenarios, especially with large foundation models, introduces significant challenges related to communication efficiency, data heterogeneity, privacy preservation, and system scalability. This paper provides a comprehensive survey of FL, focusing on its challenges and applications in the era of large foundation models. We first outline the fundamentals of FL and discuss key challenges, including statistical heterogeneity, communication bottlenecks, and privacy-utility trade-offs. Then, we explore emerging applications of FL in domains such as healthcare, finance, and edge computing, highlighting how large pre-trained models can be fine-tuned in a federated manner. Finally, we discuss future directions, including integration with advanced techniques like differential privacy and secure multi-party computation to enhance FL's robustness against emerging threats.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Hodges},
 doi = {10.1007/978-3-031-95841-0_35},
