 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:04:11Z},
 year = {2024}
}

@inproceedings{akyash_evolutionary_2024,
 abstract = {Digital twins (DTs) are virtual replicas of physical entities that enable real-time monitoring, simulation, and optimization. While DTs hold significant potential for sustainability, their implementation often involves high computational demands and resource-intensive processes, potentially offsetting environmental benefits. This paper presents a systematic literature review (SLR) exploring the sustainability implications of DTs. We analyzed 58 peer-reviewed articles published between 2018 and 2023 to identify sustainability challenges and opportunities associated with DTs. Our findings reveal that while DTs can contribute to sustainability through improved resource efficiency and predictive maintenance, they also pose challenges such as increased energy consumption and data management issues. We propose a framework for sustainable DT design that integrates life cycle assessment and energy-efficient computing practices. This work provides a foundation for future research and practical guidelines to ensure that DTs align with sustainability goals.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
