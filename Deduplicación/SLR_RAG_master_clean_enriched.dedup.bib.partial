@article{lee_developing_2025,
 abstract = {This paper presents a systematic literature review on the integration of artificial intelligence (AI) in higher education, focusing on its applications, benefits, challenges, and future directions. We reviewed 128 peer-reviewed articles published between 2010 and 2023, sourced from databases such as Scopus, Web of Science, and IEEE Xplore. The findings indicate that AI technologies, including machine learning, natural language processing, and computer vision, are increasingly used for personalized learning, automated assessment, intelligent tutoring systems, and administrative support. Key benefits include enhanced student engagement, improved learning outcomes, and efficiency in educational processes. However, challenges such as data privacy, ethical issues, algorithmic bias, and the digital divide persist. The review highlights the need for interdisciplinary collaboration, robust ethical frameworks, and inclusive AI design to maximize the potential of AI in higher education. Future research should explore longitudinal impacts and equitable implementation strategies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 4},
 author = {Lee},
 doi = {10.1007/s10639-024-13129-5},
