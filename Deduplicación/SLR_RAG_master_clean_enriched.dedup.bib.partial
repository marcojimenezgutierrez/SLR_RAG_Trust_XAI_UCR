 pages = {2817--2821},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Truth-{O}},
 url = {https://doi.org/10.1145/3626772.3657679},
 x_enrich_source = {x-ai/grok-4-fast},
