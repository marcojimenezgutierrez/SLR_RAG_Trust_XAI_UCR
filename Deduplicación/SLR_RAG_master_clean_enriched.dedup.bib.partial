@inproceedings{baughman_large_2024,
 abstract = {Vision-language models (VLMs) have achieved remarkable success in various multimodal tasks. However, they often exhibit undesirable biases inherited from their training data, leading to unfair and harmful outputs. Existing debiasing methods for VLMs are limited in their effectiveness and generalizability across different models and tasks. In this paper, we propose a simple yet effective debiasing approach for VLMs using biased prompts. Our method leverages the sensitivity of VLMs to input prompts by crafting counter-biased prompts that counteract the model's inherent biases. We evaluate our approach on multiple fairness benchmarks, including gender and racial bias in image captioning and visual question answering. Experimental results demonstrate that our prompt-based debiasing significantly reduces bias while maintaining high task performance. Our method is model-agnostic, requiring no access to model parameters or retraining, making it practical for real-world deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
