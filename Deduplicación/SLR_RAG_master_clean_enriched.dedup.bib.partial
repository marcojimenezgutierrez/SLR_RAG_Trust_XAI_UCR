@inproceedings{lee_sensible_2025,
 abstract = {Diffusion models have achieved remarkable success in image inpainting. However, existing methods often suffer from either high computational cost or limited performance in handling complex scenes. In this paper, we propose DiffuEraser, a multi-granularity diffusion model that achieves efficient and high-quality image inpainting. Specifically, we design a multi-granularity erasure strategy to progressively refine the inpainted regions from coarse to fine. At each granularity level, we employ a lightweight diffusion model to generate plausible content conditioned on the previously inpainted results. To further enhance efficiency, we introduce a knowledge distillation scheme to transfer the inpainting ability from a large teacher model to our student model. Extensive experiments on Places2 and CelebA-HQ demonstrate that DiffuEraser outperforms state-of-the-art methods in both quality and efficiency.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 and large multimodal models (lmms) to infer context and suggest appropriate actions delivered via minimally intrusive interaction modes. we demonstrate our prototype on an xr headset through a user study (n = {10) in both AR and VR scenarios. Results indicate that Sensible Agent significantly reduces perceived interaction effort compared to voice-prompted baseline},
 author = {Lee},
 based on real-time multimodal context sensing. informed by an expert workshop (n = {12) and a data annotation study (n=40)},
 booktitle = {Proceedings of the 38th {Annual}},
