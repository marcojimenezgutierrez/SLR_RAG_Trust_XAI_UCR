@inproceedings{yan_assertllm_2025,
 abstract = {Deep neural networks have achieved remarkable success in various visual recognition tasks. However, they can also inherit and amplify biases present in the training data, leading to unfair outcomes for certain demographic groups. Addressing fairness in visual recognition is crucial for deploying DNNs in real-world applications. In this paper, we provide a comprehensive overview of fairness in visual recognition, including bias sources, evaluation metrics, mitigation strategies, and future directions. We discuss the challenges and opportunities in achieving fair visual recognition and highlight the importance of interdisciplinary collaboration to develop fair and inclusive AI systems.},
