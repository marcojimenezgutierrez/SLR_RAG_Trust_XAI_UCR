 title = {Making {LLMs}},
 url = {https://doi.org/10.1145/3604237.3626891},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:52:03Z},
 year = {2023}
}

@inproceedings{lovtsov_automated_2025,
 abstract = {This paper proposes a novel control strategy for grid-forming inverters in microgrids to enhance stability under high renewable penetration. The approach integrates adaptive virtual inertia and damping control with machine learning-based prediction of load variations. Simulation results demonstrate improved frequency regulation and reduced oscillations compared to conventional methods. Experimental validation on a hardware-in-the-loop setup confirms the feasibility and robustness of the proposed technique.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
