@article{xiong_when_2024,
 abstract = {Achieving generalist robot policies that can perform a wide range of tasks in diverse environments remains a central challenge in robotics. While large-scale data and foundation models have led to remarkable successes in other domains, robotic learning has been limited by the lack of high-quality, diverse, and large-scale datasets. To address this, we introduce RT-X, a new dataset and model family for real-world robotics. RT-X comprises over 1 million trajectories across 100+ robots and 20+ real-world environments, spanning manipulation, navigation, and multi-task settings. We also introduce RT-X models, a family of transformer-based policies trained on RT-X data, which demonstrate strong generalization to novel tasks and environments. Our models achieve state-of-the-art performance on benchmarks like BridgeData V2 and RoboTurk, and show promising results in real-world sim-to-real transfer on a Franka Panda robot. We release the RT-X dataset, models, and code to enable further research on generalist robotic policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Xiong},
 journal = {arXiv preprint arXiv …},
