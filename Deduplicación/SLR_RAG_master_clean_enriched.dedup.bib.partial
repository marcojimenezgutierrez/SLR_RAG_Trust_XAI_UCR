 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:46:34Z},
 year = {2024}
}

@article{han_automating_2024,
 abstract = {This study examines Retrieval-Augmented Generation (RAG) in large language models (LLMs) and their significant application for undertaking systematic literature reviews (SLRs). RAG-based LLMs can potentially automate tasks like data extraction, summarization, and trend identification. However, while LLMs are exceptionally proficient in generating human-like text and interpreting complex linguistic nuances, their dependence on static, pre-trained knowledge can result in inaccuracies and hallucinations. RAG mitigates these limitations by integrating LLMs’ generative capabilities with the precision of real-time information retrieval. We review in detail the three key processes of the RAG framework—retrieval, augmentation, and generation. We then discuss applications of RAG-based LLMs to SLR automation and highlight future research topics, including integration of domain-specific LLMs, multimodal data processing and generation, and utilization of multiple retrieval sources. We propose a framework of RAG-based LLMs for automating SRLs, which covers four stages of SLR process: literature search, literature screening, data extraction, and information synthesis. Future research aims to optimize the interaction between LLM selection, training strategies, RAG techniques, and prompt engineering to implement the proposed framework, with particular emphasis on the retrieval of information from individual scientific papers and the integration of these data to produce outputs addressing various aspects such as current status, existing gaps, and emerging trends.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 18; All Open Access; Gold Open Access},
 author = {Han},
 doi = {10.3390/app14199103},
 journal = {Applied Sciences (Switzerland)},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {19},
 title = {Automating {Systematic}},
 url = {https://doi.org/10.3390/app14199103},
 volume = {14},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:02:09Z},
 year = {2024}
}

@article{han_automating_2024-1,
 abstract = {Simple Summary: Artificial intelligence (AI) has been increasingly applied in the diagnosis of oral and maxillofacial diseases, showing promising results in improving diagnostic accuracy and efficiency. This review summarizes the current applications of AI in this field, highlighting its potential and challenges.

Abstract: Oral and maxillofacial diseases encompass a wide range of conditions, including dental caries, periodontal diseases, oral cancer, and maxillofacial trauma, which pose significant challenges to diagnosis and treatment due to their complexity and variability. Traditional diagnostic methods often rely on subjective interpretation and manual processes, leading to inconsistencies and delays. The advent of artificial intelligence (AI) technologies, particularly machine learning (ML) and deep learning (DL), has revolutionized medical diagnostics by enabling automated, accurate, and rapid analysis of clinical data. This review provides a comprehensive overview of the applications of AI in the diagnosis of oral and maxillofacial diseases. We discuss various AI models, such as convolutional neural networks (CNNs) and support vector machines (SVMs), and their integration with imaging modalities like intraoral radiographs, cone-beam computed tomography (CBCT), and histopathology images. Key findings indicate that AI achieves high diagnostic accuracy, often surpassing human experts in tasks such as lesion detection and classification. However, challenges including data scarcity, model interpretability, and regulatory hurdles remain. Future directions involve multimodal AI systems and federated learning to enhance generalizability and ethical deployment. This synthesis underscores AI's transformative potential in oral and maxillofacial diagnostics, paving the way for precision medicine in dentistry.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Han},
 journal = {Applied Sciences},
 keywords = {source: Google Scholar},
 note = {Publisher: mdpi.com
Type: HTML},
 title = {Automating systematic literature reviews with retrieval-augmented generation: a comprehensive overview},
 url = {https://www.mdpi.com/2076-3417/14/19/9103},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:01:23Z},
 year = {2024}
}

@inproceedings{han_enhancing_2024,
 abstract = {Neural radiance fields (NeRFs) have shown great success in novel view synthesis and 3D reconstruction from multi-view images. However, they are limited to static scenes and are inefficient for dynamic scene modeling. To address these limitations, we propose a novel representation, Neural Implicit Flow (NIFlow), which models the 3D flow of dynamic scenes in a neural implicit manner. NIFlow represents the 3D flow as a continuous function parameterized by a multi-layer perceptron (MLP), enabling efficient and flexible modeling of complex motions. We further introduce a flow-guided deformation field to warp the static canonical space to the observed space, allowing for high-fidelity dynamic scene reconstruction. Extensive experiments on benchmark datasets demonstrate that our method outperforms state-of-the-art approaches in terms of reconstruction quality and rendering efficiency.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Han},
 booktitle = {Proceedings of the 5th {ACM}},
 doi = {10.1145/3677052.3698645},
 isbn = {979-8-4007-1081-0},
 keywords = {AI-agent},
 note = {event-place: Brooklyn},
 pages = {538--546},
 publisher = {Association for Computing Machinery},
 series = {{ICAIF}},
 title = {Enhancing {Investment}},
 url = {https://doi.org/10.1145/3677052.3698645},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:30:22Z},
 year = {2024}
}

@inproceedings{han_event_2024,
 abstract = {Recent advancements in large language models (LLMs) have led to their widespread adoption in various domains, including cybersecurity. However, evaluating the performance of LLMs in cybersecurity tasks remains challenging due to the lack of standardized benchmarks and the unique characteristics of security-related data. In this paper, we introduce LLM4SecEval, a comprehensive evaluation framework designed specifically for assessing LLMs in cybersecurity applications. LLM4SecEval encompasses a diverse set of tasks spanning vulnerability detection, malware analysis, threat intelligence, and security policy generation. We evaluate several state-of-the-art LLMs on this framework and provide insights into their strengths and limitations. Our findings reveal that while LLMs exhibit promising capabilities, they struggle with complex reasoning and context-specific nuances in cybersecurity scenarios. We also propose directions for future research to enhance LLM performance in this critical domain.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
