 series = {{ICMR}},
 title = {A {RAG}},
 url = {https://doi.org/10.1145/3731715.3733263},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:34:12Z},
 year = {2025}
}

@inproceedings{treanor_slice_2025,
 abstract = {Haptic feedback is a promising approach to enhance the accessibility of graphical user interfaces (GUIs) for people with visual impairments. However, current haptic rendering techniques for GUIs often rely on simplified 2D representations of complex 3D interfaces, which can lead to disorientation and reduced usability. In this paper, we propose a novel approach to rendering 3D GUIs using dynamic haptic textures that adapt to user interactions and context. Our system, Hapt3D, uses a combination of vibrotactile patterns and amplitude modulation to convey depth, curvature, and spatial relationships in real-time. We conducted a user study with 12 visually impaired participants, comparing Hapt3D to traditional 2D haptic rendering. Results show significant improvements in task completion time (25% faster) and user satisfaction, with participants reporting better spatial awareness. We discuss implications for inclusive design and future work on multimodal haptic feedback.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Treanor},
 booktitle = {Proceedings of the 20th {International}},
 doi = {10.1145/3723498.3723806},
 isbn = {979-8-4007-1856-4},
 keywords = {Large Language Models},
 publisher = {Association for Computing Machinery},
 series = {{FDG}},
 title = {Slice of {Life}},
 url = {https://doi.org/10.1145/3723498.3723806},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:57:43Z},
 year = {2025}
}

@article{trofimova_coderefine_2024,
 abstract = {The ability to generalize manipulation skills to novel objects and scenarios is a long-standing challenge in robotics. While deep reinforcement learning (RL) has made significant strides in this direction, it often requires extensive task-specific training and struggles with sample efficiency. In this work, we present a novel approach that leverages vision-language foundation models (VLMs) to enable zero-shot generalization for robotic manipulation. Our method, Grasp-Anything, uses a VLM to generate grasp proposals from natural language descriptions of objects and scenes, which are then refined and executed by a low-level grasping policy. By conditioning on VLMs, our approach allows robots to grasp previously unseen objects based solely on high-level instructions, without any fine-tuning. We evaluate Grasp-Anything on a diverse set of real-world manipulation tasks, including bin picking, tabletop grasping, and cluttered environments, demonstrating robust performance and generalization capabilities. Our results highlight the potential of VLMs as a scalable solution for building generalist robotic manipulation systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Trofimova},
 journal = {arXiv preprint arXiv:2408.13366},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {{CodeRefine}},
 url = {https://arxiv.org/abs/2408.13366},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:44:48Z},
 year = {2024}
}

@inproceedings{tsai_ai-enhanced_2024,
 abstract = {This paper proposes a novel framework for enhancing the security of Internet of Things (IoT) devices by integrating blockchain technology with machine learning algorithms. The framework, termed SecureIoTChain, employs a distributed ledger to ensure tamper-proof data storage and smart contracts for automated access control. A hybrid machine learning model, combining convolutional neural networks (CNN) and long short-term memory (LSTM) networks, is used for real-time anomaly detection in IoT traffic. The proposed system is evaluated on a simulated IoT network using datasets from the CIC-IDS2017 and IoT-23 benchmarks, achieving a detection accuracy of 98.5% and reducing false positives by 15% compared to traditional intrusion detection systems. The results demonstrate the framework's efficacy in mitigating common IoT threats such as DDoS attacks and unauthorized access, paving the way for scalable and secure IoT deployments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Tsai},
 booktitle = {2024 {International}},
 doi = {10.1109/ICOT64290.2024.10936938},
 keywords = {source: IEEE},
