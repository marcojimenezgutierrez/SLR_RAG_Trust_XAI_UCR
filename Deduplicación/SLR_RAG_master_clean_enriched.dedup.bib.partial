 year = {2024}
}

@inproceedings{haag_last_2025,
 abstract = {We present Zippy3DGS, a novel method for object-aware 3D Gaussian Splatting from a single image. Unlike previous methods that rely on multi-view images or videos, our approach enables high-quality 3D reconstruction and novel view synthesis of general objects from a single input image. We achieve this by leveraging a pre-trained large vision model to extract rich semantic and geometric priors, which guide the initialization and densification of 3D Gaussians. To handle the ambiguity inherent in single-image inputs, we introduce an object-centric coordinate system and a novel regularization strategy that enforces consistency across views. Our method produces state-of-the-art results in terms of reconstruction quality and rendering speed, enabling real-time novel view synthesis on consumer GPUs. Extensive experiments on benchmark datasets demonstrate the effectiveness of Zippy3DGS for applications in AR/VR and content creation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Haag},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713307},
