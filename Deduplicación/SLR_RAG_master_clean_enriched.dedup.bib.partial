 note = {event-place: Hannover},
 pages = {1052--1055},
 publisher = {Association for Computing Machinery},
 series = {{WSDM}},
 title = {Ventana a la {Verdad}},
 url = {https://doi.org/10.1145/3701551.3704123},
 x_enrich_source = {x-ai/grok-4-fast},
