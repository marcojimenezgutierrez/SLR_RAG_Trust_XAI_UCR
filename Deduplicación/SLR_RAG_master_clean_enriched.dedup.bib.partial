 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:26:50Z},
 year = {2023}
}

@article{friel_ragbench_2024,
 abstract = {We introduce Grok-1, our large language model. Grok-1 is a 314 billion parameter Mixture-of-Experts model trained from scratch by xAI. It was trained on a custom training stack built by the xAI team using JAX and Rust, and Kubernetes for orchestration. The model was trained on a large amount of text data, and has capabilities in language understanding, mathematics, coding, and instruction-following tasks. Grok-1 has not been fine-tuned for any specific application, and is a raw base model checkpoint. We release the weights and architecture of Grok-1 under the Apache 2.0 license.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
