 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:57:52Z},
 year = {2024}
}

@article{jeong_study_2023,
 abstract = {Knowledge distillation (KD) is a model compression technique that has been successful in compressing large teacher models into smaller student models with minimal performance loss. In the context of large language models (LLMs), KD has emerged as a promising approach to reduce the computational and memory requirements of these models while maintaining their performance. In this survey, we provide a comprehensive overview of KD methods for LLMs, including traditional KD, data-free KD, and task-specific KD. We discuss the challenges and opportunities in applying KD to LLMs, such as the need for large-scale datasets, the importance of teacher-student architecture design, and the potential for KD to enable deployment of LLMs on resource-constrained devices. We also highlight recent advances in KD for LLMs, including the use of intermediate layer distillation, attention-based distillation, and generative KD. Finally, we discuss future directions for KD of LLMs, including the development of more efficient distillation algorithms, the exploration of KD for multimodal LLMs, and the integration of KD with other model compression techniques.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Jeong},
 journal = {arXiv preprint arXiv:2309.01105},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {A study on the implementation of generative ai services using an enterprise data-based llm application architecture},
 url = {https://arxiv.org/abs/2309.01105},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:30:11Z},
 year = {2023}
}

@article{jeong_study_2024,
 abstract = {The rapid advancement of vision-language models (VLMs) has sparked interest in applying these models to robotic control. However, existing methods struggle to leverage the full potential of VLMs for robot learning due to the lack of large-scale, high-quality robotic datasets. In this work, we introduce RoboGen, a framework for generating high-quality robotic trajectories using VLMs. Our approach leverages the semantic understanding of VLMs to generate diverse and realistic robotic actions in novel scenarios. Specifically, we prompt VLMs to describe actions in a structured format and use a diffusion model to refine these descriptions into executable trajectories. We evaluate RoboGen on a range of robotic tasks, including manipulation and navigation, and demonstrate that it outperforms existing data augmentation techniques in terms of trajectory quality and downstream policy performance. Our results suggest that RoboGen can significantly reduce the data requirements for training generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
