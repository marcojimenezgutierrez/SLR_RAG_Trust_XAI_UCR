@inproceedings{shelley_flora-rag_2025,
 abstract = {Abstract—Artificial intelligence (AI) has revolutionized various sectors, including education. This paper investigates the integration of AI-driven chatbots in higher education for enhancing student engagement and support services. We propose a novel chatbot framework utilizing natural language processing (NLP) and machine learning techniques to provide personalized academic advising, real-time query resolution, and mental health support. The system was implemented and tested in a university setting with 500 students over a semester. Results indicate a 35% increase in student satisfaction and a 25% reduction in response time for administrative queries compared to traditional methods. Challenges such as data privacy and ethical considerations are discussed, along with future directions for scalable deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
