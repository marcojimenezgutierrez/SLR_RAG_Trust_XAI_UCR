@inproceedings{benedict_gen-ir_2024,
 abstract = {Recent advances in vision-language models (VLMs) have led to impressive performance across a variety of tasks. However, these models often exhibit biases inherited from their training data, resulting in unfair and discriminatory outputs. Mitigating such biases is crucial for deploying VLMs in real-world applications. In this paper, we propose a simple yet effective approach to debias VLMs by leveraging biased prompts. Specifically, we generate counterfactual prompts that intentionally introduce biases in the opposite direction to counteract the model's inherent biases. Our method does not require retraining or fine-tuning the model, making it computationally efficient. Extensive experiments on multiple benchmark datasets demonstrate that our biased prompt-based debiasing significantly reduces bias metrics while preserving the model's overall performance. Our findings highlight the potential of prompt engineering as a practical tool for promoting fairness in VLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
