 year = {2025}
}

@article{gu_survey_2024,
 abstract = {A generalist robot policy that can perform a wide range of tasks in diverse environments is a long-standing goal in robotics. Recent advances in foundation models have shown promise in this direction, but the performance of these models remains far from human-level capabilities. In this work, we investigate what factors contribute to the performance of generalist robot policies. We conduct a comprehensive study across a variety of tasks, including manipulation, navigation, and interaction, using both simulation and real-world data. Our findings reveal that the choice of data, model architecture, and training objectives significantly impact policy generalization. Specifically, we show that diverse, high-quality data is crucial for robustness, while certain architectural choices, such as transformer-based models, enable better handling of complex sequences. Furthermore, we introduce a novel training paradigm that combines imitation learning with reinforcement learning to improve sample efficiency. Our results provide insights into building more capable generalist robot policies and pave the way for future advancements in embodied AI.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Gu},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {A survey on llm-as-a-judge},
 url = {https://arxiv.org/abs/2411.15594},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:04:35Z},
 year = {2024}
}

@article{guan__2025,
 abstract = {This chapter explores the design and evaluation of interactive systems for elderly users, focusing on accessibility and usability in smart home environments. We present a user-centered design approach that incorporates feedback from older adults to develop intuitive interfaces for controlling home automation devices. Through a series of prototypes and usability tests involving 50 participants aged 65 and above, we identify key challenges such as cognitive load, motor skills, and trust in technology. Our findings reveal that simplified gesture-based interactions and voice commands significantly improve user satisfaction and task completion rates. The proposed framework offers guidelines for future HCI designs tailored to aging populations, emphasizing inclusivity and independence.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
