@inproceedings{salminen_communication_2024,
 abstract = {Visual question answering (VQA) has seen rapid progress over the past few years, thanks to the development of large-scale datasets and powerful vision-and-language models. However, the evaluation of VQA models remains a challenge, as it requires assessing the correctness of answers that are often short and ambiguous. In this paper, we propose a new evaluation metric for VQA that is more robust to annotation noise and better correlates with human judgments. Our metric, called VQA-CP, is based on the concept of consensus among multiple annotations and can be computed efficiently without requiring additional human annotations. We evaluate VQA-CP on several popular VQA datasets and show that it provides a more reliable assessment of model performance compared to existing metrics.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
