@inproceedings{saketos_large_2024,
 abstract = {Visual Question Answering (VQA) is a challenging multimodal task that requires deep understanding of both images and natural language questions. Despite the remarkable progress made in recent years, the fairness issue in VQA has been largely overlooked. In this paper, we conduct a comprehensive survey on fairness in VQA. We first categorize the fairness issues in VQA into three main types: group fairness, individual fairness, and counterfactual fairness. Then, we review the existing methods for addressing these fairness issues, including dataset construction, model debiasing, and post-processing. Finally, we discuss the challenges and future directions for fair VQA.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
