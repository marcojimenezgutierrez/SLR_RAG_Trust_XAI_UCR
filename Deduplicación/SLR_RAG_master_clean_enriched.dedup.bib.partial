@article{mukherjee_llm-driven_2025,
 abstract = {This paper introduces a novel framework for learning generalist robot policies that can perform a wide range of manipulation tasks in unstructured environments. We address key challenges in scaling robot learning, including data efficiency, sim-to-real transfer, and policy robustness. Our approach leverages large-scale self-supervised pretraining on diverse datasets, followed by fine-tuning with reinforcement learning and imitation learning. Experiments on real-world robotic platforms demonstrate that our policies achieve state-of-the-art performance across 50+ tasks, including picking, placing, and assembly, outperforming specialized baselines by up to 40% in success rate. We also analyze the impact of dataset composition, model architecture, and training paradigms on generalization, providing insights for future advancements in embodied AI.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
