 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:12:47Z},
 year = {2025}
}

@inproceedings{tamanna_navigating_2024,
 abstract = {This paper proposes a novel framework for enhancing the security of Internet of Things (IoT) devices using blockchain technology integrated with artificial intelligence (AI). The proposed system leverages smart contracts to automate access control and data sharing among IoT nodes, while AI algorithms detect and mitigate potential cyber threats in real-time. We evaluate the framework through simulations on a testbed consisting of 100 heterogeneous IoT devices, demonstrating a 35% improvement in threat detection accuracy and a 28% reduction in latency compared to traditional centralized approaches. The results highlight the framework's scalability and robustness against common attacks such as DDoS and man-in-the-middle. Future work will focus on real-world deployment and energy efficiency optimizations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
