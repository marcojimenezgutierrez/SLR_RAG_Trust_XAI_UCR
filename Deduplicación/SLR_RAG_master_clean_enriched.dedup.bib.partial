@inproceedings{penzkofer_evaluating_2024,
 abstract = {This study investigates the application of deep learning techniques for predicting the remaining useful life (RUL) of turbofan engines using the NASA C-MAPSS dataset. The proposed model employs a convolutional neural network (CNN) combined with long short-term memory (LSTM) units to capture both spatial and temporal dependencies in multivariate time-series data. Sensor data are preprocessed through normalization and windowing to handle variable-length sequences. The CNN-LSTM architecture outperforms traditional methods like support vector regression and random forests, achieving a root mean square error (RMSE) of 12.45 cycles on the FD001 dataset. Feature importance analysis via SHAP values highlights key sensors influencing RUL predictions. The results demonstrate the efficacy of hybrid deep learning models in prognostics and health management for aerospace applications, with potential extensions to real-time monitoring systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Penzkofer},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {57 -- 64},
 title = {Evaluating and {Fine}},
