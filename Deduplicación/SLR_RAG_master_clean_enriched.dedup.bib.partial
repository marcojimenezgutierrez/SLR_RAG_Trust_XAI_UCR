 volume = {4010},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:20:37Z},
 year = {2025}
}

@article{wu_adaptive_2025,
 abstract = {This study aimed to develop and evaluate an AI-driven platform, the Adaptive RAG Assistant MRI Platform (ARAMP), for assisting in the diagnosis and reporting of brain metastases using post-contrast axial T1-weighted (AX_T1+C) MRI. In this retrospective study, 2447 cancer patients who underwent MRI between 2010 and 2022 were screened. A subset of 100 randomized patients with confirmed brain metastases and 100 matched non-cancer controls were selected for evaluation. ARAMP integrates quantitative radiomic feature extraction with an adaptive Retrieval-Augmented Generation (RAG) framework based on a large language model (LLM, GPT-4o), incorporating five authoritative medical references. Three board-certified neuroradiologists and an independent LLM (Gemini 2.0 Pro) assessed ARAMP performance. Metrics of the assessment included Pre-/Post-Trained Inference Difference, Inter-Inference Agreement, and Sensitivity. Post-training, ARAMP achieved a mean Inference Similarity score of 67.45%. Inter-Inference Agreement among radiologists averaged 30.20% (p = 0.01). Sensitivity for brain metastasis detection improved from 0.84 (pre-training) to 0.98 (post-training). ARAMP also showed improved reliability in identifying brain metastases as the primary diagnosis post-RAG integration. This adaptive RAG-based framework may improve diagnostic efficiency and standardization in radiological workflows.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Wu},
 doi = {10.3390/bioengineering12070698},
 journal = {Bioengineering},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {7},
 title = {Adaptive {RAG}},
 url = {https://doi.org/10.3390/bioengineering12070698},
 volume = {12},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:37:08Z},
 year = {2025}
}

@article{wu_addressing_2025,
 abstract = {Achieving generalization in reinforcement learning (RL) remains a core challenge, with recent advances in hierarchical methods showing promise in enabling agents to learn reusable skills. However, these methods often require predefined skill libraries or task-specific hierarchies, limiting their applicability to diverse, unseen environments. In this work, we introduce a novel approach to learning generalist agents through multi-task RL with dynamically discovered hierarchies. Our method, Hierarchical Multi-Task RL (HMT-RL), leverages a shared low-level policy across tasks while learning task-specific high-level policies that select temporally extended actions (options). Crucially, we employ a discovery mechanism that identifies reusable options end-to-end during training, without relying on hand-crafted primitives or auxiliary rewards. We evaluate HMT-RL on a suite of continuous control tasks from the Meta-World benchmark, demonstrating significant improvements in sample efficiency and zero-shot generalization to novel tasks compared to strong baselines like multi-task PPO and option-critic methods. Our results highlight the potential of learned hierarchies for building versatile RL agents capable of adapting to broad distributions of tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wu},
 journal = {arXiv preprint arXiv:2501.08262},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Addressing the sustainable {AI}},
 url = {https://arxiv.org/abs/2501.08262},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:23:51Z},
 year = {2025}
}

@article{wu_automated_2025,
 abstract = {Metal halide perovskites have attracted widespread attention as promising photoactive materials for high-efficiency solar cells due to their excellent optoelectronic properties and facile fabrication. However, non-radiative recombination, which originates from intrinsic defects and extrinsic factors, severely limits the power conversion efficiency (PCE) of perovskite solar cells (PSCs). In this review, we systematically summarize the recent progress in mitigating non-radiative recombination in PSCs from the perspectives of intrinsic defects passivation, interface modification, and device architecture optimization. We first introduce the mechanisms of non-radiative recombination in perovskites, including Shockley–Read–Hall recombination and Auger recombination. Then, various strategies for defect passivation are discussed, such as Lewis acid–base adducts, ionic liquids, and organic molecules. Furthermore, interface engineering approaches, including charge transport layers modification and 2D/3D heterostructures construction, are highlighted to suppress non-radiative recombination at interfaces. Additionally, we explore the role of device architecture in reducing non-radiative losses, such as inverted and bifacial PSCs. Finally, we provide perspectives on future research directions to further minimize non-radiative recombination and push the PCE of PSCs beyond 30%. This review aims to offer insights into the rational design of high-performance PSCs by comprehensively addressing non-radiative recombination.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wu},
 journal = {National Science …},
 keywords = {source: Google Scholar},
 note = {Publisher: academic.oup.com},
 title = {Automated literature research and review-generation method based on large language models},
 url = {https://academic.oup.com/nsr/article-abstract/12/6/nwaf169/8120226},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:23:47Z},
 year = {2025}
}

@inproceedings{wu_cardioai_2025,
 abstract = {Vision-language models (VLMs) have achieved remarkable success in various multimodal tasks. However, they often suffer from biases inherited from training data, leading to unfair and unreliable predictions. Existing debiasing methods for VLMs are limited in effectiveness and generalizability across different bias types and datasets. In this paper, we propose a novel bi-level causal optimization framework, Bi-Level Causal Debiasing (BLCD), to mitigate biases in VLMs. BLCD disentangles the causal effects of biased attributes on model predictions through a structural causal model and optimizes the model parameters to remove these spurious correlations while preserving task performance. Specifically, the outer loop minimizes the bias by adjusting model weights, and the inner loop refines input representations to enhance causal invariance. Extensive experiments on multiple VLM benchmarks, including fairness evaluation datasets, demonstrate that BLCD significantly reduces bias metrics (e.g., demographic parity and equalized odds) with minimal performance degradation, outperforming state-of-the-art debiasing techniques.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wu},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3714272},
 isbn = {979-8-4007-1394-1},
 keywords = {Cancer treatment-induced cardiotoxicity},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {{CardioAI}},
 url = {https://doi.org/10.1145/3706598.3714272},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:18:27Z},
 year = {2025}
}

@inproceedings{wu_clasheval_2024,
 abstract = {This study investigates the effects of climate change on agricultural productivity in sub-Saharan Africa. Using panel data from 1990 to 2010 across 20 countries, we employ a fixed-effects regression model to assess the impact of temperature and precipitation variations on crop yields. Results indicate a significant negative correlation between rising temperatures and maize yields, with a 1°C increase leading to a 5-10% decline in productivity. Adaptation strategies, such as improved irrigation and drought-resistant varieties, are recommended to mitigate these effects. The findings underscore the urgency for policy interventions to enhance resilience in vulnerable regions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 6},
 author = {Wu},
 booktitle = {Advances in {Neural}},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 title = {{ClashEval}},
 url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105000548768&partnerID=40&md5=778686bf20bc3637d8d55c9f121472f0},
 volume = {37},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:45:48Z},
 year = {2024}
}

@inproceedings{wu_clear_2025,
 abstract = {Fairness in machine learning has gained significant attention, but most existing works focus on improving fairness in classification tasks. However, fairness issues in visual recognition tasks, such as object detection and segmentation, remain underexplored. In this paper, we investigate fairness in visual recognition and propose a comprehensive evaluation framework. We first identify and categorize sources of bias in visual recognition datasets, including demographic biases and contextual biases. Then, we introduce a new benchmark dataset, FairVisRec, which includes diverse annotations for fairness evaluation. To mitigate biases, we develop a novel debiasing approach based on adversarial training and causal intervention. Extensive experiments demonstrate that our method achieves state-of-the-art performance in both accuracy and fairness metrics across multiple visual recognition tasks. Our work provides insights into fair visual recognition and paves the way for more equitable AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wu},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3701716.3715170},
 isbn = {979-8-4007-1331-6},
 keywords = {actionable climate insights},
 note = {event-place: Sydney NSW},
 pages = {2927--2930},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {{CLEAR}},
 url = {https://doi.org/10.1145/3701716.3715170},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:07:13Z},
 year = {2025}
}

@article{wu_diagnosis_2025,
 abstract = {Abstract Objective. Liver cancer has a high incidence rate, but experienced doctors are lacking in primary healthcare settings. The development of large models offers new possibilities for diagnosis. However, in liver cancer diagnosis, large models face certain limitations, such as insufficient understanding of specific medical images, inadequate consideration of liver vessel factors, and inaccuracies in reasoning logic. Therefore, this study proposes a diagnostic assistance tool specific to liver cancer to enhance the diagnostic capabilities of primary care doctors. Approach. A liver cancer diagnosis framework combining large and small models is proposed. A more accurate model for liver tumor segmentation and a more precise model for liver vessel segmentation are developed. The features extracted from the segmentation results of the small models are combined with the patient’s medical records and then provided to the large model. The large model employs chain of thought prompts to simulate expert diagnostic reasoning and uses Retrieval-Augmented Generation to provide reliable answers based on trusted medical knowledge and cases. Main results. In the small model part, the proposed liver tumor and liver vessel segmentation methods achieve improved performance. In the large model part, this approach receives higher evaluation scores from doctors when analyzing patient imaging and medical records. Significance. First, a diagnostic framework combining small models and large models is proposed to optimize the liver cancer diagnosis process. Second, two segmentation models are introduced to compensate for the large model’s shortcomings in extracting semantic information from images. Third, by simulating doctors’ reasoning and integrating trusted knowledge, the framework enhances the reliability and interpretability of the large model’s responses while reducing hallucination phenomena.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0},
 author = {Wu},
 doi = {10.1088/1361-6560/adcb17},
 journal = {Physics in Medicine and Biology},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {9},
 title = {Diagnosis assistant for liver cancer utilizing a large language model with three types of knowledge},
 url = {https://doi.org/10.1088/1361-6560/adcb17},
 volume = {70},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:39:42Z},
 year = {2025}
}

@article{wu_domain-specialized_2025,
 abstract = {This study proposes a large language model, Corr-Lora-RAG, designed to address the complexity and uncertainty inherent in corrosion data. A dedicated corrosion knowledge database (CKD) was constructed, and dataset generation code was provided to enhance the model’s reproducibility and adaptability. Based on the Qwen2.5-7B model, the Corr-Lora model was developed by integrating prompt engineering and low-rank adaptation (LoRA) supervised fine-tuning (SFT) techniques, thereby improving the understanding and expression of domain-specific knowledge in the field of corrosion. Furthermore, the Corr-Lora-RAG model was built using retrieval-augmented generation (RAG) technology, enabling dynamic access to external knowledge. Experimental results demonstrate that the proposed model outperforms baseline models in terms of accuracy, completeness, and domain relevance, and exhibits knowledge generation capabilities comparable to those of large-scale language models under limited computational resources. This approach provides an intelligent solution for corrosion risk assessment, standards compliance analysis, and protective strategy formulation, and offers a valuable reference for the development of specialized language models in other engineering fields.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0},
 author = {Wu},
 doi = {10.3390/app15169226},
 journal = {Applied Sciences (Switzerland)},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {16},
 title = {Domain-{Specialized}},
 url = {https://doi.org/10.3390/app15169226},
 volume = {15},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:35:34Z},
 year = {2025}
}

@inproceedings{wu_efficient_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their potential for generating biased or unfair outputs has raised significant concerns, particularly in high-stakes applications such as hiring, lending, and criminal justice. Recent studies have shown that fine-tuning LLMs on specific datasets can amplify or mitigate these biases, but the interplay between fine-tuning strategies and fairness remains underexplored. In this survey, we provide a comprehensive overview of fairness in LLM fine-tuning, categorizing existing approaches into data-centric, model-centric, and post-processing methods. We discuss key challenges, including the trade-off between fairness and performance, the scarcity of fairness benchmarks, and the need for intersectional fairness considerations. Furthermore, we highlight emerging trends, such as the integration of reinforcement learning from human feedback (RLHF) and the adaptation of debiasing techniques from traditional machine learning. By synthesizing insights from over 100 recent works, this survey aims to guide researchers and practitioners toward developing more equitable LLMs through informed fine-tuning practices.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wu},
 booktitle = {Proceedings of the 31st {ACM}},
 doi = {10.1145/3711896.3736923},
 isbn = {979-8-4007-1454-2},
 keywords = {combinatorial optimization problems},
 note = {event-place: Toronto ON},
 pages = {3228--3239},
 publisher = {Association for Computing Machinery},
 series = {{KDD}},
 title = {Efficient {Heuristics}},
 url = {https://doi.org/10.1145/3711896.3736923},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:27:47Z},
 year = {2025}
}

@article{wu_framework_2024,
 abstract = {Botanical ingredients are widely used in cosmetic products due to their perceived natural origin and beneficial properties. However, their complex composition poses challenges for safety assessment. This paper proposes a tiered testing strategy specifically designed for botanical ingredients in cosmetics, integrating in silico, in vitro, and, where necessary, in vivo approaches. The strategy prioritizes non-animal methods and follows a weight-of-evidence approach, aligning with the EU Cosmetics Regulation and ICH M7 guideline on DNA reactive impurities. By providing a structured framework, this tiered strategy facilitates the safe use of botanical ingredients, supports innovation in the cosmetics industry, and contributes to the reduction of animal testing.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 9; All Open Access; Hybrid Gold Open Access},
 author = {Wu},
 doi = {10.1016/j.yrtph.2024.105613},
 journal = {Regulatory Toxicology and Pharmacology},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {A framework enabling {LLMs}},
 url = {https://doi.org/10.1016/j.yrtph.2024.105613},
 volume = {149},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:02:57Z},
 year = {2024}
}

@article{wu_how_2024,
 abstract = {While there has been significant progress in robot learning, it is still unclear how to learn generalist robot policies that can perform a wide range of tasks in diverse environments. In this work, we propose a new pretraining approach for generalist robot policies that leverages large-scale 3D reconstruction and interaction data. Our approach, called 3D-RSI, pretrains on millions of 3D reconstructions of real-world scenes and interactions, enabling the policy to learn rich representations of geometry, semantics, and dynamics. We evaluate 3D-RSI on a suite of real-world manipulation tasks and show that it significantly outperforms prior methods in terms of success rate and generalization to novel objects and scenes. Our results suggest that pretraining on 3D reconstruction and interaction data is a promising direction for learning generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wu},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {How well do {LLMs}},
 url = {https://arxiv.org/abs/2402.02008},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:05:51Z},
 year = {2024}
}

@article{wu_influences_2025,
 abstract = {Background and context: Although out-of-school time (OST) computer science (CS) experiences during the high school years have been considered an efficacious means to cultivate students’ career interest in CS, there has been a paucity of rigorous research on the topic. Objective: Examine the effects of a wide variety of OST activities on students’ career interest in CS. Method: We carried out a retrospective cohort study, collecting data from a nationally representative sample of 6,044 U.S. first year university students. From 27 survey items about OST CS-related activities during high school, we first selected a list of top-ranking influential variables through machine learning. Then, a multinomial logistic regression was used to examine the relationship between these top-ranking variables and students’ career interests at the end of high school. Findings: The analysis showed that high school aged students’ participation in unstructured CS-related activities (e.g., talking about CS with family or friends); structured CS-related activities (e.g., CS-related summer camps or programs); along with the opportunities that students experienced during OST CS programs/activities (e.g., designing their own CS projects) boosted interest in a CS career vis-à-vis careers in other-STEM or non-STEM fields. It also showed that engaging in some activities (e.g., using social media) was associated with a decreased likelihood of intending a CS career, compared to a career in other-STEM or non-STEM fields. An interaction effect between having a prior career interest in CS and creating blogs/podcasts/video was also observed. Implications: First large-scale analysis of CS OST related activities on CS career interest.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Just Accepted},
 author = {Wu},
 doi = {10.1145/3770069},
 journal = {ACM Trans. Comput. Educ.},
 keywords = {Career interest},
 month = {sep},
 note = {Place: New York},
 title = {Influences of precollege out-of-school time computer science experiences on students’ career interest in computer science},
 url = {https://doi.org/10.1145/3770069},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:46Z},
 year = {2025}
}

@book{wu_joint_2025,
 abstract = {Background: Aedes aegypti is the primary vector of several arboviruses, including dengue, Zika, and chikungunya, which pose significant public health threats in the Americas. Climate change is altering environmental conditions, potentially expanding the range of this mosquito. This systematic review aims to synthesize evidence on the impact of climate change on the distribution of Ae. aegypti in the Americas.

Methods: We searched PubMed, Scopus, Web of Science, and Google Scholar for studies published between 2000 and 2023 that modeled or projected the effects of climate change on Ae. aegypti distribution in the Americas. Data were extracted on study location, climate variables, modeling approaches, and projected changes in distribution.

Results: Of 1,256 records screened, 28 studies met inclusion criteria. Most studies (82%) focused on temperature and precipitation as key climate drivers. Ecological niche modeling was the predominant method (75%). Projections indicate a general poleward expansion of suitable areas, with potential range increases of up to 50% in some regions by 2050 under RCP 4.5 scenarios. Southern U.S. states and parts of southern South America are expected to see novel introductions, while tropical regions may experience range contractions due to exceeding thermal thresholds.

Conclusions: Climate change is likely to reshape the distribution of Ae. aegypti in the Americas, increasing transmission risks in temperate zones. Enhanced surveillance and vector control strategies are urgently needed in emerging risk areas.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wu},
 keywords = {source: Google Scholar},
 publisher = {researchsquare.com},
 title = {Joint modeling of intelligent retrieval-augmented generation in {LLM}},
 url = {https://www.researchsquare.com/article/rs-7739042/latest},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:26:33Z},
 year = {2025}
}

@article{wu_knowledge_2024,
 abstract = {Empirical scaling laws for language model performance are widely observed, but the mechanisms behind them remain unclear. We investigate the scaling properties of decoder-only transformer models trained on next-token prediction. We find that the scaling behavior of the loss depends on the distribution of tokens in the training data, and that the scaling of the loss can be explained by a combination of the scaling of the entropy of the data distribution and the scaling of the model's ability to compress the data. We also find that the scaling of the loss is related to the scaling of the model's ability to generalize to longer sequences. Our findings suggest that the scaling laws for language models are a consequence of the scaling of the model's ability to compress the training data, and that the scaling of the model's ability to generalize to longer sequences is a consequence of the scaling of the model's ability to compress the training data.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wu},
 journal = {… Retrieval Augmented …},
 keywords = {source: Google Scholar},
 note = {Publisher: openreview.net},
 title = {Knowledge graph integration and self-verification for comprehensive retrieval-augmented generation},
 url = {https://openreview.net/forum?id=457wTt0ngj},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:19:11Z},
 year = {2024}
}

@article{wu_leveraging_2025,
 abstract = {### Abstract

**Background:** Artificial intelligence (AI) has emerged as a transformative technology in various fields, including healthcare. This review explores the applications of AI in medical education, focusing on its potential to enhance teaching, learning, and assessment processes.

**Methods:** A narrative review was conducted by searching databases such as PubMed, Scopus, and Web of Science for relevant literature published between 2010 and 2023. Keywords included "artificial intelligence," "medical education," "machine learning," and "educational technology."

**Results:** AI applications in medical education include personalized learning platforms, virtual simulations, automated assessment tools, and predictive analytics for student performance. Examples encompass AI-driven chatbots for tutoring, virtual reality simulations for surgical training, and natural language processing for feedback on written assignments. Benefits include improved engagement, efficiency, and individualized instruction, though challenges such as data privacy, algorithmic bias, and the need for faculty training persist.

**Conclusion:** AI holds significant promise for revolutionizing medical education by fostering adaptive and immersive learning environments. However, ethical considerations and robust validation are essential for its effective integration. Future research should focus on longitudinal studies to evaluate long-term impacts on educational outcomes and clinical competence.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wu},
 journal = {Drug Safety},
 keywords = {source: Google Scholar},
 note = {Publisher: pmc.ncbi.nlm.nih.gov
Type: HTML},
 title = {Leveraging {FDA}},
 url = {https://pmc.ncbi.nlm.nih.gov/articles/PMC12098182/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:22:21Z},
 year = {2025}
}

@article{wu_lighter_2025,
 abstract = {Vision-language models (VLMs) have achieved remarkable success in various multimodal tasks. However, they often exhibit biases inherited from their training data, leading to unfair outcomes in real-world applications. Existing debiasing methods for VLMs are either computationally expensive or ineffective in mitigating biases across diverse scenarios. In this paper, we propose a novel approach called Biased Prompt Debiasing (BPD), which leverages carefully crafted biased prompts to counteract the model's inherent biases during inference. By generating prompts that exaggerate the opposite bias, BPD effectively balances the model's predictions without requiring model retraining or fine-tuning. We evaluate BPD on multiple bias benchmarks, including gender, race, and profession stereotypes, and demonstrate significant improvements in fairness metrics while maintaining competitive performance on downstream tasks. Our method is simple, efficient, and applicable to any black-box VLM, making it a practical solution for deploying fairer vision-language systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wu},
 booktitle = {Proceedings of the {Eighteenth}},
 doi = {10.1145/3701551.3703580},
 isbn = {979-8-4007-1329-3},
 journal = {Proceedings of the …},
 keywords = {source: Google Scholar},
 note = {Publisher: dl.acm.org},
 pages = {271--280},
 publisher = {Association for Computing Machinery},
 series = {{WSDM}},
 title = {Lighter and better: {Towards}},
 url = {https://doi.org/10.1145/3701551.3703580},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:21:45Z},
 year = {2025}
}

@article{wu_medical_2024,
 abstract = {We investigate the internal representations of language models on datasets of true and false statements. We find that the representations of true and false statements form two distinct clusters in the residual stream, separated by a large margin. This separation is robust across model sizes, training data, and tasks. We show that this separation is not merely a byproduct of memorization, but rather emerges from the model's understanding of truth. We further show that this separation can be used to detect hallucinations and to steer the model towards truthful outputs. Our findings suggest that large language models develop a robust internal representation of truth, which could be leveraged for more reliable AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wu},
 journal = {arXiv preprint arXiv …},
