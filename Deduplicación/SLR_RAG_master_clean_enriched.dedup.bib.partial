 series = {{CHI}},
 title = {Responsible {Prompting}},
 url = {https://doi.org/10.1145/3706598.3713365},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:16:58Z},
 year = {2025}
}

@inproceedings{santos_using_2025,
 abstract = {The rapid growth of Internet of Things (IoT) devices has led to an increase in data generation, necessitating efficient and secure data sharing mechanisms. Traditional centralized approaches suffer from single points of failure and privacy concerns. This paper proposes a blockchain-based framework for secure data sharing in IoT environments. The framework utilizes smart contracts to automate access control and ensures data integrity through cryptographic hashing. We implement a prototype using Hyperledger Fabric and evaluate its performance in terms of latency, throughput, and security against common attacks. Experimental results show that our approach achieves a 25% reduction in access time compared to existing methods while maintaining high security standards.},
