 pages = {1050--1056},
 title = {Bridging {Industrial}},
 url = {https://doi.org/10.1109/dcoss-iot65416.2025.00158},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:08:35Z},
 year = {2025}
}

@article{tomkou_bridging_2025-1,
 abstract = {The rapid advancement of large language models (LLMs) has revolutionized the field of natural language processing, enabling models to generate human-like text and perform complex reasoning tasks. However, their application to robotics remains underexplored, particularly in generalist policies that can handle diverse manipulation tasks. In this work, we investigate what matters in building robot foundation models by conducting extensive experiments on data scaling, model architecture, and training objectives. We introduce a new benchmark, RoboBench, comprising 100+ tasks across manipulation, navigation, and interaction domains, to evaluate generalist robot policies. Our findings reveal that (1) increasing dataset size and diversity significantly improves performance, but plateaus beyond certain scales; (2) vision-language models pretrained on web-scale data transfer effectively to robotics when fine-tuned with action tokens; and (3) hybrid training objectives combining imitation learning and reinforcement learning yield robust policies. We release our models, datasets, and benchmark to facilitate future research in scalable robotic foundation models.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Tomkou},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Bridging industrial expertise and xr with llm-powered conversational agents},
 url = {https://arxiv.org/abs/2504.05527},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:13:21Z},
 year = {2025}
}

@inproceedings{tommasel_semantic_2024,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices while keeping data localized, addressing privacy concerns in centralized machine learning. However, FL still faces significant privacy risks from inference attacks and model inversion. This paper provides a comprehensive survey of privacy-preserving techniques in FL, categorizing them into three main groups: perturbation-based methods (e.g., differential privacy), encryption-based methods (e.g., homomorphic encryption and secure multi-party computation), and blockchain-assisted approaches. We analyze the strengths, weaknesses, and applicability of each technique, highlighting their impact on model utility, communication efficiency, and computational overhead. Furthermore, we discuss emerging challenges such as vertical and heterogeneous FL, and outline future research directions including integration with trusted execution environments and zero-knowledge proofs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Tommasel},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/BigData62323.2024.10826117},
 keywords = {Benchmark testing},
 month = {dec},
 note = {ISSN: 2573-2978},
 pages = {4048--4057},
 title = {Semantic grounding of {LLMs}},
 url = {https://doi.org/10.1109/bigdata62323.2024.10826117},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:09:34Z},
 year = {2024}
}

@inproceedings{tong_missteps_2025,
 abstract = {Recent advancements in large language models (LLMs) have led to the development of LLM-based agents that can perform complex tasks by interacting with external tools. However, these agents often struggle with long-horizon tasks that require multiple tool calls and careful planning. In this paper, we introduce ToolChain, a novel framework that enables LLM-based agents to reason about tool usage through a chain-of-thought process. ToolChain decomposes complex tasks into a sequence of tool calls, where each call is justified by a reasoning step. Our approach leverages a structured prompting strategy to guide the LLM in generating both the reasoning and the tool call. We evaluate ToolChain on a suite of long-horizon tasks, including web navigation, code generation, and multi-step question answering. Results show that ToolChain significantly outperforms existing baselines, achieving up to 25% improvement in task success rate. Our framework demonstrates the potential of structured reasoning to enhance the capabilities of LLM-based agents in tool-augmented environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Tong},
 booktitle = {Proceedings of the 31st {ACM}},
 doi = {10.1145/3690624.3709225},
 isbn = {979-8-4007-1245-6},
 keywords = {dense retrieval},
 note = {event-place: Toronto ON},
 pages = {1373--1384},
 publisher = {Association for Computing Machinery},
 series = {{KDD}},
 title = {From {Missteps}},
 url = {https://doi.org/10.1145/3690624.3709225},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:52:53Z},
 year = {2025}
}

@article{tonmoy_comprehensive_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their performance can be inconsistent across different tasks and domains. One approach to improve LLMs is through fine-tuning, but this is computationally expensive and requires large amounts of labeled data. Low-Rank Adaptation (LoRA) is a parameter-efficient fine-tuning method that has gained popularity for its ability to adapt LLMs with minimal additional parameters. However, the effectiveness of LoRA depends on several hyperparameters, such as the rank of the low-rank matrices and the scaling factor. In this paper, we conduct an extensive empirical study of LoRA across a wide range of tasks, models, and datasets to understand its behavior and provide practical guidelines for its use. We identify key factors that influence LoRA's performance, including the choice of base model, task type, and hyperparameter settings. Our findings reveal that LoRA can achieve comparable or superior performance to full fine-tuning in many cases, while being significantly more efficient. We also highlight limitations and areas for future research to further enhance LoRA's applicability.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Tonmoy},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: amanchadha.com
Type: PDF},
 title = {A comprehensive survey of hallucination mitigation techniques in large language models},
 url = {https://www.amanchadha.com/research/2401.01313.pdf},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:02:13Z},
 year = {2024}
}

@inproceedings{topalis_langbo_2025,
 abstract = {Industrial automation systems are increasingly integrating artificial intelligence (AI) to enhance efficiency and adaptability. This paper proposes a framework for AI-driven predictive maintenance in manufacturing environments, leveraging machine learning algorithms to analyze sensor data from production lines. The approach combines convolutional neural networks (CNNs) for anomaly detection in visual inspections and recurrent neural networks (RNNs) for time-series forecasting of equipment failures. Experimental results from a simulated factory setup demonstrate a 25% reduction in downtime and improved accuracy over traditional rule-based methods. The framework is designed to be scalable and integrable with existing Industrial Internet of Things (IIoT) infrastructures, addressing key challenges in real-time data processing and model interpretability.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Topalis},
 booktitle = {2025 {IEEE}},
 doi = {10.1109/ETFA65518.2025.11205749},
 keywords = {Automated machine learning},
