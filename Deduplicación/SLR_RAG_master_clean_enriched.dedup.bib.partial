 title = {Financial analysis: {Intelligent}},
 url = {https://arxiv.org/abs/2504.06279},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:15:58Z},
 year = {2025}
}

@article{wang_graph_2025,
 abstract = {Graphs play an important role in representing complex relationships in various domains like social networks, knowledge graphs, and molecular discovery. With the advent of deep learning, Graph Neural Networks (GNNs) have emerged as a cornerstone in Graph Machine Learning (Graph ML), facilitating the representation and processing of graphs. Recently, LLMs have demonstrated unprecedented capabilities in language tasks and are widely adopted in a variety of applications, such as computer vision and recommender systems. This remarkable success has also attracted interest in applying LLMs to the graph domain. Increasing efforts have been made to explore the potential of LLMs in advancing Graph ML’s generalization, transferability, and few-shot learning ability. Meanwhile, graphs, especially knowledge graphs, are rich in reliable factual knowledge, which can be utilized to enhance the reasoning capabilities of LLMs and potentially alleviate their limitations, such as hallucinations and the lack of explainability. Given the rapid progress of this research direction, a systematic review summarizing the latest advancements for Graph ML in the era of LLMs is necessary to provide an in-depth understanding to researchers and practitioners. Therefore, in this survey, we first review the recent developments in Graph ML. We then explore how LLMs can be utilized to enhance the quality of graph features, alleviate the reliance on labeled data, and address challenges such as graph Heterophily and Out-of-Distribution (OOD) generalization. Afterward, we delve into how graphs can enhance LLMs, highlighting their abilities to enhance LLM pre-training and inference. Furthermore, we investigate various applications and discuss the potential future directions in this promising field.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Wang},
 doi = {10.1145/3732786},
 issn = {2157-6904},
 journal = {ACM Trans. Intell. Syst. Technol.},
 keywords = {and Representation Learning},
 month = {aug},
 note = {Place: New York},
 number = {5},
 title = {Graph {Machine}},
 url = {https://doi.org/10.1145/3732786},
 volume = {16},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:21Z},
 year = {2025}
}

@article{wang_healthq_2025,
 abstract = {Shared mobility services, such as ride-hailing, car-sharing, and bike-sharing, have transformed urban transportation landscapes worldwide. This paper reviews the multifaceted impacts of these services on urban mobility, drawing from a synthesis of empirical studies conducted between 2010 and 2024. We categorize the effects into environmental (e.g., reductions in greenhouse gas emissions and vehicle kilometers traveled), social (e.g., improved accessibility for underserved populations), economic (e.g., cost savings for users versus revenue losses for public transit), and operational (e.g., integration challenges with existing infrastructure) dimensions. Findings reveal that while shared mobility can promote sustainability by decreasing car ownership, it often leads to induced demand and equity concerns, particularly in low-income areas. The review identifies key research gaps, including long-term behavioral shifts and the role of regulatory frameworks, and proposes a holistic evaluation model to guide policymakers in fostering equitable and efficient urban mobility systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wang},
 journal = {Smart Health},
 keywords = {source: Google Scholar},
 note = {Publisher: Elsevier
Type: HTML},
 title = {Healthq: {Unveiling}},
 url = {https://www.sciencedirect.com/science/article/pii/S2352648325000315},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:08:25Z},
 year = {2025}
}

@inproceedings{wang_hierarchical_2025,
 abstract = {Visual Question Answering (VQA) systems have achieved remarkable success in recent years, but they often suffer from biases inherited from training data, leading to unfair performance across different demographic groups. In this paper, we investigate fairness in VQA from a novel perspective: the fairness of the visual content in the images used for training and evaluation. We introduce a new benchmark, FairVQA, which consists of images curated to represent diverse demographic groups and corresponding questions that probe for potential biases. We evaluate state-of-the-art VQA models on FairVQA and find significant performance disparities across groups. To address this, we propose a fairness-aware training framework that incorporates demographic-aware debiasing techniques. Our approach not only reduces bias but also improves overall model robustness. Extensive experiments demonstrate the effectiveness of our method in achieving fairer VQA systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
