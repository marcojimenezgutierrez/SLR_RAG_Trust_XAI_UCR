@article{zhai_rag-ler_2025,
 abstract = {Graph neural networks (GNNs) have achieved remarkable success in modeling graph-structured data. However, existing GNNs suffer from over-smoothing and over-squashing issues, which limit their expressive power on deep architectures. To address these challenges, we propose a novel GNN framework called Adaptive Graph Transformer (AGT), which integrates adaptive attention mechanisms with graph transformers to enhance long-range dependency capture and mitigate information loss in deep layers. Specifically, AGT employs a dynamic edge weighting scheme based on node features and structural properties, allowing the model to focus on informative edges while suppressing noisy connections. Extensive experiments on benchmark datasets for node classification, link prediction, and graph classification tasks demonstrate that AGT outperforms state-of-the-art GNN baselines, achieving up to 15% improvement in accuracy on heterophilic graphs. Our approach offers a scalable solution for real-world applications involving complex graph topologies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Zhai},
 doi = {10.1016/j.neucom.2025.131514},
