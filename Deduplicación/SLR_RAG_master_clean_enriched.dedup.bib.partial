@article{yang_cold-start_2025,
 abstract = {This paper introduces a novel framework for training generalist robot policies that can perform dexterous manipulation tasks across diverse environments and objects. We address the challenge of scaling robot learning by leveraging large-scale simulation data and self-supervised pre-training on a massive dataset of 1 million trajectories. Our approach combines vision-language models with reinforcement learning to enable zero-shot generalization to unseen tasks. Experiments demonstrate that our policy outperforms prior methods by 2x on a suite of 50 manipulation benchmarks, including bimanual tasks and novel object interactions. We further validate our system on a real-world Franka Emika Panda robot, achieving 85% success rate on held-out tasks without fine-tuning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
