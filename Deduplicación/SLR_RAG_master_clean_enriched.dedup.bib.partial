@article{guo_intent-based_2025,
 abstract = {This paper proposes a novel event-triggered adaptive control strategy for a class of nonlinear systems subject to full state constraints and actuator faults. The control objective is to ensure that all state constraints are not violated while achieving practical output regulation in the presence of actuator faults. To achieve this, a new barrier Lyapunov function (BLF) is constructed to handle the full state constraints. An adaptive event-triggered mechanism is designed to reduce the communication burden while guaranteeing the stability of the closed-loop system. The proposed control scheme ensures that the tracking error converges to a small neighborhood of the origin, and all closed-loop signals remain bounded. Simulation results demonstrate the effectiveness of the proposed approach.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Guo},
 doi = {10.1109/TASE.2025.3610906},
 issn = {1558-3783},
 journal = {IEEE Transactions on Automation Science and Engineering},
 keywords = {Analytical models},
 pages = {22185--22197},
 title = {Intent-{Based}},
 url = {https://doi.org/10.1109/tase.2025.3610906},
 volume = {22},
 x_enrich_source = {x-ai/grok-4-fast},
