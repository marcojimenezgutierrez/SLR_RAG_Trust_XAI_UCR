 isbn = {979-8-4007-1274-6},
 journal = {Proceedings of the ACM …},
 keywords = {source: Google Scholar},
 note = {Publisher: dl.acm.org},
 pages = {4206--4225},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {Understand what {LLM}},
 url = {https://doi.org/10.1145/3696410.3714717},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:18:16Z},
 year = {2025}
}

@inproceedings{donnelly_exploring_2025,
 abstract = {Social media platforms have become a primary source of news for many users, but the spread of misinformation poses significant challenges. This paper investigates the role of user expertise in detecting misinformation on social media. Through a mixed-methods approach, including surveys, experiments, and content analysis, we examine how domain knowledge, media literacy, and platform familiarity influence users' ability to identify false information. Our findings reveal that while experts in specific fields perform better in their domains, general media literacy is a stronger predictor of overall detection accuracy. We also identify common pitfalls, such as confirmation bias, that affect even knowledgeable users. Based on these insights, we propose design recommendations for social media platforms to enhance misinformation detection tools, including personalized nudges and educational interventions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
