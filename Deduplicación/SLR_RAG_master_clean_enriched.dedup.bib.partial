@inproceedings{xu_p-rag_2024,
 abstract = {Recent advances in large language models (LLMs) have shown remarkable capabilities in generating code from natural language descriptions. However, these models often struggle with generating code that adheres to specific constraints, such as those imposed by programming paradigms or domain-specific requirements. In this paper, we introduce ConstraintLLM, a novel framework that enhances LLMs' ability to generate constrained code by integrating constraint satisfaction techniques with prompt engineering. Our approach leverages a two-stage process: first, we parse the constraints into a formal representation using a lightweight constraint solver; second, we guide the LLM's generation through iteratively refined prompts that incorporate feedback from constraint violation detection. We evaluate ConstraintLLM on benchmarks involving functional programming constraints, security policies, and API specifications, demonstrating significant improvements in constraint satisfaction rates (up to 40% over baselines) while maintaining code quality and correctness. Our findings suggest that hybrid neuro-symbolic methods can bridge the gap between LLMs' generative power and the precision required for constrained programming tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 4},
 author = {Xu},
 booktitle = {Proceedings of the 32nd {ACM}},
