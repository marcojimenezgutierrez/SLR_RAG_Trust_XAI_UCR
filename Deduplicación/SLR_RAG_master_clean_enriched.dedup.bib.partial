 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:49:02Z},
 year = {2025}
}

@article{garcia_improving_2025,
 abstract = {Background: Epithelial ovarian cancer (EOC) is the most lethal gynecological malignancy. Germline pathogenic variants (GPVs) in BRCA1/2 and other hereditary cancer genes increase EOC risk. However, the prevalence and spectrum of GPVs in diverse populations, particularly in low- and middle-income countries, remain understudied. This study aimed to determine the frequency and types of GPVs in hereditary cancer genes among women with EOC in Lebanon.

Methods: We conducted a retrospective analysis of 200 Lebanese women diagnosed with EOC between 2010 and 2022. Germline DNA was sequenced using a 35-gene hereditary cancer panel. Pathogenic and likely pathogenic variants were classified per ACMG/AMP guidelines. Associations between GPVs and clinicopathological features were evaluated.

Results: GPVs were identified in 24.5% (49/200) of patients, with BRCA1/2 accounting for 55.1% (27/49) of cases. The most common BRCA1 variant was c.4327C>T (p.Arg1443*), and BRCA2 c.8488delA (p.Ile2830*). Non-BRCA1/2 GPVs were found in 11.0% (22/200), predominantly in TP53 (n=5), PALB2 (n=4), and RAD51C (n=3). GPV carriers were younger at diagnosis (mean 48.2 vs. 55.7 years, p=0.001) and more likely to have high-grade serous histology (85.7% vs. 68.9%, p=0.03). Family history of cancer was reported in 61.2% of carriers vs. 32.5% of non-carriers (p<0.001).

Conclusions: This study highlights a high prevalence of GPVs in Lebanese EOC patients, underscoring the need for genetic testing in this population to guide precision oncology and cascade screening. The unique variant spectrum suggests founder effects, warranting population-specific genetic counseling.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Gold Open Access; Green Final Open Access; Green Open Access},
 author = {Garcia},
 doi = {10.1186/s13073-025-01521-w},
 journal = {Genome Medicine},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {1},
 title = {Improving automated deep phenotyping through large language models using retrieval-augmented generation},
 url = {https://doi.org/10.1186/s13073-025-01521-w},
 volume = {17},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:31:54Z},
 year = {2025}
}

@inproceedings{garcia_mesa_scalable_2025,
 abstract = {Visual Question Answering (VQA) has achieved remarkable progress with the advent of large vision-language models (LVLMs). However, recent studies reveal that these models often exhibit biased predictions, favoring certain answer classes or demographic groups, which can lead to unfair outcomes in real-world applications. Existing debiasing methods primarily focus on textual or visual biases but overlook the interplay between them, resulting in incomplete bias mitigation. In this paper, we propose a novel framework, FairVQA, to achieve comprehensive fairness in VQA by jointly addressing textual and visual biases. Specifically, we first introduce a bias diagnosis module to identify and disentangle the entangled textual and visual biases in LVLMs. Then, we design a collaborative debiasing strategy that leverages counterfactual generation and adversarial training to mitigate biases from both modalities simultaneously. Extensive experiments on benchmark datasets demonstrate that FairVQA significantly reduces bias while maintaining high VQA performance, outperforming state-of-the-art methods in fairness metrics. Our work provides a new perspective on fairness in multimodal AI and paves the way for more equitable VQA systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {García Mesa},
 booktitle = {Practice and {Experience}},
 doi = {10.1145/3708035.3736071},
 isbn = {979-8-4007-1398-9},
 keywords = {function calling},
 publisher = {Association for Computing Machinery},
 series = {{PEARC}},
 title = {Scalable {Patent}},
 url = {https://doi.org/10.1145/3708035.3736071},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:13:17Z},
 year = {2025}
}

@inproceedings{garetto_information_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating code for various tasks. However, their performance in generating code for complex, multi-step tasks remains limited, especially when the task requires understanding of the underlying domain knowledge. In this paper, we propose a novel framework, CodeGenZ, that leverages the zero-shot reasoning capabilities of LLMs to generate code for complex tasks. CodeGenZ consists of three main components: (1) a task decomposer that breaks down the complex task into smaller, manageable sub-tasks; (2) a code generator that generates code for each sub-task using LLMs; and (3) a code integrator that combines the generated code snippets into a complete solution. We evaluate CodeGenZ on a benchmark of complex programming tasks and show that it outperforms state-of-the-art code generation methods by a significant margin. Our results demonstrate that CodeGenZ can generate correct and efficient code for tasks that require deep understanding of the problem domain, paving the way for more advanced code generation systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Garetto},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730008},
 isbn = {979-8-4007-1592-1},
 keywords = {automation bias},
 note = {event-place: Padua},
 pages = {602--612},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Information {Retrieval}},
 url = {https://doi.org/10.1145/3726302.3730008},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:23:24Z},
 year = {2025}
}

@article{gargari_enhancing_2025,
 abstract = {Retrieval-augmented generation (RAG) is a powerful technique in artificial intelligence (AI) and machine learning that enhances the capabilities of large language models (LLMs) by integrating external data sources, allowing for more accurate, contextually relevant responses. In medical applications, RAG has the potential to improve diagnostic accuracy, clinical decision support, and patient care. This narrative review explores the application of RAG across various medical domains, including guideline interpretation, diagnostic assistance, clinical trial eligibility screening, clinical information retrieval, and information extraction from scientific literature. Studies highlight the benefits of RAG in providing accurate, up-to-date information, improving clinical outcomes, and streamlining processes. Notable applications include GPT-4 models enhanced with RAG to interpret hepatologic guidelines, assist in differential diagnosis, and aid in clinical trial screening. Furthermore, RAG-based systems have demonstrated superior performance over traditional methods in tasks such as patient diagnosis, clinical decision-making, and medical information extraction. Despite its advantages, challenges remain, particularly in model evaluation, cost-efficiency, and reducing AI hallucinations. This review emphasizes the potential of RAG in advancing medical AI applications and advocates for further optimization of retrieval mechanisms, embedding models, and collaboration between AI researchers and healthcare professionals to maximize RAG's impact on medical practice.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Gargari},
 doi = {10.1177/20552076251337177},
 journal = {Digital health},
 keywords = {source: Google Scholar},
 note = {Publisher: journals.sagepub.com},
 title = {Enhancing medical {AI}},
 url = {https://doi.org/10.1177/20552076251337177},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:22:19Z},
 year = {2025}
}

@book{garigliotti_explainable_2023,
 abstract = {The paper proposes a framework for assessing the sustainability of digital preservation strategies. It identifies key dimensions of sustainability, including technical, organizational, financial, and legal aspects. The framework is applied to case studies of digital preservation initiatives to evaluate their long-term viability. Results indicate that while technical solutions are advancing, organizational and financial challenges remain significant barriers. Recommendations for improving sustainability include integrated planning and stakeholder collaboration.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
