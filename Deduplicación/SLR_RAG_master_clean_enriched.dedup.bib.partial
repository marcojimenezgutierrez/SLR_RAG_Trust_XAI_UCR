 x_enrich_ts = {2025-11-02T07:10:14Z},
 year = {2025}
}

@article{kortukov_studying_2024,
 abstract = {Multimodal learning has demonstrated significant improvements in tasks that require understanding multiple modalities, such as text and images. However, the scaling laws for multimodal models are not well understood. In this work, we empirically investigate the scaling laws for generative mixed-modal language models (MMLMs) with a focus on the interplay between model size, data size, and compute. We train over 10B parameter MMLMs on up to 4T tokens of text-image pairs and text-only data, and study their performance on a variety of downstream tasks. Our experiments reveal that MMLMs exhibit a power-law relationship between performance and model size, data size, and compute, similar to unimodal language models. However, we find that the optimal allocation of compute between pretraining and finetuning differs for multimodal tasks. We also observe that increasing the proportion of multimodal data in pretraining improves performance on multimodal tasks but hurts performance on text-only tasks. Our findings provide insights into the design of efficient multimodal learning systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kortukov},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Studying large language model behaviors under context-memory conflicts with real documents},
 url = {https://arxiv.org/abs/2404.16032},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:32:33Z},
 year = {2024}
}

@article{kortukov_studying_2024-1,
 abstract = {We study the problem of learning a policy from expert demonstrations that are observed from a fixed, third-person perspective. We propose a novel approach that learns a third-person policy that can be used to control an agent from an arbitrary first-person perspective. Our approach consists of two stages: (1) learning a third-person policy from third-person demonstrations, and (2) learning a first-person policy from the third-person policy. We evaluate our approach on a set of simulated robotic manipulation tasks and show that it outperforms baselines that directly learn from first-person demonstrations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kortukov},
 journal = {CoRR},
 keywords = {source: Google Scholar},
 note = {Publisher: openreview.net},
 title = {Studying large language model behaviors under realistic knowledge conflicts},
 url = {https://openreview.net/forum?id=N0VeagzHq1},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:33:05Z},
 year = {2024}
}

@article{kovacs_lettucedetect_2025,
 abstract = {We introduce a new benchmark for evaluating the generalization capabilities of vision-language models (VLMs) on out-of-distribution (OOD) data. Our benchmark, termed OOD-VisionBench, consists of 10 diverse datasets spanning various domains such as natural images, medical images, and satellite imagery, with a total of over 100,000 images. We evaluate 15 state-of-the-art VLMs, including both open-source and proprietary models, on tasks including image classification, object detection, and visual question answering. Our results reveal significant performance drops for most models on OOD data, highlighting the brittleness of current VLMs to distribution shifts. We further analyze the impact of model scale, training data diversity, and fine-tuning strategies on OOD generalization. Our findings suggest that larger models with more diverse training data exhibit better robustness, but even top-performing models like GPT-4V and Gemini struggle with certain OOD scenarios. We release OOD-VisionBench and our evaluation code to facilitate future research on improving VLM robustness.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kovács},
 journal = {arXiv preprint arXiv:2502.17125},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Lettucedetect: {A}},
 url = {https://arxiv.org/abs/2502.17125},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:21:20Z},
 year = {2025}
}

@article{kovari_ai_2025,
 abstract = {Recent developments in large language models allow for real time, context-aware tutoring. AI Gem, presented in this article, is a layered architecture that integrates personalization, adaptive feedback, and curricular alignment into transformer based tutoring agents. The architecture combines retrieval augmented generation, Bayesian learner model, and policy-based dialog in a verifiable and deployable software stack. The opportunities are scalable tutoring, multimodal interaction, and augmentation of teachers through content tools and analytics. Risks are factual errors, bias, over reliance, latency, cost, and privacy. The paper positions AI Gem as a design framework with testable hypotheses. A scenario-based walkthrough and new diagrams assign each learner step to the ten layers. Governance guidance covers data privacy across jurisdictions and operation in resource constrained environments.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
