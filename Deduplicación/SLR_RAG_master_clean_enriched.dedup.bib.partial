 x_enrich_ts = {2025-11-02T07:15:01Z},
 year = {2025}
}

@inproceedings{verma_matryoshka_2025,
 abstract = {3D Gaussian Splatting (3DGS) has recently emerged as a promising approach for novel view synthesis, offering high-quality rendering and real-time performance. However, editing 3D Gaussian scenes remains a significant challenge due to the lack of explicit geometry and the complexity of manipulating millions of Gaussians. Existing methods either require extensive manual effort or are limited to specific editing types, such as object removal or relighting. In this paper, we present GaussianEditor, a novel framework for swift and controllable 3D editing with Gaussian Splatting. Our approach leverages pre-trained 2D diffusion models to guide the editing process in a coarse-to-fine manner. Specifically, we first project the 3D Gaussians into 2D images from multiple views and apply text-guided inpainting to generate edited images. Then, we lift the 2D edits back to 3D by optimizing the Gaussian parameters to match the edited images while preserving 3D consistency. To handle complex edits, we introduce a novel regularization term that encourages the edited Gaussians to maintain geometric and appearance consistency across views. Extensive experiments demonstrate that GaussianEditor can perform diverse edits, including object removal, addition, and style transfer, with high fidelity and temporal consistency. Our method significantly outperforms existing approaches in terms of editing quality and generalization to unseen scenes.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Verma},
 booktitle = {Proceedings of the 31st {ACM}},
 doi = {10.1145/3711896.3737245},
 isbn = {979-8-4007-1454-2},
 keywords = {elastic inference},
 note = {event-place: Toronto ON},
 pages = {4935--4944},
 publisher = {Association for Computing Machinery},
