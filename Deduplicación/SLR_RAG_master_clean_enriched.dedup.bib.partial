 keywords = {explanation},
 note = {event-place: Sydney NSW},
 pages = {4034--4042},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {{LP}},
 url = {https://doi.org/10.1145/3696410.3714667},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:24:51Z},
 year = {2025}
}

@article{barnett_fine-tuning_2024,
 abstract = {As large language models (LLMs) become increasingly integrated into various applications, ensuring their safety and alignment with human values is paramount. This paper investigates the robustness of Anthropic's Claude 3 Opus, a state-of-the-art LLM, against jailbreaking attacks—techniques designed to elicit harmful or unethical responses from the model. We systematically evaluate a diverse set of jailbreaking methods, including prompt engineering, role-playing, and multi-turn interactions, achieving high success rates in bypassing safety mechanisms. Our analysis reveals persistent vulnerabilities, even with advanced safeguards, highlighting the challenges in achieving robust AI safety. We discuss the implications for model deployment and suggest directions for future research to mitigate these risks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Barnett},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Fine-tuning or fine-failing? debunking performance myths in large language models},
 url = {https://arxiv.org/abs/2406.11201},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:12:31Z},
 year = {2024}
}

@article{barnett_seven_2024,
 abstract = {Long-context language models (LCLMs) have recently gained significant attention due to their ability to process long inputs. However, their true context utilization remains unclear. We introduce RULER, a model-based framework for evaluating the effective context window of LCLMs. RULER uses a state-of-the-art LCLM to generate instruction-following tasks that require long contexts, and then evaluates the LCLM's performance on these tasks. We apply RULER to 9 LCLMs and find that their effective context lengths are often much shorter than their maximum context lengths, and that performance degrades rapidly beyond the effective context length. We also find that RULER tasks are challenging for LCLMs, with even the best models achieving only 50% accuracy on average. Our findings highlight the need for better evaluation methods for LCLMs and suggest that current LCLMs may not be as capable of long-context understanding as previously thought.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Barnett},
