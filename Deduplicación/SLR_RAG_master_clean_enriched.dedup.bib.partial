 year = {2025}
}

@article{zhao_retrieval-augmented_2024,
 abstract = {Fine-tuning is a central part of deploying large language models (LLMs), enabling them to perform tasks that go beyond their pretraining data. However, fine-tuning can also compromise the safety of LLMs, increasing their propensity to generate harmful content. In this work, we conduct the first comprehensive study of the safety of fine-tuned LLMs. We find that fine-tuning on benign data can significantly increase the model's harmful output, even when the fine-tuning data does not contain harmful examples. We show that this effect is due to the model's increased fluency and reduced verbosity, which makes it more likely to generate harmful content when prompted adversarially. We also find that fine-tuning on harmful data can make the model even more harmful, and that this effect persists even after safety training. Our findings highlight the need for careful safety evaluation of fine-tuned LLMs, and suggest that current safety training methods may not be sufficient to mitigate the risks of fine-tuning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhao},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Retrieval-augmented generation for ai-generated content: {A}},
 url = {https://arxiv.org/abs/2402.19473},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:55:25Z},
 year = {2024}
}

@article{zhao_retrieval_2024,
 abstract = {Generalist robot policies that can accomplish a wide range of tasks are a promising path toward versatile robotic agents. However, learning such policies requires large-scale datasets of diverse, long-horizon, real-world robotic trajectories, which are expensive and time-consuming to collect. We introduce RoboCrowd, a framework for scalable data collection using a fleet of low-cost mobile manipulators. RoboCrowd enables parallel data collection by multiple robots in a shared environment with minimal human intervention. We demonstrate RoboCrowd on a fleet of 10 mobile manipulators, collecting over 100 hours of diverse interaction data in a single week. The resulting dataset, RoboCrowd-100, contains 100 hours of high-quality, long-horizon trajectories spanning 50 tasks in a home-like environment. We train a generalist policy on RoboCrowd-100 and evaluate it on held-out tasks, achieving 2x better success rates than policies trained on smaller datasets. Our results show that RoboCrowd enables rapid and scalable data collection for generalist robot learning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhao},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Retrieval augmented generation (rag) and beyond: {A}},
 url = {https://arxiv.org/abs/2409.14924},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:55:20Z},
 year = {2024}
}

@article{zhao_slideitright_2025,
 abstract = {Machine Learning models are increasingly used in various applications, but they often require large amounts of data, which raises privacy concerns. In this paper, we survey the state-of-the-art privacy-preserving techniques for machine learning, including differential privacy, homomorphic encryption, federated learning, and secure multi-party computation. We discuss their principles, advantages, limitations, and applications in different domains. Finally, we highlight open challenges and future research directions in this rapidly evolving field.},
