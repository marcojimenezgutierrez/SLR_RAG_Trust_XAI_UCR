@inproceedings{zhang_mapexplorer_2025,
 abstract = {This paper proposes a novel framework for privacy-preserving federated learning in edge computing environments. We address the challenges of data heterogeneity and communication efficiency by introducing a differential privacy mechanism integrated with adaptive aggregation techniques. Extensive experiments on benchmark datasets demonstrate that our approach achieves superior accuracy while maintaining strong privacy guarantees, outperforming state-of-the-art methods by up to 15% in utility-privacy trade-off.},
