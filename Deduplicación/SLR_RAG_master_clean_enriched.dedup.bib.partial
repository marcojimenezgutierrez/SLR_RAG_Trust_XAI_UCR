 year = {2025}
}

@inproceedings{zhang_cream_2024,
 abstract = {This paper explores the design and evaluation of a novel interactive system for supporting creative writing processes through AI assistance. We conducted a user study with 24 writers to investigate how different levels of AI intervention affect creativity, productivity, and user satisfaction. Our findings reveal that adaptive AI suggestions enhance idea generation without overwhelming users, while over-reliance on AI can stifle originality. We discuss implications for designing human-AI collaborative tools in creative domains and provide design guidelines for balancing autonomy and assistance.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
