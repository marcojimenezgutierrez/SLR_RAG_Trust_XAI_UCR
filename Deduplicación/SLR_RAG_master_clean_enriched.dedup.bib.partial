@inproceedings{wang_quantitative_2025,
 abstract = {Personal informatics (PI) systems have the potential to support self-improvement by helping people track and reflect on their behaviors. However, the role of self-reflection---a core component of PI---remains underexplored. In this paper, we investigate how different forms of self-reflection affect user engagement and behavior change in PI systems. Through a four-week field study with 48 participants using a custom PI app for physical activity tracking, we compared three reflection conditions: no reflection, open-ended reflection, and guided reflection. Our results show that guided reflection significantly increased engagement (e.g., 25% more logins) and led to more sustained behavior change compared to the other conditions. Qualitative analysis revealed that guided prompts helped users overcome reflection barriers like lack of time and motivation. We discuss design implications for integrating effective self-reflection into PI systems to foster long-term user engagement and self-improvement.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wang},
 booktitle = {Proceedings of the 56th {ACM}},
 doi = {10.1145/3641554.3701917},
