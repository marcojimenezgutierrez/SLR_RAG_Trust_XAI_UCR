@article{shen_citekit_2024,
 abstract = {Recent work has shown that large language models (LLMs) store factual knowledge in a remarkably human-like way: by encoding facts in the direction of the truth value. In this paper, we investigate the geometry of truth in LLM representations. We find that the direction of truth is remarkably consistent across different datasets, models, and languages. We also find that the geometry of truth is robust to perturbations, and that it can be used to steer LLMs towards truthful outputs. Our findings suggest that the geometry of truth is a fundamental property of LLM representations, and that it can be used to improve the truthfulness of LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
