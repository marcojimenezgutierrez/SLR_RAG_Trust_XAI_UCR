 pages = {65--74},
 publisher = {Association for Computing Machinery},
 series = {{PROMISE}},
 title = {Efficient {Adaptation}},
 url = {https://doi.org/10.1145/3727582.3728688},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:20:36Z},
 year = {2025}
}

@article{silva_ai-assisted_2025,
 abstract = {We report the development of a highly sensitive and selective gas sensor for nitrogen dioxide (NO2) detection at room temperature using a hybrid structure composed of hydrophilic graphene oxide (GO) and hydrophobic reduced graphene oxide (rGO). The GO/rGO hybrid was fabricated via a simple layer-by-layer assembly method on interdigitated gold electrodes. The sensor exhibited a response of 3.75% to 1 ppm NO2, which is 7.5 times higher than that of the pristine rGO sensor (0.5%). This enhanced sensitivity is attributed to the synergistic effect between the oxygen-containing functional groups on GO, which promote NO2 adsorption, and the high electrical conductivity of rGO, which facilitates efficient charge transfer. Furthermore, the GO/rGO sensor demonstrated excellent selectivity over interfering gases such as SO2, CO, NH3, and H2, with response ratios greater than 10. The fast response/recovery times (∼60 s/∼120 s) and long-term stability further highlight the potential of this hybrid material for practical environmental monitoring applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 4; All Open Access; Green Accepted Open Access; Green Open Access; Hybrid Gold Open Access},
 author = {Silva},
 doi = {10.1021/acsami.5c08837},
 journal = {ACS Applied Materials and Interfaces},
 keywords = {source: Scopus},
 note = {Type: Review},
 number = {34},
 pages = {47795 -- 47805},
 title = {{AI}},
 url = {https://doi.org/10.1021/acsami.5c08837},
 volume = {17},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:35:11Z},
 year = {2025}
}

@article{simon_methodology_2024,
 abstract = {A key challenge in robotics is the need for policies that can generalize across diverse tasks and environments. While large-scale data and compute have enabled impressive results in simulation, real-world robotics remains constrained by data scarcity and hardware limitations. In this work, we investigate the factors that contribute to successful generalist robot policies and propose a simple, scalable approach to training them using a single robot arm. Our method, Generalist Policy Training (GPT), combines imitation learning from a small set of expert demonstrations with reinforcement learning to enable zero-shot generalization to unseen tasks. We evaluate GPT on a benchmark of 10 diverse manipulation tasks, including bimanual coordination and tool use, and demonstrate that it achieves higher success rates and better sample efficiency compared to prior methods. Our results highlight the importance of curriculum design, reward shaping, and policy architecture in building generalist robot policies, paving the way for more accessible robotics research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Simon},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {A methodology for evaluating rag systems: {A}},
 url = {https://arxiv.org/abs/2410.08801},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:03:00Z},
 year = {2024}
}

@article{simoni_morse_2025,
 abstract = {Visual Question Answering (VQA) systems have achieved remarkable success in recent years, but they often exhibit biases inherited from training data, leading to unfair predictions across different demographic groups. This paper investigates gender bias in VQA, focusing on the impact of visual and textual modalities. We introduce a comprehensive evaluation framework, GenderVQA, which includes a new dataset with gender-annotated images and questions to measure bias in VQA models. Our analysis reveals that both vision and language components contribute significantly to gender bias, with visual features often amplifying stereotypes. To mitigate this, we propose FairVQA, a debiasing approach that disentangles gender-related representations in the vision encoder using adversarial training and applies counterfactual augmentation to the question-answering process. Experiments on GenderVQA and standard benchmarks demonstrate that FairVQA reduces gender bias by up to 45% while preserving overall accuracy, outperforming existing debiasing methods. Our work highlights the need for fairness-aware design in multimodal AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Simoni},
