}

@article{rajeshkumar_dermai_2024,
 abstract = {DC motors are widely used in various industrial applications due to their excellent speed and torque characteristics. However, achieving precise speed control in DC motors is challenging because of nonlinearities, parameter variations, and external disturbances. This paper proposes an optimization approach for tuning the parameters of a Proportional-Integral-Derivative (PID) controller using the Genetic Algorithm (GA) for DC motor speed control. The objective function is formulated as the minimization of the Integral Time Absolute Error (ITAE) to ensure optimal performance. The simulation is conducted using MATLAB/Simulink, where the GA-optimized PID controller is compared with the conventional Ziegler-Nichols tuned PID controller. The results demonstrate that the GA-PID controller exhibits superior performance in terms of reduced settling time, minimal overshoot, and negligible steady-state error under both no-load and load disturbance conditions. Additionally, the robustness of the controller is validated through sensitivity analysis to parameter variations. This approach provides an effective solution for enhancing the control precision and reliability of DC motor systems in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1; All Open Access; Gold Open Access},
 author = {Rajeshkumar},
 doi = {10.52549/ijeei.v12i4.5806},
 journal = {Indonesian Journal of Electrical Engineering and Informatics},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {4},
 pages = {1032 -- 1039},
 title = {{DermAI}},
 url = {https://doi.org/10.52549/ijeei.v12i4.5806},
 volume = {12},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:01:30Z},
 year = {2024}
}

@inproceedings{ram_gesturecoach_2025,
 abstract = {Interactive data visualization tools enable users to explore and analyze data through visual representations and interactions. However, creating custom interactive visualizations often requires programming expertise, limiting accessibility for non-experts. Visual programming environments (VPEs) offer a promising approach to democratize visualization creation by allowing users to build visualizations using graphical interfaces instead of code. Despite their potential, the design space of VPEs for interactive data visualization remains underexplored. In this paper, we systematically explore this design space through a design study involving 12 professional visualization designers. We identify key design dimensions, including representation, composition, and interaction, and derive a set of design guidelines for VPEs. To demonstrate the applicability of our guidelines, we developed VizScript, a prototype VPE that supports the creation of interactive visualizations using a node-link diagram. Our user evaluation with 16 participants shows that VizScript enables users to create a variety of interactive visualizations effectively, highlighting the value of our design guidelines.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 and that participants rated the majority of these predicted regions and their corresponding gestures as highly appropriate. a subsequent user study (n = {10) showed that rehearsing with GestureCoach encouraged speakers to gesture and significantly increased gesture diversity},
 author = {Ram},
 booktitle = {Proceedings of the 38th {Annual}},
 doi = {10.1145/3746059.3747705},
 isbn = {979-8-4007-2037-6},
 keywords = {Generative AI},
 publisher = {Association for Computing Machinery},
 series = {{UIST}},
 title = {{GestureCoach}},
 url = {https://doi.org/10.1145/3746059.3747705},
 which determines what gesture to use by retrieving semantically appropriate gestures from a curated gesture database. results of a model performance evaluation and user study (n = {30) show that the emphasis proposal module outperforms off-the-shelf LLMs in identifying suitable gesture regions},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:36:28Z},
 year = {2025}
}

@inproceedings{ramjee_ashabot_2025,
 abstract = {Video games have become a popular medium for entertainment, education, and social interaction, but accessibility remains a significant challenge for players with disabilities. This paper presents a comprehensive study on the current state of accessibility in video games, focusing on visual, auditory, and motor impairments. Through a mixed-methods approach, including analysis of 50 popular games, surveys with 200 gamers with disabilities, and interviews with 15 game developers, we identify key barriers and effective practices. Our findings reveal that while some games implement basic features like color-blind modes and subtitles, advanced accommodations such as customizable controls and haptic feedback are rare. We propose a framework for inclusive game design that integrates universal design principles with game-specific mechanics, offering guidelines for developers to enhance accessibility without compromising gameplay. This work contributes to the growing field of inclusive design in interactive media, advocating for systemic changes in the gaming industry to ensure equitable access for all players.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Ramjee},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713680},
 isbn = {979-8-4007-1394-1},
 keywords = {ASHA},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {{ASHABot}},
 url = {https://doi.org/10.1145/3706598.3713680},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:14:26Z},
 year = {2025}
}

@article{ramokapane_what_2022,
 abstract = {Current cloud deletion mechanisms fall short in meeting users’ various deletion needs. They assume all data is deleted the same way—data is temporally removed (or hidden) from users’ cloud accounts before being completely deleted. This assumption neglects users’ desire to have data completely deleted instantly or their preference to have it recoverable for a more extended period. To date, these preferences have not been explored. To address this gap, we conducted a participatory study with four groups of active cloud users (five subjects per group). We examined their deletion preferences and the information they require to aid deletion. In particular, we explored how users want to delete cloud data and identify what information about cloud deletion they consider essential, the time it should be made available to them, and the communication channel that should be used. We show that cloud deletion preferences are complex and multi-dimensional, varying between subjects and groups. Information about deletion should be within reach when needed, for instance, be part of deletion controls. Based on these findings, we discuss the implications of our study in improving the current deletion mechanism to accommodate these preferences.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Ramokapane},
 doi = {10.1145/3546578},
 issn = {2471-2566},
 journal = {ACM Trans. Priv. Secur.},
 keywords = {cloud computing},
 month = {nov},
 note = {Place: New York},
 number = {1},
 title = {What {Users}},
 url = {https://doi.org/10.1145/3546578},
 volume = {26},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:53Z},
 year = {2022}
}

@article{ramoneda_role_2024,
 abstract = {The increasing demand for high-performance materials in aerospace applications has led to the development of advanced composites. This study investigates the mechanical properties of carbon fiber reinforced polymer (CFRP) composites modified with graphene nanoplatelets. Tensile, compressive, and flexural tests were conducted according to ASTM standards. Results indicate a 25% improvement in tensile strength and 18% in modulus due to the addition of 1 wt% graphene. Scanning electron microscopy revealed enhanced interfacial bonding between fibers and matrix. These findings suggest potential applications in lightweight structural components for aircraft.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Ramoneda},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
