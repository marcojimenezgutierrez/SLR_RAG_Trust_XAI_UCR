@article{neumann_llm-driven_2024,
 abstract = {This paper proposes a novel federated learning framework for resource-constrained Internet of Things (IoT) devices, addressing the challenges of data privacy, communication overhead, and computational limitations in distributed environments. We introduce an efficient model aggregation technique that incorporates knowledge distillation and adaptive quantization to reduce bandwidth usage while maintaining model accuracy. Extensive experiments on real-world IoT datasets demonstrate that our approach achieves up to 30% improvement in accuracy compared to traditional federated learning methods, with significantly lower energy consumption and latency, making it suitable for edge computing applications.},
