 publisher = {Association for Computing Machinery},
 series = {{ASSETS}},
 title = {{TwIPS}},
 url = {https://doi.org/10.1145/3663548.3675633},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:31:23Z},
 year = {2024}
}

@inproceedings{harvey_dont_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, they often exhibit biases inherited from their training data, leading to unfair and harmful outputs, especially in sensitive applications like hiring, lending, and criminal justice. Mitigating these biases while preserving the models' performance is a critical challenge. In this paper, we propose FairInstruct, a novel framework for debiasing LLMs through instruction tuning. FairInstruct leverages a carefully curated dataset of fairness-oriented instructions to fine-tune LLMs, encouraging them to generate unbiased responses. Our approach combines counterfactual data augmentation with reinforcement learning from human feedback (RLHF) to align the model with fairness principles. Extensive experiments on multiple LLMs and bias benchmarks demonstrate that FairInstruct significantly reduces demographic biases across gender, race, and age dimensions, while maintaining or even improving performance on standard NLP tasks. Our work provides a scalable and effective solution for deploying fairer LLMs in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Harvey},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713210},
 isbn = {979-8-4007-1394-1},
 keywords = {edtech},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {"{Don}},
 url = {https://doi.org/10.1145/3706598.3713210},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:08:56Z},
 year = {2025}
}

@inproceedings{harvey_framework_2025,
 abstract = {Visual programming languages (VPLs) have long promised to make programming more accessible, yet their adoption remains limited. We explore why through a design space analysis of 20 VPLs, identifying key dimensions: representation (e.g., blocks, nodes), interaction (e.g., drag-and-drop, direct manipulation), and semantics (e.g., dataflow, imperative). Our analysis reveals that while VPLs excel in visual expressiveness, they often struggle with scalability, expressiveness for complex logic, and integration with text-based code. We discuss implications for future VPL design, emphasizing hybrid approaches that combine visual and textual elements to broaden accessibility without sacrificing power.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Harvey},
 booktitle = {Proceedings of the 2025 {ACM}},
