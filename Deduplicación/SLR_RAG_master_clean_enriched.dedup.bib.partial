@inproceedings{cheng_sqlord_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but they often exhibit biases that can lead to unfair or harmful outputs. Fine-tuning LLMs on specific datasets can amplify these biases, particularly when the data is imbalanced across protected attributes such as gender, race, or age. In this paper, we propose a unified framework for mitigating multiple types of biases during the fine-tuning process of LLMs. Our approach integrates debiasing techniques at both the data and model levels, including counterfactual data augmentation, adversarial training, and fairness-aware loss functions. We evaluate our framework on several benchmark datasets for tasks like sentiment analysis and question answering, demonstrating significant reductions in bias metrics (e.g., demographic parity and equalized odds) while maintaining or improving task performance. Our results highlight the importance of holistic debiasing strategies to ensure equitable deployment of LLMs in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Cheng},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3701716.3715541},
 isbn = {979-8-4007-1331-6},
 keywords = {llm},
 note = {event-place: Sydney NSW},
 pages = {919--923},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {{SQLord}},
 url = {https://doi.org/10.1145/3701716.3715541},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:12:25Z},
 year = {2025}
}

@article{cheng_unified_2024,
 abstract = {Learning generalist robot policies in unstructured environments has been a long-standing challenge in robotics. While large-scale data collection and training have led to significant progress in simulation, transferring these policies to the real world remains challenging. In this work, we introduce Robot Synesthesia, a framework that leverages vision-language models (VLMs) to enable in-context reinforcement learning (RL) for robotic manipulation. By conditioning the policy on natural language instructions and visual observations, our approach allows for zero-shot transfer of policies trained in simulation to real-world robots without any fine-tuning. We evaluate our method on a suite of diverse manipulation tasks and demonstrate that Robot Synesthesia outperforms existing methods in terms of success rate and generalization. Our results highlight the potential of VLMs as a powerful tool for bridging the sim-to-real gap in robotics.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Cheng},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Unified active retrieval for retrieval augmented generation},
 url = {https://arxiv.org/abs/2406.12534},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:48:38Z},
 year = {2024}
}

@misc{cherukuri_large_2025,
 abstract = {Oral histories are vital records of lived experience, particularly within communities affected by systemic injustice and historical erasure. Effective and efficient analysis of their oral history archives can promote access and understanding of the oral histories. However, Large-scale analysis of these archives remains limited due to their unstructured format, emotional complexity, and high annotation costs. This paper presents a scalable framework to automate semantic and sentiment annotation for Japanese American Incarceration Oral History. Using LLMs, we construct a high-quality dataset, evaluate multiple models, and test prompt engineering strategies in historically sensitive contexts. Our multiphase approach combines expert annotation, prompt design, and LLM evaluation with ChatGPT, Llama, and Qwen. We labeled 558 sentences from 15 narrators for sentiment and semantic classification, then evaluated zero-shot, few-shot, and RAG strategies. For semantic classification, ChatGPT achieved the highest F1 score (88.71%), followed by Llama (84.99%) and Qwen (83.72%). For sentiment analysis, Llama slightly outperformed Qwen (82.66%) and ChatGPT (82.29%), with all models showing comparable results. The best prompt configurations were used to annotate 92,191 sentences from 1,002 interviews in the JAIOH collection. Our findings show that LLMs can effectively perform semantic and sentiment annotation across large oral history collections when guided by well-designed prompts. This study provides a reusable annotation pipeline and practical guidance for applying LLMs in culturally sensitive archival analysis. By bridging archival ethics with scalable NLP techniques, this work lays the groundwork for responsible use of artificial intelligence in digital humanities and preservation of collective memory. GitHub: https://github.com/kc6699c/LLM4OralHistoryAnalysis.},
 abstract_lang = {en},
 abstract_source = {doi-json},
 author = {Cherukuri},
 doi = {10.48550/arXiv.2508.06729},
