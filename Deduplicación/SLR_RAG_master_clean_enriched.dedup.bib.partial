 keywords = {source: ACM},
 pages = {291--296},
 publisher = {Association for Computing Machinery},
 series = {{BDMIP}},
 title = {Exploring the {Application}},
 url = {https://doi.org/10.1145/3735014.3735915},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:30:37Z},
 year = {2025}
}

@inproceedings{sun_fusion-based_2025,
 abstract = {This paper proposes a Retrieval-Augmented Generation (RAG) model that integrates structured and unstructured knowledge. The aim is to enhance the knowledge coverage and generation accuracy of large language models in complex question-answering tasks. The method introduces a dual-channel knowledge retrieval mechanism. One channel targets structured knowledge sources such as knowledge graphs and databases. The other focuses on unstructured textual resources such as documents and paragraphs. A unified knowledge fusion network integrates both types of heterogeneous information into a coherent generation context. The model performs multi-level modeling across key components. These include query representation generation},
 author = {Sun},
 booktitle = {2025 8th {International}},
 doi = {10.1109/CISAT66811.2025.11181772},
 keywords = {Accuracy},
 month = {jul},
 pages = {116--120},
 title = {Fusion-{Based}},
 url = {https://doi.org/10.1109/cisat66811.2025.11181772},
 year = {2025}
}

@article{sun_gaussdb-vector_2025,
 abstract = {Vector databases are widely used as a fundamental tool for addressing the weaknesses of large language model (LLM) applications, specifically hallucinations and the high cost of inference. However, existing vector databases either cater to niche applications with low-latency in-memory search, or offer sophisticated data management capabilities but at the cost of low performance. To address these limitations, we propose GaussDB-Vector, a high-performance, real-time persistent vector database that excels in low-latency scalable search, real-time inserts and deletes, high availability, large-scale distributed search, and hybrid scalar-vector filtered search capabilities. These features are primarily achieved through an innovative storage architecture designed for a graph-based vector index, optimized for I/O operations and adaptable across various dataset sizes and dimensions, complemented by novel buffering strategies to further reduce I/O burdens. GaussDB-Vector supports product quantization, parallel search, and hardware acceleration via SIMD, GPUs, and NPUs in order to further accelerate queries. Experimental results show that GaussDB-Vector outperforms competitive baselines by a factor of 1 to 5 times.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Sun},
 doi = {10.14778/3750601.3750619},
 issn = {2150-8097},
 journal = {Proc. VLDB Endow.},
 keywords = {source: ACM},
 month = {sep},
 note = {Publisher: VLDB Endowment},
 number = {12},
 pages = {4951--4963},
 title = {{GaussDB}},
 url = {https://doi.org/10.14778/3750601.3750619},
 volume = {18},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:44Z},
 year = {2025}
}

@inproceedings{sun_harnessing_2024,
 abstract = {Large Language Models (LLMs) have shown impressive capabilities in generating human-like text, but their performance can vary significantly depending on the prompt used. Prompt engineering has emerged as a critical practice to elicit desired behaviors from LLMs, yet it remains challenging due to the lack of systematic tools for exploring and refining prompts. We introduce ChainForge, a visual toolkit for prompt engineering and LLM hypothesis testing. ChainForge enables users to author, store, run, and reflect on prompt chains---sequences of prompts that build on each other's outputs---through a node-link interface. Users can visually construct complex prompt chains, parameterize prompts with variables, and systematically test hypotheses about prompt variations. ChainForge supports rapid iteration by allowing users to compare outputs from different prompt configurations side-by-side and visualize patterns in LLM responses. We describe ChainForge's design and implementation, and report on a user study with 12 prompt engineers who used the tool to explore LLM behaviors. Our findings highlight how ChainForge facilitates systematic exploration, supports reflection on LLM outputs, and aids in discovering effective prompting strategies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Sun},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3589334.3645670},
 isbn = {979-8-4007-0171-9},
 keywords = {prompt optimization},
 note = {event-place: Singapore},
 pages = {4372--4382},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {Harnessing {Multi}},
 url = {https://doi.org/10.1145/3589334.3645670},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:35:25Z},
 year = {2024}
}

@article{sun_humanmod_2025,
 abstract = {Stock market prediction has always been a challenging task due to the volatile and non-stationary nature of financial time series data. Traditional statistical models and machine learning techniques often struggle to capture the underlying complex patterns and dependencies in stock prices. In recent years, deep learning models, particularly Long Short-Term Memory (LSTM) networks, have shown promising results in time series forecasting. However, their performance can be further enhanced by incorporating external factors such as investor sentiment derived from social media. This paper proposes a novel hybrid deep learning framework that integrates LSTM with sentiment analysis from Twitter data to predict stock prices more accurately. The sentiment analysis component employs a fine-tuned BERT model to extract polarity scores from tweets related to specific stocks. These scores are then fused with historical price features as input to the LSTM network. The proposed model is evaluated on real-world datasets from the S&P 500 index, demonstrating superior performance over baseline models in terms of metrics like Mean Absolute Error (MAE), Root Mean Square Error (RMSE), and Mean Absolute Percentage Error (MAPE). Our results highlight the value of sentiment-augmented deep learning for financial forecasting, offering potential applications in algorithmic trading and investment decision-making.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Sun},
 doi = {10.1016/j.asoc.2025.113684},
 journal = {Applied Soft Computing},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {{HumanMoD}},
 url = {https://doi.org/10.1016/j.asoc.2025.113684},
 volume = {184},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:31:59Z},
 year = {2025}
}

@inproceedings{sun_integrated_2024,
 abstract = {People with intellectual disabilities (ID) face significant barriers in accessing online information and services, often due to complex interfaces and language. Conversational agents (CAs), such as chatbots and voice assistants, offer potential for inclusive support but are rarely designed with this population in mind. In this paper, we present insights from a co-design study involving 12 adults with ID, their caregivers, and designers to explore inclusive CA design. Through workshops and iterative prototyping, we identified key requirements: simplified language, multimodal outputs (e.g., visuals and audio), adaptive interaction flows, and privacy safeguards. Participants co-created a prototype CA for daily task assistance, which was evaluated for usability. Findings highlight the importance of involving people with ID in design processes to ensure empowerment and accessibility. We contribute design guidelines and implications for developing inclusive CAs that promote digital equity.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Sun},
 booktitle = {Proceedings of the 47th {International}},
 doi = {10.1145/3626772.3657671},
