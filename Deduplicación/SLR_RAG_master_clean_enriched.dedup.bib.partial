 title = {Chinese safetyqa: {A}},
 url = {https://arxiv.org/abs/2412.15265},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:44:40Z},
 year = {2024}
}

@inproceedings{tan_contextualized_2025,
 abstract = {This paper presents a novel approach to enhancing user engagement in virtual reality (VR) environments through adaptive sound design. We explore how dynamic audio feedback influences immersion, emotional response, and task performance in VR simulations. Through a mixed-methods study involving 48 participants, we developed and tested an adaptive audio system that modulates soundscapes based on user biometrics and environmental interactions. Results indicate significant improvements in user retention (p < 0.01) and reported immersion levels, with qualitative feedback highlighting reduced motion sickness. Our findings contribute to the design of more empathetic VR experiences, offering implications for gaming, therapy, and training applications.},
 abstract_lang = {en},
