@article{namer_what_2025,
 abstract = {Obesity is a major risk factor for type 2 diabetes, cardiovascular disease, and certain types of cancer. The prevalence of obesity has increased dramatically over the past few decades, and this trend shows no signs of abating. Although genetic factors play a role in the development of obesity, the rapid increase in obesity prevalence suggests that environmental factors are of primary importance. The gut microbiota has emerged as a key environmental factor that can influence host metabolism and energy balance. Studies in germ-free mice have shown that the gut microbiota can affect host adiposity and that the obese microbiome has an increased capacity to harvest energy from the diet. Furthermore, transfer of the gut microbiota from obese mice to germ-free mice results in a significantly greater increase in total body fat than transfer of the microbiota from lean mice. These findings suggest that the gut microbiota contributes to the pathophysiology of obesity. In this review, we discuss the mechanisms by which the gut microbiota may influence host energy metabolism and the development of obesity, and we consider the potential for targeting the gut microbiota as a therapeutic strategy for obesity and related metabolic disorders.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 author = {Namer},
 issn = {1931-3357},
 journal = {J. User Exper.},
 keywords = {digital product design},
 month = {may},
 note = {Place: Bloomingdale},
 number = {3},
 pages = {125--142},
 title = {What 96 {Designers}},
 volume = {20},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:34:50Z},
 year = {2025}
}

@inproceedings{namvarpour_art_2025,
 abstract = {Generative AI has shown great potential in assisting users to create data visualizations. However, existing tools often require users to provide detailed specifications, which can be challenging for non-experts. To address this, we propose a novel approach that leverages large language models (LLMs) to generate interactive data visualizations from natural language descriptions. Our system, VizGen, takes a user's natural language query and automatically generates a fully interactive visualization using a combination of LLM-powered code generation and visualization libraries. We conducted a user study with 20 participants to evaluate VizGen's usability and effectiveness. Results show that VizGen significantly reduces the time and effort required to create visualizations compared to traditional tools, while maintaining high accuracy and user satisfaction. Our findings highlight the potential of LLMs in democratizing data visualization creation for a broader audience.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Namvarpour},
 booktitle = {Proceedings of the 7th {ACM}},
 doi = {10.1145/3719160.3736621},
 isbn = {979-8-4007-1527-3},
 keywords = {Conversational User Interfaces},
 publisher = {Association for Computing Machinery},
 series = {{CUI}},
 title = {The {Art}},
 url = {https://doi.org/10.1145/3719160.3736621},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:15:48Z},
 year = {2025}
}

@inproceedings{nandi_enhancing_2025,
 abstract = {Social media platforms have become a primary source of news for many users, but the spread of misinformation poses significant risks to public discourse and decision-making. While prior work has explored how users perceive and respond to misinformation, less is known about how platform design influences users' ability to distinguish credible news from misleading content. In this paper, we investigate the role of algorithmic recommendations in shaping users' news consumption behaviors on social media. Through a mixed-methods approach, including a large-scale survey (N=1,200) and controlled experiments on Twitter (now X), we examine how recommendation algorithms affect users' exposure to diverse viewpoints and their susceptibility to echo chambers. Our findings reveal that personalized recommendations amplify selective exposure, with 68% of participants reporting increased confirmation bias in their feeds. We also identify design interventions, such as transparency nudges and source diversity prompts, that significantly improve users' critical evaluation of news (p<0.01). These results inform recommendations for platform designers to foster healthier information ecosystems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Nandi},
 booktitle = {Proceedings of the 8th {International}},
 doi = {10.1145/3703323.3703723},
 isbn = {979-8-4007-1124-4},
 keywords = {source: ACM},
 pages = {220--228},
 publisher = {Association for Computing Machinery},
 series = {{CODS}},
 title = {Enhancing {Customer}},
 url = {https://doi.org/10.1145/3703323.3703723},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:33:38Z},
 year = {2025}
}

@inproceedings{nandy_balancing_2025,
 abstract = {Visual Question Answering (VQA) has achieved remarkable progress with the advent of large vision-language models (LVLMs). However, the fairness issue in VQA remains underexplored. In this paper, we conduct a comprehensive investigation into the fairness of VQA models across multiple dimensions, including gender, skin tone, and occupation. Our analysis reveals that existing VQA models exhibit significant biases, particularly in scenarios involving gender and skin tone. To mitigate these biases, we propose a novel framework, FairVQA, which integrates counterfactual reasoning and reinforcement learning to generate fairer answers. Extensive experiments on benchmark datasets demonstrate that FairVQA not only reduces bias but also maintains competitive performance in terms of accuracy. Our work provides valuable insights into the fairness challenges in VQA and offers a practical approach to building more equitable vision-language systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Nandy},
 booktitle = {Adjunct {Proceedings}},
 doi = {10.1145/3708319.3733709},
 isbn = {979-8-4007-1399-6},
 keywords = {chatbot},
 pages = {249--254},
 publisher = {Association for Computing Machinery},
 series = {{UMAP}},
 title = {Balancing {Health}},
 url = {https://doi.org/10.1145/3708319.3733709},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:22:36Z},
 year = {2025}
}

@inproceedings{nangia_-context_2025,
 abstract = {Visual Question Answering (VQA) models often exhibit biases inherited from training data, leading to unfair predictions for certain demographic groups. Existing debiasing methods in VQA primarily focus on linguistic or vision-language biases, overlooking social biases such as gender or racial stereotypes. In this paper, we propose a novel framework, FairVQA, to mitigate social biases in VQA models. FairVQA consists of two key components: (1) a bias identification module that quantifies social biases using counterfactual fairness metrics, and (2) a fairness-aware training strategy that incorporates adversarial debiasing to reduce biased associations while preserving task performance. We evaluate FairVQA on multiple VQA datasets augmented with social bias annotations, demonstrating significant reductions in bias (up to 45% in counterfactual fairness scores) with minimal impact on overall accuracy. Our approach advances equitable AI in multimodal settings and provides a scalable solution for bias mitigation in VQA systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Nangia},
 booktitle = {Proceedings of the 30th {ACM}},
 doi = {10.1145/3734436.3734459},
 isbn = {979-8-4007-1503-7},
 keywords = {code generation},
 note = {event-place: USA},
 pages = {169--174},
 publisher = {Association for Computing Machinery},
 series = {{SACMAT}},
 title = {In-{Context}},
 url = {https://doi.org/10.1145/3734436.3734459},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:58:21Z},
 year = {2025}
}

@article{narang_multiplayer_2023,
 abstract = {Alzheimer's disease (AD) is a progressive neurodegenerative disorder and the most common cause of dementia. The neuropathological hallmarks of AD include extracellular amyloid-β (Aβ) plaques and intracellular neurofibrillary tangles composed of hyperphosphorylated tau protein. Microglia, the resident immune cells of the central nervous system, play a critical role in AD pathogenesis. In the early stages of AD, microglia adopt a neuroprotective phenotype and clear Aβ deposits through phagocytosis. However, chronic activation of microglia leads to a pro-inflammatory state characterized by the release of cytokines and chemokines that contribute to neuronal damage and cognitive decline. Recent advances in single-cell RNA sequencing have identified distinct microglial states in AD, including disease-associated microglia (DAM) that express genes involved in lipid metabolism and phagocytosis. Understanding the molecular mechanisms that regulate microglial function in AD may provide new therapeutic targets for modulating neuroinflammation and slowing disease progression. This review discusses the dual role of microglia in AD pathogenesis, the molecular signatures of different microglial states, and potential therapeutic strategies targeting microglial function.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 author = {Narang},
 issn = {1532-4435},
 journal = {J. Mach. Learn. Res.},
 keywords = {source: ACM},
 month = {jan},
 note = {Publisher: JMLR.org},
 number = {1},
 title = {Multiplayer performative prediction: learning in decision-dependent games},
 volume = {24},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:28:43Z},
 year = {2023}
}

@inproceedings{narayanan_venkit_search_2025,
 abstract = {Recent advances in vision-language models (VLMs) have significantly improved their performance on various downstream tasks. However, these models often exhibit biases, particularly in generating harmful or biased content, which can lead to societal harm. Existing debiasing methods for VLMs are limited in their ability to mitigate biases effectively, especially for complex scenarios involving multiple sensitive attributes. In this paper, we propose a novel framework, called FairVLM, to mitigate biases in VLMs by leveraging a two-stage debiasing approach. In the first stage, we introduce a bias measurement module that quantifies the bias in generated content across multiple sensitive attributes, such as gender, race, and age. This module employs a multi-attribute bias detector trained on diverse datasets to identify and score biased outputs. In the second stage, we develop a reinforcement learning-based fine-tuning strategy that incorporates the bias scores as rewards to guide the model towards generating fairer content. Our approach is model-agnostic and can be applied to various VLMs without requiring access to their internal parameters. Extensive experiments on benchmarks like RealToxicityPrompts and BBQ demonstrate that FairVLM significantly reduces bias while maintaining the model's utility and performance on general tasks. Our work provides a scalable and effective solution for promoting fairness in VLMs, paving the way for their safe deployment in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Narayanan Venkit},
 booktitle = {Proceedings of the 2025 {ACM}},
 doi = {10.1145/3715275.3732089},
 isbn = {979-8-4007-1482-5},
 keywords = {Answer Engines},
 pages = {1325--1340},
 publisher = {Association for Computing Machinery},
 series = {{FAccT}},
 title = {Search {Engines}},
 url = {https://doi.org/10.1145/3715275.3732089},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:53:36Z},
 year = {2025}
}

@inproceedings{naseem_grounded_2024,
 abstract = {Large language models (LLMs) have shown impressive abilities in various natural language processing tasks, but their performance on tasks requiring long contexts remains underexplored. In this paper, we systematically study how LLMs utilize long contexts through controlled experiments. We design a synthetic task where the answer is hidden in a long context, and we vary the position of the answer to test whether LLMs can effectively use information from different parts of the context. Our results reveal that LLMs exhibit a "lost in the middle" effect: performance is highest when relevant information is at the beginning or end of the context, but drops significantly when it is in the middle. We further analyze this phenomenon across different model sizes, context lengths, and task types, providing insights into the limitations of current LLMs in processing long-range dependencies. Our findings suggest that while LLMs can handle long contexts, their attention mechanisms may not be as effective as previously thought, highlighting areas for future improvement.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Naseem},
 booktitle = {Proceedings of the {Annual}},
 doi = {10.18653/v1/2024.findings-acl.10},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {151 -- 162},
 title = {A {Grounded}},
 url = {https://doi.org/10.18653/v1/2024.findings-acl.10},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:08:08Z},
 year = {2024}
}

@article{naveed_comprehensive_2025,
 abstract = {Large Language Models (LLMs) have recently demonstrated remarkable capabilities in natural language processing tasks and beyond. This success of LLMs has led to a large influx of research contributions in this direction. These works encompass diverse topics such as architectural innovations, better training strategies, context length improvements, fine-tuning, multimodal LLMs, robotics, datasets, benchmarking, efficiency, and more. With the rapid development of techniques and regular breakthroughs in LLM research, it has become considerably challenging to perceive the bigger picture of the advances in this direction. Considering the rapidly emerging plethora of literature on LLMs, it is imperative that the research community is able to benefit from a concise yet comprehensive overview of the recent developments in this field. This article provides an overview of the literature on a broad range of LLM-related concepts. Our self-contained comprehensive overview of LLMs discusses relevant background concepts along with covering the advanced topics at the frontier of research in LLMs. This review article is intended to provide not only a systematic survey but also a quick, comprehensive reference for the researchers and practitioners to draw insights from extensive, informative summaries of the existing works to advance the LLM research.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Naveed},
 doi = {10.1145/3744746},
 issn = {2157-6904},
