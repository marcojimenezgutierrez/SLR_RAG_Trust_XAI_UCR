 keywords = {foundation model},
 note = {event-place: Toronto ON},
 pages = {404--414},
 publisher = {Association for Computing Machinery},
 series = {{KDD}},
 title = {{FlanS}},
 url = {https://doi.org/10.1145/3711896.3736963},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:21:50Z},
 year = {2025}
}

@article{da_ge-chat_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their performance in structured tasks like mathematical reasoning remains a challenge. In this paper, we introduce a novel benchmark, MathInstruct, designed to evaluate the mathematical reasoning abilities of LLMs through instruction-following tasks. MathInstruct consists of 12,500 diverse math problems spanning arithmetic, algebra, geometry, and calculus, each paired with step-by-step solution instructions. We evaluate several state-of-the-art LLMs, including GPT-4, Llama-2, and Mistral, in both zero-shot and few-shot settings. Our results reveal significant gaps in current models' ability to follow mathematical instructions accurately, with even top-performing models achieving only 45% success on complex problems. We further analyze error patterns and propose fine-tuning strategies to improve instruction adherence. This work highlights the need for targeted advancements in LLMs for reliable mathematical reasoning and provides a robust evaluation framework for future research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
