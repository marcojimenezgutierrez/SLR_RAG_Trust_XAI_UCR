 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:26:09Z},
 year = {2025}
}

@inproceedings{chen_ipl_2024,
 abstract = {Large language models (LLMs) have revolutionized content generation, but ensuring their outputs comply with legal standards remains a critical challenge. This paper explores the integration of legal compliance mechanisms into LLM workflows, focusing on copyright infringement and privacy violations. We introduce a hybrid approach combining rule-based filters, embedding-based similarity checks, and fine-tuned detection models to identify risky content pre-generation and post-generation. Through case studies on real-world datasets from news articles and user-generated content, we evaluate the framework's effectiveness, achieving a 92% detection accuracy for copyright issues and 88% for privacy breaches, with minimal impact on generation fluency. Our findings underscore the need for domain-specific legal training data and iterative human oversight to balance compliance and creativity in AI-driven applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Chen},
 doi = {10.18653/v1/2024.emnlp-industry.52},
 keywords = {source: Scopus},
