@inproceedings{sequeda_benchmark_2024,
 abstract = {Articulated object manipulation is a fundamental yet challenging task in robotics, requiring robots to interact with diverse objects that have movable parts, such as doors, drawers, and cabinets. Despite significant progress in learning-based approaches, existing methods often struggle with generalization to unseen objects and categories, limiting their real-world applicability. In this work, we propose a novel zero-shot framework for articulated object manipulation that leverages visual affordance prediction to enable generalizable interaction without requiring category-specific training. Our approach consists of two key components: (1) an affordance prediction module that identifies interaction points and types (e.g., rotate, slide) from visual observations using a pre-trained vision-language model, and (2) a manipulation policy that conditions on these affordances to execute precise actions. We evaluate our method on a diverse set of articulated objects in simulation and real-world settings, demonstrating superior generalization compared to prior zero-shot and few-shot baselines. Our framework advances the field by bridging the gap between perception and action for flexible robotic manipulation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Sequeda},
 booktitle = {Proceedings of the 7th {Joint}},
