 year = {2024}
}

@article{min_verification_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has led to increased integration of AI systems in safety-critical applications, such as autonomous vehicles and medical diagnostics. However, ensuring the reliability and safety of these systems remains a significant challenge. This paper presents a novel framework for AI testing that incorporates adversarial robustness evaluation and formal verification techniques. We propose a hybrid approach combining machine learning-based test generation with model checking to identify potential failure modes in deep neural networks. Experimental results on benchmark datasets demonstrate that our method achieves a 25% improvement in detecting adversarial examples compared to traditional gradient-based attacks. Furthermore, we discuss ethical considerations and scalability issues in deploying such testing frameworks in real-world scenarios.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
