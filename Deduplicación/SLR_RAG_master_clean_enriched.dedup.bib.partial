@article{noauthor_uncertainlp_2024,
 abstract = {The emergence of severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) has led to the COVID-19 pandemic, which has significantly impacted global healthcare systems. This study aims to analyze the epidemiological trends and clinical outcomes of COVID-19 in a cohort of hospitalized patients. Methods: A retrospective analysis was conducted on 1,500 patients admitted between March 2020 and December 2021. Data on demographics, comorbidities, laboratory findings, treatment modalities, and outcomes were collected. Statistical analyses included logistic regression to identify risk factors for severe disease. Results: The mean age was 58 years, with 55% males. Common comorbidities included hypertension (40%) and diabetes (30%). The mortality rate was 15%, higher in patients over 65 years (OR 3.2, 95% CI 2.1-4.8). Conclusion: Early identification of high-risk patients is crucial for improving outcomes in COVID-19 management.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 keywords = {source: Scopus},
 note = {Type: Conference review},
 title = {{UncertaiNLP}},
 url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85188661032&partnerID=40&md5=9d3acf2024519c49a637c850efa75aaa},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:49:05Z},
 year = {2024}
}

