@inproceedings{mohan_enhancing_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) and machine learning (ML) technologies has revolutionized various sectors, including healthcare. However, the integration of AI in medical diagnostics raises significant ethical, legal, and social concerns. This paper explores the challenges and opportunities associated with AI-driven diagnostic tools, focusing on accuracy, bias mitigation, data privacy, and regulatory frameworks. Through a comprehensive review of existing literature and case studies, we propose a multi-stakeholder framework to ensure responsible AI deployment in healthcare. Our findings highlight the need for interdisciplinary collaboration to balance innovation with patient safety and equity.},
