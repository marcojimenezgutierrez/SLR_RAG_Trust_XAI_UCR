@inproceedings{mawardi_indonesian_2025,
 abstract = {This paper proposes a novel framework for optimizing deep learning models in resource-constrained environments, focusing on edge computing applications. We introduce an adaptive pruning technique that dynamically adjusts model complexity based on input data characteristics, achieving up to 40% reduction in computational overhead without significant accuracy loss. Experimental results on benchmark datasets demonstrate the efficacy of our approach in real-time scenarios, such as IoT device integration and mobile AI inference. The framework is implemented using TensorFlow and evaluated across various hardware platforms.},
