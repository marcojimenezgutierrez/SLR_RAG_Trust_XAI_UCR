@article{zhao_tcaf_2024,
 abstract = {Large language models have a surprising ability to perform complex reasoning tasks without explicit training on those tasks. We show that this ability arises from the model's ability to learn a wide variety of skills, which are then composed together to solve new tasks. We study this ability by training a large language model on a massive dataset of code, and then evaluating its ability to solve a variety of tasks, including visual question answering, math word problems, and multi-step reasoning. We find that the model can solve these tasks with few-shot learning, and that its performance improves with scale. We also find that the model can generalize to new tasks that it has not seen before, and that this generalization improves with scale.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
