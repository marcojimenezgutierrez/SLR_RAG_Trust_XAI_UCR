@article{filice_generating_2025-1,
 abstract = {This paper explores the integration of large language models (LLMs) into enterprise workflows, focusing on practical deployment challenges in production environments. We propose a framework that addresses key issues such as data privacy, scalability, and fine-tuning efficiency. Through case studies from industry partners, we demonstrate how our approach reduces deployment time by 40% while maintaining model performance. Our findings highlight the importance of hybrid on-premise and cloud architectures for secure LLM adoption in regulated sectors.},
