@article{weinert_enhancing_2025,
 abstract = {Purpose To develop and validate a deep learning model for the detection of incidental pulmonary nodules on chest radiographs and to evaluate its performance in a real-world clinical setting.

Materials and Methods This retrospective study included 12 069 chest radiographs with bounding box annotations for pulmonary nodules acquired between January 2015 and December 2019 at institution 1 for training. The model was validated on an internal test set of 2000 chest radiographs from institution 1 and an external test set of 1000 chest radiographs from institution 2. Model performance was assessed using sensitivity, specificity, positive predictive value, and negative predictive value at the patient and nodule levels. From July 2022 to June 2023, the model was prospectively deployed on 50 000 consecutive chest radiographs at institution 1, and its detection performance was evaluated by comparison with radiologist reports.

Results On the internal test set, the model achieved a patient-level sensitivity of 92% (95% CI: 90, 94) and specificity of 88% (95% CI: 87, 90). On the external test set, sensitivity was 89% (95% CI: 85, 93) and specificity was 91% (95% CI: 89, 93). In real-world deployment, the model flagged 456 nodules in 412 patients, of which 378 (83%) were confirmed by radiologists, yielding a positive predictive value of 83% (95% CI: 79, 86).

Conclusion The deep learning model showed high sensitivity and specificity for detecting incidental pulmonary nodules on chest radiographs and demonstrated promising performance in real-world clinical deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 4},
 author = {Weinert},
 doi = {10.1148/ryai.240313},
 journal = {Radiology: Artificial Intelligence},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {3},
 title = {Enhancing {Large}},
 url = {https://doi.org/10.1148/ryai.240313},
 volume = {7},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:39:55Z},
 year = {2025}
}

@article{wellawatte_chemlit-qa_2025,
 abstract = {Abstract Retrieval-Augmented Generation (RAG) is a widely used strategy in Large-Language Models (LLMs) to extrapolate beyond the inherent pre-trained knowledge. Hence, RAG is crucial when working in data-sparse fields such as Chemistry. The evaluation of RAG systems is commonly conducted using specialized datasets. However, existing datasets, typically in the form of scientific Question-Answer-Context (QAC) triplets or QA pairs, are often limited in size due to the labor-intensive nature of manual curation or require further quality assessment when generated through automated processes. This highlights a critical need for large, high-quality datasets tailored to scientific applications. We introduce ChemLit-QA, a comprehensive, expert-validated, open-source dataset comprising over 1,000 entries specifically designed for chemistry. Our approach involves the initial generation and filtering of a QAC dataset using an automated framework based on GPT-4 Turbo, followed by rigorous evaluation by chemistry experts. Additionally, we provide two supplementary datasets: ChemLit-QA-neg focused on negative data, and ChemLit-QA-multi focused on multihop reasoning tasks for LLMs, which complement the main dataset on hallucination detection and more reasoning-intensive tasks.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 1; All Open Access; Gold Open Access},
 author = {Wellawatte},
 doi = {10.1088/2632-2153/adc2d6},
 journal = {Machine Learning: Science and Technology},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {2},
 title = {{ChemLit}},
 url = {https://doi.org/10.1088/2632-2153/adc2d6},
 volume = {6},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:37:59Z},
 year = {2025}
}

@article{welsh_custom-tailored_2025,
 abstract = {Large language models (LLMs) show promise in enhancing medical research through domain-specific question answering. However, their clinical application is limited by hallucination risk, limited domain specialization, and privacy concerns. Public LLMs like GPT-4-Consensus pose challenges for use with institutional data, due to the inability to ensure patient data protection. In this work, we present a secure, custom-designed retrieval-augmented generation (RAG) LLM system deployed entirely within our institution and tailored for radiology research. Radiology researchers at our institution evaluated the system against GPT-4-Consensus through a blinded survey assessing factual accuracy (FA), citation relevance (CR), and perceived performance (PP) using 5-point Likert scales. Our system achieved mean ± SD scores of 4.15 ± 0.99 for FA, 3.70 ± 1.17 for CR, and 3.55 ± 1.39 for PP. In comparison, GPT-4-Consensus obtained 4.25 ± 0.72, 3.85 ± 1.23, and 3.90 ± 1.12 for the same metrics, respectively. No statistically significant differences were observed (p = 0.97, 0.65, 0.42), and 50% of participants preferred our system’s output. These results validate that secure, local RAG-based LLMs can match state-of-the-art performance while preserving privacy and adaptability, offering a scalable tool for medical research environments.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0},
 author = {Welsh},
 doi = {10.3390/inventions10040055},
 journal = {Inventions},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {4},
 title = {Custom-{Tailored}},
 url = {https://doi.org/10.3390/inventions10040055},
 volume = {10},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:35:32Z},
 year = {2025}
}

@article{welz_enhancing_2024,
 abstract = {Intrusion detection systems (IDS) play a crucial role in cybersecurity by identifying malicious activities in network traffic. Traditional IDS often struggle with high false positive rates and inability to detect novel attacks. This chapter proposes a novel hybrid machine learning framework that integrates convolutional neural networks (CNN) with random forest classifiers to enhance IDS performance. The approach preprocesses network data using feature selection techniques and applies the hybrid model for binary and multi-class classification of intrusions. Experiments conducted on the NSL-KDD and CIC-IDS2017 datasets demonstrate superior accuracy, precision, recall, and F1-score compared to baseline methods, achieving up to 99.5% detection rate with reduced computational overhead. The results highlight the framework's potential for real-time deployment in modern networks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 4},
 author = {Welz},
 doi = {10.1007/978-3-031-60615-1_9},
