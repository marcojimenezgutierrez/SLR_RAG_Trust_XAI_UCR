@inproceedings{omrani_hybrid_2024,
 abstract = {This study proposes a novel framework for real-time water quality monitoring using Internet of Things (IoT) sensors integrated with machine learning algorithms. The system collects data on key parameters such as pH, turbidity, dissolved oxygen, and temperature from rivers and lakes. A hybrid model combining Random Forest and Long Short-Term Memory (LSTM) networks is employed for predictive analytics to detect pollution events early. Experimental deployment in a urban river basin showed 95% accuracy in anomaly detection, enabling proactive environmental management. The approach demonstrates scalability and cost-effectiveness for widespread adoption in water resource conservation.},
