 x_enrich_ts = {2025-11-02T06:17:33Z},
 year = {2024}
}

@article{jiang_knowledge_2025,
 abstract = {In this paper, a novel multi-granularity three-way decision model based on probabilistic rough sets is proposed to address the uncertainty in multi-granularity decision-making problems. First, we introduce the concept of multi-granularity probabilistic rough sets by combining multi-granularity rough sets with probabilistic rough sets, which can effectively handle the uncertainty and fuzziness in decision information. Then, based on the multi-granularity probabilistic rough sets, we define the multi-granularity three-way decision rules, including the positive region, boundary region, and negative region, to provide more flexible decision strategies. Furthermore, we develop a multi-granularity three-way decision model that integrates the loss functions and probabilistic thresholds to optimize the decision process. To verify the effectiveness of the proposed model, we apply it to a real-world case study on supplier selection. The experimental results demonstrate that the proposed model outperforms traditional three-way decision models in terms of decision accuracy and robustness.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
