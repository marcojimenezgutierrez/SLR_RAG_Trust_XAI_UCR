@article{ferrag_llm_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in understanding and generating human-like text, but their application to physical tasks remains limited. In this work, we explore the potential of LLMs to serve as generalist robot policies by leveraging internet-scale video data. We introduce a novel training framework that combines self-supervised learning on vast video corpora with reinforcement learning from human demonstrations. Our approach enables robots to perform a wide range of manipulation tasks, from everyday household activities to complex assembly operations, without task-specific fine-tuning. Experiments on benchmark datasets demonstrate that our model outperforms existing specialized policies by 25% in generalization to unseen environments. We further analyze the key factors contributing to success, including data diversity, model scale, and integration of multimodal inputs. This work paves the way for deploying versatile, adaptable robots in real-world settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
