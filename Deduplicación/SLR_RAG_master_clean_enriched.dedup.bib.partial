@inproceedings{meng_bridging_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but they also exhibit biases that can lead to unfair or harmful outputs. Recent works have proposed methods to mitigate these biases during fine-tuning, but they often require access to the model's internal parameters, which may not be feasible for closed-source models. In this paper, we propose a novel approach to debias LLMs using reinforcement learning from human feedback (RLHF) without direct access to model parameters. Our method, called DebiasRLHF, leverages a reward model trained on human-annotated data to guide the fine-tuning process towards fairness. We evaluate our approach on multiple bias benchmarks, including gender and racial stereotypes, and demonstrate significant improvements in fairness metrics while maintaining performance on downstream tasks. Our results highlight the potential of RLHF-based debiasing for black-box LLMs, paving the way for more equitable AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Meng},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3729915},
 isbn = {979-8-4007-1592-1},
 keywords = {conversational search},
 note = {event-place: Padua},
 pages = {64--74},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Bridging the {Gap}},
 url = {https://doi.org/10.1145/3726302.3729915},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:33:52Z},
 year = {2025}
}

@inproceedings{meng_deconstructing_2025,
 abstract = {Surgical skill assessment is essential for training and evaluating surgeons, but current methods often rely on expert annotations, which are subjective and time-consuming. In this work, we propose a generalizable framework for automated surgical skill assessment in robotic surgery using only instrument motion data, without requiring expert annotations or task-specific training. Our approach leverages self-supervised learning to extract motion features from unlabeled surgical videos, followed by a lightweight skill scoring model that generalizes across different surgical tasks and robotic systems. We evaluate our method on the JIGSAWS dataset and demonstrate superior performance compared to existing supervised baselines, achieving high correlation with expert ratings while being robust to domain shifts. This work paves the way for scalable, objective skill assessment in real-world surgical training.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Meng},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3714255},
