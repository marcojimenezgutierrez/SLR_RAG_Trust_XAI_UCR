@inproceedings{shi_learnable_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in various natural language processing tasks. However, their application in multi-agent systems remains underexplored. In this paper, we conduct a comprehensive survey on LLM-based multi-agent systems. We first define the key concepts and taxonomy of LLM-based multi-agent systems. Then, we review the existing works from three perspectives: workflow, infrastructure, and challenges. Specifically, we discuss the typical workflow of LLM-based multi-agent systems, including perception, planning, action, and reflection. We also summarize the infrastructure for building such systems, such as communication protocols, memory management, and tool integration. Finally, we highlight the main challenges and future research directions in this emerging field. This survey aims to provide researchers with a holistic view of the current state-of-the-art and inspire further innovations in LLM-based multi-agent systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
