@article{li_mitigating_2024,
 abstract = {**Abstract**

Artificial intelligence (AI) has emerged as a transformative force in drug discovery, accelerating the identification of novel therapeutic targets and optimizing lead compound development. However, the integration of AI into pharmaceutical research remains fragmented, with varying degrees of adoption across industry and academia. This study conducts a comprehensive bibliometric analysis of AI applications in drug discovery from 2010 to 2023, utilizing data from Web of Science and Scopus databases. We identify key trends, influential publications, and collaborative networks, revealing a surge in AI-driven virtual screening and de novo drug design. Machine learning models, particularly deep neural networks, dominate the literature, with protein-ligand interaction prediction being the most studied area. Geographic analysis highlights leadership by institutions in the United States and China, while keyword co-occurrence maps underscore interdisciplinary intersections with cheminformatics and bioinformatics. Despite rapid growth, challenges such as data quality, model interpretability, and regulatory hurdles persist. Our findings provide a roadmap for future research, emphasizing the need for standardized AI frameworks to enhance reproducibility and clinical translation in drug discovery.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Li},
 doi = {10.1101/2024.09.27.24314506.abstract},
 journal = {medRxiv},
 keywords = {source: Google Scholar},
 note = {Publisher: medrxiv.org},
 title = {Mitigating {Hallucinations}},
 url = {https://doi.org/10.1101/2024.09.27.24314506.abstract},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:22:07Z},
 year = {2024}
}

@inproceedings{li_mm-forecast_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating code, but their application in visual programming remains underexplored. This paper explores the design space of visual programming interfaces for human-robot teaming, where users program robots using visual blocks rather than text. We present a novel system that integrates LLMs to assist in block-based programming, enabling natural language inputs to generate visual code. Through a user study with 24 participants, we evaluate the system's usability, efficiency, and effectiveness compared to traditional text-based programming. Results indicate significant improvements in task completion time and user satisfaction, particularly for novice users. We discuss implications for accessible robotics programming and future directions in AI-assisted visual interfaces.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
