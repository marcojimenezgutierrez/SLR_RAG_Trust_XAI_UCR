 keywords = {adaptive reflection},
 note = {event-place: Boise},
 pages = {354--364},
 publisher = {Association for Computing Machinery},
 series = {{CIKM}},
 title = {Empowering {Private}},
 url = {https://doi.org/10.1145/3627673.3679665},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:25:57Z},
 year = {2024}
}

@article{chen_enhanced_2024,
 abstract = {Large language model (LLM) processing, with natural language as its core, carries out information retrieval through intelligent Q&A. It has a wide range of application scenarios and is commonly considered a kind of generative AI. However, when LLMs handle generation tasks, the results generated by fundamental LLMs with an insufficient comprehensive performance, specifically in the vertical domain, are often inaccurate due to a poor generalization ability, resulting in the so-called “hallucination” phenomenon. To solve these problems, in this study, an enhanced retrieval scheme for LLM processing was developed, named the BM-RAGAM (BM25 retrieval-augmented generation attention mechanism), by constructing a vectorized knowledge base, utilizing a hybrid joint retrieval strategy of keyword matching through searching and a semantic-enhanced association with an attention mechanism and taking ocean-front- and eddy-related knowledge in oceanography as an example. This scheme realized accurate word-based matching with the BM25 algorithm and text generation through a semantic-enhanced association using RAG, and it was used to construct a vector database of the text knowledge on ocean fronts and eddies. The output was compared and analyzed with the fundamental LLM of Qwen2-72B using the proposed scheme, and an ablation experiment was conducted. The results show that the proposed scheme greatly reduced hallucination generation in the process of text generation, making its outputs more interpretable.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 2; All Open Access; Gold Open Access},
 author = {Chen},
 doi = {10.3390/app142411529},
 journal = {Applied Sciences (Switzerland)},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {24},
 title = {An {Enhanced}},
 url = {https://doi.org/10.3390/app142411529},
 volume = {14},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:01:37Z},
 year = {2024}
}

@inproceedings{chen_exploring_2025,
 abstract = {This paper presents a novel approach to optimizing supply chain management using machine learning techniques. We propose a hybrid model that integrates deep neural networks with traditional optimization algorithms to predict demand fluctuations and minimize inventory costs. The model was tested on real-world datasets from the retail sector, achieving a 25% reduction in stockouts and a 15% decrease in holding costs compared to baseline methods. Our results demonstrate the potential for scalable implementation in dynamic market environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Chen},
 booktitle = {{CEUR}},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {19 -- 28},
 title = {Exploring the {Role}},
 url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105010688471&partnerID=40&md5=c4d8bce0f477087e3b5092182476c098},
 volume = {3985},
