@article{noauthor_international_2025,
 abstract = {The emergence of COVID-19 has disrupted life as we know it. In addition to the tragic loss of life, this pandemic has affected the way we live and work in profound ways. In this article, we provide an overview of the implications of COVID-19 for the workplace, with a focus on implications for future research and action. We begin by describing the context of the pandemic and its initial effects on work. We then discuss key issues related to employee well-being, work arrangements, leadership, and inequality. We conclude with recommendations for organizations, policymakers, and researchers.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 journal = {Lecture Notes in Networks and Systems},
 keywords = {source: Scopus},
 note = {Type: Conference review},
