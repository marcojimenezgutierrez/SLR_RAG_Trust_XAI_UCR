@inproceedings{zhu_ospc_2024,
 abstract = {Inclusive higher education is crucial for fostering equitable learning environments, yet many online learning platforms and practices remain inaccessible to diverse learners, including those with disabilities, from underrepresented groups, or with varying socio-economic backgrounds. This systematic literature review synthesizes evidence on inclusive practices in online higher education, focusing on pedagogical, technological, and institutional strategies. We analyzed 87 peer-reviewed articles published between 2015 and 2023, identifying key themes such as universal design for learning (UDL), accessibility features in learning management systems (LMS), and faculty training for inclusive teaching. Findings reveal that while UDL principles enhance engagement and retention, implementation barriers like resource constraints and lack of awareness persist. We propose a framework for integrating inclusive practices, emphasizing intersectional approaches that address multiple dimensions of diversity. This review contributes to the growing body of knowledge on digital equity in education, offering actionable recommendations for educators, designers, and policymakers to create more inclusive online learning experiences.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhu},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3589335.3665994},
