@article{du_retrieval-augmented_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly impacted various sectors, including healthcare, finance, and transportation. This paper presents a comprehensive review of recent developments in AI-driven intelligent systems, focusing on their integration with edge computing for real-time decision-making. We explore key challenges such as data privacy, model interpretability, and scalability, while proposing a novel framework for hybrid AI architectures that combine deep learning with symbolic reasoning. Experimental results on benchmark datasets demonstrate improved performance in terms of accuracy and efficiency compared to traditional methods. Future directions include ethical considerations and sustainable AI deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
