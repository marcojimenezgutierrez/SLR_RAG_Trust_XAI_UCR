@article{yang_crag-comprehensive_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating code, but they often produce insecure code that is vulnerable to attacks. Recent studies have attempted to mitigate this issue by fine-tuning LLMs on human-written secure code, yet these approaches are limited by the scarcity of high-quality secure code data and the inherent complexity of security issues. In this paper, we propose a novel approach to enhance the security of LLM-generated code through reinforcement learning from code execution feedback. Specifically, we develop a secure code generation framework that leverages a code interpreter to automatically evaluate the generated code for security vulnerabilities and provides feedback to guide the LLM towards producing more secure outputs. Our method does not require extensive secure code datasets, as it learns directly from execution results. We evaluate our approach on real-world benchmarks and demonstrate significant improvements in generating secure code, reducing vulnerabilities by up to 40% compared to baseline LLMs. Our findings suggest that execution-guided reinforcement learning is a promising direction for improving the security of code generated by LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Yang},
 journal = {Advances in …},
 keywords = {source: Google Scholar},
 note = {Publisher: proceedings.neurips.cc},
 title = {Crag-comprehensive rag benchmark},
 url = {https://proceedings.neurips.cc/paper_files/paper/2024/hash/1435d2d0fca85a84d83ddcb754f58c29-Abstract-Datasets_and_Benchmarks_Track.html},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:42:58Z},
 year = {2024}
}

@inproceedings{yang_debugging_2024,
 abstract = {People often capture photos and videos to create digital memories, but these media are often revisited only a few times before being forgotten. We investigate how people share memories with family members and uncover opportunities for technology to support family memory sharing. Through a survey (N=201) and in-depth interviews (N=18), we find that people share memories to strengthen family bonds, preserve family history, and relive shared experiences. However, sharing is hindered by the effort required to find and select media, as well as concerns about privacy and appropriateness. We propose design implications for family-oriented memory technologies, including features to facilitate discovery, curation, and sharing of media, while addressing privacy concerns. Our findings highlight the importance of supporting family dynamics in the design of personal memory technologies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Yang},
 booktitle = {Proceedings of the 2024 {ACM}},
