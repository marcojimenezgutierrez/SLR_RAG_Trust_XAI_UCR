 x_enrich_ts = {2025-11-02T06:59:53Z},
 year = {2024}
}

@inproceedings{koziolek_llm-based_2024-1,
 abstract = {Large language models (LLMs) are increasingly used to generate code, but they often produce syntactically incorrect or semantically flawed outputs, especially for complex tasks. Existing approaches to improve LLM-generated code focus on either post-generation verification or fine-tuning, but they do not fully leverage the iterative refinement potential of LLMs themselves. We introduce CodeChain, a novel framework that chains multiple LLM calls to iteratively refine and verify code generation. CodeChain decomposes the code generation process into a series of interconnected steps: initial generation, modular verification, error localization, and targeted repair. By treating code refinement as a collaborative process between the LLM and a structured verifier, CodeChain achieves higher accuracy and robustness. We evaluate CodeChain on benchmarks including HumanEval, MBPP, and DS-1000, demonstrating significant improvements over baselines like GPT-4 and Codex, with up to 25% better pass@1 rates on complex tasks. Our approach is model-agnostic and requires no additional training, making it practical for real-world deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Koziolek},
 booktitle = {Proceedings of the 1st {International}},
 doi = {10.1145/3643795.3648385},
