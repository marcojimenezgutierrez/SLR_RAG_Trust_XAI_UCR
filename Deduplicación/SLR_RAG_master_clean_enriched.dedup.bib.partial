@article{craig_lmrac_2024,
 abstract = {Abstract Motivation Large Language Models (LLMs) have provided spectacular results across a wide variety of domains. However, persistent concerns about hallucination and fabrication of authoritative sources raise serious issues for their integral use in scientific research. Retrieval-augmented generation (RAG) is a technique for making data and documents, otherwise unavailable during training, available to the LLM for reasoning tasks. In addition to making dynamic and quantitative data available to the LLM, RAG provides the means by which to carefully control and trace source material, thereby ensuring results are accurate, complete, and authoritative. Results Here, we introduce LmRaC, an LLM-based tool capable of answering complex scientific questions in the context of a user’s own experimental results. LmRaC allows users to dynamically build domain specific knowledge-bases from PubMed sources (RAGdom). Answers are drawn solely from this RAG with citations to the paragraph level, virtually eliminating any chance of hallucination or fabrication. These answers can then be used to construct an experimental context (RAGexp) that, along with user supplied documents (e.g. design, protocols) and quantitative results, can be used to answer questions about the user’s specific experiment. Questions about quantitative experimental data are integral to LmRaC and are supported by a user-defined and functionally extensible REST API server (RAGfun). Availability and implementation Detailed documentation for LmRaC along with a sample REST API server for defining user functions can be found at https://github.com/dbcraig/LmRaC. The LmRaC web application image can be pulled from Docker Hub (https://hub.docker.com) as dbcraig/lmrac.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 2; All Open Access; Gold Open Access},
 author = {Craig},
 doi = {10.1093/bioinformatics/btae679},
 journal = {Bioinformatics},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {12},
 title = {{LmRaC}},
 url = {https://doi.org/10.1093/bioinformatics/btae679},
 volume = {40},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:01:37Z},
 year = {2024}
}

@inproceedings{craig_whats_2024,
 abstract = {Machine learning models have achieved remarkable success in various domains, but their performance can be limited by the lack of interpretability, especially in high-stakes applications like healthcare. In this paper, we propose a novel framework for enhancing the interpretability of deep learning models in biomedical image analysis. Our approach integrates attention mechanisms with counterfactual explanations to provide both global and local insights into model decisions. We evaluate our method on chest X-ray datasets for disease classification, demonstrating improved faithfulness and user trust compared to existing methods. The results highlight the potential of our framework to bridge the gap between model accuracy and clinical usability.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Craig},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/BIBM62325.2024.10821725},
