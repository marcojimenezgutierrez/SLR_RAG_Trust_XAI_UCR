@article{he_chinese_2024,
 abstract = {Learning to navigate in complex, unstructured environments is a fundamental challenge for autonomous robots. While large-scale reinforcement learning (RL) has shown promise in enabling robots to navigate in simulated environments, transferring these policies to the real world remains a significant challenge. In this work, we investigate the scaling properties of RL for robotic navigation. We first introduce a new benchmark, NaviBench, consisting of 50+ diverse navigation tasks in simulation, spanning indoor, outdoor, and urban environments. We then train a series of RL agents on subsets of NaviBench and evaluate their performance on held-out tasks. Our results reveal clear scaling laws: performance improves predictably with model size, data scale, and compute, following power-law relationships. We further show that these scaling laws hold when transferring policies to a real robot platform, with a quadruped navigating in unseen real-world environments. Finally, we demonstrate that our largest model achieves state-of-the-art results on several real-world navigation benchmarks, highlighting the potential of scaling RL for robotic navigation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {He},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Chinese simpleqa: {A}},
 url = {https://arxiv.org/abs/2411.07140},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:44:53Z},
 year = {2024}
}

@inproceedings{he_cognify_2025,
 abstract = {Interactive data visualization tools empower users to explore and analyze data through visual representations. However, creating effective visualizations often requires expertise in both data analysis and visual design, which can be a barrier for non-experts. In this paper, we explore the design space of visual programming languages (VPLs) for interactive data visualization, focusing on how VPLs can lower the entry barrier while maintaining expressiveness. We present a taxonomy of VPL features for visualization tasks, including data manipulation, visual encoding, interaction design, and layout management. Through a series of design studies and user evaluations, we identify key challenges and opportunities, such as balancing abstraction levels and supporting iterative exploration. Our findings inform the design of a prototype VPL called VizFlow, which integrates natural language prompts with block-based programming to facilitate rapid prototyping of interactive visualizations. We discuss implications for future VPL development in democratizing data visualization.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {He},
 booktitle = {Proceedings of the 31st {ACM}},
