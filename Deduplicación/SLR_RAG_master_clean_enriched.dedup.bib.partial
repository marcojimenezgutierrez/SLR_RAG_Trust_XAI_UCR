 year = {2024}
}

@inproceedings{yoon_implementation_2025,
 abstract = {This paper proposes a novel federated learning framework for edge computing in 6G networks, addressing privacy preservation and resource efficiency. We introduce a differential privacy mechanism integrated with asynchronous aggregation to mitigate communication overhead in heterogeneous devices. Extensive simulations demonstrate that our approach achieves up to 30% reduction in latency compared to traditional federated learning methods while maintaining model accuracy above 95%. The framework is particularly suited for IoT applications in smart cities, showcasing robustness against adversarial attacks.},
