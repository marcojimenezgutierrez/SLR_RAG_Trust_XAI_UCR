@inproceedings{rogers_what_2024,
 abstract = {Despite the impressive performance of deep neural networks (DNNs) in various computer vision tasks, they often exhibit biases toward certain demographic groups, leading to unfair outcomes. Existing debiasing methods primarily focus on mitigating biases in the training data or model representations, but they often overlook the biases introduced during the inference phase, particularly in real-world scenarios where the test data distribution may differ from the training data. In this paper, we propose a novel framework, FairInference, to achieve fairness in visual recognition during inference by dynamically adjusting the model's decision boundary for each input image based on its demographic attributes. Specifically, we introduce a lightweight fairness module that learns to predict the bias score for each image and compensates for the biased predictions accordingly. Our approach is model-agnostic and can be seamlessly integrated into any pre-trained DNN without requiring access to the training data or retraining the model. Extensive experiments on multiple datasets and tasks demonstrate that FairInference significantly reduces demographic biases while maintaining high accuracy, outperforming state-of-the-art debiasing methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Rogers},
 booktitle = {Companion of the 2024 {ACM}},
 doi = {10.1145/3610978.3640752},
 isbn = {979-8-4007-0323-2},
 keywords = {deception},
 note = {event-place: Boulder},
 pages = {906--910},
 publisher = {Association for Computing Machinery},
 series = {{HRI}},
 title = {What {Should}},
 url = {https://doi.org/10.1145/3610978.3640752},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:03:17Z},
 year = {2024}
}

@article{roll_augmenting_2025,
 abstract = {This preliminary study covers the construction and application of a Graph-based Retrieval-Augmented Generation (GraphRAG) system integrating a multimodal LLM, Large Language and Vision Assistant (LLaVA) with graph database software (Neo4j) to enhance LLM output quality through structured knowledge retrieval. This is aimed at the field of orbital debris detection, proposed to support the current intelligent methods for such detection by introducing the beneficial properties of both LLMs and a corpus of external information. By constructing a dynamic knowledge graph from relevant research papers, context-aware retrieval is enabled, improving factual accuracy and minimizing hallucinations. The system extracts, summarizes, and embeds research papers into a Neo4j graph database, with API-powered LLM-generated relationships enriching interconnections. Querying this graph allows for contextual ranking of relevant documents, which are then provided as context to the LLM through prompt engineering during the inference process. A case study applying the technology to a synthetic image of orbital debris is discussed. Qualitative results indicate that the inclusion of GraphRAG and external information result in successful retrieval of information and reduced hallucinations. Further work to refine the system is necessary, as well as establishing benchmark tests to assess performance quantitatively. This approach offers a scalable and interpretable method for enhanced domain-specific knowledge retrieval, improving the qualitative quality of the LLM’s output when tasked with description-based activities.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 2; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Roll},
 doi = {10.3390/s25113352},
 journal = {Sensors},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {11},
 title = {Augmenting {Orbital}},
 url = {https://doi.org/10.3390/s25113352},
 volume = {25},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:39:20Z},
 year = {2025}
}

@article{rome__2024,
 abstract = {Visual programming languages (VPLs) have been widely used to enable end-users to create data visualization without programming. However, existing VPLs often require users to have a certain level of expertise in data visualization design and programming concepts, which limits their accessibility to novices. In this paper, we explore the design space of VPLs for interactive data visualization, with a focus on supporting novices. We first conducted a literature review and analysis of existing VPLs to identify key design dimensions, including representation, interaction, and abstraction. Based on these dimensions, we designed and implemented three prototype VPLs that vary along these dimensions: a block-based VPL, a node-based VPL, and a direct-manipulation VPL. We then conducted a user study with 24 novice participants to evaluate the usability, learnability, and effectiveness of these prototypes. Our results show that the direct-manipulation VPL was preferred by novices for its intuitiveness and ease of use, while the block-based VPL was better for expressing complex logic. We discuss the implications of our findings for designing VPLs for novices and provide design guidelines for future VPL development.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Rome},
