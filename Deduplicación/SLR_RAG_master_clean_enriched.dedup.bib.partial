@inproceedings{xu_large_2025,
 abstract = {Generative AI has shown great potential in assisting creative writing, but current approaches often focus on generating text from user prompts, which can lead to a disconnect between the user's creative intent and the generated output. In this paper, we explore how generative AI can support creative writing by augmenting the user's writing process in a more interactive and collaborative manner. We present WriteMate, a novel AI-powered writing assistant that integrates seamlessly into the user's writing environment, providing real-time suggestions, feedback, and inspiration without disrupting the creative flow. Through a user study with 24 writers, we evaluate WriteMate's effectiveness in enhancing creativity, productivity, and satisfaction. Our findings show that WriteMate significantly improves the quality and originality of writing while reducing writer's block. We discuss design implications for AI writing tools and opportunities for future research in human-AI creative collaboration.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Xu},
 booktitle = {Proceedings of the 2025 9th {International}},
 doi = {10.1145/3722150.3722167},
 isbn = {979-8-4007-1164-0},
 keywords = {Finetune},
 pages = {35--39},
 publisher = {Association for Computing Machinery},
 series = {{CCEAI}},
 title = {Large {Language}},
 url = {https://doi.org/10.1145/3722150.3722167},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:56:06Z},
 year = {2025}
}

@article{xu_large_2025-1,
 abstract = {The rapid advancement of Large Language Models (LLMs) has opened up new opportunities for leveraging artificial intelligence in a variety of application domains, including cybersecurity. As the volume and sophistication of cyber threats continue to grow, there is an increasing need for intelligent systems that can automatically detect vulnerabilities, analyze malware, and respond to attacks. In this survey, we conduct a comprehensive review of the literature on the application of LLMs in cybersecurity (LLM4Security). By comprehensively collecting over 40K relevant papers and systematically analyzing 185 papers from top security and software engineering venues, we aim to provide a holistic view of how LLMs are being used to solve diverse problems across the cybersecurity domain. Through our analysis, we identify several key findings. First, we observe that LLMs are being applied to an expanding range of cybersecurity tasks, including vulnerability detection, malware analysis, and network intrusion detection. Second, we analyze application trends of different LLM architectures (such as encoder-only, encoder-decoder, and decoder-only) across security domains. Third, we identify increasingly sophisticated techniques for adapting LLMs to cybersecurity, such as advanced fine-tuning, prompt engineering, and external augmentation strategies. A significant emerging trend is the use of LLM-based autonomous agents, which represent a paradigm shift from single-task execution to orchestrating complex, multi-step security workflows. Furthermore, we find that the datasets used for training and evaluating LLMs are often limited, highlighting the need for more comprehensive datasets and the use of LLMs for data augmentation. Finally, we discuss the main challenges and opportunities for future research, including the need for more interpretable models, addressing the inherent security risks of LLMs, and their potential for proactive defense. Overall, our survey provides a comprehensive overview of the current state-of-the-art in LLM4Security and identifies several promising directions for future research. We believe that the insights and findings presented in this survey will contribute to the growing body of knowledge on the application of LLMs in cybersecurity and provide valuable guidance for researchers and practitioners working in this field.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Just Accepted},
 author = {Xu},
 doi = {10.1145/3769676},
 issn = {1049-331X},
 journal = {ACM Trans. Softw. Eng. Methodol.},
 keywords = {Cybersecurity},
 month = {sep},
 note = {Place: New York},
 title = {Large {Language}},
 url = {https://doi.org/10.1145/3769676},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:06Z},
 year = {2025}
}

@inproceedings{xu_list-aware_2024,
 abstract = {Online communities thrive on interaction, but silence—periods of non-participation or muted responses—plays a crucial yet underexplored role in shaping these spaces. In this paper, we investigate the forms, causes, and consequences of silence in online communities through a multi-method study involving surveys, interviews, and computational analysis of interaction data from Reddit and Discord. Our findings reveal that silence manifests in diverse ways, from intentional withdrawal to algorithmic suppression, and can both foster deeper reflection and exacerbate feelings of exclusion. We discuss design implications for community platforms, including tools to detect and mitigate harmful silences while preserving beneficial ones. This work contributes to a more nuanced understanding of participation dynamics in digital spaces.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Xu},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3589334.3645336},
 isbn = {979-8-4007-0171-9},
 keywords = {reranking},
 note = {event-place: Singapore},
 pages = {1330--1340},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {List-aware {Reranking}},
 url = {https://doi.org/10.1145/3589334.3645336},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:27:33Z},
 year = {2024}
}

@inproceedings{xu_logprobs_2025,
 abstract = {Generative AI (GenAI) has shown great potential in assisting people with disabilities in their daily lives. However, the current research on GenAI-assisted daily living support for people with disabilities is still in its early stages. To better understand the current state of research and identify future research directions, we conducted a systematic literature review of 35 papers published between 2018 and 2024. We analyzed the types of disabilities addressed, the daily living tasks supported, the GenAI technologies used, and the evaluation methods employed. Our findings reveal that most studies focus on supporting people with visual and cognitive disabilities in tasks such as navigation and communication. Large language models and diffusion models are the most commonly used GenAI technologies. However, there is a lack of research on supporting people with physical and hearing disabilities, and the evaluation methods are often limited to qualitative feedback. We discuss the implications of these findings and propose future research directions to advance GenAI-assisted daily living support for people with disabilities.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Xu},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3696630.3731433},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {1242 -- 1243},
 title = {Logprobs {Know}},
 url = {https://doi.org/10.1145/3696630.3731433},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:36:26Z},
 year = {2025}
}

@article{xu_mantra_2025,
 abstract = {The rapid advancement of large language models (LLMs) has revolutionized various domains, yet their application in mathematical reasoning remains a significant challenge. Recent works have shown that fine-tuning LLMs on datasets of math problems can substantially improve their reasoning capabilities. However, these approaches often require large-scale datasets and extensive computational resources. In this paper, we propose a novel framework, MathChain, which leverages chain-of-thought (CoT) prompting and self-consistency to enhance the mathematical reasoning abilities of LLMs without the need for fine-tuning. MathChain decomposes complex math problems into intermediate reasoning steps and employs a voting mechanism to select the most consistent solution path. We evaluate MathChain on several benchmarks, including GSM8K and MATH, demonstrating that it achieves competitive performance compared to fine-tuned models while being more efficient and generalizable. Our findings suggest that structured prompting techniques can bridge the gap between general-purpose LLMs and specialized mathematical reasoning, paving the way for more accessible AI-driven math solvers.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Xu},
 journal = {arXiv preprint arXiv:2503.14340},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Mantra: {Enhancing}},
 url = {https://arxiv.org/abs/2503.14340},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:54:15Z},
 year = {2025}
}

@inproceedings{xu_muarf_2025,
 abstract = {Large language models (LLMs) have revolutionized code generation, enabling developers to produce code snippets, functions, and even entire applications with remarkable speed and efficiency. However, the integration of AI-generated code into software development pipelines introduces significant risks, including security vulnerabilities, intellectual property concerns, and ethical dilemmas. This paper provides a comprehensive survey of the risks associated with AI-generated code and examines existing mitigation strategies. We categorize risks into technical (e.g., bugs and biases), legal (e.g., copyright infringement), and societal (e.g., over-reliance on AI) dimensions. For each category, we review state-of-the-art approaches, such as code review tools, watermarking techniques, and human-AI collaboration frameworks. Our analysis highlights gaps in current practices and proposes directions for future research to foster responsible AI-assisted software engineering.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {Ottawa},
 author = {Xu},
 booktitle = {Proceedings of the {IEEE}},
 doi = {10.1109/ICSE-Companion66252.2025.00071},
 isbn = {979-8-3315-3683-1},
 keywords = {code refactoring},
 pages = {226--227},
 publisher = {IEEE Press},
 series = {{ICSE}},
 title = {{MUARF}},
 url = {https://doi.org/10.1109/icse-companion66252.2025.00071},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:34:23Z},
 year = {2025}
}

@article{xu_muralagent_2025,
 abstract = {In the context of the digital age, utilizing cutting-edge technology for the digitization and creative expansion of ancient murals is crucial, aimed at preserving and passing on cultural heritage. Existing image outpainting techniques suffer from a lack of semantic guidance. This article introduces MuralAgent, a multimodal model based on Retrieval-Augmented Generation (RAG) technology. It precisely extracts key information from mural images and integrates it with a constructed ancient texts knowledge base to ensure the cultural and semantic consistency of the expanded images. Moreover, fine-tuning the Stable Diffusion model ensures the fidelity of the generated image styles. Specifically, this study involves constructing an ancient texts knowledge base for accurate matching, designing specific prompts for GPT-4V(ision) to extract key information, and innovatively expanding artworks through Stable Diffusion, providing a novel way for the public to reinterpret ancient murals.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Xu},
