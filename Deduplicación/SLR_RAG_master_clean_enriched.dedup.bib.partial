 x_enrich_ts = {2025-11-02T07:17:51Z},
 year = {2024}
}

@inproceedings{bustamante_raccoon_2025,
 abstract = {This paper introduces a novel framework for multi-robot coordination in uncertain environments, leveraging distributed reinforcement learning and graph neural networks. Our approach enables robots to adaptively form coalitions for task allocation while minimizing communication overhead. Through extensive simulations and real-world experiments on a fleet of mobile robots, we demonstrate significant improvements in efficiency and robustness over state-of-the-art methods, achieving up to 30% reduction in completion time under partial observability.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
