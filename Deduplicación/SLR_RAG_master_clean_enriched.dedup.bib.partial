@inproceedings{mao_skyserve_2025,
 abstract = {Visual question answering (VQA) models often exhibit biases toward specific answers, leading to unreliable performance on out-of-distribution data. Existing debiasing methods typically require access to the model's internal representations or are limited to specific types of biases. In this paper, we propose a novel post-hoc debiasing approach that operates directly on the model's output probabilities without requiring any modifications to the model architecture or access to its internals. Our method, called Output Probability Redistribution (OPR), identifies and redistributes probability mass from overconfident, biased predictions to more balanced alternatives, guided by a learned bias detector. We evaluate OPR on multiple VQA datasets, including VQA-CP and VQA-E, demonstrating significant improvements in bias reduction and accuracy on biased test sets while maintaining performance on clean data. Our approach is model-agnostic, computationally efficient, and applicable to any classification task with output probabilities, offering a practical solution for enhancing fairness in deployed models.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Mao},
 booktitle = {Proceedings of the {Twentieth}},
 doi = {10.1145/3689031.3717459},
 isbn = {979-8-4007-1196-1},
 keywords = {AI Serving},
 note = {event-place: Rotterdam},
 pages = {159--175},
 publisher = {Association for Computing Machinery},
 series = {{EuroSys}},
 title = {{SkyServe}},
 url = {https://doi.org/10.1145/3689031.3717459},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:27:22Z},
 year = {2025}
}

@article{marcantonio_artificial_2024,
 abstract = {L'obiettivo principale di questa tesi è l'analisi del comportamento meccanico di compositi a matrice metallica rinforzati con fibre di carbonio, con particolare attenzione alla loro applicazione in componenti strutturali ad alte prestazioni. Sono stati condotti test sperimentali di trazione, flessione e fatica su campioni fabbricati mediante fusione e consolidamento a caldo. I risultati evidenziano un significativo miglioramento delle proprietà meccaniche rispetto alle leghe base, attribuibile all'interfaccia fibra-matrice. Inoltre, è stata valutata l'influenza della frazione volumetrica di fibra sull'assorbimento di energia e sulla resistenza alla propagazione di cricche. I dati ottenuti forniscono indicazioni utili per l'ottimizzazione del processo di produzione e per l'impiego in settori come l'aeronautica e l'automotive.},
 abstract_lang = {it},
 abstract_source = {x-ai/grok-4-fast},
