@article{wahidur_legal_2025-1,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices while keeping data localized, addressing privacy concerns in IoT ecosystems. However, resource-constrained IoT devices face challenges like limited computation, communication overhead, and heterogeneity. This paper proposes a lightweight FL framework, FedIoT, that integrates model compression, adaptive aggregation, and efficient communication protocols to optimize performance on edge devices. We evaluate FedIoT on real-world IoT datasets, demonstrating significant reductions in energy consumption and latency compared to baseline FL methods, while maintaining model accuracy. Our approach paves the way for scalable FL deployment in smart IoT applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
