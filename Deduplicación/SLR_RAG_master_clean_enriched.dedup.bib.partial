@inproceedings{kamran_vision_2024,
 abstract = {We present a novel framework for generating diverse and controllable 3D-aware images using a single 2D diffusion model. Our approach, dubbed 3D-Aware Diffusion, enables the synthesis of high-fidelity, multi-view consistent images without requiring 3D supervision or multi-view datasets. By leveraging the latent space of a pre-trained 2D diffusion model and introducing a lightweight 3D-aware module, we enforce geometric consistency across views during the generation process. This module consists of a neural radiance field (NeRF)-inspired conditioner that predicts view-dependent features, integrated seamlessly into the denoising pipeline. To enhance controllability, we incorporate text prompts and camera poses as conditioning inputs, allowing users to guide the generation of specific scenes from desired viewpoints. Extensive experiments demonstrate that our method outperforms existing 3D-aware generation techniques in terms of visual quality, view consistency, and diversity, while maintaining efficiency suitable for real-time applications. Our work bridges the gap between 2D generative models and 3D content creation, paving the way for accessible 3D asset generation in creative industries.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
