 pages = {76--80},
 publisher = {Association for Computing Machinery},
 series = {{CMNM}},
 title = {A {Comparative}},
 url = {https://doi.org/10.1145/3677779.3677791},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:24:33Z},
 year = {2024}
}

@article{xiao_eda-copilot_2025,
 abstract = {With the rise of Large Language Models (LLMs), researchers have become increasingly interested in their applications in EDA flows, particularly in specific subdomains such as serving as knowledge assistants and generating RTL code. In this study, we present a Retrieval-Augmented Generation (RAG) framework tailored to EDA task processing, named EDA-Adaptive RAG. This framework addresses the implicit semantics of EDA data and facilitates efficient knowledge acquisition through classification and enhanced retrieval, significantly enhancing LLMs ability to acquire EDA knowledge. Furthermore, we aim to integrate RAG into the design process as an EDA assistant application. Using RTL code generation as a case study, we demonstrate that the performance of RTL code generation can be enhanced through highly relevant retrievals provided by our RAG. The experimental analysis involves EDA Q&A tasks and RTL code generation evaluation. It is shown that our method outperforms the latest works in terms of both answer stability and code quality.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Xiao},
 doi = {10.1145/3715326},
 issn = {1084-4309},
 journal = {ACM Trans. Des. Autom. Electron. Syst.},
 keywords = {electronic design automation},
 month = {oct},
 note = {Place: New York},
 number = {6},
 title = {{EDA}},
 url = {https://doi.org/10.1145/3715326},
 volume = {30},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:40:43Z},
 year = {2025}
}

@article{xiao_krail_2024,
 abstract = {Large language models (LLMs) have shown remarkable generalization capabilities, but their application to robotics remains limited. We hypothesize that the key to unlocking LLM potential in robotics lies in developing generalist robot policies that can handle diverse tasks across varied environments. To this end, we introduce RoboBrain, a new benchmark for evaluating generalist robot policies on a wide range of manipulation and navigation tasks in simulated and real-world settings. We then present RT-3, a vision-language-action (VLA) model that leverages a large-scale dataset of robot interactions to learn generalist policies. RT-3 demonstrates strong zero-shot generalization to unseen tasks and environments, outperforming prior methods by a significant margin. Our results highlight the importance of scale, data diversity, and architectural innovations in building effective generalist robot policies, paving the way for more capable and versatile robotic systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Xiao},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
