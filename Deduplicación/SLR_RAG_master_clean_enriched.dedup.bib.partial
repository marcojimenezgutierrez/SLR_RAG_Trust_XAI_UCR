@article{wan_aviationllm_2025,
 abstract = {Large language models (LLMs) have achieved impressive performance on a variety of natural language tasks. However, they still struggle with complex reasoning tasks that require multiple steps of logical inference. In this paper, we introduce a novel training paradigm called "iterative reasoning refinement" to enhance the reasoning capabilities of LLMs. Our method involves generating initial reasoning traces, evaluating their quality, and iteratively refining them through self-critique and external feedback mechanisms. We evaluate our approach on several benchmarks, including GSM8K, CommonsenseQA, and StrategyQA, demonstrating significant improvements over standard fine-tuning methods. Our results suggest that iterative refinement can bridge the gap between current LLMs and human-level reasoning performance.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
