 keywords = {automotive design},
 note = {event-place: Melbourne VIC},
 pages = {11125--11126},
 publisher = {Association for Computing Machinery},
 series = {{MM}},
 title = {An {Innovative}},
 url = {https://doi.org/10.1145/3664647.3689702},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:29:17Z},
 year = {2024}
}

@article{liu_judge_2025,
 abstract = {Achieving generalist robot policies that can perform diverse tasks across different embodiments and environments remains a grand challenge in robotics. While large language models (LLMs) have demonstrated remarkable generalization capabilities in language tasks, their application to physical robot control is limited by the need for precise, low-level actions and the handling of noisy, high-dimensional sensor data. In this work, we explore the potential of vision-language models (VLMs) as a foundation for generalist robot policies through in-context reinforcement learning. We introduce a novel framework, Robot Synesthesia, which enables zero-shot transfer of manipulation skills by conditioning VLMs on sequences of proprioceptive states and egocentric images. This approach allows the model to reason about actions in a multimodal context, making it robust to variations in embodiment and task specifics. We evaluate our method on a suite of simulated and real-world manipulation tasks, including bimanual dexterous manipulation and multi-object rearrangement. Our results show that Robot Synesthesia outperforms traditional reinforcement learning baselines and LLM-based controllers in zero-shot settings, achieving up to 2.5x improvement in success rates. These findings suggest that VLMs, when integrated with appropriate conditioning mechanisms, can serve as versatile priors for developing adaptable, generalist robotic systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Liu},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Judge as a judge: {Improving}},
 url = {https://arxiv.org/abs/2502.18817},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:26:29Z},
 year = {2025}
}

@inproceedings{liu_leveraging_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their inner workings remain opaque. To better understand LLMs, researchers often conduct experiments to test hypotheses about their behavior. However, designing and running these experiments can be time-consuming and error-prone. We introduce ChainForge, a visual toolkit for conducting LLM experiments. ChainForge allows users to create complex prompt chains, run experiments across multiple LLMs, and visualize the results. We describe the design and implementation of ChainForge, and present case studies of its use in LLM research. Our results show that ChainForge can significantly reduce the time and effort required to conduct LLM experiments, and enable new types of experiments that would be difficult or impossible with existing tools.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Liu},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3696410.3714554},
