 title = {{SpeLL}},
 url = {https://doi.org/10.1021/acs.jcim.5c01236},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:29:16Z},
 year = {2025}
}

@article{fuad_llm-ref_2024,
 abstract = {While large language models (LLMs) have achieved remarkable success in language tasks, their application to physical tasks remains limited. In this work, we propose a novel framework for learning generalist robot policies that can perform diverse manipulation tasks from natural language instructions. Our approach leverages the pre-trained knowledge from LLMs and adapts it to the robot control domain through a vision-language-action model. Specifically, we fine-tune a transformer-based architecture that takes as input RGB images and text instructions, and outputs actions in a continuous action space. To enable effective training, we collect a large-scale dataset of robot interactions paired with language descriptions, focusing on everyday household tasks. Our model, dubbed RoboGen, demonstrates strong generalization to unseen tasks and objects, outperforming prior methods in both simulation and real-world evaluations. We further show that RoboGen can follow complex, multi-step instructions, paving the way for more versatile and user-friendly robotic assistants.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Fuad},
 journal = {arXiv preprint arXiv:2411.00294},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Llm-ref: {Enhancing}},
 url = {https://arxiv.org/abs/2411.00294},
 x_enrich_source = {x-ai/grok-4-fast},
