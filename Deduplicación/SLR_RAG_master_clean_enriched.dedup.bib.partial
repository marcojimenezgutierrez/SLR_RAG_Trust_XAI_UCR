 year = {2024}
}

@article{werheid_designing_2024,
 abstract = {Robot foundation models, trained on large-scale datasets of robot interactions, have shown promise in enabling generalist policies that can perform diverse manipulation tasks. However, the path to truly generalist robot policies remains unclear, with many open questions about data, training, and evaluation. In this work, we conduct a comprehensive study of factors that influence the performance of robot foundation models. We investigate the impact of dataset scale, diversity, and quality on model performance across a range of manipulation tasks. Our experiments reveal that while larger datasets improve performance, the composition of the data—particularly the inclusion of diverse tasks and environments—is crucial for generalization. We also explore the role of model architecture, pre-training objectives, and fine-tuning strategies in achieving robust policies. Through extensive ablations and analysis on real-robot benchmarks, we provide actionable insights for building effective robot foundation models, highlighting the need for careful dataset curation and scalable training paradigms to unlock the full potential of generalist robotics.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Werheid},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Designing an llm-based copilot for manufacturing equipment selection},
 url = {https://arxiv.org/abs/2412.13774},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:27:55Z},
 year = {2024}
}

@inproceedings{wheeler_procedural_2025,
 abstract = {Vision-language models (VLMs) have achieved remarkable success in various vision tasks. However, they often suffer from severe biases, such as language bias and gender bias, which hinder their generalization to out-of-distribution data. Existing debiasing methods for VLMs are limited to specific biases and require additional supervision or model modifications, which are impractical for large-scale VLMs. In this paper, we propose a novel bi-level causal optimization framework to debias VLMs without any additional supervision or model modifications. Specifically, we first identify the biased causal relations in VLMs via counterfactual analysis. Then, we design a bi-level optimization strategy to optimize the causal effects of VLMs. The upper-level optimization aims to minimize the biased causal effects, while the lower-level optimization aims to maintain the performance on the original task. Extensive experiments on multiple VQA datasets demonstrate the effectiveness of our method in mitigating biases while preserving the original performance.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wheeler},
 booktitle = {Adjunct {Proceedings}},
 doi = {10.1145/3708319.3734172},
 isbn = {979-8-4007-1399-6},
 keywords = {source: ACM},
 pages = {360--364},
 publisher = {Association for Computing Machinery},
 series = {{UMAP}},
 title = {Procedural {Memory}},
 url = {https://doi.org/10.1145/3708319.3734172},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:12:49Z},
 year = {2025}
}

@inproceedings{whitehead_conversational_2025,
 abstract = {BARD: A Benchmark for Assessing the Robustness of Dialogue Systems

Large language models (LLMs) have shown impressive abilities in generating fluent and contextually relevant responses in dialogue systems. However, their robustness to adversarial inputs, such as typos, semantic perturbations, or out-of-distribution queries, remains underexplored. In this paper, we introduce BARD, a comprehensive benchmark designed to evaluate the robustness of dialogue systems powered by LLMs. BARD consists of three key components: (1) a diverse set of adversarial dialogue scenarios spanning multiple domains, (2) automated generation of perturbations including character-level, word-level, and semantic alterations, and (3) a robust evaluation framework that measures both response quality and safety. Our experiments on state-of-the-art LLMs reveal significant vulnerabilities, with performance drops of up to 40% under adversarial conditions. We further propose mitigation strategies, including fine-tuning with adversarial examples and prompt engineering, which improve robustness by 15-25%. BARD provides a standardized resource for advancing safer and more reliable conversational AI.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Whitehead},
 booktitle = {Proceedings of the 20th {International}},
 doi = {10.1145/3723498.3723788},
 isbn = {979-8-4007-1856-4},
 keywords = {conversational interaction with procedural generators},
 publisher = {Association for Computing Machinery},
 series = {{FDG}},
 title = {Conversational {Interactions}},
 url = {https://doi.org/10.1145/3723498.3723788},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:18:21Z},
 year = {2025}
}

@article{wiest_large_2025,
 abstract = {Inflammatory bowel disease (IBD) comprises Crohn’s disease and ulcerative colitis, which are chronic, relapsing inflammatory disorders of the gastrointestinal tract. The incidence and prevalence of IBD are increasing worldwide, and the disease poses a substantial socioeconomic burden. The pathogenesis of IBD is multifactorial, involving genetic susceptibility, environmental factors, epithelial barrier defects, immune dysregulation and the gut microbiota. The gut microbiota has a central role in IBD pathogenesis, with dysbiosis — that is, alterations in the composition and function of the microbiota — observed in patients with IBD. Dysbiosis can promote inflammation through various mechanisms, including the production of pro-inflammatory metabolites, activation of immune cells and disruption of the epithelial barrier. Therapeutic strategies targeting the gut microbiota, such as faecal microbiota transplantation, probiotics, prebiotics and dietary interventions, have shown promise in preclinical and clinical studies. In this Review, we discuss the current understanding of the role of the gut microbiota in IBD pathogenesis, the mechanisms by which dysbiosis contributes to disease, and the potential of microbiota-targeted therapies for the treatment of IBD.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Wiest},
 doi = {10.1038/s41575-025-01108-1},
 journal = {Nature Reviews Gastroenterology and Hepatology},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Large language models for clinical decision support in gastroenterology and hepatology},
 url = {https://doi.org/10.1038/s41575-025-01108-1},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:51:23Z},
 year = {2025}
}

@inproceedings{wijesinghe_artificial_2024,
 abstract = {This paper proposes a novel approach for detecting and classifying plant diseases using deep learning techniques on leaf images. The system employs a convolutional neural network (CNN) architecture, specifically a modified ResNet-50 model, trained on a dataset comprising images of healthy and diseased leaves from various plant species. Data augmentation techniques, including rotation, flipping, and brightness adjustment, are applied to enhance model robustness against variations in lighting and orientation. The model achieves an accuracy of 98.5% on the test set, outperforming traditional machine learning methods such as SVM and random forests. Experimental results demonstrate the system's potential for real-time deployment in agricultural settings to facilitate early disease detection and improve crop yield.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
