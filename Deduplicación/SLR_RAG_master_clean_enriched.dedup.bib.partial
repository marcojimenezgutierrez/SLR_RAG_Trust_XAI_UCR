 x_enrich_ts = {2025-11-02T08:16:25Z},
 year = {2025}
}

@inproceedings{panday_puaa_2024,
 abstract = {Abstract—Internet of Things (IoT) devices are increasingly integrated into smart city infrastructures, raising significant security concerns due to their resource constraints and vulnerability to cyber-attacks. This paper proposes a lightweight blockchain-based authentication framework for securing IoT communications in smart cities. The framework leverages a consortium blockchain to enable decentralized identity management and mutual authentication between devices, reducing computational overhead while ensuring data integrity and confidentiality. We introduce an optimized consensus mechanism using practical Byzantine fault tolerance (PBFT) adapted for resource-limited environments. Experimental evaluations on a simulated smart city testbed demonstrate that our approach achieves 95% authentication success rate with 40% lower latency compared to traditional centralized methods, making it suitable for real-time IoT applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
