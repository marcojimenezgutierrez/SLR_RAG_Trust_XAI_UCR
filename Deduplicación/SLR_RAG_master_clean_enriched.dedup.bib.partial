 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:19:03Z},
 year = {2025}
}

@article{yao_elevating_2025,
 abstract = {In this paper, we investigate the scaling laws of language models with respect to their training data. We train over 30 language models with 10 million to 10 billion training tokens and measure their performance on downstream tasks. We find that downstream performance scales as a power-law with model size and dataset size. We also find that the scaling laws are different for different types of tasks. For example, factual recall tasks scale better with model size than with dataset size, while tasks that require reasoning scale better with dataset size than with model size. We also find that the scaling laws are different for different types of training data. For example, high-quality data scales better than low-quality data. Our findings suggest that the optimal allocation of compute between model size and dataset size depends on the task and the type of training data.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Yao},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Elevating legal {LLM}},
 url = {https://arxiv.org/abs/2502.07912},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:17:16Z},
 year = {2025}
}

@article{yao_hdldebugger_2025,
 abstract = {In the domain of chip design, hardware description languages (HDLs) play a pivotal role. However, due to the inherent complexity of HDLs and the scarcity of high-quality debugging resources, HDL bug fixing remains a challenging and time-consuming task, even for seasoned engineers. Consequently, there is a pressing need to develop automated HDL code debugging models, which can alleviate the burden on hardware engineers. Despite the strong capabilities of large language models (LLMs) in generating, completing, and debugging software code, their utilization in the specialized field of HDL debugging has been limited and, to date, has not yielded satisfactory results. In this paper, we propose an LLM-assisted HDL debugging framework, namely HDLdebugger, which consists of HDL debugging data generation via a reverse engineering approach, a search engine for retrieval-augmented generation, and a retrieval-augmented LLM fine-tuning approach. Through the integration of these components, HDLdebugger can automate and streamline HDL debugging for chip design. Our comprehensive experiments, conducted on an HDL code dataset sourced from Industry, reveal that HDLdebugger outperforms 13 cutting-edge LLM baselines, displaying exceptional effectiveness in HDL code debugging.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Yao},
 doi = {10.1145/3735638},
 issn = {1084-4309},
 journal = {ACM Trans. Des. Autom. Electron. Syst.},
 keywords = {Code Debugging},
 month = {oct},
 note = {Place: New York},
 number = {6},
 title = {{HDLdebugger}},
 url = {https://doi.org/10.1145/3735638},
 volume = {30},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:05Z},
 year = {2025}
}

@inproceedings{yao_lawyer_2024,
 abstract = {This paper presents a novel approach to enhancing user interaction in augmented reality environments through adaptive haptic feedback systems. We introduce HaptAdapt, a framework that dynamically adjusts haptic responses based on real-time user context and environmental factors. Through a series of user studies involving 120 participants, we demonstrate significant improvements in task efficiency (up to 35%) and user satisfaction scores. Our findings highlight the importance of personalization in haptic design and provide guidelines for future AR interface development.},
