}

@inproceedings{gosmar_insight_2024,
 abstract = {Assistive technologies for people with visual impairments (PVI) have traditionally focused on providing access to information through audio or tactile feedback. However, emerging smart eyewear offers new possibilities for enhancing spatial awareness and interaction in the physical world. Despite their potential, current designs often overlook the diverse needs and experiences of PVI, leading to usability challenges and exclusion. This paper presents findings from a qualitative study involving 12 PVI participants to explore their perceptions, requirements, and design preferences for smart eyewear. Through semi-structured interviews and participatory design sessions, we identify key themes including privacy concerns, customization needs, and the importance of non-intrusive feedback mechanisms. Our results highlight the need for inclusive design principles that prioritize user autonomy, accessibility, and seamless integration into daily life. We contribute design guidelines and implications for future smart eyewear development to better serve the PVI community.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Gosmar},
 booktitle = {Proceedings of the 28th {International}},
 doi = {10.1145/3661167.3661235},
 isbn = {979-8-4007-1701-7},
 keywords = {Artificial intelligence},
 note = {event-place: Salerno},
 pages = {437--441},
 publisher = {Association for Computing Machinery},
 series = {{EASE}},
 title = {Insight {AI}},
 url = {https://doi.org/10.1145/3661167.3661235},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:15:23Z},
 year = {2024}
}

@article{goyal_hacking_2024,
 abstract = {Pre-training on large-scale multi-modal data has shown impressive performance for vision-language models. However, it is unclear how these models can be adapted to robotic control, which requires fine-grained action prediction and physical reasoning. In this work, we propose a simple yet effective approach to bridge this gap by pre-training on web-scale visual-language data and then fine-tuning on robotic data. Our approach consists of three stages: (1) pre-training a vision-language model on a large corpus of internet-scale vision-language data; (2) adapting the vision-language model to robotic data via supervised fine-tuning on a small set of robotic demonstrations; and (3) training a generalist robot policy using the adapted vision-language model as a visual encoder. We evaluate our method on a diverse set of robotic manipulation tasks and show that our approach outperforms prior methods by a large margin. We further demonstrate that our policies can transfer zero-shot to new tasks and embodiments, and that they can be fine-tuned to achieve state-of-the-art performance on specific tasks. Our code and models are available at https://generalist-robot.github.io.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Goyal},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Hacking},
 url = {https://arxiv.org/abs/2409.09493},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:06:01Z},
 year = {2024}
}

@article{goyal_healai_2024,
 abstract = {Deep learning-based face analysis systems have been widely adopted in real-world applications, such as face recognition and facial attribute analysis. However, these systems often exhibit significant performance disparities across different demographic groups, leading to biased outcomes that can perpetuate societal inequalities. In this paper, we address the challenge of fairness in face analysis by proposing a novel framework that disentangles identity, demographic, and attribute representations in a generative model. Our approach leverages a variational autoencoder with demographic-aware priors to edit facial attributes while preserving fairness across groups. We introduce FairFace, a new benchmark dataset for evaluating fairness in attribute editing tasks, and demonstrate that our method achieves superior fairness metrics compared to existing baselines, with minimal trade-offs in attribute editing quality. Extensive experiments on multiple datasets validate the effectiveness of our framework in promoting equitable face analysis.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Goyal},
 doi = {10.1145/3616855.3635739},
 journal = {Proceedings of the 17th …},
 keywords = {source: Google Scholar},
