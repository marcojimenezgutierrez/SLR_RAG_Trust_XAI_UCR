@article{wang_nas-based_2025,
 abstract = {The rapid proliferation of Internet of Things (IoT) devices has led to an exponential increase in data generation, necessitating efficient and secure data management solutions. Traditional centralized systems face challenges such as scalability, privacy concerns, and vulnerability to single points of failure. In this paper, we propose a novel blockchain-based framework for secure and decentralized data sharing in IoT ecosystems. Our approach leverages smart contracts for automated access control and integrates lightweight consensus mechanisms to ensure low-latency transactions suitable for resource-constrained devices. We introduce a hybrid encryption scheme combining attribute-based encryption with homomorphic properties to enable privacy-preserving computations on shared data. Extensive simulations and real-world deployments on Raspberry Pi-based IoT networks demonstrate that our framework achieves up to 40% improvement in transaction throughput and reduces latency by 25% compared to existing solutions, while maintaining robust security against common attacks like replay and man-in-the-middle. This work paves the way for scalable, trustworthy IoT data ecosystems in smart cities and healthcare applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Wang},
