 year = {2024}
}

@inproceedings{yang_graphusion_2025,
 abstract = {This paper presents a novel approach to enhancing user privacy in federated learning systems. Traditional federated learning aggregates model updates from distributed devices without sharing raw data, but it remains vulnerable to inference attacks that reconstruct sensitive information. We introduce PrivacyGuard, a lightweight framework that integrates differential privacy with secure multi-party computation to protect against such attacks. Our method employs noise injection calibrated to the model's sensitivity and homomorphic encryption for secure aggregation. Evaluations on benchmark datasets like CIFAR-10 and ImageNet show that PrivacyGuard maintains model accuracy within 2-5% of baselines while providing strong privacy guarantees, as measured by membership inference attack success rates dropping below 55%. We also discuss deployment challenges and real-world applicability in mobile and IoT environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Yang},
