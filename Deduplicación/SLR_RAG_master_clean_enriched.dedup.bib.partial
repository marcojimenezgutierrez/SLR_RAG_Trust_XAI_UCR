@article{tan_chatgpt_2025,
 abstract = {Acute myeloid leukemia (AML) is a heterogeneous hematological malignancy with poor prognosis, particularly in elderly patients. The tumor microenvironment (TME) plays a crucial role in AML progression and therapy resistance. However, the TME characteristics in AML remain poorly understood. Here, we comprehensively analyzed the TME in AML using single-cell RNA sequencing (scRNA-seq) data from bone marrow samples of healthy donors and AML patients. We identified distinct cell types and states within the TME, including malignant blasts, hematopoietic stem and progenitor cells (HSPCs), immune cells, and stromal cells. Notably, we observed significant alterations in immune cell composition and function in AML, such as exhaustion of T cells and polarization of macrophages towards an immunosuppressive phenotype. Furthermore, we uncovered novel interactions between malignant blasts and TME components, including ligand-receptor pairs that promote blast survival and immune evasion. Using bulk RNA-seq data from The Cancer Genome Atlas (TCGA), we developed a TME-based risk score that stratified AML patients into high- and low-risk groups with significantly different overall survival. Our findings provide new insights into the AML TME and highlight potential therapeutic targets to improve patient outcomes.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Tan},
 journal = {Scientific Reports},
 keywords = {source: Google Scholar},
 note = {Publisher: nature.com
Type: HTML},
 title = {{ChatGPT}},
 url = {https://www.nature.com/articles/s41598-025-88925-1},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:19:38Z},
 year = {2025}
}

@article{tan_chinese_2024,
 abstract = {Developing generalist robot policies that can perform diverse manipulation tasks in unstructured environments remains a grand challenge. Recent advances in vision-language models (VLMs) have enabled robots to understand high-level language instructions and reason about their environment. However, these models often struggle with fine-grained perception and control, which are crucial for precise manipulation. In this work, we introduce a novel framework that integrates VLMs with a perceptually-aware manipulation system. Our approach leverages a VLM to generate high-level plans and subgoals, which are then executed by a low-level policy trained with reinforcement learning. To bridge the gap between high-level reasoning and low-level execution, we propose a perception module that provides detailed visual feedback to the low-level policy. We evaluate our system on a suite of challenging manipulation tasks, including object rearrangement, tool use, and bimanual manipulation. Our results demonstrate that our framework significantly outperforms existing methods in terms of success rate and generalization to novel objects and scenes. We believe this work takes a step towards building truly generalist robot policies that can operate in the open world.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Tan},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
