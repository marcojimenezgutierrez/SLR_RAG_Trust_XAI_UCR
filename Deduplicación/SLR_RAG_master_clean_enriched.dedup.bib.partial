@inproceedings{awadid_ritsa_2025,
 abstract = {Blockchain technology has emerged as a promising solution for enhancing security and transparency in various domains, including supply chain management. However, traditional blockchain systems face challenges such as scalability, privacy concerns, and vulnerability to certain attacks. This paper proposes a novel hybrid blockchain framework that integrates consortium blockchain with sidechain technology to address these issues in supply chain management. The proposed framework employs smart contracts for automated processes and incorporates advanced cryptographic techniques, including zero-knowledge proofs, to ensure data privacy and integrity. Additionally, a consensus mechanism based on Practical Byzantine Fault Tolerance (PBFT) is adapted for improved efficiency. Simulation results demonstrate that the framework achieves higher throughput, lower latency, and enhanced security compared to existing solutions, making it suitable for real-world supply chain applications.},
 abstract_lang = {en},
