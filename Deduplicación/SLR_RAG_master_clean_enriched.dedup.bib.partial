@article{gajjar_oran-bench-13k_2025,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for training machine learning models in a distributed manner while preserving data privacy. However, the deployment of FL on resource-constrained Internet of Things (IoT) devices poses significant challenges due to their limited computational, communication, and energy resources. This survey provides a comprehensive overview of FL techniques tailored for resource-constrained IoT devices. We first introduce the fundamentals of FL and discuss the unique constraints of IoT environments. Then, we categorize and analyze existing approaches to address these challenges, including model compression, communication-efficient algorithms, energy-aware scheduling, and heterogeneous device handling. We also highlight key applications of FL in IoT domains such as smart healthcare, industrial IoT, and edge computing. Finally, we discuss open research challenges and future directions to advance FL for sustainable and scalable IoT deployments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Gajjar},
 journal = {2025 IEEE 22nd Consumer …},
