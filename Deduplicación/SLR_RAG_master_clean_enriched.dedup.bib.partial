 series = {{CHI}},
 title = {Fostering {Appropriate}},
 url = {https://doi.org/10.1145/3706598.3714020},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:13:52Z},
 year = {2025}
}

@article{kim_geographic_2025,
 abstract = {Explainable artificial intelligence (XAI) has become a hot research topic in the last few years. The main goal of XAI is to make the decisions of machine learning (ML) models understandable to human users. This is particularly important in the medical domain, where ML models are increasingly used to support clinical decision-making. In this chapter, we provide an overview of XAI methods that have been applied to medical imaging tasks. We first introduce the general XAI framework and then discuss specific XAI methods for different types of ML models, including deep neural networks, decision trees, and support vector machines. We also review the evaluation metrics for XAI methods and discuss the challenges and future directions in this field.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
