@inproceedings{zheng_incorporating_2025,
 abstract = {This paper proposes a novel framework for enhancing cybersecurity in edge computing environments through the integration of blockchain technology and machine learning algorithms. We address key challenges such as data privacy, scalability, and real-time threat detection by developing a decentralized consensus mechanism that ensures secure data sharing among edge devices. Experimental results demonstrate a 35% improvement in detection accuracy and a 50% reduction in latency compared to traditional centralized systems. The framework is evaluated on a simulated IoT network, showing robustness against common attacks like DDoS and man-in-the-middle. Future work includes real-world deployment and optimization for resource-constrained devices.},
