@inproceedings{orlando_can_2025,
 abstract = {Large language models (LLMs) have shown impressive capabilities in generating code from natural language descriptions. However, their generated code often contains subtle bugs that are hard to detect, especially for novice programmers. In this paper, we investigate the effectiveness of LLM-generated code in educational settings, where students use it as a learning tool. Through a study with 100 undergraduate students, we compare learning outcomes when using LLM-generated code versus human-written code. Our results show that while LLM code accelerates initial task completion, it leads to poorer long-term understanding and higher error rates in follow-up tasks. We discuss implications for integrating LLMs into programming education and propose guidelines for educators.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
