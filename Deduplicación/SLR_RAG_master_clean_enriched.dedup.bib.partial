@inproceedings{haldar_rubra_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly impacted various sectors, including cybersecurity. This paper explores the integration of AI-driven machine learning algorithms in enhancing intrusion detection systems (IDS) for industrial control systems (ICS). We propose a hybrid model combining convolutional neural networks (CNN) and long short-term memory (LSTM) networks to detect anomalous behaviors in real-time ICS environments. The model is evaluated using the Mississippi State University dataset, achieving a detection accuracy of 98.5% and a false positive rate of 1.2%. Our approach demonstrates superior performance compared to traditional signature-based and anomaly-based IDS methods, particularly in handling zero-day attacks. The results underscore the potential of AI in fortifying ICS security against evolving cyber threats.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
