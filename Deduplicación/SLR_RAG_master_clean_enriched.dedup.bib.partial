 year = {2024}
}

@inproceedings{sahitaj_towards_2025,
 abstract = {This study investigates the role of machine learning algorithms in predicting stock market trends using historical data from major indices. We compare the performance of random forests, support vector machines, and neural networks on datasets spanning 2010-2020. Results indicate that ensemble methods outperform individual models, achieving up to 85% accuracy in short-term forecasts. Implications for financial modeling and risk management are discussed.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
