 note = {Publisher: arxiv.org},
 title = {Real-{Time}},
 url = {https://arxiv.org/abs/2503.21157},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:37:13Z},
 year = {2025}
}

@inproceedings{sarmah_hybridrag_2024,
 abstract = {Haptic feedback is a promising modality for wearable devices, but current designs often overlook the needs of users with upper-body mobility impairments. In this paper, we investigate how to design inclusive wearable haptics for this population through a multi-method approach. We first conducted a needs assessment with 12 participants with upper-body mobility impairments to understand their preferences and challenges. Based on these insights, we developed and evaluated three prototype haptic armbands using linear resonant actuators (LRAs). Our user study with 15 participants revealed key design considerations, including placement flexibility, intensity modulation, and multi-site stimulation to accommodate varying motor abilities. Findings indicate that adaptive haptic patterns significantly improve perceived effectiveness and comfort, with 87% of participants preferring our inclusive design over standard ones. We discuss implications for future wearable haptic systems and provide design guidelines to enhance accessibility.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
