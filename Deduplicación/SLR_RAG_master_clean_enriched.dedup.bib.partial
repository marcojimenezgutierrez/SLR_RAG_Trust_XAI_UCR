@inproceedings{yang_design_2025,
 abstract = {This paper presents a novel approach to enhancing the accessibility of conversational AI agents for users with visual impairments. We conducted a series of user studies involving 20 participants with varying degrees of visual impairment to identify key barriers in current systems, such as inadequate audio feedback and navigation challenges. Based on these findings, we developed an inclusive design framework that incorporates multimodal interactions, including voice, haptic, and gesture-based controls. Our prototype implementation demonstrates a 40% improvement in task completion rates compared to baseline agents. We discuss implications for future AI design and provide guidelines for developers to ensure equitable access.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
