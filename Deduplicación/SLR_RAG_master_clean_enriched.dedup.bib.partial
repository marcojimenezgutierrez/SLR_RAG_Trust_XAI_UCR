@inproceedings{s_leveraging_2024,
 abstract = {This paper proposes a novel approach to enhance the security of Internet of Things (IoT) devices by integrating blockchain technology with machine learning algorithms. We introduce a decentralized framework that utilizes smart contracts for secure data sharing and federated learning to train models without compromising user privacy. The proposed system is evaluated on a real-world IoT dataset, demonstrating significant improvements in threat detection accuracy (up to 92%) and reduced latency in response times compared to centralized alternatives. Our results highlight the potential of this hybrid model in addressing key challenges in IoT security, such as scalability and data integrity.},
