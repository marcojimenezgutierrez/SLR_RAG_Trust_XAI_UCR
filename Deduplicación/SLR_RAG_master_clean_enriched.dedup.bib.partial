 x_enrich_ts = {2025-11-02T07:18:55Z},
 year = {2024}
}

@article{salminen_using_2024,
 abstract = {Fairness in machine learning has gained increasing attention in recent years, with a particular focus on addressing biases in image recognition systems. However, existing fairness benchmarks primarily concentrate on facial attribute analysis, neglecting other important computer vision tasks such as object detection and semantic segmentation. In this paper, we introduce FairVis, a comprehensive benchmark for evaluating fairness in visual recognition tasks beyond facial attributes. FairVis encompasses a diverse set of datasets and tasks, enabling researchers to assess and mitigate biases in a broader range of applications. We evaluate state-of-the-art models on FairVis and reveal significant disparities across demographic groups. Furthermore, we propose novel mitigation techniques that achieve a better trade-off between fairness and performance. Our benchmark and findings provide valuable insights for developing fair and robust visual recognition systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
