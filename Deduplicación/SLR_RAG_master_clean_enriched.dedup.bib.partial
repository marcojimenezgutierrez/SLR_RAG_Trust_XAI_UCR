}

@inproceedings{wu_retrieval_2025,
 abstract = {Generative AI (GenAI) has shown great potential in assisting developers with various software engineering tasks. However, existing research has primarily focused on using GenAI to generate code snippets or entire programs, with limited exploration of its potential in facilitating the comprehension of complex codebases. In this paper, we investigate how GenAI can assist developers in understanding unfamiliar code through the generation of code explanations. Specifically, we propose a novel approach that leverages GenAI to produce structured explanations of code, including summaries, key concepts, and relationships between different parts of the code. We evaluate our approach through a user study involving 30 professional developers, who were tasked with comprehending and modifying a large, open-source codebase. Our results show that GenAI-generated explanations significantly improve developers' understanding of the code, reduce the time required to grasp key concepts, and enhance their ability to make informed modifications. Furthermore, we identify several challenges and opportunities for future research in this area, including the need for more accurate and context-aware explanation generation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wu},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3729958},
 isbn = {979-8-4007-1592-1},
 keywords = {dynamic graph modeling},
 note = {event-place: Padua},
 pages = {1434--1443},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Retrieval {Augmented}},
 url = {https://doi.org/10.1145/3726302.3729958},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:18:30Z},
 year = {2025}
}

@article{wu_thinking_2024,
 abstract = {The ability to generalize across diverse tasks and environments is a critical challenge for developing generalist robot policies. In this work, we systematically investigate key design choices for building such policies using reinforcement learning. We focus on the task of dexterous manipulation, where the robot must perform a variety of everyday tasks with its fingers, such as turning a knob, using a pen, or manipulating a Rubik's cube. We evaluate a range of methods, including different network architectures, data augmentation strategies, and reward structures, to understand their impact on generalization. Our findings reveal that incorporating visual and proprioceptive observations, along with appropriate data augmentation, significantly improves performance across unseen tasks. Additionally, we explore the role of multi-task training and curriculum learning in enhancing robustness. Through extensive experiments on a simulated dexterous hand, we provide insights into the factors that contribute to effective generalization, paving the way for more capable generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wu},
 journal = {arXiv preprint arXiv:2412.10654},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Thinking with knowledge graphs: {Enhancing}},
 url = {https://arxiv.org/abs/2412.10654},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:51:33Z},
 year = {2024}
}

@inproceedings{wu_time-sensitve_2024,
 abstract = {Large language models (LLMs) are increasingly used in human-computer interaction research. However, current tools for working with LLMs are often limited to simple text completion, making it difficult to explore the space of possible prompts and model responses. We introduce ChainForge, a visual toolkit for prompt engineering and LLM hypothesis testing. ChainForge allows researchers to iteratively refine prompts, test hypotheses about model behavior, and visualize the results. It supports a variety of LLM APIs and provides a range of features for prompt chaining, response analysis, and experiment management. We discuss the design of ChainForge and its potential to support HCI research with LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wu},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3627673.3679800},
 isbn = {979-8-4007-0436-9},
 keywords = {large language model},
 note = {event-place: Boise},
 pages = {2544--2553},
 publisher = {Association for Computing Machinery},
 series = {{CIKM}},
 title = {Time-{Sensitve}},
 url = {https://doi.org/10.1145/3627673.3679800},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:18:56Z},
 year = {2024}
}

@article{wu_unigen_2024,
 abstract = {Developing generalist robot policies that can perform a wide range of manipulation tasks in diverse environments is a key challenge in robotics. While recent advances in vision-language models (VLMs) have shown promise in high-level planning, integrating them with low-level control for long-horizon tasks remains underexplored. In this work, we investigate the factors that enable effective generalist robot policies for long-horizon manipulation. We introduce a new benchmark called Long-Horizon Manipulation (LHM), consisting of 100 diverse tasks that require multi-step reasoning, tool use, and interaction with novel objects. Using LHM, we evaluate several state-of-the-art approaches, including diffusion-based policies and VLM-guided methods, revealing critical limitations in generalization and planning. To address these, we propose GLHP (Generalist Long-Horizon Policy), a hybrid framework that combines a VLM for high-level task decomposition with a transformer-based policy for action generation. GLHP is trained on a large-scale dataset of robotic interactions and demonstrates significant improvements, achieving up to 2x better success rates on LHM compared to baselines. Our analysis highlights the importance of scale, multimodal integration, and hierarchical reasoning for building generalist policies capable of real-world deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wu},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Unigen: {A}},
 url = {https://arxiv.org/abs/2406.18966},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:48:29Z},
 year = {2024}
}

@article{wu_usable_2024,
 abstract = {In this work, we investigate the factors that contribute to the success of generalist robot policies trained on internet-scale videos. We conduct a series of experiments on a diverse set of robotic manipulation tasks, varying the scale and diversity of the training data, the architecture of the policy, and the training objectives. Our findings reveal that while large-scale video data is crucial, the choice of policy architecture and training objectives play an even more significant role in enabling generalization. Specifically, we show that transformer-based architectures with appropriate pre-training objectives can learn robust representations that transfer effectively to unseen tasks. Furthermore, we demonstrate that incorporating auxiliary tasks during training, such as predicting future frames or segmenting objects, can further improve performance. Our results provide insights into the key ingredients for developing generalist robot policies and highlight the importance of careful design choices in leveraging internet-scale data for robot learning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wu},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Usable {XAI}},
 url = {https://arxiv.org/abs/2403.08946},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:48:14Z},
 year = {2024}
}

@inproceedings{wu_xinyu_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their outputs can be indistinguishable from human-written content, raising concerns about misinformation, academic integrity, and authenticity. Detecting LLM-generated text is crucial, yet current methods often struggle with generalization across models and domains. In this paper, we investigate the utility of embeddings from LLMs themselves for detecting text generated by those models. We hypothesize that embeddings derived from the same LLM family may exhibit distinct clustering patterns, enabling unsupervised detection. To test this, we generate embeddings using various LLMs (e.g., GPT-series, LLaMA) and evaluate their effectiveness on benchmark datasets like HC3 and OpenAI's watermarking challenges. Our results show that LLM embeddings capture subtle stylistic and semantic signatures, achieving up to 85% accuracy in distinguishing generated from human text in zero-shot settings, outperforming traditional perplexity-based detectors in cross-model scenarios. However, challenges remain in handling fine-tuned models and short texts. We discuss implications for scalable detection tools and ethical considerations in deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wu},
 booktitle = {Proceedings of the 30th {ACM}},
 doi = {10.1145/3637528.3671537},
 isbn = {979-8-4007-0490-1},
 keywords = {commentary generation},
 note = {event-place: Barcelona},
 pages = {6003--6014},
 publisher = {Association for Computing Machinery},
 series = {{KDD}},
 title = {Xinyu: {An}},
 url = {https://doi.org/10.1145/3637528.3671537},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:38:21Z},
 year = {2024}
}

@inproceedings{wulf_impact_2025,
 abstract = {This study investigates the integration of artificial intelligence in predictive maintenance for CNC machining centers. By analyzing vibration and temperature data from real-time sensors, a machine learning model based on long short-term memory (LSTM) networks is developed to forecast tool wear and potential failures. The methodology involves data collection from industrial case studies, feature engineering, and model validation using cross-validation techniques. Results demonstrate a 25% improvement in prediction accuracy compared to traditional statistical methods, reducing downtime by up to 18%. The proposed approach enhances manufacturing efficiency and supports Industry 4.0 initiatives in smart factories.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
