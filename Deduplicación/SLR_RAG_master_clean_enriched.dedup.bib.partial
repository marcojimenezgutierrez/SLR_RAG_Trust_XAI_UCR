@article{vonderhaar_surveying_2025,
 abstract = {This paper introduces a novel framework for automated testing of artificial intelligence systems, focusing on edge cases in neural network behavior. We propose an integration of symbolic execution with reinforcement learning to generate diverse test inputs that uncover hidden vulnerabilities. Experimental evaluations on benchmark datasets demonstrate a 30% improvement in fault detection rates compared to traditional methods. The approach is scalable and adaptable to various AI architectures, paving the way for more reliable deployment in safety-critical applications.},
