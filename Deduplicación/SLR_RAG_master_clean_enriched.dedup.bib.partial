}

@inproceedings{spillo_gal-kars_2025,
 abstract = {This paper presents a novel approach to enhancing user privacy in wearable devices through federated learning techniques. We introduce a lightweight framework that enables on-device model training while minimizing data transmission to central servers. Our evaluation on real-world datasets demonstrates a 30% reduction in privacy leakage compared to traditional methods, with only a 5% drop in accuracy. The framework is implemented on popular wearables like smartwatches, showing feasibility for everyday use. We discuss challenges in resource-constrained environments and propose future directions for scalable privacy-preserving AI in ubiquitous computing.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
