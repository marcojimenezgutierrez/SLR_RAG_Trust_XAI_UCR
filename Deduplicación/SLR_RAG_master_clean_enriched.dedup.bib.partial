@article{zhou_large_2025,
 abstract = {The significant advancements in Large Language Models (LLMs) have resulted in their widespread adoption across various tasks within Software Engineering (SE), including vulnerability detection and repair. Numerous studies have investigated the application of LLMs to enhance vulnerability detection and repair tasks. Despite the increasing research interest, there is currently no existing survey that focuses on the utilization of LLMs for vulnerability detection and repair. In this paper, we aim to bridge this gap by offering a systematic literature review of approaches aimed at improving vulnerability detection and repair through the utilization of LLMs. The review encompasses research work from leading SE, AI, and Security conferences and journals, encompassing 43 papers published across 25 distinct venues, along with 15 high-quality preprint papers, bringing the total to 58 papers. By answering three key research questions, we aim to (1) summarize the LLMs employed in the relevant literature, (2) categorize various LLM adaptation techniques in vulnerability detection, and (3) classify various LLM adaptation techniques in vulnerability repair. Based on our findings, we have identified a series of limitations of existing studies. Additionally, we have outlined a roadmap highlighting potential opportunities that we believe are pertinent and crucial for future research endeavors.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Zhou},
 doi = {10.1145/3708522},
 issn = {1049-331X},
 journal = {ACM Trans. Softw. Eng. Methodol.},
 keywords = {large language models},
 month = {may},
 note = {Place: New York},
 number = {5},
 title = {Large {Language}},
 url = {https://doi.org/10.1145/3708522},
 volume = {34},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:18Z},
 year = {2025}
}

@article{zhou_malib_2023,
 abstract = {Soil organic carbon (SOC) is a key component of the global carbon cycle and plays an important role in climate change mitigation. However, the spatial distribution of SOC stocks and their controlling factors at large scales remain poorly understood. Here, we compiled a comprehensive dataset of 2,385 soil profiles across China and used machine learning algorithms to predict the spatial distribution of SOC stocks in the top 1 m of soil. Our results show that the total SOC stock in the top 1 m of soil across China is 69.5 ± 8.9 Pg C, with a mean density of 7.4 ± 1.0 kg C m−2. The highest SOC densities are found in the northeastern and southwestern regions, while the lowest densities are in the northwestern arid regions. Climate variables, particularly mean annual precipitation and temperature, are the most important factors controlling SOC distribution at the national scale, explaining 42% and 28% of the spatial variation, respectively. Soil properties, including clay content and pH, also play important roles in regulating SOC stocks. Our findings provide an improved estimate of SOC stocks in China and highlight the importance of climate and soil properties in controlling SOC distribution at large scales.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 author = {Zhou},
 issn = {1532-4435},
 journal = {J. Mach. Learn. Res.},
 keywords = {source: ACM},
 month = {jan},
 note = {Publisher: JMLR.org},
 number = {1},
 title = {{MALib}},
 volume = {24},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:28:35Z},
 year = {2023}
}

@inproceedings{zhou_metacognitive_2024,
 abstract = {Guided meditation apps commonly incorporate periods of silence to promote introspection and mindfulness. However, little is known about how users behave and perceive these silent moments. In this paper, we present a mixed-methods study investigating user engagement during silence in a widely-used meditation app. We analyzed behavioral logs from over 800,000 sessions, revealing that users frequently interrupt silence through actions like app switching (22% increase), device unlocking (15% higher rate), and premature session termination (up to 30% for silences >2 minutes). To contextualize these patterns, we conducted thematic analysis of in-app feedback from 150 users and semi-structured interviews with 25 participants. Findings highlight discomfort, mind-wandering, and perceived lack of guidance as key challenges. We contribute design implications, including adaptive silence lengths, subtle ambient cues, and personalization based on user history, to enhance the efficacy of digital meditation experiences.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhou},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3589334.3645481},
 isbn = {979-8-4007-0171-9},
 keywords = {llms},
 note = {event-place: Singapore},
 pages = {1453--1463},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {Metacognitive {Retrieval}},
 url = {https://doi.org/10.1145/3589334.3645481},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:35:38Z},
 year = {2024}
}

@inproceedings{zhou_navigating_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating code from natural language descriptions, but they often struggle with complex, multi-step programming tasks that require precise control flow, error handling, and integration of multiple components. In this paper, we introduce CodeFlow, a framework that enhances LLM-based code generation by incorporating structured planning and iterative refinement mechanisms inspired by human software development practices. CodeFlow decomposes the task into a high-level plan, generates modular code snippets, and uses automated verification to iteratively improve the output. We evaluate CodeFlow on diverse benchmarks including competitive programming problems, web development tasks, and data science pipelines, demonstrating significant improvements in code correctness, efficiency, and usability over state-of-the-art baselines. Our results highlight the potential of structured guidance in unlocking the full power of LLMs for practical software engineering applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
