@inproceedings{chopra_challenges_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating code, but they often produce insecure code that contains vulnerabilities. Existing approaches to detecting vulnerabilities in LLM-generated code are limited to specific types of vulnerabilities and require manual effort to craft detection rules. In this paper, we propose VulGen, a novel framework that leverages LLMs to automatically generate vulnerable code snippets and corresponding detection rules for vulnerability detection. VulGen consists of two main components: (1) a vulnerability code generator that uses LLMs to generate vulnerable code snippets based on vulnerability descriptions, and (2) a rule generator that uses LLMs to generate detection rules based on the generated vulnerable code. We evaluate VulGen on 10 common vulnerability types and show that it can generate high-quality vulnerable code snippets and detection rules that achieve high precision and recall in vulnerability detection. Our results demonstrate that VulGen can effectively augment vulnerability detection for LLM-generated code with minimal manual effort.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 and a survey (n = {114). Our findings reveal key obstacles},
 author = {Chopra},
 booktitle = {Proceedings of the {Workshop}},
 doi = {10.1145/3736733.3736748},
 isbn = {979-8-4007-1959-2},
 keywords = {computational notebooks},
 note = {event-place: Intercontinental Berlin},
 publisher = {Association for Computing Machinery},
 semi-structured interviews (n = {14)},
 series = {{HILDA}},
 title = {Challenges in {Using}},
