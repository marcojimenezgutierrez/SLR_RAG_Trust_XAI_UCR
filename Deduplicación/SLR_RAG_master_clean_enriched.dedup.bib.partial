 keywords = {Large Language Models},
 pages = {690--695},
 publisher = {Association for Computing Machinery},
 series = {{RecSys}},
 title = {{TreatRAG}},
 url = {https://doi.org/10.1145/3705328.3748022},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:04:53Z},
 year = {2025}
}

@inproceedings{liu_tsconnect_2025,
 abstract = {Visual Question Answering (VQA) has achieved remarkable progress with the advent of large multimodal models. However, these models often exhibit biases toward specific answer types, leading to unfair performance across different question types. In this paper, we propose FairVQA, a novel framework to mitigate bias in VQA models by incorporating fairness constraints during training. Specifically, we introduce a fairness-aware loss function that balances the model's performance across various answer distributions. Extensive experiments on benchmark datasets demonstrate that FairVQA significantly improves fairness metrics while maintaining competitive overall accuracy. Our approach provides a promising direction for developing equitable VQA systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Liu},
 booktitle = {Proceedings of the 30th {International}},
 doi = {10.1145/3708359.3712108},
