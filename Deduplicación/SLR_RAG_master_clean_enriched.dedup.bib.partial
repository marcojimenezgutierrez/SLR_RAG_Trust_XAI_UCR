@article{voznyuk_advacheck_2025,
 abstract = {This paper describes our system for the SemEval-2025 Task 1: Multilingual and Cross-Lingual Semantic Similarity. We experiment with cross-encoders and bi-encoders based on transformer models, including multilingual models like mBERT and XLM-R, as well as monolingual models for English. We also explore sentence embeddings from models like Sentence-BERT and LaBSE. Our best system combines predictions from multiple models using a weighted average, achieving competitive performance on the development and test sets.},
