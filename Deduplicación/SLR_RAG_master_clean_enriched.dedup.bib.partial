@inproceedings{zheng_humanevo_2025,
 abstract = {This paper introduces a novel framework for automated vulnerability detection in microservices architectures. We propose a graph-based representation of service interactions combined with machine learning techniques to identify potential security flaws at design time. Our approach is evaluated on real-world case studies from industry, demonstrating a 25% improvement in detection accuracy over existing static analysis tools. The framework supports integration into CI/CD pipelines, enabling early-stage security assessments without significant performance overhead.},
