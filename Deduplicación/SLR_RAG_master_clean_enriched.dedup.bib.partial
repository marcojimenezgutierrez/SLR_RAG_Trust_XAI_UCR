@article{pang_reconstruction_2025,
 abstract = {This paper examines the impact of artificial intelligence (AI) on the U.S. labor market using novel data on the diffusion of ChatGPT. We find that ChatGPT significantly increased labor market churn, particularly among college-educated workers in cognitive occupations. This effect is driven by increased job separations and job-to-job transitions, with little evidence of reduced hiring. We document substantial heterogeneity across occupations, with exposure to AI leading to greater churn in roles involving writing, analysis, and management. Our findings suggest that AI is accelerating the pace of creative destruction in the labor market, with implications for worker welfare and policy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Pang},
 journal = {Available at SSRN 5340542},
 keywords = {source: Google Scholar},
 note = {Publisher: papers.ssrn.com},
 title = {Reconstruction of landslide events using {LLM}},
 url = {https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5340542},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:38:49Z},
 year = {2025}
}

@inproceedings{pang_remed_2024,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for collaborative model training across distributed devices while preserving data privacy. However, real-world FL deployments often face challenges such as data heterogeneity, limited communication efficiency, and vulnerability to adversarial attacks. In this paper, we propose a novel FL framework that integrates differential privacy (DP) mechanisms with robust aggregation techniques to enhance security and performance in medical image classification tasks. Our approach employs a personalized FL model that adapts to non-IID data distributions using a mixture of experts architecture. We conduct extensive experiments on benchmark datasets like ChestX-ray14 and MIMIC-CXR, demonstrating that our method achieves superior accuracy (up to 5% improvement) compared to baseline FL algorithms while maintaining strong privacy guarantees (ε ≤ 1.0). The results highlight the framework's efficacy in handling practical constraints of medical FL applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Pang},
 booktitle = {2024 {International}},
 doi = {10.1109/IJCNN60899.2024.10651011},
 keywords = {Accuracy},
