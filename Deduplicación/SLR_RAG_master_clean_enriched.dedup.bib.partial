 x_enrich_ts = {2025-11-02T08:39:12Z},
 year = {2025}
}

@article{bezerra_llmquoter_2025,
 abstract = {We introduce Grok-1.5V, the first multimodal model from xAI. It shows significant improvements on real-world tasks incorporating vision, such as real-world spatial understanding, document comprehension, and image reasoning. Grok-1.5V exhibits strong performance on benchmarks like RealWorldQA, a benchmark evaluating spatial understanding of real-world images, and achieves state-of-the-art results on the AI2D dataset. Additionally, Grok-1.5V demonstrates strong performance on text and image understanding tasks on the RealWorldQA, MMMU, and MathVista benchmarks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
