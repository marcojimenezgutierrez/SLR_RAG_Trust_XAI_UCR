@article{odubola_ai_2025,
 abstract = {The rapid evolution of artificial intelligence (AI), particularly large language models (LLMs), has opened new avenues for addressing complex societal challenges, including crisis management and disaster response. This paper explores the transformative potential of LLM-powered interventions in enhancing social good within these critical domains. We examine how LLMs can facilitate real-time information processing, multilingual communication, predictive analytics, and personalized support during various phases of crises—from preparedness and response to recovery. Drawing on case studies from recent global disasters, such as natural calamities and humanitarian emergencies, we highlight practical applications, including automated alert systems, sentiment analysis for public mood gauging, and resource optimization tools. Ethical considerations, including bias mitigation, privacy concerns, and equitable access, are critically analyzed to ensure responsible deployment. Our findings underscore the need for interdisciplinary collaboration to harness LLMs effectively, ultimately aiming to save lives, reduce response times, and foster resilient communities in an era of increasing uncertainty.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
