@inproceedings{borghoff_generative_2025,
 abstract = {Federated Learning (FL) has emerged as a promising approach for collaborative model training while preserving data privacy. However, existing FL frameworks often overlook the privacy risks associated with model updates and their potential leakage of sensitive information. In this paper, we propose a comprehensive framework for evaluating the privacy guarantees of FL systems. Our framework integrates differential privacy mechanisms, secure aggregation protocols, and adversarial attack simulations to quantify privacy leakage under various threat models. Through extensive experiments on benchmark datasets, we demonstrate that our evaluation framework reveals significant vulnerabilities in state-of-the-art FL implementations, guiding the development of more robust privacy-preserving techniques.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
