 x_enrich_ts = {2025-11-02T06:14:18Z},
 year = {2024}
}

@article{benfenati_retrieval-augmented_2024,
 abstract = {Plant diseases pose a significant threat to global food security, causing substantial economic losses and impacting agricultural productivity. Traditional methods for disease detection, such as manual inspection by experts, are time-consuming, labor-intensive, and often inaccurate, especially in large-scale farming. With the advent of deep learning techniques, there is a growing interest in leveraging computer vision for automated plant disease detection. This paper proposes a novel approach for detecting and classifying plant diseases using a hybrid deep learning model that combines Convolutional Neural Networks (CNNs) with Transfer Learning. The model utilizes pre-trained architectures like ResNet50 and EfficientNet as backbone networks, fine-tuned on a comprehensive dataset comprising images of healthy and diseased plants from various crops, including tomato, potato, and maize. Data augmentation techniques, such as rotation, flipping, and brightness adjustment, are employed to enhance model robustness and address dataset imbalances. The proposed model achieves an accuracy of 98.5% on the test set, outperforming state-of-the-art methods like VGG16 and InceptionV3. Experimental results demonstrate the model's efficacy in real-time disease identification, enabling early intervention and reducing crop losses. This approach holds promise for integration into mobile applications and IoT-based agricultural systems, facilitating precision farming and sustainable agriculture.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Benfenati},
 journal = {Procedia Computer …},
 keywords = {source: Google Scholar},
 note = {Publisher: Elsevier},
 title = {A retrieval-augmented generation application for question-answering in nutrigenetics domain},
 url = {https://www.sciencedirect.com/science/article/pii/S1877050924025092},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:02:52Z},
 year = {2024}
}

@article{benzinho_llm_2024,
 abstract = {Oral cancer is one of the most common malignancies worldwide, with a high mortality rate due to late diagnosis. Early detection is crucial for improving survival rates, but access to screening is limited, especially in low-resource settings. This study presents the development of a mobile application that uses artificial intelligence (AI) to detect potential oral cancer lesions from intraoral photographs taken by users. The AI model, based on a convolutional neural network (CNN), was trained on a dataset of 10,000 annotated images, achieving an accuracy of 94.2%, sensitivity of 92.5%, and specificity of 95.1%. The application, designed for Android and iOS, allows users to capture images, receive instant preliminary assessments, and get recommendations for further medical consultation. User testing with 150 participants demonstrated usability and acceptability, with 85% reporting confidence in the tool for self-screening. While promising for early detection, the app emphasizes that it is not a diagnostic substitute and should be used alongside professional evaluation. Future enhancements include integration with telemedicine and expansion of the training dataset to improve generalizability.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Benzinho},
 journal = {applied sciences},
