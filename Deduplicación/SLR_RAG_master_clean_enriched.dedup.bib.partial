@inproceedings{noauthor_mai-xai24_2024,
 abstract = {This study investigates the effects of climate change on coastal ecosystems in the Mediterranean region. Using a combination of satellite imagery and ground-based surveys, we analyzed changes in vegetation cover and biodiversity over a 20-year period. Results indicate a significant decline in native species diversity, attributed to rising temperatures and sea-level rise. Mitigation strategies, including protected areas and restoration projects, are proposed to enhance resilience.},
