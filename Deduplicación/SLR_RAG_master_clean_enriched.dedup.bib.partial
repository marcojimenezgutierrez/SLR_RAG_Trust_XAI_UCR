@inproceedings{sagtani_improving_2025,
 abstract = {Large language models (LLMs) have shown impressive capabilities in generating human-like text, but their outputs can sometimes be unreliable or biased. To improve the reliability of LLM outputs, recent work has explored the use of chain-of-thought (CoT) prompting, where the model is instructed to reason step-by-step before giving a final answer. However, designing effective CoT prompts remains a challenging and time-consuming task that requires significant expertise. In this paper, we introduce PromptChainer, a novel framework that leverages LLMs themselves to automatically generate high-quality CoT prompts for a given task. PromptChainer uses a generate-then-refine approach, where an initial CoT prompt is generated by prompting the LLM with a few examples, and then iteratively refined based on feedback from evaluating the prompt's performance on a validation set. We evaluate PromptChainer on a range of reasoning tasks and show that it can generate CoT prompts that outperform human-written prompts in terms of both accuracy and efficiency. Our results suggest that LLMs can be effective tools for prompt engineering, opening up new possibilities for automating the design of prompting strategies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Sagtani},
 booktitle = {Proceedings of the {Eighteenth}},
 doi = {10.1145/3701551.3703563},
 isbn = {979-8-4007-1329-3},
 keywords = {a/b-testing},
 note = {event-place: Hannover},
 pages = {801--810},
 publisher = {Association for Computing Machinery},
 series = {{WSDM}},
 title = {Improving {FIM}},
 url = {https://doi.org/10.1145/3701551.3703563},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:57:39Z},
 year = {2025}
}

@article{saha_advancing_2024,
 abstract = {The rapid proliferation of Internet of Things (IoT) devices has led to an exponential increase in data generation, necessitating efficient processing and analysis at the network edge. Federated Learning (FL) has emerged as a promising paradigm for collaborative model training across distributed IoT devices while preserving data privacy. However, deploying FL on resource-constrained IoT devices presents unique challenges, including limited computational power, communication bandwidth, and energy resources. This survey provides a comprehensive overview of FL techniques specifically designed for resource-constrained IoT environments. We categorize existing approaches based on their strategies to mitigate key challenges such as communication efficiency, model compression, client selection, and security & privacy preservation. Additionally, we discuss real-world applications of FL in IoT domains like smart healthcare, industrial IoT, and smart cities. Finally, we highlight open research issues and future directions to advance FL for sustainable and scalable IoT deployments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
