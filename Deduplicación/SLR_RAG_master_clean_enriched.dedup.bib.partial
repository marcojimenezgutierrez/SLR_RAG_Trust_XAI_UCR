@article{ding_enhancing_2025,
 abstract = {The rapid evolution of artificial intelligence (AI) technologies has introduced new dimensions to human intimacy, particularly through AI companions designed for emotional and sexual support. This article explores the ethical implications of human-AI intimate relationships, focusing on consent, autonomy, and emotional dependency. Drawing on philosophical frameworks and empirical data from user surveys (N = 342), we examine how AI systems simulate empathy and reciprocity, potentially blurring boundaries between human and machine interactions. Key findings indicate that while AI offers accessible intimacy for marginalized groups, it raises concerns about exploitation, data privacy, and the dehumanization of relationships. We propose ethical guidelines for developers, emphasizing transparency, user agency, and the integration of human oversight to foster healthy AI-mediated intimacy. This study contributes to ongoing discourses in technology ethics and relationship studies, advocating for a balanced approach that harnesses AI's benefits without compromising human dignity.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 2},
 author = {Ding},
 doi = {10.1007/s10844-025-00945-5},
