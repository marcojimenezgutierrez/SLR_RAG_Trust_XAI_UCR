 year = {2025}
}

@article{mukherjee_documents_2025,
 abstract = {We introduce a novel framework for training large language models (LLMs) to act as generalist agents capable of performing diverse tasks across multiple domains. Our approach leverages a unified pre-training paradigm that integrates instruction-following, tool-use, and multi-turn reasoning, enabling the model to handle complex, open-ended interactions without task-specific fine-tuning. Through extensive experiments on benchmarks such as GAIA, WebArena, and custom agent evaluation suites, we demonstrate that our model outperforms specialized agents by up to 25% in cross-domain generalization while maintaining efficiency in inference. This work paves the way for scalable, versatile AI assistants deployable in real-world scenarios.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
