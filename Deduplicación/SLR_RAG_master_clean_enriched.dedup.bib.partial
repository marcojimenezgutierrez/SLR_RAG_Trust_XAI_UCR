 volume = {30},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:02:44Z},
 year = {2024}
}

@article{church_emerging_2024-1,
 abstract = {Retrieval-augmented generation (RAG) is a technique for augmenting large language model (LLM)-generated text with external information. Since its inception, RAG has become a foundational component of many LLM applications. In this article, we provide a gentle introduction to RAG, including its motivation, core components, and common implementations. We also discuss emerging trends and future directions for RAG research.},
