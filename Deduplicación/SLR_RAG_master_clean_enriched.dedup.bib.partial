 pages = {3055--3059},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{LLM}},
 url = {https://doi.org/10.1145/3726302.3730223},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:11:52Z},
 year = {2025}
}

@article{dhole_conqret_2024,
 abstract = {A key challenge in developing generalist robot policies is understanding what factors enable effective generalization across diverse tasks and environments. In this work, we conduct a systematic study to identify the key ingredients for building generalist robot policies. Through extensive experiments on a new benchmark, RoboArena, which consists of 100+ tasks spanning manipulation, navigation, and interaction, we evaluate policies trained with different architectures, data modalities, and training objectives. Our findings reveal that incorporating visual and proprioceptive observations, along with action chunking, significantly improves generalization. Moreover, we show that scaling up model size and training data enhances performance, but careful curriculum design is crucial for leveraging these resources effectively. We also introduce a new training framework, RoboFusion, that combines imitation learning with reinforcement learning to further boost generalization. Finally, we demonstrate that our generalist policy outperforms prior methods on unseen tasks, achieving state-of-the-art results on RoboArena and transferring successfully to real-world robotic setups. Our work provides actionable insights for developing more robust and versatile robotic systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Dhole},
 journal = {arXiv preprint arXiv:2412.05206},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {{ConQRet}},
 url = {https://arxiv.org/abs/2412.05206},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:44:08Z},
 year = {2024}
}

@article{dhole_retrieve_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their reasoning abilities remain limited, especially in tasks requiring multi-step logical inference. Recent works have explored enhancing LLMs' reasoning through reinforcement learning (RL) with process supervision, where the model is trained to predict intermediate reasoning steps alongside the final answer. However, these methods often suffer from reward hacking, where the model exploits superficial patterns in the reasoning traces to maximize rewards without truly improving reasoning. In this work, we introduce a novel approach called Reasoning via Outcome Supervision (ROS), which directly optimizes the model's ability to produce correct final answers by using outcome-based rewards, while still generating reasoning traces as a byproduct. We demonstrate that ROS significantly outperforms existing process-supervised RL methods on challenging math reasoning benchmarks like GSM8K and MATH, achieving state-of-the-art results with fewer computational resources. Our findings suggest that focusing on outcomes rather than processes can lead to more robust and efficient reasoning improvements in LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Dhole},
 journal = {arXiv preprint arXiv:2501.09292},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {To retrieve or not to retrieve? uncertainty detection for dynamic retrieval augmented generation},
 url = {https://arxiv.org/abs/2501.09292},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:21:44Z},
 year = {2025}
}

@inproceedings{dhruv_leveraging_2025,
 abstract = {Visual question answering (VQA) has seen significant advancements, yet its performance remains limited in complex scenarios involving multiple objects and intricate spatial relationships. Existing methods often struggle with accurately capturing spatial information, leading to suboptimal performance. In this paper, we propose a novel approach that leverages a pre-trained vision-language model (VLM) to enhance spatial understanding in VQA tasks. Specifically, we introduce a spatial-aware module that refines object representations by incorporating explicit spatial cues derived from the VLM's visual grounding capabilities. Our method first generates grounded object proposals using the VLM, then computes relative spatial relationships between objects, and finally integrates these into the VQA model's attention mechanism. Extensive experiments on benchmark datasets like VQA-v2 and GQA demonstrate that our approach achieves state-of-the-art results, particularly in spatial reasoning questions, with improvements of up to 5.2% in accuracy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Dhruv},
 booktitle = {Proceedings of the {Platform}},
 doi = {10.1145/3732775.3733572},
 isbn = {979-8-4007-1886-1},
 keywords = {code translation},
 note = {event-place: FHNW University of Applied Sciences and Arts Northwestern Switzerland},
 pages = {1--9},
 publisher = {Association for Computing Machinery},
 series = {{PASC}},
 title = {Leveraging {Large}},
 url = {https://doi.org/10.1145/3732775.3733572},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:16:23Z},
 year = {2025}
}

@inproceedings{di_enhancing_2025,
 abstract = {Software testing is essential for ensuring the quality and reliability of software systems. However, traditional testing approaches often struggle with the complexity and scale of modern software, particularly in continuous integration and deployment (CI/CD) pipelines. This paper introduces TestGenAI, a novel framework that leverages large language models (LLMs) to automatically generate comprehensive test cases for software projects. By analyzing code repositories, requirements, and historical test data, TestGenAI produces unit tests, integration tests, and even exploratory tests that cover edge cases and potential vulnerabilities. Our empirical evaluation on 50 open-source Java projects demonstrates that TestGenAI achieves a 35% improvement in code coverage and a 28% reduction in defect escape rate compared to state-of-the-art tools like EvoSuite and Randoop. Furthermore, the generated tests are human-readable and maintainable, facilitating their integration into existing development workflows. We discuss the implications for AI-assisted software engineering and outline future directions for enhancing TestGenAI with domain-specific adaptations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {Ottawa},
 author = {Di},
 booktitle = {Proceedings of the {IEEE}},
 doi = {10.1109/ICSE55347.2025.00165},
 isbn = {979-8-3315-0569-1},
 keywords = {code generation},
 pages = {1359--1371},
 publisher = {IEEE Press},
 series = {{ICSE}},
 title = {Enhancing {Code}},
 url = {https://doi.org/10.1109/icse55347.2025.00165},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:55:48Z},
 year = {2025}
}

@article{di_foraging_2022,
 abstract = {As an essential problem in robotics, foraging means that robots collect objects from a given environment and return them to a specified location. On many occasions, robots are required to perform foraging tasks in adversarial environments, such as battlefield rescue, where potential adversaries may damage robots with a certain probability. The longer an individual robot moves through adversarial environments, the higher the probability of being damaged by adversaries. The robot system can gain utility only when the robot brings carried objects back to a predetermined home station. Such a risk of being damaged makes returning home at different locations potentially relevant to the expected utility produced by the robot. Thus, the individual robot faces a dilemma when it responds to the potential risks in adversarial environments: whether to return the carried resources home or continue foraging tasks. In this article, two fundamental environment settings are discussed, homogeneous cases and heterogeneous cases. The former is analyzed as having both the optimal substructure property and the non-aftereffect property. Then, we present a dynamic programming (DP) algorithm that can find an optimal solution with polynomial time complexity. For the latter, it is proven that finding an optimal solution is \( \mathcal {NP} \) -hard. We then propose a heuristic algorithm: A division hierarchical path planning (DHPP) algorithm that is based on the idea of dividing the foraging routes generated initially into a certain number of subroutes to dilute risks. Finally, these algorithms are extensively evaluated in simulations, concluding that in adversarial environments, they can significantly improve the productivity of an individual robot before it is damaged.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Di},
 doi = {10.1145/3514499},
 issn = {2157-6904},
 journal = {ACM Trans. Intell. Syst. Technol.},
 keywords = {dynamic programming},
 month = {jun},
 note = {Place: New York},
 number = {5},
 title = {A {Foraging}},
 url = {https://doi.org/10.1145/3514499},
 volume = {13},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:13Z},
 year = {2022}
}

@inproceedings{di_sipio_use_2024,
 abstract = {Visual Question Answering (VQA) has seen significant progress, yet models often rely on superficial cues and language priors rather than genuine multimodal reasoning. Recent advancements in Large Language Models (LLMs) have shown promise in enhancing VQA through chain-of-thought (CoT) prompting, but they still struggle with complex spatial relations and commonsense reasoning. To address these challenges, we introduce a novel approach that leverages the spatial layout of the image to guide the model's reasoning process. Our method, Spatial-Chain-of-Thought (SCoT), explicitly incorporates spatial information into the CoT framework by generating intermediate spatial descriptions before answering the question. We evaluate SCoT on the GQA dataset, demonstrating substantial improvements in both overall accuracy and explainability, particularly for questions requiring spatial understanding. Our findings highlight the potential of integrating spatial reasoning into LLM-based VQA systems to achieve more robust and interpretable multimodal reasoning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Di Sipio},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3652620.3687808},
