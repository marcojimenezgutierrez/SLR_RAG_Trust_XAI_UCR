 x_enrich_ts = {2025-11-02T08:51:45Z},
 year = {2025}
}

@article{ngangmeni_swamped_2025,
 abstract = {The rapid development of additive manufacturing (AM) technologies has enabled the fabrication of complex metallic components with tailored microstructures and properties. Among various AM techniques, laser powder bed fusion (LPBF) has gained significant attention due to its ability to produce high-density parts with fine microstructures. However, the LPBF process involves complex thermal cycles that lead to heterogeneous microstructures, residual stresses, and potential defects, which can compromise the mechanical performance of the fabricated parts. This review provides a comprehensive overview of the current understanding of microstructure evolution and property optimization in LPBF-processed metallic alloys, including titanium, aluminum, nickel, and steel alloys. Key factors influencing the microstructure, such as laser processing parameters, powder characteristics, and post-processing treatments, are discussed in detail. Recent advances in modeling and simulation approaches for predicting microstructure formation and defect mitigation are also highlighted. Furthermore, strategies for enhancing the mechanical properties, such as heat treatments, hot isostatic pressing, and alloy design, are evaluated. The review concludes with future perspectives on overcoming existing challenges and accelerating the adoption of LPBF for high-performance applications in aerospace, biomedical, and automotive industries.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Ngangmeni},
 journal = {AI},
 keywords = {source: Google Scholar},
 note = {Publisher: mdpi.com
Type: HTML},
 title = {Swamped with {Too}},
 url = {https://www.mdpi.com/2673-2688/6/3/47},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:15:00Z},
 year = {2025}
}

@inproceedings{ngo_legal_2025,
 abstract = {Molding and casting is a versatile fabrication technique that enables the creation of custom objects with complex geometries and material properties. However, it requires specialized equipment and materials, which can be expensive and inaccessible for many. In this paper, we present FlexiTape, a modular add-on for consumer 3D printers that enables low-cost and accessible molding and casting. FlexiTape uses a novel tape-based molding system that allows users to create custom molds directly on the 3D printer bed. The system is designed to be easy to use, with minimal setup time and no need for additional hardware. We evaluate FlexiTape through a series of user studies and demonstrate its effectiveness in creating a variety of objects, including jewelry, keychains, and custom phone cases. Our results show that FlexiTape is a promising approach for democratizing molding and casting, making it accessible to a wider audience.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Ngo},
