 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:01:06Z},
 year = {2025}
}

@inproceedings{barile_lp-dixit_2025,
 abstract = {Data visualization tools have become increasingly accessible to non-experts, enabling them to create interactive visualizations for various purposes. However, the design space of visual programming for interactive data visualization remains underexplored. In this paper, we investigate how visual programming can support the creation of interactive visualizations by non-experts. We first conducted a formative study with 12 non-expert participants to understand their needs and challenges in creating interactive visualizations. Based on the findings, we designed and implemented a visual programming environment called VizFlow, which allows users to create interactive visualizations by composing visual blocks. We then conducted a comparative user study with 24 non-expert participants to evaluate the effectiveness of VizFlow compared to a baseline tool. The results show that VizFlow significantly improves users' ability to create interactive visualizations, reduces the time spent on debugging, and increases their confidence in the process. Our work contributes to the understanding of visual programming for interactive data visualization and provides design implications for future tools in this space.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Barile},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3696410.3714667},
