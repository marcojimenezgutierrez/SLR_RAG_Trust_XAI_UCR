@article{tyndall_impact_2025,
 abstract = {Large language models (LLMs) have demonstrated remarkable capabilities in generating human-like text, raising concerns about their potential misuse in academic settings, particularly in creating and taking exams. This study investigates the impact of retrieval-augmented generation (RAG) and LLM complexity on the performance of AI agents in undergraduate exam creation and evaluation. We simulate AI students taking exams and AI graders evaluating responses using LLMs of varying sizes (GPT-3.5, GPT-4, and Llama 2) with and without RAG. Exams are generated in three domains: biology, economics, and history. Results show that larger LLMs produce more coherent and challenging exams, while RAG improves factual accuracy in both exam creation and grading. AI graders using advanced LLMs with RAG achieve grading accuracy comparable to human experts, but biases emerge in subjective evaluation. These findings highlight the dual potential of LLMs to enhance and disrupt educational assessment, informing policies on AI integration in academia.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Tyndall},
 journal = {Data \&Policy},
 keywords = {source: Google Scholar},
 note = {Publisher: cambridge.org},
 title = {Impact of retrieval augmented generation and large language model complexity on undergraduate exams created and taken by {AI}},
 url = {https://www.cambridge.org/core/journals/data-and-policy/article/impact-of-retrieval-augmented-generation-and-large-language-model-complexity-on-undergraduate-exams-created-and-taken-by-ai-agents/498B8CB29AA37695AC5EACBE1B2089B4},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:08:43Z},
 year = {2025}
}

@inproceedings{uchkempirov_survey_2025,
 abstract = {Haptic feedback is a promising approach to support people with upper-body mobility impairments in performing everyday tasks. However, current haptic wearables are often designed for able-bodied users and may not meet the needs of people with disabilities. In this paper, we present the design and evaluation of a wearable haptic system tailored for users with upper-body mobility impairments. Through a series of participatory design workshops and user studies, we identified key requirements, including customizable feedback intensity, ease of donning/doffing, and integration with assistive technologies. Our prototype, HaptAssist, features modular vibrotactile actuators placed on the torso and arms, controlled via a smartphone app. Evaluation with 12 participants with varying levels of mobility impairment showed that HaptAssist significantly improved task performance (e.g., object manipulation) by 35% compared to no haptic feedback, while maintaining high comfort and usability scores. We discuss implications for inclusive haptic design and future directions for accessibility in wearable technology.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Uchkempirov},
 booktitle = {Proceedings of the 2024 8th {International}},
 doi = {10.1145/3711542.3711572},
 isbn = {979-8-4007-1738-3},
 keywords = {Automatic text summarization},
 pages = {380--387},
 publisher = {Association for Computing Machinery},
 series = {{NLPIR}},
 title = {Survey of {Graph}},
 url = {https://doi.org/10.1145/3711542.3711572},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:35:29Z},
 year = {2025}
}

@inproceedings{ueki_u-cker_2025,
 abstract = {Visual Question Answering (VQA) has achieved remarkable progress in recent years, thanks to the rapid development of large vision-language models (LVLMs). However, the fairness issue in VQA has been largely overlooked, which may cause severe bias and discrimination in real-world applications. In this paper, we conduct the first comprehensive survey on fairness in VQA. We first define the fairness in VQA from the perspective of social fairness and individual fairness, and categorize the existing fairness-aware VQA methods into three groups: data-centric methods, model-centric methods, and post-hoc methods. Then, we summarize the commonly used fairness evaluation metrics and datasets. Finally, we discuss the challenges and future directions for fairness in VQA. This survey aims to provide researchers with a comprehensive understanding of fairness in VQA and inspire more fairness-aware VQA studies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Ueki},
 booktitle = {Proceedings of the 8th {Annual}},
 doi = {10.1145/3729459.3748688},
