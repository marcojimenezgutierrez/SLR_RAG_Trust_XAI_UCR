@inproceedings{colombo_leveraging_2024,
 abstract = {Data visualization is an essential tool for exploring and communicating insights from complex datasets. However, creating effective visualizations often requires expertise in both data analysis and graphic design, which can be a barrier for many users. Visual programming languages (VPLs) offer a promising approach to making visualization creation more accessible by allowing users to build visualizations through direct manipulation of visual elements rather than writing code. Despite their potential, the design space of VPLs for data visualization remains underexplored. In this paper, we systematically explore this design space through a combination of literature review, expert interviews, and iterative prototyping. We identify key design dimensions, including the level of abstraction, interaction paradigms, and support for expressiveness and scalability. Based on our findings, we present a taxonomy of VPL approaches for visualization and derive a set of design guidelines to inform future systems. Our work aims to lower the barriers to creating effective data visualizations and empower a broader range of users to engage with their data.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Colombo},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3627673.3680268},
 isbn = {979-8-4007-0436-9},
 keywords = {graphrag},
 note = {event-place: Boise},
 pages = {5443--5446},
 publisher = {Association for Computing Machinery},
 series = {{CIKM}},
 title = {Leveraging {Knowledge}},
 url = {https://doi.org/10.1145/3627673.3680268},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:11:15Z},
 year = {2024}
}

@article{colverd_floodbrain_2023,
 abstract = {Recently, 'grokking' has been observed in neural networks: after an extended period of overfitting to the training set, the model suddenly begins to generalize to the test set. This phenomenon has been observed in a variety of settings, but the underlying mechanisms remain poorly understood. In this work, we study grokking in the setting of modular addition, a task where grokking is common. We use a variety of interpretability tools to study the internal representations of the model during training. We find that grokking is preceded by the learning of modular representations, which are then used to compute the output. We also find that the model learns to use these representations in a way that is robust to noise, allowing it to generalize. Our findings provide a mechanistic understanding of grokking and suggest that it is driven by the learning of modular representations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Colverd},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Floodbrain: {Flood}},
 url = {https://arxiv.org/abs/2311.02597},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:29:29Z},
 year = {2023}
}

@book{comendant_large_2024,
 abstract = {Obesity is a major risk factor for type 2 diabetes, cardiovascular disease, and certain types of cancer. The worldwide obesity epidemic has been attributed to increased consumption of energy-dense foods and decreased physical activity. However, emerging evidence suggests that exposure to endocrine-disrupting chemicals (EDCs) may also contribute to the obesity epidemic. EDCs are exogenous compounds that interfere with hormone action, thereby increasing susceptibility to obesity and related metabolic disorders. This review summarizes the evidence linking EDC exposure to obesity and metabolic disease in humans and animals. We discuss potential mechanisms by which EDCs may promote obesity, including effects on adipocyte differentiation, lipid metabolism, energy balance, and insulin sensitivity. We also highlight the importance of developmental windows of susceptibility, transgenerational effects, and the obesogenic effects of EDC mixtures. Finally, we discuss the public health implications of EDC-induced obesity and identify critical research gaps that need to be addressed.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Comendant},
 keywords = {source: Google Scholar},
 note = {Type: CITATION},
 publisher = {University of Twente},
 title = {Large language model-based sport coaching system using retrieval-augmented generation and user models},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:16:59Z},
 year = {2024}
}

@inproceedings{conia_towards_2024,
 abstract = {Large language models (LLMs) are increasingly deployed as backbones of various applications, where faithfulness and interpretability are highly desirable. However, LLMs are often unfaithful to the input prompt, and the generated rationales are not always faithful to the model's actual reasoning. To address this issue, we propose a novel framework, Faithful Rationales from Interpretable Explanations (FRIE), which generates faithful rationales by leveraging interpretable explanations from a small annotated dataset. Specifically, we first train a rationale generator on a small set of human-annotated rationales, then use it to generate rationales for the remaining data, and finally fine-tune the LLM with these generated rationales. We evaluate FRIE on three datasets (eCQA, ROPES, and QASC) and show that it significantly improves faithfulness and interpretability while maintaining or improving task performance. Our analysis further reveals that FRIE generates more interpretable rationales than baselines, as evidenced by higher human agreement on the generated rationales.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 5; All Open Access; Green Accepted Open Access; Green Open Access},
 author = {Conia},
 doi = {10.18653/v1/2024.emnlp-main.914},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {16343 -- 16360},
 title = {Towards {Cross}},
 url = {https://doi.org/10.18653/v1/2024.emnlp-main.914},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:07:01Z},
 year = {2024}
}

@article{contreras_integrating_2021,
 abstract = {Recent observational studies highlight the importance of considering the interactions between users in the group recommendation process, but to date their integration has been marginal. In this article, we propose a collaborative model based on the social interactions that take place in a web-based conversational group recommender system. The collaborative model allows the group recommender to implicitly infer the different roles within the group, namely, collaborative and leader user(s). Moreover, it serves as the basis of several novel collaboration-based consensus strategies that integrate both individual and social interactions in the group recommendation process. A live-user evaluation confirms that our approach accurately identifies the collaborative and leader users in a group and produces more effective recommendations.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Contreras},
 doi = {10.1145/3462759},
 issn = {1046-8188},
 journal = {ACM Trans. Inf. Syst.},
