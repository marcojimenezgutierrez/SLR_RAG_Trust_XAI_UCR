 keywords = {agents},
 note = {event-place: Padua},
 pages = {3911--3921},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {From {To}},
 url = {https://doi.org/10.1145/3726302.3730352},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:28:11Z},
 year = {2025}
}

@inproceedings{shah_building_2024,
 abstract = {The rapid growth of Internet of Things (IoT) devices has led to increased vulnerabilities in network security, particularly against Distributed Denial of Service (DDoS) attacks. Traditional intrusion detection systems often struggle with the scale and complexity of IoT traffic. This paper presents a deep learning-based approach for detecting DDoS attacks in IoT networks using a Convolutional Neural Network (CNN) combined with Long Short-Term Memory (LSTM) model. The proposed CNN-LSTM model processes network traffic features extracted from the CICIDS2017 dataset to classify normal and attack traffic. Experimental results show that the model achieves an accuracy of 99.2%, precision of 99.1%, and recall of 99.3%, outperforming state-of-the-art methods such as SVM and traditional LSTM. This approach offers a lightweight and efficient solution suitable for resource-constrained IoT environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Shah},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/UEMCON62879.2024.10754774},
