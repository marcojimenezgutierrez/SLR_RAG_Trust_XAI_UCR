@inproceedings{sokol_ventana_2025,
 abstract = {We present HaptiMap, a mobile augmented reality (AR) system that visualizes haptic feedback on physical surfaces. HaptiMap enables users to experience and interact with haptic patterns overlaid on everyday objects using a smartphone camera and a custom haptic glove. By combining computer vision for surface detection with vibrotactile rendering, our system bridges the gap between virtual haptic simulations and tangible interactions. We conducted a user study with 16 participants to evaluate HaptiMap's usability, intuitiveness, and effectiveness in tasks such as texture exploration and gesture-based control. Results show that users could accurately identify and replicate haptic cues with 92% success rate, reporting high immersion and low cognitive load. HaptiMap demonstrates potential applications in remote collaboration, accessibility, and haptic design prototyping, paving the way for more intuitive AR haptics in mobile contexts.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Sokol},
 booktitle = {Proceedings of the {Eighteenth}},
