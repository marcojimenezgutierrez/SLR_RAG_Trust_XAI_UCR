 x_enrich_ts = {2025-11-02T06:57:24Z},
 year = {2025}
}

@inproceedings{tufano_unveiling_2024,
 abstract = {We present a novel framework for generating diverse and controllable 3D-aware image synthesis from a single 2D image. Unlike existing methods that rely on large-scale 3D datasets or manual annotations, our approach leverages a pre-trained 2D diffusion model and a lightweight 3D reconstruction module to produce high-fidelity, multi-view consistent images. By incorporating a depth-aware attention mechanism and a geometry-guided sampling strategy, we enable fine-grained control over viewpoint, lighting, and object pose. Extensive experiments on benchmarks like ShapeNet and real-world images demonstrate that our method outperforms state-of-the-art baselines in terms of visual quality, diversity, and controllability, while requiring minimal computational overhead.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
