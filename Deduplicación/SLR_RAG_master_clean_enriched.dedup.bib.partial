@article{tang_automatic_2025,
 abstract = {Generative artificial intelligence (GenAI) has emerged as a transformative technology across various domains, including communications. This article provides a comprehensive survey on the applications of GenAI in physical layer communications. We begin by introducing the fundamentals of GenAI, encompassing key models such as generative adversarial networks (GANs), variational autoencoders (VAEs), diffusion models, and large language models (LLMs). Subsequently, we explore the diverse applications of GenAI in physical layer communications, including channel modeling and estimation, signal processing and modulation, beamforming and resource allocation, as well as security and privacy enhancement. Finally, we discuss the challenges and outline future research directions for integrating GenAI into physical layer communications, aiming to inspire further innovations in this rapidly evolving field.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Tang},
 doi = {10.1109/MCOM.002.2400280},
 issn = {1558-1896},
