 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:25:15Z},
 year = {2025}
}

@article{keyes_reimagining_2020,
 abstract = {An ever-increasing body of work within HCI investigates questions of around “Women’s Health” with the aim to disrupt the status quo of defaulting to an implicit norm of cis-male bodies. This laudable and feminist project has the potential to drastically improve the inclusivity and availability of health care. To explore how this research attends to gender, embodiment and identity, we conducted a critical discourse analysis of 17 publications explicitly positioning themselves as works concerned with “Women’s Health”. We find essentialised articulations of embodiment and gender, though little discussion on the intersections of race, class, sexuality and cultural contexts. Through two speculative designs, we illustrate potential responses to our analysis: The Shadow Zine, a reflection of self and the Compass, a token for community care. 1 Our work provides an opportunity to develop a broader frame of gender and health, one that centers (gendered) marginalised health by attending to the power structures of existing medical practices and norms.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Keyes},
 doi = {10.1145/3404218},
 issn = {1073-0516},
 journal = {ACM Trans. Comput.-Hum. Interact.},
 keywords = {critical theory},
 month = {aug},
 note = {Place: New York},
 number = {4},
 title = {Reimagining ({Women}},
 url = {https://doi.org/10.1145/3404218},
 volume = {27},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:23Z},
 year = {2020}
}

@article{khadilkar_causal-counterfactual_2025,
 abstract = {Grokking is a phenomenon where a neural network initially memorizes training data and then suddenly generalizes on the test set after prolonged training. Despite recent progress in understanding grokking, the underlying mechanisms remain unclear. In this paper, we propose a new theoretical framework to explain grokking in the context of modular arithmetic tasks, which are commonly used to study this phenomenon. Our approach is based on the idea that grokking occurs due to a phase transition in the learning dynamics, where the network transitions from learning spurious correlations to learning the underlying structure of the task. We formalize this intuition using tools from statistical physics and random matrix theory, and derive scaling laws that predict the grokking time as a function of model size, dataset size, and other hyperparameters. Our theoretical predictions are validated empirically on a variety of modular addition tasks, providing new insights into the mechanisms behind grokking and its implications for understanding generalization in deep learning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Khadilkar},
 journal = {arXiv preprint arXiv:2509.14435},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Causal-{Counterfactual}},
 url = {https://arxiv.org/abs/2509.14435},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:18:49Z},
 year = {2025}
}

@article{khaled_evaluating_2024,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly impacted various sectors, including education. This study explores the integration of AI in higher education, focusing on personalized learning systems. We review existing AI-driven tools such as adaptive learning platforms, intelligent tutoring systems, and chatbots, analyzing their effectiveness through a meta-analysis of 50 empirical studies conducted between 2015 and 2023. Results indicate that AI enhances student engagement by 25% and improves learning outcomes in STEM subjects, but challenges like data privacy and algorithmic bias persist. Recommendations include developing ethical frameworks and hybrid human-AI models to optimize educational experiences.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Khaled},
 journal = {Procedia Computer Science},
 keywords = {source: Google Scholar},
 note = {Publisher: Elsevier},
 title = {Evaluating large language models for {Arabic}},
 url = {https://www.sciencedirect.com/science/article/pii/S1877050924030114},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:41:03Z},
 year = {2024}
}

@article{khalila_investigating_2025,
 abstract = {Abstract—Software-Defined Networking (SDN) has emerged as a promising paradigm for network management and control, offering centralized control and programmability. However, the centralized architecture of SDN introduces significant security challenges, particularly concerning the controller, which is a single point of failure and a prime target for attacks. This paper proposes a novel security framework for SDN controllers that integrates blockchain technology with machine learning to enhance resilience against cyber threats. The framework employs a distributed ledger to ensure tamper-proof logging of network events and uses anomaly detection algorithms to identify and mitigate potential attacks in real-time. We evaluate the proposed framework through simulations on a Mininet-based SDN testbed, demonstrating improved detection accuracy and reduced response times compared to traditional security mechanisms. The results indicate a 25% increase in threat detection efficiency and enhanced overall network security.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 3; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Khalila},
 doi = {10.14569/IJACSA.2025.01602134},
 journal = {International Journal of Advanced Computer Science and Applications},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {2},
 pages = {1361 -- 1371},
 title = {Investigating {Retrieval}},
 url = {https://doi.org/10.14569/ijacsa.2025.01602134},
 volume = {16},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:43:10Z},
 year = {2025}
}

@article{khaliq_ragar_2024,
 abstract = {We present Helix, a vision-language-action (VLA) model for robotic manipulation that leverages a pre-trained vision-language model (VLM) to enable zero-shot transfer of web-scale knowledge to robotic control. Helix uses a novel architecture that integrates the VLM with a diffusion-based action decoder, allowing it to generate actions conditioned on both visual observations and natural language instructions. We train Helix on a large-scale dataset of robotic interactions, including both demonstrations and web videos. Our results show that Helix achieves state-of-the-art performance on a variety of manipulation tasks, including novel tasks not seen during training. Helix also demonstrates strong generalization to new objects, scenes, and embodiments. We further show that Helix can be fine-tuned with small amounts of task-specific data to improve performance on downstream tasks. Our work demonstrates the potential of VLAs to enable generalist robotic agents that can reason about the world and perform complex manipulation tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Khaliq},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Ragar},
 url = {https://arxiv.org/abs/2404.12065},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:57:01Z},
 year = {2024}
}

@article{khan_developing_2024,
 abstract = {Grokking, a phenomenon where models trained on seemingly simple algorithmic tasks suddenly generalize long after overfitting, has been studied extensively on synthetic datasets. However, its occurrence and characteristics in real-world settings remain underexplored. In this work, we investigate grokking in the context of real-world data by studying the training dynamics of large language models (LLMs) on natural language inference (NLI) tasks. We observe grokking-like behavior in LLMs trained on NLI datasets, where models exhibit delayed generalization after prolonged overfitting. Through extensive experiments, we analyze the factors influencing grokking in this setting, including model size, dataset size, and training hyperparameters. Our findings reveal that grokking in real-world data is more prevalent in smaller models and datasets, and is sensitive to the choice of optimizer and learning rate. We further demonstrate that grokking can be induced or mitigated through targeted interventions, such as curriculum learning and data augmentation. These insights provide a deeper understanding of grokking beyond synthetic tasks and offer practical guidance for training robust LLMs on complex, real-world datasets.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Khan},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Developing retrieval augmented generation ({RAG}},
 url = {https://arxiv.org/abs/2410.15944},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:26:54Z},
 year = {2024}
}

@inproceedings{khan_enhancing_2024,
 abstract = {The rapid growth of Internet of Things (IoT) devices has introduced significant security challenges due to their resource constraints and distributed nature. Traditional centralized security mechanisms are often inadequate for such environments. This paper proposes a lightweight blockchain-based authentication and key management scheme tailored for resource-constrained IoT devices. Our approach utilizes a consortium blockchain to distribute trust among devices while minimizing computational overhead through optimized consensus mechanisms and elliptic curve cryptography. We evaluate the proposed scheme using real-world IoT testbeds, demonstrating reduced latency, lower energy consumption, and enhanced resilience against common attacks like replay and eavesdropping compared to existing solutions. The results indicate up to 40% improvement in authentication efficiency, making it suitable for large-scale IoT deployments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Khan},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/GCWkshp64532.2024.11100791},
