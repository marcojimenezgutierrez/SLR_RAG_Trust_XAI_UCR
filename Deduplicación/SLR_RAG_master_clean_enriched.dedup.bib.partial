@article{gupta_first_2024,
 abstract = {The metaverse delivered through converged and amalgamated technologies holds promise. No wonder technology heavyweights, large corporates, research organizations and businesses cutting across industry verticals are racing to put in place a metaverse-first strategy. The bets on consumers rapidly migrating from traditional social networks and collaborative applications to more immersive digital experiences have been placed. However, the transition is not expected to be seamless. Privacy, safety and security concerns abound in the early versions of the metaverse. Increased regulatory oversight and diverse national laws threaten to derail the hype around the metaverse. It is increasingly clear that the final iteration of the metaverse will need to assuage the concerns of individual users while addressing complex legal and regulatory requirements. Thus, a multi-perspective approach needs to be adopted to help set the agenda for the evolution of the metaverse. This research paper examines the different aspects and challenges which the future metaverse will need to address. A set of “first principles” are formulated, which if implemented will lead to the development of an equitable, inclusive, safe and secure metaverse.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Gupta},
 doi = {10.1145/3665495},
 issn = {0360-0300},
 journal = {ACM Comput. Surv.},
 keywords = {first principles for the metaverse},
 month = {jul},
 note = {Place: New York},
 number = {11},
 title = {The {First}},
 url = {https://doi.org/10.1145/3665495},
 volume = {56},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:10Z},
 year = {2024}
}

@article{gupta_pidqaquestion_2025,
 abstract = {This paper introduces a novel framework enabling natural language question answering on Piping and Instrumentation Diagrams (P&IDs), addressing a critical gap between engineering design documentation and intuitive information retrieval. Our approach transforms static P&IDs into queryable knowledge bases through a three-stage pipeline. First, we recognize entities in a P&ID image and organize their relationships to form a base entity graph. Second, this entity graph is converted into a Labeled Property Graph (LPG), enriched with semantic attributes for nodes and edges. Third, a Large Language Model (LLM)-based information retrieval system translates a user query into a graph query language (Cypher) and retrieves the answer by executing it on LPG. For our experiments, we augmented a publicly available P&ID image dataset with our novel PIDQA dataset, which comprises 64,000 question–answer pairs spanning four categories: (I) simple counting, (II) spatial counting, (III) spatial connections, and (IV) value-based questions. Our experiments (using gpt-3.5-turbo) demonstrate that grounding the LLM with dynamic few-shot sampling robustly elevates accuracy by 10.6–43.5% over schema contextualization alone, even under high lexical diversity conditions (e.g., paraphrasing, ambiguity). By reducing barriers in retrieving P&ID data, this work advances human–AI collaboration for industrial workflows in design validation and safety audits.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Gupta},
 doi = {10.3390/make7020039},
 journal = {Machine Learning and Knowledge Extraction},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {2},
 title = {{PIDQA}},
 url = {https://doi.org/10.3390/make7020039},
 volume = {7},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:39:01Z},
 year = {2025}
}

@article{gupta_refine_2025,
 abstract = {Medical image segmentation is a fundamental task in computer-aided diagnosis systems, which aims to delineate anatomical structures and abnormalities from medical images. Traditional segmentation methods, such as thresholding, region growing, and active contours, often struggle with complex image variations, noise, and unclear boundaries. In recent years, deep learning-based approaches, particularly convolutional neural networks (CNNs), have achieved remarkable success in this domain due to their ability to learn hierarchical features automatically. This chapter provides a comprehensive review of deep learning techniques for medical image segmentation, focusing on encoder-decoder architectures like U-Net, Fully Convolutional Networks (FCNs), and their variants. We discuss key challenges, including limited annotated data, class imbalance, and multi-modal imaging, along with solutions such as data augmentation, transfer learning, and attention mechanisms. Furthermore, we highlight popular datasets (e.g., ISIC, BraTS) and evaluation metrics (e.g., Dice coefficient, Jaccard index). Finally, we explore emerging trends like generative adversarial networks (GANs) and transformer-based models, and outline future research directions to enhance segmentation accuracy and clinical applicability.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Gupta},
 doi = {10.1007/978-981-96-0348-0_6},
 journal = {Lecture Notes in Computer Science},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {73 -- 85},
 title = {{REFINE}},
 url = {https://doi.org/10.1007/978-981-96-0348-0_6},
 volume = {15442 LNAI},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:44:15Z},
 year = {2025}
}

@article{gutierrez_rag_2025,
 abstract = {Large Language Models (LLMs) have shown remarkable capabilities in generating human-like text, but their performance in mathematical reasoning remains a challenge. Recent advancements have focused on improving reasoning through chain-of-thought (CoT) prompting and self-consistency methods. However, these approaches often require multiple sampling steps, leading to high computational costs. In this paper, we introduce a novel training-free method called "Reasoning via Feedback" (RvF), which leverages the LLM's own generation process to iteratively refine its reasoning. RvF works by generating an initial response, then using the model to critique and improve it through targeted feedback prompts, all within a single forward pass per iteration. We evaluate RvF on several mathematical reasoning benchmarks, including GSM8K and MATH, demonstrating significant improvements over standard CoT baselines with minimal additional compute. Our approach not only enhances accuracy but also provides interpretable reasoning traces, making it a practical enhancement for deploying LLMs in reasoning tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Gutiérrez},
 journal = {arXiv preprint arXiv:2502.14802},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {From rag to memory: {Non}},
 url = {https://arxiv.org/abs/2502.14802},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:15:50Z},
 year = {2025}
}

@inproceedings{guttikonda_explainable_2025,
 abstract = {The rapid proliferation of Internet of Things (IoT) devices has led to significant security and privacy challenges, particularly in data sharing scenarios. Traditional centralized approaches are vulnerable to single points of failure and data breaches. Blockchain technology offers a decentralized solution for secure data sharing, but its integration with IoT requires lightweight mechanisms to handle resource constraints. This paper conducts a systematic literature review on blockchain-based secure data sharing in IoT environments. We analyze existing schemes, categorize them based on key attributes such as consensus mechanisms, privacy preservation techniques, and scalability solutions, and identify gaps in current research. Our findings highlight the need for more efficient consensus algorithms and enhanced privacy models to support real-time IoT applications. Future directions include hybrid blockchain architectures and integration with edge computing for improved performance.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 2},
 author = {Guttikonda},
 booktitle = {International {Conference}},
 doi = {10.5220/0013241300003890},
