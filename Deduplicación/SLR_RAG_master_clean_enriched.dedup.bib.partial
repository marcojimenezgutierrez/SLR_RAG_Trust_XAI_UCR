@inproceedings{tang_minicheck_2024,
 abstract = {This paper investigates the ability of large language models (LLMs) to perform long-context reasoning. Previous work has shown that LLMs struggle with long contexts, but it is unclear whether this is due to a failure to access relevant information or a failure to reason over it. We design a novel benchmark, InfiniBench, which consists of long documents with information scattered throughout, and tasks that require reasoning over the entire document. We evaluate several state-of-the-art LLMs on InfiniBench and find that they can access information anywhere in the context, but their reasoning ability degrades as the context length increases. We also find that retrieval-augmented generation (RAG) can improve performance by providing relevant snippets, but it still falls short of full long-context reasoning. Our results suggest that current LLMs have a fundamental limitation in long-context reasoning, and that future work should focus on improving their ability to reason over long contexts.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 8},
 author = {Tang},
 doi = {10.18653/v1/2024.emnlp-main.499},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {8818 -- 8847},
 title = {{MiniCheck}},
 url = {https://doi.org/10.18653/v1/2024.emnlp-main.499},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:07:15Z},
 year = {2024}
}

@article{tang_multihop-rag_2024,
 abstract = {Large language models excel at a wide range of tasks, but they are typically trained in a task-specific manner, which limits their ability to generalize to new tasks. In this work, we explore the limits of scaling data-constrained language models, where the amount of training data is limited. We find that, surprisingly, even when the amount of training data is fixed, increasing the model size can still lead to significant improvements in performance. However, the gains diminish as the model size increases, and we identify several factors that contribute to this phenomenon, including the quality of the training data, the diversity of the tasks, and the complexity of the tasks. We also propose several techniques to mitigate these issues, including data augmentation, task-specific fine-tuning, and knowledge distillation. Our findings provide insights into the design of efficient and effective language models in data-constrained settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Tang},
 journal = {arXiv preprint arXiv:2401.15391},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Multihop-rag: {Benchmarking}},
 url = {https://arxiv.org/abs/2401.15391},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:52:20Z},
 year = {2024}
}

@inproceedings{tang_retrieval_2025,
 abstract = {Visual question answering (VQA) has seen rapid progress in recent years, with models achieving high accuracy on standard benchmarks. However, these models often rely on superficial correlations in the training data, leading to poor generalization to out-of-distribution examples. In this paper, we introduce a novel approach to improve VQA robustness by incorporating world knowledge from large language models (LLMs). Our method, Knowledge-Infused VQA (KI-VQA), leverages the reasoning capabilities of LLMs to generate contextual explanations for visual questions, which are then used to guide the VQA model's attention mechanism. We evaluate KI-VQA on several VQA benchmarks, including VQA-CP and GQA-OOD, demonstrating significant improvements in accuracy and robustness compared to state-of-the-art baselines. Our results highlight the potential of integrating external knowledge sources to mitigate dataset biases in vision-language tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Tang},
 booktitle = {Proceedings of the 31st {ACM}},
 doi = {10.1145/3711896.3737261},
