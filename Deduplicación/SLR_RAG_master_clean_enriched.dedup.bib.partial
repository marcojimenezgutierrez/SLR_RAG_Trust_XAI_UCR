@inproceedings{patel_large_2025,
 abstract = {The rapid growth of Internet of Things (IoT) devices has led to an exponential increase in data generation, necessitating efficient data management and analysis techniques. This paper proposes a novel framework for federated learning in IoT environments, integrating edge computing to enhance privacy preservation and reduce latency. We introduce a lightweight aggregation algorithm that optimizes model updates across distributed devices while mitigating communication overhead. Experimental evaluations on real-world datasets demonstrate that our approach achieves up to 25% improvement in accuracy compared to traditional federated learning methods, with significant reductions in energy consumption suitable for resource-constrained IoT networks.},
