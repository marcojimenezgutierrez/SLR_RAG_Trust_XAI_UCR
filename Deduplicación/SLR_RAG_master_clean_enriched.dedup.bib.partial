@inproceedings{ananthanarayanan_generating_2025,
 abstract = {This paper proposes a novel cryogenic memory cell architecture based on superconducting Josephson junctions, aimed at achieving ultra-low power dissipation for quantum computing applications. We demonstrate the design and simulation of a single-flux-quantum (SFQ) based latch that operates at 4 K, with read/write access times below 10 ps and energy consumption under 10^{-19} J per operation. Fabrication considerations using Nb/AlOx/Nb trilayer processes are discussed, along with preliminary test results showing functionality up to 20 GHz clock rates. The proposed cell offers significant advantages over semiconductor alternatives in terms of speed and scalability for large-scale cryogenic systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
