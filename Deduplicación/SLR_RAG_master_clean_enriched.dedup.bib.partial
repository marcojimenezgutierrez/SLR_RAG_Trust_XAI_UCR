 pages = {608--615},
 title = {{RAG}},
 url = {https://doi.org/10.1109/trustcom63139.2024.00098},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:50:51Z},
 year = {2024}
}

@inproceedings{jeong_4bit-quantization_2024,
 abstract = {Abstract—Federated Learning (FL) has emerged as a promising paradigm for collaborative model training across distributed devices while preserving data privacy. However, real-world deployments of FL, particularly in resource-constrained environments like the Internet of Things (IoT), face significant challenges including communication overhead, heterogeneous data distributions, and vulnerability to adversarial attacks. This paper proposes a novel Privacy-Preserving Federated Learning framework tailored for Edge Computing in IoT ecosystems (PPFL-Edge). Our approach integrates differential privacy mechanisms with secure multi-party computation to enhance privacy guarantees without compromising model utility. We introduce an adaptive aggregation algorithm that dynamically adjusts to data heterogeneity and network conditions, reducing communication costs by up to 40% compared to traditional FL methods. Extensive experiments on benchmark IoT datasets demonstrate that PPFL-Edge achieves superior accuracy (improved by 15-20%) and robustness against poisoning attacks, making it suitable for practical deployments in smart cities and healthcare applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Jeong},
