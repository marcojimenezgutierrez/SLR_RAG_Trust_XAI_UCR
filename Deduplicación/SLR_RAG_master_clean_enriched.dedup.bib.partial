@article{abshari_llm-assisted_2024,
 abstract = {Cyber-physical systems (CPS) integrate computational and physical processes, where anomalies can lead to catastrophic failures. Traditional anomaly detection methods often rely on domain-specific knowledge to define physical invariants, which are challenging to extract manually for complex systems. This paper introduces a novel framework that leverages large language models (LLMs) to automate the extraction of physical invariants from natural language descriptions and codebases of CPS. The extracted invariants are formalized into logical constraints and integrated into a hybrid anomaly detection system combining model-based and data-driven techniques. We evaluate our approach on benchmark CPS datasets, including water distribution and power systems, demonstrating significant improvements in detection accuracy and false positive reduction compared to baseline methods. Our work highlights the potential of LLMs in bridging the gap between high-level system specifications and low-level anomaly detection in safety-critical applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Abshari},
 journal = {arXiv preprint arXiv:2411.10918},
 keywords = {source: Google Scholar},
 note = {Publisher: researchgate.net
Type: PDF},
 title = {Llm-assisted physical invariant extraction for cyber-physical systems anomaly detection},
 url = {https://www.researchgate.net/profile/Danial-Abshari/publication/385920298_LLM-assisted_Physical_Invariant_Extraction_for_Cyber-Physical_Systems_Anomaly_Detection/links/679c8c94207c0c20fa6b0b57/LLM-assisted-Physical-Invariant-Extraction-for-Cyber-Physical-Systems-Anomaly-Detection.pdf},
