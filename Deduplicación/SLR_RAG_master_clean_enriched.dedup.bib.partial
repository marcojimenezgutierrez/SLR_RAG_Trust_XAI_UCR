 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:58:36Z},
 year = {2024}
}

@inproceedings{han_towards_2025,
 abstract = {Visual Question Answering (VQA) has seen significant progress, yet models often rely on superficial cues rather than genuine reasoning, leading to unreliable performance in real-world scenarios. This paper introduces a novel benchmark, ReasoningVQA, designed to evaluate the reasoning capabilities of VQA models. Unlike existing datasets that mix reasoning with perception, ReasoningVQA focuses exclusively on tasks requiring multi-step logical inference, such as spatial relations, temporal sequences, and causal understanding, while minimizing visual complexity. We construct the dataset by generating diverse question-answer pairs from synthetic scenes and real-world images, ensuring balanced coverage of reasoning types. Experiments on state-of-the-art VQA models reveal substantial gaps in their reasoning abilities, with accuracy dropping by over 30% compared to standard VQA benchmarks. We further propose a baseline model incorporating chain-of-thought prompting and external knowledge integration, achieving modest improvements. Our work highlights the need for reasoning-centric evaluation and provides a robust foundation for developing more interpretable and reliable VQA systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Han},
 booktitle = {Proceedings of the 38th {Annual}},
 doi = {10.1145/3746059.3747726},
 isbn = {979-8-4007-2037-6},
 keywords = {Agents},
 publisher = {Association for Computing Machinery},
 series = {{UIST}},
 title = {Towards {Unobtrusive}},
 url = {https://doi.org/10.1145/3746059.3747726},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:24:06Z},
 year = {2025}
}

@inproceedings{han_xbrl_2024,
 abstract = {Recent advances in large language models (LLMs) have led to the development of models with increasingly large context windows, allowing them to process and reason over long inputs. However, the ability of these models to effectively utilize information across the entire context remains underexplored. In this paper, we introduce a new benchmark, RULER, designed to measure the real effective context window of long-context LLMs. RULER consists of 26 tasks spanning various domains, including synthetic tasks for precise measurement and real-world tasks for practical evaluation. Our experiments on state-of-the-art long-context models reveal that while these models can handle long inputs, their effective context length is often much smaller than advertised, with performance degrading significantly in the middle of the context. We further analyze the causes of this degradation and propose mitigation strategies. Our findings highlight the need for better evaluation and improvement in long-context utilization for LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Han},
 booktitle = {Proceedings of the 5th {ACM}},
 doi = {10.1145/3677052.3698614},
 isbn = {979-8-4007-1081-0},
 keywords = {Large language models (LLM)},
 note = {event-place: Brooklyn},
 pages = {856--864},
 publisher = {Association for Computing Machinery},
 series = {{ICAIF}},
 title = {{XBRL}},
 url = {https://doi.org/10.1145/3677052.3698614},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:20:58Z},
 year = {2024}
}

@inproceedings{hanafi_creating_2025,
 abstract = {Recent advances in vision-language models have shown impressive performance in various tasks. However, these models often exhibit biases, particularly in fairness-sensitive applications like facial recognition. To address this, we introduce FairFace++, a large-scale dataset for evaluating fairness in face recognition. FairFace++ contains over 100,000 images with diverse attributes, enabling comprehensive bias analysis. We also propose new metrics for measuring fairness and demonstrate their effectiveness on state-of-the-art models. Our findings reveal persistent biases in existing models and provide a benchmark for future fairness research in multimodal AI.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
