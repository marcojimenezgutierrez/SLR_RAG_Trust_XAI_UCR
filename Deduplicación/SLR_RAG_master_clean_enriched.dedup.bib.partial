 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Halueval-wild: {Evaluating}},
 url = {https://arxiv.org/abs/2403.04307},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:05:31Z},
 year = {2024}
}

@inproceedings{zhu_hybrid_2025,
 abstract = {This paper proposes a novel diffusion-based model for high-fidelity neural audio codec, termed DiffCodec, which leverages a hierarchical variational autoencoder (VAE) structure to achieve superior compression efficiency and perceptual quality. Unlike traditional neural audio codecs that rely on autoregressive or GAN-based generation, DiffCodec employs a cascaded diffusion process to model the temporal and spectral dependencies in audio signals. We conduct extensive experiments on standard benchmarks such as LibriTTS and VCTK, demonstrating that DiffCodec outperforms state-of-the-art methods in terms of bitrate, reconstruction SNR, and subjective MOS scores. Our approach also enables flexible rate control and supports real-time decoding, making it suitable for applications in streaming and edge devices.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Zhu},
 booktitle = {Proceedings - {ICASSP}},
