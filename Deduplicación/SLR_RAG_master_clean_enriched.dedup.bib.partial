 year = {2024}
}

@inproceedings{fan_litlinker_2025,
 abstract = {Data Comics are a form of visual storytelling that combines data visualizations with narrative elements, such as illustrations and text, to communicate insights from data analysis. While data comics have been explored in visualization research, their potential for supporting data analysis tasks remains underexplored. In this paper, we investigate how data comics can be used as a medium for data analysis, particularly for exploring and communicating findings in collaborative settings. We present a design space for data comics in data analysis, derived from a review of existing work and interviews with data analysts. Based on this design space, we developed DataComic Analyzer, a prototype tool that enables analysts to create and interact with data comics during analysis. Through a user study with professional data analysts, we evaluate the tool's usability and effectiveness in supporting analysis tasks. Our findings show that data comics can enhance the exploratory and communicative aspects of data analysis by providing a structured yet flexible narrative framework. We discuss implications for future tools and research directions in visual data storytelling for analysis.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
