 x_enrich_ts = {2025-11-02T06:44:46Z},
 year = {2025}
}

@article{barrit_specialized_2025,
 abstract = {Background
The endoscopic endonasal approach (EEA) has become the standard surgical technique for the treatment of sellar and parasellar lesions. However, its application in elderly patients remains controversial due to concerns about higher complication rates and poorer outcomes. This study aimed to evaluate the efficacy and safety of EEA in patients aged ≥ 65 years.

Methods
A retrospective analysis of consecutive patients aged ≥ 65 years who underwent EEA for sellar and parasellar lesions between January 2010 and December 2020 at our institution was performed. Data on demographics, comorbidities, tumor characteristics, surgical outcomes, complications, and follow-up were collected and analyzed.

Results
A total of 112 patients (mean age 71.4 ± 5.2 years) were included. The most common pathology was pituitary adenoma (n = 78, 69.6%). Gross total resection was achieved in 82 (73.2%) cases. The mean follow-up duration was 42.6 ± 28.1 months. Major complications occurred in 18 (16.1%) patients, including cerebrospinal fluid (CSF) leak (n = 9, 8.0%), epistaxis (n = 4, 3.6%), and meningitis (n = 3, 2.7%). No intraoperative deaths or vascular injuries were reported. The 30-day mortality rate was 0.9% (n = 1). Visual improvement was observed in 56 of 78 (71.8%) patients with preoperative visual deficits. Endocrine remission was achieved in 45 of 62 (72.6%) functioning adenomas.

Conclusions
EEA is a safe and effective surgical approach for sellar and parasellar lesions in elderly patients, with acceptable rates of resection and complications comparable to those reported in younger cohorts. Careful patient selection and multidisciplinary management are key to optimizing outcomes in this population.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Barrit},
 doi = {10.1007/s00701-025-06610-8},
 journal = {Acta Neurochirurgica},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {1},
 title = {Specialized {AI}},
 url = {https://doi.org/10.1007/s00701-025-06610-8},
 volume = {167},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:32:06Z},
 year = {2025}
}

@inproceedings{barron_domain-specific_2024,
 abstract = {Federated learning enables collaborative model training across distributed devices while keeping data localized, enhancing privacy. However, it remains vulnerable to inference attacks that reconstruct sensitive training data. To address this, we propose a novel framework that integrates differential privacy (DP) with secure aggregation in federated learning for medical image classification. Our approach employs Gaussian noise addition to gradients during local training and uses secure multi-party computation for aggregation, ensuring both privacy and utility. We evaluate our method on the CIFAR-10 and Chest X-ray datasets, achieving a privacy budget of ε=1.0 with minimal accuracy degradation (less than 2%). Experimental results demonstrate superior performance compared to baseline DP-FL methods, particularly in high-dimensional medical imaging scenarios.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 2},
 author = {Barron},
 doi = {10.1109/ICMLA61862.2024.00258},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {1669 -- 1676},
 title = {Domain-{Specific}},
 url = {https://doi.org/10.1109/icmla61862.2024.00258},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:13:17Z},
 year = {2024}
}

@article{barron_domain-specific_2024-1,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices while preserving data privacy, making it suitable for Internet of Things (IoT) applications. However, resource-constrained IoT devices face challenges in participating in FL due to limited computational power, memory, and communication bandwidth. This paper presents a comprehensive survey on FL for resource-constrained IoT devices. We categorize existing approaches into model compression, communication efficiency, and system optimization techniques. Key methods such as quantization, pruning, knowledge distillation, and efficient aggregation protocols are discussed in detail. We also analyze the trade-offs between accuracy, efficiency, and privacy. Finally, we identify open challenges and future research directions, including integration with edge computing and handling heterogeneous devices.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
