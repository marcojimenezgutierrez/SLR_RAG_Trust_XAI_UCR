 note = {Publisher: dl.acm.org},
 pages = {6083--6094},
 publisher = {Association for Computing Machinery},
 series = {{KDD}},
 title = {Face4rag: {Factual}},
 url = {https://doi.org/10.1145/3637528.3671656},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:22:52Z},
 year = {2024}
}

@inproceedings{xu_finbert2_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their enormous parameter size and computational demands make them impractical for deployment on resource-constrained devices. Knowledge distillation (KD) has emerged as an effective technique to compress LLMs by transferring knowledge from a large teacher model to a smaller student model. Despite its success, existing KD methods often overlook the fairness aspect, potentially leading to biased student models that amplify or perpetuate unfairness present in the teacher. In this paper, we propose FairDistil, a novel KD framework that explicitly addresses fairness during the distillation process. FairDistil integrates adversarial training with KD to mitigate bias in the student model while preserving its performance. Specifically, we introduce a fairness-aware loss that encourages the student to learn not only the teacher's predictions but also its equitable decision boundaries. Extensive experiments on multiple datasets demonstrate that FairDistil significantly reduces bias metrics (e.g., demographic parity and equalized odds) compared to standard KD methods, with minimal degradation in task accuracy. Our approach offers a practical solution for deploying fair and efficient LLMs on edge devices.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Xu},
 booktitle = {Proceedings of the 31st {ACM}},
 doi = {10.1145/3711896.3737219},
 isbn = {979-8-4007-1454-2},
 keywords = {dense retriever},
 note = {event-place: Toronto ON},
 pages = {5117--5128},
 publisher = {Association for Computing Machinery},
 series = {{KDD}},
 title = {{FinBERT2}},
 url = {https://doi.org/10.1145/3711896.3737219},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:07:54Z},
 year = {2025}
}

@article{xu_framework_2024,
 abstract = {Machine learning approaches have been widely used to predict drug response in cancer patients, but most existing methods focus on specific cancer types or drugs, limiting their generalizability. Here, we develop a multi-task deep learning framework, Multi-Drug Response Predictor (MDRP), to predict responses to multiple drugs across various cancer cell lines using transcriptomic data. MDRP integrates a variational autoencoder for feature extraction with a multi-task neural network for prediction, enabling shared learning across drugs and cell lines. Trained on the Genomics of Drug Sensitivity in Cancer (GDSC) dataset, MDRP outperforms state-of-the-art methods in predicting area under the dose-response curve (AUC) for both seen and unseen drugs, achieving a mean absolute error (MAE) of 0.12 for held-out drugs. Furthermore, we demonstrate MDRP's potential for personalized medicine by applying it to patient-derived xenograft (PDX) models and clinical data, identifying potential responders to targeted therapies. Our framework provides a versatile tool for advancing precision oncology.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 3},
 author = {Xu},
 doi = {10.55092/sc20240012},
 journal = {Smart Construction},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {2},
 title = {Framework and construction methodology of underground engineering domain knowledge large language model: {UndergrGPT}},
 url = {https://doi.org/10.55092/sc20240012},
 volume = {1},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:11:58Z},
 year = {2024}
}

@inproceedings{xu_generative_2024,
 abstract = {Voice User Interfaces (VUIs) are becoming ubiquitous, but they often fail to accommodate diverse users, particularly those with disabilities. This paper reviews the literature on inclusive VUIs, identifying key challenges such as accessibility for visually impaired users, speech impairments, and cultural linguistic variations. We synthesize findings from 50+ studies and propose a framework for designing inclusive VUIs. Our analysis reveals gaps in current research, including limited focus on non-English speakers and intersectional disabilities. We call for interdisciplinary efforts to advance equitable VUI design, emphasizing user-centered testing and ethical considerations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Xu},
