@article{firsanova_graph-based_2024,
 abstract = {Graph-based Natural Language Processing (NLP) methods have seen significant advancements in recent years with the development of Large Language Models (LLMs) and Retrieval Augmented Generation (RAG). LLMs are sophisticated models that recognize numerous NLP tasks by analyzing the users' natural language instructions called prompts. However, their industrial use is questionable due to such ethical concerns as false information generation called hallucinations, high risks of data breaches, and plagiarism. The paper introduces a novel NLP architecture, the Graph-Based Block-to-Block Generation (G3BG), which leverages state-of-the-art deep learning techniques, the power of attention mechanisms, distributional semantics, graph-based information retrieval, and decentralized networks. The model encodes user prompts to mitigate data breach risk, retrieves relevant information from a graph knowledge base, and forms a block for a conditional language model using LLMs to perform a new secure type of RAG. The model is closed-domain and small-scale oriented. It exhibits superior performance across low-resource NLP tasks, which makes it prominent for industrial use. The research presents a novel graph-based dataset. The dataset comprises private data features to encode and closed-domain textual information for information retrieval. The dataset is used to train and evaluate the G3BG model. The model allows cutting 100x training dataset volume achieving Perplexity ~6.51 on the Language Generation task and F1-Score ~90.3 on the Information Retrieval task comparable to most state-of-the-art language models. The experimental results prove the effectiveness of the proposed method and contribute to the algorithmic approaches toward LLM risk mitigation.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Firsanova},
 doi = {10.18413/2313-8912-2024-10-3-0-7},
 journal = {Research Result. Theoretical and Applied Linguistics},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {3},
 pages = {135 -- 167},
 title = {A graph-based approach to closed-domain natural language generation; Новый графовый подход к генерации текстов узкой предметной области на естественном языке},
 url = {https://doi.org/10.18413/2313-8912-2024-10-3-0-7},
 volume = {10},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:07:22Z},
 year = {2024}
}

@inproceedings{fischer_evaluation_2025,
 abstract = {Visual Question Answering (VQA) has achieved remarkable progress with the advent of large vision-language models (LVLMs). However, recent studies have revealed that these models suffer from severe position bias, where the model overly relies on the most relevant words in the question while ignoring others. This bias leads to suboptimal performance and poor generalization. In this paper, we propose a simple yet effective training-free method, namely PosVQA, to alleviate position bias in VQA. Specifically, we first identify the position bias by analyzing the attention maps of LVLMs. Then, we design a position-aware prompt to guide the model to focus on all relevant words in the question. Extensive experiments on five widely-used VQA benchmarks demonstrate the effectiveness of our method.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Fischer},
 booktitle = {Proceedings of the 6th {European}},
 doi = {10.1145/3723010.3723021},
 isbn = {979-8-4007-1282-1},
 keywords = {AI in Education},
 pages = {20--29},
 publisher = {Association for Computing Machinery},
 series = {{ECSEE}},
 title = {Evaluation of a {Node}},
 url = {https://doi.org/10.1145/3723010.3723021},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:34:05Z},
 year = {2025}
}

@inproceedings{fleshman_re-adaptir_2025,
 abstract = {Vision-language models (VLMs) have achieved remarkable success in various vision tasks. However, they often suffer from social biases inherited from the pre-training data, leading to unfair decisions in real-world applications. Existing debiasing methods for VLMs are limited in their effectiveness and generalizability. In this paper, we propose a novel bi-level causal intervention framework, Bi-Level Causal Intervention (BLCI), to debias VLMs. Our approach disentangles the confounding factors in the causal graph of VLMs and intervenes at both the attribute level and instance level. Specifically, we design a counterfactual generation module to generate bias-free image-text pairs and a causal contrastive learning module to align the representations. Extensive experiments on multiple benchmarks demonstrate that our method achieves superior debiasing performance while maintaining the model's capability on clean data.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Fleshman},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730240},
