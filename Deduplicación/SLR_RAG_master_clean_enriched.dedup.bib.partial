@book{asbai_mitigating_2024,
 abstract = {This study investigates the implementation of sustainable packaging solutions in the food industry, focusing on the transition from traditional plastic materials to bio-based alternatives. Through a combination of literature review, case studies from Swedish companies, and stakeholder interviews, the research identifies key barriers such as cost, scalability, and regulatory hurdles, as well as drivers like consumer demand and environmental regulations. The findings highlight the potential of mycelium-based packaging as a viable, low-impact option, offering recommendations for industry adoption and policy support to accelerate the shift towards circular economy principles.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
