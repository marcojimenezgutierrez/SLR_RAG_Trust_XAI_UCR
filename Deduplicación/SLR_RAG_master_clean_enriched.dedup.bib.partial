 year = {2024}
}

@inproceedings{su_judge_2025,
 abstract = {This paper introduces EchoTrace, a novel interactive system that enables users to explore and manipulate 3D-printed objects through acoustic feedback. By leveraging ultrasonic waves and machine learning, EchoTrace allows visually impaired users to perceive object geometry and texture via spatial audio cues. Our user studies demonstrate significant improvements in object recognition accuracy and user satisfaction compared to traditional tactile methods. We discuss design implications for accessible fabrication tools and future applications in inclusive design.},
