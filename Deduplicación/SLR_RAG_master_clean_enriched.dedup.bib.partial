@article{iacob_are_2025,
 abstract = {This chapter proposes a hybrid deep learning model for the classification of brain tumors using MRI images. The model combines convolutional neural networks (CNN) with long short-term memory (LSTM) networks to capture both spatial and temporal features. The dataset used is the Brain Tumor Segmentation (BraTS) challenge dataset, which includes multimodal MRI scans. Preprocessing steps include skull stripping, normalization, and data augmentation to handle class imbalance. The proposed model achieves an accuracy of 98.5%, outperforming state-of-the-art methods. Experimental results demonstrate the effectiveness of the hybrid approach in early detection and classification of brain tumors, aiding in timely medical intervention.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
