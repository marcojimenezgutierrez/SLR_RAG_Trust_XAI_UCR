 keywords = {Large Language Model},
 note = {event-place: Singapore},
 pages = {27--39},
 publisher = {Association for Computing Machinery},
 series = {{LMPL}},
 title = {Towards {Repository}},
 url = {https://doi.org/10.1145/3759425.3763382},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:36:09Z},
 year = {2025}
}

@inproceedings{zhou_1st_2025,
 abstract = {Deep neural networks (DNNs) have achieved remarkable success in various computer vision tasks. However, they often rely on spurious correlations in the training data, leading to poor generalization on distribution shifts. Existing methods to mitigate this issue typically require access to sensitive attributes or additional annotations, which may not be available in practice. In this paper, we propose a novel approach to improve fairness and robustness in visual recognition without requiring sensitive attributes. Our method leverages a fairness-aware regularization term that encourages the model to focus on causal features rather than spurious ones. We evaluate our approach on multiple benchmarks, including CelebA and UTKFace, demonstrating significant improvements in fairness metrics while maintaining high accuracy. Our results highlight the potential of this method for deploying fair AI systems in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Zhou},
