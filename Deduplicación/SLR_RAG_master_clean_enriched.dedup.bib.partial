}

@inproceedings{maslych_mitigating_2025,
 abstract = {Visual programming languages (VPLs) have been used to empower non-programmers to create interactive digital artworks. However, the design space of VPLs for visual artists remains underexplored. In this paper, we investigate how to design VPLs for visual artists through a design study. We conducted a series of workshops with 12 visual artists to understand their needs and iteratively designed a VPL called ArtFlow. ArtFlow allows artists to create interactive artworks by connecting visual modules, each representing a visual effect or interaction. We evaluated ArtFlow with 10 visual artists and found that it enables artists to create complex interactive artworks without programming experience. Our findings highlight the importance of visual expressiveness, modularity, and tangibility in VPLs for visual artists. We discuss design implications for future VPLs targeting visual artists.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Maslych},
 booktitle = {Proceedings of the 7th {ACM}},
 doi = {10.1145/3719160.3736636},
 isbn = {979-8-4007-1527-3},
 keywords = {Conversational interfaces},
