@article{wang_m-rag_2024,
 abstract = {Generalist robot policies that can perform a variety of tasks across different embodiments and environments are a promising direction for robot learning. However, existing methods for learning such policies often require large amounts of data and compute, and they do not generalize well to new tasks or embodiments. In this work, we study what matters in building generalist robot policies. We first introduce a new benchmark, RoboSuite Multi-Task, which consists of 10 diverse manipulation tasks in simulation. We then train a series of policies using different architectures, data modalities, and training objectives, and evaluate them on the benchmark. Our results show that (1) simple feedforward policies can achieve strong performance on the benchmark, (2) proprioceptive observations are sufficient for good performance, and (3) behavior cloning with a mixture of experts objective is effective for learning generalist policies. We also find that policies trained on a subset of the tasks can generalize to unseen tasks, suggesting that generalist policies can be learned from a small number of diverse tasks. Finally, we demonstrate that our policies transfer to a real robot arm, performing tasks such as picking and placing objects. Our code and models are available at https://generalist-robot.github.io.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wang},
 journal = {arXiv preprint arXiv:2405.16420},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {M-{RAG}},
 url = {https://arxiv.org/abs/2405.16420},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:52:45Z},
 year = {2024}
