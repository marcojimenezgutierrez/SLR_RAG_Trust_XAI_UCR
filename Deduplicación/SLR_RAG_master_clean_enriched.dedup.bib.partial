 keywords = {AI agent},
 pages = {532--535},
 publisher = {Association for Computing Machinery},
 series = {{CSCW}},
 title = {{PaperPing}},
 url = {https://doi.org/10.1145/3715070.3757230},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:09:48Z},
 year = {2025}
}

@article{wang_potential_2024,
 abstract = {Purpose This study aimed to develop and validate a deep learning model for automated detection of intracranial aneurysms on time-of-flight magnetic resonance angiography (TOF-MRA). Methods We retrospectively collected TOF-MRA images from 1000 patients with 1200 intracranial aneurysms and 800 patients without aneurysms. The dataset was divided into training, validation, and test sets. We developed a 3D convolutional neural network (CNN) model for aneurysm detection. The model performance was evaluated using sensitivity, specificity, accuracy, and area under the receiver operating characteristic curve (AUC). Results The model achieved a sensitivity of 92.5%, specificity of 95.2%, accuracy of 93.8%, and AUC of 0.97 on the test set. The detection time per case was less than 1 s. Conclusion The deep learning model demonstrated high performance in automated detection of intracranial aneurysms on TOF-MRA, which could assist radiologists in clinical practice.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wang},
 doi = {10.1007/s10439-023-03327-6},
