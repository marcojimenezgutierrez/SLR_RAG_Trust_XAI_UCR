@inproceedings{shen_gpiot_2025,
 abstract = {Social media platforms have become a primary source for seeking and providing support, yet little is known about the barriers that prevent people from seeking support online. We conducted a mixed-methods study with 20 bereaved parents to understand the barriers they face when seeking support on social media. Through 20 semi-structured interviews and a thematic analysis of 1,000 Reddit posts, we identified five key barriers: fear of burdening others, fear of judgment, lack of trust in online communities, emotional overwhelm, and privacy concerns. Our findings highlight the complex interplay between these barriers and suggest design implications for social media platforms to better support vulnerable users in seeking help.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
