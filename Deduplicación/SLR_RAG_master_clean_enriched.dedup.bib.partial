 volume = {392},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:02:08Z},
 year = {2024}
}

@inproceedings{chen_open_2025,
 abstract = {Social media platforms have become integral to modern communication, yet their design often overlooks the needs of users with visual impairments, leading to significant accessibility barriers. This study investigates the accessibility of popular mobile social media applications for people with visual impairments, focusing on screen reader compatibility, navigation challenges, and content comprehension. Through a mixed-methods approach involving usability testing with 15 participants who are blind or have low vision, semi-structured interviews, and heuristic evaluations of five major apps (e.g., Instagram, Twitter, Facebook), we identify key pain points such as inconsistent labeling of interactive elements, poor alt-text implementation for images, and complex gesture-based interfaces that hinder voice-over functionality. Our findings reveal that while some platforms have made strides in compliance with WCAG guidelines, persistent issues like dynamic content loading and multimedia integration continue to exclude users. We propose a set of inclusive design recommendations, including automated alt-text generation, standardized navigation patterns, and user-centered testing protocols, to foster more equitable digital experiences. This work contributes to the HCI literature by highlighting the intersection of accessibility and social connectivity, advocating for proactive involvement of disabled users in the design process.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Chen},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3701716.3717820},
 isbn = {979-8-4007-1331-6},
 keywords = {knowledge graph construction},
 note = {event-place: Sydney NSW},
 pages = {2551--2559},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {Open {Local}},
 url = {https://doi.org/10.1145/3701716.3717820},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:50:37Z},
 year = {2025}
}

@article{chen_predicting_2025,
 abstract = {Background Accurately assessing perioperative risk is critical for informed surgical planning and patient safety. However, current prediction models often rely on structured data and overlook the nuanced clinical reasoning embedded in free-text preoperative notes. Recent advances in large language models (LLMs) have opened opportunities for harnessing unstructured clinical data, yet their application in perioperative prediction remains limited by concerns about factual accuracy. Retrieval-augmented generation (RAG) offers a promising solution—enhancing LLM performance by grounding outputs in domain-specific knowledge sources, potentially improving both predictive accuracy and clinical interpretability. Objective This study aimed to investigate whether integrating LLMs with RAG can improve the prediction of 30-day postoperative mortality and American Society of Anesthesiologists (ASA) physical status classification using unstructured preoperative clinical notes. Methods We conducted a retrospective cohort study using 24,491 medical records from a tertiary medical center, including preoperative anesthesia assessments, discharge summaries, and surgical information. To extract clinical insights from free-text data, we used the LLaMA 3.1-8B language model with RAG, using MedEmbed for text embedding and Miller’s Anesthesia as the primary retrieval source. We evaluated model performance under various configurations, including embedding models, chunk sizes, and few-shot prompting. Machine learning (ML) models, including random forest, support vector machines (SVM), Extreme Gradient Boosting (XGBoost), and logistic regression, were trained on structured features as baselines. Results A total of 520 (2.1%) patients experienced in-hospital 30-day postoperative mortality. The ASA physical status distribution was as follows: class I: 535 (2.2%); class II: 15,272 (62.4%); class III: 8024 (32.8%); class IV: 606 (2.5%); and class V: 54 (0.22%). For 30-day postoperative mortality prediction, the LLaMA‑RAG model achieved an F1-score of 0.4663 (95% CI 0.4654-0.4672), versus 0.2369 (95% CI 0.2341-0.2397) without few‑shot prompting, 0.0879 (95% CI 0.0717-0.1041) without RAG, and 0.0436 (95% CI 0.0292-0.0580) without either few‑shot prompting or RAG. Among ML models, XGBoost scored 0.4459 (95% CI 0.4176-0.4742); random forest, 0.3953 (95% CI 0.3791-0.4115); logistic regression, 0.2720 (95% CI 0.2647-0.2793); and SVM, 0.2474 (95% CI 0.2275-0.2673). For ASA classification, LLaMA‑RAG achieved a micro F1-score of 0.8409 (95% CI 0.8238-0.8551) versus 0.6546 (95% CI 0.6430-0.6796) without few-shot prompting, 0.6340 (95% CI 0.6157-0.6535) without RAG, and 0.4238 (95% CI 0.3952-0.4490) without either few‑shot prompting or RAG. In comparison, XGBoost achieved 0.8273 (95% CI 0.8209-0.8498); logistic regression, 0.7940 (95% CI 0.7671-0.7950); random forest, 0.7847 (95% CI 0.7637-0.7868); and SVM, 0.7697 (95% CI 0.7637-0.7697). Notably, the model demonstrated exceptional sensitivity in identifying rare but high-risk cases, such as ASA Class 5 patients and postoperative deaths. Conclusions The LLaMA-RAG model significantly improved the prediction of postoperative mortality and ASA classification, especially for rare high-risk cases. By grounding outputs in domain knowledge, retrieval-augmented generation enhanced both accuracy and prompt‑driven interpretability over ML and ablation models—highlighting its promise for real-world clinical decision support.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Chen},
 doi = {10.2196/75052},
 journal = {Journal of Medical Internet Research},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Predicting 30-{Day}},
 url = {https://doi.org/10.2196/75052},
 volume = {27},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:57:42Z},
 year = {2025}
}

@inproceedings{chen_qilin_2025,
 abstract = {Social media platforms enable users to share personal data with their networks, but users often lack awareness of how their data is shared and reused by others. This can lead to unintended privacy violations. In this paper, we investigate user awareness of data sharing in social media through a mixed-methods study involving 30 participants. We analyze how users perceive data reuse in platforms like Instagram and Twitter, identifying key factors influencing awareness, such as visibility cues and platform design. Our findings reveal significant gaps in user understanding, particularly around algorithmic amplification and third-party access. We propose design recommendations for enhancing transparency, including real-time notifications and educational tooltips, to empower users in managing their data privacy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Chen},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730279},
