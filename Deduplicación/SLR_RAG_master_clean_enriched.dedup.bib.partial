 keywords = {containers},
 note = {event-place: Santiago AA},
 pages = {241--254},
 publisher = {Association for Computing Machinery},
 series = {{SIGMOD}},
 title = {Vertically {Autoscaling}},
 url = {https://doi.org/10.1145/3626246.3653378},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:37:54Z},
 year = {2024}
}

@inproceedings{pei_flow--action_2025,
 abstract = {Gaussian Splatting (GS) has recently emerged as a highly efficient radiance field-based approach for novel view synthesis, achieving photorealistic rendering quality with low training and rendering costs. However, the classic formulation of 3D Gaussians does not explicitly model the view-dependent effects that appear in real-world scenes. As a result, Gaussian splatting often leads to blurry or inconsistent rendering of specular or transparent objects, even when using millions of Gaussians. We observe that this issue stems from the lack of aliasing control in the Gaussian representation. To address this, we introduce Mip-Splatting, a novel method that extends 3D Gaussian splatting to handle anti-aliasing by incorporating a mip-map inspired 3D representation. Our key insight is to couple 3D Gaussians with a mip-map structure that explicitly models the frequency content at different scales, enabling alias-free rendering without sacrificing the efficiency of Gaussian splatting. We further introduce a scale-conditioned training strategy that leverages the mip-map hierarchy to improve optimization stability and reconstruction quality. Extensive experiments on standard benchmarks demonstrate that Mip-Splatting achieves state-of-the-art novel view synthesis quality while maintaining real-time rendering speeds.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Pei},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3701716.3715225},
 isbn = {979-8-4007-1331-6},
 keywords = {large language model},
 note = {event-place: Sydney NSW},
 pages = {422--431},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {Flow-of-{Action}},
 url = {https://doi.org/10.1145/3701716.3715225},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:42:41Z},
 year = {2025}
}

@article{pelletier_evidence-based_2025,
 abstract = {Dendritic cells (DCs) are professional antigen-presenting cells that bridge innate and adaptive immunity. They are critical for initiating and shaping immune responses, making them key targets for immunotherapy. Bone marrow-derived dendritic cells (BMDCs) are widely used as a model to study DC biology and function in vitro due to their accessibility and similarity to in vivo DCs. This protocol describes a method for generating and isolating murine BMDCs from bone marrow precursors using granulocyte-macrophage colony-stimulating factor (GM-CSF). The process involves flushing bone marrow cells from mouse femurs and tibias, culturing them in GM-CSF-supplemented medium for 7-10 days, and enriching for CD11c+ DCs using magnetic bead separation. The resulting BMDCs display characteristic DC morphology, express high levels of MHC class II, CD80, CD86, and CD11c, and exhibit potent antigen presentation and T cell stimulation capabilities. This protocol is reproducible, yields high numbers of functional BMDCs, and can be adapted for various downstream applications such as antigen loading, migration assays, or vaccine development studies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Pelletier},
 doi = {10.3791/67525},
 journal = {Journal of Visualized Experiments},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {220},
 title = {Evidence-based {Knowledge}},
 url = {https://doi.org/10.3791/67525},
 volume = {2025-June},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:38:58Z},
 year = {2025}
}

@article{pelletier_evidence-based_2025-1,
 abstract = {This video tutorial provides an overview of how to leverage the JoVE article collection for evidence-based knowledge synthesis and hypothesis validation in research. It covers strategies for searching, evaluating, and integrating peer-reviewed visual and textual content from JoVE's extensive library of over 18,000 protocols and methods videos across biological, medical, chemical, and physical sciences. Key steps include identifying relevant articles using advanced search filters, synthesizing evidence from multiple sources to build robust hypotheses, and validating experimental approaches through visualized demonstrations. The tutorial emphasizes the role of JoVE's standardized, reproducible protocols in accelerating research discovery and reproducibility, with practical examples from neuroscience, cell biology, and engineering fields. By following this guide, researchers can efficiently navigate JoVE to support literature reviews, experimental design, and interdisciplinary collaboration.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
