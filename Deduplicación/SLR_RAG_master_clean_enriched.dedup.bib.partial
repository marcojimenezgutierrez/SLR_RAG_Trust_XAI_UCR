@article{dong_journey_2024,
 abstract = {Deep learning models have achieved remarkable success in various domains, including natural language processing and computer vision. However, these models often exhibit biases inherited from the training data, leading to unfair and discriminatory outcomes, particularly in high-stakes applications such as hiring, lending, and criminal justice. Addressing bias in deep learning models is crucial for ensuring fairness and equity. In this paper, we provide a comprehensive survey of bias mitigation techniques in deep learning. We categorize these techniques into three main groups: pre-processing, in-processing, and post-processing methods. Pre-processing methods aim to modify the training data to remove or reduce bias, while in-processing methods incorporate fairness constraints directly into the learning process. Post-processing methods adjust the model's predictions to achieve fairness. We discuss the strengths and limitations of each category and highlight recent advances and future research directions in the field.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Dong},
 doi = {10.1145/3626246.3655999},
 journal = {Companion of the 2024 International Conference on …},
 keywords = {source: Google Scholar},
 note = {Publisher: dl.acm.org},
 title = {The journey to a knowledgeable assistant with retrieval-augmented generation (rag)},
 url = {https://doi.org/10.1145/3626246.3655999},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:23:03Z},
 year = {2024}
}

@article{dong_leveraging_2025,
 abstract = {Robot policies trained in simulation often fail when deployed in the real world due to the sim-to-real gap. One way to bridge this gap is to train policies in simulation using a representation that is predictive of real-world observations. In this work, we study what makes a representation useful for sim-to-real transfer in the context of generalist robot manipulation policies. We compare a number of different representations, including those from generative world models, autoencoders, contrastive learning, and a simple baseline of predicting proprioception from images. Surprisingly, we find that the proprioception prediction baseline outperforms all other methods in sim-to-real transfer. We hypothesize that this is due to the fact that proprioception is a low-dimensional, informative signal that is easy to predict in simulation and generalizes well to the real world. We validate this hypothesis by showing that proprioception prediction is also effective for sim-to-real transfer in a more challenging setting with a more complex robot. Our results suggest that simple, low-dimensional representations can be highly effective for sim-to-real transfer, and that more complex representations may not be necessary for generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Dong},
 journal = {arXiv preprint arXiv:2506.21384},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Leveraging {LLM}},
 url = {https://arxiv.org/abs/2506.21384},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:21:17Z},
 year = {2025}
}

@inproceedings{dong_maxmind_2024,
 abstract = {Abstract—With the rapid development of the Internet of Things (IoT), the number of connected devices has exploded, leading to increased security challenges. Anomaly detection in IoT networks is crucial for identifying potential threats. This paper proposes a novel hybrid machine learning approach combining Convolutional Neural Networks (CNN) and Long Short-Term Memory (LSTM) networks to detect anomalies in IoT traffic. The model leverages spatial and temporal features from network data to improve detection accuracy. Experiments on benchmark datasets demonstrate that the proposed method outperforms traditional techniques, achieving up to 98% accuracy with low false positive rates. The results highlight the effectiveness of the hybrid model in real-time IoT security applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
