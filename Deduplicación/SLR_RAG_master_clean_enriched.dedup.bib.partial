@inproceedings{zhai_law_2025,
 abstract = {This paper proposes a novel federated learning framework for privacy-preserving anomaly detection in industrial IoT systems. Traditional centralized approaches face challenges in data privacy and scalability due to the distributed nature of IoT devices. Our framework leverages differential privacy mechanisms integrated with federated averaging to train models across edge devices without sharing raw data. Extensive simulations on real-world datasets demonstrate that the proposed method achieves up to 15% higher detection accuracy compared to baseline federated learning models while maintaining strong privacy guarantees. The results highlight the framework's potential for secure and efficient deployment in resource-constrained environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
