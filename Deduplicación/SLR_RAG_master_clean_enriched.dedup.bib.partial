@article{mundlamuri_evolution_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly impacted various sectors, including healthcare. This paper explores the integration of AI in medical diagnosis, focusing on machine learning algorithms for early detection of diseases such as cancer and cardiovascular conditions. We propose a hybrid model combining convolutional neural networks (CNNs) and recurrent neural networks (RNNs) to improve accuracy in image-based diagnostics. Experimental results on datasets from the ImageNet and MIMIC-III repositories demonstrate a 15% improvement in precision compared to traditional methods. The study also discusses ethical considerations and challenges in AI deployment within clinical settings.},
