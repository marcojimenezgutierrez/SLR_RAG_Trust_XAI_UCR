 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:04:19Z},
 year = {2024}
}

@inproceedings{yao_rtlrewriter_2025,
 abstract = {We present MuseCam, a wearable camera system that captures high-quality images and videos while users are moving. MuseCam consists of a miniature camera module and a 3D-printed enclosure that can be attached to various body locations, such as the chest, waist, or wrist. The system is designed to be lightweight, unobtrusive, and comfortable for long-term wear. To address the challenges of motion blur and low light conditions common in wearable imaging, MuseCam incorporates advanced image stabilization and computational photography techniques. Our evaluation shows that MuseCam outperforms commercial wearable cameras in image quality and user comfort, enabling new applications in personal documentation, activity recognition, and augmented reality.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
