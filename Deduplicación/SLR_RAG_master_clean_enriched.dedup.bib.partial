@inproceedings{barnett_seven_2024-1,
 abstract = {Software engineers are increasingly adding semantic search capabilities to applications using a strategy known as Retrieval Augmented Generation (RAG). A RAG system involves finding documents that semantically match a query and then passing the documents to a large language model (LLM) such as ChatGPT to extract the right answer using an LLM. RAG systems aim to: a) reduce the problem of hallucinated responses from LLMs},
 author = {Barnett},
 booktitle = {2024 {IEEE}},
 keywords = {Case Study},
 month = {apr},
 pages = {194--199},
 title = {Seven {Failure}},
 year = {2024}
}

@inproceedings{barone_combining_2025,
 abstract = {Large Language Models (LLMs) have revolutionized various domains, including code generation and understanding. However, their application in software engineering tasks remains underexplored in terms of systematic evaluation and improvement. This paper surveys the current landscape of LLMs for code-related tasks, categorizing them into generation, completion, repair, and explanation. We analyze key benchmarks, challenges such as hallucination and bias, and future directions for enhancing LLM performance in coding scenarios. Through empirical studies on datasets like HumanEval and MBPP, we highlight the strengths and limitations of models like GPT-4 and CodeLlama, proposing hybrid approaches combining LLMs with traditional symbolic methods for more robust code intelligence.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
