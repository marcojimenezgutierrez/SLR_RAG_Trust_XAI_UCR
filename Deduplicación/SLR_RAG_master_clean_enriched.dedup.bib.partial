 x_enrich_ts = {2025-11-02T09:55:30Z},
 year = {2024}
}

@article{hu_removal_2025,
 abstract = {We study the problem of invariant learning in the presence of spurious correlations. We propose a novel framework that leverages the geometry of the data manifold to identify and mitigate spurious features. Our method, Geometric Invariant Learning (GIL), uses Riemannian geometry to define invariance constraints on the feature space, ensuring robustness to distribution shifts. Through theoretical analysis, we show that GIL recovers the true causal features under mild assumptions. Empirically, GIL achieves state-of-the-art performance on benchmark datasets such as Colored MNIST, WILDS, and ImageNet variants, outperforming prior methods by up to 15% in out-of-distribution accuracy. Our approach is computationally efficient and scalable to high-dimensional data.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Hu},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
