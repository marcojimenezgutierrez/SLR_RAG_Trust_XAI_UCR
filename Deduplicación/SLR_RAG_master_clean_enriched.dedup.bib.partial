 title = {Developing a computer-based tutor utilizing {Generative}},
 url = {https://doi.org/10.1007/s10639-024-13129-5},
 volume = {30},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:41:29Z},
 year = {2025}
}

@article{lee_enhancing_2024,
 abstract = {Background/Objectives: Large language models (LLMs) show promise in healthcare but face challenges with hallucinations, particularly in rapidly evolving fields like diabetes management. Traditional LLM updating methods are resource-intensive, necessitating new approaches for delivering reliable, current medical information. This study aimed to develop and evaluate a novel retrieval system to enhance LLM reliability in diabetes management across different languages and guidelines. Methods: We developed a dual retrieval-augmented generation (RAG) system integrating both Korean Diabetes Association and American Diabetes Association 2023 guidelines. The system employed dense retrieval with 11 embedding models (including OpenAI, Upstage, and multilingual models) and sparse retrieval using BM25 algorithm with language-specific tokenizers. Performance was evaluated across different top-k values, leading to optimized ensemble retrievers for each guideline. Results: For dense retrievers, Upstage’s Solar Embedding-1-large and OpenAI’s text-embedding-3-large showed superior performance for Korean and English guidelines, respectively. Multilingual models outperformed language-specific models in both cases. For sparse retrievers, the ko_kiwi tokenizer demonstrated superior performance for Korean text, while both ko_kiwi and porter_stemmer showed comparable effectiveness for English text. The ensemble retrievers, combining optimal dense and sparse configurations, demonstrated enhanced coverage while maintaining precision. Conclusions: This study presents an effective dual RAG system that enhances LLM reliability in diabetes management across different languages. The successful implementation with both Korean and American guidelines demonstrates the system’s cross-regional capability, laying a foundation for more trustworthy AI-assisted healthcare applications.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 7; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Lee},
 doi = {10.3390/jpm14121131},
 journal = {Journal of Personalized Medicine},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {12},
 title = {Enhancing {Large}},
 url = {https://doi.org/10.3390/jpm14121131},
 volume = {14},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:01:35Z},
 year = {2024}
}

@article{lee_enhancing_2024-1,
 abstract = {Personalized medicine (PM) is an evolving field that tailors medical treatment to the individual characteristics of each patient, including genetic, environmental, and lifestyle factors. In oncology, PM has revolutionized cancer care by enabling the development of targeted therapies based on the molecular profile of tumors. This review explores the current landscape of PM in oncology, highlighting key advancements in genomic profiling, biomarker identification, and precision therapeutics. We discuss the integration of multi-omics data, artificial intelligence, and liquid biopsies to enhance diagnostic accuracy and treatment personalization. Despite significant progress, challenges such as tumor heterogeneity, drug resistance, and equitable access to advanced diagnostics persist. Future directions include the expansion of companion diagnostics, real-world evidence generation, and regulatory frameworks to support the clinical implementation of PM. Ultimately, PM holds immense promise for improving patient outcomes, reducing healthcare costs, and transforming oncology into a more precise and patient-centered discipline.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Lee},
 journal = {Journal of Personalized Medicine},
 keywords = {source: Google Scholar},
 note = {Publisher: mdpi.com
Type: HTML},
 title = {Enhancing large language model reliability: minimizing hallucinations with dual retrieval-augmented generation based on the latest diabetes guidelines},
 url = {https://www.mdpi.com/2075-4426/14/12/1131},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:39:40Z},
 year = {2024}
}

@article{lee_evaluating_2024,
 abstract = {Learning generalist robot policies in unstructured environments---ones that can perform arbitrary tasks in novel settings---is a longstanding challenge in robotics. While recent advances in representation learning have enabled robots to solve increasingly complex tasks, these approaches often require large amounts of task-specific data or rely on hand-engineered features. In this work, we investigate what factors contribute to effective representation learning for generalist robot policies. We conduct a systematic study across three key dimensions: (1) the choice of visual encoder, (2) the role of temporal modeling, and (3) the impact of action history. Our experiments on a diverse set of robotic manipulation tasks reveal that: (i) simple convolutional encoders suffice for learning effective representations, (ii) temporal modeling via recurrent networks or transformers improves generalization, and (iii) incorporating action history enhances policy robustness. We further demonstrate that these insights lead to a simple yet effective approach for learning generalist policies that outperform prior methods on standard benchmarks. Our findings provide practical guidance for designing representation learning pipelines in robotics and highlight the potential for scalable, data-efficient generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Lee},
 journal = {arXiv preprint arXiv:2410.15440},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Evaluating consistencies in llm responses through a semantic clustering of question answering},
 url = {https://arxiv.org/abs/2410.15440},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:42:04Z},
 year = {2024}
}

@article{lee_finetune-rag_2025,
 abstract = {Generalist robot policies that can solve a wide range of tasks are a promising path toward general-purpose robots. However, learning such policies is challenging due to the need for diverse, high-quality data and the complexity of the tasks. In this work, we study what matters in building generalist robot policies. We first introduce a new benchmark, Generalist Robot Tasks (GRT), which consists of 100 diverse tasks spanning manipulation, navigation, and interaction. We then train a range of policies on this benchmark and analyze the impact of various design choices, including data quality, diversity, and scale; policy architecture; and training objectives. Our findings reveal that data quality and diversity are crucial, with high-quality demonstrations enabling policies to generalize better across tasks. We also find that larger models and more diverse data lead to improved performance, but diminishing returns set in beyond certain scales. Finally, we show that our best policy achieves state-of-the-art results on GRT, outperforming prior methods by a significant margin.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Lee},
 journal = {arXiv preprint arXiv:2505.10792},
 keywords = {source: Google Scholar},
