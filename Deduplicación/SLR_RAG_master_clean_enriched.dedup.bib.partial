@inproceedings{salemi_learning_2025,
 abstract = {Visual Question Answering (VQA) is an important multimodal task that has received increasing attention in recent years. However, the existing VQA datasets and models suffer from severe bias problems, which may lead to unreliable and unfair results. To this end, we conduct a comprehensive survey on fairness in VQA. First, we introduce the definition of fairness in VQA and summarize the bias sources in VQA from the perspectives of data, model, and evaluation. Then, we review the debiasing methods for VQA from the perspectives of data, model, and ensemble. Furthermore, we discuss the evaluation metrics for fairness in VQA and introduce the existing fairness evaluation datasets and benchmarks. Finally, we point out the challenges in fairness in VQA and discuss the future research directions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
