@inproceedings{arefeen_irag_2024,
 abstract = {Machine learning models are increasingly used in high-stakes domains, where it is critical to understand and mitigate potential biases. However, current methods for measuring bias often rely on predefined protected attributes (e.g., race, gender) and datasets that may not capture the full scope of real-world disparities. This paper introduces a framework for expanding the scope of data used in human-centered AI evaluations to better represent diverse populations and contexts. We propose a multi-step process involving data augmentation, synthetic data generation, and community-driven annotation to create more inclusive datasets. Through case studies in healthcare and hiring, we demonstrate how our framework uncovers hidden biases that standard approaches miss, leading to fairer AI systems. Our contributions include open-source tools for implementation and guidelines for ethical data expansion.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
