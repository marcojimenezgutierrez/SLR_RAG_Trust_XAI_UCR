 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:28:50Z},
 year = {2025}
}

@article{galat_llm_2025,
 abstract = {Robot learning has made significant progress in recent years, particularly in the domain of manipulation tasks. However, most existing methods focus on learning policies for specific tasks or environments, limiting their generalization to novel scenarios. In this work, we aim to develop generalist robot policies that can perform a wide range of manipulation tasks across diverse environments. We investigate key factors that contribute to the success of such policies, including data diversity, model architecture, and training objectives. Through extensive experiments on simulated and real-world robotic platforms, we demonstrate that incorporating multi-task learning with a transformer-based architecture and a combination of imitation and reinforcement learning leads to robust generalization. Our findings provide insights into building versatile robot agents capable of adapting to unseen tasks with minimal fine-tuning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
