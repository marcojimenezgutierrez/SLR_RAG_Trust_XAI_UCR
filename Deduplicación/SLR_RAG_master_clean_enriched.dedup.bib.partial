 x_enrich_ts = {2025-11-02T06:02:48Z},
 year = {2024}
}

@inproceedings{volker_chat_2024,
 abstract = {This paper presents a novel approach to multi-modal fake news detection by leveraging diffusion models as priors. Traditional methods often struggle with generalization across different modalities and domains due to their reliance on hand-crafted features or large labeled datasets. We introduce a framework that integrates text, image, and video modalities using a pre-trained diffusion model to generate realistic counterfactuals, which are then used to train a robust classifier. Our method achieves state-of-the-art performance on benchmark datasets, demonstrating improved generalization and reduced vulnerability to adversarial attacks. Experimental results show an average F1-score improvement of 12% over baselines.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
