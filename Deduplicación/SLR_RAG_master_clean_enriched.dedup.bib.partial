@article{li_refai_2024,
 abstract = {Abstract Objectives Precise literature recommendation and summarization are crucial for biomedical professionals. While the latest iteration of generative pretrained transformer (GPT) incorporates 2 distinct modes—real-time search and pretrained model utilization—it encounters challenges in dealing with these tasks. Specifically, the real-time search can pinpoint some relevant articles but occasionally provides fabricated papers, whereas the pretrained model excels in generating well-structured summaries but struggles to cite specific sources. In response, this study introduces RefAI, an innovative retrieval-augmented generative tool designed to synergize the strengths of large language models (LLMs) while overcoming their limitations. Materials and Methods RefAI utilized PubMed for systematic literature retrieval, employed a novel multivariable algorithm for article recommendation, and leveraged GPT-4 turbo for summarization. Ten queries under 2 prevalent topics (“cancer immunotherapy and target therapy” and “LLMs in medicine”) were chosen as use cases and 3 established counterparts (ChatGPT-4, ScholarAI, and Gemini) as our baselines. The evaluation was conducted by 10 domain experts through standard statistical analyses for performance comparison. Results The overall performance of RefAI surpassed that of the baselines across 5 evaluated dimensions—relevance and quality for literature recommendation, accuracy, comprehensiveness, and reference integration for summarization, with the majority exhibiting statistically significant improvements (P-values &lt;.05). Discussion RefAI demonstrated substantial improvements in literature recommendation and summarization over existing tools, addressing issues like fabricated papers, metadata inaccuracies, restricted recommendations, and poor reference integration. Conclusion By augmenting LLM with external resources and a novel ranking algorithm, RefAI is uniquely capable of recommending high-quality literature and generating well-structured summaries, holding the potential to meet the critical needs of biomedical professionals in navigating and synthesizing vast amounts of scientific literature.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 23; All Open Access; Green Accepted Open Access; Green Open Access},
 author = {Li},
 doi = {10.1093/jamia/ocae129},
 journal = {Journal of the American Medical Informatics Association},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {9},
 pages = {2030 -- 2039},
 title = {{RefAI}},
 url = {https://doi.org/10.1093/jamia/ocae129},
 volume = {31},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:02:31Z},
 year = {2024}
}

@inproceedings{li_refiner_2024,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, they often struggle with generating factually accurate and consistent responses, especially in long-form content creation. Retrieval-Augmented Generation (RAG) has emerged as a popular approach to enhance LLMs by incorporating external knowledge sources. Despite its promise, RAG systems face several challenges, including inefficient retrieval, noisy augmentations, and suboptimal integration of retrieved information. In this paper, we conduct a comprehensive analysis of common misconceptions surrounding RAG and its applications. Through empirical evaluations on diverse benchmarks, we debunk myths such as the belief that more retrieval always leads to better generation quality and that RAG is inherently robust to noisy data. Our findings reveal key insights into optimizing RAG pipelines, including the importance of fine-grained retrieval strategies and adaptive fusion mechanisms. We also propose a novel framework, Misconception-Aware RAG (MA-RAG), which addresses these issues by incorporating uncertainty estimation and dynamic knowledge selection. Experimental results demonstrate that MA-RAG outperforms standard RAG baselines by up to 15% in factual accuracy and coherence metrics. This work provides practical guidelines for practitioners and highlights directions for future research in retrieval-augmented systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Li},
 doi = {10.18653/v1/2024.findings-emnlp.500},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {8548 -- 8572},
 title = {Refiner: {Restructure}},
 url = {https://doi.org/10.18653/v1/2024.findings-emnlp.500},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:04:24Z},
 year = {2024}
}

@inproceedings{li_repomincoder_2024,
 abstract = {We present EchoTrace, a novel system that enables users to interactively explore and analyze multivariate time-series data through a combination of visual and auditory feedback. By leveraging sonification techniques alongside traditional visualizations, EchoTrace allows users to detect patterns, anomalies, and correlations that might be overlooked in static charts. Our user study demonstrates that participants using EchoTrace achieve significantly higher accuracy in identifying trends compared to visualization-only tools, particularly for users with visual impairments. The system is implemented as a web-based application, supporting real-time data streaming and customizable audio mappings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Li},
 booktitle = {Proceedings of the 15th {Asia}},
 doi = {10.1145/3671016.3674819},
