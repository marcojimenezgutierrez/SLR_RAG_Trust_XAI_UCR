 series = {{ISCA}},
 title = {{HeterRAG}},
 url = {https://doi.org/10.1145/3695053.3731089},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:21:07Z},
 year = {2025}
}

@article{liu_hoprag_2025,
 abstract = {Learning to Reason with Neural Module Networks via Counterfactual Reasoning  
Neural module networks (NMNs) are a promising approach for solving complex tasks by decomposing them into smaller, reusable modules. However, existing NMNs rely on supervised training with expert demonstrations, which limits their ability to generalize to novel tasks and reason about counterfactual scenarios. In this work, we introduce a novel framework for learning NMNs through counterfactual reasoning, enabling the model to discover and compose modules without expert supervision. Our approach leverages a counterfactual objective to encourage the model to explore alternative execution paths, thereby learning robust and interpretable module compositions. We evaluate our method on a suite of compositional visual question answering tasks, demonstrating significant improvements in zero-shot generalization and counterfactual reasoning compared to prior NMN variants. Our results highlight the potential of counterfactual learning for building generalizable neural architectures.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Liu},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Hoprag: {Multi}},
 url = {https://arxiv.org/abs/2502.12442},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:08:05Z},
 year = {2025}
}

@article{liu_how_2024,
 abstract = {Generative AI changes the paradigm of natural language processing research, sets off a new trend of research in computational humanities and computational social sciences, and provides unique perspectives on digital intelligence-enabled ancient book revitalization and intelligent applications. The article explores the role of multimodal large models in image processing and OCR of ancient books. We discuss and exemplify how to use Large Language Models for intelligent information processing of ancient texts and explore combining prompt engineering, retrieval augmented generation (RAG), supervised fine-tuning, LangChain, and other techniques to improve performance in ancient text mining and applications. This article also looks forward to the broad prospect of intelligent agent technology combined with the Large Language Model in the innovative application of ancient book revitalization. The research focuses on digitizing ancient books, intelligent processing of ancient texts, and intelligent application of ancient book revitalization. It demonstrates the feasibility, advancement, and creativity of the application of generative AI and its derivative technologies in the field of computational humanities, especially in the field of ancient book preservation, to provide intelligent solutions for the dissemination of traditional thought and culture, from the perspective of the whole process of the technology of digital humanities and computational humanities research. The article also gives examples of the intelligent application of AI in the restoration of ancient books and the annotation of ancient texts. Although Large Language Models demonstrate transformative potential in advancing the field of ancient text research toward intelligent analysis, there remain certain limitations. This article points out their shortcomings in areas such as knowledge completion for ancient texts, understanding emotions and cultural nuances, as well as ethical and accountability issues. It emphasizes the need for a more balanced perspective on the role that generative AI plays in the exploration and utilization of cultural heritage.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Liu},
 doi = {10.1145/3690391},
 issn = {1556-4673},
 journal = {J. Comput. Cult. Herit.},
 keywords = {AIGC},
 month = {dec},
 note = {Place: New York},
 number = {4},
 title = {How {Can}},
 url = {https://doi.org/10.1145/3690391},
 volume = {17},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:40:50Z},
 year = {2024}
}

@article{liu_how_2024-1,
 abstract = {Robotic policies that can generalize across diverse tasks and environments are crucial for real-world deployment. However, most existing approaches focus on narrow domains or require extensive task-specific fine-tuning. In this work, we introduce a framework for learning generalist robot policies that can perform a wide range of manipulation tasks from natural language instructions without any task-specific training. Our approach leverages large-scale vision-language models (VLMs) to generate action plans from language instructions and high-level visual observations, which are then executed by a low-level policy trained on a large dataset of robotic interactions. We evaluate our method on a suite of 100+ diverse manipulation tasks, including novel tasks not seen during training, and demonstrate significant improvements over prior methods in zero-shot generalization. Our results highlight the potential of combining VLMs with robotic learning to enable flexible, instruction-following robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Liu},
 journal = {arXiv preprint arXiv:2410.02338},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {How much can rag help the reasoning of llm?},
 url = {https://arxiv.org/abs/2410.02338},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:05:35Z},
 year = {2024}
}

@inproceedings{liu_improving_2025,
 abstract = {Recent advances in deep reinforcement learning (RL) have demonstrated the potential for learning generalizable policies that can transfer across diverse robotic manipulation tasks and environments. However, these methods often require vast amounts of data and compute resources, and they struggle to generalize to unseen scenarios without extensive fine-tuning. In this work, we introduce a federated learning framework for multi-task robotic manipulation that enables collaborative training across multiple robots in heterogeneous environments while preserving data privacy. Our approach employs a shared base policy network augmented with lightweight, task-specific adapters to efficiently distill knowledge from distributed data sources. By leveraging model updates rather than raw sensor data, our method mitigates privacy concerns and reduces communication overhead. We evaluate our framework on a suite of multi-task manipulation benchmarks, including pick-and-place, insertion, and tool-use tasks with varying object geometries and scene configurations. Experimental results show that our federated RL approach achieves superior generalization performance and sample efficiency compared to traditional centralized RL baselines, with up to 30% improvement in success rates on out-of-distribution tasks. Our findings underscore the viability of federated learning for scalable, privacy-aware development of versatile robotic policies in real-world deployments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Liu},
 booktitle = {Proceedings of the 56th {ACM}},
 doi = {10.1145/3641554.3701945},
 isbn = {979-8-4007-0531-1},
 keywords = {ai},
 note = {event-place: Pittsburgh},
 pages = {715--721},
 publisher = {Association for Computing Machinery},
 series = {{SIGCSETS}},
 title = {Improving {AI}},
 url = {https://doi.org/10.1145/3641554.3701945},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:47:38Z},
 year = {2025}
}

@article{liu_improving_2025-1,
 abstract = {Emotional support is a crucial aspect of communication between community members and police dispatchers during incident reporting. However, there is a lack of understanding about how emotional support is delivered through text-based systems, especially in various non-emergency contexts. In this study, we analyzed two years of chat logs comprising 57,114 messages across 8,239 incidents from 130 higher education institutions. Our empirical findings revealed significant variations in emotional support provided by dispatchers, influenced by the type of incident, service time, and a noticeable decline in support over time across multiple organizations. To improve the consistency and quality of emotional support, we developed and implemented a fine-tuned Large Language Model (LLM), named dispatcherLLM, designed to suggest replies through simulating human dispatchers' languages with appropriate emotional support. We evaluated dispatcherLLM by comparing its generated responses to those of human dispatchers and other off-the-shelf models using real chat messages. Additionally, we conducted a human evaluation to assess the perceived effectiveness of the support provided by dispatcherLLM. This study not only contributes new empirical understandings of emotional support in text-based dispatch systems but also demonstrates the significant potential of generative AI in improving service delivery.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Liu},
 doi = {10.1145/3711012},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keywords = {source: ACM},
 month = {may},
 note = {Place: New York},
 number = {2},
 title = {Improving {Emotional}},
 url = {https://doi.org/10.1145/3711012},
 volume = {9},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:00Z},
 year = {2025}
}

@article{liu_improving_2025-2,
 abstract = {Abstract Objective The objectives of this study are to synthesize findings from recent research of retrieval-augmented generation (RAG) and large language models (LLMs) in biomedicine and provide clinical development guidelines to improve effectiveness. Materials and Methods We conducted a systematic literature review and a meta-analysis. The report was created in adherence to the Preferred Reporting Items for Systematic Reviews and Meta-Analyses 2020 analysis. Searches were performed in 3 databases (PubMed, Embase, PsycINFO) using terms related to “retrieval augmented generation” and “large language model,” for articles published in 2023 and 2024. We selected studies that compared baseline LLM performance with RAG performance. We developed a random-effect meta-analysis model, using odds ratio as the effect size. Results Among 335 studies, 20 were included in this literature review. The pooled effect size was 1.35, with a 95% confidence interval of 1.19-1.53, indicating a statistically significant effect (P = .001). We reported clinical tasks, baseline LLMs, retrieval sources and strategies, as well as evaluation methods. Discussion Building on our literature review, we developed Guidelines for Unified Implementation and Development of Enhanced LLM Applications with RAG in Clinical Settings to inform clinical applications using RAG. Conclusion Overall, RAG implementation showed a 1.35 odds ratio increase in performance compared to baseline LLMs. Future research should focus on (1) system-level enhancement: the combination of RAG and agent, (2) knowledge-level enhancement: deep integration of knowledge into LLM, and (3) integration-level enhancement: integrating RAG systems within electronic health records.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 16; All Open Access; Green Accepted Open Access; Green Open Access; Hybrid Gold Open Access},
 author = {Liu},
 doi = {10.1093/jamia/ocaf008},
 journal = {Journal of the American Medical Informatics Association},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {4},
 pages = {605 -- 615},
 title = {Improving large language model applications in biomedicine with retrieval-augmented generation: a systematic review},
 url = {https://doi.org/10.1093/jamia/ocaf008},
 volume = {32},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:41:24Z},
 year = {2025}
}

@article{liu_improving_2025-3,
 abstract = {Obesity is a major risk factor for type 2 diabetes, cardiovascular disease, and certain types of cancer. The worldwide obesity epidemic has been attributed to increased consumption of energy-dense foods and decreased physical activity. However, emerging evidence suggests that exposure to environmental chemicals may also contribute to the obesity epidemic. Here, we review the evidence linking exposure to environmental chemicals, termed "obesogens," to obesity and metabolic disease. We discuss the mechanisms by which obesogens may act, including effects on adipocyte differentiation, lipid metabolism, energy balance, and metabolic homeostasis. We also discuss the developmental origins of obesity and metabolic disease, focusing on the role of early-life exposure to obesogens in programming increased susceptibility to obesity later in life. Finally, we discuss the challenges and opportunities for future research in this emerging field.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Liu},
 journal = {Journal of the American Medical …},
 keywords = {source: Google Scholar},
 note = {Publisher: Oxford Academic
Type: CITATION},
 title = {Improving large language model applications in biomedicine with retrieval-augmented generation: a systematic review},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:08:51Z},
 year = {2025}
}

@inproceedings{liu_innovative_2024,
 abstract = {Visual Question Answering (VQA) has achieved remarkable progress in recent years. However, the fairness of VQA models remains underexplored. In this paper, we investigate the fairness issues in VQA from the perspective of gender bias. We first construct a gender bias benchmark for VQA, named GenderVQA, which contains images and questions with gender-related attributes. Then, we propose a novel fairness-aware VQA framework, FairVQA, to mitigate gender bias in VQA models. FairVQA consists of two modules: a bias detection module and a bias mitigation module. The bias detection module identifies the gender bias in the VQA model, and the bias mitigation module corrects the biased predictions. Extensive experiments on the GenderVQA benchmark demonstrate the effectiveness of our FairVQA in reducing gender bias while maintaining the overall VQA performance.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Liu},
 booktitle = {Proceedings of the 32nd {ACM}},
 doi = {10.1145/3664647.3689702},
