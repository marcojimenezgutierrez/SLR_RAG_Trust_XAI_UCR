 year = {2024}
}

@inproceedings{zeng_federated_2024,
 abstract = {Big data analytics has revolutionized various industries by enabling data-driven decision-making. However, the increasing volume and complexity of data require advanced techniques for efficient processing and analysis. In this paper, we propose a novel hybrid machine learning framework that integrates deep neural networks with ensemble methods to enhance predictive accuracy in large-scale datasets. Our approach addresses key challenges such as data imbalance, feature selection, and computational scalability. Extensive experiments on benchmark datasets from the UCI repository and real-world applications in healthcare and finance demonstrate that our framework outperforms state-of-the-art methods by up to 15% in terms of precision, recall, and F1-score, while reducing training time by 25%. This work provides a robust solution for big data applications demanding high performance and reliability.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
