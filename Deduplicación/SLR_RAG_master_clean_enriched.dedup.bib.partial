@inproceedings{miyaji_empowering_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly impacted various industries, including manufacturing and automation. This paper explores the integration of AI-driven predictive maintenance systems in industrial settings to enhance operational efficiency and reduce downtime. We propose a novel framework that combines machine learning algorithms with Internet of Things (IoT) sensors for real-time data analysis. Through case studies from automotive and energy sectors, we demonstrate a 25% improvement in equipment reliability and cost savings. The results highlight the potential of AI to transform traditional maintenance practices into proactive strategies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
