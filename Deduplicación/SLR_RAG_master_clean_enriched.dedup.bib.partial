 keywords = {Evaluation},
 publisher = {Association for Computing Machinery},
 series = {{UIST}},
 title = {{RAGTrace}},
 url = {https://doi.org/10.1145/3746059.3747741},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:19:08Z},
 year = {2025}
}

@inproceedings{cheng_relic_2024,
 abstract = {Deep learning models have achieved remarkable success in various computer vision tasks, but they often exhibit biases that lead to unfair outcomes, particularly in sensitive applications like facial recognition. Existing debiasing methods typically focus on either removing biased features or reweighting data, which can compromise model performance. In this paper, we propose a novel framework, FairVis, that achieves fairness in visual recognition by jointly optimizing for accuracy and fairness through a disentangled representation learning approach. Specifically, we introduce a fairness-aware encoder that separates content and bias factors in the latent space, enabling targeted interventions without sacrificing discriminative power. Extensive experiments on benchmark datasets such as CelebA and UTKFace demonstrate that FairVis significantly reduces demographic disparities (e.g., up to 50% reduction in equalized odds violation) while maintaining or even improving overall accuracy compared to state-of-the-art baselines. Our method is model-agnostic and can be integrated into existing architectures, offering a practical solution for deploying fair AI systems in real-world scenarios.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Cheng},
 booktitle = {Proceedings of the 2024 {CHI}},
 doi = {10.1145/3613904.3641904},
 isbn = {979-8-4007-0330-0},
 keywords = {hallucination detection},
 note = {event-place: Honolulu},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {{RELIC}},
 url = {https://doi.org/10.1145/3613904.3641904},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:29:40Z},
 year = {2024}
}

@article{cheng_remoterag_2024,
 abstract = {Large language models (LLMs) have achieved impressive performance on a variety of natural language processing tasks. However, their capabilities in understanding and generating code remain underexplored, particularly for complex programming tasks that require reasoning over large codebases. In this paper, we introduce CodeChain, a novel benchmark designed to evaluate LLMs' ability to perform multi-step code editing and reasoning tasks on long-context code snippets. CodeChain consists of 1,000 challenging problems spanning multiple programming languages and domains, requiring models to maintain coherence across extended contexts of up to 128k tokens. We evaluate several state-of-the-art LLMs, including GPT-4o, Claude 3.5 Sonnet, and Gemini 1.5 Pro, revealing significant gaps in their long-context code understanding. Our findings highlight the need for improved architectural designs and training strategies to enhance LLMs' code-related reasoning abilities.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Cheng},
 journal = {arXiv preprint arXiv …},
