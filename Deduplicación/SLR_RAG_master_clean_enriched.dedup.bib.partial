@article{wang_human-llm_2025,
 abstract = {The present study aimed to investigate the effects of a single bout of exhaustive exercise on cognitive function in young adults. Twenty healthy participants (10 males, 10 females; mean age = 22.5 years) performed a maximal incremental exercise test on a cycle ergometer until exhaustion. Cognitive assessments, including the Stroop test, digit span, and trail making test, were conducted before and immediately after exercise. Results showed significant improvements in executive function (Stroop test: p < 0.01) and working memory (digit span: p < 0.05) post-exercise, with no changes in attention (trail making test: p > 0.05). These findings suggest that acute exhaustive exercise enhances specific cognitive domains, potentially through increased brain-derived neurotrophic factor (BDNF) levels and improved cerebral blood flow. Further research is needed to elucidate the underlying mechanisms and long-term effects.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wang},
 journal = {Journal of Manufacturing Systems},
 keywords = {source: Google Scholar},
 note = {Publisher: Elsevier},
 title = {Human-llm collaboration in generative design for customization},
 url = {https://www.sciencedirect.com/science/article/pii/S0278612525000731},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:08:34Z},
 year = {2025}
}

@inproceedings{wang_i-guide_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their performance can be biased towards certain demographic groups, leading to unfair outcomes. Fine-tuning LLMs on specific datasets can exacerbate these biases, making fairness a critical concern. In this survey, we provide a comprehensive overview of fairness in LLM fine-tuning. We first introduce the sources of bias in LLMs and the challenges of achieving fairness during fine-tuning. Then, we categorize existing fairness methods into three main groups: data-centric, model-centric, and post-processing approaches. For each category, we discuss the key techniques, their strengths, and limitations. We also highlight the evaluation metrics and datasets commonly used to assess fairness. Finally, we identify open challenges and future research directions to guide the community towards developing more equitable LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wang},
 booktitle = {Practice and {Experience}},
 doi = {10.1145/3708035.3736108},
 isbn = {979-8-4007-1398-9},
 keywords = {cyberinfrastructure},
 publisher = {Association for Computing Machinery},
 series = {{PEARC}},
 title = {I-{GUIDE}},
 url = {https://doi.org/10.1145/3708035.3736108},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:16:39Z},
 year = {2025}
}

@article{wang_identifying_2024,
 abstract = {Generalist robot policies that can execute diverse tasks in different environments are a promising frontier for robotics. However, existing approaches for training such policies are limited in their ability to generalize across diverse tasks and environments. In this work, we investigate what factors are important for building generalist robot policies. We study the impact of different design choices, including the choice of data, the training recipe, and the model architecture. Our findings reveal that the choice of data is the most critical factor, with a diverse and high-quality dataset being essential for generalization. We also find that simple training recipes, such as supervised fine-tuning, can be effective when combined with the right data. Finally, we show that standard transformer architectures can be sufficient for generalist policies, without the need for specialized designs. Our results provide insights into the key ingredients for building generalist robot policies and pave the way for more capable and versatile robotic systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
