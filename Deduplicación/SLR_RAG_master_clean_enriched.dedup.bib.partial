@article{tang_lottery_2025,
 abstract = {We introduce Grok-1.5V, the first multimodal model from xAI. Building on the language understanding capabilities of Grok-1.5, Grok-1.5V excels in real-world spatial understanding through superior performance on the RealWorldQA benchmark, which consists of over 700 images depicting everyday scenes with questions requiring visual reasoning. Grok-1.5V also demonstrates strong performance on charts, diagrams, and various visual reasoning tasks, compared to leading models such as GPT-4V, Gemini Pro 1.5 and Claude 3 Sonnet.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
