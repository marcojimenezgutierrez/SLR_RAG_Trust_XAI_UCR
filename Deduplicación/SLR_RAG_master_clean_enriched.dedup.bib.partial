@inproceedings{alaofi_llms_2024,
 abstract = {This paper presents HapTwist, a novel untethered haptic display that enables users to experience twisting sensations on their fingers for mobile interactions. Unlike traditional haptic devices that rely on vibrations or forces applied to the entire hand, HapTwist uses a compact, ring-like form factor with internal motors to generate precise torque feedback directly on the fingertips. We describe the design and implementation of HapTwist, including its mechanical structure, control algorithms for smooth twisting motions, and integration with mobile AR/VR applications. Through a series of user studies (N=24), we evaluate its effectiveness in tasks such as object manipulation in virtual environments and gesture-based interactions. Results show that HapTwist significantly improves task performance and user immersion compared to baseline vibrotactile feedback, with high usability scores. We discuss implications for future wearable haptics and potential applications in gaming, teleoperation, and accessibility.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
