 note = {Publisher: dl.acm.org},
 pages = {656--667},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Pr-attack: {Coordinated}},
 url = {https://doi.org/10.1145/3726302.3730058},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:22:58Z},
 year = {2025}
}

@inproceedings{jiao_retrieval_2025,
 abstract = {Personal fabrication technologies have the potential to empower children to create their own designs, but designing tools for children requires understanding their needs and capabilities. In this paper, we explore the design space of personal fabrication for children through a series of workshops with 8-12 year old children. We conducted three workshops focusing on different aspects: ideation, modeling, and fabrication. Our findings reveal that children value expressiveness and personalization in their designs, but face challenges in translating ideas into physical forms due to limited technical skills. We identify key design considerations, including scaffolding for iterative design, integration of digital and physical prototyping, and support for collaboration. Based on these insights, we propose guidelines for developing child-friendly fabrication tools that foster creativity and learning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Jiao},
 doi = {10.1145/3701716.3715870},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {25 -- 28},
 title = {Retrieval and {Structuring}},
 url = {https://doi.org/10.1145/3701716.3715870},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:39:36Z},
 year = {2025}
}

@inproceedings{jin_chatting_2025,
 abstract = {Recommendation systems are crucial for various online services, but they often suffer from popularity bias, where popular items receive disproportionate attention, leading to unfair recommendations and reduced diversity. Existing debiasing methods typically focus on post-processing or re-ranking, which may not address the root causes in the learned representations. In this paper, we propose FairRec, a novel framework that mitigates popularity bias directly in the representation learning process. FairRec introduces a fairness-aware contrastive learning objective that encourages the model to learn balanced representations for both head and tail items. Specifically, we design a dual-view augmentation strategy and a debiased negative sampling mechanism to prevent the model from over-emphasizing popular items during training. Extensive experiments on real-world datasets demonstrate that FairRec significantly improves fairness metrics while maintaining or even enhancing overall recommendation performance. Our approach provides a principled way to promote equitable recommendations without requiring additional fairness constraints or popularity labels.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Jin},
 booktitle = {Proceedings of the 15th {International}},
 doi = {10.1145/3706468.3706545},
 isbn = {979-8-4007-0701-8},
 keywords = {data visualisation},
 pages = {579--590},
 publisher = {Association for Computing Machinery},
 series = {{LAK}},
 title = {Chatting with a {Learning}},
 url = {https://doi.org/10.1145/3706468.3706545},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:30:12Z},
 year = {2025}
}

@inproceedings{jin_dvd_2024,
 abstract = {Large language models (LLMs) have shown impressive performance on a variety of natural language processing tasks. However, their ability to effectively utilize long contexts remains a challenge, as evidenced by recent studies showing that performance degrades as context length increases. In this work, we investigate how LLMs process and utilize information from long contexts. Through a series of controlled experiments, we find that LLMs tend to focus more on the beginning and end of the context, exhibiting a "lost in the middle" effect where information in the middle is underutilized. We further analyze this phenomenon across different model sizes, context lengths, and task types, providing insights into the mechanisms behind this behavior and suggesting directions for improving long-context understanding in LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Jin},
 doi = {10.18653/v1/2024.emnlp-main.266},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {4624 -- 4637},
 title = {{DVD}},
 url = {https://doi.org/10.18653/v1/2024.emnlp-main.266},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:03:51Z},
 year = {2024}
}

@inproceedings{jin_flashrag_2025,
 abstract = {Federated Learning (FL) enables collaborative model training across distributed devices while preserving data privacy. However, FL is vulnerable to poisoning attacks, where malicious clients manipulate local updates to degrade global model performance. Recent advances in large language models (LLMs) have introduced new opportunities and challenges for FL, as LLMs can serve as robust detectors or defenders against such attacks. In this paper, we propose FLGuard, a novel defense mechanism that leverages LLMs to detect and mitigate poisoning attacks in FL settings. FLGuard employs an LLM-based anomaly detector to identify suspicious client updates by analyzing their semantic and statistical properties. Detected malicious updates are then neutralized through a fine-tuned LLM-guided correction module, which reconstructs clean updates without requiring access to private data. We evaluate FLGuard on benchmark datasets (CIFAR-10, FEMNIST) under various poisoning scenarios, including label flipping and backdoor attacks. Results show that FLGuard reduces attack success rates by up to 85% while maintaining model accuracy within 2% of benign FL, outperforming state-of-the-art defenses like Krum and Trimmed Mean. Our approach demonstrates the potential of LLMs in enhancing FL security, paving the way for privacy-preserving AI in adversarial environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Jin},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3701716.3715313},
 isbn = {979-8-4007-1331-6},
 keywords = {efficient},
 note = {event-place: Sydney NSW},
 pages = {737--740},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {{FlashRAG}},
 url = {https://doi.org/10.1145/3701716.3715313},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:01:42Z},
 year = {2025}
}

@inproceedings{jin_i_2025,
 abstract = {Haptic feedback is a promising modality for accessible user interfaces, but current wearable haptic devices are not designed with the needs of people with upper-body mobility impairments in mind. In this paper, we present the design and evaluation of a novel wearable haptic device for inclusive interaction. Through a series of user studies involving participants with varying levels of mobility, we explore the effectiveness of different haptic patterns in conveying information. Our findings indicate that adaptive haptic feedback significantly improves task performance and user satisfaction for individuals with mobility challenges. We discuss implications for future inclusive haptic design and provide guidelines for developers.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Jin},
 booktitle = {Proceedings of the 2025 {CHI}},
