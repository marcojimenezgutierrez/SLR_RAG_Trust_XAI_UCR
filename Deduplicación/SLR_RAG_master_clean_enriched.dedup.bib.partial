@inproceedings{pathiyan_cherumanal_towards_2024,
 abstract = {This paper explores the integration of large language models (LLMs) into software engineering practices, focusing on their potential to automate and enhance various stages of the software development lifecycle. We examine current applications of LLMs in code generation, debugging, testing, and documentation, highlighting both their transformative capabilities and inherent limitations. Through a series of case studies and empirical evaluations, we assess the impact of LLMs on developer productivity, code quality, and collaboration. Our findings reveal that while LLMs can significantly accelerate routine tasks, they often introduce challenges related to reliability, ethical considerations, and over-reliance. We propose a framework for responsible adoption of LLMs in software engineering, emphasizing the need for human oversight, continuous evaluation, and interdisciplinary collaboration to mitigate risks and maximize benefits.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
