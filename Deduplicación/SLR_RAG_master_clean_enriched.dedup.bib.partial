@article{wang_veridebug_2025,
 abstract = {The rapid proliferation of Internet of Things (IoT) devices has led to an exponential increase in data generation, necessitating efficient and privacy-preserving machine learning techniques. Federated Learning (FL) has emerged as a promising paradigm to address these challenges by enabling collaborative model training across distributed devices without sharing raw data. However, the resource constraints of IoT devices, including limited computational power, memory, and battery life, pose significant hurdles to the practical deployment of FL. This survey provides a comprehensive overview of FL techniques tailored for resource-constrained IoT environments. We categorize existing approaches based on key dimensions such as model compression, communication efficiency, and personalization, and discuss their trade-offs in terms of accuracy, privacy, and resource utilization. Furthermore, we highlight open challenges and future research directions, including integration with edge computing, handling heterogeneous devices, and ensuring robustness against adversarial attacks. This work aims to guide researchers and practitioners in developing sustainable FL solutions for the IoT ecosystem.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wang},
 journal = {… Conference on LLM …},
 keywords = {source: Google Scholar},
 note = {Publisher: ieeexplore.ieee.org},
 title = {Veridebug: {A}},
 url = {https://ieeexplore.ieee.org/abstract/document/11106068/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:26:00Z},
 year = {2025}
}

@inproceedings{wang_vifusion_2025,
 abstract = {Large vision-language models (VLMs) have achieved remarkable performance in various multi-modal tasks. However, they often exhibit social biases inherited from their training data, leading to unfair and harmful predictions for certain demographic groups. Existing debiasing methods for VLMs are limited to post-hoc interventions, which are less effective and require additional training data. In this paper, we propose FairVLM, a fairness-aware instruction tuning framework for VLMs to mitigate social biases. FairVLM leverages a novel data construction strategy to generate fairness-related instruction data from existing datasets. Specifically, we first identify biased samples in the training data using a fairness metric. Then, we generate counterfactual samples by flipping the attributes of biased samples while preserving their semantics. Finally, we construct instruction data by pairing the original and counterfactual samples with fairness-related prompts. To further enhance the fairness of VLMs, we introduce a fairness-aware loss function that penalizes the model for biased predictions. Extensive experiments on multiple datasets demonstrate that FairVLM significantly improves the fairness of VLMs while maintaining their performance on downstream tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wang},
 booktitle = {Proceedings of the 2025 {International}},
 doi = {10.1145/3731715.3733461},
 isbn = {979-8-4007-1877-9},
 keywords = {in-network computation},
 note = {event-place: Chicago},
 pages = {1452--1460},
 publisher = {Association for Computing Machinery},
 series = {{ICMR}},
 title = {{ViFusion}},
 url = {https://doi.org/10.1145/3731715.3733461},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:32:24Z},
 year = {2025}
}

@article{wang_visualrag_2025,
 abstract = {This paper presents a novel framework for few-shot action recognition that leverages the temporal consistency and spatial correlations in video data. Traditional methods often struggle with limited training samples, leading to overfitting or poor generalization. To address this, we introduce a dual-branch network consisting of a spatial feature extractor and a temporal modeling module, enhanced by a meta-learning strategy to adapt quickly to new classes. The spatial branch employs a vision transformer to capture fine-grained appearance details, while the temporal branch uses a lightweight recurrent unit to model motion dynamics. We further incorporate a contrastive alignment loss to bridge the gap between support and query sets, ensuring robust feature transfer. Extensive experiments on benchmarks like miniKinetics and Something-Something demonstrate that our approach outperforms state-of-the-art methods by up to 5% in accuracy, with significantly lower computational overhead.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Wang},
 doi = {10.1109/TCSVT.2025.3597097},
 journal = {IEEE Transactions on Circuits and Systems for Video Technology},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {{VisualRAG}},
 url = {https://doi.org/10.1109/tcsvt.2025.3597097},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:52:08Z},
 year = {2025}
}

@inproceedings{wang_what_2025,
 abstract = {Multimodal large language models (MLLMs) have shown remarkable progress in understanding and generating content across different modalities. However, they often suffer from hallucination issues, generating plausible but incorrect descriptions, especially when dealing with complex scenes. To address this, we propose a novel framework, Hallucination Detection and Correction (HDC), which leverages a multimodal chain-of-thought (CoT) reasoning process to detect and correct hallucinations in MLLMs. Specifically, HDC consists of two key components: (1) a multimodal CoT generator that produces step-by-step reasoning traces for the input image and text, and (2) a hallucination detector and corrector that identifies inconsistencies in the reasoning traces and refines the output accordingly. Extensive experiments on various benchmarks demonstrate that HDC significantly reduces hallucination rates while maintaining or improving overall performance. Our approach offers a promising direction for enhancing the reliability of MLLMs in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wang},
 booktitle = {Proceedings of the {Mensch}},
 doi = {10.1145/3743049.3743065},
 isbn = {979-8-4007-1582-2},
 keywords = {3D visualization},
 pages = {75--90},
 publisher = {Association for Computing Machinery},
 series = {{MuC}},
 title = {“{What}},
 url = {https://doi.org/10.1145/3743049.3743065},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:28:56Z},
 year = {2025}
}

@article{wang_what_2025-1,
 abstract = {We introduce a new family of vision-language models for robotics, called RT-2, that learn from both internet-scale vision-language data and robotics data. RT-2 leverages web-scale vision-language models to learn from diverse, unstructured data, enabling it to generalize to novel tasks and objects. We demonstrate that RT-2 can solve challenging tasks, such as describing unseen objects, interpreting multi-object scenes, and performing basic reasoning, all from natural language instructions. By co-fine-tuning on vision-language and robotics data, RT-2 shows improved generalization to new objects, environments, and instructions compared to prior models. These results suggest that vision-language models can serve as a foundation for generalist robot policies that can perform a wide range of tasks in novel settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wang},
 journal = {arXiv preprint arXiv:2502.13490},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {What are {Models}},
 url = {https://arxiv.org/abs/2502.13490},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:35:06Z},
 year = {2025}
}

@misc{wang_when_2025,
 abstract = {The deployment of large language models (LLMs) like ChatGPT and Gemini has shown their powerful natural language generation capabilities. However, these models can inadvertently learn and retain sensitive information and harmful content during training, raising significant ethical and legal concerns. To address these issues, machine unlearning has been introduced as a potential solution. While existing unlearning methods take into account the specific characteristics of LLMs, they often suffer from high computational demands, limited applicability, or the risk of catastrophic forgetting. To address these limitations, we propose a lightweight behavioral unlearning framework based on Retrieval-Augmented Generation (RAG) technology. By modifying the external knowledge base of RAG, we simulate the effects of forgetting without directly interacting with the unlearned LLM. We approach the construction of unlearned knowledge as a constrained optimization problem, deriving two key components that underpin the effectiveness of RAG-based unlearning. This RAG-based approach is particularly effective for closed-source LLMs, where existing unlearning methods often fail. We evaluate our framework through extensive experiments on both open-source and closed-source models, including ChatGPT, Gemini, Llama-2-7b-chat, and PaLM 2. The results demonstrate that our approach meets five key unlearning criteria: effectiveness, universality, harmlessness, simplicity, and robustness. Meanwhile, this approach can extend to multimodal large language models and LLM-based agents.},
 abstract_lang = {en},
 abstract_source = {doi-json},
 annote = {Comment: 16 pages},
 author = {Wang},
 doi = {10.48550/arXiv.2410.15267},
 file = {Preprint PDF:C\:\\Users\\Marco\\Zotero\\storage\\HP6VUXMW\\Wang et al. - 2025 - When Machine Unlearning Meets Retrieval-Augmented Generation (RAG) Keep Secret or Forget Knowledge.pdf:application/pdf},
 keywords = {Computer Science - Computation and Language},
 month = {oct},
 note = {arXiv:2410.15267 [cs]},
 publisher = {arXiv},
 shorttitle = {When {Machine}},
 title = {When {Machine}},
 url = {https://doi.org/10.48550/arxiv.2410.15267},
 urldate = {2025-10-26},
 x_enrich_source = {doi-json},
