@inproceedings{sinha_fact-centric_2024,
 abstract = {With the rapid advancement of artificial intelligence, large language models (LLMs) have demonstrated remarkable capabilities in various domains, including software engineering. However, the application of LLMs in software engineering remains underexplored, particularly in terms of agent-based systems that can autonomously perform complex software engineering tasks. In this paper, we propose a novel framework for LLM-based multi-agent systems tailored for software engineering tasks, such as code generation, debugging, and testing. Our framework leverages the collaborative strengths of multiple LLM agents, each specialized in different aspects of software engineering, to enhance overall performance and efficiency. We evaluate our framework on benchmark datasets and real-world software projects, demonstrating significant improvements over single-agent baselines in terms of accuracy, productivity, and error reduction. Our findings highlight the potential of LLM-based multi-agent systems to revolutionize software engineering practices.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
