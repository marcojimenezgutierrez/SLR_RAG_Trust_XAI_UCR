 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:53:51Z},
 year = {2025}
}

@article{guo_root_2025,
 abstract = {Abstract—With the rapid development of artificial intelligence (AI) technology, AI-generated content (AIGC) has become a hot topic in various fields. However, the collaborative design of AIGC still faces challenges such as lack of efficient interaction mechanisms and poor quality control. This paper proposes a novel collaborative framework for AIGC design, integrating multi-agent systems and human-AI interaction models. We introduce a dynamic workflow that enables real-time collaboration among designers, AI agents, and stakeholders. Experimental results demonstrate that our framework improves design efficiency by 35% and content quality by 28% compared to traditional methods. The proposed approach provides a scalable solution for future AIGC applications in creative industries.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
