@article{sudhir_leveraging_2025,
 abstract = {This chapter presents a novel approach to enhancing cybersecurity in IoT ecosystems using blockchain technology integrated with machine learning algorithms. We propose a decentralized framework that ensures secure data transmission and anomaly detection in real-time. The system leverages smart contracts for authentication and ensemble learning models for threat prediction. Experimental results on simulated IoT networks demonstrate a 25% improvement in detection accuracy and reduced latency compared to traditional methods. Challenges such as scalability and energy consumption are discussed, along with future research directions.},
