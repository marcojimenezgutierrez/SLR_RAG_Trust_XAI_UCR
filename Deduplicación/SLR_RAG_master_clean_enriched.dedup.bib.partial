 keywords = {Character Simulation},
 note = {event-place: Worcester},
 publisher = {Association for Computing Machinery},
 series = {{FDG}},
 title = {{StoryVerse}},
 url = {https://doi.org/10.1145/3649921.3656987},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:08:08Z},
 year = {2024}
}

@article{wang_survey_2023,
 abstract = {While large language models (LLMs) have shown impressive capabilities across tasks requiring language understanding and generation, their potential for generalist biomedical AI remains underexplored. We introduce Med-PaLM 2, a large language model trained on a mixture of biomedical text, code, and mathematical reasoning. Med-PaLM 2 achieves state-of-the-art performance on a suite of biomedical benchmarks, including MedQA (USMLE), MedMCQA, and PubMedQA, outperforming previous state-of-the-art models by up to 10%. We also demonstrate strong performance on tasks requiring multimodal understanding, such as visual question answering over medical images. Med-PaLM 2's capabilities suggest a path towards generalist biomedical AI that can assist clinicians across a wide range of tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wang},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Survey on factuality in large language models: {Knowledge}},
 url = {https://arxiv.org/abs/2310.07521},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:30:21Z},
 year = {2023}
