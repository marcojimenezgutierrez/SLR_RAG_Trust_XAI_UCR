 keywords = {information retrieval},
 note = {event-place: Padua},
 pages = {3681--3690},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{RankLLM}},
 url = {https://doi.org/10.1145/3726302.3730331},
