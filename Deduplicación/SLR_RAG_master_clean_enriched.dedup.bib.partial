@inproceedings{bhardwaj_ai-powered_2025,
 abstract = {Abstract—This paper presents a novel approach to enhancing cybersecurity in IoT networks using machine learning-based anomaly detection. We propose a hybrid model combining convolutional neural networks (CNN) and long short-term memory (LSTM) networks to identify and mitigate distributed denial-of-service (DDoS) attacks in real-time. The model is trained on a dataset comprising normal and attack traffic from edge devices, achieving an accuracy of 98.5% and a false positive rate of 1.2%. Experimental results demonstrate superior performance compared to traditional methods like support vector machines (SVM) and random forests. The proposed system is lightweight, suitable for resource-constrained IoT environments, and scalable for large-scale deployments. Future work includes integration with blockchain for secure data sharing among IoT nodes.},
