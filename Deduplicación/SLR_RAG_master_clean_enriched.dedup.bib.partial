 year = {2022}
}

@inproceedings{ran_driver-guide_2025,
 abstract = {This paper proposes a novel distributed optimization algorithm for multi-agent systems under communication constraints. The algorithm integrates event-triggered communication and gradient tracking techniques to achieve consensus optimization while reducing communication overhead. Theoretical analysis shows that the algorithm converges to the optimal solution under mild assumptions on the objective functions and network topology. Numerical simulations demonstrate the effectiveness and efficiency of the proposed method compared to existing approaches.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
