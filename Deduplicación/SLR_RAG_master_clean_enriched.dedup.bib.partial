@inproceedings{feng_intelligent_2025,
 abstract = {The rapid advancement of 5G and beyond-5G networks demands innovative approaches to spectrum management and resource allocation. This paper proposes a novel deep reinforcement learning (DRL)-based framework for dynamic spectrum sharing in cognitive radio networks (CRNs). By integrating multi-agent DRL with graph neural networks, our approach enables secondary users to intelligently access spectrum holes while minimizing interference to primary users. Simulation results demonstrate significant improvements in throughput, energy efficiency, and convergence speed compared to traditional methods, paving the way for efficient spectrum utilization in future wireless systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
