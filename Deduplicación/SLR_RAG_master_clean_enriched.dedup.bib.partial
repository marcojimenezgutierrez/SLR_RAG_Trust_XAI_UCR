 title = {Retrieval augmented generation (rag) based restaurant chatbot with ai testability},
 url = {https://ieeexplore.ieee.org/abstract/document/10730393/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:57:17Z},
 year = {2024}
}

@inproceedings{bhatia_optimization_2024,
 abstract = {The rapid proliferation of Internet of Things (IoT) devices has led to an exponential increase in data generation, necessitating efficient data management and processing techniques. Federated Learning (FL) has emerged as a promising paradigm to address privacy concerns by enabling collaborative model training across distributed devices without sharing raw data. However, deploying FL in resource-constrained IoT environments poses significant challenges, including communication overhead, heterogeneity of devices, and security vulnerabilities. This paper provides a comprehensive survey on FL for edge computing in IoT systems. We first outline the fundamentals of FL and edge computing, then discuss key challenges and existing solutions. We categorize state-of-the-art approaches based on communication efficiency, model optimization, and privacy preservation. Finally, we highlight open research issues and future directions to advance FL deployment in IoT ecosystems.},
