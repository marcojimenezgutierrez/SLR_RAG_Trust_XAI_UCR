@inproceedings{ariza-casabona_comparative_2024,
 abstract = {Large language models (LLMs) are increasingly used in interactive applications, but their integration into user interfaces remains underexplored. We investigate how LLMs can enhance interactive data visualization authoring by proposing VizLLM, a framework that leverages LLMs to generate and refine visualization specifications from natural language descriptions. VizLLM supports iterative refinement through conversational interactions, allowing users to describe desired changes and receive updated visualizations. We evaluate VizLLM through a user study with 24 participants, comparing it to traditional visualization tools. Results show that VizLLM significantly reduces the time and effort required for creating complex visualizations, particularly for non-expert users, while maintaining high satisfaction levels. Our findings highlight the potential of LLMs in democratizing data visualization and provide design implications for future LLM-assisted creative tools.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
