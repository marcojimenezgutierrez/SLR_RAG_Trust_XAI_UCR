@book{bourne_notitle_2024,
 abstract = {This paper presents a novel approach to enhance the security of federated learning (FL) systems against model poisoning attacks by integrating blockchain technology. We propose a secure and efficient FL framework, called BlockFL, which leverages blockchain's immutability and consensus mechanisms to validate and store model updates from distributed clients. Unlike traditional FL methods that are vulnerable to malicious participants injecting poisoned gradients, BlockFL employs a smart contract-based validation process to detect anomalies in updates using statistical analysis and Byzantine fault tolerance. Our system also incorporates differential privacy to further protect client data. Extensive simulations on benchmark datasets demonstrate that BlockFL achieves up to 95% accuracy in detecting poisoning attacks while maintaining model performance comparable to state-of-the-art FL algorithms, with only a 15% increase in communication overhead. This work provides a practical solution for deploying trustworthy FL in real-world applications such as healthcare and finance.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Bourne},
