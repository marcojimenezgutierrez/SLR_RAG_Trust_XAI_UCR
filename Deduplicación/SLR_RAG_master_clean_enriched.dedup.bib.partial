 pages = {12--17},
 publisher = {Association for Computing Machinery},
 series = {{LSC}},
 title = {{MemoriEase}},
 url = {https://doi.org/10.1145/3643489.3661114},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:04:27Z},
 year = {2024}
}

@inproceedings{tran_memoriqa_2024,
 abstract = {Machine learning models are increasingly used in high-stakes decision-making applications, yet they often perpetuate societal biases present in their training data. Addressing bias in these models is critical to ensure fairness and equity. In this paper, we focus on mitigating bias in visual recognition models, specifically in the context of facial analysis tasks. We propose a comprehensive framework that combines data augmentation, adversarial training, and post-processing techniques to reduce demographic biases. Our approach is evaluated on multiple benchmark datasets, demonstrating significant improvements in fairness metrics while maintaining model accuracy. Experimental results show that our method effectively balances performance and fairness, providing a practical solution for deploying unbiased visual recognition systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Tran},
