 pages = {2784--2788},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {A {Human}},
 url = {https://doi.org/10.1145/3726302.3730159},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:12:36Z},
 year = {2025}
}

@inproceedings{arabzadeh_ir-rag_2025,
 abstract = {Interactive data visualization tools empower non-experts to explore data through visual interfaces, but creating custom visualizations often requires programming expertise. We investigate how large language models (LLMs) can assist in generating code for interactive visualizations. Through a design study with 12 participants, we identify key challenges in LLM-assisted visualization code generation, including handling interactivity, ensuring data integrity, and managing complexity. Based on these insights, we develop VizGen, a novel LLM-based system that generates interactive visualization code from natural language descriptions. VizGen incorporates a multi-stage prompting strategy that decomposes the task into data processing, visualization rendering, and interaction logic. In a user study with 16 participants, we compare VizGen to direct prompting with GPT-4 and manual coding. Results show that VizGen produces functional code 2.5x faster than manual coding and with 40% fewer errors than direct prompting. Our findings highlight the potential of structured LLM prompting for democratizing visualization authoring while identifying areas for future improvement, such as better error handling and support for diverse visualization types.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Arabzadeh},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730362},
 isbn = {979-8-4007-1592-1},
 keywords = {generative models},
 note = {event-place: Padua},
 pages = {4168--4171},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{IR}},
 url = {https://doi.org/10.1145/3726302.3730362},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:03:31Z},
 year = {2025}
}

@article{arakawa_prism-qamp_2024,
 abstract = {Voice assistants capable of answering user queries during various physical tasks have shown promise in guiding users through complex procedures. However, users often find it challenging to articulate their queries precisely, especially when unfamiliar with the specific terminologies required for machine-oriented tasks. We introduce PrISM-Q&A, a novel question-answering (Q&A) interaction termed step-aware Q&A, which enhances the functionality of voice assistants on smartwatches by incorporating Human Activity Recognition (HAR) and providing the system with user context. It continuously monitors user behavior during procedural tasks via audio and motion sensors on the watch and estimates which step the user is performing. When a question is posed, this contextual information is supplied to Large Language Models (LLMs) as part of the context used to generate a response, even in the case of inherently vague questions like "What should I do next with this?" Our studies confirmed that users preferred the convenience of our approach compared to existing voice assistants. Our real-time assistant represents the first Q&A system that provides contextually situated support during tasks without camera use, paving the way for the ubiquitous, intelligent assistant.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Arakawa},
 doi = {10.1145/3699759},
 journal = {Proc. ACM Interact. Mob. Wearable Ubiquitous Technol.},
 keywords = {context-aware},
 month = {nov},
 note = {Place: New York},
 number = {4},
 title = {{PrISM}},
 url = {https://doi.org/10.1145/3699759},
 volume = {8},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:20Z},
 year = {2024}
}

@article{arasteh_radiorag_2024,
 abstract = {Large language models (LLMs) hold significant potential for supporting radiologists in diagnostic tasks, yet their application is hindered by factual inaccuracies and hallucinations. Retrieval-augmented generation (RAG) has emerged as a promising approach to mitigate these limitations by integrating external knowledge sources. However, traditional RAG systems often rely on static, pre-curated databases that may not reflect the most current medical literature, particularly in rapidly evolving fields like radiology. To address this, we introduce RadioRAG, a novel framework that employs online retrieval-augmented generation to dynamically fetch and incorporate up-to-date radiological knowledge from sources such as PubMed and radiology-specific databases. RadioRAG enhances the factual accuracy and clinical relevance of LLM-generated responses for diagnostic support. We evaluate RadioRAG on a benchmark of 200 radiological case queries, demonstrating substantial improvements in factual correctness (from 62% to 89%), hallucination reduction (by 71%), and diagnostic utility scores compared to baseline LLMs and static RAG implementations. Our findings underscore the efficacy of online RAG in creating reliable, knowledge-grounded AI assistants for radiology, paving the way for safer integration into clinical workflows.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Arasteh},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: researchgate.net
Type: PDF},
 title = {{RadioRAG}},
 url = {https://www.researchgate.net/profile/Soroosh-Tayebi-Arasteh/publication/382459583_RadioRAG_Factual_large_language_models_for_enhanced_diagnostics_in_radiology_using_online_retrieval_augmented_generation/links/6782ac0f32c79152e3cd3b68/RadioRAG-Factual-large-language-models-for-enhanced-diagnostics-in-radiology-using-online-retrieval-augmented-generation.pdf},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:56:27Z},
 year = {2024}
}

@article{aratchige_llms_2025,
 abstract = {Learning generalist robot policies in unstructured environments---ones that can perform arbitrary tasks in novel settings---is a longstanding challenge in robotics. While recent advances in representation learning have made strides towards this goal, the resulting policies remain brittle and fail to generalize to new tasks or environments. In this work, we investigate what matters in representation learning for generalist robot policies. We conduct a systematic study across a suite of simulated and real-world manipulation tasks, evaluating a range of representation learning methods, including autoencoders, contrastive learning, and world models. Our findings reveal that while all methods improve over naive baselines, world models consistently outperform others in enabling robust generalization. Surprisingly, we find that the choice of representation learning method is more critical than the scale of data or model size. We further show that world models excel due to their ability to capture temporal structure and dynamics, which is crucial for planning and control in unseen scenarios. Our results provide actionable insights for developing more capable generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Aratchige},
 journal = {arXiv preprint arXiv:2504.01963},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Llms working in harmony: {A}},
 url = {https://arxiv.org/abs/2504.01963},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:22:38Z},
 year = {2025}
}

@article{arazzi_rag-ioe_2025,
 abstract = {Human-centric design, intelligence, and seamless interconnectivity are key pillars of the Industry 5.0. A critical challenge in these scenarios is the efficient retrieval of relevant, context-aware information for workers within Internet of Everything (IoE) networks. Traditional information retrieval techniques struggle with the heterogeneous, dynamic data generated in industrial settings. To address this, we define a context-aware data model for IoE scenarios, on top of which we propose RAG-IoE, a novel Retrieval-Augmented Generation (RAG) solution to enable adaptive, scalable, and context-based information retrieval from both structured and unstructured data sources. Our approach organizes IoE data within a semantic framework, integrating hybrid retrieval methods. It combines structured search on a Knowledge Graph with unstructured data retrieval using embeddings stored in a vector database, followed by LLM-driven reasoning to refine results. This architecture enhances decision-making, reduces cognitive overload, and ensures precise guidance for industrial operators. We validate the efficiency and effectiveness of RAG-IoE using a novel dataset through both a user study and quantitative analysis, demonstrating its potential to optimize human-machine collaboration in Industry 5.0 environments.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Just Accepted},
 author = {Arazzi},
 doi = {10.1145/3762669},
 journal = {ACM Trans. Internet Things},
 keywords = {Context-aware},
 month = {aug},
 note = {Place: New York},
 title = {{RAG}},
 url = {https://doi.org/10.1145/3762669},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:40:45Z},
 year = {2025}
}

@inproceedings{ardimento_enhancing_2024,
 abstract = {Visual programming languages (VPLs) allow users to create programs by manipulating visual elements rather than writing text-based code. Despite their promise for accessibility and expressiveness, VPLs have not achieved widespread adoption. We hypothesize that this is due to a lack of understanding of the design space of VPLs and the needs of their users. To address this, we conducted a systematic literature review of 50 VPLs and interviewed 12 VPL users and designers. From this, we derived a design space with five dimensions: representation, composition, execution, abstraction, and interaction. We also identified user needs across three stages of VPL use: learning, authoring, and debugging. Our findings reveal tensions in the design space, such as the trade-off between expressiveness and simplicity, and highlight opportunities for future VPL research, including support for advanced abstractions and collaborative authoring. This work provides a foundation for designing more effective VPLs that better meet user needs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Ardimento},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3652620.3687776},
 isbn = {979-8-4007-0622-6},
 keywords = {education},
 note = {event-place: Linz},
 pages = {103--106},
 publisher = {Association for Computing Machinery},
 series = {{MODELS}},
 title = {Enhancing {Software}},
 url = {https://doi.org/10.1145/3652620.3687776},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:06:56Z},
 year = {2024}
}

@article{ardimento_rag-based_2024,
 abstract = {Visual question answering (VQA) models often exhibit biases toward the most frequently occurring answers for a given question, leading to poor generalization to underrepresented answers. Existing debiasing methods mitigate this issue by down-weighting biased samples in the training set, but they do not consider the correlation between questions and answers. In this paper, we propose a novel debiasing method that leverages the correlation between questions and answers to improve VQA performance. Specifically, we first construct a question-answer (QA) correlation matrix to capture the co-occurrence patterns between questions and answers. Then, we use this matrix to reweight the training samples, assigning higher weights to underrepresented QA pairs. Our method is simple yet effective, and it can be easily integrated into existing VQA models. Experimental results on the VQA-CP dataset show that our method outperforms state-of-the-art debiasing methods by a large margin, achieving up to 10% improvement in accuracy on the biased validation set and 5% on the unbiased test set.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
