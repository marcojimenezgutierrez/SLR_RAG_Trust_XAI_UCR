 year = {2024}
}

@inproceedings{safaei_kglm-qa_2024,
 abstract = {The rapid advancement of artificial intelligence (AI) and machine learning (ML) technologies has significantly impacted various sectors, including healthcare. However, the integration of AI in healthcare raises critical ethical, legal, and social concerns. This paper explores the ethical implications of AI in healthcare, focusing on issues such as data privacy, algorithmic bias, accountability, and informed consent. We examine existing frameworks and guidelines from organizations like the World Health Organization (WHO) and the European Union (EU) to propose a comprehensive ethical model for AI deployment in healthcare. Through case studies, including AI-driven diagnostic tools and predictive analytics, we highlight potential risks and mitigation strategies. Our findings emphasize the need for interdisciplinary collaboration among technologists, ethicists, policymakers, and healthcare professionals to ensure that AI systems are transparent, equitable, and beneficial to patients. Ultimately, this work advocates for robust regulatory mechanisms to foster trust and responsible innovation in AI-enabled healthcare.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Safaei},
 booktitle = {2024 15th {International}},
