@article{rajbhar_aiced-prep_2025,
 abstract = {This paper proposes a novel framework for enhancing cybersecurity in IoT ecosystems using machine learning techniques. We introduce an adaptive anomaly detection model that integrates federated learning to address privacy concerns while improving real-time threat identification. Experimental results on benchmark datasets demonstrate a 25% increase in detection accuracy compared to traditional methods, with reduced computational overhead. The framework is evaluated in simulated smart home environments, highlighting its scalability and robustness against evolving attack vectors.},
