 year = {2024}
}

@inproceedings{anaissi_fine-tuning_2024,
 abstract = {Network anomaly detection is a critical task for ensuring the security and reliability of modern communication systems. Traditional methods often rely on handcrafted features and struggle with the high dimensionality and complexity of network traffic data. In this paper, we propose a novel deep learning framework that leverages graph neural networks (GNNs) to model the structural dependencies in network traffic, combined with attention mechanisms to capture temporal dynamics. Our approach constructs dynamic graphs from traffic flows, where nodes represent hosts and edges encode communication patterns. We evaluate the proposed method on real-world datasets, including CIC-IDS2017 and UNSW-NB15, demonstrating superior performance in terms of accuracy, precision, recall, and F1-score compared to state-of-the-art baselines. The results highlight the effectiveness of our graph-based representation in identifying both known and zero-day anomalies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Anaissi},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/ICDMW65004.2024.00026},
