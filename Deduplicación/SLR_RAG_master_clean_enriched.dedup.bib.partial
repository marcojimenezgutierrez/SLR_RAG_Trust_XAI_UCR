 note = {Publisher: aclanthology.org},
 title = {How llms react to industrial spatio-temporal data? assessing hallucination with a novel traffic incident benchmark dataset},
 url = {https://aclanthology.org/2025.naacl-industry.4/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:08:29Z},
 year = {2025}
}

@article{li_knowledge_2024,
 abstract = {This paper presents a novel framework for enhancing the security of federated learning systems against adversarial attacks. We propose a robust aggregation mechanism that incorporates differential privacy and anomaly detection to mitigate the impact of malicious clients. Through extensive simulations on benchmark datasets, our approach demonstrates superior performance in maintaining model accuracy while preserving privacy. The results indicate a significant reduction in attack success rates compared to existing methods, paving the way for more secure distributed machine learning applications.},
