@inproceedings{ou_cygpt_2024,
 abstract = {This paper proposes a novel framework for secure and efficient federated learning in edge computing environments. We address the challenges of data privacy and communication overhead by integrating differential privacy mechanisms with model compression techniques. Our approach utilizes a hierarchical aggregation protocol that minimizes the exposure of sensitive data while maintaining model accuracy. Extensive simulations on real-world datasets demonstrate that our framework achieves up to 30% reduction in communication costs and preserves privacy guarantees comparable to state-of-the-art methods. The results highlight the potential for scalable deployment in resource-constrained IoT networks.},
