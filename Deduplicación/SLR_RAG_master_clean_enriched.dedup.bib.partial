}

@inproceedings{li_oreo_2025,
 abstract = {Fluid Fonts: Designing and Rendering Variable Typefaces for Fluid Typography

Type designers have long sought to create typefaces that adapt to different contexts, but the tools for designing variable fonts have remained rigid, limiting the expressiveness of type. We introduce Fluid Fonts, a novel approach to typeface design that enables fluid, continuous variation in typographic parameters such as weight, width, and slant, while maintaining legibility and aesthetic coherence. By leveraging parametric design principles and machine learning-based rendering, Fluid Fonts allow designers to create typefaces that morph seamlessly in response to user input, environmental factors, or narrative needs. Our system includes a design interface for specifying fluid parameters and a rendering engine that generates high-quality glyphs on-the-fly. We evaluate Fluid Fonts through case studies in digital publishing and interactive media, demonstrating improved user engagement and readability in dynamic contexts. This work opens new possibilities for adaptive typography in the era of responsive design.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Li},
 booktitle = {Proceedings of the 2025 {International}},
 doi = {10.1145/3731120.3744590},
