 pages = {165--177},
 publisher = {Association for Computing Machinery},
 series = {{CHIIR}},
 title = {Generative {Information}},
 url = {https://doi.org/10.1145/3627508.3638345},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:29:07Z},
 year = {2024}
}

@misc{roffo_exploring_2024,
 abstract = {This research investigates the mental health implications of the COVID-19 pandemic on university students in Jordan. A cross-sectional online survey was conducted among 1,022 students from various universities during the lockdown period in April 2020. The survey utilized the Depression Anxiety Stress Scales (DASS-21) to assess psychological distress. Results revealed high prevalence rates of depression (48.2%), anxiety (53.7%), and stress (38.1%) among participants. Factors such as female gender, younger age, and living in urban areas were significantly associated with higher levels of distress. The findings highlight the urgent need for mental health support services tailored to university students during public health crises.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Comment: Keywords: Language Model Benchmarking},
 author = {Roffo},
 doi = {10.13140/RG.2.2.11774.80963},
