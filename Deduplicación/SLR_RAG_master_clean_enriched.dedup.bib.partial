@inproceedings{cao_generative_2025,
 abstract = {Recent advancements in conversational AI have enabled the creation of chatbots that can engage users in natural, human-like interactions. However, the visual presentation of these chatbots plays a crucial role in shaping user perceptions, including trust, perceived intelligence, and overall engagement. This study explores how varying visual design elements—such as avatar style (anthropomorphic vs. abstract) and color schemes (warm vs. cool)—influence users' subjective evaluations of AI chatbots. We conducted a 2x2 between-subjects experiment (N=150) where participants interacted with one of four chatbot variants in a simulated customer service scenario. Results indicate that anthropomorphic avatars significantly increased perceived trustworthiness (p < .01) and engagement (p < .05), while warm color schemes enhanced ratings of friendliness but reduced perceptions of competence. These findings highlight the importance of aligning visual design with intended user experiences in AI interfaces, offering design guidelines for developers to optimize chatbot effectiveness.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Cao},
 booktitle = {Proceedings of the 2025 {CHI}},
