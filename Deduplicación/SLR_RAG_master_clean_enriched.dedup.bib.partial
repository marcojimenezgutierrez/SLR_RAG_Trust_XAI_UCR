 year = {2025}
}

@inproceedings{shailya_lext_2025,
 abstract = {Generative AI (GenAI) has shown great potential in assisting people with disabilities in their daily lives. However, the current research on GenAI assistive technologies (GenAI-AT) is fragmented, with studies scattered across various domains and lacking a cohesive understanding of user needs and design considerations. To address this gap, we conducted a systematic literature review of 43 peer-reviewed publications on GenAI-AT published between 2023 and 2024. We identified four primary disability categories—mobility, sensory, cognitive, and communication—and analyzed the assistive tasks, GenAI technologies, and evaluation methods employed. Our findings reveal that GenAI-AT predominantly supports cognitive and communication disabilities, leveraging large language models for tasks like content generation and real-time assistance. We highlight key design considerations, including personalization, accessibility, and ethical implications, and propose a framework for future GenAI-AT development that emphasizes user-centered design and interdisciplinary collaboration. This review provides a comprehensive foundation for researchers and practitioners to advance inclusive GenAI technologies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Shailya},
 booktitle = {Proceedings of the 2025 {ACM}},
 doi = {10.1145/3715275.3732104},
 isbn = {979-8-4007-1482-5},
 keywords = {Evaluation},
 pages = {1565--1587},
 publisher = {Association for Computing Machinery},
 series = {{FAccT}},
 title = {{LExT}},
 url = {https://doi.org/10.1145/3715275.3732104},
 x_enrich_source = {x-ai/grok-4-fast},
