@inproceedings{pavlenko_vertically_2024,
 abstract = {Generative AI has shown remarkable success in creating high-quality, human-like text, but it remains unclear how people perceive and interact with such text. In this paper, we investigate how people perceive and engage with AI-generated text in a social media context. We conducted a mixed-methods study with 240 participants who interacted with Twitter threads containing AI-generated replies. Our findings reveal that people often fail to distinguish AI-generated text from human-written text, with accuracy rates around 50%. However, when they do identify AI-generated text, they perceive it as less engaging and more repetitive. We also found that people are more likely to engage with (e.g., like, retweet) human-written text. Our qualitative analysis highlights themes such as perceived authenticity, emotional resonance, and contextual relevance as key factors influencing perceptions. These insights have implications for the design of AI systems that generate social media content and for understanding human-AI interaction in online environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Pavlenko},
 booktitle = {Companion of the 2024 {International}},
 doi = {10.1145/3626246.3653378},
