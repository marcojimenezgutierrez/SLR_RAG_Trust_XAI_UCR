 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:24:10Z},
 year = {2025}
}

@inproceedings{zhang_ai_2024,
 abstract = {Fairness in machine learning has gained significant attention in recent years, particularly in the context of visual recognition tasks. However, achieving fairness while maintaining model performance remains a challenging problem. In this paper, we propose a comprehensive framework for bias mitigation and evaluation in visual recognition models. Our approach consists of three key components: (1) a novel debiasing technique that leverages adversarial training to reduce demographic biases in feature representations, (2) a fairness-aware fine-tuning strategy that balances accuracy and fairness objectives, and (3) a set of evaluation metrics that provide a holistic assessment of both group and individual fairness. We evaluate our framework on multiple benchmark datasets, including CelebA and UTKFace, demonstrating significant improvements in fairness metrics without substantial degradation in classification accuracy. Our results highlight the effectiveness of our method in addressing intersectional biases and provide insights into the trade-offs between fairness and performance in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
