}

@inproceedings{zhang_are_2024,
 abstract = {This paper explores the design and evaluation of a novel haptic feedback system for wearable devices aimed at enhancing users' perceptual awareness in dynamic environments. We conducted a series of user studies to assess the effectiveness of different haptic patterns in conveying spatial and temporal information. Our findings indicate that vibrotactile cues significantly improve reaction times and accuracy in obstacle avoidance tasks compared to auditory or visual alternatives. The system was prototyped using off-the-shelf components and tested in real-world urban settings. Implications for accessibility and immersion in augmented reality applications are discussed.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
