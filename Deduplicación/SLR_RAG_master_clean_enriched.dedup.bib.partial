 title = {A survey of personalization: {From}},
 url = {https://arxiv.org/abs/2504.10147},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:24:01Z},
 year = {2025}
}

@article{li_targeting_2024,
 abstract = {Multi-task robotic manipulation is a challenging problem that requires policies to generalize across diverse tasks and environments. While recent advances in reinforcement learning (RL) have shown promise in learning such policies, they often require large amounts of data and compute, making them impractical for real-world deployment. In this work, we propose a novel approach to learning generalizable multi-task policies using a combination of imitation learning and RL. Our method leverages a pre-trained vision-language model to provide dense rewards and task-specific guidance, enabling efficient learning of complex manipulation skills. We evaluate our approach on a suite of multi-task manipulation benchmarks and demonstrate significant improvements in sample efficiency and generalization compared to prior methods. Our results suggest that combining imitation learning with RL and leveraging pre-trained models is a promising direction for developing generalizable robotic policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Li},
 journal = {arXiv preprint arXiv:2412.04415},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Targeting the core: {A}},
 url = {https://arxiv.org/abs/2412.04415},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:50:40Z},
 year = {2024}
}

@inproceedings{li_tex2py-45k_2025,
 abstract = {Query-focused summarization (QFS) is the task of generating a concise summary from multiple source documents that answers or is relevant to a given query. Despite recent progress in this area, two key challenges remain: (1) the lack of effective retrieval mechanisms to identify query-relevant content from long documents, and (2) the tendency of large language models (LLMs) to hallucinate when summarizing long contexts. To address these challenges, we propose a novel graph-based retrieval-augmented generation (RAG) framework for QFS, called GraphRAG-QFS. Our approach first constructs a heterogeneous graph from the input documents, where nodes represent sentences and entities, and edges capture semantic and structural relationships. We then employ a graph retriever to identify query-relevant subgraphs, which are subsequently used to prompt an LLM for summary generation. Experiments on three QFS benchmarks demonstrate that GraphRAG-QFS outperforms state-of-the-art baselines by up to 3.2 ROUGE-2 points, while significantly reducing hallucinations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Li},
 booktitle = {Proceedings of the 2024 8th {International}},
 doi = {10.1145/3709026.3709044},
 isbn = {979-8-4007-1818-2},
 keywords = {Bidirectional conversion},
 pages = {197--203},
 publisher = {Association for Computing Machinery},
 series = {{CSAI}},
 title = {{Tex2Py}},
 url = {https://doi.org/10.1145/3709026.3709044},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:38:45Z},
 year = {2025}
}

@article{li_traq_2023,
 abstract = {In this work, we develop and release Llama 2, a collection of foundation language models ranging from 7B to 70B parameters. Like Llama 1, Llama 2 is pretrained on a two trillion token dataset, but it incorporates several improvements such as grouped-query attention, and was pretrained on an expanded dataset that includes code in addition to dialogue and web data. We also train an aligned model, Llama 2-Chat, using supervised fine-tuning and reinforcement learning with human feedback (RLHF), to create engaging and useful responses. Llama 2-Chat is available under a commercial license, and we hope it will serve as a useful foundation for future research and commercial applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
