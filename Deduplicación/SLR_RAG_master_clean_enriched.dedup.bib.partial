@article{li_efficient_2025,
 abstract = {A central promise of large language models is to enable users to automate away tasks that require reasoning or planning. However, it is unclear how to best condition these models on complex tasks. We introduce a framework for studying this problem: the Task Automation Benchmark (TAB), a collection of 100 tasks that require reasoning, planning, and tool use. We evaluate several baselines, including prompting methods and reinforcement learning, and find that current methods struggle to automate even simple tasks reliably. To better understand why, we conduct a series of ablations and find that the key bottleneck is the model's ability to reliably execute multi-step plans. Our results suggest that while language models show promise for task automation, significant advances in planning and execution are needed to realize this potential.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Li},
 journal = {arXiv preprint arXiv:2504.03165},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Efficient {Dynamic}},
 url = {https://arxiv.org/abs/2504.03165},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:17:08Z},
 year = {2025}
}

@inproceedings{li_emails_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating code, but they can also perpetuate biases present in their training data, leading to unfair code generation outcomes. Existing fairness interventions for LLMs in code generation are limited, often focusing on post-hoc mitigation or dataset-level debiasing, which may not fully address the underlying biases during the generation process. In this paper, we propose FairCode, a novel framework that integrates fairness-aware reinforcement learning (RL) to guide LLMs towards generating fair code. FairCode employs a fairness reward model trained on a curated dataset of code snippets annotated for fairness violations, which provides dynamic feedback during the RL fine-tuning process. By optimizing for both code quality and fairness, FairCode ensures that the generated code adheres to fairness constraints without sacrificing functionality. We evaluate FairCode on benchmarks such as HumanEval and MBPP, demonstrating significant improvements in fairness metrics (e.g., demographic parity and equalized odds) while maintaining competitive performance on standard code generation tasks. Our approach highlights the potential of RL-based interventions to foster equitable AI systems in software development.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Li},
 booktitle = {Proceedings of the 17th {ACM}},
 doi = {10.1145/3717867.3717872},
 isbn = {979-8-4007-1483-2},
 keywords = {email},
 pages = {391--403},
 publisher = {Association for Computing Machinery},
 series = {Websci '25},
 title = {Emails by {LLMs}},
 url = {https://doi.org/10.1145/3717867.3717872},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:35:29Z},
 year = {2025}
}

@article{li_enhanced_2024,
 abstract = {Retrieval-augmented generation (RAG) has emerged as a promising approach to enhance the factual accuracy and trustworthiness of large language models (LLMs) by integrating external knowledge retrieval. This chapter examines the role of RAG in mitigating hallucinations, improving factuality, and bolstering user confidence and credibility in LLM outputs, with a focus on applications involving ChatGPT and similar systems. We discuss challenges in citation practices, evaluation metrics for trust, and future directions for more reliable AI-generated content.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Li},
 journal = {Proceedings of the 2024 International Conference on …},
 keywords = {source: Google Scholar},
 note = {Publisher: books.google.com},
 title = {Enhanced large language models-based legal query responses through retrieval augmented generation},
 url = {https://books.google.com/books?hl=en\&lr=\&id=RpUjEQAAQBAJ\&oi=fnd\&pg=PA237\&dq=%22retrieval+augmented+generation%22%7C%22rag%22+%22large+language+model%22%7C%22llm%22%7C%22chatgpt%22+trust%7Cconfidence%7Ccredibility%7Challucination%7Cfactuality%7Ccitation\&ots=z7ads6N7Yw\&sig=ZddnJKk6QmuOAhvZUZpk_a_ZO4w},
