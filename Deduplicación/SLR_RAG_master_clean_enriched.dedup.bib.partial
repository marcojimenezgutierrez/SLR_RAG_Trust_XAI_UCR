 url = {https://arxiv.org/abs/2408.01107},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:07:07Z},
 year = {2024}
}

@inproceedings{wang_colacare_2025,
 abstract = {Machine learning models often exhibit biases that lead to unfair outcomes for different demographic groups. Achieving fairness in machine learning is crucial for ethical AI deployment, yet current approaches often trade off accuracy for fairness or fail to generalize across datasets. In this work, we propose FairGen, a generative framework that learns to synthesize fair training data by disentangling sensitive attributes from task-relevant features. Our method leverages variational autoencoders with fairness-aware priors to generate balanced datasets that mitigate bias at the data level. Extensive experiments on image classification tasks demonstrate that models trained on FairGen data achieve up to 20% improvement in fairness metrics (e.g., demographic parity and equalized odds) compared to baselines, while preserving or enhancing overall accuracy. We also show that FairGen generalizes to unseen sensitive attributes, making it a versatile tool for debiasing in diverse applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 1},
