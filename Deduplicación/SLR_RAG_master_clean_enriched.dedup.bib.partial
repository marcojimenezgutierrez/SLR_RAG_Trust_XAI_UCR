 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:26:06Z},
 year = {2025}
}

@inproceedings{yilmaz_grounded_2025,
 abstract = {Abstract—This paper presents a comprehensive review of recent advances in machine learning applications for cybersecurity. We discuss key algorithms, challenges, and future directions in detecting and mitigating cyber threats using AI techniques. The study highlights the integration of deep learning models with traditional security measures to enhance system resilience against evolving attacks. Experimental results from benchmark datasets demonstrate the efficacy of hybrid approaches in improving detection accuracy and reducing false positives.},
