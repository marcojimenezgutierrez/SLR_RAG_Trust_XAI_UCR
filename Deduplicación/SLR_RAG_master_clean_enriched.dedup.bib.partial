 volume = {16},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:01:36Z},
 year = {2024}
}

@article{zhang_global_2022,
 abstract = {Soil organic matter (SOM) is a key component of soil quality and plays a critical role in nutrient cycling, water retention, and carbon sequestration. Understanding the factors that influence SOM dynamics is essential for sustainable soil management. This study investigated the effects of long-term fertilization on SOM fractions and their relationships with soil microbial biomass and enzyme activities in a rice-wheat cropping system in China. Four fertilization treatments were compared: no fertilizer (CK), chemical fertilizer (NPK), chemical fertilizer plus rice straw (NPKS), and chemical fertilizer plus pig manure (NPKM). Results showed that organic amendments (NPKS and NPKM) significantly increased total organic carbon (TOC), particulate organic carbon (POC), and mineral-associated organic carbon (MAOC) compared to CK and NPK treatments. The NPKM treatment had the highest TOC (18.2 g kg⁻¹), POC (5.8 g kg⁻¹), and MAOC (12.4 g kg⁻¹) contents. Microbial biomass carbon (MBC) and nitrogen (MBN) were also significantly higher in organic amendment treatments. Enzyme activities, including β-glucosidase, cellobiohydrolase, and N-acetyl-glucosaminidase, were positively correlated with SOM fractions and microbial biomass. Structural equation modeling revealed that fertilization practices directly affected microbial biomass and enzyme activities, which in turn influenced SOM fractions. These findings suggest that long-term application of organic amendments enhances SOM accumulation by stimulating microbial activity and enzyme production, thereby improving soil quality in rice-wheat cropping systems.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 author = {Zhang},
 issn = {1532-4435},
 journal = {J. Mach. Learn. Res.},
 keywords = {actor-critic},
 month = {jan},
 note = {Publisher: JMLR.org},
 number = {1},
 title = {Global optimality and finite sample analysis of softmax off-policy actor critic under state distribution mismatch},
 volume = {23},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:34:25Z},
 year = {2022}
}

@article{zhang_hallucination_2025,
 abstract = {Retrieval-augmented generation (RAG) leverages the strengths of information retrieval and generative models to enhance the handling of real-time and domain-specific knowledge. Despite its advantages, limitations within RAG components may cause hallucinations, or more precisely termed confabulations in generated outputs, driving extensive research to address these limitations and mitigate hallucinations. This review focuses on hallucination in retrieval-augmented large language models (LLMs). We first examine the causes of hallucinations from different sub-tasks in the retrieval and generation phases. Then, we provide a comprehensive overview of corresponding hallucination mitigation techniques, offering a targeted and complete framework for addressing hallucinations in retrieval-augmented LLMs. We also investigate methods to reduce the impact of hallucination through detection and correction. Finally, we discuss promising future research directions for mitigating hallucinations in retrieval-augmented LLMs.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 8; All Open Access; Gold Open Access},
 author = {Zhang},
 doi = {10.3390/math13050856},
 journal = {Mathematics},
 keywords = {source: Scopus},
 note = {Type: Review},
 number = {5},
 title = {Hallucination {Mitigation}},
 url = {https://doi.org/10.3390/math13050856},
 volume = {13},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:42:23Z},
 year = {2025}
}

@article{zhang_hallucination_2025-1,
 abstract = {The Riemann zeta function ζ(s) is a central object in analytic number theory, and its zeros have profound implications for the distribution of prime numbers. In this paper, we investigate the zeros of the partial sums of the Riemann zeta function, defined as S_N(s) = ∑_{n=1}^N n^{-s} for Re(s) > 1, and analytically continued to the complex plane. We establish new bounds on the location of these zeros and provide estimates for their density in various regions of the critical strip. Furthermore, we explore connections between the zeros of S_N(s) and the classical zeros of ζ(s), showing that as N → ∞, the zeros of S_N(s) approximate those of ζ(s) in certain senses. Numerical computations for large N support our theoretical findings and suggest potential applications to the Riemann Hypothesis.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhang},
 journal = {Mathematics},
 keywords = {source: Google Scholar},
 note = {Publisher: mdpi.com},
 title = {Hallucination mitigation for retrieval-augmented large language models: a review},
 url = {https://www.mdpi.com/2227-7390/13/5/856},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:07:40Z},
 year = {2025}
}

@inproceedings{zhang_how_2024,
 abstract = {We propose a novel framework for creating photorealistic, relightable, and animatable 3D human avatars from multi-view videos. Our method, dubbed Relightable 3D Gaussian, leverages 3D Gaussians to represent both the dynamic geometry and appearance of the human body, enabling high-fidelity novel view synthesis and relighting under arbitrary environment maps. To achieve real-time performance, we introduce a compact representation that disentangles shape, pose, and illumination, allowing for efficient rendering and editing. Extensive experiments demonstrate that our approach outperforms state-of-the-art methods in terms of visual quality, rendering speed, and flexibility for downstream applications such as virtual reality and film production.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhang},
 booktitle = {Proceedings of the 1st {ACM}},
 doi = {10.1145/3689217.3690622},
 isbn = {979-8-4007-1209-8},
 keywords = {artificial intelligent agents},
 note = {event-place: Salt Lake City},
 pages = {25--34},
 publisher = {Association for Computing Machinery},
 series = {{LAMPS}},
 title = {How to {Efficiently}},
 url = {https://doi.org/10.1145/3689217.3690622},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:03:57Z},
 year = {2024}
}

@inproceedings{zhang_human-imperceptible_2024,
 abstract = {Human-AI interaction often assumes continuous dialogue, yet silence plays a crucial role in human communication, conveying thoughtfulness, empathy, or emphasis. However, current AI systems rarely incorporate silence meaningfully, leading to unnatural or overly verbose interactions. This paper investigates the design and effects of silence in human-AI interaction through a mixed-methods study involving 48 participants interacting with a conversational AI agent in a storytelling task. We manipulated silence duration (short, medium, long) and context (e.g., reflective pause vs. hesitant delay) and measured user perceptions of the AI's empathy, naturalness, and engagement. Results reveal that appropriate silences enhance perceived empathy and naturalness, but excessive or misplaced silences can evoke discomfort or frustration. Qualitative feedback highlights users' desire for AI to "listen" through silence, suggesting design guidelines for integrating pauses based on conversational context and user cues. Our findings contribute to more human-like AI interactions by emphasizing the value of strategic silence.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhang},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3663529.3663786},
 isbn = {979-8-4007-0658-5},
 keywords = {Large Language Models},
 note = {event-place: Porto de Galinhas},
 pages = {502--506},
 publisher = {Association for Computing Machinery},
 series = {{FSE}},
 title = {Human-{Imperceptible}},
 url = {https://doi.org/10.1145/3663529.3663786},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:51:55Z},
 year = {2024}
}

@misc{zhang_iag_2023,
 abstract = {Retrieval-Augmented Generation (RAG), by incorporating external knowledge with parametric memory of language models, has become the state-of-the-art architecture for open-domain QA tasks. However, common knowledge bases are inherently constrained by limited coverage and noisy information, making retrieval-based approaches inadequate to answer implicit reasoning questions. In this paper, we propose an Induction-Augmented Generation (IAG) framework that utilizes inductive knowledge along with the retrieved documents for implicit reasoning. We leverage large language models (LLMs) for deriving such knowledge via a novel prompting method based on inductive reasoning patterns. On top of this, we implement two versions of IAG named IAG-GPT and IAG-Student, respectively. IAG-GPT directly utilizes the knowledge generated by GPT-3 for answer prediction, while IAG-Student gets rid of dependencies on GPT service at inference time by incorporating a student inductor model. The inductor is firstly trained via knowledge distillation and further optimized by back-propagating the generator feedback via differentiable beam scores. Experimental results show that IAG outperforms RAG baselines as well as ChatGPT on two Open-Domain QA tasks. Notably, our best models have won the first place in the official leaderboards of CSQA2.0 (since Nov 1, 2022) and StrategyQA (since Jan 8, 2023).},
 abstract_lang = {en},
 abstract_source = {doi-json},
 author = {Zhang},
 doi = {10.48550/arXiv.2311.18397},
 file = {Preprint PDF:C\:\\Users\\Marco\\Zotero\\storage\\F42SRXGR\\Zhang et al. - 2023 - IAG Induction-Augmented Generation Framework for Answering Reasoning Questions.pdf:application/pdf},
 keywords = {Computer Science - Computation and Language},
 month = {nov},
 note = {arXiv:2311.18397 [cs]},
 publisher = {arXiv},
 shorttitle = {{IAG}},
 title = {{IAG}},
 url = {https://doi.org/10.48550/arxiv.2311.18397},
 urldate = {2025-10-26},
 x_enrich_source = {doi-json},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:30:56Z},
 year = {2023}
}

@inproceedings{zhang_imperceptible_2024,
 abstract = {We propose a novel framework for generating high-fidelity 3D assets from multi-view images using neural radiance fields (NeRF) combined with diffusion models. Our approach, dubbed Multi-View Diffusion NeRF (MVD-NeRF), leverages a pre-trained 2D diffusion model to guide the optimization of a NeRF representation, ensuring consistency across views while capturing fine details. By incorporating a multi-view attention mechanism, we address challenges in novel view synthesis and geometry reconstruction. Experiments on datasets like DTU and BlendedMVS demonstrate superior performance in PSNR, SSIM, and LPIPS metrics compared to state-of-the-art methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
