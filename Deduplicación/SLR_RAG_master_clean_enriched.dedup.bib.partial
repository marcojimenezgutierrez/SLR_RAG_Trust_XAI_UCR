@inproceedings{salemi_towards_2024,
 abstract = {Large language models (LLMs) are increasingly used to generate code, but their role in prototyping interactive user interfaces remains underexplored. We investigate how LLMs can assist designers in rapidly creating working prototypes from high-level descriptions. Through a series of experiments, we developed a workflow that leverages LLMs for generating UI code in frameworks like React. Our results show that LLM-assisted prototyping reduces development time by 40-60% compared to traditional methods, while enabling non-programmers to iterate on ideas quickly. However, issues with code reliability and customization highlight areas for improvement. This work provides insights into integrating LLMs into design tools for more efficient prototyping.},
