@inproceedings{feng_secllm-intent-driven_2025,
 abstract = {This paper proposes a novel approach to enhance the security of Internet of Things (IoT) devices using blockchain technology integrated with machine learning algorithms. We address the challenges of data privacy and authentication in distributed networks by developing a lightweight consensus mechanism that reduces computational overhead while maintaining robustness against common attacks such as DDoS and man-in-the-middle. Experimental results on a simulated IoT environment demonstrate a 40% improvement in response time and a 25% reduction in energy consumption compared to traditional methods. The proposed framework is scalable and suitable for resource-constrained devices, paving the way for secure smart city applications.},
 abstract_lang = {en},
