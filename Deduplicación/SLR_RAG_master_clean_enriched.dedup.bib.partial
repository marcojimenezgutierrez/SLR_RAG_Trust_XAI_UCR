@inproceedings{bi_rbdq_2025,
 abstract = {Personal fabrication technologies have enabled children to create physical artifacts using digital design tools. However, the design space of personal fabrication for children remains underexplored, particularly in terms of how children engage with these technologies in educational settings. In this paper, we present a study exploring how children (ages 8-12) interact with personal fabrication tools during a workshop series focused on designing and building interactive prototypes. Through qualitative analysis of workshop observations, interviews, and artifact analysis, we identify key themes in children's design processes, including iterative experimentation, collaboration, and the integration of digital and physical elements. Our findings reveal opportunities for enhancing personal fabrication tools to better support children's creativity and learning, such as adaptive interfaces and scaffolding for complex assemblies. We discuss implications for designing child-centered fabrication experiences and future research directions in this domain.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
