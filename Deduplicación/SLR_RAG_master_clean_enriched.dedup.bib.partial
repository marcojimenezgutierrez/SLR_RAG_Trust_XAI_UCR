 number = {4},
 title = {{ECHO}},
 url = {https://doi.org/10.1145/3734191},
 volume = {9},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:22Z},
 year = {2025}
}

@inproceedings{vandeputte_foundational_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, they can inherit and amplify biases from training data, leading to unfair outcomes. Fine-tuning LLMs on specific datasets can mitigate these biases, but the process itself may introduce new fairness issues. In this paper, we survey recent advances in fairness-aware fine-tuning of LLMs. We categorize the methods into data-centric, model-centric, and post-processing approaches, and discuss their strengths and limitations. We also identify open challenges and future directions for fair LLM fine-tuning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Vandeputte},
 booktitle = {Proceedings of the 2025 {ACM}},
 doi = {10.1145/3759429.3762620},
