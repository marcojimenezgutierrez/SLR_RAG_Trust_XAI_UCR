@inproceedings{yang_enhancing_2025,
 abstract = {In this paper, we introduce a novel framework for multi-modal video anomaly detection in surveillance systems, leveraging both visual and audio cues to enhance detection accuracy. Our approach integrates a transformer-based architecture with cross-modal attention mechanisms to fuse RGB video frames and audio spectrograms, addressing challenges such as subtle anomalies and environmental noise. Extensive experiments on benchmark datasets like UCSD Ped2 and Avenue demonstrate that our method outperforms state-of-the-art techniques, achieving up to 15% improvement in AUC scores. The framework is lightweight and deployable on edge devices, making it suitable for real-world applications.},
 abstract_lang = {en},
