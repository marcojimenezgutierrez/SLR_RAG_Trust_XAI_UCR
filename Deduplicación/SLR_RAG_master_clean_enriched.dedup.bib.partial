@article{paneru_leveraging_2024,
 abstract = {Artificial intelligence (AI) has become increasingly prevalent in various domains, including healthcare, where it is used to support clinical decision-making. However, the integration of AI into clinical practice raises ethical concerns, particularly regarding accountability and trust. This paper explores the ethical implications of AI in healthcare through a multidisciplinary lens, drawing on philosophy, law, and computer science. We examine key issues such as bias in AI algorithms, informed consent, and the distribution of responsibility between AI systems and human clinicians. Using case studies from diagnostic imaging and personalized medicine, we argue that a framework for ethical AI deployment must prioritize transparency, human oversight, and continuous evaluation. Our findings suggest that while AI offers significant benefits, unchecked implementation could exacerbate inequalities and erode patient trust. We propose a set of guidelines to mitigate these risks and foster responsible innovation in healthcare AI.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 4; All Open Access; Gold Open Access},
 author = {Paneru},
 doi = {10.1016/j.teler.2024.100181},
 journal = {Telematics and Informatics Reports},
 keywords = {source: Scopus},
