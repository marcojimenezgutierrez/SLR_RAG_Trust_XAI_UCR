@inproceedings{liu_enhancing_2025,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices while preserving data privacy. However, integrating large language models (LLMs) into FL frameworks introduces significant challenges, including high communication costs, resource constraints on edge devices, and potential privacy leakage risks. This paper proposes a novel secure and efficient FL framework tailored for LLMs, called SecureFedLLM. We introduce a lightweight model compression technique combined with differential privacy mechanisms to reduce communication overhead and enhance privacy guarantees. Additionally, we design an adaptive aggregation protocol that dynamically adjusts to heterogeneous device capabilities. Extensive experiments on benchmark datasets demonstrate that SecureFedLLM achieves up to 40% reduction in communication costs and maintains model accuracy comparable to centralized training, while providing strong theoretical privacy bounds.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
