 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:25:08Z},
 year = {2025}
}

@inproceedings{tundik_building_2024,
 abstract = {This paper introduces a novel framework for detecting and classifying cyber threats in IoT networks using machine learning techniques. The proposed system leverages a hybrid model combining convolutional neural networks (CNNs) and long short-term memory (LSTM) networks to analyze network traffic patterns. By preprocessing data with feature selection algorithms and applying ensemble learning, the model achieves high accuracy in identifying anomalies and specific attack types such as DDoS and ransomware. Experimental evaluations on real-world datasets demonstrate an improvement of 15% in detection rate compared to state-of-the-art methods, with reduced false positives. The framework is designed for real-time deployment, addressing scalability issues in large-scale IoT environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
