@article{meduri_efficient_2024,
 abstract = {Retrieval-Augmented Generation (RAG) has become a cornerstone for enhancing large language models (LLMs) with external knowledge, enabling more accurate and contextually relevant responses. However, applying RAG to large-scale knowledge bases introduces significant challenges, including high computational costs, slow retrieval times, and scalability issues. In this paper, we propose an efficient RAG framework designed to handle massive knowledge bases with minimal latency and resource overhead. Our approach integrates hierarchical indexing, adaptive chunking strategies, and parallelized retrieval mechanisms to optimize both the retrieval and generation phases. By leveraging vector databases and fine-tuned embedding models, we achieve up to 5x faster query processing while preserving or improving response fidelity. Extensive experiments on diverse datasets, including Wikipedia and domain-specific corpora, demonstrate the framework's superiority over traditional RAG implementations in terms of efficiency, accuracy, and robustness to scale.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Meduri},
 journal = {Efficient RAG …},
 keywords = {source: Google Scholar},
 note = {Publisher: researchgate.net
Type: PDF},
