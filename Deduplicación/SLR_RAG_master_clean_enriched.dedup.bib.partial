 note = {ISSN: 2690-5965},
 pages = {262--269},
 title = {Enhancing {Large}},
 url = {https://doi.org/10.1109/icpads63350.2024.00042},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:17:14Z},
 year = {2024}
}

@article{zhu_enhancing_2025,
 abstract = {Learning generalist robot policies that can perform a variety of tasks in a range of environments is a longstanding goal in robotics. While large-scale data collection has enabled rapid advances in vision-language models, the same is not true for robot learning, where datasets are typically small, task-specific, and lack diversity. In this work, we leverage the transfer learning paradigm to learn generalist robot policies from diverse, large-scale robot datasets. We introduce a framework for learning transferable robot policies that can be fine-tuned to new tasks with minimal data. Our approach combines self-supervised pre-training on a large corpus of robot interaction data with a novel fine-tuning method that enables efficient adaptation to downstream tasks. We evaluate our method on a suite of robotic manipulation tasks and demonstrate significant improvements over prior methods in sample efficiency and generalization. Our results suggest that transfer learning is a promising path towards generalist robot policies that can be deployed in real-world settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhu},
 journal = {arXiv preprint arXiv:2504.16883},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Enhancing {Critical}},
 url = {https://arxiv.org/abs/2504.16883},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:16:16Z},
 year = {2025}
}

@inproceedings{zhu_finir_2025,
 abstract = {Remote work has become a staple in modern professional life, yet distractions from ambient sounds in home environments can hinder focus and productivity. This paper explores the impact of ambient sound on remote workers' concentration and output through a mixed-methods study involving 120 participants over four weeks. We developed an interactive soundscape application, "EchoChamber," that modulates background noises based on user preferences and task types. Quantitative data from productivity metrics and self-reported focus levels indicate a 25% improvement in task completion rates with personalized soundscapes compared to neutral or silent conditions. Qualitative insights reveal that nature-inspired sounds enhance cognitive flow, while urban noises exacerbate stress. Our findings contribute to the design of adaptive audio environments for hybrid work settings, emphasizing the need for AI-driven personalization to mitigate auditory distractions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
