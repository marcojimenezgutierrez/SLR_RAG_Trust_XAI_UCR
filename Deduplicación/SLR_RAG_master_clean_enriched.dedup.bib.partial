@inproceedings{darji_enhancing_2024,
 abstract = {Brain tumor detection plays a crucial role in the diagnosis and treatment of this life-threatening disease. Traditional methods rely on manual interpretation of medical images, which is time-consuming and subject to human error. In this paper, we propose a novel deep learning framework for automated brain tumor classification using magnetic resonance imaging (MRI) scans. The model employs a hybrid convolutional neural network (CNN) architecture combined with transfer learning from pre-trained models like VGG16 and ResNet50 to enhance feature extraction. We utilize a publicly available dataset comprising T1-weighted contrast-enhanced MRI images categorized into glioma, meningioma, pituitary, and no tumor classes. Data augmentation techniques are applied to address class imbalance and improve generalization. Experimental results demonstrate that the proposed model achieves an accuracy of 98.5%, precision of 98.2%, recall of 98.4%, and F1-score of 98.3%, outperforming state-of-the-art methods. This approach offers a promising tool for radiologists to expedite diagnosis and improve patient outcomes.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Darji},
