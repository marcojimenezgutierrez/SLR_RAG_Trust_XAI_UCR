@inproceedings{de_araujo_luz_junior_generative_2025,
 abstract = {This paper proposes a novel framework for enhancing cybersecurity in smart grid systems using machine learning techniques. We introduce a hybrid model that combines convolutional neural networks (CNNs) with long short-term memory (LSTM) networks to detect anomalous behaviors in real-time power distribution data. The approach is evaluated on a dataset from the IEEE test systems, achieving a detection accuracy of 98.5% and reducing false positives by 30% compared to traditional methods. Our results demonstrate the framework's robustness against adversarial attacks and its potential for deployment in large-scale energy infrastructures.},
