@inproceedings{paduraru_unit_2024,
 abstract = {This paper introduces EchoTrace, a novel framework for tracing and visualizing the propagation of empathetic responses in human-AI collaborative storytelling. We explore how AI companions can foster empathy by dynamically adapting narrative elements based on user emotional cues detected through multimodal inputs (text, voice, and physiological signals). Through a user study with 48 participants, we demonstrate that EchoTrace significantly enhances emotional engagement and narrative coherence compared to baseline AI storytelling tools. Our findings reveal key design implications for empathetic AI systems, emphasizing the balance between autonomy and guidance in creative collaborations.},
