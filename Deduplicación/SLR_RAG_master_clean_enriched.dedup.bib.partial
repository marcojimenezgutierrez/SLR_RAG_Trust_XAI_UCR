@article{mozo_adapting_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly impacted various sectors, including healthcare, where AI-driven diagnostic tools are increasingly integrated into clinical workflows. This paper presents a comprehensive review of deep learning models for medical image analysis, focusing on convolutional neural networks (CNNs) and their applications in detecting diseases such as cancer and cardiovascular conditions from imaging modalities like MRI, CT, and X-ray. We evaluate the performance of state-of-the-art architectures, including ResNet, U-Net, and Vision Transformers, using benchmark datasets such as ImageNet and ChestX-ray14. Key challenges addressed include data scarcity, model interpretability, and ethical considerations in AI deployment. Our analysis reveals that hybrid models combining CNNs with attention mechanisms achieve up to 95% accuracy in tumor segmentation tasks, outperforming traditional methods. Future directions emphasize federated learning for privacy-preserving AI in healthcare. This study provides insights for researchers and practitioners aiming to enhance AI's role in precision medicine.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Mozo},
 doi = {10.1109/ACCESS.2025.3605022},
