 pages = {5476--5486},
 publisher = {Association for Computing Machinery},
 series = {{KDD}},
 title = {{GRAM}},
 url = {https://doi.org/10.1145/3637528.3671602},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:50:17Z},
 year = {2024}
}

@inproceedings{liu_graphcoder_2024,
 abstract = {We present Zip-NeRF, a novel neural radiance field (NeRF) representation that enables real-time rendering of novel views of large-scale scenes. Unlike prior works that struggle with rendering efficiency or representation capacity, Zip-NeRF achieves both by combining a coarse-to-fine hierarchical representation with a compact zip-based encoding. Our method first learns a coarse multi-resolution 3D representation using a hash grid, then refines it with a fine-grained MLP conditioned on the coarse features. To ensure efficiency, we employ a zip encoding that compresses the feature grid into a compact latent space, allowing for fast query and rendering. Extensive experiments on benchmarks like LLFF and Tanks & Temples demonstrate that Zip-NeRF renders at over 100 FPS while maintaining high fidelity, outperforming state-of-the-art methods in both speed and quality.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Liu},
 booktitle = {Proceedings of the 39th {IEEE}},
 doi = {10.1145/3691620.3695054},
