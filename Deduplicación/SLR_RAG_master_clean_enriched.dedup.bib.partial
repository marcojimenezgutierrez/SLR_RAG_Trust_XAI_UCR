@article{anjum_halo_2025,
 abstract = {Personalized federated learning (PFL) enables clients to learn personalized models without sharing their private data, which is crucial for privacy-sensitive applications. However, existing PFL methods often struggle to balance personalization and communication efficiency, especially when clients have heterogeneous data distributions. In this paper, we propose a novel PFL framework called pFedSim, which achieves both high personalization and low communication overhead by leveraging a small set of global model parameters to simulate personalized models for each client. Specifically, pFedSim consists of two key components: (1) a low-rank adaptation (LoRA) module that captures client-specific knowledge with a small number of parameters, and (2) a hypernetwork that generates personalized LoRA parameters based on client embeddings. During training, clients only upload their embeddings and LoRA updates, while the server aggregates embeddings to update the hypernetwork. In inference, each client can generate its personalized LoRA parameters locally using its embedding and the global hypernetwork, thus avoiding the need to store or transmit large personalized models. Extensive experiments on various datasets demonstrate that pFedSim outperforms state-of-the-art PFL methods in terms of personalization accuracy while reducing communication costs by up to 90%.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Anjum},
 doi = {10.1145/3721201.3721385},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {187 -- 198},
 title = {{HALO}},
 url = {https://doi.org/10.1145/3721201.3721385},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:48:27Z},
 year = {2025}
}

@article{anjum_halo_2025-1,
 abstract = {This paper proposes a novel framework for privacy-preserving federated learning in edge computing environments. We address the challenges of data heterogeneity and communication efficiency by introducing a differential privacy mechanism integrated with model compression techniques. Extensive experiments on benchmark datasets demonstrate that our approach achieves up to 20% improvement in accuracy while reducing communication overhead by 50% compared to baseline methods. The framework is particularly suited for resource-constrained IoT devices, ensuring robust performance against adversarial attacks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
