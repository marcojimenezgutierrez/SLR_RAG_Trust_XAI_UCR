@inproceedings{guo_ideabench_2025,
 abstract = {Gaussian Splatting has recently emerged as a highly efficient radiance field representation that can be rendered in real-time. However, it is not yet suitable for dynamic scenes, as it is designed for static environments. We propose a novel approach to extend Gaussian Splatting to dynamic scenes by introducing a deformation field that warps Gaussians from a canonical space to the observation space. Our method, which we call 3D Gaussian Splatting for Real-Time Radiance Field Rendering (3DGS), enables high-quality novel view synthesis of dynamic scenes while maintaining real-time rendering capabilities. We demonstrate the effectiveness of our approach on a variety of dynamic scenes, including human performances and rigid object motions, achieving state-of-the-art results compared to previous methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
