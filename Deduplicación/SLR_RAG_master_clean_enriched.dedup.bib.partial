 title = {Ctrla: {Adaptive}},
 url = {https://ui.adsabs.harvard.edu/abs/2024arXiv240518727L/abstract},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:44:35Z},
 year = {2024}
}

@inproceedings{liu_detecting_2025,
 abstract = {Recommender systems (RSs) are widely used in various online platforms to provide personalized recommendations to users. However, recent studies have shown that these systems can exhibit biases, leading to unfair recommendations for certain groups of users. In this paper, we provide a comprehensive survey on fairness in personalized recommendations. We first introduce the background and motivation for fairness in recommender systems. Then, we categorize the existing fairness-aware recommendation methods into three main groups: group fairness, individual fairness, and counterfactual fairness. For each category, we discuss the corresponding fairness notions, evaluation metrics, and state-of-the-art methods. We also highlight the challenges and future directions in this field. Finally, we discuss the open problems and future research directions in fairness-aware recommender systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
