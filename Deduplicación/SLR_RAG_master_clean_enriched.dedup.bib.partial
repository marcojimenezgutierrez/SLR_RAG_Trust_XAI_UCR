 x_enrich_ts = {2025-11-02T06:33:54Z},
 year = {2025}
}

@article{ngom_mallet_2024,
 abstract = {Interactive data visualization tools empower users to explore and analyze data through direct manipulation of visual representations. However, creating effective visualizations often requires programming expertise, limiting accessibility. Visual programming languages (VPLs) offer a promising alternative by allowing users to construct visualizations through graphical interfaces. Despite their potential, designing VPLs for data visualization remains underexplored. In this paper, we investigate the design space of VPLs for interactive data visualization. We first review existing VPLs and identify key design dimensions, including representation, composition, and interaction. We then present a novel VPL prototype that embodies these dimensions, enabling users to build visualizations using modular blocks. Through a user study with 12 participants, we evaluate our prototype's usability and expressiveness compared to a text-based tool. Our findings reveal that while VPLs reduce cognitive load for novices, they may introduce overhead for complex tasks. We discuss implications for future VPL design, emphasizing the need for hybrid approaches that blend visual and textual elements.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
