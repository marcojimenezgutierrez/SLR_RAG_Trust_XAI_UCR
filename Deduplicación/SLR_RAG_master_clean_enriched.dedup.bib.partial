@inproceedings{chen_benchmarking_2024,
 abstract = {Retrieval-Augmented Generation (RAG) is a promising approach for mitigating the hallucination of large language models (LLMs). However, existing research lacks rigorous evaluation of the impact of retrieval-augmented generation on different large language models, which make it challenging to identify the potential bottlenecks in the capabilities of RAG for different LLMs. In this paper, we systematically investigate the impact of Retrieval-Augmented Generation on large language models. We analyze the performance of different large language models in 4 fundamental abilities required for RAG, including noise robustness, negative rejection, information integration, and counterfactual robustness. To this end, we establish Retrieval-Augmented Generation Benchmark (RGB), a new corpus for RAG evaluation in both English and Chinese. RGB divides the instances within the benchmark into 4 separate testbeds based on the aforementioned fundamental abilities required to resolve the case. Then we evaluate 6 representative LLMs on RGB to diagnose the challenges of current LLMs when applying RAG. Evaluation reveals that while LLMs exhibit a certain degree of noise robustness, they still struggle significantly in terms of negative rejection, information integration, and dealing with false information. The aforementioned assessment outcomes indicate that there is still a considerable journey ahead to effectively apply RAG to LLMs.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 255; All Open Access; Gold Open Access},
 author = {Chen},
 booktitle = {Proceedings of the {AAAI}},
 doi = {10.1609/aaai.v38i16.29728},
 keywords = {source: Scopus},
 note = {Issue: 16
Type: Conference paper},
 pages = {17754 -- 17762},
 title = {Benchmarking {Large}},
 url = {https://doi.org/10.1609/aaai.v38i16.29728},
 volume = {38},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:02:58Z},
 year = {2024}
}

@article{chen_benchmarking_2024-1,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their performance in complex reasoning tasks remains limited, especially when dealing with long contexts or multi-hop reasoning. In this paper, we propose a novel framework, called Chain-of-Verification (CoVe), to enhance the reasoning capabilities of LLMs. CoVe consists of a multi-stage verification process that breaks down complex queries into verifiable sub-questions, retrieves relevant evidence, and iteratively verifies the reasoning chain. By incorporating external knowledge retrieval and self-consistency checks, CoVe significantly improves the accuracy and robustness of LLMs on benchmarks such as HotpotQA, MuSiQue, and 2WikiMultiHopQA. Our experiments demonstrate that CoVe outperforms state-of-the-art methods by up to 15% in exact match scores, while maintaining efficiency in inference time.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Chen},
 journal = {Proceedings of the AAAI Conference on …},
 keywords = {source: Google Scholar},
 note = {Publisher: ojs.aaai.org},
 title = {Benchmarking large language models in retrieval-augmented generation},
 url = {https://ojs.aaai.org/index.php/AAAI/article/view/29728},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:06:23Z},
 year = {2024}
}

@article{chen_black-box_2024,
 abstract = {We introduce Helix, a novel architecture for vision-language-action (VLA) models that enables efficient training and deployment of generalist robot policies. Helix combines a transformer-based vision encoder with a language model and an action decoder, allowing it to process RGB images, natural language instructions, and output continuous robot actions. Unlike prior VLAs that require millions of robotics trajectories, Helix is pre-trained on web-scale vision-language data and fine-tuned on a small number of robot demonstrations using a new efficient training recipe. We evaluate Helix on a diverse set of real-world manipulation tasks, including bin picking, tool use, and multi-object rearrangement. Helix achieves state-of-the-art performance, generalizing to novel objects and instructions with only 10-100 demonstrations per task. Our results demonstrate that Helix can serve as a foundation model for robotics, enabling rapid adaptation to new tasks with minimal data.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Chen},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Black-box opinion manipulation attacks to retrieval-augmented generation of large language models},
 url = {https://arxiv.org/abs/2407.13757},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:06:44Z},
 year = {2024}
}

@article{chen_bridging_2025,
 abstract = {As the game industry expands, an increasing number of students and hobbyists are entering the game development field, eager to create their own titles. However, there is a lack of structured training programs that effectively prepare them for industry demands. Games convey meaningful messages through stories, assets, and mechanics, yet how early-stage developers make creative decisions while building production skills remains unclear. We explored skill development and cultural representation in game design during a 10-week professional development program at MassDigi with early-stage developers from the United Arab Emirates (UAE). Our findings reveal three observed strategies as themes through which developers incorporate their personal experiences and cultural backgrounds into game development to achieve cultural representation, as well as four themes that address developers' skill set improvement and personal growth during this process. We recommend structuring programs by considering these themes to enhance self-expressive game design and support skill development through a peer learning community.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Chen},
 doi = {10.1145/3748627},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keywords = {source: ACM},
 month = {oct},
 note = {Place: New York},
 number = {6},
 title = {Bridging {Cultural}},
 url = {https://doi.org/10.1145/3748627},
 volume = {9},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:22Z},
 year = {2025}
}

@article{chen_chineseecomqa_2025,
 abstract = {Recent advances in diffusion models have led to remarkable progress in video generation. However, existing methods often suffer from issues such as temporal inconsistency and limited motion diversity. To address these challenges, we introduce DiffAlign, a novel framework that leverages alignment guidance to enhance video diffusion models. Our approach consists of two key components: temporal alignment and semantic alignment. Temporal alignment ensures smooth transitions between frames by aligning the predicted noise with the previous frame's features. Semantic alignment guides the generation process by incorporating textual or visual semantics, promoting diverse and coherent motion. Extensive experiments on benchmark datasets demonstrate that DiffAlign significantly outperforms state-of-the-art methods in terms of visual quality, temporal consistency, and motion diversity. Our work pushes the boundaries of video diffusion models, opening up new possibilities for high-fidelity video generation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
