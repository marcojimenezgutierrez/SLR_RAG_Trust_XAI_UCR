 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:02:06Z},
 year = {2024}
}

@article{patel_graph-enhanced_2025,
 abstract = {While large language models (LLMs) have shown remarkable generalization capabilities, their performance in robotics remains limited, particularly in generalist policies that can handle diverse tasks across varied environments. This paper investigates the key factors influencing the development of generalist robot policies, focusing on data diversity, model architecture, and training paradigms. We conduct extensive experiments using a suite of robotic manipulation tasks, including object picking, stacking, and tool use, across simulated and real-world settings. Our findings reveal that incorporating multimodal data (vision, proprioception, and language instructions) significantly enhances policy robustness, with a 25% improvement in cross-task transfer. Furthermore, we explore the role of hierarchical architectures and reinforcement learning fine-tuning, demonstrating that hybrid approaches outperform purely supervised methods. These insights provide a roadmap for advancing generalist robotics, emphasizing the need for scalable, diverse datasets and adaptive learning strategies to bridge the gap between simulation and reality.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
