 year = {2025}
}

@inproceedings{guo_multimodal_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their outputs can be inconsistent and sensitive to various factors, including time. In this paper, we investigate the temporal dynamics of LLM outputs by analyzing how the same prompt yields different responses over time. We conduct a longitudinal study using multiple LLMs, prompting them repeatedly over several months, and measure variations in response quality, coherence, and factual accuracy. Our findings reveal significant temporal patterns: outputs degrade in quality during model updates or high-load periods, and exhibit diurnal cycles influenced by server-side optimizations. We propose a framework for temporal-aware prompting and evaluation, including techniques to mitigate time-induced variability, such as prompt stabilization and output caching. This work highlights the need for robust evaluation protocols that account for temporal factors in LLM research and deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Guo},
 booktitle = {Proceedings of the 27th {International}},
 doi = {10.1145/3716553.3750787},
 isbn = {979-8-4007-1499-3},
 keywords = {Behavioral Patterns},
 pages = {475--484},
 publisher = {Association for Computing Machinery},
 series = {{ICMI}},
 title = {Multimodal {Behavioral}},
 url = {https://doi.org/10.1145/3716553.3750787},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:57:50Z},
 year = {2025}
}

@article{guo_omnigirl_2025,
 abstract = {The GitHub issue resolution task aims to resolve issues reported in repositories automatically. With advances in large language models (LLMs), this task has gained increasing attention, and several benchmarks are proposed to evaluate the issue resolution ability of LLMs. However, existing benchmarks have three main limitations. First, current benchmarks focus on a single programming language, limiting the evaluation of issues from repositories across different languages. Second, they usually cover a narrow range of domains, which may fail to represent the diversity of real-world issues. Third, existing benchmarks rely solely on textual information in issue descriptions, overlooking multimodal information such as images in issues. In this paper, we propose OmniGIRL, a GitHub Issue ResoLution benchmark that is multilingual, multimodal, and multi-domain. OmniGIRL includes 959 task instances, which are collected from repositories across four programming languages (i.e., Python, JavaScript, TypeScript, and Java) and eight different domains. Our evaluation shows that current LLMs show limited performances on OmniGIRL. Notably, the best-performing model, GPT-4o, resolves only 8.6% of the issues. Besides, we find that current LLMs struggle to resolve issues requiring understanding images. The best performance is achieved by Claude-3.5-Sonnet, which resolves only 10.5% of the issues with image information. Finally, we analyze the reasons behind current LLMs’ failure on OmniGIRL, providing insights for future improvements.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Guo},
 doi = {10.1145/3728871},
 journal = {Proc. ACM Softw. Eng.},
 keywords = {Benchmark},
 month = {jun},
 note = {Place: New York},
 number = {ISSTA},
 title = {{OmniGIRL}},
 url = {https://doi.org/10.1145/3728871},
 volume = {2},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:28Z},
 year = {2025}
}

@inproceedings{guo_optimizing_2025,
 abstract = {Interactive data visualization tools have become essential for exploring and communicating insights from complex datasets. However, creating custom visualizations often requires programming expertise, limiting accessibility for non-experts. We investigate the potential of visual programming languages (VPLs) to democratize interactive data visualization creation. Through a design study with 12 visualization designers, we explore how VPLs can support the iterative design process of interactive visualizations. Participants used a prototype VPL to recreate and extend existing visualizations, revealing opportunities and challenges in visual programming for this domain. Our findings highlight the need for VPLs that balance expressiveness with simplicity, support modular composition, and integrate seamlessly with data processing pipelines. We contribute design guidelines for VPLs in interactive visualization and discuss implications for tool development to empower diverse users in creating tailored visualizations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Guo},
 booktitle = {Proceedings of the 31st {ACM}},
 doi = {10.1145/3711896.3737254},
