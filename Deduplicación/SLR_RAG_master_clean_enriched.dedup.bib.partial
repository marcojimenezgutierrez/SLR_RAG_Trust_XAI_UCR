@inproceedings{jacobs_leveraging_2024,
 abstract = {Software engineering education faces significant challenges in preparing students for the complexities of modern software development practices. This paper presents a systematic literature review on the integration of large language models (LLMs) into software engineering education. We analyzed 42 primary studies published between 2017 and 2023 to identify opportunities, challenges, and best practices. Our findings reveal that LLMs are primarily used for code generation, automated assessment, and personalized tutoring in software engineering courses. However, concerns regarding ethical implications, accuracy, and over-reliance persist. We propose a framework for educators to effectively incorporate LLMs while mitigating risks, aiming to enhance learning outcomes and align education with industry needs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 7},
 author = {Jacobs},
 booktitle = {Software {Engineering}},
 doi = {10.1109/CSEET62301.2024.10663001},
 keywords = {source: Scopus},
