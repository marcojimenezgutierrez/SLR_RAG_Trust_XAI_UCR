 pages = {29--42},
 publisher = {Association for Computing Machinery},
 series = {{SLE}},
 title = {Towards an {In}},
 url = {https://doi.org/10.1145/3687997.3695650},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:02:56Z},
