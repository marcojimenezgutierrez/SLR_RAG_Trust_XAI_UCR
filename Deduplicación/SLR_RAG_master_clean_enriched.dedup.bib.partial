@inproceedings{ahmed_quality_2025,
 abstract = {This paper proposes a novel approach for detecting and mitigating adversarial attacks on deep learning models in autonomous driving systems. We focus on vision-based perception modules, which are critical for safe navigation. By integrating uncertainty estimation with ensemble methods, our framework enhances robustness against imperceptible perturbations. Experimental results on benchmark datasets demonstrate a significant reduction in attack success rates while maintaining real-time performance.},
