@inproceedings{xu_search---chain_2024,
 abstract = {Social media platforms have become a primary source of news for many users, but the spread of misinformation poses significant challenges. While prior work has explored how users perceive and respond to misinformation, less is known about how users seek information to verify potentially false news stories. In this paper, we investigate how users leverage web search during the online information seeking process when encountering questionable news. Through a mixed-methods approach, including a crowdsourced behavioral study (N=1,200) and in-depth interviews (N=20), we characterize users' verification behaviors and the factors influencing their search strategies. Our findings reveal that users often engage in limited verification, relying on heuristics like source reputation and emotional resonance rather than systematic fact-checking. We identify key barriers to effective verification, such as information overload and confirmation bias, and discuss design implications for improving search tools to support better news verification on social media.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 20; All Open Access; Gold Open Access},
