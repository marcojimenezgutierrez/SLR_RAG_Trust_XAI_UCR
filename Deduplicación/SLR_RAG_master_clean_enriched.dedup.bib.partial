@inproceedings{wang_exploring_2025,
 abstract = {Deep generative models (DGMs) such as Stable Diffusion and DALL-E have recently become widely accessible, enabling anyone to create high-quality images from text prompts. While prior work has explored the technical capabilities of DGMs, less is known about how people use them in everyday life. In this paper, we investigate the social roles of DGMs through a mixed-methods study of 30 participants who regularly use these tools. We find that participants use DGMs to create images for personal expression, social connection, and professional work, often integrating them into existing social practices. However, participants also face challenges related to authenticity, ethics, and the blurring of human and AI-generated content. Our findings highlight the need for design interventions that support positive social uses of DGMs while mitigating potential harms.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wang},
