@inproceedings{yamane_chimera-vdb_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their application in creative writing assistance remains underexplored. We investigate how LLMs can support novice writers in crafting short stories by providing real-time feedback on narrative elements such as plot, character development, and emotional arcs. Through a user study with 24 participants, we evaluate the effectiveness of our LLM-based writing assistant, StoryWeaver, compared to traditional writing tools. Results indicate that StoryWeaver significantly improves story coherence and user satisfaction, while reducing writer's block. We discuss design implications for integrating LLMs into creative workflows and address ethical considerations around authorship and originality.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
