@inproceedings{zubkova_sugar_2025,
 abstract = {This paper proposes a novel approach to blind source separation in reverberant environments using a transformer-based neural network architecture. Traditional methods often struggle with long-range dependencies and overlapping echoes, leading to suboptimal performance in real-world acoustic scenarios. Our model, Reverberant Transformer Separator (RTSep), leverages self-attention mechanisms to capture temporal and spatial correlations across mixed signals. We incorporate a multi-head attention module tailored for audio spectrograms, enabling efficient handling of variable reverberation times. Experimental results on benchmark datasets such as WSJ0-mix and simulated RIRs demonstrate that RTSep outperforms state-of-the-art baselines by up to 15% in SI-SDR, with reduced computational overhead. The method is particularly effective for applications in teleconferencing and hearing aids, where robustness to environmental noise is crucial.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Zubkova},
 booktitle = {{ICASSP}},
 doi = {10.1109/ICASSP49660.2025.10890064},
