 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:33:57Z},
 year = {2024}
}

@inproceedings{grimm_conversational_2024,
 abstract = {Multi-modal Large Language Models (MLLMs) have shown remarkable progress in understanding images and text. However, their capability in video understanding remains underexplored. In this paper, we present Video-ChatGPT, a multi-modal framework that combines a multi-modal LLM with a video captioning model to enable MLLMs to understand video content. Specifically, we utilize a multi-modal LLM to generate a series of questions about the video and then leverage a video captioning model to provide corresponding answers. These question-answer pairs serve as a textual description of the video, which is then fed into the MLLM for further processing. To enhance the video understanding capability of MLLMs, we construct a video instruction-following dataset, Video-ChatGPT-Bench, which contains diverse videos and corresponding instructions. Experimental results demonstrate that our framework significantly improves the performance of MLLMs in video understanding tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Grimm},
 booktitle = {Proceedings of the 7th {Workshop}},
