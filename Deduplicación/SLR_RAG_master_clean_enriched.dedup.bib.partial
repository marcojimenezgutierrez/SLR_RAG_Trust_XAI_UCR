@inproceedings{pan_raglog_2024,
 abstract = {This paper proposes a novel federated learning framework for privacy-preserving anomaly detection in industrial IoT networks. Traditional centralized approaches are vulnerable to data breaches and single points of failure, while federated learning enables collaborative model training without sharing raw data. We design a lightweight aggregation protocol using secure multi-party computation to mitigate poisoning attacks and ensure model robustness. Extensive simulations on real-world datasets demonstrate that our framework achieves 95% detection accuracy with 30% reduced communication overhead compared to state-of-the-art methods.},
