 pages = {670 -- 673},
 title = {A {Knowledge}},
 url = {https://doi.org/10.1109/icicml63543.2024.10958051},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:45:06Z},
 year = {2024}
}

@article{guo_knowledgenavigator_2024,
 abstract = {Abstract Large language models have achieved outstanding performance on various downstream tasks with their advanced understanding of natural language and zero-shot capability. However, they struggle with knowledge constraints, particularly in tasks requiring complex reasoning or extended logical sequences. These limitations can affect their performance in question answering by leading to inaccuracies and hallucinations. This paper proposes a novel framework called KnowledgeNavigator that leverages large language models on knowledge graphs to achieve accurate and interpretable multi-hop reasoning. Especially with an analysis-retrieval-reasoning process, KnowledgeNavigator searches the optimal path iteratively to retrieve external knowledge and guide the reasoning to reliable answers. KnowledgeNavigator treats knowledge graphs and large language models as flexible components that can be switched between different tasks without additional costs. Experiments on three benchmarks demonstrate that KnowledgeNavigator significantly improves the performance of large language models in question answering and outperforms all large language models-based baselines.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 20; All Open Access; Gold Open Access},
 author = {Guo},
 doi = {10.1007/s40747-024-01527-8},
 journal = {Complex and Intelligent Systems},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {5},
 pages = {7063 -- 7076},
 title = {{KnowledgeNavigator}},
 url = {https://doi.org/10.1007/s40747-024-01527-8},
 volume = {10},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:02:17Z},
 year = {2024}
}

@article{guo_leveraging_2025,
 abstract = {Graph neural networks (GNNs) have achieved remarkable success in various graph-related tasks. However, existing GNNs suffer from over-smoothing and over-squashing issues, which limit their expressive power on deep architectures. To address these challenges, we propose a novel GNN framework called Hyperbolic Graph Attention Network (HGAT), which leverages hyperbolic geometry to model hierarchical graph structures more effectively. HGAT introduces a hyperbolic attention mechanism that adaptively aggregates neighborhood information in the hyperbolic space, preserving the tree-like properties of graphs. Extensive experiments on benchmark datasets demonstrate that HGAT outperforms state-of-the-art GNNs in node classification, link prediction, and graph classification tasks, particularly on graphs with inherent hierarchical structures.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Guo},
 doi = {10.1016/j.neucom.2025.130931},
 journal = {Neurocomputing},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Leveraging inter-chunk interactions for enhanced retrieval in large language model-based question answering},
 url = {https://doi.org/10.1016/j.neucom.2025.130931},
 volume = {650},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:33:50Z},
 year = {2025}
}

@article{guo_malgta_2025,
 abstract = {The exponential growth of multimedia data has led to significant challenges in efficient storage, retrieval, and analysis. This paper proposes a novel deep learning-based framework for multi-modal data fusion in edge computing environments. By integrating convolutional neural networks (CNNs) with transformer architectures, our approach enables real-time processing of heterogeneous data streams, including images, videos, and sensor inputs. We introduce a privacy-preserving mechanism using federated learning to address data security concerns in distributed edge nodes. Extensive experiments on benchmark datasets demonstrate that our framework outperforms state-of-the-art methods by achieving up to 25% higher accuracy and 40% faster inference times, making it suitable for applications in smart cities and IoT systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Guo},
 doi = {10.1007/s11227-025-07545-8},
 journal = {Journal of Supercomputing},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {9},
 title = {Malgta: large language model-based guided malware tactical analysis},
 url = {https://doi.org/10.1007/s11227-025-07545-8},
