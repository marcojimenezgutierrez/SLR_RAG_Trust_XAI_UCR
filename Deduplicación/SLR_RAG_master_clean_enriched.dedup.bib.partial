@article{jho_leveraging_2024,
 abstract = {The rapid advancement of generative artificial intelligence (AI), particularly large language models (LLMs), has revolutionized various educational domains, including physics education. These models offer innovative tools for personalized learning, interactive problem-solving, and conceptual visualization. However, a critical challenge is the phenomenon of "hallucinations," where LLMs generate plausible but factually incorrect information, which can mislead learners and undermine educational integrity. This paper explores the integration of generative AI in physics education while addressing hallucination issues through a multi-faceted approach. We propose a framework that incorporates prompt engineering techniques, external knowledge verification, and hybrid human-AI collaboration to enhance reliability. Case studies in classical mechanics and quantum physics illustrate the framework's application, demonstrating improved accuracy and student engagement. Our findings suggest that with careful implementation, generative AI can transform physics pedagogy, fostering deeper understanding while minimizing risks associated with model limitations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Jho},
 journal = {New Phys},
