@article{_rag_2023,
 abstract = {이 연구는 한국의 청소년을 대상으로 한 스마트폰 과의존의 심리적·사회적 요인을 분석하고, 이를 예방하기 위한 교육 프로그램의 효과성을 검증하는 것을 목적으로 한다. 설문조사와 심층면담을 통해 500명의 청소년을 대상으로 데이터를 수집하였으며, 결과적으로 가족 관계, 학업 스트레스, 또래 영향이 스마트폰 과의존의 주요 요인으로 나타났다. 개발된 교육 프로그램은 인지행동치료 기법을 기반으로 하며, 실험군과 통제군을 비교한 결과, 프로그램 참여 후 과의존 수준이 유의미하게 감소하였다. 본 연구는 청소년 스마트폰 과의존 예방을 위한 실천적 방안을 제시한다.},
 abstract_lang = {ko},
