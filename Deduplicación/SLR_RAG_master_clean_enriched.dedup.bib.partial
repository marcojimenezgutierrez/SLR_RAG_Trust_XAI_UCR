 series = {{WWW}},
 title = {{SymAgent}},
 url = {https://doi.org/10.1145/3696410.3714768},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:55:52Z},
 year = {2025}
}

@inproceedings{liu_t-rap_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their outputs are often non-deterministic and require careful evaluation. Existing tools for LLM development focus on either prompt engineering or output analysis, but lack integrated support for iterative experimentation. We present ChainForge, a visual toolkit for building, running, and evaluating LLM pipelines. ChainForge enables users to create complex workflows using a node-based interface, where nodes represent prompts, model calls, data processing steps, and evaluation metrics. Users can execute pipelines on datasets, visualize results in interactive grids, and refine components through direct interaction with examples. The tool supports branching, versioning, and comparative analysis across models and configurations. We describe ChainForge's design, implementation, and a study with 12 participants who used it to prototype LLM applications. Results indicate that ChainForge accelerates development cycles, improves understanding of pipeline behavior, and facilitates hypothesis testing for LLM research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Liu},
 booktitle = {Proceedings of the 15th {Asia}},
 doi = {10.1145/3671016.3672506},
