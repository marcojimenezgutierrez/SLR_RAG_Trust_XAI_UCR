 isbn = {979-8-4007-1592-1},
 keywords = {evaluation},
 note = {event-place: Padua},
 pages = {4199--4201},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {The {LiveRAG}},
 url = {https://doi.org/10.1145/3726302.3733591},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:06:18Z},
 year = {2025}
}

@inproceedings{carvalho_towards_2025,
 abstract = {The adoption of large language models (LLMs) has facilitated significant advancements in natural language processing. In a short space of time, LLMs have permeated a wide array of disciplines including healthcare, finance, education, etc. However, in their native form, LLMs retain information in their parameters, which sometimes causes the underlying models to produce inaccurate results or hallucinations. To that end, Retrieval-Augmented Generation (RAG) has been proposed to address some of the challenges of LLMs by referencing an external knowledge base while formulating a response to queries. Still, traditional RAG fails to handle the complex structure of relationships among different entities in structured data such as knowledge graphs. GraphRAG, a successor of basic RAG, leverages structural information contained in graphs to enable more precise and comprehensive retrieval thereby facilitating more accurate, context-aware responses. GraphRAG has been applied in many domains, but its use in a cybersecurity context has not been widely explored. In this research, we propose a framework that applies GraphRAG to network security monitoring. By generating knowledge graphs from network logs, we provide LLMs with more structured data, backed by an ontology, that enables the models to perform high-level reasoning to answer questions regarding the security posture of an organization more accurately.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Carvalho.},
 booktitle = {Proceedings of the {International}},
 doi = {10.32473/flairs.38.1.138895},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 title = {Towards the {Application}},
 url = {https://doi.org/10.32473/flairs.38.1.138895},
 volume = {38},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:39:37Z},
 year = {2025}
}

@article{cederlund_llmrag_2024,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly impacted various sectors, including healthcare. In particular, AI-driven diagnostic tools have shown promise in enhancing the accuracy and efficiency of medical imaging analysis. This paper presents a novel deep learning framework for the automated detection and classification of skin lesions from dermoscopic images, aiming to assist dermatologists in early melanoma diagnosis. Our approach leverages a hybrid convolutional neural network (CNN) architecture combined with attention mechanisms to capture both local and global features in the images. The model was trained and evaluated on the ISIC 2019 dataset, achieving an area under the curve (AUC) of 0.92 for binary classification (benign vs. malignant) and a mean average precision (mAP) of 0.85 across eight lesion classes. Comparative analysis with state-of-the-art methods demonstrates superior performance, particularly in handling class imbalance and noisy data. Furthermore, we explore the interpretability of the model using gradient-weighted class activation mapping (Grad-CAM), providing visual explanations that align with clinical interpretations. This work underscores the potential of AI in reducing diagnostic errors and expediting triage in resource-limited settings, while highlighting challenges such as data privacy and model generalizability for future research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Cederlund},
 journal = {2024 9th International …},
 keywords = {source: Google Scholar},
