 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:22:21Z},
 year = {2024}
}

@article{soularidis_llm-assisted_2024,
 abstract = {Abstract—Large Language Models (LLMs) have shown remarkable capabilities in generating human-like text, but their application in specialized domains like legal reasoning remains underexplored. This paper introduces LegalChain, a novel framework that leverages LLMs to enhance legal document analysis and chain-of-thought reasoning for contract review tasks. By integrating domain-specific prompting strategies and fine-tuned legal knowledge injection, LegalChain achieves superior performance in identifying clauses, assessing risks, and generating compliance recommendations. Experimental results on benchmark datasets demonstrate that our approach outperforms traditional rule-based systems and general-purpose LLMs, with improvements in accuracy by up to 25%. We discuss implications for automating legal workflows and ethical considerations in AI-assisted jurisprudence.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
