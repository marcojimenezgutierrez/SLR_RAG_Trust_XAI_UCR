@inproceedings{fuchs_lissa_2025,
 abstract = {Software engineering research has increasingly focused on improving the reliability of machine learning (ML) systems, yet little is known about the bugs that commonly occur in these systems. In this paper, we conduct an empirical study to characterize the bugs in 12 popular open-source ML libraries. We manually analyze 1,200 bug-fixing commits and classify the bugs into 8 categories based on their root causes and impacts. Our findings reveal that configuration errors and data-related issues account for over 60% of the bugs, while algorithmic defects are less frequent but more severe. We also identify patterns in bug lifecycles and discuss implications for developing robust ML tools. This work provides a foundational understanding to guide future research in ML reliability.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {Ottawa},
