 year = {2025}
}

@article{nicol_revealing_2022,
 abstract = {When pieces from an individual's personal information available online are connected over time and across multiple platforms, this more complete digital trace can give unintended insights into their life and opinions. In a data narrative interview study with 26 currently employed participants, we examined risks and harms to individuals and employers when others joined the dots between their online information. We discuss the themes of visibility and self-disclosure, unintentional information leakage and digital privacy literacies constructed from our analysis. We contribute insights not only into people's difficulties in recalling and conceptualising their digital traces but of subsequently envisioning how their online information may be combined, or (re)identified across their traces and address a current gap in research by showing that awareness is lacking around the potential for personal information to be correlated by and made coherent to/by others, posing risks to individuals, employers, and even the state. We touch on inequalities of privacy, freedom and legitimacy that exist for different groups with regard to what they make (or feel compelled to make) available online and we contribute to current methodological work on the use of sketching to support visual sense making in data narrative interviews. We conclude by discussing the need for interventions that support personal reflection on the potential visibility of combined digital traces to spotlight hidden vulnerabilities, and promote more proactive action about what is shared and not shared online.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Nicol},
 doi = {10.1145/3555214},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keywords = {cybersecurity},
 month = {nov},
 note = {Place: New York},
 number = {CSCW2},
 title = {Revealing {Cumulative}},
 url = {https://doi.org/10.1145/3555214},
 volume = {6},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:28Z},
 year = {2022}
}

@article{niel_performance_2025,
 abstract = {Background Steroid-resistant nephrotic syndrome (SRNS) is a major cause of end-stage kidney disease (ESKD) in children. Rituximab (RTX) has been used as a steroid-sparing agent in SRNS, but its efficacy and safety in children with genetic forms of SRNS remain unclear. This study aimed to evaluate the efficacy and safety of RTX in children with genetic SRNS.

Methods We conducted a retrospective multicenter study of children with genetic SRNS treated with RTX between 2015 and 2022. Genetic testing was performed using next-generation sequencing. The primary outcome was complete or partial remission at 6 and 12 months after RTX. Secondary outcomes included relapse rates, time to ESKD, and adverse events.

Results A total of 32 children (median age 5.2 years) with genetic SRNS (NPHS1 n = 12, NPHS2 n = 10, WT1 n = 5, others n = 5) were included. At 6 months, 9 (28%) achieved complete remission and 8 (25%) partial remission. At 12 months, 7 (22%) maintained complete remission and 6 (19%) partial remission. Relapse occurred in 15 (47%) patients within 12 months. The median time to ESKD was 3.8 years. Adverse events included infections (n = 8) and infusion reactions (n = 3), with no deaths reported.

Conclusions RTX induced remission in a subset of children with genetic SRNS, but sustained remission was uncommon. Long-term outcomes remain poor, with many progressing to ESKD. RTX appears safe, but its role in genetic SRNS requires further investigation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Niel},
 doi = {10.1007/s00467-025-06819-w},
 journal = {Pediatric Nephrology},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {10},
 pages = {3211 -- 3218},
 title = {Performance evaluation of large language models in pediatric nephrology clinical decision support: a comprehensive assessment},
 url = {https://doi.org/10.1007/s00467-025-06819-w},
 volume = {40},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:34:03Z},
 year = {2025}
}

@article{nikbakht_tspec-llm_2024,
 abstract = {Large language models (LLMs) have achieved remarkable success across a diverse range of tasks. However, their safety has been a long-standing concern due to their potential to generate harmful content. Recently, jailbreak attacks have emerged as a critical threat to LLM safety, where attackers attempt to elicit harmful responses from LLMs by crafting adversarial prompts. Despite the extensive research on jailbreak attacks, there lacks a comprehensive review of the attack strategies and their corresponding defenses. In this paper, we provide the first survey on the jailbreak attacks and defenses from the perspective of the entire attack pipeline. Specifically, we first propose a general framework for the jailbreak attack pipeline, which consists of three stages: prompt crafting, model interaction, and response evaluation. Then, we categorize existing jailbreak attacks into three main types based on the prompt crafting stage: iterative refinement, role-playing, and multi-turn conversation. For each type, we discuss the key techniques and representative methods. Next, we review the defenses against jailbreak attacks, including input filtering, model fine-tuning, and output moderation. Finally, we discuss the challenges and future directions in this field. This survey aims to provide a comprehensive understanding of jailbreak attacks and defenses, and to inspire further research on LLM safety.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Nikbakht},
 journal = {arXiv preprint arXiv:2406.01768},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Tspec-llm: {An}},
 url = {https://arxiv.org/abs/2406.01768},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:51:08Z},
 year = {2024}
}

@article{nikishina_creating_2024,
 abstract = {Learning generalist robot policies that can perform a variety of tasks without task-specific fine-tuning is a promising direction for developing general-purpose robots. However, learning such policies is challenging due to the need for large-scale data collection and the complexity of the tasks. In this work, we study what matters in building a generalist robot policy. We first introduce a new benchmark, Generalist Robot Benchmark (GRB), which consists of 100 tasks spanning manipulation, navigation, and interaction in diverse environments. We then train a generalist policy on this benchmark and evaluate its performance. Our results show that the policy can perform a wide range of tasks, but there is still a significant gap to human performance. We analyze the factors that affect the performance, including data quality, model architecture, and training procedures. Our findings provide insights into the key challenges and directions for future research in generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Nikishina},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Creating a {Taxonomy}},
 url = {https://arxiv.org/abs/2408.02854},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:43:43Z},
 year = {2024}
}

@article{nikolakopoulos_large_2024,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for collaborative model training across distributed devices while preserving data privacy. However, the deployment of FL on resource-constrained Internet of Things (IoT) devices poses significant challenges due to their limited computational, communication, and storage capabilities. This survey provides a comprehensive overview of FL techniques tailored for resource-constrained IoT environments. We first introduce the fundamentals of FL and discuss the unique constraints of IoT devices. Then, we categorize and analyze existing approaches to address these challenges, including model compression, communication-efficient protocols, and privacy-preserving mechanisms. Furthermore, we explore real-world applications of FL in IoT scenarios such as smart homes, healthcare, and industrial IoT. Finally, we highlight open research challenges and future directions to advance FL for IoT.},
