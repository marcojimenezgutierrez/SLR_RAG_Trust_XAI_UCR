 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:25:51Z},
 year = {2024}
}

@article{holvoet_approach_2025,
 abstract = {Abstract Despite ongoing digitization in industry, many companies still work with paper instructions or ‘paper-on-glass’ solutions (e.g., PDF files on screens). In recent years, various digital work instruction (DWI) technologies have become available that provide shop-floor employees with information during their activities, e.g., sequences of instructions for tasks at hand. Engineering new instructions in these systems for new products or product variants is however expensive and time-consuming. To scale up, there is a need for methods to generate work instructions (semi) automatically. Recently, Generative AI models and Large Language Models (LLMs) have taken center stage with their abilities to interact fluently with humans, both in understanding user questions/statements and in convincingly producing natural language texts. These models however suffer from several problems, including hallucinations where unsubstantiated content is presented as facts and lack of domain-specific data about products and procedures. For instruction generation however, we need verifiably correct statements about the task at hand. To tackle both problems, we have created a pipeline that combines the generative abilities of LLMs with explicit domain-specific data. We deploy a variant of Retrieval Augmented Generation (RAG) and incorporate an ontology that augments the instructions with additional information (policies, warnings, tools). Our results show an increase in correctness of output.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 1; All Open Access; Hybrid Gold Open Access},
 author = {Holvoet},
 doi = {10.1007/978-3-031-86489-6_23},
 journal = {Lecture Notes in Mechanical Engineering},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {224 -- 233},
 title = {An {Approach}},
 url = {https://doi.org/10.1007/978-3-031-86489-6_23},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:01:00Z},
 year = {2025}
}

@inproceedings{hong_context-aware_2024,
 a large language model-based pipeline that generates context-aware answers to users when onboarding metaverse. an ablation study (n = {20) reveals that PICAN’s usage of context made responses more useful and immersive than those generated without contexts. Furthermore},
 a user study (n = {21) shows that the use of long-term exploration context promotes users’ learning about the locations and activities within the virtual environment.}},
 abstract = {The rapid advancement of artificial intelligence (AI) has led to the widespread deployment of large language models (LLMs) in various applications. However, these models often exhibit biases that can perpetuate societal inequalities. This paper investigates bias mitigation techniques in LLMs through a comprehensive empirical study. We evaluate debiasing methods including data augmentation, adversarial training, and fine-tuning on diverse datasets. Our results show that while these approaches reduce bias in controlled settings, they may compromise model performance and generalize poorly to real-world scenarios. We propose a hybrid framework combining multiple techniques to balance fairness and utility, and discuss implications for responsible AI development.},
