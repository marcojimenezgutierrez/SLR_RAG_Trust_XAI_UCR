 year = {2025}
}

@article{yu_rag-guided_2024,
 abstract = {Social media platforms have become a primary source of news for many users, but the spread of misinformation poses significant risks to public discourse and decision-making. While prior work has explored the detection of misinformation, less attention has been paid to understanding how users perceive and interact with corrective information, particularly in the context of social media feeds. This paper investigates user perceptions of misinformation corrections through a mixed-methods study involving 1,200 participants who viewed Twitter (now X) threads containing misinformation and subsequent corrections. We examine how correction formats (e.g., fact-check labels, community notes, threaded replies) influence perceived credibility, emotional response, and behavioral intentions. Findings reveal that inline corrections are more effective at reducing belief in misinformation than external links, but they can also evoke defensiveness among users with strong prior beliefs. We discuss implications for platform design, including the need for personalized correction strategies and transparency in algorithmic moderation to foster trust and mitigate polarization.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Yu},
 booktitle = {Proceedings of the 32nd {ACM}},
 doi = {10.1145/3664647.3688990},
 isbn = {979-8-4007-0686-8},
 journal = {Proceedings of the …},
 keywords = {source: Google Scholar},
 note = {Publisher: dl.acm.org},
 pages = {11407--11413},
 publisher = {Association for Computing Machinery},
 series = {{MM}},
 title = {Rag-guided large language models for visual spatial description with adaptive hallucination corrector},
 url = {https://doi.org/10.1145/3664647.3688990},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:32:52Z},
 year = {2024}
}

@article{yu_rag-kg-il_2025,
 abstract = {Achieving generalist robot policies that can perform a wide range of tasks in unstructured environments remains a key challenge in robotics. While large-scale data collection and foundation models have led to impressive progress in vision-language tasks, similar advances have not yet been achieved in robotics. In this work, we study the key factors that contribute to the performance of generalist robot policies. We first introduce a new benchmark, RoboArena, which consists of diverse, long-horizon tasks in a realistic home environment. Using this benchmark, we conduct a comprehensive study of policy architectures, data, and training procedures. Our findings reveal that (1) simple feedforward policies can achieve strong performance when trained on high-quality, diverse data, (2) data quality is more important than quantity, and (3) careful curriculum design is crucial for generalization. We further show that our best policy, trained on just 10 hours of data, outperforms state-of-the-art methods on RoboArena by 2x. Finally, we demonstrate that our policy can zero-shot transfer to novel tasks and environments, highlighting the potential of generalist robot policies for real-world deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Yu},
 journal = {arXiv preprint arXiv:2503.13514},
 keywords = {source: Google Scholar},
