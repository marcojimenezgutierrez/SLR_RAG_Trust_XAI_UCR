 title = {{ExpertRAG}},
 url = {https://arxiv.org/abs/2504.08744},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:16:31Z},
 year = {2025}
}

@inproceedings{gummadi_enhancing_2024,
 abstract = {The rapid growth of electric vehicles (EVs) has led to increased demand for efficient charging infrastructure. This paper proposes a smart charging scheduling algorithm for EV charging stations using reinforcement learning (RL) to optimize energy consumption and reduce grid stress. The algorithm considers factors such as battery state of charge, user preferences, and renewable energy availability. Simulation results demonstrate a 20% reduction in peak load and improved charging efficiency compared to traditional methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
