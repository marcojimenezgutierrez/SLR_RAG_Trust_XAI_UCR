@article{_llm_2023,
 abstract = {With the development of artificial intelligence technology, the importance of large language models (LLMs) is increasing. LLMs have the advantage of being able to generate human-like text, but they also have limitations such as hallucination and lack of domain-specific knowledge. To address these limitations, Retrieval-Augmented Generation (RAG) models have been proposed. RAG models retrieve relevant information from external knowledge bases and use it to generate more accurate and reliable responses. In this paper, we propose an LLM application architecture based on RAG model and LangChain framework. The proposed architecture consists of three main components: data ingestion, retrieval, and generation. The data ingestion component is responsible for loading and processing data from various sources. The retrieval component retrieves relevant information from the knowledge base using vector search. The generation component generates responses using the retrieved information and the LLM. We implemented a generative AI service using the proposed architecture and evaluated its performance. The experimental results show that the proposed architecture can generate more accurate and reliable responses than the baseline LLM.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {{정천수}},
 journal = {지능정보연구},
 keywords = {source: Google Scholar},
 note = {Publisher: researchgate.net
Type: PDF},
 title = {{LLM}},
 url = {https://www.researchgate.net/profile/Cheonsu-Jeong/publication/376893991_Generative_AI_service_implementation_using_LLM_application_architecture_based_on_RAG_model_and_LangChain_framework/links/658e9c136f6e450f19b310b1/Generative-AI-service-implementation-using-LLM-application-architecture-based-on-RAG-model-and-LangChain-framework.pdf},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:27:25Z},
 year = {2023}
}

