@inproceedings{shi_flowxpert_2025,
 abstract = {Recent advances in large language models (LLMs) have shown remarkable capabilities in generating code from natural language descriptions. However, these models often exhibit biases that can lead to unfair or discriminatory outcomes in code generation tasks, particularly when the generated code involves decision-making logic or resource allocation. This paper provides a comprehensive survey of fairness issues in LLM-based code generation, categorizing biases into data-related, model-related, and application-specific types. We discuss evaluation metrics for fairness, mitigation strategies such as debiasing techniques and fairness-aware fine-tuning, and open challenges for future research. By addressing these concerns, we aim to promote equitable and reliable code generation systems that benefit diverse user groups.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Shi},
