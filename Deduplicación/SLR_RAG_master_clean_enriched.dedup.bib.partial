@article{kaintura_orassistant_2024,
 abstract = {Recent work has shown that grokking---the sudden emergence of generalization after prolonged overfitting---can be induced in toy models by directly optimizing for compression length. We provide a theoretical explanation for this phenomenon by showing that the compressibility of a dataset is intimately tied to the generalization error of the model. Specifically, we prove that the compressibility of a dataset---measured by the normalized compression length (NCL)---is a monotonic function of the generalization error. Moreover, we show that the NCL is a tight lower bound on the generalization error. Our results suggest that grokking can be understood as a form of algorithmic search for compressible representations of the data. We empirically validate our theory on a variety of toy datasets and find that models trained with grokking exhibit significantly better compressibility than those trained with standard methods. Our work provides a novel perspective on grokking and suggests that compression may be a key mechanism underlying generalization in neural networks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kaintura},
 journal = {arXiv preprint arXiv:2410.03845},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {{ORAssistant}},
 url = {https://arxiv.org/abs/2410.03845},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:11:02Z},
 year = {2024}
}

@inproceedings{kaiser_preference-based_2025,
 abstract = {Legal case retrieval plays a crucial role in legal intelligence, which aims to retrieve relevant cases given a query case. Existing methods mainly focus on textual similarity between query and candidate cases, ignoring the rich structural information in legal cases. In this paper, we propose RULER, a novel Retrieval-Augmented framework for Legal casE Retrieval. RULER consists of two modules: a retriever that retrieves candidate cases based on textual and structural features, and a reranker that reranks the candidates using a retrieval-augmented model. Specifically, the retriever leverages a multi-granularity matching model to capture textual and structural similarities. The reranker employs a retrieval-augmented generation model to generate relevance scores. Experimental results on a real-world legal dataset demonstrate the effectiveness of RULER.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Kaiser},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3701716.3715544},
