@inproceedings{shaikh_creating_2025,
 abstract = {Visual Question Answering (VQA) has achieved remarkable progress in recent years, thanks to the rapid development of large-scale datasets and powerful pre-trained models. However, the fairness issue in VQA has been largely overlooked by the community. In this paper, we conduct a comprehensive survey on fairness in VQA. We first define the fairness problem in VQA and categorize the existing fairness-aware VQA methods into three groups: fairness-aware datasets, fairness-aware pre-training, and fairness-aware fine-tuning. Then, we summarize the evaluation metrics and discuss the challenges and future directions. This survey aims to provide researchers with a comprehensive understanding of the current state of fairness in VQA and inspire further research in this direction.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
