@inproceedings{lo_noel_2025,
 abstract = {Hearing loss affects over 1.5 billion people worldwide, yet hearing aids remain underutilized due to challenges in usability, personalization, and social stigma. Recent advancements in artificial intelligence (AI) offer opportunities to enhance hearing aids with adaptive, context-aware features that better meet diverse user needs. However, the design of AI-powered hearing aids must prioritize inclusivity to ensure accessibility for varied demographics, including age, culture, and severity of hearing loss. In this paper, we conducted a qualitative study with 20 participants, including hearing aid users and non-users from diverse backgrounds, to explore their needs, pain points, and expectations for AI integration in hearing devices. Through thematic analysis of interviews and co-design sessions, we identified key themes: (1) personalized sound enhancement for dynamic environments, (2) seamless integration with daily life to reduce cognitive load, (3) privacy-preserving AI to build trust, and (4) stigma mitigation through discreet, multifunctional designs. Our findings highlight the importance of user-centered AI development and offer design implications for creating inclusive hearing technologies that empower users and promote equitable access to auditory assistance.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Lo},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713836},
