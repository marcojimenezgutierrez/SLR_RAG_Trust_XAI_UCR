@inproceedings{bose_prompts_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating code, but their performance on complex software engineering tasks remains underexplored. In this paper, we investigate the effectiveness of LLMs in performing code review tasks, a critical aspect of software development that requires understanding context, identifying issues, and suggesting improvements. We design a comprehensive evaluation framework using real-world pull requests from GitHub repositories, focusing on metrics such as issue detection accuracy, suggestion quality, and contextual relevance. Our experiments with state-of-the-art LLMs, including GPT-4 and CodeLlama, reveal that while LLMs can identify simple bugs and style violations effectively, they struggle with subtle logical errors and architecture-level concerns. We further analyze the impact of prompt engineering and fine-tuning on performance, providing insights into how LLMs can be better integrated into CI/CD pipelines for automated code review. Our findings highlight both the potential and limitations of LLMs in enhancing developer productivity.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Bose},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3696630.3728702},
