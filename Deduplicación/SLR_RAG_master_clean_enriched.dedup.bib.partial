 year = {2025}
}

@article{lin_concept-based_2025,
 abstract = {This paper explores the use of pre-trained language models for named entity recognition (NER) in Finnish, a low-resource language with complex morphology. We evaluate several multilingual and monolingual models, including mBERT, XLM-R, and FinBERT, on the standard Finnish NER dataset. Our experiments demonstrate that fine-tuning FinBERT yields the best performance, achieving an F1-score of 92.3%, outperforming multilingual models by up to 5 points. We also investigate the impact of morphological features and data augmentation techniques to further improve results. The findings highlight the importance of language-specific pre-training for morphologically rich languages like Finnish.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
