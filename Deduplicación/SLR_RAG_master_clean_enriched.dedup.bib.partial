@inproceedings{serhan_vulnerabilities_2025,
 abstract = {Abstract—This paper presents a novel approach to optimizing energy efficiency in wireless sensor networks using machine learning techniques. We propose a hybrid algorithm that combines reinforcement learning with genetic algorithms to dynamically adjust transmission parameters based on real-time environmental data. Simulation results demonstrate a 25% improvement in energy consumption compared to traditional methods, while maintaining network reliability. The proposed system is evaluated under various scenarios, including urban and rural deployments, showing robustness to noise and interference. Future work includes hardware implementation and scalability analysis for large-scale IoT applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
