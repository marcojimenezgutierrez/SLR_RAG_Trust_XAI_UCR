 pages = {21--29},
 title = {Toward {Autonomous}},
 url = {https://doi.org/10.1109/mnet.2025.3583298},
 volume = {39},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:20:55Z},
 year = {2025}
}

@inproceedings{liu_towards_2024,
 abstract = {We present EchoState, a novel interactive system that enables users to explore and understand the internal states of large language models (LLMs) through visualizations. Despite their impressive capabilities, LLMs remain opaque black boxes, making it challenging for users to interpret why models generate specific outputs. EchoState addresses this by providing an intuitive interface that visualizes key aspects of the model's attention mechanisms and token embeddings during inference. Through a user study with 24 participants, we evaluate EchoState's effectiveness in helping non-expert users make sense of LLM behaviors. Our results show that EchoState significantly improves users' understanding of model decisions, increases trust in outputs, and aids in identifying potential biases, compared to traditional text-based explanations. We discuss design implications for future tools that democratize access to AI interpretability.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Liu},
 booktitle = {Proceedings of the 30th {ACM}},
 doi = {10.1145/3637528.3671575},
