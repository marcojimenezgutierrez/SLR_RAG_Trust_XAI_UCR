 year = {2025}
}

@inproceedings{yang_aqua_2024,
 abstract = {Data visualizations are powerful tools for communicating complex information, but creating effective visualizations often requires expertise in both data analysis and visual design. Visual programming languages (VPLs) offer a promising approach to democratizing visualization creation by allowing users to build visualizations through direct manipulation of graphical elements. However, the design space of VPLs for interactive data visualization remains underexplored. In this paper, we systematically explore the design space of VPLs for interactive data visualization through a series of design studies and user evaluations. We identify key design dimensions, including representation of data, operations on data, and interaction mechanisms, and propose a taxonomy to guide future VPL development. Our findings reveal trade-offs in usability, expressiveness, and learnability, and highlight opportunities for hybrid approaches that combine visual and textual elements. We contribute a set of design guidelines and a prototype VPL implementation that demonstrates the feasibility of our approach.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
