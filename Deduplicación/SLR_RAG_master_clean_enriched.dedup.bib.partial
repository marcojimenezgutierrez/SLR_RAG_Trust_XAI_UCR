 keywords = {GUI automation},
 publisher = {Association for Computing Machinery},
 series = {{UIST}},
 title = {{Log2Plan}},
 url = {https://doi.org/10.1145/3746059.3747663},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:21:24Z},
 year = {2025}
}

@article{lee_memory-augmented_2025,
 abstract = {A learning management system (LMS) plays a crucial role in supporting students’ educational activities by centralized platforms for course delivery, communication, and student support. Recently, many universities have integrated chatbots into their LMS to assist students with various inquiries and tasks. However, existing chatbots often necessitate human interventions to manually respond to complex queries, resulting in limited scalability and efficiency. In this paper, we present a memory-augmented large language model (LLM) framework that enhances the reasoning and contextual continuity of LMS-based chatbots. The proposed framework first embeds user queries and retrieves semantically relevant entries from various LMS resources, including instructional documents and academic frequently asked questions. Retrieved entries are then filtered through a two-stage confidence filtering process that combines similarity thresholds and LLM-based semantic validation. Validated information, along with user queries, is processed by LLM for response generation. To maintain coherence in multi-turn interactions, the chatbot incorporates short-term, long-term, and temporal event memories, which track conversational flow and personalize responses based on user-specific information, such as recent activity history and individual preferences. To evaluate response quality, we employed a multi-layered evaluation strategy combining BERTScore-based quantitative measurement, an LLM-as-a-Judge approach for automated semantic assessment, and a user study under multi-turn scenarios. The evaluation results consistently confirm that the proposed framework improves the consistency, clarity, and usefulness of the responses. These findings highlight the potential of memory-augmented LLMs for scalable and intelligent learning support within university environments.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Lee},
 doi = {10.3390/app15179775},
 journal = {Applied Sciences (Switzerland)},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {17},
 title = {Memory-{Augmented}},
 url = {https://doi.org/10.3390/app15179775},
 volume = {15},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:34:28Z},
 year = {2025}
}

@inproceedings{lee_mvprompt_2025,
 abstract = {Generative AI has revolutionized content creation, but its application in visual arts poses significant accessibility challenges for visually impaired artists and audiences. This paper investigates the barriers faced by visually impaired users when interacting with generative AI tools for visual art, such as lack of auditory descriptions, non-inclusive interfaces, and insufficient feedback mechanisms. Through a mixed-methods approach involving interviews with 15 visually impaired artists, usability testing of three popular tools (DALL-E, Midjourney, and Stable Diffusion), and co-design workshops, we identify key pain points and propose a framework for accessible generative AI. Our framework includes multimodal output (e.g., audio narrations of generated images), voice-based controls, and collaborative features for sighted allies. Findings reveal that 80% of participants felt excluded from the creative process, highlighting the need for inclusive design in AI systems. We contribute design guidelines and a prototype implementation, AudioCanvas, demonstrating improved accessibility and user satisfaction. This work advances the field of human-AI interaction by emphasizing equity in creative technologies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Lee},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713876},
 isbn = {979-8-4007-1394-1},
 keywords = {AI Artists},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {{MVPrompt}},
 url = {https://doi.org/10.1145/3706598.3713876},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:44:16Z},
 year = {2025}
}

@inproceedings{lee_novel_2025,
 abstract = {This paper proposes a novel framework for enhancing cybersecurity in IoT ecosystems using blockchain technology integrated with machine learning algorithms. The proposed system addresses key challenges such as data privacy, authentication, and real-time threat detection. By leveraging distributed ledger technology, the framework ensures tamper-proof transaction records while employing deep neural networks for anomaly detection. Experimental results demonstrate a 25% improvement in detection accuracy and a 40% reduction in response time compared to traditional methods. The approach is scalable and suitable for deployment in smart city applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
