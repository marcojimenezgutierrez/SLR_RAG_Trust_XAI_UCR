 title = {{LEGOLAS}},
 url = {https://doi.org/10.1145/3706599.3720141},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:40:30Z},
 year = {2025}
}

@inproceedings{ko_rerag_2024,
 abstract = {This paper proposes a novel approach for enhancing the security of Internet of Things (IoT) devices by integrating blockchain technology with machine learning algorithms. The proposed system utilizes a decentralized ledger to ensure data integrity and employs a convolutional neural network (CNN) for anomaly detection in real-time IoT traffic. Experimental evaluations on a simulated IoT network demonstrate that the system achieves a detection accuracy of 98.5%, with reduced latency compared to traditional centralized methods. The results highlight the potential of this hybrid framework in addressing key security challenges in IoT ecosystems.},
