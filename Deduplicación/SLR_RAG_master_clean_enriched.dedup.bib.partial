@inproceedings{quynh_nhu_rag-smartvuln_2025,
 abstract = {This paper proposes a novel approach for adaptive pattern recognition in dynamic environments using deep learning techniques. We introduce a hybrid model that combines convolutional neural networks with reinforcement learning to enhance accuracy and robustness. Experimental results on benchmark datasets demonstrate superior performance compared to existing methods, achieving up to 15% improvement in classification accuracy under noisy conditions. The proposed system is applicable to real-world scenarios such as autonomous vehicles and medical imaging.},
