@inproceedings{barat_constructing_2025,
 abstract = {Memory sharing is a common practice in families, yet little is known about how family members share memories and what challenges they face in doing so. In this paper, we investigate memory sharing practices in families through a qualitative study with 12 families. We find that family members share memories through a variety of modalities, including verbal storytelling, photos, videos, and physical objects. We also identify several challenges in memory sharing, such as forgetting details, differing interpretations of events, and privacy concerns. Based on our findings, we propose design implications for technologies that support memory sharing in families, including features for collaborative memory reconstruction, multimodal memory capture, and privacy-preserving sharing mechanisms.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
