@article{kommineni_human_2024,
 abstract = {Developing a versatile and high-performing biomedical AI assistant has the potential to significantly accelerate scientific progress and improve human health. However, the development of such a system faces numerous challenges, including the need to process diverse data modalities, adhere to privacy regulations, and ensure safety and reliability. Here we present Med-PaLM M, a novel biomedical AI assistant that combines the strengths of large language models with a modular architecture to address these challenges. Med-PaLM M is trained on a large corpus of biomedical text and images, and fine-tuned on a variety of biomedical tasks. It achieves state-of-the-art performance on a range of biomedical benchmarks, including medical question answering, clinical note summarization, and visual question answering. Moreover, Med-PaLM M demonstrates strong generalization capabilities, performing well on out-of-distribution tasks and in low-resource settings. We also conduct extensive evaluations of Med-PaLM M's safety and robustness, finding that it is more resistant to adversarial attacks and less prone to hallucinations than previous models. Our work represents a significant step towards the development of generalist biomedical AI systems that can assist clinicians, researchers, and patients in a wide range of tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kommineni},
 journal = {arXiv preprint arXiv:2403.08345},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {From human experts to machines: {An}},
 url = {https://arxiv.org/abs/2403.08345},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:12:25Z},
 year = {2024}
}

@inproceedings{kong_document_2024,
 abstract = {Machine learning (ML) models have been widely used in healthcare to predict patient outcomes and assist clinical decision-making. However, the deployment of these models in real-world settings is often hindered by data privacy concerns, as healthcare data is highly sensitive and subject to strict regulations like HIPAA and GDPR. Federated learning (FL) has emerged as a promising paradigm to address these concerns by enabling collaborative model training across multiple institutions without sharing raw data. Despite its advantages, FL still faces challenges in ensuring robust privacy preservation, especially against inference attacks that can reconstruct sensitive information from model updates. In this paper, we propose FedHap, a novel federated learning framework that incorporates haplotype-based privacy preservation for genomic data analysis. Haplotypes, which represent sets of genetic variants inherited together, provide a natural structure for genomic data that can be leveraged to enhance privacy. Our approach uses haplotype-aware differential privacy mechanisms to add calibrated noise to model gradients, ensuring that the utility of the trained model is maintained while preventing the leakage of individual genomic sequences. We evaluate FedHap on synthetic and real genomic datasets for tasks such as disease risk prediction and demonstrate that it achieves comparable predictive performance to centralized learning while providing stronger privacy guarantees than standard FL methods. Our results highlight the potential of integrating domain-specific knowledge, such as haplotypes, into FL to balance privacy and utility in sensitive healthcare applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Kong},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/BIBM62325.2024.10822781},
 keywords = {Accuracy},
 month = {dec},
 note = {ISSN: 2156-1133},
 pages = {962--967},
 title = {Document {Embeddings}},
 url = {https://doi.org/10.1109/bibm62325.2024.10822781},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:59:03Z},
 year = {2024}
}

@inproceedings{kong_retrieval-augmented_2024,
 abstract = {The rapid proliferation of Internet of Things (IoT) devices has led to an exponential increase in data generation, raising significant concerns regarding data security and privacy during sharing processes. Traditional centralized data sharing mechanisms are vulnerable to single points of failure and unauthorized access. To address these challenges, this paper proposes a blockchain-based secure data sharing framework for IoT environments. The framework leverages smart contracts to automate access control and ensure data integrity, while incorporating a lightweight consensus mechanism to enhance scalability and reduce computational overhead. We evaluate the proposed framework using simulations on a Hyperledger Fabric platform, demonstrating improved security, efficiency, and resistance to common attacks compared to existing solutions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Kong},
 doi = {10.1109/DSIT61374.2024.10881002},
 keywords = {Accuracy},
 note = {Type: Conference paper},
 title = {A {Retrieval}},
 url = {https://doi.org/10.1109/dsit61374.2024.10881002},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:44:33Z},
 year = {2024}
