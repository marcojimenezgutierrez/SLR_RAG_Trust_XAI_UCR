}

@article{chen_llms_2024,
 abstract = {The increasing complexity of robot learning tasks has led to a growing demand for generalist robot policies that can perform a wide range of manipulation tasks in diverse environments. However, current approaches often rely on task-specific training, limiting their generalization. In this work, we investigate key factors for building effective generalist policies, including data diversity, model architecture, and training objectives. We conduct extensive experiments using a large-scale dataset of robotic interactions and evaluate policies on unseen tasks. Our findings reveal that incorporating multi-task learning with hierarchical architectures significantly improves zero-shot transfer, while careful data curation enhances robustness to environmental variations. These insights provide a foundation for developing versatile robot agents capable of adapting to real-world scenarios.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Chen},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Llms are biased evaluators but not biased for retrieval augmented generation},
 url = {https://arxiv.org/abs/2410.20833},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:16:26Z},
 year = {2024}
}

@article{chen_meet2mitigate_2025,
 abstract = {Soil organic carbon (SOC) mineralization is a critical process regulating soil carbon cycling and atmospheric CO2 concentrations. However, the microbial mechanisms driving SOC mineralization remain unclear, particularly the roles of microbial carbon use efficiency (CUE) and extracellular enzyme activity (EEA). Here, we conducted a meta-analysis of 156 studies to quantify the relationships between SOC mineralization and microbial properties. Our results showed that SOC mineralization was positively correlated with microbial biomass carbon (MBC) and EEA, but negatively correlated with CUE. Specifically, a 1% increase in MBC and EEA enhanced SOC mineralization by 0.12% and 0.08%, respectively, while a 1% increase in CUE reduced it by 0.15%. These patterns were consistent across different ecosystems, SOC levels, and experimental durations. Structural equation modeling revealed that CUE and EEA indirectly influenced SOC mineralization primarily through MBC, with CUE exerting the strongest negative effect. Our findings highlight that microbial CUE and EEA are key drivers of SOC mineralization, providing insights into microbial regulation of soil carbon cycling.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Chen},
 journal = {Advanced Engineering …},
 keywords = {source: Google Scholar},
 note = {Publisher: Elsevier},
 title = {{Meet2Mitigate}},
 url = {https://www.sciencedirect.com/science/article/pii/S1474034624007195},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:54:47Z},
 year = {2025}
}

@inproceedings{chen_multi-agent_2025,
 abstract = {Generative AI (GenAI) systems have shown great potential to support people with disabilities in their daily lives. However, the extent to which these systems are inclusive of people with disabilities is unclear. In this paper, we present findings from a series of focus groups with people with disabilities to understand their perspectives on GenAI. We recruited 24 participants with diverse disabilities and conducted 6 focus groups. Our findings reveal that people with disabilities have mixed feelings about GenAI. On the one hand, they see great potential in GenAI to support their daily lives. On the other hand, they are concerned about the accessibility of GenAI systems and the potential for GenAI to perpetuate ableism. We discuss implications for the design of inclusive GenAI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Chen},
 booktitle = {Proceedings of the 31st {ACM}},
 doi = {10.1145/3711896.3737249},
 isbn = {979-8-4007-1454-2},
 keywords = {information seeking},
 note = {event-place: Toronto ON},
 pages = {4341--4352},
 publisher = {Association for Computing Machinery},
 series = {{KDD}},
 title = {Multi-{Agent}},
 url = {https://doi.org/10.1145/3711896.3737249},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:35:59Z},
 year = {2025}
}

@inproceedings{chen_online_2024,
 abstract = {Recommendation systems have been widely deployed in various online platforms, which can significantly improve user experience by providing personalized recommendations. However, recent studies have shown that recommendation systems may exhibit bias and unfairness, which can lead to discrimination against certain groups of users or items. In this paper, we conduct a comprehensive survey on fairness in recommendation systems. We first introduce the definition of fairness in recommendation and categorize fairness issues into three main types: individual fairness, group fairness, and counterfactual fairness. Then, we review the existing fairness-aware recommendation methods, including bias mitigation techniques, fairness constraints, and adversarial training approaches. We also discuss the evaluation metrics for fairness in recommendation and highlight the challenges and future directions in this field. Our survey aims to provide a thorough understanding of fairness issues in recommendation systems and inspire more research on developing fair and unbiased recommendation algorithms.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Chen},
 booktitle = {Proceedings of the 5th {ACM}},
 doi = {10.1145/3677052.3698651},
