 volume = {57},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T06:00:49Z},
 year = {2025}
}

@inproceedings{deng_cram_2025,
 abstract = {Retrieval-Augmented Generation (RAG) can alleviate hallucinations of Large Language Models (LLMs) by referencing external documents. However, the misinformation in external documents may mislead LLMs' generation. To address this issue, we explore the task of "credibility-aware RAG", in which LLMs automatically adjust the influence of retrieved documents based on their credibility scores to counteract misinformation. To this end, we introduce a plug-and-play method named Credibility-aware Attention Modification (CrAM). CrAM identifies influential attention heads in LLMs and adjusts their attention weights based on the credibility of the documents, thereby reducing the impact of low-credibility documents. Experiments on Natual Questions and TriviaQA using Llama2-13B, Llama3-8B, and Qwen1.5-7B show that CrAM improves the RAG performance of LLMs against misinformation pollution by over 20%, even surpassing supervised fine-tuning methods.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Deng},
 booktitle = {Proceedings of the {AAAI}},
 doi = {10.1609/aaai.v39i22.34547},
 keywords = {source: Scopus},
 note = {Issue: 22
Type: Conference paper},
 pages = {23760 -- 23768},
 title = {{CrAM}},
 url = {https://doi.org/10.1609/aaai.v39i22.34547},
 volume = {39},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:40:52Z},
 year = {2025}
}

@article{deng_cram_2025-1,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their ability to perform complex reasoning, especially in the context of mathematical problem-solving, remains a significant challenge. In this paper, we propose a novel approach to enhance the mathematical reasoning capabilities of LLMs by integrating external symbolic reasoning engines. Our method, called SymReason, leverages the strengths of both LLMs and symbolic solvers to tackle mathematical problems more effectively. We evaluate our approach on several mathematical reasoning benchmarks and demonstrate significant improvements over existing baselines. Our results highlight the potential of hybrid systems that combine neural and symbolic components for advancing AI reasoning capabilities.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
