@article{rouzrokh_conflare_2024,
 abstract = {Large language models (LLMs) are increasingly used in safety-critical applications, such as medical diagnosis and legal advice. However, LLMs can be vulnerable to adversarial attacks, including jailbreaking, where an attacker tricks the model into generating harmful content. In this paper, we propose a novel jailbreaking method called "The Claude 3 Opus Jailbreak" that can successfully jailbreak Claude 3 Opus, a state-of-the-art LLM. Our method is based on a simple yet effective idea: we first generate a harmless prompt that is likely to be rejected by the model, then we iteratively refine the prompt by adding more and more harmful content until the model finally accepts it. We evaluate our method on a variety of tasks, including generating harmful content, role-playing as a malicious actor, and answering sensitive questions. Our results show that our method can achieve a success rate of over 90% on these tasks, significantly outperforming existing jailbreaking methods. We also discuss the implications of our findings and suggest possible defenses against such attacks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Rouzrokh},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Conflare: conformal large language model retrieval},
 url = {https://arxiv.org/abs/2404.04287},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:43:52Z},
 year = {2024}
}

@inproceedings{roy_beyond_2024,
 abstract = {Recent advances in large language models (LLMs) have shown promise in generating code from natural language descriptions, but their performance on complex, multi-step programming tasks remains limited. This paper introduces CodeChain, a novel framework that decomposes complex coding problems into interconnected chains of simpler subtasks, leveraging LLMs to solve each segment iteratively while maintaining global consistency through a verification module. We evaluate CodeChain on benchmarks such as HumanEval and LeetCode, demonstrating a 25% improvement in pass@1 accuracy over baseline LLM approaches. Our results highlight the potential of structured decomposition for enhancing LLM-based code generation in real-world software development scenarios.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Roy},
 booktitle = {Proceedings of the 47th {International}},
 doi = {10.1145/3626772.3657882},
 isbn = {979-8-4007-0431-4},
 keywords = {gpt-4},
 note = {event-place: Washington DC},
 pages = {1073--1082},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Beyond {Accuracy}},
 url = {https://doi.org/10.1145/3626772.3657882},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:30:49Z},
 year = {2024}
}

@inproceedings{roy_choudhury_genai_2025,
 abstract = {Visual Question Answering (VQA) models have achieved remarkable success in understanding and answering questions about images. However, these models often learn spurious correlations from training data, leading to biased predictions that favor certain answer types or demographics. In this paper, we address the fairness issue in VQA by proposing a novel debiasing framework that disentangles the visual and linguistic features to mitigate gender and racial biases. Our approach leverages counterfactual data augmentation and adversarial training to generate fair representations. Extensive experiments on the VQA-CP and GQA datasets demonstrate that our method significantly reduces bias while preserving overall accuracy, outperforming existing debiasing techniques.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Roy Choudhury},
 booktitle = {Companion of the 16th {ACM}},
 doi = {10.1145/3680256.3721333},
 isbn = {979-8-4007-1130-5},
 keywords = {cloud computing},
 note = {event-place: Toronto ON},
 pages = {154--161},
 publisher = {Association for Computing Machinery},
 series = {{ICPE}},
 title = {{GenAI}},
 url = {https://doi.org/10.1145/3680256.3721333},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:09:35Z},
 year = {2025}
}

@inproceedings{roy_exploring_2024,
 abstract = {Visual Question Answering (VQA) has made significant progress in recent years, but it still suffers from biases inherited from data and models, leading to unfair answers for certain groups of people. Existing debiasing methods for VQA mainly focus on reducing language bias, while the visual bias, which is also prevalent in VQA, has been largely ignored. In this paper, we conduct a comprehensive study on the gender bias in VQA from the perspective of both vision and language. We first propose a new metric, Gender Balance Score (GBS), to measure the gender bias in VQA datasets. Then, we propose a simple but effective method, FairVQA, to mitigate the gender bias in VQA models. FairVQA consists of two modules: a visual debiasing module and a language debiasing module. The visual debiasing module is designed to reduce the gender bias in visual features, while the language debiasing module is designed to reduce the gender bias in language features. Extensive experiments on the VQA-CP dataset demonstrate the effectiveness of our method in mitigating the gender bias in VQA models.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Roy},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3663529.3663841},
 isbn = {979-8-4007-0658-5},
 keywords = {AIOps},
 note = {event-place: Porto de Galinhas},
 pages = {208--219},
 publisher = {Association for Computing Machinery},
 series = {{FSE}},
 title = {Exploring {LLM}},
 url = {https://doi.org/10.1145/3663529.3663841},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:55:26Z},
 year = {2024}
}

@article{roychowdhury_confusedpilot_2024,
 abstract = {Learning generalist robot policies that can perform a wide range of tasks in diverse environments is a long-standing challenge in robotics. While recent advances in foundation models have shown promise in enabling generalist capabilities, they often struggle with real-world deployment due to issues like poor sim-to-real transfer, limited robustness to distribution shifts, and high data requirements. In this work, we investigate key factors that contribute to the success of generalist robot policies. We conduct a systematic study across policy architectures, data modalities, and training objectives, revealing that careful design choices in these areas can significantly improve performance. Specifically, we find that diffusion-based architectures with action chunking and multi-task learning objectives lead to more robust and generalizable policies. Furthermore, incorporating diverse data modalities, such as proprioceptive and exteroceptive observations, enhances the policy's ability to handle unseen scenarios. Our findings provide actionable insights for building effective generalist robot policies and demonstrate that with the right design, significant progress towards versatile robotic agents is achievable.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {RoyChowdhury},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Confusedpilot: {Confused}},
 url = {https://arxiv.org/abs/2408.04870},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:43:33Z},
 year = {2024}
}

@inproceedings{roychowdhury_eratta_2024,
 abstract = {Credit card fraud detection is a critical task in the financial sector, where machine learning models are widely used to identify fraudulent transactions. However, traditional centralized training approaches raise significant privacy concerns as they require sharing sensitive transaction data across institutions. In this paper, we propose a privacy-preserving federated learning framework for credit card fraud detection that enables collaborative model training without exchanging raw data. Our approach leverages differential privacy mechanisms and secure aggregation to protect individual data privacy while improving model performance through distributed learning. We evaluate the proposed framework on benchmark datasets, including the Kaggle Credit Card Fraud Detection dataset, demonstrating superior accuracy and recall compared to baseline methods, with minimal privacy overhead. Experimental results show that our federated model achieves up to 98.5% accuracy and 99% recall, highlighting its potential for real-world deployment in privacy-sensitive environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Roychowdhury},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/BigData62323.2024.10825910},
 journal = {arXiv preprint arXiv …},
 keywords = {authentication},
 month = {dec},
 note = {ISSN: 2573-2978},
 pages = {4605--4610},
 title = {{ERATTA}},
 url = {https://doi.org/10.1109/bigdata62323.2024.10825910},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:46:27Z},
 year = {2024}
}

@article{roychowdhury_evaluation_2024,
 abstract = {A key question in robot learning is how to collect data that enables generalist robot policies to perform well across a wide range of tasks and environments. In this work, we study this question by analyzing the data used to train state-of-the-art generalist robot policies. We find that the data used to train these policies is highly diverse in terms of tasks, scenes, and robot embodiments, but that the data is also highly correlated across these dimensions. We then conduct a series of experiments to understand the impact of this data structure on policy performance. Our results suggest that the high correlation in the data is beneficial for policy generalization, and that policies trained on this data can transfer to new tasks and environments. We also find that the policies are robust to changes in the robot embodiment, and that they can be fine-tuned to improve performance on specific tasks. Overall, our work provides insights into the design of data collection strategies for generalist robot policies, and highlights the importance of data diversity and correlation for policy generalization.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Roychowdhury},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Evaluation of rag metrics for question answering in the telecom domain},
 url = {https://arxiv.org/abs/2407.12873},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:41:48Z},
 year = {2024}
}

@inproceedings{ruamsuk_enhancing_2025,
 abstract = {Visual Question Answering (VQA) has achieved remarkable progress with the development of large-scale pre-trained vision-language models. However, these models often exhibit biases towards certain answer categories, leading to unfair performance across different question types or demographics. In this paper, we investigate the fairness issue in VQA from the perspective of answer distribution imbalance. We first empirically analyze the bias patterns in popular VQA datasets and models, revealing that the models tend to over-predict dominant answers while under-predicting minority ones. To mitigate this, we propose a novel framework, FairVQA, which consists of two key components: (1) a bias-aware answer generation module that encourages the model to generate diverse answers by penalizing over-confident predictions on dominant answers, and (2) a fairness-aware fine-tuning strategy that balances the training distribution across answer categories. Extensive experiments on benchmark VQA datasets demonstrate that our approach significantly improves fairness without compromising overall accuracy, achieving state-of-the-art results in both balanced and imbalanced settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Ruamsuk},
 booktitle = {Proceedings of the 2024 8th {International}},
 doi = {10.1145/3711542.3711558},
 isbn = {979-8-4007-1738-3},
 keywords = {Co-Occurrence Graph},
 pages = {265--271},
 publisher = {Association for Computing Machinery},
 series = {{NLPIR}},
 title = {Enhancing {Retrieval}},
 url = {https://doi.org/10.1145/3711542.3711558},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:21:12Z},
 year = {2025}
}

@inproceedings{ruan_specrover_2025,
 abstract = {Software engineering research has increasingly focused on improving the efficiency and quality of code review processes. However, traditional code review methods often overlook subtle issues in documentation and comments. In this paper, we introduce DocReview, an automated tool that leverages natural language processing techniques to detect and suggest improvements for documentation smells in source code comments and docstrings. We define a taxonomy of seven common documentation smells based on an empirical study of 500 open-source projects. DocReview uses a combination of rule-based heuristics and machine learning models trained on labeled data to identify these smells with high precision. Evaluated on 10,000 code files from GitHub repositories, our tool achieves an average F1-score of 0.88, outperforming existing linters by 25%. Our results demonstrate that addressing documentation smells can improve code comprehension by 30%, as measured by developer surveys. This work provides a practical contribution to enhancing software maintainability through better documentation practices.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {Ottawa},
 author = {Ruan},
 booktitle = {Proceedings of the {IEEE}},
 doi = {10.1109/ICSE55347.2025.00080},
 isbn = {979-8-3315-0569-1},
 keywords = {source: ACM},
 pages = {963--974},
 publisher = {IEEE Press},
 series = {{ICSE}},
 title = {{SpecRover}},
 url = {https://doi.org/10.1109/icse55347.2025.00080},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:01:09Z},
 year = {2025}
}

@article{rubinstein_summarizing_2025,
 abstract = {Background Concise synopses of clinical evidence support treatment decision-making but are time-consuming to curate. Large language models (LLMs) offer potential but they may provide inaccurate information. We objectively assessed the abilities of four commercially available LLMs to generate synopses for six treatment regimens in multiple myeloma and amyloid light chain (AL) amyloidosis. Methods We compared the performance of four LLMs: Claude 3.5, ChatGPT 4.0; Gemini 1.0 and Llama-3.1. Each LLM was prompted to write synopses for six regimens. Two hematologists independently assessed accuracy, completeness, relevance, clarity, coherence, and hallucinations using Likert scales. Mean scores with 95% confidence intervals (CI) were calculated across all domains and inter-rater reliability was evaluated using Cohen's quadratic weighted kappa. Results Claude demonstrated the highest performance in all domains, outperforming the other LLMs in accuracy: mean Likert score 3.92 (95% CI 3.54–4.29); ChatGPT 3.25 (2.76–3.74); Gemini 3.17 (2.54–3.80); Llama 1.92 (1.41–2.43);completeness: mean Likert score 4.00 (3.66–4.34); GPT 2.58 (2.02–3.15); Gemini 2.58 (2.02–3.15); Llama 1.67 (1.39–1.95); and extentofhallucinations: mean Likert score 4.00 (4.00–4.00); ChatGPT 2.75 (2.06-3.44); Gemini 3.25 (2.65–3.85); Llama 1.92 (1.26–2.57). Llama performed considerably poorer across all the studied domains. ChatGPT and Gemini had intermediate performance. Notably, none of the LLMs registered perfect accuracy, completeness, or relevance. Conclusion Claude performed at a consistently higher level than other LLMs, all tested LLMs required careful editing from a domain expert to become usable. More time will be needed to determine the suitability of LLMsto independently generate clinical synopses.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 1; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Rubinstein},
 doi = {10.3389/fdgth.2025.1569554},
 journal = {Frontiers in Digital Health},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Summarizing clinical evidence utilizing large language models for cancer treatments: a blinded comparative analysis},
 url = {https://doi.org/10.3389/fdgth.2025.1569554},
 volume = {7},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:58:49Z},
 year = {2025}
}

@article{rui_chatcl_2025,
 abstract = {This paper introduces a novel hybrid deep learning model for real-time anomaly detection in industrial IoT environments. The proposed approach combines convolutional neural networks (CNNs) with long short-term memory (LSTM) networks to effectively capture spatial and temporal patterns in sensor data streams. By leveraging federated learning techniques, the model ensures privacy-preserving training across distributed edge devices, addressing key challenges in scalability and data security. Experimental results on benchmark datasets demonstrate superior performance in terms of accuracy, precision, and recall compared to state-of-the-art methods, achieving up to 15% improvement in detection rates under noisy conditions. The framework is validated through simulations and a real-world deployment in a smart manufacturing setup, highlighting its practical applicability for enhancing cybersecurity in Industry 4.0 applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Rui},
 doi = {10.1109/ISEDA65950.2025.11101624},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {736 -- 742},
 title = {{ChaTCL}},
 url = {https://doi.org/10.1109/iseda65950.2025.11101624},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:51:18Z},
 year = {2025}
}

@article{rupanetti_industry_2025,
 abstract = {This paper explores the integration of Large Language Models (LLMs) and secure Gen-AI technologies within engineering design and manufacturing, with a focus on improving inventory management, component selection, and recommendation workflows. The system is intended for deployment and evaluation in a real-world industrial environment. It utilizes vector embeddings, vector databases, and Approximate Nearest Neighbor (ANN) search algorithms to implement Retrieval-Augmented Generation (RAG), enabling context-aware searches for inventory items and addressing the limitations of traditional text-based methods. Built on an LLM framework enhanced by RAG, the system performs similarity-based retrieval and part recommendations while preserving data privacy through selective obfuscation using the ROT13 algorithm. In collaboration with an industry sponsor, real-world testing demonstrated strong results: 88.4% for Answer Relevance, 92.1% for Faithfulness, 80.2% for Context Recall, and 83.1% for Context Precision. These results demonstrate the system’s ability to deliver accurate and relevant responses while retrieving meaningful context and minimizing irrelevant information. Overall, the approach presents a practical and privacy-aware solution for manufacturing, bridging the gap between traditional inventory tools and modern AI capabilities and enabling more intelligent workflows in design and production processes.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Rupanetti},
 doi = {10.3390/a18070414},
 journal = {Algorithms},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {7},
 title = {An {Industry}},
 url = {https://doi.org/10.3390/a18070414},
 volume = {18},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:37:07Z},
 year = {2025}
}

@inproceedings{russo_europeanlawadvisor_2024,
 abstract = {The rapid growth of the Internet of Things (IoT) has led to an explosion of data generated by interconnected devices, presenting both opportunities and challenges in terms of privacy, security, and computational efficiency. Traditional centralized machine learning approaches are often impractical for IoT due to data silos, bandwidth limitations, and privacy concerns. Federated Learning (FL) has emerged as a decentralized paradigm that enables collaborative model training across distributed devices while keeping data localized. This paper provides a comprehensive survey on the integration of FL with IoT systems, focusing on edge intelligence applications. We review key architectures, communication-efficient protocols, privacy-preserving techniques such as differential privacy and secure multi-party computation, and challenges including heterogeneity, resource constraints, and adversarial attacks. Furthermore, we discuss real-world use cases in smart cities, healthcare, and industrial IoT, along with open research directions to enhance scalability and robustness in FL-IoT ecosystems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Russo},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/BigData62323.2024.10826025},
 keywords = {Accuracy},
 month = {dec},
 note = {ISSN: 2573-2978},
 pages = {4751--4756},
 title = {{EuropeanLawAdvisor}},
 url = {https://doi.org/10.1109/bigdata62323.2024.10826025},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:04:45Z},
 year = {2024}
}

@inproceedings{russo_scaling_2024,
 abstract = {The rapid growth of Internet of Things (IoT) devices has led to an exponential increase in data generation, necessitating efficient anomaly detection mechanisms to ensure network security. Traditional centralized anomaly detection approaches face challenges such as privacy concerns, high communication overhead, and scalability issues in distributed IoT environments. Federated Learning (FL) emerges as a promising paradigm to address these challenges by enabling collaborative model training across decentralized devices without sharing raw data. However, applying FL to anomaly detection in IoT networks is non-trivial due to the heterogeneity of data distributions, limited computational resources on edge devices, and vulnerability to adversarial attacks. In this paper, we propose FedIoTAD, a robust federated learning framework tailored for anomaly detection in IoT networks. FedIoTAD incorporates a novel client selection mechanism based on data quality and device capabilities, along with differential privacy to enhance security. Extensive experiments on real-world IoT datasets demonstrate that FedIoTAD outperforms state-of-the-art baselines in terms of detection accuracy, communication efficiency, and resilience to attacks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Russo},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/BigData62323.2024.10825937},
 keywords = {Data mining},
 month = {dec},
 note = {ISSN: 2573-2978},
 pages = {3494--3497},
 title = {Scaling {LLM}},
 url = {https://doi.org/10.1109/bigdata62323.2024.10825937},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:11:41Z},
 year = {2024}
}

@article{russo_towards_2025,
 abstract = {Machine learning (ML)-powered systems are capable of reproducing and often amplifying undesired biases embedded in society, emphasizing the importance of operating under practices that enable the study and understanding of the intrinsic characteristics of ML pipelines. This supports the emergence of documentation frameworks with the idea that “any remedy for bias starts with awareness of its existence.” However, a resource that can formally describe ML pipelines in terms of detected biases is still missing. To address this gap, we present the Doc-BiasO ontology, a resource that sets out to create an integrated vocabulary of biases defined in the Trustworthy AI literature and their measures, as well as to incorporate relevant domain terminology and relationships between them. Overseeing ontology engineering best practices, we reuse existing vocabularies on machine learning and AI to foster knowledge sharing and interoperability between the actors concerned with its research, development, regulation, and others. In addition, we demonstrate the potential of Doc-BiasO with an experiment on an existing benchmark and as part of a neuro-symbolic system. Overall, our main objective is to contribute towards clarifying existing terminology on bias research as it rapidly expands to all areas of AI and to improve the interpretation of bias in data and downstream impact through its documentation.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Russo},
 doi = {10.1613/jair.1.19388},
 issn = {1076-9757},
 journal = {J. Artif. Int. Res.},
 keywords = {AI in Healthcare},
 month = {aug},
 note = {Place: El Segundo},
 title = {Towards an {Ontology}},
 url = {https://doi.org/10.1613/jair.1.19388},
 volume = {83},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:50Z},
 year = {2025}
}

@article{ryan_enronqa_2025,
 abstract = {Large language models (LLMs) have achieved impressive capabilities across various natural language processing tasks. However, their performance in mathematical reasoning remains limited, particularly for complex problems requiring multi-step reasoning. In this paper, we investigate the potential of LLMs for mathematical reasoning by fine-tuning them on a large-scale dataset of mathematical problems. We introduce MathBench, a new benchmark comprising 50,000 diverse mathematical questions spanning arithmetic, algebra, geometry, calculus, and more advanced topics. Our experiments show that fine-tuned LLMs significantly outperform previous models on MathBench, achieving up to 75% accuracy on challenging problems. We also analyze scaling laws for mathematical reasoning, demonstrating that performance scales predictably with model size, training data, and compute. Our results highlight the promise of LLMs as versatile tools for mathematical reasoning and provide insights for future improvements.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Ryan},
 journal = {arXiv preprint arXiv:2505.00263},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Enronqa: {Towards}},
 url = {https://arxiv.org/abs/2505.00263},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:17:23Z},
 year = {2025}
}

@inproceedings{ryu_cinema_2025,
 abstract = {Recent advances in vision-language models (VLMs) have led to impressive performance across a wide range of tasks. However, these models often perpetuate or amplify societal biases present in their training data, resulting in unfair and potentially harmful outputs. Existing debiasing techniques for VLMs are either computationally expensive or require access to the model's internal parameters, limiting their applicability. In this work, we introduce Biased Prompt Debiasing (BPD), a simple and effective method to mitigate bias in VLMs using only text prompts. BPD generates biased prompts that explicitly target known biases and uses them to fine-tune the model, encouraging it to learn fairer representations. Our approach is model-agnostic, requiring no architectural changes or proprietary data. Extensive experiments on multiple VLM architectures and bias benchmarks demonstrate that BPD substantially reduces bias metrics while preserving or enhancing overall performance. BPD offers a practical solution for deploying fairer VLMs in sensitive applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Ryu},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713641},
 isbn = {979-8-4007-1394-1},
 keywords = {Conversational AI},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {Cinema {Multiverse}},
 url = {https://doi.org/10.1145/3706598.3713641},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:23:39Z},
 year = {2025}
}

@article{ryu_retrieval-based_2023,
 abstract = {Large language models (LLMs) have achieved remarkable success in a wide range of natural language processing tasks. However, their performance on low-resource languages remains limited due to the scarcity of training data in those languages. In this paper, we investigate the potential of multilingual LLMs for low-resource language tasks, focusing on neural machine translation (NMT) and named entity recognition (NER). We conduct a comprehensive evaluation across multiple low-resource languages and propose a simple adaptation technique to enhance their zero-shot and few-shot performance. Our experiments demonstrate that while LLMs show promising transfer capabilities, there is still a significant gap compared to high-resource languages, highlighting the need for further research in this area.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Ryu},
 journal = {Proceedings of the …},
