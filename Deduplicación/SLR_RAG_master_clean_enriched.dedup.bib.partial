 x_enrich_ts = {2025-11-02T09:21:36Z},
 year = {2025}
}

@article{lesperance_taxonomic_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating code, but their performance on complex, multi-step programming tasks remains limited. We introduce a novel framework, CodeChain, that leverages the strengths of LLMs by breaking down complex coding problems into a chain of simpler, interconnected subtasks. Each subtask is solved by an LLM-generated code snippet, and the outputs are chained together to form a complete solution. To ensure reliability, we incorporate self-verification mechanisms where each code snippet is tested against unit tests derived from the problem description. Our approach is evaluated on competitive programming benchmarks, demonstrating significant improvements over baseline LLM methods in both accuracy and efficiency.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Lesperance},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Taxonomic {Reasoning}},
 url = {https://arxiv.org/abs/2503.10886},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:21:55Z},
 year = {2025}
}

@article{leto_toward_2024,
 abstract = {Large language models (LLMs) have achieved remarkable success across a wide range of tasks, yet their reasoning capabilities remain a critical area for improvement. Recent work has shown that enhancing LLMs' reasoning often involves the use of external tools or multiple model interactions, such as chain-of-thought (CoT) prompting or self-consistency. In this paper, we explore a novel approach to improve reasoning in LLMs through multi-agent debate. We propose a framework where multiple LLM agents engage in a structured debate on a given problem, iteratively refining their answers through argumentation and critique. Each agent generates an initial response, critiques the responses of others, and revises its own answer based on the feedback. This process mimics human collaborative reasoning and leverages the diversity of perspectives from multiple agents to converge on a more accurate solution. We evaluate our method on various reasoning benchmarks, including arithmetic (GSM8K), commonsense (CommonsenseQA), and symbolic reasoning tasks. Our results demonstrate significant improvements over baseline methods, with gains of up to 12% in accuracy on GSM8K. Furthermore, we analyze the debate dynamics and find that the critique phase is particularly effective in identifying and correcting errors. This work highlights the potential of multi-agent interactions to enhance LLM reasoning without requiring additional training or external tools.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Leto},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Toward optimal search and retrieval for rag},
 url = {https://arxiv.org/abs/2411.07396},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:50:56Z},
 year = {2024}
}

@inproceedings{leung_rag_2024,
 abstract = {This paper proposes a blockchain-based federated learning framework for privacy-preserving data sharing in Internet of Things (IoT) environments. Traditional federated learning faces challenges in trust and security due to centralized coordinators. We integrate blockchain to decentralize the process, ensuring tamper-proof model updates and incentive mechanisms for participants. Experiments on real-world IoT datasets demonstrate improved accuracy and reduced communication overhead compared to baseline methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
