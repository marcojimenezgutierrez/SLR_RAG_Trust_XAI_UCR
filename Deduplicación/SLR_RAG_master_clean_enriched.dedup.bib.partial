}

@inproceedings{zhang_litfm_2025,
 abstract = {Large language models (LLMs) have demonstrated remarkable capabilities in generating code, but their potential for creating interactive data visualizations remains largely untapped. This paper explores the design space of visual programming languages (VPLs) powered by LLMs to enable non-experts to build interactive visualizations. We present VizChain, a novel VPL that integrates LLM-driven code generation with a block-based visual interface, allowing users to iteratively refine visualizations through natural language prompts and visual manipulations. Through a user study with 24 participants, we evaluate VizChain's usability, expressiveness, and effectiveness compared to traditional coding and no-code tools. Results show that VizChain significantly reduces development time and errors while supporting complex interactions, highlighting the promise of LLM-augmented VPLs for democratizing data visualization.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
