 year = {2025}
}

@article{nemeth_using_2024,
 abstract = {The COVID-19 pandemic has significantly affected mortality rates worldwide, including in Hungary. This study examines the changes in Hungarian life expectancy at birth and at age 65 during the pandemic years (2020–2021) compared to the pre-pandemic period (2015–2019). Using official mortality and population data from the Hungarian Central Statistical Office, period life tables were constructed for both sexes. The results show a substantial decline in life expectancy at birth: 2.3 years for males and 1.9 years for females in 2020–2021 compared to 2015–2019. Similar declines were observed at age 65. Decomposition analysis reveals that the increase in mortality was driven primarily by excess deaths in the 65+ age group, particularly among males. The findings highlight the severe impact of the pandemic on Hungarian longevity and underscore the need for targeted public health interventions to mitigate future risks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
