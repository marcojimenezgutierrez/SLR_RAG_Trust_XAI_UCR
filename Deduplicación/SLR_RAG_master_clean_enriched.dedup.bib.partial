 year = {2024}
}

@inproceedings{elfayoumi_knowledge_2025,
 abstract = {This paper proposes a novel framework for enhancing cybersecurity in smart grids using blockchain technology integrated with machine learning algorithms. The proposed system addresses key vulnerabilities such as data tampering and unauthorized access by leveraging distributed ledger for secure data sharing and anomaly detection models for real-time threat identification. Extensive simulations demonstrate that the framework achieves a 95% accuracy in detecting intrusions while reducing latency by 40% compared to traditional methods. The results highlight its potential for scalable deployment in modern power systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
