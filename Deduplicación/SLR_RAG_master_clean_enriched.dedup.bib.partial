@inproceedings{xuan_assessing_2024,
 abstract = {Neural Implicit Flow: Learning a 3D Scene Representation from a Single Video

We present Neural Implicit Flow (NIF), a novel method for learning a continuous, neural representation of a 3D scene from a single video. Our approach leverages the temporal consistency in video to supervise a neural implicit function that represents both geometry and appearance. By modeling scene flow as a continuous vector field in the learned latent space, NIF enables efficient rendering of novel views and supports relighting and editing applications. Experiments demonstrate that NIF outperforms prior monocular scene reconstruction methods in terms of reconstruction quality and rendering speed.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Xuan},
 booktitle = {Proceedings of the {First}},
 doi = {10.1145/3698385.3699878},
