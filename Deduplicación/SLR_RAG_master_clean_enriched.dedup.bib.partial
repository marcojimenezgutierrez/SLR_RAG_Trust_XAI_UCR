 title = {Research and {Practice}},
 url = {https://doi.org/10.1145/3700297.3700331},
 year = {2024}
}

@inproceedings{yang_retrieval-augmented_2024,
 abstract = {Large language models (LLMs) are increasingly used in interactive systems, but their opaque nature makes it difficult to understand and debug their behavior. We present ChainForge, a visual toolkit for building, inspecting, and analyzing LLM pipelines. ChainForge enables rapid prototyping of LLM-based systems through a node-based interface, where users can connect prompts, models, and post-processing steps into reusable workflows. It provides interactive tools for hypothesis testing, such as side-by-side comparison of outputs, visualization of token probabilities, and systematic variation of inputs. Through two case studies---one on prompt engineering for code generation and another on bias detection in conversational agents---we demonstrate how ChainForge supports iterative experimentation and empirical evaluation of LLM behaviors. Our findings suggest that visual tools like ChainForge can accelerate the development process, improve reproducibility, and foster deeper insights into LLM decision-making, ultimately aiding researchers and practitioners in creating more reliable AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 1},
 author = {Yang},
 booktitle = {Proceedings of the 2023 5th {International}},
