@article{ju_flooding_2024,
 abstract = {Robotic policies with large-scale training data and compute have recently shown promising results on generalization to novel tasks and environments. However, it is unclear what factors are most important for building effective generalist robot policies. In this work, we conduct a comprehensive study across policy architectures, data representations, and training objectives, using a diverse set of robotic tasks. Our findings reveal that while scaling data and compute can improve performance, careful design choices in policy architecture and data representation can yield comparable or better results with significantly less resources. Specifically, we show that transformer-based policies with action chunking and frame stacking as data representations, combined with a mixture-of-experts training objective, enable efficient learning of generalist policies that generalize well across tasks. We release our code and datasets to facilitate further research in this direction.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Ju},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Flooding spread of manipulated knowledge in llm-based multi-agent communities},
 url = {https://arxiv.org/abs/2407.07791},
