}

@inproceedings{jiang_exploring_2025,
 abstract = {This paper proposes a novel deep learning-based approach for fault detection in industrial control systems. By integrating convolutional neural networks with long short-term memory models, the system achieves higher accuracy in identifying anomalies in real-time embedded environments. Experimental results on benchmark datasets demonstrate a 15% improvement in detection precision compared to traditional methods. The framework is designed for deployment on resource-constrained devices, ensuring low latency and energy efficiency. Future work will explore integration with edge computing paradigms.},
