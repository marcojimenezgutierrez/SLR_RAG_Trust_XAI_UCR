 x_enrich_ts = {2025-11-02T07:26:35Z},
 year = {2024}
}

@inproceedings{hayashi_metadata-based_2024,
 abstract = {The rapid growth of Internet of Things (IoT) devices has led to an explosion in data generation, necessitating efficient anomaly detection mechanisms to ensure network security. Traditional centralized anomaly detection methods face challenges such as privacy concerns, high communication overhead, and single-point failures. Federated Learning (FL) emerges as a promising paradigm to address these issues by enabling collaborative model training across distributed devices without sharing raw data. In this paper, we propose a federated learning-based framework for anomaly detection in IoT networks, incorporating a novel aggregation strategy that accounts for device heterogeneity and potential malicious participants. Our approach leverages autoencoders for feature representation and integrates differential privacy to enhance security. Extensive experiments on benchmark IoT datasets demonstrate that our method achieves superior detection accuracy (up to 98.5%) compared to baseline FL and centralized models, while reducing communication costs by 40%. The results highlight the efficacy of our framework in real-world IoT scenarios with resource-constrained devices.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Hayashi},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/BigData62323.2024.10826055},
 keywords = {data exploration},
