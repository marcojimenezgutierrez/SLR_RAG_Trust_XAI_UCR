 pages = {43--48},
 title = {Revolutionizing {Assessment}},
 url = {https://doi.org/10.1109/icssas64001.2024.10760285},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:48:54Z},
 year = {2024}
}

@article{sundar_revolutionizing_2024-1,
 abstract = {Federated learning (FL) has emerged as a promising approach for training machine learning models in a distributed manner while preserving data privacy. However, deploying FL on resource-constrained Internet of Things (IoT) devices presents unique challenges due to their limited computational power, memory, storage, and energy resources. This paper provides a comprehensive survey of FL techniques specifically designed or adapted for resource-constrained IoT environments. We categorize the existing methods based on key optimization dimensions, including model compression, communication efficiency, personalization, and energy management. Furthermore, we discuss the integration of FL with emerging IoT paradigms such as edge computing and 6G networks. Open challenges and future research directions are also highlighted to guide the development of efficient and scalable FL solutions for IoT applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
