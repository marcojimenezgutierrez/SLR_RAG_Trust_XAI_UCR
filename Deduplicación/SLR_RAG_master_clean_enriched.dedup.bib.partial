 x_enrich_ts = {2025-11-02T06:31:51Z},
 year = {2024}
}

@inproceedings{esposito_leveraging_2024,
 abstract = {Large Language Models (LLMs) have revolutionized various domains, but their integration into enterprise environments remains underexplored. This paper surveys current trends and future directions for LLM adoption in enterprises, focusing on challenges such as data privacy, computational costs, and ethical considerations. We categorize applications across sectors like finance, healthcare, and customer service, highlighting successful case studies and emerging techniques like retrieval-augmented generation (RAG) and federated learning. By analyzing limitations and proposing a roadmap, we aim to guide practitioners and researchers toward scalable, secure LLM deployments that drive business value.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
