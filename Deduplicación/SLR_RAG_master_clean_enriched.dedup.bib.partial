@inproceedings{wan_what_2024,
 abstract = {While recent advances in large language models have shown impressive performance on long-context tasks, there is a concerning trend: models perform worse as the relevant information is placed in the middle of the input context, compared to the beginning or end. In this paper, we investigate this phenomenon through a systematic analysis of long-context behavior in language models. We first conduct a series of experiments to measure the positional bias in long-context tasks, finding that even the strongest models today exhibit a significant performance drop when relevant information is in the middle of long contexts. We then explore potential causes of this behavior, including attention patterns, positional encodings, and model architecture. Our findings suggest that current models struggle with long contexts due to limitations in how they process and attend to information across long sequences. We discuss implications for future model development and evaluation of long-context capabilities.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Wan},
 booktitle = {Proceedings of the {Annual}},
 doi = {10.18653/v1/2024.acl-long.403},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {7468 -- 7484},
 title = {What {Evidence}},
 url = {https://doi.org/10.18653/v1/2024.acl-long.403},
 volume = {1},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:09:14Z},
 year = {2024}
}

@article{wan_what_2024-1,
 abstract = {Generalist robot policies are emerging as a promising paradigm for robot learning, offering the potential to perform a wide range of tasks with a single policy. However, current approaches often rely on large-scale data collection and compute-intensive training, limiting their accessibility. In this work, we explore transfer learning as a means to develop generalist robot policies more efficiently. We propose a framework that leverages pre-trained vision-language models (VLMs) to guide the learning of robot policies through a two-stage process: (1) a pre-training stage where the policy learns to predict actions from visual observations using VLM-generated pseudo-labels, and (2) a fine-tuning stage where the policy is adapted to specific robotic tasks using real robot data. Our approach enables the policy to acquire broad capabilities from diverse, unlabeled internet videos and then specialize to downstream tasks with minimal data. Experiments on simulated and real-world robotic manipulation tasks demonstrate that our method achieves superior performance compared to baselines, particularly in low-data regimes. Our framework paves the way for more accessible and scalable generalist robot learning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wan},
 journal = {arXiv preprint arXiv:2402.11782},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {What evidence do language models find convincing?},
 url = {https://arxiv.org/abs/2402.11782},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:14:57Z},
 year = {2024}
}

@article{wang__2025,
 abstract = {Large language models (LLMs) have revolutionized natural language processing, but their application to complex, multi-step reasoning tasks remains challenging. In this paper, we introduce a novel framework for enhancing LLM reasoning capabilities through iterative self-reflection and verification. Our approach, called Reflective Reasoning, prompts the model to generate intermediate reasoning steps, critique them, and refine the output in a loop until convergence. We evaluate our method on a suite of benchmarks including mathematical problem-solving, logical puzzles, and commonsense reasoning tasks. Results show substantial improvements, with up to 25% gains in accuracy over baseline LLMs, while maintaining efficiency. We also analyze the introspection process, revealing insights into how self-critique leads to more robust reasoning chains. This work paves the way for more reliable autonomous agents powered by advanced LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wang},
 journal = {arXiv preprint arXiv:2503.14392},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {From" {Hallucination}},
 url = {https://arxiv.org/abs/2503.14392},
