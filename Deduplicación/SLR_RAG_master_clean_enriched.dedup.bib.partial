@article{yu_integrating_2025,
 abstract = {Silence is a fundamental aspect of human communication, yet its role in human-AI interactions remains underexplored. In this paper, we investigate how people perceive and respond to silence in conversations with AI, and how AI can be designed to better handle silence. Through a mixed-methods study with 48 participants, we examine perceptions of silence in human-human and human-AI interactions, and explore design strategies for AI to interpret and respond to silence. Our findings reveal that people attribute different meanings to silence depending on context, such as thinking time, hesitation, or disinterest, and that AI's handling of silence significantly impacts perceived naturalness and collaboration. We contribute a framework for silence-aware AI design, including strategies like adaptive pausing, contextual inference, and multimodal cues, to foster more natural and empathetic human-AI interactions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Yu},
 doi = {10.1145/3641554.3701844},
 journal = {Proceedings of the 56th ACM …},
 keywords = {source: Google Scholar},
