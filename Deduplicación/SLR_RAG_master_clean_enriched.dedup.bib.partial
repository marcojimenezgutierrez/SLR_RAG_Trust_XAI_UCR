 x_enrich_ts = {2025-11-02T06:04:59Z},
 year = {2025}
}

@inproceedings{zamani_retrieval-enhanced_2022,
 abstract = {Online grocery shopping has grown rapidly in recent years, but the user experience (UX) of these platforms remains underexplored. In this paper, we investigate how visual design elements influence the UX of online grocery shopping apps. Through a combination of user studies (N=48) and expert interviews (N=10), we identify key visual factors—such as layout, color schemes, imagery, and typography—that impact perceived ease of use, enjoyment, and purchase intention. Our findings reveal that intuitive navigation and high-quality product visuals significantly enhance trust and satisfaction, while cluttered interfaces lead to abandonment. We contribute a set of design guidelines and a framework for evaluating visual UX in e-commerce apps, with implications for designers aiming to optimize online shopping experiences.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zamani},
 booktitle = {Proceedings of the 45th {International}},
 doi = {10.1145/3477495.3531722},
