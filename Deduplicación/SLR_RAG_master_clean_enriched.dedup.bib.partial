@article{jing_kg-enhanced_2025,
 abstract = {This paper presents a novel approach to optimizing the trajectory of reusable launch vehicles during ascent and reentry phases using deep reinforcement learning (DRL). Traditional trajectory optimization methods rely on solving complex nonlinear programming problems, which can be computationally intensive and sensitive to initial conditions. In contrast, the proposed DRL framework, based on the proximal policy optimization algorithm, learns an optimal policy directly from simulated flight dynamics, incorporating constraints on thrust, aerodynamics, and thermal loads. The agent is trained in a high-fidelity environment using OpenAI Gym customized for aerospace applications. Results demonstrate that the DRL agent achieves fuel savings of up to 8% compared to baseline trajectories while satisfying all mission constraints. The method shows robustness to uncertainties in atmospheric conditions and vehicle parameters, paving the way for real-time onboard optimization in future space missions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 2},
