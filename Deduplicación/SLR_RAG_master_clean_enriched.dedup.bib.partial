@inproceedings{rahmani_llm4eval_2024,
 abstract = {In this paper, we investigate the role of silence in conversations with large language models (LLMs). While LLMs are typically designed to generate verbose responses, users often prefer concise answers. We explore how LLMs handle silence—periods without user input—and whether they can infer when to stop responding or initiate new topics. Through a series of experiments, we analyze LLM behaviors in silent scenarios, including response continuation, topic shifting, and user intent prediction. Our findings reveal that current LLMs struggle with prolonged silence, often leading to repetitive or off-topic outputs. We propose design guidelines for improving silence handling in conversational AI, emphasizing adaptive pausing and context-aware inference. This work contributes to more natural and user-centric human-AI interactions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Rahmani},
 booktitle = {Proceedings of the 47th {International}},
 doi = {10.1145/3626772.3657992},
 isbn = {979-8-4007-0431-4},
 keywords = {automated evaluation},
