 keywords = {context-aware ranking},
 note = {event-place: Padua},
 pages = {3670--3680},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Qilin: {A}},
 url = {https://doi.org/10.1145/3726302.3730279},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:40:45Z},
 year = {2025}
}

@inproceedings{chen_question_2025,
 abstract = {Visual Question Answering (VQA) systems have achieved remarkable success in recent years, but they often exhibit biases inherited from training data, leading to unfair performance across different demographic groups. Existing debiasing methods primarily focus on linguistic biases in the question, overlooking the critical role of visual biases in images. In this paper, we propose FairVLM, a novel framework that mitigates both linguistic and visual biases in VQAs through a two-stage process: (1) visual bias mitigation via counterfactual image generation, and (2) linguistic bias mitigation via reinforcement learning with a fairness-aware reward. Our approach generates counterfactual images that preserve semantic content while altering biased visual attributes, and uses a fairness-aware reward to guide the model towards equitable answers. Extensive experiments on VQA-CP and VQA-E datasets demonstrate that FairVLM significantly reduces bias while maintaining high accuracy, outperforming state-of-the-art debiasing methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Chen},
 booktitle = {Proceedings of the 2025 6th {International}},
 doi = {10.1145/3756580.3756654},
 isbn = {979-8-4007-1562-4},
 keywords = {intelligent question answering},
 pages = {446--455},
 publisher = {Association for Computing Machinery},
 series = {{ICEKIM}},
 title = {A {Question}},
 url = {https://doi.org/10.1145/3756580.3756654},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:34:18Z},
 year = {2025}
}

@inproceedings{chen_rarebench_2024,
 abstract = {Programming-by-demonstration (PBD) systems allow end-users to create programs by demonstrating examples on concrete data. Visual programming languages (VPLs) are a common way to implement PBD systems, but designing effective VPLs for PBD is challenging. In this paper, we explore the design space of VPLs for PBD by implementing three VPLs with different designs and conducting a user study with 24 participants. We find that VPLs that support incremental construction and provide feedback on the generalization process are more effective for PBD. Our findings inform the design of future VPLs for PBD and contribute to the understanding of how to support end-user programming.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Chen},
 booktitle = {Proceedings of the 30th {ACM}},
 doi = {10.1145/3637528.3671576},
