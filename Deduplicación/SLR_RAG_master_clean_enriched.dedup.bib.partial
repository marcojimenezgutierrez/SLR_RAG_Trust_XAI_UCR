@inproceedings{yun_generative_2025,
 abstract = {Recommendation systems have been widely deployed in various online platforms, which recommend items to users based on their historical interactions. However, recent studies have shown that recommendation systems can exhibit bias against certain user groups, leading to unfair recommendations. In this paper, we focus on fairness in recommendation systems from the perspective of user groups. We first propose a novel group fairness metric, which measures the disparity in recommendation quality between advantaged and disadvantaged user groups. Then, we develop a fairness-aware recommendation model, which incorporates the proposed metric into the learning process to mitigate bias. Extensive experiments on real-world datasets demonstrate the effectiveness of our approach in improving group fairness while maintaining overall recommendation performance.},
 abstract_lang = {en},
