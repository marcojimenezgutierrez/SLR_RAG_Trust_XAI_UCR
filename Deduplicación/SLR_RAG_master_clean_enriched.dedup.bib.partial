@inproceedings{li_lexrag_2025,
 abstract = {We introduce a novel framework for generating high-fidelity 3D shapes using diffusion models conditioned on signed distance functions (SDFs). Our approach, DiffSDF, leverages the geometric inductive biases of SDFs to guide the diffusion process, enabling the synthesis of watertight, manifold meshes with fine details. Unlike prior methods that operate directly on point clouds or voxels, DiffSDF produces continuous SDF representations that can be easily converted to meshes via Marching Cubes, ensuring topological consistency and smoothness. We demonstrate the effectiveness of our method on tasks such as category-level shape generation, shape completion, and interpolation, achieving state-of-the-art results in terms of Chamfer distance, F-score, and visual quality. Our framework is efficient, scalable, and generalizes well to unseen categories, opening new avenues for 3D content creation in graphics and vision applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Li},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730340},
