 year = {2025}
}

@book{ogbo-gebhardt_using_2024,
 abstract = {This paper investigates the impact of digital transformation on the demand for skills in the German labor market. Using data from the IAB-BIBB-BAQ survey, we analyze how the adoption of digital technologies affects the skill requirements of occupations. Our findings show that digitalization increases the demand for cognitive and social skills while reducing the need for manual skills. Moreover, we find evidence of skill-biased technological change, where high-skilled workers benefit more from digital advancements. The results have important implications for education and training policies to address skill mismatches in the digital economy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
