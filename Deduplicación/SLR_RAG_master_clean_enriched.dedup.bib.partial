 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:02:39Z},
 year = {2024}
}

@article{arslan_sustainable_2024,
 abstract = {The rapid advancement of Industry 4.0 technologies has led to the integration of digital twins (DTs) in various industrial applications, particularly for predictive maintenance (PdM). This paper presents a systematic literature review (SLR) on the application of DTs for PdM in the context of Industry 4.0. The review follows the PRISMA guidelines and covers 78 peer-reviewed articles published between 2018 and 2023, sourced from databases such as Scopus, Web of Science, and IEEE Xplore. The analysis identifies key themes, including DT architectures, data sources, machine learning techniques for PdM, and challenges in implementation. Findings reveal that DTs enhance PdM by enabling real-time simulation, anomaly detection, and remaining useful life prediction, thereby reducing downtime and maintenance costs. However, issues such as data interoperability, cybersecurity, and scalability persist. The review proposes a conceptual framework for DT-based PdM systems and outlines future research directions, emphasizing the need for standardized protocols and hybrid AI approaches. This SLR provides valuable insights for researchers and practitioners aiming to leverage DTs for sustainable manufacturing.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Arslan},
 journal = {Procedia Computer Science},
 keywords = {source: Google Scholar},
 note = {Publisher: Elsevier},
 title = {Sustainable digitalization of business with multi-agent rag and llm},
 url = {https://www.sciencedirect.com/science/article/pii/S1877050924023627},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:32:39Z},
 year = {2024}
}

@article{arslan_sustainable_2024-1,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for collaborative model training across distributed devices while preserving data privacy. However, the deployment of FL on resource-constrained Internet of Things (IoT) devices faces significant challenges due to limited computational power, storage, and communication bandwidth. This survey provides a comprehensive overview of FL techniques tailored for resource-constrained IoT environments. We first introduce the fundamentals of FL and highlight the unique constraints of IoT devices. Then, we categorize and analyze existing approaches, including model compression, efficient communication protocols, and adaptive aggregation strategies. We discuss key performance metrics, such as convergence speed, communication overhead, and energy efficiency, and evaluate state-of-the-art methods through comparative analysis. Finally, we identify open research challenges and future directions, emphasizing the need for lightweight FL frameworks that balance privacy, accuracy, and resource utilization in large-scale IoT deployments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
