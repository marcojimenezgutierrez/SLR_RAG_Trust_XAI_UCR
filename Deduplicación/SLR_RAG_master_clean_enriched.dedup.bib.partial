@inproceedings{beasley_pipeline_2024,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, they can also generate biased and unfair outputs, which may cause serious social problems. In this survey, we provide a comprehensive overview of bias and fairness in LLMs. We first introduce the background of LLMs and the motivation for studying bias and fairness. Then, we categorize the types of bias in LLMs, including gender bias, racial bias, and political bias. Next, we review the existing methods for detecting and measuring bias in LLMs, such as template-based methods, counterfactual methods, and embedding-based methods. After that, we discuss the techniques for mitigating bias in LLMs, including pre-training, fine-tuning, and decoding strategies. Finally, we point out the challenges and future directions for bias and fairness in LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
