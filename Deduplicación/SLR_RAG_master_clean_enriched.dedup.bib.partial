 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:01:53Z},
 year = {2024}
}

@article{wang_rag-leaks_2025,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for collaborative model training across distributed devices while preserving data privacy. However, the inherent communication overhead and vulnerability to malicious participants pose significant challenges to its practical deployment. To address these issues, we propose a novel framework called FedChain, which integrates blockchain technology with FL to enhance security and efficiency. Specifically, FedChain employs a consortium blockchain to record model updates and participant behaviors, ensuring tamper-proof and verifiable aggregation processes. We design a lightweight consensus mechanism tailored for FL scenarios, reducing communication costs by up to 50% compared to traditional methods. Furthermore, to mitigate the impact of Byzantine attacks, we introduce a reputation-based participant selection strategy that dynamically evaluates trustworthiness based on historical contributions and anomaly detection. Extensive experiments on benchmark datasets demonstrate that FedChain achieves comparable accuracy to state-of-the-art FL algorithms while improving robustness against adversarial attacks and reducing latency in resource-constrained environments. Our work provides a scalable solution for privacy-preserving machine learning in decentralized settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Wang},
 doi = {10.1007/s11432-024-4441-4},
 journal = {Science China Information Sciences},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {6},
 title = {{RAG}},
 url = {https://doi.org/10.1007/s11432-024-4441-4},
 volume = {68},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:39:30Z},
 year = {2025}
}

@inproceedings{wang_rap-gen_2023,
 abstract = {Social media platforms have increasingly become a primary source of news and information, yet they can also foster echo chambers that reinforce users' existing beliefs and potentially amplify misinformation. This paper presents a large-scale analysis of echo chambers on Twitter (now X) during the 2020 U.S. presidential election. Using a novel network-based approach, we identify echo chamber communities and examine their structural properties, user engagement patterns, and the spread of misinformation within them. Our findings reveal that echo chambers are characterized by high homophily and low cross-ideological exposure, leading to polarized discussions and faster dissemination of false information. We discuss implications for platform moderation and algorithmic design to mitigate these effects.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wang},
 booktitle = {Proceedings of the 31st {ACM}},
 doi = {10.1145/3611643.3616256},
