 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:38:15Z},
 year = {2025}
}

@inproceedings{liu_unimel_2024,
 abstract = {Large language models (LLMs) have recently demonstrated impressive capabilities in generating code. However, they often produce code with subtle bugs or that does not fully meet the requirements. To address this, we propose a novel approach that uses LLMs to generate code and then automatically tests it using a set of test cases. If the code fails any test, the LLM is prompted to fix the code. This process is repeated until the code passes all tests or a maximum number of iterations is reached. We evaluate our approach on a benchmark of coding problems and show that it significantly improves the correctness of the generated code. Our approach is simple, requires no additional training, and can be applied to any LLM. We also explore the use of different test case generation strategies and find that using LLM-generated test cases can further improve performance.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Liu},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3627673.3679793},
 isbn = {979-8-4007-0436-9},
 keywords = {large language models},
 note = {event-place: Boise},
 pages = {1909--1919},
 publisher = {Association for Computing Machinery},
 series = {{CIKM}},
 title = {{UniMEL}},
 url = {https://doi.org/10.1145/3627673.3679793},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:29:27Z},
 year = {2024}
}

@inproceedings{liu_webanns_2025,
 abstract = {Generative AI has shown great potential in automating complex tasks, but current systems often struggle with long-term planning and execution in dynamic environments. We introduce Voyager, the first LLM-powered agent that plays Minecraft in a non-stationary environment where environments change dynamically. Voyager consists of three key components: an automatic curriculum to maximize exploration efficiency, an evolving skill library of executable code for reliable task completion, and an iterative prompting mechanism that incorporates environment feedback, execution errors, and self-verification to improve generality. In extensive experiments, Voyager significantly outperforms prior state-of-the-art methods, achieving a 3.3× increase in unique items collected and 15.3× more distance traveled in the Minecraft Overworld. Voyager is the first agent to collect diamonds, craft a diamond pickaxe, and mine a diamond. We also show that Voyager can transfer skills learned in Minecraft to other environments. Code and videos at https://voyager.minedojo.org.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
