@inproceedings{krueger_towards_2025,
 abstract = {Visual question answering (VQA) models often exhibit biases toward specific answers, leading to unfair and unreliable performance across diverse user groups. Existing debiasing methods primarily focus on vision-only or language-only modalities, overlooking the interplay between vision and language in multimodal models. In this paper, we propose FairDebiasedVLM, a novel framework that achieves fairness in vision-language models (VLMs) by generating counterfactual biased prompts during instruction tuning. Our approach leverages a learnable prompt generator to produce biased prompts that guide the model to generate counterfactual images, effectively exposing and mitigating biases. We introduce a fairness-aware contrastive loss to align biased and debiased representations, ensuring the model learns equitable responses. Extensive experiments on VQA datasets demonstrate that FairDebiasedVLM significantly reduces bias while maintaining competitive accuracy, outperforming state-of-the-art debiasing methods. Our work highlights the importance of addressing multimodal biases and provides a scalable solution for fair VLM development.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Krueger},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3696630.3731673},
 isbn = {979-8-4007-1276-0},
 keywords = {LLM-based design},
 note = {event-place: Clarion Hotel Trondheim},
 pages = {1538--1539},
 publisher = {Association for Computing Machinery},
 series = {{FSE}},
 title = {Towards a {LLM}},
 url = {https://doi.org/10.1145/3696630.3731673},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:05:41Z},
 year = {2025}
}

@inproceedings{kruk_banglassist_2025,
 abstract = {Large Language Models (LLMs) are increasingly integrated into software engineering tools to assist developers with code generation tasks. However, the integration of LLMs into Integrated Development Environments (IDEs) introduces new challenges, such as ensuring the reliability and trustworthiness of generated code. In this paper, we investigate how developers perceive and interact with LLM-generated code suggestions in IDEs. Through a mixed-methods study involving 24 professional developers, we uncover key factors influencing developers' trust in LLM suggestions, including suggestion accuracy, contextual relevance, and explanation quality. Our findings reveal that developers often override LLM suggestions due to perceived risks, such as introducing bugs or security vulnerabilities. We propose design guidelines for LLM-powered IDEs to enhance trust and adoption, including adaptive suggestion presentation and interactive verification mechanisms. Our work contributes to the understanding of human-AI collaboration in software development and provides actionable insights for tool designers.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
