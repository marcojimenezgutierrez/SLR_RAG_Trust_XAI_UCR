 keywords = {large language models},
 note = {event-place: World Trade Center},
 pages = {7--12},
 publisher = {Association for Computing Machinery},
 series = {{EdgeSys}},
 title = {{SELLMA}},
 url = {https://doi.org/10.1145/3721888.3722091},
 x_enrich_source = {x-ai/grok-4-fast},
