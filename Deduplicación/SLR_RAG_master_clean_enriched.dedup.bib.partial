@inproceedings{shi_scalable_2025,
 abstract = {This paper introduces HapticsCanvas, a web-based toolkit that enables creators without haptic expertise to design and prototype wearable haptic experiences. HapticsCanvas provides a visual programming interface with modular building blocks for defining haptic patterns, spatial mappings, and interaction triggers. It supports real-time preview on a variety of simulated wearables and exports designs to common haptic hardware APIs. Through a series of workshops with 20 creators, we found that HapticsCanvas lowers barriers to entry, fosters creativity, and supports iterative design, while highlighting opportunities for future enhancements in multi-modal integration and accessibility.},
 abstract_lang = {en},
