@inproceedings{petruzzelli_recommending_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but evaluating and comparing their outputs remains challenging. Practitioners often rely on manual inspection or aggregate metrics, which can miss nuanced differences across models. We present LLM Comparator, a visual analytics system that enables side-by-side comparison of responses from multiple LLMs. Our system supports interactive exploration of model outputs through coordinated visualizations, including response trees, similarity heatmaps, and performance dashboards. Users can query LLMs in real-time, filter results by criteria, and drill down into specific examples to understand model behaviors, biases, and strengths. We conducted a qualitative evaluation with AI researchers and developers, who found LLM Comparator effective for tasks such as model selection, debugging, and hypothesis testing. By bridging quantitative metrics with qualitative insights, LLM Comparator facilitates more informed decision-making in LLM development and deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Petruzzelli},
 booktitle = {Proceedings of the 18th {ACM}},
 doi = {10.1145/3640457.3688193},
