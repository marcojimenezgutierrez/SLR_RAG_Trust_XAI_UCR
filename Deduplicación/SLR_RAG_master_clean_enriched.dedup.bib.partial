@article{zhu_multimodal_2025,
 abstract = {Objective The purpose of this article is to review the current applications of artificial intelligence (AI) in breast imaging, including screening, diagnostic evaluation, and interventional procedures, and to discuss future directions and challenges. Conclusion AI has the potential to improve the efficiency and accuracy of breast imaging interpretations while reducing radiologist workload. However, challenges such as data privacy, algorithmic bias, and regulatory approval must be addressed to ensure safe and equitable implementation in clinical practice.},
