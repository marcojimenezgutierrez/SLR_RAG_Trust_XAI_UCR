 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:11:24Z},
 year = {2024}
}

@inproceedings{ju_task-classifying_2025,
 abstract = {Artificial Intelligence (AI) has revolutionized various domains, including big data analytics. This paper explores the integration of AI techniques in processing and analyzing large-scale datasets from the ICAIBD 2025 conference. We propose a novel framework that combines deep learning models with distributed computing to enhance efficiency and accuracy in big data handling. Experimental results demonstrate significant improvements in processing speed and predictive performance compared to traditional methods. The framework is evaluated on real-world datasets, showcasing its scalability and robustness.},
