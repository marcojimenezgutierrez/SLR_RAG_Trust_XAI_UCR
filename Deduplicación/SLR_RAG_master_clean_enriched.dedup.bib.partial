@article{bui_rambo_2024,
 abstract = {Generalist robot policies that can solve a wide range of tasks are a promising paradigm for robot learning. However, existing approaches to learning such policies have been limited to narrow task distributions, and often require large amounts of data or compute. In this work, we investigate what factors contribute to the success of generalist robot policies. We study a range of design choices, including the choice of data, model architecture, training objectives, and evaluation protocols. Our findings suggest that while data quality and diversity are important, the choice of model architecture and training objectives play a more significant role in enabling generalization. We also introduce a new benchmark for evaluating generalist robot policies, which we call RoboSuite Generalist, consisting of 10 diverse manipulation tasks. Our results provide insights into the key ingredients for building generalist robot policies and highlight the need for better benchmarks to drive progress in this area.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Bui},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Rambo: {Enhancing}},
 url = {https://arxiv.org/abs/2409.15204},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:00:21Z},
 year = {2024}
}

@article{bui_systematic_2024,
 abstract = {We explore the capabilities of Large Language Models (LLMs) to assist or substitute devices (i.e., firewalls) and humans (i.e., security experts) respectively in the detection and analysis of security incidents. We leverage transformer-based technologies, from relatively small to foundational sizes, to address the problem of correctly identifying the attack severity (and accessorily identifying and explaining the attack type). We contrast a broad range of LLM techniques (prompting, retrieval augmented generation, and fine-tuning of several models) using state-of-the-art machine learning models as a baseline. Using proprietary data from commercial deployment, our study provides an unbiased picture of the strengths and weaknesses of LLM for intrusion detection.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Bui},
 doi = {10.1145/3696379},
 journal = {Proc. ACM Netw.},
 keywords = {computing methodologies},
