 x_enrich_ts = {2025-11-02T07:30:14Z},
 year = {2025}
}

@inproceedings{ugarte_astral_2025,
 abstract = {In this paper, we investigate the design and evaluation of a novel haptic feedback system for virtual reality (VR) environments aimed at enhancing user immersion and interaction fidelity. Our approach integrates multi-modal haptic rendering with adaptive force feedback algorithms to simulate realistic tactile sensations in complex virtual scenarios. Through a series of user studies involving 48 participants, we demonstrate significant improvements in task performance, spatial awareness, and overall user satisfaction compared to traditional VR systems. The findings contribute to the broader field of human-computer interaction by providing insights into the role of haptics in mitigating sensory conflicts and reducing cybersickness. We discuss implications for applications in training simulations, gaming, and therapeutic interventions, along with future directions for scalable haptic integration in consumer-grade VR hardware.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
