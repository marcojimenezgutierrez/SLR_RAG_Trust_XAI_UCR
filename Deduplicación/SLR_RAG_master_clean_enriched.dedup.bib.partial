}

@article{dayarathne_comparing_2025,
 abstract = {This chapter proposes a novel framework for detecting phishing websites using machine learning techniques. Phishing attacks have become increasingly sophisticated, posing significant threats to online security. Traditional methods often rely on blacklists or rule-based systems, which are limited in handling dynamic and evolving attack patterns. Our approach leverages a combination of feature extraction from URL, webpage content, and network characteristics, followed by classification using ensemble learning models such as Random Forest and XGBoost. The proposed system achieves high accuracy, with an F1-score of 98.5% on a benchmark dataset comprising legitimate and phishing sites. Experimental results demonstrate the framework's robustness against obfuscation techniques commonly used by attackers. This work contributes to enhancing web security by providing a scalable and adaptive solution for real-time phishing detection.},
