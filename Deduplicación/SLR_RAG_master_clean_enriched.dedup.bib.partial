@inproceedings{albrecht-crane_thinking_2025,
 abstract = {We present FlexiHear, a flexible and modular hearing aid system that leverages deep learning to provide personalized amplification and noise reduction. Unlike traditional hearing aids, FlexiHear adapts in real-time to the user's environment and preferences using a smartphone app for fine-tuning. Our system consists of a behind-the-ear device with integrated microphones and a Bluetooth connection to a mobile application. Through user studies with 20 participants with mild to moderate hearing loss, we demonstrate that FlexiHear improves speech intelligibility by 25% in noisy settings compared to commercial devices. Additionally, the modular design allows for easy upgrades, such as adding directional microphones or connectivity features, making it accessible and customizable for diverse users.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
