@inproceedings{wu_multirag_2025,
 abstract = {The rapid growth of graph data has led to the development of various graph neural network (GNN) models for tasks such as node classification and link prediction. However, existing GNNs often struggle with scalability on large-scale graphs due to high computational costs. In this paper, we propose a novel scalable GNN framework called ScaleGNN, which leverages graph sampling and approximation techniques to reduce complexity while maintaining accuracy. Our approach combines random walk-based sampling with low-rank matrix factorization for efficient message passing. Extensive experiments on real-world datasets demonstrate that ScaleGNN achieves up to 10x speedup compared to state-of-the-art methods with minimal performance degradation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
