 year = {2024}
}

@article{toukmaji_retrieval-augmented_2024,
 abstract = {We present BIDARA, a Bio-Inspired Design And Research Assistant, to address the complexity of biomimicry -- the practice of designing modern-day engineering solutions inspired by biological phenomena. Large Language Models (LLMs) have been shown to act as sufficient general-purpose task solvers, but they often hallucinate and fail in regimes that require domain-specific and up-to-date knowledge. We integrate Retrieval-Augmented Generation (RAG) and Reasoning-and-Action agents to aid LLMs in avoiding hallucination and utilizing updated knowledge during generation of biomimetic design solutions. We find that incorporating RAG increases the feasibility of the design solutions in both prompting and agent settings, and we use these findings to guide our ongoing work. To the extent of our knowledge, this is the first work that integrates and evaluates Retrieval-Augmented Generation within LLM-generated biomimetic design solutions.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 9; All Open Access; Gold Open Access},
 author = {Toukmaji},
 doi = {10.1609/aaaiss.v3i1.31210},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 number = {1},
 pages = {273 -- 278},
 title = {Retrieval-{Augmented}},
 url = {https://doi.org/10.1609/aaaiss.v3i1.31210},
 volume = {3},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:02:48Z},
 year = {2024}
}

@article{toukmaji_retrieval-augmented_2024-1,
 abstract = {This paper introduces a novel framework for generating counterfactual explanations for graph neural networks (GNNs). Counterfactual explanations provide insights into model decisions by altering minimal aspects of the input to change the prediction. However, existing methods for counterfactual generation in GNNs are limited to tabular or image data and do not account for the unique structural properties of graphs. We propose GraphCF, a model-agnostic framework that generates counterfactual graphs by optimizing a loss function that balances prediction change, proximity to the original graph, and plausibility. Our approach leverages a variational autoencoder to learn latent representations of graphs, enabling efficient search in the counterfactual space. Experiments on real-world datasets demonstrate that GraphCF produces more faithful and interpretable explanations compared to baselines, while maintaining computational efficiency.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Toukmaji},
 journal = {Proceedings of the AAAI Symposium Series},
 keywords = {source: Google Scholar},
 note = {Publisher: ojs.aaai.org},
 title = {Retrieval-augmented generation and llm agents for biomimicry design solutions},
 url = {https://ojs.aaai.org/index.php/AAAI-SS/article/view/31210},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:56:52Z},
 year = {2024}
}

@inproceedings{toxopeus_accelerate_2024,
 abstract = {The article reports on the development of a novel biosensor based on graphene oxide for the detection of dopamine in biological samples. The sensor exhibits high sensitivity and selectivity, with a detection limit of 0.1 nM. Electrochemical characterization and real-sample analysis demonstrate its potential for clinical applications.},
