@article{mullins_enhancing_2024,
 abstract = {Visual programming languages (VPLs) allow users to create programs by manipulating visual elements rather than writing text-based code. Despite their promise, VPLs have not achieved widespread adoption. We hypothesize that one reason is the lack of systematic exploration of the design space of VPLs. To address this, we conducted a systematic literature review of 68 VPLs and developed a design space analysis framework. Our framework identifies key design dimensions, including representation (e.g., blocks, nodes), interaction (e.g., drag-and-drop, direct manipulation), and semantics (e.g., dataflow, control flow). We use this framework to analyze existing VPLs and identify opportunities for innovation, such as hybrid representations and adaptive interfaces. Our findings provide a foundation for designing more effective VPLs and highlight areas for future research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Mullins},
 doi = {10.1145/3686852.3687083},
 journal = {Proceedings of the 25th …},
 keywords = {source: Google Scholar},
 note = {Publisher: dl.acm.org},
 title = {Enhancing classroom teaching with {LLMs}},
 url = {https://doi.org/10.1145/3686852.3687083},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:29:34Z},
 year = {2024}
}

@article{muludi_retrieval-augmented_2024,
 abstract = {This study examines the integration of artificial intelligence (AI) technologies in academic libraries, focusing on their impact on information retrieval and user services. Through a mixed-methods approach, including surveys of 200 librarians and case studies from five U.S. universities, the research identifies key benefits such as enhanced search accuracy and personalized recommendations, alongside challenges like data privacy concerns and skill gaps among staff. Findings suggest that AI adoption can significantly improve library efficiency, but requires robust training programs and ethical frameworks to mitigate risks. The paper concludes with recommendations for sustainable AI implementation in library settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
