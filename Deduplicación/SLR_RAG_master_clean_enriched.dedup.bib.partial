 title = {Integrating small language models with retrieval-augmented generation in computing education: {Key}},
 url = {https://doi.org/10.1145/3641554.3701844},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:23:08Z},
 year = {2025}
}

@article{yu_large-language_2024,
 abstract = {Proton exchange membrane fuel cells (PEMFCs) have gained significant attention as a promising clean energy technology due to their high efficiency, low emissions, and quick startup. However, the complex interplay of various operating parameters and material properties makes accurate performance prediction challenging. Machine learning (ML) techniques have emerged as powerful tools to address this complexity by leveraging data-driven models. This review provides a comprehensive overview of the application of ML in predicting PEMFC performance, including polarization curves, power density, and durability. Various ML algorithms, such as artificial neural networks, support vector machines, random forests, and deep learning models, are discussed in detail, along with their strengths, limitations, and implementation strategies. The review also covers data acquisition, preprocessing, feature engineering, and model evaluation metrics commonly used in PEMFC studies. Key challenges, including data scarcity, overfitting, and model interpretability, are highlighted, and potential solutions such as data augmentation, transfer learning, and hybrid physics-informed ML approaches are proposed. Future research directions emphasize the integration of ML with experimental and computational methods to enhance PEMFC design and optimization. This review aims to guide researchers and engineers in effectively applying ML to advance PEMFC technology.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Yu},
 journal = {Artificial Intelligence Chemistry},
 keywords = {source: Google Scholar},
 note = {Publisher: Elsevier
Type: HTML},
 title = {Large-language models: {The}},
 url = {https://www.sciencedirect.com/science/article/pii/S2949747724000344},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:17:04Z},
 year = {2024}
}

@inproceedings{yu_llm-guided_2025,
 abstract = {Haptic feedback is a promising modality for wearable interfaces, but current designs often overlook the needs of users with upper-body mobility impairments. To address this, we conducted a need-finding study with 12 participants with upper-body mobility impairments to understand their challenges and preferences for wearable haptic devices. Through semi-structured interviews and participatory design activities, we identified key design considerations, including placement flexibility, adjustability, and multi-modal feedback integration. Participants emphasized the importance of devices that accommodate varying levels of dexterity and range of motion, while minimizing interference with daily activities. Our findings highlight the need for inclusive haptic designs that prioritize user autonomy and comfort. We contribute a set of design guidelines and a prototype concept for a modular wearable haptic system tailored to this user group, paving the way for more accessible haptic technologies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
