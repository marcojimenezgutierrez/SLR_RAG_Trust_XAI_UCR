}

@inproceedings{li_learning_2024,
 abstract = {Vision-language models (VLMs) have shown remarkable success in various vision tasks. However, they often suffer from biases inherited from their training data, leading to unfair predictions for certain demographic groups. Existing debiasing methods for VLMs are limited in effectiveness or require access to the model's parameters, which is impractical for large-scale proprietary models. In this paper, we propose a novel prompt-based debiasing approach that does not require model fine-tuning or access to internal parameters. Our method, termed BiasedPrompt, generates counterfactual prompts by inverting the biased attributes in the original prompt, thereby encouraging the model to focus on the target attribute while mitigating bias. We evaluate BiasedPrompt on multiple VLM benchmarks, including fairness-oriented datasets, and demonstrate significant improvements in fairness metrics (e.g., demographic parity) while maintaining competitive performance on standard tasks. Our approach is simple, efficient, and applicable to black-box VLMs, making it a practical solution for real-world deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Li},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3589334.3645408},
 isbn = {979-8-4007-0171-9},
 keywords = {large language models},
 note = {event-place: Singapore},
 pages = {3367--3378},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {Learning to {Rewrite}},
 url = {https://doi.org/10.1145/3589334.3645408},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:19:00Z},
 year = {2024}
}

@inproceedings{li_leveraging_2024,
 abstract = {Vision-language models (VLMs) have achieved remarkable success in various vision tasks. However, they can inherit or even amplify societal biases from the training data, leading to unfair or harmful predictions. Existing debiasing methods for VLMs are limited in effectiveness or generalizability. In this paper, we propose a simple yet effective debiasing method, Biased Prompts (BP), which leverages the power of prompts to mitigate biases in VLMs. BP generates biased prompts that counteract the inherent biases in the model, guiding it to produce fairer outputs. We evaluate BP on multiple datasets and tasks, demonstrating significant improvements in fairness metrics while maintaining high accuracy. Our approach is model-agnostic and requires no fine-tuning, making it practical for real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
