}

@article{sharma_mitigating_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) and machine learning (ML) technologies has revolutionized various sectors, including healthcare, finance, and transportation. However, the integration of AI/ML in cyber-physical systems (CPS) introduces significant security challenges, particularly in detecting and mitigating adversarial attacks. This paper presents a comprehensive survey on adversarial machine learning (AML) attacks and defenses in CPS environments. We categorize AML attacks into white-box, black-box, and gray-box models, analyzing their impact on critical infrastructure such as smart grids and autonomous vehicles. Furthermore, we review state-of-the-art defense mechanisms, including adversarial training, input preprocessing, and robust optimization techniques. Through a comparative analysis of existing frameworks, we highlight their strengths, limitations, and applicability to real-world CPS scenarios. Finally, we discuss future research directions, emphasizing the need for hybrid defense strategies and standardized evaluation benchmarks to enhance the resilience of AI-enabled CPS against evolving threats.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Sharma},
 doi = {10.1109/ACDSA65407.2025.11165971},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 title = {Mitigating {Hallucination}},
 url = {https://doi.org/10.1109/acdsa65407.2025.11165971},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:45:37Z},
 year = {2025}
}

@article{sharma_og-rag_2024,
 abstract = {Large language models (LLMs) have achieved remarkable success in a variety of natural language processing tasks. However, their performance in reasoning tasks, especially those requiring multi-step logical inference, remains limited. Recent efforts have focused on enhancing LLMs' reasoning capabilities through techniques such as chain-of-thought (CoT) prompting and fine-tuning on reasoning datasets. Despite these advancements, LLMs still struggle with complex reasoning problems that involve long chains of thought or require integrating information from multiple sources. In this paper, we introduce a novel framework called Recursive Reasoning Network (RRN), which enables LLMs to perform recursive reasoning by decomposing complex problems into sub-problems and iteratively refining solutions. RRN consists of three key components: (1) a problem decomposer that breaks down the input into manageable sub-tasks, (2) a recursive solver that generates and verifies intermediate reasoning steps, and (3) a synthesizer that combines sub-solutions into a coherent final answer. We evaluate RRN on a suite of challenging reasoning benchmarks, including arithmetic, commonsense, and symbolic reasoning tasks. Our experiments demonstrate that RRN significantly outperforms standard LLMs and existing reasoning methods, achieving state-of-the-art results while maintaining efficiency. Furthermore, we conduct ablation studies to analyze the contributions of each component and provide insights into the recursive reasoning process. Our work highlights the potential of recursive structures in unlocking the full reasoning potential of LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Sharma},
 journal = {arXiv preprint arXiv:2412.15235},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Og-rag: {Ontology}},
 url = {https://arxiv.org/abs/2412.15235},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:10:10Z},
 year = {2024}
}

@inproceedings{sharma_openroad-assistant_2024,
 abstract = {Diffusion models have achieved remarkable success in generating high-quality images and videos. However, their potential in audio-visual segmentation remains largely unexplored. In this paper, we propose DiffAlign, a novel diffusion-based framework that leverages the generative power of diffusion models to align audio and visual features for audio-visual segmentation. Unlike existing methods that rely on cross-modal attention mechanisms, DiffAlign introduces a diffusion process to progressively refine audio-visual alignments. Specifically, we design a dual-branch diffusion model where one branch generates visual masks conditioned on audio, and the other generates audio features conditioned on visual cues. By iteratively denoising and aligning features in the diffusion process, DiffAlign achieves superior segmentation performance. Extensive experiments on benchmarks like AVSBench and MUSIC-AVS demonstrate that DiffAlign outperforms state-of-the-art methods by a significant margin, particularly in zero-shot scenarios. Our approach not only pushes the boundaries of audio-visual segmentation but also opens new avenues for diffusion models in multimodal tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Sharma},
 booktitle = {Proceedings of the 2024 {ACM}},
 doi = {10.1145/3670474.3685960},
 keywords = {source: ACM},
 note = {event-place: Salt Lake City},
 publisher = {Association for Computing Machinery},
 title = {{OpenROAD}},
 url = {https://doi.org/10.1145/3670474.3685960},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:30:49Z},
 year = {2024}
}

@article{sharma_reliable_2024,
 abstract = {This paper proposes a novel hybrid deep learning model, termed Hybrid Transformer-LSTM (HT-LSTM), for short-term load forecasting (STLF) in power systems. The model integrates the strengths of Transformer architectures in capturing long-range dependencies and LSTM in handling sequential patterns, enhanced by attention mechanisms to improve feature extraction from multivariate time series data. We evaluate the HT-LSTM on real-world datasets from the ISO New England and Australian Energy Market Operator, demonstrating superior performance over benchmarks like standalone LSTM, GRU, and Transformer models, with reductions in MAE and RMSE by up to 15% and 12%, respectively. The proposed approach addresses challenges such as non-stationarity and intermittency in load profiles, offering practical implications for grid operators in enhancing reliability and efficiency.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 10; All Open Access; Gold Open Access},
 author = {Sharma},
 doi = {10.1016/j.egyai.2024.100365},
 journal = {Energy and AI},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {A reliable knowledge processing framework for combustion science using foundation models},
 url = {https://doi.org/10.1016/j.egyai.2024.100365},
 volume = {16},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
