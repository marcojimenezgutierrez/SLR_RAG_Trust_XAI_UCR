@article{patel_llm-based_2025,
 abstract = {In this paper, we propose a novel framework for anomaly detection in multivariate time series data using graph neural networks (GNNs). Traditional methods often struggle with capturing complex dependencies and spatial-temporal correlations in such data. Our approach models the time series as a dynamic graph where nodes represent variables and edges capture their relationships, evolving over time. We employ a GNN architecture combined with attention mechanisms to learn representations that highlight anomalous patterns. Experiments on benchmark datasets demonstrate that our method outperforms state-of-the-art baselines in terms of precision, recall, and F1-score, particularly in scenarios with high-dimensional and noisy data.},
 abstract_lang = {en},
