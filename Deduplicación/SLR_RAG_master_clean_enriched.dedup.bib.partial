@inproceedings{rashedul_hasan_muse_2025,
 abstract = {This paper presents a novel approach to adaptive federated learning in heterogeneous environments. We introduce HeteroFed, a framework that dynamically adjusts model aggregation based on device heterogeneity, including computational power, data distribution, and network conditions. By incorporating a meta-learning module to predict optimal aggregation weights, HeteroFed achieves up to 25% improvement in accuracy over standard FedAvg on non-IID datasets. Extensive experiments on real-world benchmarks demonstrate its robustness and efficiency in edge computing scenarios.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
