@article{wang_ms-rag_2025,
 abstract = {This paper proposes a novel framework for enhancing cybersecurity in IoT ecosystems using machine learning techniques. We address the challenges of real-time threat detection and response by integrating federated learning with blockchain for secure data sharing. Experimental results on benchmark datasets demonstrate a 25% improvement in detection accuracy compared to traditional methods. The framework is evaluated in simulated IoT environments, showing robustness against adversarial attacks. Future work includes deployment on edge devices for practical applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
