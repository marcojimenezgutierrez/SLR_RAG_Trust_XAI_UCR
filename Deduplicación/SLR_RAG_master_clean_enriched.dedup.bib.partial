@inproceedings{rajesh_learn_2024,
 abstract = {This paper proposes a novel framework for enhancing student engagement in online learning environments through gamified adaptive assessments. We integrate machine learning algorithms to personalize quiz difficulty and provide real-time feedback, drawing on data from over 500 participants in a controlled study. Results indicate a 25% improvement in retention rates and higher motivation scores compared to traditional methods. The system employs reinforcement learning to optimize content delivery, ensuring scalability for large-scale educational platforms. Future work will explore integration with virtual reality for immersive experiences.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
