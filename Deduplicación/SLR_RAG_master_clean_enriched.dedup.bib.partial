@inproceedings{kuchenbuch_smart_2025,
 abstract = {Personal fabrication tools, such as 3D printers and laser cutters, have become increasingly accessible, enabling children to create physical artifacts. However, designing effective personal fabrication experiences for children remains challenging due to their unique developmental needs and the complexity of fabrication technologies. In this paper, we explore the design space of personal fabrication for children through a systematic review of 45 existing systems and a series of design workshops with 20 children aged 7-12. We identify key design dimensions, including tool accessibility, creative expression, and learning outcomes, and propose a framework to guide future designs. Our findings highlight the importance of integrating playfulness, scaffolding, and social interaction to foster children's engagement and skill development in personal fabrication.},
