 x_enrich_ts = {2025-11-02T07:31:53Z},
 year = {2025}
}

@inproceedings{platis_lion_2024,
 abstract = {Recent advances in large language models (LLMs) have shown impressive capabilities in generating fluent and coherent text. However, their performance on long-context tasks remains underexplored. In this paper, we conduct a systematic study of how LLMs utilize long contexts. Specifically, we design a long-context benchmark based on the multi-hop question answering task, where the relevant information is placed at different positions in the context. Our experiments reveal that LLMs exhibit a "lost in the middle" phenomenon: they perform better when relevant information is at the beginning or end of the context, but struggle when it is in the middle. We further analyze this phenomenon and find that it is not due to the position bias in the attention mechanism, but rather the model's inability to effectively integrate information from the middle of long contexts. Our findings highlight the need for improved long-context understanding in LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Platis},
 booktitle = {Companion {Proceedings}},
