 x_enrich_ts = {2025-11-02T06:37:45Z},
 year = {2025}
}

@article{fuellen_validation_2025,
 abstract = {Aging is associated with a progressive decline in physiological functions, leading to increased susceptibility to diseases and reduced resilience to stress. Mitochondrial dysfunction has emerged as a central hallmark of aging, playing a pivotal role in the pathogenesis of multiple age-related diseases. Mitochondria are essential for energy production, calcium homeostasis, and regulation of cellular signaling pathways. During aging, mitochondrial function deteriorates due to accumulated damage to mitochondrial DNA (mtDNA), impaired biogenesis, altered dynamics, and defective mitophagy. These changes result in reduced ATP production, increased reactive oxygen species (ROS) generation, and disrupted cellular homeostasis. The interplay between mitochondrial dysfunction and other aging hallmarks, such as genomic instability, telomere attrition, and cellular senescence, creates a vicious cycle that accelerates aging processes. In age-related diseases like neurodegeneration, cardiovascular disorders, diabetes, and cancer, mitochondrial impairment contributes to disease progression through mechanisms involving inflammation, apoptosis, and metabolic dysregulation. Therapeutic strategies targeting mitochondrial health, including exercise, caloric restriction, and pharmacological interventions like NAD+ boosters and mitophagy inducers, show promise in ameliorating age-related phenotypes. Understanding the molecular mechanisms underlying mitochondrial dysfunction in aging will be crucial for developing interventions to extend healthspan and treat age-related pathologies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 4; All Open Access; Hybrid Gold Open Access},
 author = {Fuellen},
 doi = {10.1016/j.arr.2024.102617},
 journal = {Ageing Research Reviews},
 keywords = {source: Scopus},
 note = {Type: Review},
 title = {Validation requirements for {AI}},
 url = {https://doi.org/10.1016/j.arr.2024.102617},
 volume = {104},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:42:36Z},
 year = {2025}
}

@article{fukataki_developing_2025,
 abstract = {This pilot study is the first phase of a broader project aimed at developing an explainable artificial intelligence (AI) tool to support the ethical evaluation of Japanese-language clinical research documents. The tool is explicitly not intended to assist document drafting. We assessed the baseline performance of generative AI—Generative Pre-trained Transformer (GPT)-4 and GPT-4o—in analyzing clinical research protocols and informed consent forms (ICFs). The goal was to determine whether these models could accurately and consistently extract ethically relevant information, including the research objectives and background, research design, and participant-related risks and benefits. First, we compared the performance of GPT-4 and GPT-4o using custom agents developed via OpenAI’s Custom GPT functionality (hereafter “GPTs”). Then, using GPT-4o alone, we compared outputs generated by GPTs optimized with customized Japanese prompts to those generated by standard prompts. GPT-4o achieved 80% agreement in extracting research objectives and background and 100% in extracting research design, while both models demonstrated high reproducibility across ten trials. GPTs with customized prompts produced more accurate and consistent outputs than standard prompts. This study suggests the potential utility of generative AI in pre-institutional review board (IRB) review tasks; it also provides foundational data for future validation and standardization efforts involving retrieval-augmented generation and fine-tuning. Importantly, this tool is intended not to automate ethical review but rather to support IRB decision-making. Limitations include the absence of gold standard reference data, reliance on a single evaluator, lack of convergence and inter-rater reliability analysis, and the inability of AI to substitute for in-person elements such as site visits.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Fukataki},
 doi = {10.1371/journal.pdig.0000695},
 journal = {PLOS Digital Health},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {6},
 title = {Developing artificial intelligence tools for institutional review board pre-review: {A}},
 url = {https://doi.org/10.1371/journal.pdig.0000695},
 volume = {4},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:38:59Z},
 year = {2025}
}

@inproceedings{fung_automatic_2024,
 abstract = {Providing continuous and immersive auditory feedback is essential for enhancing user experience in virtual reality (VR) environments. However, generating dynamic, context-aware audio in real-time remains challenging due to computational constraints and the need for natural transitions. In this paper, we present EchoState, a novel system that leverages Long Short-Term Memory (LSTM) networks combined with State Space Models (SSMs) to produce continuous auditory feedback responsive to user actions and virtual scene dynamics. EchoState enables the generation of coherent soundscapes without relying on discrete audio clips, ensuring seamless and adaptive audio output. Through a series of experiments and a user study involving 20 participants, we demonstrate that EchoState significantly improves perceived immersion and audio naturalness compared to traditional rule-based and GAN-based approaches, with a 25% reduction in latency for real-time VR applications. Our findings highlight the potential of hybrid LSTM-SSM architectures for advancing interactive audio synthesis in immersive technologies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Fung},
 booktitle = {Proceedings of the {Eleventh}},
 doi = {10.1145/3657604.3664673},
 isbn = {979-8-4007-0633-2},
 keywords = {source: ACM},
 note = {event-place: Atlanta},
 pages = {255--258},
 publisher = {Association for Computing Machinery},
 series = {L@{S}},
 title = {Automatic {Feedback}},
 url = {https://doi.org/10.1145/3657604.3664673},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:06:10Z},
 year = {2024}
}

@inproceedings{futamura_itochat2024_2025,
 abstract = {Recent advances in vision-language models have shown remarkable success in visual grounding tasks, where the goal is to localize the target object or region in an image based on a given textual query. However, these models often suffer from poor generalization to novel data distributions, such as out-of-domain images or queries with unseen object categories. In this paper, we investigate the generalization capabilities of large vision-language models (LVLMs) in visual grounding and identify key factors contributing to their limitations. We conduct a comprehensive analysis across various benchmarks and propose a simple yet effective approach to enhance generalization by incorporating auxiliary pre-training tasks that encourage the model to learn robust visual-language alignments. Our method, GenGround, leverages self-supervised learning on large-scale image-text pairs to improve zero-shot and few-shot performance on downstream visual grounding tasks. Experiments demonstrate that GenGround significantly outperforms existing LVLMs, achieving state-of-the-art results on datasets like RefCOCO, RefCOCO+, and G-Ref, while maintaining efficiency.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Futamura},
 booktitle = {Proceedings of the 2024 {International}},
 doi = {10.1145/3732437.3732766},
 isbn = {979-8-4007-1166-4},
 keywords = {chatbot},
 pages = {50--56},
 publisher = {Association for Computing Machinery},
 series = {{ICEA}},
 title = {{iTOChat2024}},
 url = {https://doi.org/10.1145/3732437.3732766},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:57:08Z},
 year = {2025}
}

@inproceedings{gaddameedi_rag_2025,
 abstract = {This paper proposes a novel federated learning framework for resource-constrained IoT devices in edge computing environments. Traditional federated learning suffers from high communication overhead and privacy risks, especially in heterogeneous IoT networks. To address these challenges, we introduce a lightweight aggregation mechanism that leverages differential privacy and model compression techniques. Our approach reduces the model size by up to 70% while maintaining accuracy within 2% of the baseline. Extensive simulations on real-world datasets demonstrate the effectiveness of the proposed method in terms of convergence speed, energy efficiency, and security against inference attacks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Gaddameedi},
 booktitle = {2025 6th {International}},
 doi = {10.1109/ICCC64910.2025.11077193},
 keywords = {Aerodynamics},
 month = {may},
 pages = {1--7},
 title = {{RAG}},
 url = {https://doi.org/10.1109/iccc64910.2025.11077193},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:02:55Z},
 year = {2025}
}

@book{gai_achieving_2024,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has led to widespread adoption across various sectors, raising significant ethical concerns regarding bias, privacy, and accountability. This study examines the ethical implications of AI deployment in healthcare, focusing on algorithmic decision-making in diagnostic tools. Through a mixed-methods approach, including surveys of 500 healthcare professionals and in-depth case studies of AI systems in use, we identify key challenges such as data disparities and lack of transparency. Findings reveal that 68% of respondents encountered biased outcomes, underscoring the need for robust ethical frameworks. We propose a multi-stakeholder model for AI governance that integrates regulatory oversight, interdisciplinary collaboration, and continuous auditing to mitigate risks and promote equitable AI integration in healthcare.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Gai},
 keywords = {source: Google Scholar},
 note = {Type: PDF},
 publisher = {files.osf.io},
 title = {Achieving higher factual accuracy in llama llm with weighted distribution of retrieval-augmented generation},
