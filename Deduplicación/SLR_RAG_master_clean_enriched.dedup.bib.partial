@article{pelletier_explainable_2024,
 abstract = {Generalist robot policies that can solve a wide variety of tasks are a promising paradigm for robot learning. However, existing methods for training such policies rely on a combination of simulation and real-world data, which is expensive to collect and often leads to policies that overfit to the data distribution. In this work, we investigate what factors are important for building generalist robot policies. We conduct a series of experiments on a set of simulated manipulation tasks and find that: (1) the choice of action space is critical for generalization; (2) policies trained with a mixture of diverse tasks generalize better than those trained on a single task; (3) increasing the amount of training data improves performance, but the gains diminish after a certain point; and (4) the use of hierarchical policies can improve generalization to novel tasks. Our findings provide insights into the design of generalist robot policies and suggest directions for future research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Pelletier},
 journal = {arXiv preprint arXiv …},
