@article{panagoulias_lyricel_2025,
 abstract = {This paper proposes a novel federated learning framework for privacy-preserving edge computing in IoT networks. Traditional centralized machine learning approaches face significant challenges in handling distributed data due to privacy concerns and communication overhead. Our framework leverages differential privacy mechanisms integrated with secure multi-party computation to enable collaborative model training across edge devices without sharing raw data. Extensive simulations on real-world IoT datasets demonstrate that the proposed method achieves up to 25% improvement in model accuracy compared to baseline federated learning techniques, while maintaining strong privacy guarantees measured by epsilon-differential privacy bounds. The approach is particularly suited for resource-constrained environments, reducing latency by 40% through optimized aggregation protocols.},
