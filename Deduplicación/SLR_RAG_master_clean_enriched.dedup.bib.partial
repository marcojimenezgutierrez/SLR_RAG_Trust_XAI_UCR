}

@inproceedings{yamanishi_tourmllm_2025,
 abstract = {Visual Question Answering (VQA) systems have achieved remarkable success in recent years. However, they often exhibit biases toward certain answer classes, leading to unfair performance across different question-answer pairs. Existing debiasing methods primarily focus on post-hoc mitigation, which may not fully address the root causes of bias during training. In this paper, we propose FairVQA, a novel framework that integrates fairness-aware regularization into the VQA training process to mitigate bias proactively. Our approach employs a contrastive learning objective to encourage the model to learn unbiased representations by maximizing the similarity between question-image pairs with the same correct answer while minimizing it for pairs with different answers. Additionally, we introduce a fairness loss that penalizes the model for over-predicting biased answers, guiding it towards equitable performance across all answer classes. Extensive experiments on the VQA-CP v2 dataset demonstrate that FairVQA significantly outperforms state-of-the-art debiasing methods, achieving up to 10% improvement in accuracy on biased test splits while maintaining strong overall performance. Our work highlights the importance of incorporating fairness considerations directly into the training paradigm for more equitable VQA systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Yamanishi},
 booktitle = {Proceedings of the 2025 {International}},
 doi = {10.1145/3731715.3733450},
 isbn = {979-8-4007-1877-9},
 keywords = {multimodal large language model},
 note = {event-place: Chicago},
 pages = {1654--1663},
 publisher = {Association for Computing Machinery},
 series = {{ICMR}},
 title = {{TourMLLM}},
 url = {https://doi.org/10.1145/3731715.3733450},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:24:53Z},
 year = {2025}
}

@article{yamin_applications_2024,
 abstract = {This paper proposes a novel federated learning framework for privacy-preserving anomaly detection in IoT networks. Traditional centralized approaches are vulnerable to data breaches and single points of failure, while federated learning enables collaborative model training without sharing raw data. We introduce a lightweight autoencoder-based model that detects anomalies by reconstructing network traffic patterns, integrated with differential privacy mechanisms to safeguard sensitive information. Extensive experiments on real-world datasets, including NSL-KDD and CIC-IDS2017, demonstrate that our approach achieves up to 98% detection accuracy with minimal privacy overhead, outperforming state-of-the-art methods in both efficacy and efficiency. The framework is designed for resource-constrained edge devices, ensuring scalability in large-scale IoT deployments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
