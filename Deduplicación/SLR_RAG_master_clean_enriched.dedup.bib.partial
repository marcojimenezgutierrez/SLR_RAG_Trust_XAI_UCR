@inproceedings{sabouri_trust_2025,
 abstract = {Software testing is essential for ensuring the quality and reliability of software systems. However, traditional testing approaches often struggle with the complexity and scale of modern software, leading to inefficiencies and incomplete coverage. In this paper, we propose a novel framework for automated test generation using large language models (LLMs) integrated with reinforcement learning (RL). Our approach, termed LLM-RL-TestGen, leverages the natural language understanding capabilities of LLMs to generate diverse test cases, while RL optimizes the generation process based on feedback from code execution and coverage metrics. We evaluate our framework on real-world Java and Python projects from GitHub, demonstrating significant improvements in branch coverage (up to 25% higher) and fault detection rates compared to state-of-the-art tools like EvoSuite and Randoop. Our results highlight the potential of combining generative AI with adaptive learning for advancing software testing practices.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
