@article{joshi_robust_2024-1,
 abstract = {This paper proposes a novel federated learning framework for edge devices with heterogeneous communication constraints. Traditional federated learning assumes homogeneous network conditions, which is unrealistic in practical edge computing scenarios. Our approach dynamically adjusts model aggregation based on device-specific bandwidth and latency, using a graph neural network to model inter-device dependencies. Extensive simulations on real-world datasets show that our method reduces communication overhead by up to 40% while maintaining model accuracy comparable to centralized training.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
