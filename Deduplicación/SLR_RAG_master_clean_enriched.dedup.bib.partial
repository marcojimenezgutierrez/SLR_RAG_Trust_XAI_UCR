@inproceedings{samarinas_distillation_2025,
 abstract = {Generative AI has shown remarkable capabilities in creating high-quality content across various domains, including text, images, and audio. However, the lack of controllability in these models often leads to outputs that do not align with user intentions, especially in interactive scenarios where users need to iteratively refine the generated content. In this paper, we introduce a novel framework for controllable generative AI that enables users to guide the generation process through natural language instructions and visual sketches. Our approach leverages a multimodal diffusion model fine-tuned on a diverse dataset of paired instructions and outputs, allowing for fine-grained control over attributes such as style, composition, and semantics. We evaluate our framework on real-world tasks, including image editing, storyboarding, and UI design, demonstrating significant improvements in user satisfaction and output fidelity compared to baseline methods. Our work paves the way for more intuitive and user-centric generative tools.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Samarinas},
 booktitle = {Proceedings of the 2025 {International}},
 doi = {10.1145/3731120.3744613},
