@article{essafi_genai_2025,
 abstract = {Explainable artificial intelligence (XAI) has become a key research topic in the last years due to the increasing use of black-box models in many applications. In this paper, we provide a comprehensive overview of the current state of XAI research. We start by discussing the motivations for XAI and the different types of explanations that can be provided. We then review the main XAI methods, categorizing them into model-agnostic and model-specific approaches. For each category, we describe the main techniques and discuss their advantages and limitations. We also highlight the challenges and open problems in XAI research. Finally, we provide some guidelines for practitioners who want to apply XAI methods in their projects.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Essafi},
 doi = {10.1007/978-3-032-05607-8_3},
 journal = {International Conference on Flexible Query Answering …},
 keywords = {source: Google Scholar},
