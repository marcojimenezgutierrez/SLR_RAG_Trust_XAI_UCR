@inproceedings{hung_dark_2024,
 abstract = {Large language models (LLMs) have revolutionized code generation, enabling developers to produce code snippets efficiently. However, the security implications of LLM-generated code remain underexplored, particularly regarding the potential for vulnerabilities to be inadvertently introduced. This paper investigates the vulnerability injection risks in LLM-generated code and evaluates detection methods. We conduct a comprehensive study using popular LLMs, including GPT-4 and Code Llama, to generate code for common programming tasks. Our analysis reveals that LLM-generated code often contains exploitable vulnerabilities, such as buffer overflows and SQL injections, at rates comparable to human-written code from novice developers. We further assess the efficacy of static analysis tools and LLM-based vulnerability detectors in identifying these issues. Results indicate that while traditional tools struggle with LLM-specific patterns, fine-tuned LLMs show promise in detection, achieving up to 85% accuracy. Our findings underscore the need for robust security practices in integrating LLMs into software development workflows.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Hung},
 booktitle = {2024 {Annual}},
 doi = {10.1109/ACSACW65225.2024.00010},
 keywords = {BERT},
 month = {dec},
 pages = {11--19},
 title = {Dark {Watchdog}},
 url = {https://doi.org/10.1109/acsacw65225.2024.00010},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:49:13Z},
 year = {2024}
}

@inproceedings{huo_retrieving_2023,
 abstract = {Recent advances in large language models (LLMs) have shown remarkable capabilities in generating long-form text, but evaluating the quality of such outputs remains challenging. Traditional metrics like BLEU and ROUGE are limited for assessing coherence, factual accuracy, and overall fluency in long contexts. In this paper, we propose a novel evaluation framework that leverages LLMs themselves as judges to assess the quality of generated long-form content. We explore various prompting strategies and fine-tuning approaches to optimize LLM judges for this task. Through extensive experiments on diverse datasets, including news articles, stories, and dialogues, we demonstrate that our LLM-based evaluation method achieves high correlation with human judgments, outperforming existing automatic metrics. Our findings provide insights into the potential and limitations of using LLMs for NLG evaluation, paving the way for more reliable assessment of long-context generation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Huo},
