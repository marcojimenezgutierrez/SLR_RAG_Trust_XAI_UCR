 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:46:03Z},
 year = {2024}
}

@inproceedings{he_ai_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but evaluating their performance remains challenging. Traditional metrics often fail to capture nuanced aspects of quality, leading to the development of LLM-based evaluators that use one LLM to assess the outputs of another. However, the reliability and potential biases of such LLM-as-a-judge approaches are not fully understood, especially when the evaluator and the evaluated model are from the same family. In this paper, we conduct a comprehensive study on using LLMs to evaluate other LLMs (LLM4LLM), focusing on the impact of model similarity, prompt engineering, and evaluation criteria. Through experiments on benchmarks like MT-Bench and AlpacaEval, we reveal that LLM evaluators exhibit strong agreement with human judgments but are influenced by superficial cues and suffer from length biases. We also propose mitigation strategies, including calibration techniques and diverse prompting, to enhance fairness and robustness. Our findings provide insights into the strengths and limitations of LLM4LLM evaluation, paving the way for more trustworthy automated assessment in the era of LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {He},
 booktitle = {Proceedings of the 3rd {Annual}},
 doi = {10.1145/3663384.3663398},
 isbn = {979-8-4007-1017-9},
 keywords = {Brainstorming},
 note = {event-place: Newcastle upon Tyne},
 publisher = {Association for Computing Machinery},
 series = {{CHIWORK}},
 title = {{AI}},
 url = {https://doi.org/10.1145/3663384.3663398},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:39:24Z},
 year = {2024}
}

@inproceedings{he_can_2025,
 abstract = {Deepfakes, synthetic media generated using deep learning techniques, pose significant threats to society by enabling misinformation and identity manipulation. Traditional detection methods often struggle with evolving deepfake generation algorithms. This paper proposes a novel hybrid deep learning framework for deepfake video detection that integrates convolutional neural networks (CNNs) for spatial feature extraction and long short-term memory (LSTM) networks for temporal analysis. The model is trained on a diverse dataset including FaceForensics++ and Celeb-DF, achieving an accuracy of 96.5%, surpassing state-of-the-art methods. Ablation studies validate the contribution of each component, demonstrating robustness against various deepfake generation tools.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {He},
 booktitle = {2025 {IEEE}},
 doi = {10.1109/CCWC62904.2025.10903733},
 keywords = {Accuracy},
 month = {jan},
