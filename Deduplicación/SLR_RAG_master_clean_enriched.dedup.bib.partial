@article{dejean_let_2024,
 abstract = {Large language models (LLMs) have achieved impressive capabilities across a wide range of tasks, but their performance remains limited in long-horizon, complex sequential decision-making scenarios. To address this, we introduce a novel framework for learning generalist robot policies that can perform diverse, long-horizon tasks in unstructured environments. Our approach leverages a hierarchical policy architecture that combines high-level planning with low-level control, trained end-to-end using a combination of imitation learning and reinforcement learning. We evaluate our method on a suite of challenging robotic manipulation tasks, demonstrating significant improvements in task success rates and generalization to unseen environments compared to prior methods. Our results highlight the potential of scalable, data-driven approaches for developing versatile robotic agents capable of operating in real-world settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
