@inproceedings{sarcevic_enhancing_2024,
 abstract = {This paper proposes a novel hybrid deep learning model for automatic detection and classification of plant diseases using leaf images. The model combines Convolutional Neural Network (CNN) with Long Short-Term Memory (LSTM) to extract spatial and temporal features from images. The dataset used includes images of healthy and diseased leaves from various plant species. Experimental results demonstrate that the proposed model achieves an accuracy of 98.5%, outperforming traditional machine learning methods and standalone deep learning architectures. The approach is suitable for real-time deployment in agricultural applications to aid farmers in early disease detection.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
