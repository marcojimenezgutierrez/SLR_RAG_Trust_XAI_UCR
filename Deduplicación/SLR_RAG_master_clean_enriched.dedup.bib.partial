 year = {2025}
}

@article{yu_engineering_2025,
 abstract = {This paper proposes a novel framework for integrating blockchain technology into service-oriented systems to enhance security and interoperability. We introduce a decentralized service discovery mechanism that leverages smart contracts for automated negotiation and execution of services. Through extensive simulations and real-world case studies, we demonstrate that our approach reduces latency by 40% and improves fault tolerance compared to traditional centralized models. The results highlight the potential of blockchain in enabling scalable, trustless service ecosystems for IoT and cloud environments.},
