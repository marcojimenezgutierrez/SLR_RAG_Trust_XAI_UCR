@misc{peng_athena_2024,
 abstract = {Recently, large language models (LLMs) like ChatGPT, LLaMA, and Claude have prevailed in countless domains, including legal scenarios. With LLMs' rapid technological progress, the development of prompt engineering (PE) as an interface between the LLMs and real-world applications has drawn the attention of all developers. Various PE methods have been proposed to overcome real-world challenges, such as few-shot prompting, chain-of-thought, and retrieval-augmented generation (RAG). However, RAG for legal judgment prediction (LJP) is still underexplored. To address this, we propose "Athena", a novel framework cultivating RAG as a core preprocess component to enhance LLMs' performance on specialized tasks. Athena constructs a knowledge base for accusations, attached with a semantic retrieval mechanism through vectorization. Our experiments show that Athena's overall performance has improved significantly, achieving state-of-the-art results on the CAIL2018 dataset. Our ablation study on the in-context window size parameter further reproduces LLMs' "lost-in-the-middle" phenomenon with a relative positional variation. And with moderate hyper-parameter-tuning, we can achieve at most 95% of accuracy accordingly. We also study the impact of query rewriting and data distribution, providing possible directions for future research based on former analyses.},
 abstract_lang = {en},
 abstract_source = {doi-json},
 annote = {Comment: 13 pages},
 author = {Peng},
 doi = {10.48550/arXiv.2410.11195},
 file = {Preprint PDF:C\:\\Users\\Marco\\Zotero\\storage\\XF3BYVF3\\Peng and Chen - 2024 - Athena Retrieval-augmented Legal Judgment Prediction with Large Language Models.pdf:application/pdf},
 keywords = {Computer Science - Artificial Intelligence},
 month = {oct},
 note = {arXiv:2410.11195 [cs]},
 publisher = {arXiv},
 shorttitle = {Athena},
 title = {Athena: {Retrieval}},
 url = {https://doi.org/10.48550/arxiv.2410.11195},
 urldate = {2025-10-26},
 x_enrich_source = {doi-json},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:30:30Z},
 year = {2024}
}

@article{peng_data_2024,
 abstract = {Mixture of Experts (MoE) has emerged as a paradigm for large language models (LLMs), enabling efficient scaling by activating only a subset of parameters per input. However, the conventional training of MoE models using cross-entropy loss often leads to suboptimal performance, particularly in terms of expert utilization and overall model quality. In this work, we propose a novel training objective, Maximum Likelihood Estimation (MLE) for MoE, which directly optimizes the likelihood of the data under the MoE model. Unlike cross-entropy, which approximates the negative log-likelihood for single-expert models, MLE for MoE accounts for the probabilistic routing mechanism inherent in MoE architectures. We theoretically analyze the equivalence between MLE and cross-entropy under certain conditions and highlight scenarios where MLE provides a more accurate optimization signal. Empirically, we demonstrate that MLE-trained MoE models outperform their cross-entropy counterparts on language modeling tasks, achieving better perplexity and expert utilization. Our findings suggest that MLE offers a principled approach to training MoE models, potentially unlocking further improvements in efficiency and performance for next-generation LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Peng},
 journal = {arXiv preprint arXiv:2411.01705},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Data extraction attacks in retrieval-augmented generation via backdoors},
 url = {https://arxiv.org/abs/2411.01705},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:27:22Z},
 year = {2024}
}

@article{peng_eloq_2025,
 abstract = {Generative AI (GenAI) tools have shown promise in assisting developers with various software engineering tasks, but their effectiveness in supporting the creation of interactive visualizations remains underexplored. In this paper, we investigate how GenAI can assist developers in creating interactive visualizations through a controlled user study with 24 participants. We compare two GenAI-assisted approaches—prompt-based code generation and interactive diagram editing—against a baseline of writing code from scratch. Our findings reveal that while GenAI assistance does not significantly improve task completion time or perceived workload, it enhances the perceived usefulness and ease of use, particularly for diagram editing. Qualitative analysis highlights how GenAI supports visualization development by generating code snippets, suggesting design ideas, and facilitating iterative refinement. However, challenges such as inaccurate code generation and limited interactivity support persist. Based on our results, we discuss design implications for GenAI tools to better support interactive visualization development and outline avenues for future research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
