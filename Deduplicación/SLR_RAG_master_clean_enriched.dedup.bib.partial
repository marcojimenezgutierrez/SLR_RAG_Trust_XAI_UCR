@article{sui_enhancing_2024,
 abstract = {This paper presents a comprehensive survey on the application of graph neural networks (GNNs) in recommender systems. We first introduce the basic concepts of GNNs and recommender systems, and then discuss how GNNs can be used to model user-item interactions, user preferences, and item attributes in recommendation scenarios. We categorize GNN-based recommendation methods into several groups based on their architectures and objectives, including graph convolutional networks, graph attention networks, and heterogeneous graph neural networks. For each category, we review representative models, analyze their strengths and limitations, and highlight key techniques such as node embedding, edge prediction, and link prediction. Furthermore, we discuss practical challenges in deploying GNNs for large-scale recommendation systems, including scalability, cold-start problems, and interpretability. Finally, we outline future research directions, such as integrating GNNs with other AI techniques and addressing privacy concerns in federated learning settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
