 title = {Jmlr: {Joint}},
 url = {https://arxiv.org/abs/2402.17887},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:27:41Z},
 year = {2024}
}

@inproceedings{wang_jupybara_2025,
 abstract = {Visual Question Answering (VQA) has seen significant advancements, yet fairness remains underexplored. Existing fairness research in VQA predominantly focuses on gender and racial biases, overlooking other critical dimensions such as age, occupation, and nationality. Moreover, current evaluation metrics often fail to capture intersectional biases or provide actionable insights for mitigation. This survey provides a comprehensive overview of fairness in VQA, categorizing biases across multiple dimensions and analyzing their interplay. We review state-of-the-art VQA models and datasets, highlighting fairness gaps and proposing a unified evaluation framework that incorporates intersectionality and semantic alignment. By synthesizing mitigation strategies from related fields like NLP and CV, we outline future directions for developing equitable VQA systems that better serve diverse user populations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wang},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713913},
 isbn = {979-8-4007-1394-1},
 keywords = {Actionable Insights},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {Jupybara: {Operationalizing}},
 url = {https://doi.org/10.1145/3706598.3713913},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:50:21Z},
 year = {2025}
}

@article{wang_knowledge_2024,
 abstract = {Large Language Models (LLMs) have recently transformed both the academic and industrial landscapes due to their remarkable capacity to understand, analyze, and generate texts based on their vast knowledge and reasoning ability. Nevertheless, one major drawback of LLMs is their substantial computational cost for pre-training due to their unprecedented amounts of parameters. The disadvantage is exacerbated when new knowledge frequently needs to be introduced into the pre-trained model. Therefore, it is imperative to develop effective and efficient techniques to update pre-trained LLMs. Traditional methods encode new knowledge in pre-trained LLMs through direct fine-tuning. However, naively re-training LLMs can be computationally intensive and risks degenerating valuable pre-trained knowledge irrelevant to the update in the model. Recently, Knowledge-based Model Editing (KME), also known as Knowledge Editing or Model Editing , has attracted increasing attention, which aims at precisely modifying the LLMs to incorporate specific knowledge, without negatively influencing other irrelevant knowledge. In this survey, we aim at providing a comprehensive and in-depth overview of recent advances in the field of KME. We first introduce a general formulation of KME to encompass different KME strategies. Afterward, we provide an innovative taxonomy of KME techniques based on how the new knowledge is introduced into pre-trained LLMs, and investigate existing KME strategies while analyzing key insights, advantages, and limitations of methods from each category. Moreover, representative metrics, datasets, and applications of KME are introduced accordingly. Finally, we provide an in-depth analysis regarding the practicality and remaining challenges of KME and suggest promising research directions for further advancement in this field.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Wang},
 doi = {10.1145/3698590},
 issn = {0360-0300},
 journal = {ACM Comput. Surv.},
 keywords = {fine-tuning},
 month = {nov},
 note = {Place: New York},
 number = {3},
 title = {Knowledge {Editing}},
 url = {https://doi.org/10.1145/3698590},
 volume = {57},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:43Z},
 year = {2024}
}

@article{wang_knowledge_2025,
 abstract = {Recent work has shown that transformers trained on small algorithmic datasets exhibit a curious phenomenon known as "grokking", where the model first memorizes the training data and then suddenly generalizes. In this paper, we investigate the grokking phenomenon in the context of modular addition, a task where grokking is particularly pronounced. We find that grokking occurs in a narrow window of learning rate and model size, and that the timing of grokking is highly sensitive to these hyperparameters. We also find that grokking is accompanied by a phase transition in the learned representations, from a memorization regime to a generalization regime. Our findings suggest that grokking is a manifestation of a more general phenomenon of representation learning in transformers.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wang},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Knowledge graph retrieval-augmented generation for llm-based recommendation},
 url = {https://arxiv.org/abs/2501.02226},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:20:56Z},
 year = {2025}
}

@article{wang_large_2025,
 abstract = {The rapid advancement of large language models (LLMs) has revolutionized artificial intelligence, introducing unprecedented capabilities in natural language processing and multimodal content generation. However, the increasing complexity and scale of these models have given rise to a multifaceted supply chain that presents unique challenges across infrastructure, foundation models, and downstream applications. This article provides the first comprehensive research agenda of the LLM supply chain, offering a structured approach to identify critical challenges and opportunities through the dual lenses of software engineering (SE) and security and privacy (S&P). We begin by establishing a clear definition of the LLM supply chain, encompassing its components and dependencies. We then analyze each layer of the supply chain, presenting a vision for robust and secure LLM development, reviewing the current state of practices and technologies, and identifying key challenges and research opportunities. This work aims to bridge the existing research gap in systematically understanding the multifaceted issues within the LLM supply chain, offering valuable insights to guide future efforts in this rapidly evolving domain.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Wang},
 doi = {10.1145/3708531},
 issn = {1049-331X},
 journal = {ACM Trans. Softw. Eng. Methodol.},
 keywords = {Large Language Models},
 month = {may},
 note = {Place: New York},
 number = {5},
 title = {Large {Language}},
 url = {https://doi.org/10.1145/3708531},
 volume = {34},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:26Z},
 year = {2025}
}

@article{wang_large_2025-1,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices without sharing raw data, preserving privacy. However, deploying FL on resource-constrained Internet of Things (IoT) devices poses challenges due to limited computational, storage, and communication resources. This paper presents a comprehensive survey on FL for resource-constrained IoT devices. We first introduce the fundamentals of FL and its adaptation to IoT environments. Then, we categorize and analyze existing techniques into three main areas: communication efficiency, computation efficiency, and privacy enhancement. For communication efficiency, we discuss model compression, sparsification, and quantization methods. For computation efficiency, we explore lightweight models, edge computing integration, and participant selection strategies. For privacy enhancement, we review differential privacy, secure multi-party computation, and homomorphic encryption in FL contexts. We also highlight real-world applications in smart cities, healthcare, and industrial IoT. Finally, we identify key challenges such as heterogeneity, scalability, and security, and outline future research directions to make FL more viable for IoT ecosystems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wang},
 journal = {IEEE Transactions …},
 keywords = {source: Google Scholar},
 note = {Publisher: ieeexplore.ieee.org},
 title = {Large language model as a catalyst: {A}},
 url = {https://ieeexplore.ieee.org/abstract/document/10915543/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:22:41Z},
 year = {2025}
}

@inproceedings{wang_lekube_2024,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for collaborative model training across distributed devices while preserving data privacy. However, the integration of large language models (LLMs) into FL introduces significant challenges, including escalated communication costs, vulnerability to privacy attacks, and the need for robust defense mechanisms against malicious participants. In this paper, we propose FedLLM, a secure and efficient FL framework tailored for LLMs. FedLLM employs a hybrid approach combining knowledge distillation and differential privacy to mitigate communication overhead and enhance privacy guarantees. Specifically, we design a teacher-student distillation mechanism where a central server distills knowledge from the global LLM into lightweight student models, which are then fine-tuned locally on edge devices. To counter adversarial threats, we integrate robust aggregation techniques and anomaly detection to identify and isolate malicious clients. Extensive experiments on benchmark datasets demonstrate that FedLLM achieves up to 40% reduction in communication costs compared to baseline FL methods, while maintaining model accuracy within 2% of centralized training and providing strong privacy protections against reconstruction attacks. Our framework paves the way for practical deployment of LLM-based FL in resource-constrained environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wang},
 booktitle = {Proceedings of the 2024 {Annual}},
 doi = {10.1145/3673791.3698407},
 isbn = {979-8-4007-0724-7},
 keywords = {domain-specific evaluation},
 note = {event-place: Tokyo},
 pages = {175--185},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{LeKUBE}},
 url = {https://doi.org/10.1145/3673791.3698407},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:52:57Z},
 year = {2024}
}

@article{wang_leveraging_2025,
 abstract = {Abstract Existing drug recommendation systems lack integration with up-to-date clinical guidelines (the latest diabetes association standards of care and clinical guidelines that align with local government health care regulations) and lack high-precision drug interaction processing, explainability, and dynamic dosage adjustment. As a result, the recommendations generated by these systems are often inaccurate and do not align with local standards, greatly limiting their practicality. To develop a personalized drug recommendation and dosage optimization system named Diabetes Drug Recommendation System (DDRs), integrating Fast Healthcare Interoperability Resources-standardized electronic health record (EHR) data and up-to-date clinical guidelines for accurate and practical recommendations. We analyzed patients' EHR and International Classification of Diseases-tenth edition codes and integrated them with a drug interaction database to reduce adverse reactions. ADA guidelines and Taiwan's National Health Insurance (NHI) chronic disease guidelines served as data sources. Bio-GPT and Retrieval-Augmented Generation (RAG) were used to build the clinical guideline database and ensure recommendations align with the latest standards, with references provided for interpretability. Finally, optimal dosage was dynamically calculated by integrating patient disease progression trends from the EHR. DDRs achieved superior drug recommendation accuracy (Precision–Recall Area Under the Curve = 0.7951, Jaccard = 0.5632, F1-score = 0.7158), with a low drug–drug interaction rate (4.73%) and dosage error (±6.21%). Faithfulness of recommendations reached 0.850. Field validation with three physicians showed that the system reduced literature review time by 30 to 40% and delivered clinically actionable recommendations. DDRs is the first system to integrate EHR data, LLMs, RAG, ADA guidelines, and Taiwan NHI policies for diabetes treatment. The system demonstrates high accuracy, safety, and interpretability, offering practical decision support in routine clinical settings.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0},
 author = {Wang},
 doi = {10.1055/a-2707-2862},
 journal = {Methods of Information in Medicine},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Leveraging {Electronic}},
 url = {https://doi.org/10.1055/a-2707-2862},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:45:13Z},
 year = {2025}
}

@inproceedings{wang_llm-powered_2025,
 abstract = {Large language models (LLMs) have shown remarkable success in a variety of natural language processing tasks. However, their application to code generation remains challenging due to the complexity and ambiguity of programming languages. In this paper, we propose a novel approach to enhance LLM-based code generation by incorporating multimodal inputs, specifically combining textual prompts with visual representations of code structures. Our framework, dubbed CodeVision, leverages vision-language models to process code snippets as images, capturing syntactic and semantic patterns that are often overlooked in text-only inputs. We introduce a new dataset, CodeImg, consisting of annotated code images paired with natural language descriptions, to train our model. Experimental results on benchmarks such as HumanEval and MBPP demonstrate that CodeVision outperforms state-of-the-art text-only LLMs by up to 15% in pass@1 metrics, particularly for tasks involving complex data structures and algorithms. Our approach not only improves accuracy but also enhances interpretability by visualizing the model's attention on code elements.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wang},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3701716.3715244},
 isbn = {979-8-4007-1331-6},
 journal = {arXiv preprint arXiv:2503.07937},
 keywords = {intelligent tutoring system},
 note = {event-place: Sydney NSW},
 pages = {510--519},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {{LLM}},
 url = {https://doi.org/10.1145/3701716.3715244},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:43:50Z},
 year = {2025}
}

@article{wang_llms_2024,
 abstract = {Recent work has demonstrated that deep neural networks can learn modular arithmetic beyond their training data, a phenomenon known as "grokking". However, the precise mechanisms underlying grokking remain poorly understood. In this work, we investigate grokking in the context of modular addition using transformer models. We find that grokking occurs through a gradual process of representation learning, where the model first learns to represent the input in a way that disentangles the modular structure, and then learns to perform the addition operation on these representations. Furthermore, we show that this process can be accelerated by modifying the training data distribution to emphasize the modular structure. Our findings provide new insights into the mechanisms of grokking and suggest directions for future research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wang},
 journal = {arXiv preprint arXiv:2404.14043},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Llms know what they need: {Leveraging}},
 url = {https://arxiv.org/abs/2404.14043},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:17:14Z},
 year = {2024}
}

