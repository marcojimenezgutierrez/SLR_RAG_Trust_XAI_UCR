@inproceedings{k_comparative_2025,
 abstract = {The rapid growth of Internet of Things (IoT) devices has led to significant security challenges, including data privacy breaches and unauthorized access. Traditional security mechanisms often fall short in decentralized IoT environments. This paper proposes a novel hybrid framework that integrates blockchain technology with lightweight cryptographic protocols to enhance security in IoT networks. The framework employs a permissioned blockchain for secure data sharing and smart contracts for automated access control, combined with elliptic curve cryptography (ECC) for efficient key management on resource-constrained devices. We evaluate the proposed approach through simulations using NS-3 and Hyperledger Fabric, demonstrating a 40% reduction in latency compared to existing blockchain-based solutions, while achieving 99.8% accuracy in intrusion detection. Experimental results on a testbed with 100 IoT nodes show improved resilience against common attacks like DDoS and man-in-the-middle. This work provides a scalable and practical solution for securing future IoT deployments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {K},
 booktitle = {2025 {IEEE}},
 doi = {10.1109/ICCRD64588.2025.10962837},
