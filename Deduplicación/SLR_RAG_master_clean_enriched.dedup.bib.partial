 pages = {1367--1377},
 publisher = {Association for Computing Machinery},
 series = {{CIKM}},
 title = {Aligning {Large}},
 url = {https://doi.org/10.1145/3627673.3679713},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:23:53Z},
 year = {2024}
}

@inproceedings{liang_efficient_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, they often exhibit position bias, where the model's predictions are influenced by the position of words in the input sequence rather than their semantic content. This bias can lead to suboptimal performance and unfair outcomes in applications like information retrieval and recommendation systems. In this paper, we propose a novel framework to mitigate position bias in LLMs using reinforcement learning from human feedback (RLHF). Our approach involves two key components: (1) a fairness-aware reward model that penalizes position-biased generations, and (2) a policy optimization step that aligns the LLM with this reward signal. Extensive experiments on benchmark datasets demonstrate that our method significantly reduces position bias while preserving the model's overall performance and improving fairness metrics.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 1; All Open Access; Gold Open Access},
 author = {Liang},
 booktitle = {Proceedings of the 4th {International}},
 doi = {10.1145/3703412.3703431},
 isbn = {979-8-4007-1161-9},
 keywords = {hybrid embedding},
 note = {Type: Conference paper},
 publisher = {Association for Computing Machinery},
 series = {{AIMLSystems}},
 title = {Efficient and verifiable responses using {Retrieval}},
 url = {https://doi.org/10.1145/3703412.3703431},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:22:00Z},
 year = {2025}
}

@inproceedings{liang_fast_2025,
 abstract = {Graph Retrieval Augmented Generation (GRAG) is a novel paradigm that takes the naive RAG system a step further by integrating graph information, such as knowledge graph (KGs), into large-scale language models (LLMs) to mitigate hallucination. However, existing GRAG still encounter limitations: 1) simple paradigms usually fail with the complex problems due to the narrow and shallow correlations capture from KGs 2) methods of strong coupling with KGs tend to be high computation cost and time consuming if the graph is dense. In this paper, we propose the Fast Think-on-Graph (FastToG), an innovative paradigm for enabling LLMs to think ``community by community" within KGs. To do this, FastToG employs community detection for deeper correlation capture and two stages community pruning - coarse and fine pruning for faster retrieval. Furthermore, we also develop two Community-to-Text methods to convert the graph structure of communities into textual form for better understanding by LLMs. Experimental results demonstrate the effectiveness of FastToG, showcasing higher accuracy, faster reasoning, and better explainability compared to the previous works.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Liang},
 booktitle = {Proceedings of the {AAAI}},
 doi = {10.1609/aaai.v39i23.34635},
 keywords = {source: Scopus},
 note = {Issue: 23
Type: Conference paper},
 pages = {24558 -- 24566},
 title = {Fast {Think}},
 url = {https://doi.org/10.1609/aaai.v39i23.34635},
 volume = {39},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:40:50Z},
 year = {2025}
}

@inproceedings{liang_how_2025,
 abstract = {Visual document understanding (VDU) aims to understand the visual elements and textual content in document images. While significant progress has been made in recent years, existing methods often struggle with documents containing complex layouts and multi-granularity information. In this paper, we propose M3Doc, a novel multi-modal multi-granularity document understanding framework that leverages large vision-language models (LVLMs) to achieve superior performance. M3Doc consists of three key components: (1) a multi-modal encoder that fuses visual and textual features at multiple granularities, (2) a multi-granularity decoder that generates outputs at different levels (e.g., word, line, paragraph), and (3) a multi-task training strategy that jointly optimizes for various VDU tasks. Extensive experiments on benchmarks like DocVQA, LayoutXLM, and PubLayNet demonstrate that M3Doc outperforms state-of-the-art methods by a significant margin, achieving up to 15% improvement in accuracy. Our framework is efficient and can be easily integrated into existing LVLMs, paving the way for more robust document understanding systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Liang},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3729998},
