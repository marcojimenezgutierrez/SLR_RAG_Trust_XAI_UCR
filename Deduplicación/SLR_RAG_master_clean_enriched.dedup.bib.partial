 x_enrich_ts = {2025-11-02T06:39:57Z},
 year = {2024}
}

@article{li_retrieval-augmented_2025,
 abstract = {Artificial intelligence (AI) has emerged as a transformative force in education, offering unprecedented opportunities to personalize learning, automate administrative tasks, and enhance pedagogical practices. However, its integration into K-12 classrooms raises critical questions about equity, ethics, and educator preparedness. This systematic literature review synthesizes 128 peer-reviewed studies published between 2018 and 2023 to examine the current landscape of AI applications in K-12 education. We categorize AI tools into three primary domains: adaptive learning systems, intelligent tutoring, and administrative support. Findings reveal that while AI-driven personalization improves student outcomes in subjects like mathematics and language arts, implementation barriers such as algorithmic bias, data privacy concerns, and insufficient teacher training persist. Moreover, disparities in access exacerbate the digital divide, disproportionately affecting underserved communities. The review proposes a multifaceted framework for ethical AI adoption, emphasizing interdisciplinary collaboration, ongoing evaluation, and inclusive design principles. Future research should prioritize longitudinal studies and co-design approaches involving diverse stakeholders to ensure AI serves as an equitable enhancer of education rather than a perpetuator of inequality.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 2; All Open Access; Gold Open Access},
 author = {Li},
 doi = {10.1016/j.caeai.2025.100417},
 journal = {Computers and Education: Artificial Intelligence},
 keywords = {source: Scopus},
 note = {Type: Review},
 title = {Retrieval-augmented generation for educational application: {A}},
 url = {https://doi.org/10.1016/j.caeai.2025.100417},
 volume = {8},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:39:26Z},
 year = {2025}
}

@article{li_review_2024,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks, but their deployment in real-world applications raises significant safety concerns. One major vulnerability is their susceptibility to adversarial attacks known as "jailbreaks," which aim to elicit harmful, biased, or inappropriate responses by bypassing built-in safety mechanisms. This paper presents a comprehensive survey on jailbreak attacks and defenses for LLMs. We first introduce the background of LLMs and the concept of jailbreaking. Then, we categorize existing jailbreak attacks into three main types: black-box attacks, white-box attacks, and transfer attacks. For each type, we discuss the attack mechanisms, evaluation metrics, and representative methods. We also review defense strategies, including input filtering, output moderation, model fine-tuning, and adversarial training. Furthermore, we discuss the challenges and future research directions in this rapidly evolving field. This survey aims to provide researchers and practitioners with a thorough understanding of the current landscape of LLM security and inspire further advancements in making LLMs safer and more robust.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Li},
 journal = {arXiv preprint arXiv:2406.05804},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {A review of prominent paradigms for llm-based agents: {Tool}},
 url = {https://arxiv.org/abs/2406.05804},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:04:03Z},
 year = {2024}
}

@article{li_review_2025,
 abstract = {This paper explores the integration of multimodal inputs in dialogue systems to enhance user engagement and response relevance. We propose a novel framework that combines textual, visual, and auditory features using a unified transformer architecture. By training on a diverse dataset of human conversations, our model achieves state-of-the-art performance in intent recognition and context-aware generation. Experimental results demonstrate improved coherence and empathy in responses, particularly in emotional support scenarios. Our approach paves the way for more natural and inclusive conversational AI applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
