@inproceedings{huang_driverp_2024,
 abstract = {Digital twins (DTs) have gained significant attention in recent years due to their potential to revolutionize various industries by providing virtual replicas of physical systems. In smart manufacturing, DTs enable real-time monitoring, simulation, and optimization of production processes. This paper presents a comprehensive survey on the application of DTs in smart manufacturing, focusing on key technologies, architectures, and challenges. We review the state-of-the-art in DT modeling, data integration, and edge-cloud computing paradigms that support DT deployment. Furthermore, we discuss emerging trends such as AI-driven DTs and cybersecurity considerations. The survey highlights case studies from automotive and aerospace sectors, demonstrating the practical benefits and limitations of current implementations. Finally, we outline future research directions to enhance the scalability and interoperability of DT systems in Industry 4.0 environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Huang},
 booktitle = {2024 {IEEE}},
