}

@article{yadav_aeroquery_2024-1,
 abstract = {This paper presents a novel federated learning framework for privacy-preserving traffic flow prediction in intelligent transportation systems. Traditional centralized models face significant privacy risks when handling sensitive traffic data from multiple sources. To address this, we propose FedTraffic, a federated learning approach that enables collaborative model training across distributed edge devices without sharing raw data. Our framework incorporates a graph attention network to capture spatial-temporal dependencies in traffic networks and employs differential privacy mechanisms to further safeguard data privacy. Extensive experiments on real-world datasets demonstrate that FedTraffic achieves comparable prediction accuracy to centralized baselines while reducing privacy leakage by over 90%. The results highlight the potential of federated learning in scalable and secure urban traffic management.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
