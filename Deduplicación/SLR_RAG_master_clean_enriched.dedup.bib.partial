@inproceedings{kobiella_when_2025,
 abstract = {This paper introduces a novel approach to enhancing user interaction with large language models (LLMs) through the integration of multimodal inputs, specifically focusing on voice and gesture recognition. We present VoiceFlow, a system that allows users to converse with LLMs using natural speech and hand gestures, enabling more intuitive and expressive communication. Our evaluation demonstrates that VoiceFlow significantly improves user satisfaction and task efficiency compared to text-based interfaces, particularly in creative and exploratory tasks. We discuss the technical challenges in synchronizing multimodal inputs with LLM responses and outline future directions for accessible AI interactions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
