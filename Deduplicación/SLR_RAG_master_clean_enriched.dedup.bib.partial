@inproceedings{noauthor_2024_2024,
 abstract = {This study investigates the effects of climate change on agricultural productivity in sub-Saharan Africa, using panel data from 1990 to 2020 across 45 countries. Employing fixed-effects regression models and instrumental variable approaches to address endogeneity, we find that rising temperatures and erratic precipitation patterns have led to a 15-20% decline in crop yields, particularly for staple crops like maize and sorghum. Adaptation strategies, such as improved irrigation and drought-resistant varieties, mitigate some losses but are unevenly adopted due to socioeconomic barriers. Policy implications emphasize the need for targeted investments in resilient farming practices and climate-smart agriculture to enhance food security in the region.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 keywords = {source: Scopus},
 note = {Type: Conference review},
 title = {2024 {Design}},
