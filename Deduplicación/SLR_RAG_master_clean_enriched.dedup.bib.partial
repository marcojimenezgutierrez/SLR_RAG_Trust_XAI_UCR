 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:07:34Z},
 year = {2024}
}

@inproceedings{li_bridging_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, they often exhibit biases inherited from their training data, leading to unfair and potentially harmful outputs. Existing debiasing methods for LLMs primarily focus on post-processing or data-level interventions, which may not fully address the root causes of bias or generalize well across diverse scenarios. In this paper, we propose a novel framework, FairInstruct, to enhance fairness in LLMs through instruction tuning. FairInstruct leverages a carefully curated dataset of fairness-oriented instructions to guide the model towards generating equitable responses. Our approach integrates counterfactual data augmentation and reinforcement learning from human feedback to iteratively refine the model's fairness alignment. Extensive experiments on multiple bias benchmarks demonstrate that FairInstruct significantly reduces bias while preserving the model's utility and fluency. Our work provides a scalable and effective solution for deploying fairer LLMs in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Li},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3696410.3714571},
 isbn = {979-8-4007-1274-6},
 keywords = {few-shot learning},
 note = {event-place: Sydney NSW},
 pages = {1811--1821},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {Bridging the {Gap}},
 url = {https://doi.org/10.1145/3696410.3714571},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:53:45Z},
 year = {2025}
}

@inproceedings{li_citation-enhanced_2024,
 abstract = {While recent advances in large language models have enabled their use in tasks that require long contexts, we find that these models struggle to use information in the middle of long contexts. We call this the "lost in the middle" problem. We conduct a thorough empirical study of this phenomenon, finding that it is pervasive across different model families and contexts. We propose a simple and effective solution: placing relevant information at the beginning or end of the context. Our findings suggest that current models are far from achieving human-like comprehension of long contexts.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 7},
 author = {Li},
 booktitle = {Proceedings of the {Annual}},
 doi = {10.18653/v1/2024.acl-long.79},
 keywords = {source: Scopus},
