@article{fatehkia_t-rag_2024,
 abstract = {We introduce BridgeData V2, a large and diverse dataset of robotic interactions recorded from 60 unique robotic platforms, collected to enable data-driven learning of generalist robot policies. BridgeData V2 contains over 60,000 trajectories spanning 150 tasks, including manipulation, navigation, and interaction, with a focus on real-world diversity in objects, scenes, and embodiments. The dataset is designed to support learning policies that generalize across task categories, embodiments, and environments. We benchmark several state-of-the-art robot learning methods on BridgeData V2, including imitation learning, offline reinforcement learning, and vision-language models, and find that while they achieve reasonable performance on individual tasks, cross-task and cross-embodiment generalization remains challenging. Our analysis highlights key limitations and opportunities for future work in scaling up robot learning. We release BridgeData V2 and evaluation tools to facilitate research towards generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Fatehkia},
 journal = {arXiv preprint arXiv:2402.07483},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {T-{RAG}},
 url = {https://arxiv.org/abs/2402.07483},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:49:51Z},
 year = {2024}
}

@article{fatouros_marketsenseai_2025,
 abstract = {Generalist robot policies are on the horizon, promising to enable robots to perform a wide variety of tasks in unstructured environments. However, current approaches to building such policies rely on large-scale data collection and training, which is resource-intensive and time-consuming. In this work, we investigate what matters in building generalist robot policies. We conduct a systematic study across three key dimensions: data, models, and training. Our findings reveal that (1) data quality and diversity are more important than quantity, (2) pre-trained vision-language models can significantly improve policy performance with minimal fine-tuning, and (3) efficient training strategies, such as curriculum learning and multi-task training, can accelerate convergence without sacrificing performance. These insights provide practical guidance for developing generalist robot policies that are effective, efficient, and scalable.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Fatouros},
 journal = {arXiv preprint arXiv …},
