@article{bingol_accuracy_2025,
 abstract = {This study investigates the impact of digital transformation on supply chain performance, with a particular focus on the mediating role of supply chain resilience. Drawing on the dynamic capabilities view and resilience theory, we develop a conceptual model and test it using survey data from 312 supply chain managers in Chinese manufacturing firms. The results indicate that digital transformation positively affects supply chain performance, and this relationship is mediated by supply chain resilience. Moreover, the mediating effect is stronger when firms operate in highly uncertain environments. Our findings contribute to the literature by highlighting the resilience mechanism through which digital transformation enhances supply chain performance and provide practical implications for managers seeking to leverage digital technologies for supply chain resilience and performance improvement.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Bingöl},
 journal = {Journal of Renal Nutrition},
 keywords = {source: Google Scholar},
