 title = {Retrieval-based evaluation for {LLMs}},
 url = {https://aclanthology.org/2023.nllp-1.13/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:46:27Z},
 year = {2023}
