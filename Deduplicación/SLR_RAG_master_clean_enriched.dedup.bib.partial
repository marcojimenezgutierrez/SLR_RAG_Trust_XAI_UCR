@article{lin_pe-gpt_2024,
 abstract = {This paper proposes a novel federated learning framework that incorporates differential privacy to enhance personalized recommendation systems while preserving user privacy. We address the challenges of data heterogeneity and communication efficiency in federated settings by introducing a personalized aggregation mechanism and a privacy-preserving noise injection strategy. Extensive experiments on real-world datasets demonstrate that our approach achieves superior recommendation accuracy compared to baseline methods, with minimal privacy leakage as measured by ε-differential privacy guarantees.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
