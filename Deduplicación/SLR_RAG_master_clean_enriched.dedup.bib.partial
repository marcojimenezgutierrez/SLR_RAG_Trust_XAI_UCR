 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:02:46Z},
 year = {2024}
}

@article{bhattacharya_study_2025,
 abstract = {Brain tumor segmentation from magnetic resonance imaging (MRI) is a crucial step in the diagnosis and treatment planning of brain tumors. Manual segmentation by radiologists is time-consuming and prone to inter-observer variability. In recent years, deep learning-based methods have shown promising results in automating this process. This chapter provides a comprehensive review of deep learning techniques for brain tumor segmentation in MRI images. We categorize the methods into encoder-decoder architectures, generative adversarial networks (GANs), and transformer-based models. Key challenges such as class imbalance, small dataset sizes, and multi-modal integration are discussed, along with popular datasets like BraTS. Future directions include hybrid models combining deep learning with traditional methods and the incorporation of explainable AI for clinical adoption.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Bhattacharya},
 doi = {10.1007/978-981-96-5511-3_39},
 journal = {Lecture Notes in Mechanical Engineering},
 keywords = {source: Google Scholar},
