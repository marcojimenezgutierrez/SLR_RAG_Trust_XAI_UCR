@article{tang_symphony_2024,
 abstract = {This paper presents an overview of the challenges and opportunities in integrating XML with relational database management systems (RDBMS). We discuss various approaches for storing, querying, and updating XML data within an RDBMS environment, including schema mapping, middleware solutions, and native XML extensions. Key issues such as performance, schema evolution, and query optimization are addressed, with examples from commercial and research systems. The goal is to provide a foundation for developers and researchers working on XML-enabled data management.},
