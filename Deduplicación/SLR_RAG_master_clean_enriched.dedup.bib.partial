@inproceedings{huang_generating_2024,
 abstract = {Recommendation systems (RSs) have been widely deployed in various online platforms, such as e-commerce, social media, and streaming services, to provide personalized suggestions to users. However, recent studies have shown that RSs can inadvertently amplify biases present in the data, leading to unfair recommendations that disadvantage certain groups of users based on sensitive attributes like gender, race, or age. This can result in discriminatory outcomes, reduced user trust, and even societal harm. In this paper, we conduct a comprehensive survey on fairness in recommendation systems. We first provide an overview of the sources of bias in RSs and the various definitions of fairness used in the literature. Then, we categorize and review existing methods for mitigating bias, including pre-processing, in-processing, and post-processing techniques. We also discuss evaluation metrics for fairness and the trade-offs between fairness and utility. Finally, we highlight open challenges and future research directions in achieving fair recommendations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Huang},
 booktitle = {Proceedings of the {Third}},
 doi = {10.1145/3690712.3690718},
 isbn = {979-8-4007-1031-5},
 keywords = {Educational Material Generation},
 note = {event-place: Honolulu},
 pages = {16--22},
 publisher = {Association for Computing Machinery},
 series = {{In2Writing}},
 title = {Generating {Educational}},
 url = {https://doi.org/10.1145/3690712.3690718},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:48:53Z},
 year = {2024}
}

@inproceedings{huang_ket-rag_2025,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices while preserving data privacy. However, the heterogeneity in data distribution, device capabilities, and network conditions poses significant challenges to FL convergence and efficiency. To address these issues, adaptive aggregation has emerged as a promising approach, dynamically adjusting aggregation strategies based on the current state of the system. In this paper, we conduct a comprehensive survey on adaptive aggregation in FL, categorizing existing methods into three main groups: adaptive client selection, adaptive model aggregation, and adaptive communication strategies. We delve into the motivations, methodologies, and theoretical underpinnings of each category, highlighting their strengths and limitations. Furthermore, we discuss evaluation metrics, datasets, and benchmarks commonly used in this domain. Finally, we outline future research directions, including integration with emerging paradigms like split learning and blockchain, as well as addressing fairness and robustness in adaptive aggregation. This survey aims to provide researchers and practitioners with a holistic understanding of adaptive aggregation techniques in FL, fostering further innovations in this rapidly evolving field.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Huang},
