@article{anichkov_retrieval_2025,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for collaborative model training across distributed devices while preserving data privacy. However, deploying FL in Internet of Things (IoT) environments faces significant challenges due to resource constraints, heterogeneous devices, and communication overheads. This paper proposes a novel approach to enhance FL performance in IoT settings by integrating adaptive aggregation and edge caching mechanisms. Our method dynamically adjusts aggregation weights based on device reliability and local data distribution, while leveraging edge nodes for intermediate model caching to reduce latency and bandwidth usage. Extensive simulations on real-world IoT datasets demonstrate that our approach achieves up to 25% improvement in model accuracy and 40% reduction in communication costs compared to baseline FL algorithms.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
