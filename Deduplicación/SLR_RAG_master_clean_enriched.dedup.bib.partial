@inproceedings{mattis_examples_2024,
 abstract = {Visual Question Answering (VQA) has made significant progress, but the fairness of VQA models remains underexplored. In this paper, we conduct a comprehensive analysis of fairness in VQA, revealing that existing models exhibit substantial biases across demographic attributes such as gender, skin tone, and age. These biases lead to disparate performance and unfair outcomes for underrepresented groups. To address this, we propose FairVQA, a novel framework that integrates fairness-aware pretraining, debiasing during fine-tuning, and post-hoc calibration. Our approach leverages counterfactual data augmentation and adversarial training to mitigate biases while preserving overall accuracy. Extensive experiments on benchmark datasets demonstrate that FairVQA significantly reduces bias metrics (e.g., by up to 40% in worst-group accuracy) without compromising state-of-the-art performance. Our work provides a robust foundation for developing equitable VQA systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
