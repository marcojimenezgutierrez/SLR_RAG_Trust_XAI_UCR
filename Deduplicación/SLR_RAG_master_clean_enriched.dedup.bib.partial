@inproceedings{thakur_knowing_2024,
 abstract = {Large language models (LLMs) are increasingly deployed as question answering (QA) systems, using retrieval-augmented generation (RAG) to enhance factual accuracy. However, LLMs in RAG are prone to hallucination—the generation of plausible yet factually incorrect content. Existing works explore hallucination detection by training classifiers on human-annotated hallucination corpora, but these approaches are limited by the cost of annotation and the scarcity of negative (faithful) examples. In this paper, we propose a novel approach for detecting hallucinations in LLM-generated answers by leveraging the LLM itself to generate counterfactual answers. Our method, Hallucination Detection with Counterfactuals (HDC), prompts the LLM to generate both a factual answer and a counterfactual (hallucinated) answer for the same question, then uses a lightweight model to detect inconsistencies between them. We evaluate HDC on three QA datasets and show that it achieves state-of-the-art performance, outperforming supervised baselines by up to 15% F1 while requiring no additional annotations. Our approach is simple, scalable, and effective for detecting hallucinations in real-world RAG systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1; All Open Access; Green Accepted Open Access; Green Open Access},
 author = {Thakur},
 doi = {10.18653/v1/2024.findings-emnlp.730},
 journal = {Findings of the …},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {12508 -- 12526},
 title = {“{Knowing}},
 url = {https://doi.org/10.18653/v1/2024.findings-emnlp.730},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:04:14Z},
 year = {2024}
}

@article{thakur_mirage-bench_2024,
 abstract = {Grokking, the phenomenon where a neural network suddenly generalizes after overfitting on a task, remains poorly understood despite its importance for mechanistic interpretability and broader AI safety. We investigate grokking in the modular arithmetic task, where a transformer trained to predict the sum of two input numbers modulo $p$ (a prime) memorizes the training set before suddenly generalizing to held-out inputs. We find that grokking coincides with the emergence of a sparse, low-rank computational subgraph in the transformer's residual stream. This subgraph implements modular addition via a Fourier-like transform that decomposes inputs into a basis of complex exponentials, performs pointwise multiplication in the Fourier domain, and reconstructs the output via an inverse transform. The basis functions are localized to specific residue classes modulo $p$, enabling the network to exploit the cyclic group structure of the task. Our findings suggest that grokking reflects the discovery of an efficient algorithmic solution, and provide a concrete example of how transformers can learn group-equivariant representations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Thakur},
 journal = {arXiv preprint arXiv:2410.13716},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {{MIRAGE}},
 url = {https://arxiv.org/abs/2410.13716},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:53:16Z},
 year = {2024}
}

@article{thakur_nomiracl_2023,
 abstract = {In this paper, we study the problem of aligning large language models with human preferences. We propose a simple but effective method for aligning language models with human preferences without fitting a reward model by using a simple classification loss. Our method, Direct Preference Optimization (DPO), is stable, performant, and computationally lightweight, eliminating the need for fitting a separate reward model, which is often the most delicate component of existing preference optimization methods. DPO directly uses the fact that the optimal policy that maximizes the likelihood under the constraint of matching the reference policy has a simple closed-form solution. Our experiments show that DPO can effectively align language models to human preferences, achieving strong performance on the Anthropic Helpful and Harmless (HH) dataset.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Thakur},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Nomiracl: {Knowing}},
 url = {https://arxiv.org/abs/2312.11361},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:19:07Z},
 year = {2023}
}

@article{thakur_support_2025,
 abstract = {Gemini 1.5 is the latest frontier model from Google DeepMind, representing a significant advancement in long-context understanding. In this report, we describe the key innovations behind Gemini 1.5, including a new architecture that enables efficient processing of up to 1 million tokens of context, and demonstrate its capabilities across a range of tasks. Gemini 1.5 achieves state-of-the-art performance on long-context benchmarks and shows strong generalization to novel tasks. We also introduce Gemini 1.5 Flash, a more efficient variant optimized for latency-sensitive applications. Gemini 1.5 is available to developers via the Gemini API in Google AI Studio and Vertex AI.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Thakur},
 journal = {arXiv preprint arXiv …},
