 keywords = {active inquiry},
 note = {event-place: Padua},
 pages = {1055--1065},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Ask and {Retrieve}},
 url = {https://doi.org/10.1145/3726302.3729898},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:06:42Z},
 year = {2025}
}

@inproceedings{zhang_automatic_2025,
 abstract = {The electrochemical behavior of nickel in alkaline solutions containing tartrate ions was investigated using cyclic voltammetry, chronoamperometry, and electrochemical impedance spectroscopy. The results show that tartrate ions act as inhibitors for the hydrogen evolution reaction on nickel electrodes, with inhibition efficiency increasing with tartrate concentration. The adsorption of tartrate on the nickel surface follows Langmuir isotherm, and the process is spontaneous and exothermic. This study provides insights into the corrosion inhibition mechanisms of organic compounds in alkaline media.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Zhang},
 booktitle = {Proceedings - {International}},
