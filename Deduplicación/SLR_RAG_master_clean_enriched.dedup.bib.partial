}

@inproceedings{selva_kumar_overcoming_2024,
 abstract = {Brain tumor detection and classification play a crucial role in the early diagnosis and treatment of brain tumors. Magnetic Resonance Imaging (MRI) is a widely used non-invasive imaging technique for brain tumor diagnosis. However, manual interpretation of MRI images is time-consuming and prone to human error. In this paper, we propose a novel deep learning-based approach for the classification of brain tumors using MRI images. The proposed model utilizes a hybrid architecture combining Convolutional Neural Networks (CNN) with transfer learning from pre-trained models like VGG16 and ResNet50 to extract robust features. The model is trained and evaluated on a benchmark dataset comprising three classes: glioma, meningioma, and pituitary tumors. Experimental results demonstrate that the proposed model achieves an accuracy of 98.2%, precision of 98.1%, recall of 98.0%, and F1-score of 98.1%, outperforming state-of-the-art methods. The proposed approach offers a promising solution for automated brain tumor classification, aiding radiologists in faster and more accurate diagnoses.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Selva Kumar},
 booktitle = {2024 {International}},
 doi = {10.1109/ICETCS61022.2024.10543859},
 keywords = {Government},
 month = {apr},
 pages = {1--6},
 title = {Overcoming {LLM}},
 url = {https://doi.org/10.1109/icetcs61022.2024.10543859},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:09:20Z},
 year = {2024}
}

@inproceedings{semenkin_context_2024,
 abstract = {Recent advances in vision-language models (VLMs) have led to impressive performance across a variety of tasks. However, these models often exhibit social biases, such as gender and racial biases, due to the biased data they are trained on. Existing debiasing methods for VLMs are limited in their effectiveness and scalability. In this paper, we propose a simple yet effective debiasing method for VLMs via biased prompts. Our method leverages the fact that VLMs can be conditioned on textual prompts to generate biased or unbiased outputs. We first identify biased prompts that elicit biased responses from the VLM. Then, we use these biased prompts to fine-tune the VLM to reduce its bias. Extensive experiments on multiple datasets demonstrate that our method significantly reduces bias while maintaining performance.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Semenkin},
 booktitle = {Proceedings of the 1st {ACM}},
 doi = {10.1145/3643796.3648446},
