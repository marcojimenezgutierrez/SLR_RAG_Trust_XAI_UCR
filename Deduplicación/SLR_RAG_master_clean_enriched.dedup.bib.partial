@inproceedings{zhao_checkguard_2024,
 abstract = {Visual question answering (VQA) models often exhibit biases toward specific answers, leading to unreliable performance on out-of-distribution data. Existing debiasing methods typically require access to the original training data or rely on predefined bias types, limiting their applicability in real-world scenarios. In this paper, we propose a novel debiasing approach that leverages biased prompts to mitigate gender bias in vision-language models (VLMs) without requiring the original dataset. Our method generates counterfactual prompts by inverting biased attributes (e.g., gender) while preserving the semantic content, and uses these to fine-tune the model. We evaluate our approach on the VQA-CP dataset, demonstrating significant improvements in bias mitigation and overall accuracy compared to state-of-the-art methods. Our results highlight the effectiveness of prompt-based debiasing for enhancing fairness in VLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhao},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3627673.3679155},
