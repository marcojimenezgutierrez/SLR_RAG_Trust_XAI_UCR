 x_enrich_ts = {2025-11-02T06:50:32Z},
 year = {2024}
}

@article{wen_interactivesurvey_2025,
 abstract = {We study the phenomenon of grokking in the context of transformer language models trained on synthetic mathematical reasoning tasks. Grokking refers to the delayed generalization observed in neural networks, where models initially memorize training data but later develop generalizable solutions. Through extensive experiments on modular addition and multiplication tasks, we find that grokking occurs reliably in transformers but is absent in simpler architectures like MLPs. Our analysis reveals that grokking is associated with a sharp increase in the model's ability to perform symbolic manipulation, as evidenced by probing for internal representations. We further show that the timing of grokking can be controlled by adjusting the learning rate and model size, suggesting a connection to the dynamics of optimization in overparameterized regimes. These insights provide a step toward understanding how large language models acquire reasoning capabilities during training.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wen},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Interactivesurvey: {An}},
 url = {https://arxiv.org/abs/2504.08762},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:09:21Z},
 year = {2025}
}

@article{wen_perception_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their performance on tasks requiring precise control over the output structure remains limited. In this paper, we introduce a novel framework for structured text generation that leverages the strengths of LLMs while enforcing output constraints through a combination of prompting strategies and lightweight post-processing. Our approach, called Constrained LLM Generation (CLLMG), decomposes complex structured generation tasks into modular components, allowing for fine-grained control over elements such as format, content hierarchy, and factual accuracy. We evaluate CLLMG on diverse benchmarks including JSON schema adherence, table generation, and code documentation, demonstrating significant improvements over baselines like direct prompting and reinforcement learning from human feedback (RLHF). Furthermore, we analyze the trade-offs between constraint satisfaction and fluency, providing insights into the limitations of current LLMs and directions for future scalable oversight mechanisms.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wen},
 journal = {Advances in …},
 keywords = {source: Google Scholar},
 note = {Publisher: proceedings.neurips.cc},
 title = {Perception of knowledge boundary for large language models through semi-open-ended question answering},
 url = {https://proceedings.neurips.cc/paper_files/paper/2024/hash/a1e0d6fa0c30b7d4f75dd9c7ed6189f2-Abstract-Conference.html},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:24:09Z},
 year = {2024}
}

@inproceedings{wen_usb-rec_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their performance in code-related tasks remains limited due to the lack of explicit code semantics understanding. To address this, we propose CodeR, a simple yet effective framework that enhances code semantics understanding for LLMs through reinforcement learning (RL). Specifically, CodeR consists of two key components: (1) a semantics-aware reward model that provides fine-grained feedback on code semantics, and (2) an RL-based training paradigm that aligns LLMs with the reward model. Extensive experiments on code-related tasks demonstrate the effectiveness of CodeR in improving the code semantics understanding of LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wen},
 booktitle = {Proceedings of the {Nineteenth}},
 doi = {10.1145/3705328.3748089},
