 pages = {4196 -- 4210},
 title = {{TongGu}},
 url = {https://doi.org/10.18653/v1/2024.findings-emnlp.243},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:04:08Z},
 year = {2024}
}

@article{cao_video_2025,
 abstract = {We introduce RoboAgent, a generalist robot agent trained on a large-scale dataset of real-world robot interactions. RoboAgent is designed to handle diverse tasks in unstructured environments, leveraging a unified policy that coordinates perception, planning, and control. Our approach combines vision-language models with reinforcement learning to enable zero-shot generalization to novel objects, scenes, and instructions. Experiments on benchmarks like RLBench and real-world deployments demonstrate that RoboAgent outperforms specialized baselines by 25-40% in success rate across manipulation, navigation, and multi-task scenarios. This work advances the development of versatile, deployable robot systems capable of adapting to open-world challenges.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Cao},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
