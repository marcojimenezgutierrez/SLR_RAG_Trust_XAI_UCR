 keywords = {empirical study},
 note = {event-place: Sacramento},
 pages = {656--668},
 publisher = {Association for Computing Machinery},
 series = {{ASE}},
 title = {What {Makes}},
 url = {https://doi.org/10.1145/3691620.3695061},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:22:04Z},
 year = {2024}
}

@inproceedings{yuan_day_2025,
 abstract = {Context is crucial for understanding and interacting with the world, yet current large vision-language models (LVLMs) struggle to effectively leverage it. We hypothesize that this is due to a lack of explicit mechanisms for contextual reasoning. To address this, we introduce ContextR, a plug-and-play module that enhances LVLMs' ability to reason about context through a three-stage pipeline: (1) context identification, (2) context verification, and (3) context integration. ContextR is trained on a newly curated dataset, ContextQA, comprising 38K QA pairs centered around diverse forms of contextual cues. Our experiments demonstrate that ContextR significantly improves the performance of various LVLMs on context-intensive visual question answering (VQA) tasks, achieving up to 20% improvement on challenging benchmarks like CLEVR and GQA.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
