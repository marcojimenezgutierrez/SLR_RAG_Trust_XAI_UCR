 title = {Unims-rag: {A}},
 url = {https://arxiv.org/abs/2401.13256},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:47:55Z},
 year = {2024}
}

@article{wang_unique_2025,
 abstract = {With the rapid development of artificial intelligence, large language models (LLMs) have made remarkable advancements in natural language processing. These models are trained on vast datasets to exhibit powerful language understanding and generation capabilities across various applications, including chatbots and agents. However, LLMs have revealed a variety of privacy and security issues throughout their life cycle, drawing significant academic and industrial attention. Moreover, the risks faced by LLMs differ significantly from those encountered by traditional language models. Given that current surveys lack a clear taxonomy of unique threat models across diverse scenarios, we emphasize the unique privacy and security threats associated with four specific scenarios: pre-training, fine-tuning, deployment, and LLM-based agents. Addressing the characteristics of each risk, this survey outlines and analyzes potential countermeasures. Research on attack and defense situations can offer feasible research directions, enabling more areas to benefit from LLMs.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Wang},
 doi = {10.1145/3764113},
 issn = {0360-0300},
 journal = {ACM Comput. Surv.},
 keywords = {agent},
 month = {oct},
 note = {Place: New York},
 number = {4},
 title = {Unique {Security}},
 url = {https://doi.org/10.1145/3764113},
 volume = {58},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:40:53Z},
 year = {2025}
}

@article{wang_unveiling_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their impressive performance often comes at the cost of high computational and memory requirements, making them impractical for resource-constrained environments. Knowledge distillation (KD) has emerged as a popular approach to compress LLMs into smaller, more efficient models while preserving much of their performance. Despite its effectiveness, standard KD methods often fail to fully transfer the teacher's capabilities to the student, particularly in terms of factual knowledge and reasoning abilities. In this paper, we propose a novel KD framework, FactDistil, that explicitly focuses on distilling factual knowledge from the teacher LLM to the student model. FactDistil leverages a fact extraction module to identify and prioritize key factual entities and relations in the teacher's outputs, which are then used to guide the student's training. We evaluate FactDistil on several benchmarks, including natural language inference, question answering, and commonsense reasoning tasks. Our results demonstrate that FactDistil significantly outperforms standard KD methods, achieving up to 15% improvement in factual accuracy while maintaining competitive performance on other metrics. FactDistil offers a simple yet effective approach to enhance the factual reliability of distilled LLMs, paving the way for their deployment in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wang},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730112},
 isbn = {979-8-4007-1592-1},
 journal = {Proceedings of the 48th …},
 keywords = {source: Google Scholar},
 note = {Publisher: dl.acm.org},
 pages = {1262--1271},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Unveiling {Knowledge}},
 url = {https://doi.org/10.1145/3726302.3730112},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:18:49Z},
 year = {2025}
}

@article{wang_using_2025,
 abstract = {The article presents a comprehensive review of recent advances in machine learning applications for renewable energy forecasting. Key methodologies, including deep learning models such as LSTM and CNN, are evaluated for their efficacy in predicting solar and wind power generation. The study highlights challenges like data scarcity and intermittency, proposing hybrid approaches to improve accuracy. Empirical results from case studies demonstrate up to 20% enhancement in forecasting precision, underscoring the potential for integrating AI in sustainable energy systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 3},
 author = {Wang},
 journal = {Pacific Symposium on Biocomputing},
 keywords = {source: Scopus},
 note = {Type: Article},
