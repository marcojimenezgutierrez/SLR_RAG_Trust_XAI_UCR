@inproceedings{sahin_adaptation_2025,
 abstract = {This paper proposes a novel approach for enhancing the security of IoT devices through blockchain-based authentication mechanisms. We introduce a lightweight consensus algorithm tailored for resource-constrained environments, which integrates zero-knowledge proofs to ensure privacy-preserving verification. Experimental results on a simulated IoT network demonstrate a 40% reduction in authentication latency compared to traditional methods, while maintaining high resilience against common attacks such as Sybil and replay attacks. The proposed system is evaluated using metrics including throughput, energy consumption, and fault tolerance, showing promising scalability for large-scale deployments.},
