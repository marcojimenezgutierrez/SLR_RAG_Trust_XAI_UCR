 keywords = {large language model},
 note = {event-place: Padua},
 pages = {1810--1819},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {You {Are}},
 url = {https://doi.org/10.1145/3726302.3730118},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:50:56Z},
 year = {2025}
}

@article{shimada_leveraging_2025,
 abstract = {This chapter provides a comprehensive survey on the application of Explainable Artificial Intelligence (XAI) techniques in the field of cybersecurity. As AI systems become increasingly integrated into cybersecurity defenses, the need for transparency and interpretability in their decision-making processes has grown significantly. Traditional black-box models, while effective, often lack the ability to provide insights into their reasoning, which is critical for trust, accountability, and regulatory compliance in high-stakes environments like cybersecurity. We begin by outlining the unique challenges posed by cybersecurity applications, such as adversarial attacks, data imbalance, and the dynamic nature of threats. Subsequently, we categorize and review prominent XAI methods, including feature importance techniques (e.g., SHAP, LIME), model-agnostic approaches, and inherently interpretable models, evaluating their suitability and performance in cybersecurity tasks like intrusion detection, malware classification, and anomaly detection. We highlight key studies and benchmarks, discussing strengths, limitations, and open research questions. Finally, we propose future directions, emphasizing the integration of XAI with emerging paradigms like federated learning and edge computing to enhance robust and ethical AI-driven cybersecurity solutions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Shimada},
 doi = {10.1007/978-3-031-98462-4_43},
 journal = {Lecture Notes in Computer Science},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {340 -- 347},
 title = {Leveraging {Lecture}},
 url = {https://doi.org/10.1007/978-3-031-98462-4_43},
 volume = {15881 LNAI},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:53:24Z},
 year = {2025}
}

@inproceedings{shin_planfitting_2025,
 abstract = {Interactive data visualization tools empower non-experts to explore and analyze data. However, creating effective visualizations often requires expertise in both data analysis and visual design. Visual programming languages (VPLs) for data visualization aim to bridge this gap by allowing users to construct visualizations through direct manipulation of visual elements. Despite their promise, VPLs for data visualization remain underexplored, with few systems and limited understanding of their design space. In this paper, we explore the design space of VPLs for interactive data visualization through the creation of VisuaLang, a VPL that enables users to build interactive visualizations using a node-link diagram. We identify key design dimensions, including representation, composition, and interaction, and discuss how VisuaLang addresses challenges in expressiveness, usability, and learnability. Through a user study with 12 participants, we evaluate VisuaLang's effectiveness in supporting visualization creation tasks. Our findings reveal that while VisuaLang enables rapid prototyping of complex visualizations, users face difficulties in understanding data flow and managing visual complexity. We discuss implications for future VPL designs and opportunities for integrating AI assistance to enhance user experience.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Shin},
 booktitle = {Proceedings of the 7th {ACM}},
 doi = {10.1145/3719160.3736607},
 isbn = {979-8-4007-1527-3},
 keywords = {source: ACM},
 publisher = {Association for Computing Machinery},
 series = {{CUI}},
 title = {{PlanFitting}},
 url = {https://doi.org/10.1145/3719160.3736607},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:28:48Z},
 year = {2025}
}

@article{shin_qa_2023,
 abstract = {Obesity is a major risk factor for type 2 diabetes, cardiovascular disease, and certain types of cancer. The prevalence of obesity has increased dramatically over the past few decades, and this trend shows no signs of abating. Although genetic factors play a role in determining susceptibility to obesity, the recent increase in obesity prevalence is likely due to environmental factors, including increased availability of energy-dense foods and decreased physical activity. The adipose tissue is now recognized as an active endocrine organ that secretes a variety of hormones and cytokines, collectively termed adipokines, which play important roles in energy homeostasis and metabolism. Dysregulation of adipokine secretion in obesity contributes to the development of insulin resistance and other metabolic complications. This review focuses on the role of adipokines in the pathogenesis of obesity-related metabolic disorders, with particular emphasis on leptin, adiponectin, resistin, and visfatin. Understanding the complex interplay between adipokines and metabolic regulation may lead to novel therapeutic strategies for the treatment of obesity and its associated complications.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Shin},
 journal = {Annual …},
 keywords = {source: Google Scholar},
 note = {Publisher: Human and Language Technology
Type: CITATION},
 title = {{QA}},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:28:20Z},
 year = {2023}
}

@article{shin_thyro-genai_2025,
 abstract = {Background: Large language models (LLMs) have the potential to enhance information processing and clinical reasoning in the healthcare industry but are hindered by inaccuracies and hallucinations. The retrieval-augmented generation (RAG) technique may address these problems by integrating external knowledge sources. Methods: We developed a RAG-based chatbot called Thyro-GenAI by integrating a database of textbooks and guidelines with LLM. Thyro-GenAI and three service LLMs: OpenAI’s ChatGPT-4o, Perplexity AI’s ChatGPT-4o, and Anthropic’s Claude 3.5 Sonnet, were asked personalized clinical questions about thyroid disease. Three thyroid specialists assessed the quality of the generated responses and references without being blinded, which allowed them to interact with different chatbot interfaces. Results: Thyro-GenAI achieved the highest inverse-weighted mean rank for overall response quality. The overall inverse-weighted mean rankings for Thyro-GenAI, ChatGPT, Perplexity, and Claude were 3.0, 2.3, 2.8, and 1.9, respectively. Thyro-GenAI also achieved the second-highest inverse-weighted mean rank for overall reference quality. The overall inverse-weighted mean rankings for Thyro-GenAI, ChatGPT, Perplexity, and Claude were 3.1, 2.3, 3.2, and 1.8, respectively. Conclusions: Thyro-GenAI produced patient-specific clinical reasoning output based on a vector database, with fewer hallucinations and more reliability, compared to service LLMs. This emphasis on evidence-based responses ensures its safety and validity, addressing a critical limitation of existing LLMs. By integrating RAG with LLMs, it has the potential to support frontline clinical decision-making, especially helping first-line physicians by offering reliable decision support while managing thyroid disease patients.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 2; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Shin},
 doi = {10.3390/jcm14072450},
 journal = {Journal of Clinical Medicine},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {7},
 title = {Thyro-{GenAI}},
 url = {https://doi.org/10.3390/jcm14072450},
 volume = {14},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:41:31Z},
 year = {2025}
}

@inproceedings{shin_what_2025,
 abstract = {Recent advancements in large language models (LLMs) have enabled the creation of LLM-based agents that can perform complex tasks by interacting with external tools. However, these agents often struggle with long-horizon tasks that require multiple tool calls and careful planning. We introduce ToolChain, a framework that enhances LLM-based agents' ability to handle long-horizon tasks by automatically generating tool call chains. ToolChain consists of two key components: (1) a tool retriever that selects relevant tools based on the task description and current state, and (2) a chain generator that composes selected tools into executable chains using a graph-based planning approach. We evaluate ToolChain on a suite of long-horizon tasks spanning multiple domains, demonstrating significant improvements over baseline agents in terms of success rate and efficiency. Our results show that ToolChain enables agents to solve tasks that require up to 10 sequential tool calls, achieving up to 2.5x higher success rates compared to existing methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Shin},
 booktitle = {Proceedings of the 2025 {ACM}},
 design cards) and improve relevance to specific designers’ needs. in our preliminary study (n = {15)},
 doi = {10.1145/3715336.3735686},
 isbn = {979-8-4007-1485-6},
 keywords = {customization},
 pages = {1210--1227},
 publisher = {Association for Computing Machinery},
 series = {{DIS}},
 title = {What {About}},
