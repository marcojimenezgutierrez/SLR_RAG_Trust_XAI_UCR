 year = {2025}
}

@inproceedings{tuck_llms_2025,
 abstract = {Diffusion models have shown remarkable success in generating high-fidelity images. However, they can inadvertently perpetuate biases present in their training data, leading to unfair outcomes in generated content. In this paper, we propose DiffuFair, a novel regularization framework for diffusion models that promotes fairness without compromising generation quality. Our approach integrates a fairness loss into the denoising process, leveraging adversarial training to mitigate attribute bias while preserving semantic fidelity. We evaluate DiffuFair on multiple datasets, demonstrating significant reductions in bias metrics such as demographic parity and equalized odds, with minimal impact on standard image quality measures like FID and IS. Our method is plug-and-play, applicable to existing diffusion models, and offers a scalable solution for fair generative AI.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Tuck},
