@article{sardana_real-time_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their performance on complex reasoning tasks remains limited. In this paper, we introduce a novel framework for enhancing LLM reasoning through dynamic prompt engineering and iterative self-reflection. Our approach, called Reflexion, enables models to learn from their own mistakes by generating feedback and revising responses accordingly. We evaluate Reflexion on a suite of benchmarks including math word problems, coding challenges, and strategic games, demonstrating significant improvements over baseline methods. Specifically, Reflexion achieves up to 20% better accuracy on GSM8K and 15% on HumanEval without additional training data. Our findings suggest that self-reflective mechanisms can bridge the gap between current LLM capabilities and human-level reasoning, paving the way for more robust AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Sardana},
 journal = {arXiv preprint arXiv:2503.21157},
