 volume = {5},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:39:31Z},
 year = {2025}
}

@inproceedings{fu_medquery_2025,
 abstract = {We present a novel approach for dense semantic simultaneous localization and mapping (SLAM) that leverages neural implicit representations to achieve high-fidelity 3D reconstructions with semantic labels. Our method, Neural Implicit Dense Semantic SLAM (NIDS-SLAM), integrates a neural radiance field (NeRF)-like implicit scene representation with a semantic segmentation network to enable real-time, dense mapping in dynamic environments. By optimizing a continuous signed distance function (SDF) conditioned on both geometry and semantics, we achieve sub-millimeter accuracy in reconstruction while propagating semantic information across frames. Extensive experiments on benchmark datasets demonstrate that NIDS-SLAM outperforms state-of-the-art methods in terms of reconstruction quality, semantic consistency, and computational efficiency, making it suitable for robotics and augmented reality applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Fu},
 booktitle = {Proceedings of the 2025 {International}},
 doi = {10.1145/3731715.3733383},
 isbn = {979-8-4007-1877-9},
 keywords = {graph},
 note = {event-place: Chicago},
 pages = {321--329},
 publisher = {Association for Computing Machinery},
 series = {{ICMR}},
 title = {{MedQuery}},
 url = {https://doi.org/10.1145/3731715.3733383},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:13:57Z},
 year = {2025}
}

@article{fu_should_2025,
 abstract = {Relationships are essential to our happiness and wellbeing, yet their dissolution-the final stage of a relationship's lifecycle-is among the most stressful events individuals can experience, often leading to profound and lasting impacts. With the breakup process increasingly facilitated by technology, such as computer-mediated communication, and the likely future influence of generative AI tools, we conducted a semi-structured interview study with 21 participants. We aim to understand: 1) the current role of technology in the breakup process, 2) the needs and support individuals seek during this time, and 3) how GenAI might address or undermine these needs. Our findings show that people have distinct needs at various stages of breakups. While currently technology plays an important role, it falls short in supporting users' unmet needs. Participants envision that GenAI could: 1) aid in prompting self-reflection, providing neutral second opinions, and assisting with planning leading up to a breakup; 2) serve as a communication mediator, supporting wording and tone to facilitate emotional expression during breakup conversations; and 3) support personal growth and offer companionship after a breakup. However, our findings also reveal participants' various concerns about involving GenAI in this process. Based on our results, we discuss the potential opportunities, harms, and design implications of GenAI tools in facilitating people's relationship dissolution.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Fu},
 doi = {10.1145/3757424},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keywords = {ai-mediated relationship},
 month = {oct},
 note = {Place: New York},
 number = {7},
 title = {Should {ChatGPT}},
 url = {https://doi.org/10.1145/3757424},
 volume = {9},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:56Z},
 year = {2025}
}

@article{fu_spell_2025,
 abstract = {We present the Open Drug Discovery Toolkit (ODDT), an open-source software package for cheminformatics, molecular docking, and machine learning in drug discovery. ODDT provides a unified interface to several open-source libraries, including RDKit, Open Babel, and AutoDock Vina. It supports a wide range of tasks, such as molecule standardization, descriptor calculation, fingerprint generation, similarity searching, and molecular docking. Additionally, ODDT includes modules for machine learning, allowing users to train models for property prediction and virtual screening. The toolkit is designed to be modular and extensible, enabling the integration of new methods and data sources. We illustrate the use of ODDT with examples from virtual screening and lead optimization workflows. ODDT is open-source and available under the MIT license.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Fu},
 doi = {10.1021/acs.jcim.5c01236},
 journal = {Journal of Chemical Information …},
 keywords = {source: Google Scholar},
