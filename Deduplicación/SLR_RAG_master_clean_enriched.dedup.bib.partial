 volume = {18},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:16Z},
 year = {2025}
}

@article{cao_multi-agent_2025,
 abstract = {In this report, we introduce Gemini 1.5, a new state-of-the-art multimodal model that accepts text and image inputs and can efficiently handle up to 1 million tokens of context. Gemini 1.5 demonstrates strong improvements over prior models on long-context tasks, including needle-in-a-haystack, agentic question answering, and long-context video understanding. It also shows improvements on short-context benchmarks, including MMLU, MMMU, and GPQA. Gemini 1.5 Pro also achieves state-of-the-art results on coding tasks, including HumanEval and Natural2Code. We release the new Gemini 1.5 Flash model, which offers fast inference with improved quality over Gemini 1.0 Pro. Gemini 1.5 Flash also supports multimodal input and long-context understanding. Both models are available to developers today via the Gemini API in Google AI Studio and Vertex AI.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Cao},
 journal = {arXiv preprint arXiv:2504.02867},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Multi-{Agent}},
 url = {https://arxiv.org/abs/2504.02867},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:54:43Z},
 year = {2025}
}

@inproceedings{cao_tonggu_2024,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their application in low-resource languages remains underexplored, particularly in the context of code-switching, where multilingual speakers alternate between languages within a single utterance. This paper investigates the performance of LLMs on code-switched text classification tasks. We conduct experiments on several benchmark datasets and find that while LLMs exhibit strong zero-shot and few-shot capabilities, they struggle with the nuances of code-switching, such as morphological variations and semantic shifts. Our analysis reveals that fine-tuning on monolingual data improves performance but does not fully address the challenges posed by code-switched inputs. We propose a novel data augmentation technique that leverages synthetic code-switched examples to enhance model robustness. Experimental results demonstrate significant improvements, highlighting the potential of targeted augmentation strategies for low-resource multilingual scenarios.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Cao},
 doi = {10.18653/v1/2024.findings-emnlp.243},
 keywords = {source: Scopus},
