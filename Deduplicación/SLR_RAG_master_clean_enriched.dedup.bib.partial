@article{henkel_retrieval-augmented_2024,
 abstract = {This paper explores the use of multimodal data, including video, audio, and interaction logs, to detect disengagement in online learning environments. We propose a machine learning framework that fuses features from these modalities to classify student engagement levels in real-time. Using data from a large-scale MOOC platform, our model achieves an F1-score of 0.85, outperforming unimodal baselines. The findings highlight the importance of multimodal approaches for improving adaptive learning systems and providing timely interventions for at-risk students.},
