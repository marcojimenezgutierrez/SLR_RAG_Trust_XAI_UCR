 title = {{OpsEval}},
 url = {https://doi.org/10.1145/3696630.3728572},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:18:46Z},
 year = {2025}
}

@inproceedings{liu_optimizing_2025,
 abstract = {Time series forecasting (TSF) is crucial for various real-world applications, such as energy consumption prediction and traffic flow forecasting. Recently, large language models (LLMs) have shown remarkable success in various domains, including natural language processing and computer vision. However, their potential in TSF remains largely unexplored. In this paper, we propose LLM4TS, a novel framework that aligns pre-trained LLMs as data-efficient time series forecasters. Specifically, we first convert time series data into natural language descriptions and prompts, enabling LLMs to understand and process time series data. Then, we leverage the in-context learning capability of LLMs to perform zero-shot and few-shot forecasting without fine-tuning. Extensive experiments on eight real-world benchmark datasets demonstrate that LLM4TS achieves competitive performance compared to traditional TSF methods, especially in few-shot settings. Moreover, we conduct comprehensive analyses to provide insights into the effectiveness of our approach and discuss potential future directions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 4},
 author = {Liu},
 booktitle = {Proceedings of the 2024 3rd {International}},
 doi = {10.1145/3707292.3707358},
 isbn = {979-8-4007-0730-8},
 keywords = {Automotive Industry},
 note = {Type: Conference paper},
 pages = {152--159},
 publisher = {Association for Computing Machinery},
 series = {{AIIIP}},
 title = {Optimizing {RAG}},
 url = {https://doi.org/10.1145/3707292.3707358},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:41:04Z},
 year = {2025}
}

@inproceedings{liu_ora_2025,
 abstract = {Interactive data visualization tools empower users to explore and analyze data through direct manipulation. However, creating effective visualizations often requires programming skills, limiting accessibility. Visual programming languages (VPLs) offer a promising alternative by allowing users to build visualizations through graphical interfaces. Despite their potential, designing intuitive VPLs for data visualization remains challenging due to the complexity of data processing and rendering tasks. In this paper, we explore the design space of VPLs for interactive data visualization. We identify key design dimensions, including node representation, connection mechanisms, and feedback integration, and discuss trade-offs in usability and expressiveness. Through a series of design iterations and user studies, we evaluate prototypes that incorporate these dimensions. Our findings reveal that hybrid approaches combining visual and textual elements enhance user understanding and efficiency. We contribute design guidelines and a taxonomy to inform future VPL development for data visualization.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Liu},
 booktitle = {Proceedings of the 39th {ACM}},
 doi = {10.1145/3721145.3725757},
