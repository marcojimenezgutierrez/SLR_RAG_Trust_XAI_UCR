@inproceedings{mozafari_wikihint_2025,
 abstract = {We present Echo, a novel system that enables users to create interactive 3D environments using natural language descriptions. Echo leverages large language models (LLMs) and diffusion models to generate and refine 3D scenes from text prompts, allowing users to iteratively build and modify virtual spaces without specialized skills. Our approach integrates scene understanding, object placement, and lighting simulation to produce coherent and immersive environments. Through user studies, we demonstrate Echo's effectiveness in supporting creative tasks such as interior design and storytelling, outperforming traditional 3D modeling tools in accessibility and expressiveness.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
