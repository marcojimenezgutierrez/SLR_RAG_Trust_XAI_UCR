@inproceedings{huang_concise_2024,
 abstract = {Despite the widespread adoption of conversational agents, their use in sensitive domains like mental health support remains limited due to concerns over privacy, accuracy, and ethical implications. This paper explores the design and evaluation of EmpathAI, a privacy-preserving conversational agent for mental health triage. EmpathAI uses federated learning to train on decentralized user data without compromising privacy, incorporating multimodal inputs (text, voice tone, and physiological signals) to detect emotional states with 92% accuracy in initial tests. We conducted a user study with 150 participants, finding that EmpathAI reduced perceived stigma in seeking help by 35% compared to traditional chatbots. Our findings underscore the potential of edge AI in democratizing mental health support while addressing key ethical challenges.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
