 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Stall+: {Boosting}},
 url = {https://arxiv.org/abs/2406.10018},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:32:55Z},
 year = {2024}
}

@inproceedings{liu_symagent_2025,
 abstract = {This paper introduces EchoTrace, a novel interactive visualization system designed to facilitate the exploration and analysis of echo chambers in online social networks. Echo chambers, where users are exposed primarily to reinforcing viewpoints, pose significant challenges to societal discourse. EchoTrace integrates network analysis, topic modeling, and temporal visualization techniques to reveal the structure, dynamics, and content propagation within these chambers. Our system employs a multi-view interface that allows users to navigate user communities, track information flows, and inspect semantic similarities in discussions. Through a user study with journalists and social scientists, we demonstrate EchoTrace's effectiveness in uncovering hidden patterns of polarization and misinformation spread. We discuss design implications and future directions for mitigating echo chamber effects in digital platforms.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Liu},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3696410.3714768},
