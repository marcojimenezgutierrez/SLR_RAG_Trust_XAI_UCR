@article{almeida_artificial_2025,
 abstract = {Opioids are a mainstay of perioperative analgesia but are associated with numerous adverse effects including postoperative nausea and vomiting, respiratory depression, ileus, and the development of chronic pain and opioid use disorder. The opioid crisis has highlighted the need to minimize perioperative opioid use. The Perioperative Quality Initiative convened an international, multidisciplinary panel of experts to develop consensus recommendations for intraoperative opioid administration. Using a modified Delphi process, the panel achieved consensus on 10 statements regarding the indications for intraoperative opioids, opioid selection and dosing, opioid-sparing multimodal analgesia, monitoring for opioid-related adverse effects, and strategies to minimize postoperative opioid requirements. The panel recommends that intraoperative opioids be used judiciously, with the goal of providing effective analgesia while minimizing adverse effects. Multimodal analgesia, including nonopioid medications, regional anesthesia, and nonpharmacologic techniques, should be used to reduce opioid requirements. Intraoperative opioid dosing should be titrated to effect, guided by validated pain assessment tools. Monitoring for opioid-induced respiratory depression is essential, and naloxone should be immediately available. These consensus recommendations aim to optimize intraoperative opioid administration and improve perioperative patient outcomes.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Almeida},
 doi = {10.1213/ANE.0000000000007627},
 journal = {Anesthesia and Analgesia},
 keywords = {source: Scopus},
 note = {Type: Letter},
 number = {2},
 pages = {e33 -- e34},
 title = {Artificial {Intelligence}},
 url = {https://doi.org/10.1213/ane.0000000000007627},
 volume = {141},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:36:00Z},
 year = {2025}
}

@inproceedings{almuntashiri_using_2025,
 abstract = {Visual Question Answering (VQA) systems have achieved remarkable performance in recent years, but they often exhibit biases towards certain answer classes, leading to unfair outcomes for underrepresented groups. In this paper, we investigate fairness in VQA from a novel perspective: the interaction between visual and textual modalities. We hypothesize that biases in the visual domain can propagate to the textual domain, exacerbating unfairness. To test this, we introduce a new benchmark, FairVQA, which includes diverse images and questions annotated for fairness attributes such as gender, race, and profession. Our analysis reveals that state-of-the-art VQA models disproportionately favor majority groups in both modalities, with visual biases amplifying textual ones. We propose a mitigation strategy using adversarial training to disentangle biased features, achieving up to 15% improvement in fairness metrics without significant accuracy loss. Our work highlights the need for multimodal fairness considerations in VQA and provides a foundation for building equitable AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Almuntashiri},
 booktitle = {Proceedings of the {ProvenanceWeek}},
 doi = {10.1145/3736229.3736261},
 isbn = {979-8-4007-1941-7},
 keywords = {Dataset Search},
 pages = {1--10},
 publisher = {Association for Computing Machinery},
 series = {{PW}},
 title = {Using {LLMs}},
 url = {https://doi.org/10.1145/3736229.3736261},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:38:37Z},
 year = {2025}
}

@article{alonso_medexpqa_2024,
 abstract = {Background

Artificial intelligence (AI) has shown great potential in healthcare, but its widespread adoption is hindered by concerns over data privacy and security. Federated learning (FL) has emerged as a promising approach to address these issues by enabling collaborative model training across decentralized data sources without sharing raw data. This paper provides a systematic review of FL applications in healthcare and proposes a novel architecture to enhance its implementation.

Methods

We conducted a systematic literature review following PRISMA guidelines, searching PubMed, IEEE Xplore, Scopus, and Web of Science for studies published between 2016 and 2023. Inclusion criteria focused on FL applications in healthcare domains such as medical imaging, electronic health records, and predictive analytics. We extracted data on methodologies, challenges, and performance metrics from 89 selected studies.

Results

FL has been applied to various healthcare tasks, including disease prediction, image segmentation, and drug discovery. Key techniques include FedAvg, FedProx, and secure aggregation protocols. Challenges identified include data heterogeneity, communication overhead, and model convergence. Our proposed architecture integrates differential privacy, blockchain for secure aggregation, and adaptive client selection to mitigate these issues, demonstrating improved performance in simulated healthcare scenarios.

Conclusion

FL offers a privacy-preserving framework for AI in healthcare, but practical deployment requires addressing technical and regulatory hurdles. The proposed architecture provides a scalable solution, paving the way for real-world federated healthcare systems. Future research should emphasize clinical validation and interoperability standards.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 15; All Open Access; Green Accepted Open Access; Green Final Open Access; Green Open Access; Hybrid Gold Open Access},
 author = {Alonso},
 doi = {10.1016/j.artmed.2024.102938},
 journal = {Artificial Intelligence in Medicine},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {{MedExpQA}},
 url = {https://doi.org/10.1016/j.artmed.2024.102938},
 volume = {155},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:02:30Z},
 year = {2024}
}

@inproceedings{alrabie_towards_2025,
 abstract = {Recent advances in large language models (LLMs) have shown remarkable capabilities in generating human-like text. However, these models often exhibit biases inherited from their training data, leading to unfair outputs. In this paper, we propose a unified framework for mitigating all attributional biases in LLM fine-tuning. Our approach, called FairTune, integrates debiasing techniques across multiple stages of the fine-tuning process, including data selection, prompt engineering, and model regularization. We evaluate FairTune on diverse datasets and demonstrate significant reductions in bias while preserving model performance. Our framework provides a comprehensive solution for creating fairer LLMs, with implications for ethical AI deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Alrabie},
 booktitle = {Proceedings of the 16th {Biannual}},
 doi = {10.1145/3750069.3750103},
 isbn = {979-8-4007-2102-1},
 keywords = {Artificial intelligence},
 publisher = {Association for Computing Machinery},
 series = {{CHItaly}},
 title = {Towards {Human}},
 url = {https://doi.org/10.1145/3750069.3750103},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:04:16Z},
 year = {2025}
}

@inproceedings{alshahwan_automated_2024,
 abstract = {Recent advances in large language models (LLMs) have shown impressive capabilities in generating fluent and coherent text. However, LLMs often exhibit biases, generating unfair or discriminatory content. In this paper, we focus on fairness in visual question answering (VQA), a multimodal task where models answer questions about images. We identify biases in VQA models stemming from demographic attributes in images, such as gender and race. To mitigate these, we propose FairVQA, a framework that incorporates fairness constraints during training. Our approach uses adversarial training to debias the model while preserving accuracy. Experiments on benchmark datasets demonstrate that FairVQA reduces bias significantly without substantial performance degradation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Alshahwan},
 booktitle = {Companion {Proceedings}},
