@inproceedings{jiang_reasoning-enhanced_2025,
 abstract = {This study investigates the effects of climate change on agricultural productivity in sub-Saharan Africa using a panel data approach spanning 1980–2018. Employing fixed-effects regression models, we analyze how temperature and precipitation variations impact crop yields for major staples like maize, rice, and sorghum across 45 countries. Results indicate a significant negative correlation between rising temperatures and yields, with precipitation deficits exacerbating losses in rain-fed systems. Adaptation strategies, such as improved irrigation and drought-resistant varieties, are recommended to mitigate future risks. The findings underscore the urgency for policy interventions to enhance resilience in vulnerable farming communities.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
