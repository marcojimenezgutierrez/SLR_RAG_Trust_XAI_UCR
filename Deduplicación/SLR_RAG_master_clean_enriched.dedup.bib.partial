 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:30:05Z},
 year = {2025}
}

@inproceedings{zhao_noteit_2025,
 abstract = {Social media platforms have become a primary source of information for many people, but the spread of misinformation poses a significant threat to public discourse and decision-making. Detecting misinformation at scale requires automated systems that can identify false or misleading content efficiently. Traditional machine learning approaches often rely on content features like text and images, but they struggle with evolving tactics used by misinformation spreaders. In this paper, we propose a novel graph-based framework that leverages the structural properties of social media interactions to detect misinformation. Our approach models user interactions as a heterogeneous graph, where nodes represent users, posts, and topics, and edges capture relationships such as retweets, replies, and follows. We introduce a disentangled graph attention network that separates the learning of content semantics from interaction patterns, allowing the model to capture both the semantic fidelity of information and the anomalous propagation behaviors indicative of misinformation. Experiments on real-world datasets from Twitter and Facebook demonstrate that our method outperforms state-of-the-art baselines by up to 15% in AUC, particularly in low-resource settings with limited labeled data. Our framework also provides interpretable insights into the detected misinformation campaigns, aiding human moderators in verification tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhao},
 booktitle = {Proceedings of the 38th {Annual}},
 doi = {10.1145/3746059.3747626},
 isbn = {979-8-4007-2037-6},
 keywords = {multimodal large language model},
 publisher = {Association for Computing Machinery},
 series = {{UIST}},
 title = {{NoteIt}},
 url = {https://doi.org/10.1145/3746059.3747626},
 users can interact with the system to further customize the content and presentation formats of the notes according to their preferences. we conducted both a technical evaluation and a comparison user study (n = {36). The solid performance in objective metrics and the positive user feedback demonstrated the effectiveness of the pipeline and the overall usability of NoteIt.}},
