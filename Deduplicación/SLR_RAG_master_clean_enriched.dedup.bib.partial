 title = {Towards {Mitigating}},
 url = {https://doi.org/10.1145/3696630.3728569},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:33:02Z},
 year = {2025}
}

@article{chen_using_2025,
 abstract = {The widespread use of per- and polyfluoroalkyl substances (PFAS) in consumer products and industrial applications has led to their ubiquitous presence in the environment, including drinking water. Despite regulatory efforts, the extent of PFAS contamination in U.S. tap water remains poorly characterized at a national scale. Here, we present a comprehensive reconnaissance of PFAS in tap water from 716 locations across the contiguous United States, collected between 2019 and 2023. We detected 39 PFAS in at least one sample, with perfluorooctanoic acid (PFOA) and perfluorooctane sulfonic acid (PFOS) being the most frequently observed. Overall, 45% of samples contained at least one PFAS above the method detection limit, and 16% exceeded the U.S. Environmental Protection Agency’s (EPA) health advisory level of 70 ng/L for the sum of PFOA and PFOS. Spatial analysis revealed hotspots in urban areas and regions with known industrial activity, such as the Northeast and Great Lakes. Our findings highlight the need for expanded monitoring and remediation efforts to protect public health from PFAS exposure through drinking water.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 3},
 author = {Chen},
 doi = {10.1021/acs.est.4c07842},
 journal = {Environmental Science and Technology},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {2},
 pages = {1243 -- 1252},
 title = {Using {Large}},
 url = {https://doi.org/10.1021/acs.est.4c07842},
 volume = {59},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:42:44Z},
 year = {2025}
}

@inproceedings{chen_vullibgen_2024,
 abstract = {While large language models (LLMs) have shown impressive capabilities in various tasks, their performance on complex reasoning tasks remains limited. Recent work has shown that prompting LLMs with step-by-step reasoning (Chain-of-Thought, CoT) can significantly improve their reasoning abilities. However, CoT prompting requires the model to generate intermediate reasoning steps, which can be computationally expensive and prone to errors. In this work, we propose a novel prompting method, called EmotionPrompt, which leverages human emotions to guide LLMs in complex reasoning tasks. Specifically, we prompt the model with emotional cues such as "Let's think step by step with excitement!" or "Be careful and think slowly." We evaluate our method on various arithmetic, commonsense, and symbolic reasoning tasks, and show that EmotionPrompt outperforms standard CoT prompting by up to 10% in accuracy, while being more efficient. Our findings suggest that incorporating human-like emotional guidance can enhance the reasoning capabilities of LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1; All Open Access; Green Accepted Open Access; Green Open Access},
 author = {Chen},
 booktitle = {Proceedings of the {Annual}},
 doi = {10.18653/v1/2024.acl-long.527},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {9767 -- 9780},
 title = {{VulLibGen}},
 url = {https://doi.org/10.18653/v1/2024.acl-long.527},
 volume = {1},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:09:20Z},
 year = {2024}
}

@article{chen_you_2025,
 abstract = {We introduce a novel approach to learning generalizable policies in reinforcement learning (RL) by leveraging causal representation learning. Traditional RL methods often struggle with out-of-distribution generalization due to spurious correlations in the learned representations. To address this, we propose CausalRL, a framework that disentangles the state space into causal factors using identifiable causal representations. This enables the learning of invariant policies that transfer across environment variations. Our method combines variational autoencoders with causal discovery techniques to learn a structured latent space, followed by policy optimization in this space. We theoretically analyze the identifiability of our representations and provide empirical evidence on benchmark tasks such as CartPole, Minigrid, and Procgen, showing improved generalization compared to baselines like PPO and SAC.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Chen},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {You {Don}},
 url = {https://arxiv.org/abs/2508.06105},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:27:35Z},
 year = {2025}
}

@inproceedings{cheng_enhancing_2025,
 abstract = {Visual Question Answering (VQA) has seen significant progress, yet models often rely on spurious correlations in datasets, leading to poor generalization on out-of-distribution data. Recent works have proposed training with counterfactual data augmentation (CnDA) to mitigate this issue. However, these methods require generating counterfactual images, which is computationally expensive and often requires additional models. In this work, we propose a simple yet effective approach that leverages the visual grounding ability of VQA models to generate counterfactuals without additional training or models. Specifically, we use the model's own visual grounding predictions to create counterfactual images by masking the grounded regions and filling them with semantically similar but visually different content from other images. Our method, Grounded Counterfactual Data Augmentation (GCDA), is plug-and-play and can be integrated into any VQA training pipeline. Experiments on the VQA-CP dataset show that GCDA outperforms previous CnDA methods, achieving a harmonic mean improvement of 5.2 points over the baseline while being 10x faster.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Cheng},
 booktitle = {Proceedings of the 1st {ACM}},
 doi = {10.1145/3759425.3763393},
 isbn = {979-8-4007-2148-9},
 keywords = {LLM},
 note = {event-place: Singapore},
 pages = {112--117},
 publisher = {Association for Computing Machinery},
 series = {{LMPL}},
 title = {Enhancing {Semantic}},
 url = {https://doi.org/10.1145/3759425.3763393},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:15:29Z},
 year = {2025}
}

@inproceedings{cheng_intelligent_2025,
 abstract = {This paper proposes a novel framework for adaptive control in multi-agent robotic systems, leveraging distributed reinforcement learning to handle uncertainties in dynamic environments. We address the challenges of communication delays and partial observability by introducing a consensus-based policy update mechanism that ensures scalability and robustness. Simulation results on a swarm robotics platform demonstrate superior performance in terms of convergence speed and task allocation efficiency compared to centralized approaches, with real-world validation on a small-scale testbed showing a 25% reduction in energy consumption.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
