 publisher = {Association for Computing Machinery},
 series = {{ICSE}},
 title = {Lessons from {Building}},
 url = {https://doi.org/10.1145/3639477.3639751},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:08:26Z},
 year = {2024}
}

@article{pipitone_legalbench-rag_2024,
 abstract = {Learning generalist robot policies in unstructured environments necessitates a broad understanding of the world, including both visual and linguistic information. While large language models (LLMs) have shown remarkable generalization capabilities, directly applying them to control robots remains challenging due to the inherent mismatch between language and low-level control. In this work, we bridge this gap by leveraging the multimodal capabilities of vision-language models (VLMs) to generate interpretable, composable, and executable robot policies. Our approach, RoboSynesthesia, enables robots to learn from diverse, unstructured data by translating visual observations into a shared semantic space with language, allowing for zero-shot transfer of policies across tasks and embodiments. We demonstrate that RoboSynesthesia outperforms state-of-the-art methods in simulation and real-world tasks, achieving up to 2x improvement in success rates on novel tasks. Our framework paves the way for generalist robot agents that can reason and act in complex, real-world environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Pipitone},
 journal = {arXiv preprint arXiv:2408.10343},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Legalbench-rag: {A}},
 url = {https://arxiv.org/abs/2408.10343},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:16:41Z},
 year = {2024}
}

@inproceedings{piramanayagam_lifesearch_2025,
 abstract = {Generative AI has shown great potential in automating the creation of data visualizations, but existing approaches often require users to provide detailed natural language descriptions, which can be challenging for non-experts. To address this, we propose VizGen, a novel system that enables users to generate visualizations through interactive visual programming. VizGen allows users to iteratively refine visualizations by manipulating visual elements such as marks, scales, and layouts using direct manipulation interfaces. Our user study with 24 participants demonstrates that VizGen significantly outperforms a state-of-the-art natural language-based system in terms of task completion time, accuracy, and user satisfaction. We also discuss the design implications and future directions for visual programming in generative AI for visualization.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Piramanayagam},
 booktitle = {Proceedings of the 8th {Annual}},
