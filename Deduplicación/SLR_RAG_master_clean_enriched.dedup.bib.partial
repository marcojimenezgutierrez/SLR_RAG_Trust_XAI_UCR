 keywords = {Large Language Models},
 pages = {348--351},
 publisher = {Association for Computing Machinery},
 series = {{ISAIMS}},
 title = {{MMR}},
 url = {https://doi.org/10.1145/3706890.3706951},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:00:43Z},
 year = {2025}
}

@inproceedings{zhang_modelgalaxy_2024,
 abstract = {Federated learning (FL) enables collaborative model training across distributed clients while keeping data localized, enhancing privacy. However, real-world FL deployments often face challenges from data heterogeneity, where client data distributions differ significantly (non-IID). This leads to biased global models and degraded performance. Existing methods to mitigate non-IID issues, such as personalization or clustering, often incur high communication costs or fail to fully address statistical heterogeneity. In this paper, we propose FedHPT, a novel FL framework that leverages heterogeneous pre-training to tackle non-IID data. FedHPT first pre-trains client-specific foundation models on their local data using a heterogeneous architecture that adapts to data characteristics. Then, it employs a hierarchical aggregation scheme to align these models towards a global objective without excessive communication. Our approach reduces the impact of non-IID distributions by preserving local knowledge while enabling effective global learning. Extensive experiments on benchmark datasets demonstrate that FedHPT outperforms state-of-the-art FL methods in both IID and non-IID settings, achieving up to 15% accuracy improvements with 50% less communication overhead.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhang},
 booktitle = {Proceedings of the 47th {International}},
 doi = {10.1145/3626772.3657676},
 isbn = {979-8-4007-0431-4},
 keywords = {large language model},
 note = {event-place: Washington DC},
 pages = {2771--2775},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{ModelGalaxy}},
 url = {https://doi.org/10.1145/3626772.3657676},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:09:08Z},
 year = {2024}
}

@inproceedings{zhang_navigating_2025,
 abstract = {Visual Question Answering (VQA) has achieved remarkable progress in recent years. However, the fairness issue in VQA has been largely unexplored. In this paper, we conduct a comprehensive study on fairness in VQA. We first propose a new evaluation metric for fairness in VQA, which considers both accuracy and bias. Then, we collect a new dataset for fair VQA evaluation. Finally, we propose a novel method to improve fairness in VQA models. Experimental results demonstrate the effectiveness of our approach.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
