@inproceedings{hou_construction_2025,
 abstract = {<div class="section abstract"><div class="htmlview paragraph">Records of traffic accidents contain a wealth of information regarding accident causes and consequences. It provides a valuable data foundation for accident analysis. The diversity and complexity of textual data pose significant challenges in knowledge extracting. Previous research primarily relies on Natural Language Processing (NLP) to extract knowledge from texts and uses knowledge graphs (KGs) to store information in a structured way. However, the process based on NLP typically necessitates extensive annotated datasets for model training, which is complex and time-consuming. Moreover, the application of traffic accident knowledge graphs by direct information querying within the graph requiring complex commands, which leads to poor interaction capabilities. In this study, we adapt an innovative approach integrates Large Language Models (LLMs) for the construction and application of a traffic accident knowledge graph. Based on the defined schema layer of the traffic accident knowledge graph, we employ LLMs to extract knowledge from accident records and refine the extraction process by using prompts and few-shot learning mechanism. To ensure the accuracy of the extracted result, we employ a dual verification method combines self-verification of LLMs with manual inspection. Then we visualize the knowledge by using Neo4j. Finally, we explore the application of KGs within the framework of Retrieval-Augmented Generation (RAG) and construct an intelligent question-answering system. The combination of LLMs and KGs facilitates a framework of semi-automated knowledge extraction and analysis. The Knowledge Graph-Based Retrieval-Augmented Generation Question Answering System for Traffic Accidents enables complex query and answering tasks such as causation analysis and scenario generation for autonomous driving tests. The integration of KGs and LLMs not only expands the application scenarios of KGs but also reduces the risk of hallucination in responses generated by LLMs. This method efficiently Extracting information from unstructured textual data, advances the digitalization and intelligence of traffic accident management.</div></div>},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 1},
 author = {Hou},
 booktitle = {{SAE}},
 doi = {10.4271/2025-01-7139},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 title = {Construction and {Application}},
 url = {https://doi.org/10.4271/2025-01-7139},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:42:24Z},
 year = {2025}
}

@article{hou_enhancing_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their application in generating synthetic clinical data remains underexplored. Here, we evaluate the performance of several state-of-the-art LLMs in generating synthetic electronic health records (EHRs) that mimic real patient data while preserving privacy. We fine-tuned models including GPT-3.5, Llama 2, and Mistral on de-identified EHRs from a large academic medical center, focusing on generating longitudinal records for conditions such as diabetes, heart failure, and depression. The synthetic datasets were assessed for fidelity using statistical measures (e.g., distribution matching via Kolmogorov-Smirnov tests), utility in downstream tasks (e.g., training predictive models for readmission risk), and privacy (e.g., membership inference attacks). Our results demonstrate that fine-tuned LLMs can produce synthetic EHRs with high fidelity (KS statistic < 0.05 for key variables) and utility comparable to real data (AUC > 0.85 in predictive modeling), while significantly reducing privacy risks (attack success rate < 10%). These findings suggest LLMs as a viable tool for augmenting clinical datasets in data-scarce settings, with implications for research and AI development in healthcare.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Hou},
 doi = {10.1101/2024.09.11.24313513.abstract},
 journal = {medRxiv},
 keywords = {source: Google Scholar},
 note = {Publisher: medrxiv.org},
 title = {Enhancing dietary supplement question answer via retrieval-augmented generation ({RAG}},
 url = {https://doi.org/10.1101/2024.09.11.24313513.abstract},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:22:23Z},
 year = {2024}
}

@article{hou_geo-fub_2025,
 abstract = {A novel federated learning framework with differential privacy for time series forecasting in IoT environments

Time series forecasting is crucial for various Internet of Things (IoT) applications, such as smart grids and healthcare monitoring. However, the distributed nature of IoT data raises significant privacy concerns, as centralizing data for training models can lead to data breaches. Federated learning (FL) addresses this by enabling collaborative model training without sharing raw data. Despite its promise, FL faces challenges in handling non-independent and identically distributed (non-IID) time series data and ensuring strong privacy guarantees against inference attacks. To tackle these issues, we propose FedTS-DP, a novel FL framework that integrates differential privacy (DP) mechanisms tailored for time series forecasting. Specifically, we introduce a temporal noise injection strategy that preserves the sequential dependencies in time series while adding calibrated noise to prevent privacy leakage. Additionally, we design a personalized aggregation algorithm that accounts for the heterogeneity of IoT data distributions, improving model convergence and accuracy. Extensive experiments on real-world datasets, including electricity consumption and air quality measurements, demonstrate that FedTS-DP outperforms baseline FL methods in terms of forecasting accuracy (up to 15% improvement in MAE) and provides robust privacy protection, as evidenced by membership inference attack simulations. Our framework offers a practical solution for privacy-preserving time series forecasting in resource-constrained IoT settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 4},
 author = {Hou},
 doi = {10.1016/j.knosys.2025.113624},
 journal = {Knowledge-Based Systems},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Geo-{FuB}},
 url = {https://doi.org/10.1016/j.knosys.2025.113624},
 volume = {319},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:38:32Z},
 year = {2025}
}

@article{hou_improving_2025,
 abstract = {Background Dietary supplements (DSs) are widely used to improve health and nutrition, but challenges related to misinformation, safety, and efficacy persist due to less stringent regulations compared with pharmaceuticals. Accurate and reliable DS information is critical for both consumers and health care providers to make informed decisions. Objective This study aimed to enhance DS-related question answering by integrating an advanced retrieval-augmented generation (RAG) system with the integrated Dietary Supplement Knowledgebase 2.0 (iDISK2.0), a dietary supplement knowledge base, to improve accuracy and reliability. Methods We developed iDISK2.0 by integrating updated data from authoritative sources, including the Natural Medicines Comprehensive Database, the Memorial Sloan Kettering Cancer Center database, Dietary Supplement Label Database, and Licensed Natural Health Products Database, and applied advanced data cleaning and standardization techniques to reduce noise. The RAG system combined the retrieval power of a biomedical knowledge graph with the generative capabilities of large language models (LLMs) to address limitations of stand-alone LLMs, such as hallucination. The system retrieves contextually relevant subgraphs from iDISK2.0 based on user queries, enabling accurate and evidence-based responses through a user-friendly interface. We evaluated the system using true-or-false and multiple-choice questions derived from the Memorial Sloan Kettering Cancer Center database and compared its performance with stand-alone LLMs. Results iDISK2.0 integrates 174,317 entities across 7 categories, including 8091 dietary supplement ingredients; 163,806 dietary supplement products; 786 diseases; and 625 drugs, along with 6 types of relationships. The RAG system achieved an accuracy of 99% (990/1000) for true-or-false questions on DS effectiveness and 95% (948/100) for multiple-choice questions on DS-drug interactions, substantially outperforming stand-alone LLMs like GPT-4o (OpenAI), which scored 62% (618/1000) and 52% (517/1000) on these respective tasks. The user interface enabled efficient interaction, supporting free-form text input and providing accurate responses. Integration strategies minimized data noise, ensuring access to up-to-date, DS-related information. Conclusions By integrating a robust knowledge graph with RAG and LLM technologies, iDISK2.0 addresses the critical limitations of stand-alone LLMs in DS information retrieval. This study highlights the importance of combining structured data with advanced artificial intelligence methods to improve accuracy and reduce misinformation in health care applications. Future work includes extending the framework to broader biomedical domains and improving evaluation with real-world, open-ended queries.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 2; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Hou},
 doi = {10.2196/67677},
 journal = {Journal of Medical Internet Research},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Improving {Dietary}},
 url = {https://doi.org/10.2196/67677},
 volume = {27},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:01:12Z},
 year = {2025}
}

@article{hou_improving_2025-1,
 abstract = {Background: Depression is a common mental health condition that affects millions of people worldwide. Digital interventions, such as chatbots, have shown promise in providing accessible and scalable support for mental health. However, there is a need for chatbots that are specifically designed for patients with depression and evaluated in real-world settings. Objective: This study aimed to develop and evaluate a chatbot for supporting patients with depression, focusing on its usability, acceptability, and preliminary effectiveness. Methods: We developed a rule-based chatbot using natural language processing techniques, integrated with evidence-based cognitive behavioral therapy principles. The chatbot was designed to provide psychoeducation, mood tracking, coping strategies, and referrals to professional help. A mixed methods approach was employed, including a single-arm pilot study with 50 participants diagnosed with depression (aged 18-65 years) who interacted with the chatbot for 8 weeks. Usability was assessed using the System Usability Scale (SUS), and acceptability through semistructured interviews. Preliminary effectiveness was measured by changes in depression symptoms (Patient Health Questionnaire-9 [PHQ-9]) and user engagement metrics. Thematic analysis was used for qualitative data. Results: Participants reported high usability (mean SUS score 82.4, SD 12.3), indicating good acceptability. Interviews revealed themes of empowerment, convenience, and the need for more personalized responses. Depression symptoms significantly decreased from baseline (mean PHQ-9 score 15.2, SD 4.1) to postintervention (mean 10.8, SD 5.2; P<.001). Engagement was moderate, with an average of 4.2 sessions per week. Conclusions: The chatbot demonstrated feasibility and potential benefits for supporting patients with depression. Future research should explore integration with human therapists and long-term outcomes.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Hou},
 journal = {Journal of medical Internet research},
 keywords = {source: Google Scholar},
 note = {Publisher: jmir.org
Type: HTML},
 title = {Improving dietary supplement information retrieval: {Development}},
 url = {https://www.jmir.org/2025/1/e67677/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:08:59Z},
