@inproceedings{kambhamettu_explainable_2024,
 abstract = {Prompt engineering has emerged as a critical practice for effectively leveraging large language models (LLMs). However, the ad hoc and iterative nature of crafting prompts makes it challenging to systematically explore and refine them. We introduce ChainForge, a research prototype that enables visual prompt engineering. ChainForge allows users to author, run, and debug LLM prompts using a node-based visual interface. It supports a variety of prompt patterns, including few-shot examples, chain-of-thought reasoning, and tree-of-thoughts exploration. Users can visualize prompt structures, execute multiple prompt variants in parallel, and compare LLM outputs side-by-side to test hypotheses about model behavior. Through a study with 12 participants, we found that ChainForge significantly reduced the time required to create effective prompts and enabled new forms of experimentation and insight generation. Our work demonstrates the value of visual tools for making prompt engineering more accessible, efficient, and rigorous.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Kambhamettu},
