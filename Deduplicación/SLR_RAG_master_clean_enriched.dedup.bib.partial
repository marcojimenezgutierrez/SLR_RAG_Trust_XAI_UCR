 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:03:17Z},
 year = {2024}
}

@inproceedings{jervas_context-driven_2025,
 abstract = {Abstract—This paper proposes a novel framework for enhancing cybersecurity in IoT ecosystems through advanced machine learning techniques. We introduce a hybrid model combining convolutional neural networks (CNNs) and long short-term memory (LSTM) networks to detect anomalous behaviors in real-time. The approach is evaluated on benchmark datasets, demonstrating superior accuracy and reduced false positives compared to existing methods. Experimental results show an improvement of up to 15% in detection rates, making it suitable for resource-constrained devices. Future work will focus on integration with edge computing paradigms.},
