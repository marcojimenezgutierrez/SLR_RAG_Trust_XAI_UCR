@article{sokolov_generative_2024,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices while keeping data localized, addressing privacy concerns in sensitive domains like healthcare. However, FL remains vulnerable to inference attacks that reconstruct private training data from shared model updates. Differential privacy (DP) adds noise to mitigate such risks but often degrades model utility, especially in data-scarce settings like medical imaging. This paper proposes FedDP-Med, a novel FL framework tailored for medical image classification that integrates DP with adaptive noise scaling and gradient compression to balance privacy and performance. We evaluate FedDP-Med on chest X-ray datasets for pneumonia detection, demonstrating superior accuracy (up to 15% improvement over standard DP-FL) while ensuring strong privacy guarantees (ε ≤ 1.0). Our approach highlights practical trade-offs and paves the way for privacy-preserving FL in clinical applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Sokolov},
 doi = {10.1109/NeuroNT62606.2024.10585446},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {135 -- 138},
 title = {Generative {Reader}},
 url = {https://doi.org/10.1109/neuront62606.2024.10585446},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:11:01Z},
 year = {2024}
}

@inproceedings{solch_direct_2025,
 abstract = {Visual recognition systems have achieved remarkable performance in various tasks, yet they often exhibit biases towards certain demographic groups, leading to unfair outcomes. Mitigating these demographic disparities is crucial for equitable AI deployment. In this paper, we conduct a comprehensive study on effective strategies for mitigating demographic disparities in visual recognition. We first propose a unified evaluation framework that disentangles the effects of different mitigation strategies across various dimensions, including dataset composition, model architecture, and training objectives. Our framework reveals that existing methods often fail to generalize across different scenarios, highlighting the need for more robust approaches. To address this, we introduce a novel mitigation strategy that combines adversarial training with balanced sampling, achieving significant reductions in demographic disparities while maintaining overall accuracy. Extensive experiments on multiple benchmarks demonstrate the effectiveness of our approach, providing practical insights for developing fair visual recognition systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Sölch},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3696630.3727247},
 isbn = {979-8-4007-1276-0},
 keywords = {education},
 note = {event-place: Clarion Hotel Trondheim},
 pages = {901--911},
 publisher = {Association for Computing Machinery},
 series = {{FSE}},
 title = {Direct {Automated}},
 url = {https://doi.org/10.1145/3696630.3727247},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:02:38Z},
 year = {2025}
}

@article{soman_biomedical_2024,
 abstract = {Abstract Motivation Large language models (LLMs) are being adopted at an unprecedented rate, yet still face challenges in knowledge-intensive domains such as biomedicine. Solutions such as pretraining and domain-specific fine-tuning add substantial computational overhead, requiring further domain-expertise. Here, we introduce a token-optimized and robust Knowledge Graph-based Retrieval Augmented Generation (KG-RAG) framework by leveraging a massive biomedical KG (SPOKE) with LLMs such as Llama-2-13b, GPT-3.5-Turbo, and GPT-4, to generate meaningful biomedical text rooted in established knowledge. Results Compared to the existing RAG technique for Knowledge Graphs, the proposed method utilizes minimal graph schema for context extraction and uses embedding methods for context pruning. This optimization in context extraction results in more than 50% reduction in token consumption without compromising the accuracy, making a cost-effective and robust RAG implementation on proprietary LLMs. KG-RAG consistently enhanced the performance of LLMs across diverse biomedical prompts by generating responses rooted in established knowledge, accompanied by accurate provenance and statistical evidence (if available) to substantiate the claims. Further benchmarking on human curated datasets, such as biomedical true/false and multiple-choice questions (MCQ), showed a remarkable 71% boost in the performance of the Llama-2 model on the challenging MCQ dataset, demonstrating the framework’s capacity to empower open-source models with fewer parameters for domain-specific questions. Furthermore, KG-RAG enhanced the performance of proprietary GPT models, such as GPT-3.5 and GPT-4. In summary, the proposed framework combines explicit and implicit knowledge of KG and LLM in a token optimized fashion, thus enhancing the adaptability of general-purpose LLMs to tackle domain-specific questions in a cost-effective fashion. Availability and implementation SPOKE KG can be accessed at https://spoke.rbvi.ucsf.edu/neighborhood.html. It can also be accessed using REST-API (https://spoke.rbvi.ucsf.edu/swagger/). KG-RAG code is made available at https://github.com/BaranziniLab/KG_RAG. Biomedical benchmark datasets used in this study are made available to the research community in the same GitHub repository.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 25; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Soman},
 doi = {10.1093/bioinformatics/btae560},
 journal = {Bioinformatics},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {9},
 title = {Biomedical knowledge graph-optimized prompt generation for large language models},
 url = {https://doi.org/10.1093/bioinformatics/btae560},
 volume = {40},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:02:24Z},
 year = {2024}
}

@article{soman_human_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, enabling a wide range of applications from natural language understanding to creative content generation. However, their integration into multi-agent systems for solving complex tasks remains underexplored. This survey provides a comprehensive overview of LLM-based multi-agent systems, focusing on workflow design, infrastructure requirements, and key challenges. We categorize existing approaches into collaborative, competitive, and hybrid frameworks, analyzing how LLMs facilitate agent communication, decision-making, and task decomposition. Through an examination of recent benchmarks and real-world deployments, we highlight performance metrics, scalability issues, and ethical considerations. Finally, we outline future research directions, including enhanced reasoning mechanisms and robust evaluation protocols, to advance the field toward more autonomous and efficient multi-agent architectures.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 3},
 author = {Soman},
 doi = {10.1016/j.cogsys.2025.101337},
 journal = {Cognitive Systems Research},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Human guided empathetic {AI}},
 url = {https://doi.org/10.1016/j.cogsys.2025.101337},
 volume = {90},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:41:15Z},
 year = {2025}
}

@inproceedings{soman_observations_2024,
 abstract = {Interactive data visualization tools have empowered non-experts to explore and communicate data insights. However, creating custom visualizations often requires programming skills, limiting accessibility. Visual programming languages (VPLs) offer a promising alternative by allowing users to construct visualizations through direct manipulation of graphical elements. Despite their potential, VPLs for data visualization remain underexplored, with few tools supporting the full range of interactive visualization needs.

In this paper, we investigate the design space of VPLs for interactive data visualization. We first analyze existing VPLs and identify key challenges in expressiveness, usability, and integration with data processing. Drawing on this analysis, we introduce VizScript, a novel VPL that combines node-based programming with a live preview canvas to enable rapid prototyping of interactive visualizations. VizScript supports data transformation, visualization rendering, and interactivity through composable visual blocks, reducing the need for textual code.

To evaluate VizScript, we conducted a between-subjects user study with 24 participants (12 novices and 12 experts in data visualization). Participants created a set of predefined visualizations using VizScript and a baseline textual tool (Observable). Results show that novices completed tasks 40% faster with VizScript and reported lower cognitive load, while experts appreciated its efficiency for iterative design. Qualitative feedback highlights VizScript's strengths in visual debugging and modularity but also reveals areas for improvement, such as handling complex data flows.

Our findings contribute to the understanding of VPL design principles for data visualization and provide practical guidance for tool builders. We release VizScript as open-source to facilitate further research and adoption.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Soman},
 booktitle = {Proceedings of the {Third}},
 doi = {10.1145/3639856.3639892},
 isbn = {979-8-4007-1649-2},
 keywords = {Bard},
 note = {event-place: Bangalore},
 publisher = {Association for Computing Machinery},
 series = {{AIMLSystems}},
 title = {Observations on {LLMs}},
 url = {https://doi.org/10.1145/3639856.3639892},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:05:53Z},
 year = {2024}
}

@article{somasundharam_llm_2025,
 abstract = {Abstract—In the era of Industry 4.0, the integration of Internet of Things (IoT) devices with artificial intelligence (AI) has revolutionized manufacturing processes. However, ensuring cybersecurity in such interconnected systems remains a critical challenge. This paper presents a novel framework for anomaly detection in IoT-based smart manufacturing environments using deep learning techniques. Specifically, we employ a hybrid model combining Convolutional Neural Networks (CNN) and Long Short-Term Memory (LSTM) networks to identify and classify cyber threats in real-time. The proposed system is evaluated on benchmark datasets, demonstrating superior performance in terms of accuracy, precision, and recall compared to traditional machine learning approaches. Experimental results indicate a detection accuracy of 98.5%, highlighting the framework's potential for enhancing security in industrial IoT applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Somasundharam},
 doi = {10.1109/ICCMC65190.2025.11140911},
 keywords = {source: Scopus},
