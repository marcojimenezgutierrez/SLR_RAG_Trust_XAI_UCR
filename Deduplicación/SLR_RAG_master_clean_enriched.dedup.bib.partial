@inproceedings{agrawal_algoace_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has transformed various sectors, including healthcare, finance, and transportation. This study explores the ethical implications of AI deployment in autonomous systems, focusing on decision-making algorithms in self-driving vehicles. Through a combination of qualitative analysis and simulation modeling, we examine potential biases in AI training data and their societal impacts. Our findings reveal that without robust regulatory frameworks, AI systems may exacerbate inequalities and pose risks to public safety. We propose a multi-stakeholder approach to AI governance, emphasizing transparency, accountability, and interdisciplinary collaboration to ensure equitable and responsible AI development.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
