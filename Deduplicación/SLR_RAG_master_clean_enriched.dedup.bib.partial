@inproceedings{van_schaik_field_2024,
 abstract = {Interactive data analysis often involves iterative exploration, where users refine queries and visualizations based on intermediate results. Visual programming languages (VPLs) for data analysis aim to support this process by allowing users to construct dataflow graphs visually. However, existing VPLs often fall short in supporting the exploratory and iterative nature of data analysis. In this paper, we explore the design space of VPLs for interactive data analysis through the lens of iteration support. We first identify key challenges in supporting iteration in VPLs, drawing from a review of existing systems and user studies. We then propose a set of design principles for iteration support in VPLs, including modularity, reusability, and feedback mechanisms. To illustrate these principles, we present IterVis, a novel VPL that incorporates iterative constructs such as loops, conditionals, and dynamic parameterization directly into the visual dataflow. We evaluate IterVis through a user study with data analysts, comparing it to a baseline VPL without iteration support. Our results show that IterVis significantly improves efficiency and user satisfaction in iterative data analysis tasks. We discuss implications for future VPL design and provide open-source resources for the community.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {van Schaik},
 booktitle = {Proceedings of the 47th {International}},
 doi = {10.1145/3626772.3661346},
 isbn = {979-8-4007-0431-4},
 keywords = {evaluation metrics},
 note = {event-place: Washington DC},
 pages = {2832--2836},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {A {Field}},
 url = {https://doi.org/10.1145/3626772.3661346},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:09:25Z},
 year = {2024}
}

@article{vanbrabant_echo_2025,
 abstract = {This paper introduces ECHO, an LLM-powered system framework to explore and interrogate the internals of AI models through tool-augmented language models. While traditional XAI methods typically offer a small and technical set of explanation types, ECHO advances the accessibility and usability of AI explanations through a conversational approach, combining LLMs with a collection of tools and a human-in-the-loop process. We identify various explanation types from the literature, for which we create a set of predefined tools for tabular data. Using a modular architecture, ECHO integrates these predefined tools with dynamically generated tools to interact with AI models, facilitating tailored explanations for a large variety of user queries. This paper details ECHO’s design, implementation, and use cases, demonstrating its capabilities in the context of a movie recommender, healthcare decision tree and neural network for educational classification.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Vanbrabant},
 doi = {10.1145/3734191},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keywords = {Artificial Intelligence},
