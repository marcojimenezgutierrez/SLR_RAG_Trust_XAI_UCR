@inproceedings{pandini_exploratory_2025,
 abstract = {Microservices have become a popular architectural style for building distributed systems due to their scalability and flexibility. However, the decentralized nature of microservices introduces unique challenges in testing, particularly in ensuring the reliability and performance of interactions between services. This paper presents a systematic mapping study on testing practices for microservices architectures. We reviewed 92 primary studies published between 2015 and 2024, classifying them based on testing levels (unit, integration, system, and end-to-end), techniques (mocking, contract testing, chaos engineering), and tools (Postman, WireMock, Pact). Our analysis reveals that while unit testing is well-covered, integration and performance testing remain underexplored, with a lack of standardized approaches for distributed environments. We identify key trends, challenges, and gaps in the literature, providing recommendations for practitioners and future research directions to enhance microservices testing efficacy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
