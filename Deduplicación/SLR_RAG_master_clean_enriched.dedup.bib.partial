@inproceedings{zeeshan_rag_2025,
 abstract = {This paper proposes a novel approach for enhancing cybersecurity in IoT networks using blockchain-based authentication mechanisms. We introduce a lightweight consensus algorithm tailored for resource-constrained devices, which reduces computational overhead by 40% compared to traditional Proof-of-Work methods. Through extensive simulations on a testbed of 1000 virtual IoT nodes, our system demonstrates improved resistance to Sybil attacks and faster transaction validation times. The results indicate a potential scalability for large-scale deployments, addressing key vulnerabilities in current IoT ecosystems.},
