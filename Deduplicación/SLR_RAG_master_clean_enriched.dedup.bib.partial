 year = {2025}
}

@inproceedings{du_sc-telco_2024,
 abstract = {With the proliferation of Internet of Things (IoT) devices, edge computing has emerged as a key enabler for processing data closer to the source, reducing latency and bandwidth usage. However, training machine learning models on resource-constrained edge devices remains challenging. Federated Learning (FL) offers a decentralized approach where models are trained collaboratively across devices without sharing raw data, preserving privacy. This paper provides a comprehensive survey on FL in edge computing environments. We first outline the fundamentals of FL and edge computing, highlighting their synergy. Then, we categorize and analyze existing FL frameworks, algorithms, and optimization techniques tailored for edge scenarios, addressing challenges such as heterogeneity, communication overhead, and security. We also discuss real-world applications, evaluation metrics, and open research directions to advance FL deployment at the edge.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Du},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/GCWkshp64532.2024.11100862},
 keywords = {5G mobile communication},
 month = {dec},
 note = {ISSN: 2166-0077},
 pages = {1--6},
 title = {{SC}},
 url = {https://doi.org/10.1109/gcwkshp64532.2024.11100862},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:11:46Z},
 year = {2024}
}

@article{duan_pgtuner_2025,
 abstract = {Approximate Nearest Neighbor Search (ANNS) plays a crucial role in many key areas. Proximity graphs (PGs) are the leading method for ANNS, offering the best balance between query efficiency and accuracy. However, their performance heavily depends on various construction and query parameters, which are difficult to optimize due to their complex interdependencies. Given that users often prioritize specific accuracy levels, efficiently identifying the optimal PG configurations to meet these targets is essential. Although some studies have explored automatic configuration tuning for PGs, they are limited by inefficiencies and suboptimal results. These issues stem from the need to construct numerous PGs for searching and re-tuning from scratch whenever the dataset changes, as well as the failure to capture the complex dependencies between configurations, query performance, and tuning objectives. To address these challenges, we propose PGTuner, an efficient framework for automatic PG configuration tuning leveraging pre-training knowledge and model transfer techniques. PGTuner improves efficiency through a pre-trained query performance prediction (QPP) model, eliminating the need to build multiple PGs. It also features a deep reinforcement learning-based parameter configuration recommendation (PCR) model to recommend optimal configurations for specific datasets and accuracy targets. Additionally, PGTuner incorporates out-of-distribution detection and deep active learning for efficient tuning in dynamic scenarios and transferring to new datasets. Extensive experiments demonstrate that PGTuner can stably achieve the top-level tuning effect across different datasets while significantly improving tuning efficiency by up to 14.69X, with a 14.64X boost in dynamic scenarios. The code and data for PGTuner are available online at https://github.com/hao-duan/PGTuner.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Duan},
 doi = {10.1145/3749179},
 journal = {Proc. ACM Manag. Data},
 keywords = {approximate nearest neighbor search},
 month = {sep},
 note = {Place: New York},
 number = {4},
 title = {{PGTuner}},
 url = {https://doi.org/10.1145/3749179},
 volume = {3},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:54Z},
 year = {2025}
}

@article{duan_research_2025,
 abstract = {Introduction Traditional Chinese Medicine (TCM) case records encapsulate vast clinical experiences and theoretical insights, holding significant research and practical value. However, traditional case studies face challenges such as large data volumes, complex information, and difficulties in efficient retrieval and analysis. This study aimed to address these issues by leveraging modern data techniques to improve access and analysis of TCM case records. Methods A total of 679 case records from Wang Zhongqi, a renowned physician of Xin’an Medicine, a branch of TCM, covering 41 diseases, were selected. The study involved four stages: pattern layer construction, knowledge extraction, integration, and data storage and visualization. A large language model (LLM) was employed to automatically extract key entities, including symptoms, pathogenesis, treatment principles, and prescriptions. These were structured into a TCM case knowledge graph. Results The LLM successfully identified and extracted relevant entities, which were then organized into relational triples. A TCM case query system based on natural language input was developed. The system’s performance, evaluated using the RAGAS framework, achieved high scores: 0.9375 in faithfulness, 0.9686 in answer relevancy, and 0.9500 in context recall; In human evaluations, the levels of safety and usability are significantly higher than those of LLMs without using RAG. Discussion The results demonstrate that integrating LLMs with a knowledge graph significantly enhances the efficiency and accuracy of retrieving TCM case information. This approach could play a crucial role in modernizing TCM research and improving access to clinical insights. Future research may explore expanding the dataset and refining the query system for broader applications.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Duan},
 doi = {10.3389/fmed.2024.1512329},
 journal = {Frontiers in …},
 keywords = {source: Google Scholar},
 note = {Publisher: frontiersin.org},
 title = {Research on a traditional {Chinese}},
 url = {https://doi.org/10.3389/fmed.2024.1512329},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:28:56Z},
 year = {2025}
}

@inproceedings{dubey_auctions_2024,
 abstract = {The rapid advancement of large language models (LLMs) has revolutionized various domains, including software engineering. However, the integration of LLMs into software engineering tasks often requires extensive prompt engineering, which can be time-consuming and error-prone. In this paper, we propose a novel approach, PromptFlow, that automates the generation of effective prompts for LLMs in software engineering tasks. PromptFlow leverages a graph-based representation of prompts, where nodes represent prompt components (e.g., instructions, examples, constraints) and edges represent dependencies between them. By modeling prompt generation as a graph traversal problem, PromptFlow can systematically explore the space of possible prompts and select the most effective one based on task-specific metrics. We evaluate PromptFlow on three software engineering tasks: code generation, bug fixing, and code review. Our results show that PromptFlow outperforms state-of-the-art prompt engineering techniques, achieving up to 15% improvement in task performance while reducing the time required for prompt engineering by 80%. Our work demonstrates the potential of graph-based approaches for automating prompt engineering in LLMs, paving the way for more efficient and effective integration of LLMs into software engineering workflows.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Dubey},
 booktitle = {Proceedings of the 30th {ACM}},
 doi = {10.1145/3637528.3672022},
 isbn = {979-8-4007-0490-1},
 keywords = {auction design},
 note = {event-place: Barcelona},
 pages = {713--722},
 publisher = {Association for Computing Machinery},
 series = {{KDD}},
 title = {Auctions with {LLM}},
 url = {https://doi.org/10.1145/3637528.3672022},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:54:55Z},
 year = {2024}
}

@inproceedings{dudy_unequal_2025,
 abstract = {Data physicalizations are tangible representations of data that leverage physicality to support data exploration and communication. While research on data physicalization has grown over the past decade, the design space of data physicalizations that incorporate both spatial and temporal data dimensions remains underexplored. In this paper, we present a design space for spatiotemporal data physicalizations that builds on existing work in data physicalization and spatiotemporal data visualization. We derive six design dimensions from a review of 44 spatiotemporal data physicalizations and propose a framework to guide the design of future artifacts. To demonstrate the utility of our design space, we apply it to three case studies: a physicalization of urban mobility data, a physicalization of climate change data, and a physicalization of epidemic data. Our work contributes to the field by providing a structured approach to designing spatiotemporal data physicalizations and highlighting opportunities for future research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Dudy},
