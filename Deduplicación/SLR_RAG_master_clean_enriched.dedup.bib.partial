@article{shlyk_real_2024,
 abstract = {L'articolo analizza il concetto di "rischio clinico" nel contesto del Servizio Sanitario Nazionale italiano, esaminando le normative vigenti e le esperienze regionali in materia di gestione del rischio. Attraverso un approccio interdisciplinare, che integra elementi di diritto, management sanitario e statistica, si valutano le strategie implementate per la prevenzione degli errori medici e la promozione della sicurezza delle cure. Il lavoro evidenzia le criticità del sistema attuale e propone raccomandazioni per un miglioramento coordinato a livello nazionale, basandosi su casi studio e dati empirici raccolti dalle regioni Lombardia, Emilia-Romagna e Toscana.},
