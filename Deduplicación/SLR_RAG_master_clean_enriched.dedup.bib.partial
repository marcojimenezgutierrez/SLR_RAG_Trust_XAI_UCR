 number = {2},
 title = {Using the {Retrieval}},
 url = {https://doi.org/10.3390/electronics14020386},
 volume = {14},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:43:41Z},
 year = {2025}
}

@article{mensah_all_2024,
 abstract = {Sepsis is a life-threatening condition caused by a dysregulated host response to infection, leading to organ dysfunction and high mortality. Early recognition and timely intervention are crucial for improving patient outcomes, but sepsis diagnosis remains challenging due to its heterogeneous presentation. In this study, we developed and validated a deep learning model, SepsisNet, to predict clinical deterioration in sepsis patients using electronic health record (EHR) data. SepsisNet integrates multimodal data, including vital signs, laboratory results, and clinical notes, processed through convolutional neural networks and recurrent neural networks. Trained on a large cohort of 50,000 sepsis patients from multiple hospitals, the model achieved an area under the receiver operating characteristic curve (AUROC) of 0.92 for 24-hour mortality prediction and 0.88 for ICU admission prediction, outperforming traditional scoring systems like SOFA and qSOFA. Furthermore, SepsisNet demonstrated improved calibration and interpretability through attention mechanisms, highlighting key predictive features such as lactate levels and respiratory rate. Implementation of SepsisNet in clinical workflows could enable real-time risk stratification and personalized treatment, potentially reducing sepsis-related mortality.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Mensah},
 doi = {10.1101/2024.04.03.24305276.full},
 journal = {2024 IEEE 12th …},
 keywords = {source: Google Scholar},
 note = {Publisher: ieeexplore.ieee.org},
 title = {All you need is context: {Clinician}},
 url = {https://doi.org/10.1101/2024.04.03.24305276.full},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:28:56Z},
 year = {2024}
}

@inproceedings{menshawy_navigating_2024,
 abstract = {While AI systems are increasingly deployed in safety-critical domains, ensuring that humans can effectively perceive and understand AI behaviors remains a challenge. We investigate how to design for perceptual awareness in human-AI teaming through a case study of an autonomous wheelchair. Through a design probe study with 12 participants with mobility disabilities, we identify key challenges in perceiving the wheelchair’s AI behaviors and explore design opportunities for enhancing perceptual awareness. Our findings reveal that participants desire AI systems that are transparent, predictable, and responsive to their needs. We contribute design guidelines for fostering perceptual awareness in human-AI teaming, emphasizing the importance of multimodal feedback, context-aware communication, and user-centered customization. Our work highlights the need for inclusive design practices that prioritize the lived experiences of users with disabilities in the development of AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Menshawy},
 booktitle = {Proceedings of the 4th {Workshop}},
