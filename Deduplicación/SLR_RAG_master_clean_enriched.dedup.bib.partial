@inproceedings{lee_understanding_2025,
 abstract = {Language models have revolutionized natural language processing, but their application to complex, domain-specific tasks like legal reasoning remains underexplored. This paper introduces LegalBench, a collaboratively constructed benchmark for evaluating the capabilities of language models in the legal domain. LegalBench consists of 162 tasks covering 16 different legal categories, including criminal law, constitutional law, and contracts. We evaluate a range of state-of-the-art language models on LegalBench, revealing significant gaps in their legal reasoning abilities. Our findings highlight the need for specialized training and evaluation in the legal domain to improve model performance and reliability in real-world legal applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
