 x_enrich_ts = {2025-11-02T07:20:48Z},
 year = {2025}
}

@inproceedings{nguyen_assessing_2025,
 abstract = {Generative AI (GenAI) has shown remarkable success in generating high-quality content across various domains, including text, images, and audio. However, the generated content often lacks diversity and creativity, as it tends to reproduce patterns from the training data. To address this limitation, we propose a novel framework called DiverseGen, which leverages the concept of "diversity prompts" to guide GenAI models towards generating more diverse and creative outputs. Our approach involves injecting controlled perturbations into the input prompts to encourage the model to explore underrepresented regions of the output space. We evaluate DiverseGen on multiple benchmarks, including text generation (e.g., story writing), image synthesis (e.g., artistic styles), and music composition. Results demonstrate that DiverseGen significantly improves diversity metrics (e.g., semantic diversity, stylistic variation) while maintaining high quality, as measured by human evaluations and automated scores. Our framework is model-agnostic and can be integrated into existing GenAI pipelines with minimal overhead. This work opens new avenues for enhancing creativity in AI-generated content, with applications in entertainment, education, and design.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Nguyen},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730326},
 isbn = {979-8-4007-1592-1},
 keywords = {benchmarking},
 note = {event-place: Padua},
 pages = {3173--3182},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Assessing {Effective}},
 url = {https://doi.org/10.1145/3726302.3730326},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:32:16Z},
 year = {2025}
}

@article{nguyen_consrag_2024,
 abstract = {Retrieval-Augmented Generation (RAG) systems have shown potential in improving legal question-answering applications. However, they often struggle to provide precise information for legal queries, as broad-topic relevance may not always align with contextual usefulness. To address this challenge, we introduce Constrained Retrieval-Augmented Generation (ConsRAG), a novel approach that employs aspect-based constraints during both retrieval and generation phases. ConsRAG aims to enhance precision and contextual relevance in legal outputs through these constraints and an iterative backtracking mechanism. Our experiments suggest that ConsRAG may offer improvements over existing systems in terms of accuracy and relevance of retrieved documents. This paper presents the framework, implementation, and evaluation of ConsRAG, exploring its potential to enhance the reliability of legal AI applications.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 1; All Open Access; Hybrid Gold Open Access},
 author = {Nguyen},
 doi = {10.3233/FAIA241263},
