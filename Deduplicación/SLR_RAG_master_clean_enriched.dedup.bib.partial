 keywords = {source: Scopus},
 note = {Type: Article},
 number = {2},
 pages = {103 -- 114},
 title = {Evaluating {AI}},
 url = {https://doi.org/10.1017/jli.2025.10052},
 volume = {53},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:55:01Z},
 year = {2025}
}

@inproceedings{munir_leveraging_2024,
 abstract = {This article presents an experimental study on the streamer propagation characteristics along the solid–gas interface in a needle-to-plate electrode configuration under positive lightning impulse voltages. The experiments were conducted in air and SF6/N2 gas mixtures at different pressures. The streamer propagation was recorded using a high-speed camera, and the electrical characteristics were measured using a digital oscilloscope. The results show that the streamer propagation velocity increases with the gas pressure and the applied voltage. In addition, the streamer propagation length and the number of streamers increase with the gas pressure. The streamer propagation characteristics in SF6/N2 gas mixtures are similar to those in air, but the streamer propagation velocity in SF6/N2 gas mixtures is lower than that in air. The experimental results provide a basis for the design of gas-insulated switchgear (GIS).},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Munir},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/TPS-ISA62245.2024.00046},
 keywords = {Accuracy},
 month = {oct},
 pages = {341--350},
 title = {Leveraging {Multimodal}},
 url = {https://doi.org/10.1109/tps-isa62245.2024.00046},
