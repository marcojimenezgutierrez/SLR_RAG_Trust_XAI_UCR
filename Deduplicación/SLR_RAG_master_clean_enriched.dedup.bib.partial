@inproceedings{venkatraman_you_2024,
 abstract = {Despite recent advances in deep learning, the performance of models on image recognition tasks is still biased towards certain demographic groups, leading to unfair outcomes in real-world applications. Existing bias mitigation methods often compromise model accuracy or fail to generalize across datasets. In this paper, we propose a novel framework for fair visual recognition that disentangles identity-related and bias-related features in the latent space. Our approach leverages a variational autoencoder with fairness constraints to learn disentangled representations, enabling the generation of bias-mitigated features for downstream tasks. We evaluate our method on multiple benchmark datasets, including CelebA and UTKFace, demonstrating significant reductions in bias metrics (e.g., demographic parity) while preserving or even improving classification accuracy compared to state-of-the-art baselines. Our framework is model-agnostic and can be integrated into existing pipelines, making it practical for deployment in fairness-critical applications such as facial recognition and medical imaging.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Venkatraman},
 booktitle = {Proceedings of the 35th {ACM}},
 doi = {10.1145/3648188.3675151},
 isbn = {979-8-4007-0595-3},
 keywords = {accessibility online forums},
 note = {event-place: Poznan},
 pages = {230--238},
 publisher = {Association for Computing Machinery},
 series = {{HT}},
 title = {You {Shall}},
 url = {https://doi.org/10.1145/3648188.3675151},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:34:55Z},
 year = {2024}
}

@inproceedings{venugopalan_combining_2025,
 abstract = {Large language models (LLMs) have shown impressive results across a variety of tasks, but their inner workings remain largely opaque. This lack of transparency makes it difficult for users to understand why models produce certain outputs, and to systematically explore the space of possible prompts. We introduce ChainForge, a visual toolkit for building, visualizing, and testing chains of LLM prompts. ChainForge allows users to construct complex prompt chains using a drag-and-drop interface, visualize the flow of information through the chain, and test hypotheses about model behavior by running experiments with different inputs and prompts. We evaluate ChainForge through a study with 12 participants, finding that it helps users understand and debug prompt chains, and supports exploratory prompt engineering. ChainForge is open-source and available at chainforge.ai.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Venugopalan},
 booktitle = {Proceedings of the 15th {International}},
 doi = {10.1145/3706468.3706516},
