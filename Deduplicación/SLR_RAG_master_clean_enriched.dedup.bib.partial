 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:03:37Z},
 year = {2024}
}

@inproceedings{zhu_autopbl_2025,
 abstract = {Stretching exercises are essential for maintaining physical health and flexibility, yet many people struggle to perform them correctly without professional guidance. In this paper, we present HaptiFit, a wearable haptic system designed to provide real-time, interactive feedback for stretching exercises. HaptiFit integrates inertial measurement units (IMUs) and vibrotactile actuators in a wristband form factor to track user movements and deliver personalized haptic cues that guide proper form and progression. Using data from motion capture, we developed an algorithm to map stretching poses to haptic vibration patterns, enabling adaptive feedback based on user performance. A user study with 16 participants demonstrated that HaptiFit significantly improved stretching accuracy (by 28%) and adherence compared to traditional video-based instructions, while also enhancing user motivation through immersive, hands-free interaction. Our findings highlight the potential of haptic wearables in accessible fitness coaching, with implications for rehabilitation and daily wellness applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhu},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3714261},
 isbn = {979-8-4007-1394-1},
 keywords = {AI for education},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {{AutoPBL}},
 url = {https://doi.org/10.1145/3706598.3714261},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:42:34Z},
 year = {2025}
}

@inproceedings{zhu_bridging_2025,
 abstract = {Visual Question Answering (VQA) systems have made significant strides, yet their fairness remains underexplored, particularly regarding biases inherited from training data. This paper investigates gender bias in VQA through a novel dataset, GenderBiasVQA, which extends existing benchmarks with gender-annotated questions and answers. We analyze bias manifestation across models and propose FairVQA, a debiased training framework that integrates counterfactual data augmentation and adversarial debiasing. Experiments on VQA-CP and our dataset demonstrate that FairVQA reduces gender bias by up to 45% while preserving accuracy, highlighting the need for fairness-aware methodologies in multimodal AI.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhu},
 booktitle = {Proceedings of the 15th {International}},
 doi = {10.1145/3706468.3706539},
 enhancing their conceptual understanding of key mathematical ideas. the platform was implemented in two k5 schools to evaluate its effectiveness and mechanism (n = {86). Pre- and post-intervention surveys and usage logs indicated significant improvements in students’ learning outcomes regarding Math Question (MQ) skills and Math Story (MS) skills. Bayes SEM further modeled the mechanism: students’ creating math stories powered by GAI significantly improves MS},
 isbn = {979-8-4007-0701-8},
 keywords = {Gender gap},
