 pages = {1211--1228},
 publisher = {Association for Computing Machinery},
 series = {{FAccT}},
 title = {Worldbench: {Quantifying}},
 url = {https://doi.org/10.1145/3630106.3658967},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
