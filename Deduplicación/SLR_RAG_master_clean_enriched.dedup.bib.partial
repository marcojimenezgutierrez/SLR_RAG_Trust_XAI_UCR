@article{bouvard_derby_2024,
 abstract = {The article proposes a new approach to the study of the dynamics of the solar wind based on the analysis of the invariants of motion of charged particles in the presence of electromagnetic fields. The invariants are calculated using the Liouville theorem and the conservation of the magnetic moment. The results show that the invariants can be used to describe the structure of the solar wind and to predict its evolution over time. The method is applied to data from the Parker Solar Probe mission and shows good agreement with observations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
