@inproceedings{pamnani_ai-driven_2025,
 abstract = {Fairness in machine learning has become a critical concern, particularly in visual recognition tasks where models often exhibit biases against certain demographic groups. This paper investigates effective strategies for bias mitigation and evaluation in image classification. We propose a unified framework that integrates adversarial debiasing with group-balanced sampling and fairness regularization. Extensive experiments on benchmark datasets like CelebA and UTKFace demonstrate that our approach significantly reduces demographic disparities in model predictions while preserving overall accuracy. Additionally, we introduce new metrics for comprehensive fairness assessment, highlighting the trade-offs between accuracy and equity. Our findings provide practical guidelines for developing fairer visual recognition systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
