@article{luo_application_2024,
 abstract = {This paper proposes a novel approach to enhance the security and efficiency of data transmission in wireless sensor networks (WSNs) using a hybrid encryption scheme combining elliptic curve cryptography (ECC) and chaotic maps. The proposed method addresses the limitations of traditional encryption techniques by providing lightweight computation suitable for resource-constrained devices. Simulation results demonstrate that the scheme achieves higher resistance to attacks, reduced computational overhead, and improved energy efficiency compared to existing methods. The integration of chaotic maps ensures dynamic key generation, further bolstering the system's robustness against cryptanalytic threats.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
