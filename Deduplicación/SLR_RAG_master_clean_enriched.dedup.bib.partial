@inproceedings{pathak_utilizing_2024,
 abstract = {Abstract—This paper presents a novel approach to enhance the security of Internet of Things (IoT) devices using blockchain technology integrated with machine learning algorithms. The proposed system employs a distributed ledger to ensure tamper-proof data storage and transaction verification, while a hybrid ML model, combining convolutional neural networks (CNN) and recurrent neural networks (RNN), detects anomalous behaviors in real-time. Experimental evaluations on a simulated IoT network demonstrate a detection accuracy of 98.5% and reduced latency compared to existing centralized security frameworks. The results highlight the potential for scalable, decentralized security solutions in smart environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
