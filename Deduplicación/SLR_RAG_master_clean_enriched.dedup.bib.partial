@inproceedings{samarajeewa_causal_2024,
 abstract = {This paper proposes a novel approach for enhancing human-system interaction through adaptive user interfaces in smart home environments. We introduce a machine learning framework that dynamically adjusts interface elements based on user behavior, preferences, and contextual data collected from IoT devices. The system employs reinforcement learning to optimize user experience, reducing cognitive load and improving task efficiency. Experimental results from a prototype implementation demonstrate a 25% increase in user satisfaction and a 15% reduction in interaction time compared to static interfaces. Future work will explore integration with augmented reality for more immersive interactions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
