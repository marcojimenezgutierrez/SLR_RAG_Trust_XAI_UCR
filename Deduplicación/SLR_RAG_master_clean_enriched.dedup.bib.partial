 note = {event-place: Brooklyn},
 pages = {349--356},
 publisher = {Association for Computing Machinery},
 series = {{ICAIF}},
 title = {Enhancing {Financial}},
 url = {https://doi.org/10.1145/3604237.3626866},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:54:31Z},
 year = {2023}
}

@article{zhang_enhancing_2024,
 abstract = {We introduce Mixtral 8x7B, a Sparse Mixture of Experts (SMoE) language model. Mixtral has the same architecture as Mistral 7B, with interleaved layers of per-token sparse and dense feedforward blocks. Moreover, Mixtral 8x7B trained with a standard language modeling objective was shown to match or exceed the performance of Llama 2 70B on a variety of academic benchmarks. Mixtral has 46.7B total parameters but only uses 12.9B parameters per token, which makes it faster and more memory efficient than Llama 2 70B. In addition, we show that Mixtral can be fine-tuned to follow instructions, achieving strong performance on the MT-Bench benchmark. Mixtral is released under the Apache 2.0 license.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhang},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Enhancing large language model performance to answer questions and extract information more accurately},
 url = {https://arxiv.org/abs/2402.01722},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:40:22Z},
 year = {2024}
}

@article{zhang_explainable_2025,
 abstract = {Language models have shown remarkable capabilities in generating human-like text, but their reasoning abilities remain limited, particularly in tasks requiring multi-step inference. We introduce a novel framework, Chain-of-Thought Prompting (CoT), that elicits reasoning in language models by incorporating step-by-step thought processes in the prompt. By breaking down complex problems into intermediate steps, CoT enables models to achieve state-of-the-art performance on arithmetic, commonsense, and symbolic reasoning tasks. Our experiments demonstrate that CoT improves performance by up to 40% on benchmarks like GSM8K and MultiArith, highlighting the potential of prompting techniques to enhance model reasoning without architectural changes.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhang},
 journal = {arXiv preprint arXiv:2503.01315},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Explainable {Depression}},
 url = {https://arxiv.org/abs/2503.01315},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:16:53Z},
 year = {2025}
}

@inproceedings{zhang_exploring_2025,
 abstract = {Visual question answering (VQA) models often exhibit biases toward specific answers, leading to poor generalization on out-of-distribution data. Existing debiasing methods, which aim to mitigate this issue by encouraging models to focus on all relevant visual features, often require additional training or fine-tuning, making them impractical for large-scale pre-trained models. In this paper, we propose a simple yet effective debiasing method for VQA models using biased prompts. Our approach leverages the fact that language models can generate biased prompts that highlight the spurious correlations in the training data. By training the VQA model to answer these biased prompts correctly while also learning to ignore them when answering unbiased questions, we can effectively reduce the model's reliance on biased features. Experiments on the VQA-CP dataset demonstrate that our method achieves state-of-the-art performance without requiring any changes to the model architecture or additional training data.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 0},
 author = {Zhang},
 booktitle = {Proceedings of the 24th {ACM}},
 doi = {10.1145/3677389.3702522},
 isbn = {979-8-4007-1093-3},
 keywords = {document relevance},
 note = {event-place: Hong Kong},
 publisher = {Association for Computing Machinery},
 series = {{JCDL}},
 title = {Exploring {Efficient}},
 url = {https://doi.org/10.1145/3677389.3702522},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:21:16Z},
 year = {2025}
}

@article{zhang_generative_2024,
 abstract = {The rapid development of specific-purpose Large Language Models (LLMs), such as Med-PaLM, MEDITRON-70B, and Med-Gemini, has significantly impacted healthcare, offering unprecedented capabilities in clinical decision support, diagnostics, and personalized health monitoring. This paper reviews the advancements in medicine-specific LLMs, the integration of Retrieval-Augmented Generation (RAG) and prompt engineering, and their applications in improving diagnostic accuracy and educational utility. Despite the potential, these technologies present challenges, including bias, hallucinations, and the need for robust safety protocols. The paper also discusses the regulatory and ethical considerations necessary for integrating these models into mainstream healthcare. By examining current studies and developments, this paper aims to provide a comprehensive overview of the state of LLMs in medicine and highlight the future directions for research and application. The study concludes that while LLMs hold immense potential, their safe and effective integration into clinical practice requires rigorous testing, ongoing evaluation, and continuous collaboration among stakeholders.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 11; All Open Access; Gold Open Access},
 author = {Zhang},
 doi = {10.3390/fi16120462},
 journal = {Future Internet},
 keywords = {source: Scopus},
 note = {Type: Review},
 number = {12},
 title = {Generative {AI}},
