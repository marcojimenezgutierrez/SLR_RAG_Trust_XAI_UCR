 x_enrich_ts = {2025-11-02T10:20:00Z},
 year = {2024}
}

@article{xu_large_2024,
 abstract = {Semantic communication is envisioned as a promising paradigm to support future intelligent wireless networks by transmitting only task-relevant semantic information. In this article, we first introduce the basic concepts of semantic communication and then present the semantic communication framework from the perspective of semantic information generation, semantic information transmission, and semantic information understanding. We further discuss the key technologies of semantic communication, including semantic information extraction, semantic coding, semantic channel modeling, and semantic decoding. Finally, we highlight the challenges and future research directions of semantic communication.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
