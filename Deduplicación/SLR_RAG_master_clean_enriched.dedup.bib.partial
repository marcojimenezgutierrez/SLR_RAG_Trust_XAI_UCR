@inproceedings{huang_paracoder_2025,
 abstract = {This paper explores the design and evaluation of a conversational agent that simulates empathetic responses in mental health support scenarios. Drawing from psychological theories of empathy, we developed "EmpathyBot," an AI system trained on diverse dialogue datasets to generate contextually appropriate empathetic replies. Through a user study with 120 participants experiencing simulated stress, we assessed the agent's impact on user emotional states using validated scales like the State-Trait Anxiety Inventory. Results indicate that EmpathyBot significantly reduced reported anxiety levels compared to neutral chatbots (p < 0.01), with qualitative feedback highlighting its role in fostering trust and emotional connection. However, challenges in handling cultural nuances and edge cases were noted, suggesting avenues for future multimodal enhancements. Our findings contribute to the HCI community's understanding of AI's potential in therapeutic contexts while emphasizing ethical considerations for deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Huang},
