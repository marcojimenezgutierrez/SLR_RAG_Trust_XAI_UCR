@article{liu_ctrla_2024,
 abstract = {Multimodal large language models (MLLMs) have made significant progress in understanding and generating content across multiple modalities. However, their ability to process long sequences of multimodal data remains limited. In this work, we introduce Gemini 1.5, a new family of models that significantly expands the capabilities of previous Gemini models in complex tasks requiring multimodal and long-context understanding. Gemini 1.5 Pro and Gemini 1.5 Flash are the first models to support a context window of up to 1 million tokens, enabling them to process vast amounts of information in a single input. This allows for applications such as analyzing entire books, long videos, or large codebases. Gemini 1.5 also supports multimodal inputs and outputs, including text, images, audio, and video. We evaluate Gemini 1.5 on a broad range of benchmarks, demonstrating state-of-the-art performance in long-context understanding, multimodal reasoning, and efficiency. Our models are available through the Gemini API and Vertex AI.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
