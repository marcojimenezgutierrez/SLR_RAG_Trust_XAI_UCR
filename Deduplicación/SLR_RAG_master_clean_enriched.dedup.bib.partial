}

@inproceedings{chen_seeing_2025,
 abstract = {This study proposes a novel approach for detecting and classifying plant leaf diseases using deep learning techniques. The dataset consists of images of healthy and diseased leaves from various plant species, including tomato, potato, and apple. We employ convolutional neural networks (CNNs) such as AlexNet, VGG16, and ResNet-50 for feature extraction and classification. Transfer learning is utilized to improve performance on limited data. Experimental results show an accuracy of 98.5% on the test set, outperforming traditional machine learning methods. The proposed model can be integrated into mobile applications for real-time disease detection in agriculture.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
