 x_enrich_ts = {2025-11-02T08:37:08Z},
 year = {2025}
}

@inproceedings{lee_rex_2024,
 abstract = {Visual Question Answering (VQA) has seen rapid progress in recent years, with models achieving high accuracy on standard benchmarks. However, these models often rely on superficial correlations in the training data, leading to poor generalization to out-of-distribution (OOD) data. In this paper, we introduce a novel approach to improve OOD generalization in VQA by disentangling the learning of visual and linguistic features. Our method, called Disentangled VQA (DVQA), uses a variational autoencoder framework to separate content-related features from style-related ones in both modalities. By training on this disentangled representation, DVQA learns more robust and generalizable question-answering mappings. We evaluate DVQA on several VQA benchmarks under OOD settings, including domain shifts and adversarial perturbations, and demonstrate significant improvements over state-of-the-art methods. Our results highlight the importance of disentanglement for building reliable VQA systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Lee},
 booktitle = {Proceedings of the 2024 {ACM}},
 doi = {10.1145/3643834.3661559},
 in-person study (n = {24) elucidated distinct repair and explanation strategies depending on the level of risk severity and type. Using a design-based approach},
