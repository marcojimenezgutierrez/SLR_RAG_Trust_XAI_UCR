@inproceedings{tihanyi_cybermetric_2024,
 abstract = {This paper proposes a novel federated learning framework for privacy-preserving anomaly detection in IoT networks. Traditional centralized approaches are vulnerable to data breaches and single points of failure, while federated learning enables collaborative model training without sharing raw data. We introduce a lightweight autoencoder-based model that detects anomalies by reconstructing network traffic patterns, integrated with differential privacy mechanisms to enhance security. Extensive experiments on benchmark datasets demonstrate that our approach achieves 95% accuracy with minimal communication overhead, outperforming state-of-the-art methods in both detection performance and privacy preservation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
