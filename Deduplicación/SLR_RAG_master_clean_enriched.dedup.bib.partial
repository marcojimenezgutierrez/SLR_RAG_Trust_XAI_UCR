@article{shi_retrieval_2025,
 abstract = {Visual Question Answering (VQA) has achieved significant progress in recent years, but the fairness of VQA models remains underexplored. In this paper, we investigate gender and profession biases in VQA models. We first propose a new evaluation framework that measures both accuracy and fairness in VQA. Our framework includes a fairness metric that quantifies the disparity in model performance across different gender-profession pairs. We then conduct a comprehensive evaluation of state-of-the-art VQA models on the VQA-CP dataset, revealing significant biases: models perform worse on questions involving female professionals in STEM fields compared to male counterparts. To mitigate these biases, we explore debiasing techniques, including counterfactual data augmentation and adversarial training, which improve fairness while maintaining competitive accuracy. Our findings underscore the need for fairness considerations in VQA research and provide a benchmark for future work.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
