 volume = {14418 LNCS},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:13:39Z},
 year = {2023}
}

@inproceedings{anandayuvaraj_fail_2024,
 abstract = {Recent advancements in large language models (LLMs) have led to their widespread adoption in various domains, including education. However, the opaque nature of these models raises concerns about their reliability and potential biases, particularly in sensitive applications like education. In this paper, we investigate the robustness of LLMs in generating educational content, focusing on their susceptibility to adversarial prompts designed to elicit biased or harmful responses. Through a series of controlled experiments, we evaluate popular LLMs such as GPT-4 and Llama 2 on tasks involving curriculum design and student assessment. Our findings reveal significant vulnerabilities, where subtle prompt modifications can lead to the generation of discriminatory or factually incorrect content. We propose a framework for detecting and mitigating such adversarial attacks, incorporating techniques like prompt filtering and model fine-tuning. This work underscores the need for enhanced safety measures in deploying LLMs for educational purposes, ensuring equitable and trustworthy AI-assisted learning experiences.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Anandayuvaraj},
