@inproceedings{dang_authoring_2025,
 abstract = {Generative AI models have demonstrated remarkable capabilities in creative tasks, yet their integration into interactive storytelling—where user input dynamically shapes narratives—remains underexplored. We investigate how visual programming can empower non-experts to author interactive stories powered by AI. Through a design study with 12 participants, we prototyped VibeScript, a domain-specific visual language for directing large language models (LLMs) as narrative agents. VibeScript allows users to visually compose story structures, character behaviors, and plot branches using node-based diagrams, abstracting away code while providing fine-grained control over AI outputs. Our findings reveal that visual programming lowers barriers to AI storytelling but introduces challenges in managing narrative coherence and agent autonomy. We discuss design implications for hybrid creativity tools that blend visual abstraction with AI generation, contributing to the broader vision of accessible computational creativity.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Dang},
 booktitle = {Proceedings of the 30th {International}},
 doi = {10.1145/3708359.3712164},
 isbn = {979-8-4007-1306-4},
 keywords = {generative AI},
 pages = {211--230},
 publisher = {Association for Computing Machinery},
 series = {{IUI}},
 title = {Authoring {LLM}},
