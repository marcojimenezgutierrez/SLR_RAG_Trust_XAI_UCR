@inproceedings{hang_trumorgpt_2024,
 abstract = {Federated learning enables collaborative model training across distributed devices while keeping data localized, enhancing privacy. However, real-world data often exhibits non-independent and identically distributed (non-IID) characteristics, leading to performance degradation. Moreover, privacy concerns necessitate mechanisms like differential privacy (DP). This paper proposes a novel federated learning framework that integrates DP with a non-IID-aware aggregation strategy to mitigate both performance loss and privacy risks. Our approach employs a personalized model adaptation technique to handle heterogeneity and adds calibrated noise for DP guarantees. Extensive experiments on benchmark datasets demonstrate that our method achieves higher accuracy than baselines under non-IID settings while providing strong privacy protections.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Hang},
