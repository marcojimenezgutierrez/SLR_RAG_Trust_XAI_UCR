 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:09:38Z},
 year = {2025}
}

@inproceedings{zhu_multimodal_2024,
 abstract = {Large language models (LLMs) have recently become a popular tool for generating code. However, their utility is limited by the difficulty of engineering effective prompts. In this paper, we introduce ChainForge, a visual toolkit for building, visualizing, and testing chains of LLM prompts. ChainForge enables rapid exploration of prompt engineering by allowing users to construct chains of prompts, visualize the execution flow, and test hypotheses about prompt performance. We describe the design and implementation of ChainForge, and present two case studies demonstrating its use in prompt engineering for code generation and data analysis tasks. Our findings suggest that ChainForge can accelerate the process of prompt engineering and improve the quality of generated code.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
