@inproceedings{yao_adapting_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly impacted various sectors, including education. This paper explores the integration of AI in higher education, focusing on personalized learning systems. We propose a framework that leverages machine learning algorithms to adapt educational content to individual student needs, thereby enhancing engagement and learning outcomes. Through a case study involving a university course, we demonstrate the effectiveness of our approach in improving student performance by 25%. The results highlight the potential of AI to transform traditional teaching methodologies, while also addressing ethical considerations such as data privacy and algorithmic bias. Future work will extend this framework to larger-scale implementations across multiple disciplines.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Yao},
 doi = {10.1109/ICAACE65325.2025.11019949},
 keywords = {Adaptation models},
 note = {Type: Conference paper},
