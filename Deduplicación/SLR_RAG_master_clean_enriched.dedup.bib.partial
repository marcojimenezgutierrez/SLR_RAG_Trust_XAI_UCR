@inproceedings{singh_understanding_2025,
 abstract = {The rapid growth of Internet of Things (IoT) devices has led to increased vulnerabilities in network security. This paper proposes a novel machine learning-based framework for detecting Distributed Denial of Service (DDoS) attacks in Software-Defined Networking (SDN) environments. We utilize a hybrid approach combining Random Forest and Support Vector Machine algorithms to classify network traffic patterns. The proposed model is evaluated on the CIC-DDoS2019 dataset, achieving an accuracy of 98.7%, precision of 98.5%, and recall of 99.1%. Experimental results demonstrate the framework's effectiveness in real-time detection, reducing false positives compared to traditional methods. This approach enhances SDN controllers' ability to mitigate DDoS threats efficiently, ensuring robust IoT network performance.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Singh},
 booktitle = {2025 {International}},
 doi = {10.1109/ICMCTC62214.2025.11196493},
