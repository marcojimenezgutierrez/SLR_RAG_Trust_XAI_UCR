@article{yao_cacheblend_2025,
 abstract = {Visual Question Answering (VQA) systems have made significant strides, yet they often perpetuate societal biases present in training data, leading to unfair predictions across demographic groups. This paper introduces FairVQA, a comprehensive framework for detecting, measuring, and mitigating biases in VQA models. We first propose a novel bias detection method using counterfactual reasoning to identify demographic disparities in model outputs. Then, we develop fairness-aware fine-tuning techniques that incorporate adversarial debiasing and group-balanced sampling to reduce biases while preserving overall performance. Extensive experiments on multiple VQA datasets, including VQA-CP and VQA-X, demonstrate that FairVQA significantly improves fairness metrics (e.g., demographic parity and equalized odds) by up to 25% compared to state-of-the-art baselines, with minimal accuracy degradation. Our work provides a robust foundation for building equitable VQA systems deployable in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
