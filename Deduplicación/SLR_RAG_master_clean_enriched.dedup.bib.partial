@inproceedings{rao_riskrag_2025,
 abstract = {Visual Question Answering (VQA) has achieved remarkable progress with the advent of large multimodal models (LMMs). However, these models often suffer from severe position bias, where the model overly relies on the most frequent answer for each question template, leading to poor generalization on out-of-distribution data. Existing debiasing methods, such as adversarial training and ensemble strategies, are limited by the trade-off between bias reduction and accuracy preservation, and they require additional computational resources or multiple model trainings. In this paper, we propose a simple yet effective method, called Question-Adaptive Balancing (QAB), to dynamically adjust the sampling probability of each answer during training based on the question semantics. Specifically, we leverage the LMM itself to estimate the semantic similarity between the question and each answer, and then use this similarity as a prior to balance the sampling distribution. Extensive experiments on the VQA-CP dataset demonstrate that our QAB method achieves state-of-the-art performance in bias reduction while maintaining high accuracy. Furthermore, QAB can be easily integrated into existing LMMs without additional training overhead.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Rao},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713979},
 isbn = {979-8-4007-1394-1},
 keywords = {AI model},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {{RiskRAG}},
 url = {https://doi.org/10.1145/3706598.3713979},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:58:04Z},
 year = {2025}
}

@inproceedings{rao_xpf_2025,
 abstract = {Recent advances in diffusion models have led to impressive results in image generation. However, these models are vulnerable to backdoor attacks, where malicious triggers cause the model to generate undesired outputs. Existing defense methods are either ineffective or require access to the model's weights. We propose DiffuEraser, a novel diffusion-based method to erase invisible backdoors at multiple granularities. Our approach leverages the generative power of diffusion models to purify images without knowing the trigger. Extensive experiments show that DiffuEraser outperforms state-of-the-art methods in removing backdoors while preserving image quality.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
