@inproceedings{s_rag-based_2024,
 abstract = {The Internet of Things (IoT) has revolutionized various sectors by enabling interconnected devices to collect and exchange data. However, the exponential growth of IoT devices has raised significant security and privacy concerns, particularly in data sharing and management. Traditional centralized systems are vulnerable to single points of failure, data breaches, and unauthorized access. Blockchain technology, with its decentralized, immutable, and transparent nature, offers a promising solution to these challenges. This paper proposes a novel blockchain-based framework for secure and efficient data sharing in IoT environments. The framework integrates smart contracts to enforce access control policies and ensure data integrity. We employ a lightweight consensus mechanism to address the scalability issues associated with blockchain in resource-constrained IoT devices. Performance evaluation through simulations demonstrates that the proposed framework achieves enhanced security, reduced latency, and improved throughput compared to existing solutions. The results highlight the potential of blockchain in enabling trustworthy IoT ecosystems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {S},
