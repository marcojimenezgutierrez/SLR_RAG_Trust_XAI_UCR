@article{sui_fidelis_2024,
 abstract = {Learning generalist robot policies is a long-standing challenge in robotics, as it requires policies to generalize across diverse tasks, environments, and embodiments. While large-scale data collection has enabled impressive results in specific domains, scaling this approach to generalist policies remains challenging due to the high cost of data acquisition and the need for policies to adapt to new tasks with minimal data. In this work, we propose a transfer learning framework for generalist robot policies that leverages pre-trained vision-language models (VLMs) to enable zero-shot generalization to novel tasks. Our approach, called VLM-Transfer, consists of two stages: (1) a pre-training stage where we fine-tune a VLM on a large corpus of robotic interaction data, and (2) a transfer stage where we adapt the pre-trained VLM to new tasks using few-shot demonstrations. We evaluate VLM-Transfer on a suite of robotic manipulation tasks and demonstrate significant improvements in zero-shot generalization compared to baselines. Our results suggest that transfer learning with VLMs is a promising direction for developing generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Sui},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Fidelis: {Faithful}},
 url = {https://arxiv.org/abs/2405.13873},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:11:20Z},
 year = {2024}
}

@inproceedings{sui_pre-warming_2024,
 abstract = {Federated Learning (FL) enables collaborative model training across distributed clients without sharing raw data, thus preserving privacy. However, integrating Large Language Models (LLMs) into FL introduces significant challenges, including high communication costs, vulnerability to poisoning attacks, and privacy leakage risks. In this paper, we propose FedLLM, a novel framework that enhances the security and efficiency of FL for LLMs. FedLLM incorporates differential privacy mechanisms and robust aggregation techniques to mitigate poisoning attacks while reducing communication overhead through model compression and adaptive client selection. Extensive experiments on benchmark datasets demonstrate that FedLLM achieves superior performance in terms of accuracy, privacy preservation, and resistance to adversarial attacks compared to state-of-the-art baselines. Our approach paves the way for scalable and secure deployment of LLMs in federated settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
