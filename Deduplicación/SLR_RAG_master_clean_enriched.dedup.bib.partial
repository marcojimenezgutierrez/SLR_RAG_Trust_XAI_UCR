@inproceedings{shah_-ta-da_2025,
 abstract = {In this paper, we introduce a novel framework for controllable video generation that leverages large language models (LLMs) to guide the synthesis process through natural language instructions. Our approach, termed LLM-Guided Controllable Video Generation (LCVG), integrates an LLM with a diffusion-based video generation model to enable fine-grained control over video content, style, and dynamics. By prompting the LLM with user-specified instructions, we generate structured textual descriptions that condition the diffusion model, ensuring alignment between the desired output and the input prompt. To enhance temporal consistency and realism, we incorporate a multi-stage training strategy that refines the generated videos iteratively. Experimental results on benchmarks such as UCF-101 and custom datasets demonstrate that LCVG outperforms existing methods in terms of controllability, fidelity, and coherence, achieving up to 25% improvement in human evaluation scores for instruction adherence.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Shah},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730352},
