@inproceedings{you_navigating_2025,
 abstract = {This paper introduces a novel approach to automated program repair (APR) using large language models (LLMs) fine-tuned on diverse software repositories. We propose LLM-Repair, a framework that leverages the contextual understanding of LLMs to generate and validate patches for real-world bugs. Our method outperforms traditional APR techniques by 25% in terms of patch success rate on the Defects4J benchmark. Through extensive evaluation on 1,000+ bugs, we demonstrate improved efficiency and generalizability across programming languages. The results highlight the potential of LLMs in bridging the gap between bug detection and repair in software maintenance.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
