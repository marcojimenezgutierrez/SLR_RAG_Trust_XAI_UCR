 year = {2025}
}

@inproceedings{staudinger_reproducibility_2024,
 abstract = {We present Haptics4All, a wearable haptic device designed to provide tactile feedback for people with upper limb differences. Our design process involved co-design workshops with participants who have limb differences to ensure inclusivity. The device uses vibrotactile actuators placed on the torso to simulate hand-based interactions in virtual reality. Preliminary user studies show improved immersion and accessibility in VR environments. This work contributes to the growing field of inclusive haptics, highlighting the importance of user-centered design for diverse populations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
