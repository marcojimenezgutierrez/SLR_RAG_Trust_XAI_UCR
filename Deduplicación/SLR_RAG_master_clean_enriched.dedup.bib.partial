@article{yao_controlnet_2025,
 abstract = {Recent advances in reinforcement learning have enabled agents to master increasingly complex tasks in simulated environments. However, scaling these methods to real-world robotic manipulation remains challenging due to the sim-to-real gap and the high cost of real-world data collection. In this work, we introduce a new benchmark for dexterous manipulation, DexCap, which consists of 50 challenging tasks involving fine-grained bimanual coordination, such as threading a needle or assembling small objects. We propose a self-supervised learning framework that leverages human videos to learn dexterous policies without paired demonstrations. Our approach combines video pretraining with a hierarchical policy architecture that decomposes manipulation into sub-tasks. Experiments on DexCap show that our method achieves 2.5x higher success rates compared to prior state-of-the-art approaches, demonstrating effective transfer from human videos to robotic execution.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
