 year = {2024}
}

@inproceedings{zhu_enhancing_2024,
 abstract = {This paper delves into the fascinating integration of Retrieval-Augmented Generation (RAG) with Large Language Models (LLMs) for optimizing supply chain management operations. RAG combines the robust retrieval capabilities of information retrieval systems with the generative prowess of neural language models to create a powerful tool that bolsters data protection while expanding the knowledge base to capture supply chain intricacies. This innovative methodology revolves around a dual-component system that employs a retrieval module to pinpoint relevant information from a knowledge base},
 author = {Zhu},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/BigDataService62917.2024.00025},
