 year = {2024}
}

@inproceedings{tran_myeachtrax_2024,
 abstract = {Smart speakers are increasingly integrated into everyday life, providing hands-free access to information and control over connected devices. However, their adoption and use among people with visual impairments remains underexplored. To understand how this population uses smart speakers in their homes, we conducted semi-structured interviews with 12 visually impaired smart speaker users. Our findings reveal that participants use smart speakers for a variety of purposes, including entertainment, information seeking, and home automation. While participants appreciate the accessibility benefits of smart speakers, they also encounter challenges related to discoverability, reliability, and privacy. We discuss implications for the design of more accessible and inclusive smart speaker systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Tran},
 booktitle = {Proceedings of the 7th {Annual}},
 doi = {10.1145/3643489.3661128},
 isbn = {979-8-4007-0550-2},
 keywords = {lifelog},
 note = {event-place: Phuket},
 pages = {93--98},
 publisher = {Association for Computing Machinery},
