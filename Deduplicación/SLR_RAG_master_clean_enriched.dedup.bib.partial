@inproceedings{mao_scrag_2025,
 abstract = {This paper introduces a novel framework for efficient query processing over dynamic graphs in distributed environments. Traditional graph databases struggle with scalability and real-time updates in large-scale settings. We propose GraphFlow, a streaming graph processing system that leverages adaptive partitioning and incremental computation to minimize latency. Our approach integrates machine learning-based edge prediction to handle missing data during updates. Experimental results on real-world datasets, including social networks and citation graphs, demonstrate up to 5x improvement in query throughput compared to state-of-the-art systems like Neo4j and Apache Giraph. The framework is implemented as an extension to Apache Flink, ensuring fault tolerance and horizontal scalability.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Mao},
 booktitle = {2025 {IEEE}},
 doi = {10.1109/ICDE65448.2025.00352},
