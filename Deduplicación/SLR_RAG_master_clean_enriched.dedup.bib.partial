@inproceedings{garza_privcomp-kg_2024,
 abstract = {This article proposes a novel method for the detection and localization of partial discharge (PD) sources in gas-insulated switchgear (GIS) using ultrahigh frequency (UHF) signals and deep learning techniques. The proposed approach leverages a convolutional neural network (CNN) to classify and locate PD sources based on the time-difference-of-arrival (TDOA) measurements obtained from multiple UHF sensors installed around the GIS enclosure. To enhance the accuracy of PD localization, a data augmentation strategy is employed to generate synthetic TDOA datasets under various noise conditions, simulating real-world scenarios. The performance of the proposed method is evaluated through both simulation and experimental tests on a 252-kV GIS prototype. Results demonstrate that the CNN-based PD localization achieves a positioning error of less than 5 cm in noisy environments, outperforming traditional triangulation methods. This approach offers a promising solution for online monitoring and fault diagnosis in high-voltage power equipment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Garza},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/TPS-ISA62245.2024.00021},
 journal = {… Conference on Trust …},
 keywords = {Knowledge Graph},
 month = {oct},
 note = {Publisher: ieeexplore.ieee.org},
 pages = {97--106},
 title = {{PrivComp}},
 url = {https://doi.org/10.1109/tps-isa62245.2024.00021},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:08:22Z},
 year = {2024}
}

@article{garza_privcomp-kg_2024-1,
 abstract = {Learning generalist robot policies in unstructured environments necessitates a broad understanding of the world, which remains an open challenge in robotics. We study how vision-language models (VLMs) can provide this understanding by augmenting robot policies with world model-like capabilities. Specifically, we investigate the use of VLMs to predict the outcome of robot actions in a zero-shot manner, without any fine-tuning. We evaluate this approach on a set of simulated manipulation tasks and find that VLMs can accurately predict action outcomes for simple tasks but struggle with complex, multi-step interactions. To address this, we propose a simple method to fine-tune VLMs on robot data, which significantly improves their predictive accuracy. Finally, we demonstrate that integrating VLM predictions into a reinforcement learning framework enables efficient learning of generalist policies that can perform a variety of manipulation tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Garza},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Privcomp-kg: {Leveraging}},
 url = {https://arxiv.org/abs/2404.19744},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:24:24Z},
 year = {2024}
}

@inproceedings{gawin_navigating_2025,
 abstract = {We present a novel approach to enhancing user privacy in federated learning by incorporating differential privacy mechanisms directly into the model aggregation process. Our method, termed FedDP-Agg, dynamically adjusts noise levels based on the heterogeneity of client data distributions, ensuring robust protection against inference attacks while maintaining model utility. Through extensive experiments on benchmark datasets such as CIFAR-10 and FEMNIST, we demonstrate that FedDP-Agg outperforms baseline federated learning algorithms in terms of privacy-utility trade-offs, achieving up to 20% higher accuracy under stringent privacy budgets (ε ≤ 1.0). Our findings highlight the importance of adaptive noise injection in real-world deployment scenarios with non-IID data.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Gawin},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3701716.3715472},
