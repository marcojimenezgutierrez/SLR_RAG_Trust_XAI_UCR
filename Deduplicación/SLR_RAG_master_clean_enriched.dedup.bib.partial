 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:12:16Z},
 year = {2024}
}

@inproceedings{yin_panns_2025,
 abstract = {Haptic wearables have the potential to enable new forms of communication and interaction for people with upper-body mobility impairments. However, the design space for such wearables is underexplored, and existing prototypes are often not designed with the target users in mind. In this paper, we present findings from a co-design workshop with 8 participants with upper-body mobility impairments to explore the design space of haptic wearables. We identify key design considerations, including placement, intensity, and duration of haptic feedback, as well as social acceptability and comfort. Our findings highlight the importance of involving target users in the design process and provide a foundation for future work in inclusive haptic wearable design.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
