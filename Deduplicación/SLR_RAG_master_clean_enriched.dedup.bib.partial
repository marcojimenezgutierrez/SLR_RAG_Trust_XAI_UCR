@inproceedings{deva_kya_2025,
 abstract = {We present HoloBoard, a novel holographic mixed reality (MR) interface for remote collaboration that enables users to interact with shared 3D holographic content using mid-air gestures and a physical keyboard. HoloBoard combines the expressiveness of 3D gestures with the precision of keyboard input, allowing users to seamlessly switch between modes for efficient task completion. Through a user study with 12 participants, we evaluate HoloBoard's usability in a collaborative design task compared to a baseline video conferencing tool. Results show that HoloBoard significantly improves spatial awareness and interaction efficiency, with participants reporting higher satisfaction and reduced cognitive load. We discuss design implications for MR collaboration tools and future directions for integrating hybrid input modalities.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Deva},
 booktitle = {Proceedings of the 2025 {CHI}},
