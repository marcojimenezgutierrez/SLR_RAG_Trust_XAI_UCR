 keywords = {deployment},
 note = {event-place: Sydney NSW},
 pages = {3831--3839},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {Understanding and {Detecting}},
 url = {https://doi.org/10.1145/3696410.3714755},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:40:02Z},
 year = {2025}
}

@inproceedings{yan_when_2025,
 abstract = {Large language models (LLMs) have revolutionized how we interact with AI, but their black-box nature makes it challenging to understand and control their behavior. Prompt engineering has emerged as a critical technique for eliciting desired responses from LLMs, yet it remains an ad-hoc, trial-and-error process. We introduce ChainForge, a visual programming environment for building and testing LLM pipelines. ChainForge allows users to construct complex prompt chains, visualize their execution, and systematically explore the design space of prompts. By enabling rapid iteration and hypothesis testing, ChainForge lowers the barrier to effective prompt engineering and fosters a deeper understanding of LLM behavior. Our evaluation with 12 participants shows that ChainForge significantly improves users' ability to craft effective prompts and debug LLM pipelines.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Yan},
