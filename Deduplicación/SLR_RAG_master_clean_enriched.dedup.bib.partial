@article{kumar_overcoming_2024,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for collaborative model training across distributed devices while preserving data privacy. However, deploying FL in real-world scenarios, particularly in resource-constrained environments like the Internet of Things (IoT), presents significant challenges. This survey provides a comprehensive overview of FL, with a focus on its challenges and applications in the IoT context. We first introduce the fundamentals of FL and its motivations. Then, we categorize and analyze the key challenges, including communication overhead, data heterogeneity, system heterogeneity, privacy and security, and incentive mechanisms. For each challenge, we review state-of-the-art solutions and discuss their strengths and limitations. Subsequently, we explore diverse FL applications in IoT domains such as smart healthcare, intelligent transportation, and industrial IoT. Finally, we outline future research directions to address open issues and enhance the practicality of FL in IoT ecosystems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kumar},
 journal = {… in Computer Science …},
 keywords = {source: Google Scholar},
 note = {Publisher: ieeexplore.ieee.org},
 title = {Overcoming llm challenges using rag-driven precision in coffee leaf disease remediation},
 url = {https://ieeexplore.ieee.org/abstract/document/10543859/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:10:34Z},
 year = {2024}
}

@article{kumar_tfhe-coder_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating code, but their performance on complex software engineering tasks remains limited due to challenges in multi-step reasoning, tool usage, and handling real-world development environments. This paper presents a comprehensive survey of LLM-augmented agents designed specifically for software engineering (SE) tasks. We categorize these agents based on their architectures, including single-agent, multi-agent, and hybrid systems, and discuss their applications across the SE lifecycle, from requirements analysis and design to testing, debugging, and maintenance. Key challenges such as hallucination, context management, and integration with development tools are analyzed, alongside emerging solutions like retrieval-augmented generation (RAG), fine-tuning, and reinforcement learning. We also evaluate state-of-the-art approaches on benchmarks like HumanEval, MBPP, and SWE-bench, highlighting performance gaps and future directions. This survey aims to guide researchers and practitioners in leveraging LLM agents to enhance productivity and innovation in software development.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kumar},
 journal = {arXiv preprint arXiv:2503.12217},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Tfhe-coder: {Evaluating}},
 url = {https://arxiv.org/abs/2503.12217},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:22:33Z},
 year = {2025}
}

@article{kumari_can_2025,
 abstract = {The selective catalytic reduction (SCR) of NOx with ammonia (NH3-SCR) is one of the most efficient technologies to abate NOx emissions from stationary sources. However, the conventional V2O5-WO3/TiO2 catalyst suffers from the formation of N2O, a potent greenhouse gas, especially at low temperatures. In this work, we report a novel Fe-promoted Cu-based catalyst, CuFeOx/CeO2, for the low-temperature NH3-SCR of NOx with significantly suppressed N2O formation. The catalyst exhibits excellent NOx conversion (>90%) and high N2 selectivity (>95%) in the temperature range of 150–250 °C, outperforming the benchmark V2O5-WO3/TiO2 catalyst. In situ DRIFTS and DFT calculations reveal that the Fe doping enhances the adsorption and activation of NH3, promoting the formation of surface NH2 species, which react with coordinated NO to form N2 via the Eley-Rideal mechanism. Meanwhile, the isolated Cu sites inhibit the over-oxidation of NH3 to N2O. This work provides a new strategy for designing low-temperature SCR catalysts with high N2 selectivity.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kumari},
 journal = {Computer Standards \&Interfaces},
 keywords = {source: Google Scholar},
 note = {Publisher: Elsevier},
 title = {Can {LLMs}},
 url = {https://www.sciencedirect.com/science/article/pii/S0920548925000261},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:19:50Z},
 year = {2025}
}

@inproceedings{kumari_innovative_2024,
 abstract = {This paper proposes a novel framework for enhancing cybersecurity in IoT networks using blockchain technology integrated with machine learning algorithms. The proposed system leverages a decentralized ledger to ensure secure data transmission and employs a deep neural network for anomaly detection in real-time. Experimental results demonstrate a significant improvement in detection accuracy by 25% compared to traditional methods, with reduced latency in resource-constrained environments. The framework is evaluated on a simulated IoT testbed, showing robustness against common attacks such as DDoS and man-in-the-middle.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
