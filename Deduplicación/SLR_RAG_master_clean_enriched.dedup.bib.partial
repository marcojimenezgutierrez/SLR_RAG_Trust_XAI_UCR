@inproceedings{zhang_mmr_2025,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for collaborative model training across distributed devices while preserving data privacy. However, the integration of large language models (LLMs) into FL introduces unique challenges, including high communication overhead, vulnerability to malicious participants, and the need for efficient personalization. This paper presents a comprehensive survey on secure and efficient FL in the era of LLMs. We first outline the motivations and key characteristics of LLM-FL, highlighting its differences from traditional FL settings. Then, we delve into the primary challenges, such as model compression for resource-constrained devices, defense mechanisms against poisoning and inference attacks, and strategies for vertical and horizontal FL adaptations. We further explore emerging techniques, including knowledge distillation, differential privacy enhancements, and blockchain-based secure aggregation. Finally, we discuss future research directions, such as integrating LLMs with edge computing and addressing fairness in heterogeneous environments. This survey aims to provide researchers and practitioners with a holistic understanding of the evolving landscape of secure and efficient LLM-FL.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhang},
 booktitle = {Proceedings of the 2024 5th {International}},
 doi = {10.1145/3706890.3706951},
