@article{nazar_revolutionizing_2024,
 abstract = {Llama 3.1 is a family of large language models (LLMs) developed by Meta AI, consisting of models with 8B, 70B, and 405B parameters. These models are designed to be openly available, performant, and reliable for commercial and research use in multiple languages. Llama 3.1 significantly outperforms many popular closed-source models and matches or exceeds the performance of leading closed-source models in many evaluations. The Llama 3.1 models are instruction-tuned and support a long context window of 128K tokens. This report presents the methodology used to develop Llama 3.1, including data curation, training recipes, and evaluation. We also discuss the safety measures implemented to mitigate potential risks associated with the deployment of these models.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
