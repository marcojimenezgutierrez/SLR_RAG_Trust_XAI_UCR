 x_enrich_ts = {2025-11-02T06:43:39Z},
 year = {2024}
}

@inproceedings{zhu_trustful_2024,
 abstract = {This paper presents a novel approach to customizing large language models (LLMs) for user-specific natural language processing tasks. We introduce a framework that leverages user interaction data to fine-tune LLMs, enabling personalized adaptations without extensive retraining. Our method incorporates privacy-preserving techniques and evaluates performance on diverse domains such as sentiment analysis and text generation. Experimental results demonstrate significant improvements in user satisfaction and task accuracy compared to generic models.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
