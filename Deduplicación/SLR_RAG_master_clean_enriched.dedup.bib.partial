 series = {{KDD}},
 title = {Cognify: {Supercharging}},
 url = {https://doi.org/10.1145/3711896.3736884},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:13:27Z},
 year = {2025}
}

@inproceedings{he_designminds_2025,
 abstract = {GenAIC is an integrated platform designed to facilitate the use of generative AI in scientific research. It provides a unified interface for interacting with multiple large language models (LLMs) and supports seamless integration with scientific workflows, including data analysis, experiment design, and literature review. By leveraging advanced prompting techniques and tool-calling capabilities, GenAIC enables researchers to automate repetitive tasks, generate hypotheses, and interpret complex results. The platform emphasizes reproducibility, ethical AI use, and customization to domain-specific needs, making generative AI more accessible and effective for scientific discovery.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
