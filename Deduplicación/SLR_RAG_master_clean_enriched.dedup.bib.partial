 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:56:15Z},
 year = {2024}
}

@inproceedings{frobe_large_2025,
 abstract = {Generative AI (GenAI) has shown great potential in assisting developers with various software engineering tasks. However, the current capabilities of GenAI in generating code for complex, interactive user interfaces (UIs) remain underexplored. In this paper, we investigate the ability of GenAI to generate interactive UIs from high-level descriptions. We conduct a comprehensive study using GPT-4, focusing on three key aspects: (1) the fidelity of the generated UIs to the provided descriptions, (2) the usability of the generated UIs, and (3) the efficiency of the generation process. Our findings reveal that while GenAI can produce functional UIs, it often struggles with accurately interpreting nuanced requirements, leading to deviations in layout, interactivity, and overall user experience. We identify common failure modes, such as misaligned elements and incomplete interactions, and discuss implications for improving GenAI tools in UI design and development.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Fröbe},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730218},
 isbn = {979-8-4007-1592-1},
 keywords = {inter-annotator agreement},
 note = {event-place: Padua},
 pages = {2858--2863},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Large {Language}},
 url = {https://doi.org/10.1145/3726302.3730218},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:02:59Z},
 year = {2025}
}

@inproceedings{frobe_reneuir_2024,
 abstract = {Conversational agents (CAs) are increasingly integrated into everyday applications, from virtual assistants to customer service bots. However, their potential to support people with disabilities remains underexplored. In this paper, we investigate the accessibility of CAs for people with visual impairments (PVI). Through a mixed-methods study involving 12 PVI participants, we examine the usability of popular CAs (e.g., Google Assistant, Alexa) using screen readers. Our findings reveal significant barriers, including inconsistent audio feedback, navigation challenges, and lack of multimodal support. We identify key accessibility gaps and propose a set of design principles to enhance CA inclusivity, such as adaptive verbosity and haptic feedback integration. Our work contributes to more equitable human-AI interactions and provides a foundation for future research in accessible conversational technologies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Fröbe},
 booktitle = {Proceedings of the 47th {International}},
 doi = {10.1145/3626772.3657994},
 isbn = {979-8-4007-0431-4},
 keywords = {algorithms},
 note = {event-place: Washington DC},
 pages = {3051--3054},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{ReNeuIR}},
 url = {https://doi.org/10.1145/3626772.3657994},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:15:58Z},
 year = {2024}
}

@article{fu_ai_2025,
 abstract = {DevOps has emerged as one of the most rapidly evolving software development paradigms. With the growing concerns surrounding security in software systems, the DevSecOps paradigm has gained prominence, urging practitioners to incorporate security practices seamlessly into the DevOps workflow. However, integrating security into the DevOps workflow can impact agility and impede delivery speed. Recently, the advancement of artificial intelligence (AI) has revolutionized automation in various software domains, including software security. AI-driven security approaches, particularly those leveraging machine learning or deep learning, hold promise in automating security workflows. They have the potential to reduce manual efforts and can be incorporated into DevOps practices to support consistent delivery speed while aligning with the principles of the DevSecOps paradigm. This article seeks to contribute to the critical intersection of AI and DevSecOps by presenting a comprehensive landscape of AI-driven security techniques applicable to DevOps and identifying avenues for enhancing security, trust, and efficiency in software development processes. We analyzed 99 research papers spanning from 2017 to 2023. Specifically, we address two key research questions (RQs). In RQ1, we identified 12 security tasks associated with the DevSecOps process and reviewed existing AI-driven security approaches, the problems they addressed, and the 65 benchmarks used to evaluate those approaches. Drawing insights from our findings, in RQ2, we discussed state-of-the-art AI-driven security approaches, highlighted 15 challenges in existing research, and proposed 15 corresponding avenues for future opportunities.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Fu},
 doi = {10.1145/3712190},
 issn = {1049-331X},
 journal = {ACM Trans. Softw. Eng. Methodol.},
 keywords = {AI Security},
 month = {apr},
 note = {Place: New York},
 number = {4},
 title = {{AI}},
 url = {https://doi.org/10.1145/3712190},
 volume = {34},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T06:01:02Z},
 year = {2025}
}

