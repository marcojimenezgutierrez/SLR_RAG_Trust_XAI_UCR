 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:21:48Z},
 year = {2025}
}

@article{nian_w-rag_2025,
 abstract = {Visual programming languages (VPLs) empower users to create programs by manipulating visual elements, offering an intuitive alternative to text-based coding. However, existing VPLs are primarily designed for sighted users, making them inaccessible to visually impaired (VI) individuals due to their reliance on visual-spatial interactions. In this paper, we explore the design space of VPLs for VI users through a multi-method approach, including a formative study with 12 VI participants, iterative prototyping, and evaluation with 10 VI users. Our findings reveal key challenges in perceiving, navigating, and manipulating visual elements without sight, and we propose novel interaction techniques leveraging audio, haptics, and voice to address them. We introduce HapticFlow, a VPL prototype that supports block-based programming via a multimodal interface, enabling VI users to author functional programs independently. Our evaluation demonstrates HapticFlow's usability and expressiveness, paving the way for inclusive visual programming tools.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
