@inproceedings{ordoumpozanis_generative_2025,
 abstract = {Visual question answering (VQA) has seen significant progress, yet models often rely on superficial cues rather than genuine reasoning, leading to brittleness in real-world scenarios. We introduce a novel approach to enhance VQA reasoning by integrating a dynamic, multi-hop reasoning process that leverages external knowledge graphs (KGs) to decompose complex questions into verifiable sub-questions. Our method, called KG-MultiHop VQA, constructs a reasoning graph where nodes represent sub-questions and edges denote logical dependencies, grounded in structured KG facts. This enables the model to iteratively refine answers, reducing hallucination and improving interpretability. Experiments on benchmarks like GQA and Visual Genome demonstrate that KG-MultiHop VQA outperforms baselines by up to 12% in accuracy while providing transparent reasoning traces, paving the way for more robust and explainable vision-language systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
