 volume = {9},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:07Z},
 year = {2025}
}

@inproceedings{yang_bee_2025,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices while keeping data localized, enhancing privacy. However, FL is vulnerable to poisoning attacks, where malicious clients manipulate local updates to degrade the global model. Existing defenses often assume honest-but-curious servers or focus on specific attack types, leaving gaps in robustness against adaptive adversaries. We propose FLGuard, a novel defense framework that combines robust aggregation with client-side anomaly detection to mitigate poisoning attacks effectively. FLGuard employs a trimmed mean aggregation enhanced by spectral clustering to identify and isolate malicious updates, while a lightweight client-side filter detects anomalous local training behaviors using gradient statistics. Extensive evaluations on benchmark datasets demonstrate that FLGuard significantly outperforms state-of-the-art defenses, reducing attack success rates by up to 95% under various poisoning scenarios, including label-flipping, backdoor, and model poisoning attacks, while maintaining model utility with minimal overhead.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Yang},
 booktitle = {Proceedings of the 25th {ACM}},
 doi = {10.1145/3717511.3747067},
 isbn = {979-8-4007-1508-2},
 keywords = {Belief-value Alignment},
 publisher = {Association for Computing Machinery},
 series = {{IVA}},
 title = {{BEE}},
 url = {https://doi.org/10.1145/3717511.3747067},
 we created two virtual agents based on historical figures and compared them to baseline agents. our evaluation combined quantitative assessments of belief-value alignment with a user study (n = {48) examining explainable agency. Results show that our framework exhibits model-agnostic improved belief-value alignment and produces more detailed},
