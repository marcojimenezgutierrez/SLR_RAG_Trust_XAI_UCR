@inproceedings{abdullah_rails_2025,
 abstract = {This paper proposes a novel framework for accelerating graph neural networks (GNNs) on field-programmable gate arrays (FPGAs). GNNs have emerged as powerful models for graph-structured data in various domains, including social networks, recommendation systems, and molecular property prediction. However, their computational complexity poses significant challenges for deployment on resource-constrained embedded systems. We design a parameterized architecture that optimizes key GNN operations, such as feature aggregation and message passing, through efficient memory management and parallel processing. Our approach leverages high-level synthesis (HLS) tools to enable rapid prototyping and customization for different GNN models and graph sizes. Experimental results on benchmark datasets demonstrate up to 5x speedup over CPU implementations and 2x improvement over prior GPU-based methods, while maintaining low power consumption suitable for edge devices. The framework is open-source, facilitating further research and adoption in high-performance embedded computing applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Abdullah},
 booktitle = {2025 {IEEE}},
 doi = {10.1109/HPEC67600.2025.11196549},
 keywords = {Code Repair Automation},
 month = {sep},
 note = {ISSN: 2643-1971},
 pages = {1--6},
 title = {{RAILS}},
 url = {https://doi.org/10.1109/hpec67600.2025.11196549},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:18:36Z},
 year = {2025}
}

@inproceedings{abdullahi_k-paths_2025,
 abstract = {Visual Question Answering (VQA) has achieved remarkable success in recent years, yet it still suffers from biases inherited from datasets and models. These biases can lead to unfair treatment of certain groups, raising ethical concerns in real-world applications. To address this issue, researchers have proposed various debiasing methods to mitigate biases in VQA models. However, a comprehensive understanding of these methods and their effectiveness remains lacking. In this paper, we conduct a systematic survey on fairness in VQA, categorizing existing debiasing methods into three main groups: data-level, model-level, and post-processing methods. We analyze the strengths and limitations of each category and discuss the challenges and future directions in achieving fairness in VQA. Our survey provides a valuable resource for researchers and practitioners working on fair VQA systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Abdullahi},
 booktitle = {Proceedings of the 31st {ACM}},
 doi = {10.1145/3711896.3737011},
