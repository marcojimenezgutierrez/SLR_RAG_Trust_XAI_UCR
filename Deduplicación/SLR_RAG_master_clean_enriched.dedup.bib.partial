 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:57:34Z},
 year = {2024}
}

@inproceedings{cheng_rule_2025,
 abstract = {This paper proposes a novel framework for enhancing energy efficiency in smart grids through the integration of machine learning algorithms. By leveraging real-time data analytics and predictive modeling, the system optimizes power distribution and reduces losses by up to 25%. Experimental results from a simulated urban grid demonstrate the framework's robustness and scalability, addressing key challenges in renewable energy integration.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
