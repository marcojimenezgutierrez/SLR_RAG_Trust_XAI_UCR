@inproceedings{hendrawan_explanations_2024,
 abstract = {Web search engines rely on ranking models to order search results by relevance. These models are trained on user interactions with search results, such as clicks and reformulations. However, the reliance on user interactions can lead to biases, such as position bias, where higher-ranked results receive more clicks regardless of their actual relevance. To mitigate these biases, we propose a new ranking model that uses large language models (LLMs) to generate relevance labels for search results. Our approach leverages the ability of LLMs to understand and reason about the relevance of search results to queries. We evaluate our model on the TREC Web Track dataset and show that it outperforms traditional ranking models that rely on user interactions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
