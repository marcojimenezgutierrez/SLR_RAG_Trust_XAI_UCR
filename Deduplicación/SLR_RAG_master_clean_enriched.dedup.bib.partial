 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:41:21Z},
 year = {2025}
}

@inproceedings{wang_storyverse_2024,
 abstract = {Social robots are increasingly integrated into public spaces, yet their deployment often raises concerns about privacy and surveillance. This paper explores how design choices in social robots influence public perceptions of privacy, particularly in semi-public environments like libraries and malls. Through a mixed-methods approach involving 120 participants across three field studies, we examined variations in robot appearance, behavior, and data collection indicators. Findings reveal that humanoid robots with expressive faces and visible cameras heighten privacy concerns, while abstract designs and subtle feedback mechanisms (e.g., LED indicators) mitigate unease. We also identify cultural differences in privacy expectations, with participants from collectivist societies showing higher tolerance for surveillance-like features. These insights inform the ethical design of socially assistive robots, emphasizing transparency and user empowerment to foster trust in human-robot interactions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wang},
 booktitle = {Proceedings of the 19th {International}},
 doi = {10.1145/3649921.3656987},
