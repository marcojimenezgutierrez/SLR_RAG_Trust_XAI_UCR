 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:31Z},
 year = {2024}
}

@article{li_how_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their application in industrial settings often requires integration with domain-specific knowledge and real-time data retrieval to ensure accuracy and relevance. This paper introduces Retrieval-Augmented Generation for Industry (RAG-I), a framework that enhances LLMs by incorporating vector-based retrieval from proprietary enterprise databases. We evaluate RAG-I on three industry benchmarks: customer support query resolution, technical documentation summarization, and compliance report generation. Our results demonstrate a 25% improvement in factual accuracy and a 40% reduction in hallucination rates compared to baseline LLMs, while maintaining inference efficiency suitable for production environments. We also discuss deployment challenges, including data privacy and scalability, and provide case studies from financial and manufacturing sectors.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
