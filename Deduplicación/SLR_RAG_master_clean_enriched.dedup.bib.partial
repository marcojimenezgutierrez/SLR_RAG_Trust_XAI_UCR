 keywords = {competitive search},
 note = {event-place: Padua},
 pages = {4142--4145},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Robust-{IR}},
 url = {https://doi.org/10.1145/3726302.3730355},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:17:51Z},
 year = {2025}
}

@article{liu_secure_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their outputs can sometimes be unreliable or biased. To address this, we introduce a novel framework called "Abstract Consistency Verification" (ACV), which leverages the inherent structure of scientific abstracts to verify the factual accuracy and coherence of LLM-generated content. Specifically, ACV decomposes an abstract into key components—such as background, methods, results, and conclusions—and cross-validates them against external knowledge sources and internal logical consistency checks. Our experiments on a dataset of 1,000 peer-reviewed papers demonstrate that ACV improves the reliability of LLM summaries by 25% while maintaining fluency. This approach is particularly useful for applications in academic writing assistance and automated peer review.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Liu},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Secure multi-llm agentic ai and agentification for edge general intelligence by zero-trust: {A}},
 url = {https://arxiv.org/abs/2508.19870},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:15:07Z},
 year = {2025}
}

@inproceedings{liu_selenite_2024,
 abstract = {This paper explores the potential of large language models (LLMs) for generating code that implements data visualizations. We conduct a systematic evaluation of LLMs' ability to generate D3.js code for a diverse set of visualization tasks, including standard charts and more complex, interactive visualizations. Our results show that while LLMs can generate functional code for simple visualizations, they struggle with more advanced tasks, such as handling user interactions and ensuring visual encodings align with best practices. We identify key limitations, including hallucinations in code generation and insufficient understanding of visualization principles. To address these, we propose a hybrid approach combining LLM-generated code with human oversight and automated validation tools. Our findings provide insights into the current capabilities of LLMs in visualization code generation and outline directions for improving their utility in this domain.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Liu},
