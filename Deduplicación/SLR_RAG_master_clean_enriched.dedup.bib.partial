 year = {2023}
}

@article{chen_adaptive_2025,
 abstract = {This paper proposes a novel hybrid deep learning model for predicting software defects in large-scale projects. By combining convolutional neural networks (CNNs) with long short-term memory (LSTM) networks, the model extracts spatial and temporal features from source code metrics and historical data. The approach is evaluated on NASA and PROMISE datasets, achieving an F1-score of 0.92, outperforming traditional machine learning methods by up to 15%. The results highlight the potential of hybrid models in improving software quality assurance processes.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
