 x_enrich_ts = {2025-11-02T07:36:55Z},
 year = {2024}
}

@inproceedings{shrestha_fairrag_2024,
 abstract = {Photorealistic human head avatar modeling is a long-standing problem with significant applications in VR/AR, telepresence, and film production. Current approaches rely on accurate 3D scans and multi-view images, which are often unavailable. In this work, we propose GaussianAvatars, a method for creating photorealistic head avatars from monocular videos. Our key insight is to leverage 3D Gaussian Splatting (3DGS) for representing both the geometry and appearance of the head. We introduce a novel rigged 3DGS representation that allows for efficient deformation of the Gaussians using a parametric head model. To handle the challenging appearance modeling of the face, we propose a hybrid approach that combines 3DGS with a neural reflectance field. Our method achieves state-of-the-art results in terms of photorealism and expressiveness, while being significantly faster than competing methods. We demonstrate our approach on a variety of real-world videos, showing that GaussianAvatars can create high-fidelity avatars that can be animated with arbitrary expressions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Shrestha},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/CVPR52733.2024.01140},
 keywords = {bias},
