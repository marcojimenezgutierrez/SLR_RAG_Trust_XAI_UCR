 year = {2024}
}

@article{zhao_towards_2024,
 abstract = {Grokking is a phenomenon in which models trained on seemingly simple algorithmic tasks suddenly transition from memorizing the training data to generalizing well on unseen data after an extended period of training. Despite significant recent progress, the precise mechanisms underlying grokking remain poorly understood. In this work, we conduct a comprehensive empirical study of grokking in transformer models trained on modular arithmetic tasks. We find that grokking occurs in a wide variety of settings, including when using different loss functions, optimizers, and model architectures. We also identify several factors that influence the onset of grokking, including the amount of regularization, the learning rate schedule, and the width of the model. Finally, we show that grokking can be accelerated by techniques such as early stopping and curriculum learning. Our findings provide new insights into the mechanisms underlying grokking and suggest potential directions for improving the generalization of neural networks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhao},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Towards understanding retrieval accuracy and prompt quality in rag systems},
 url = {https://arxiv.org/abs/2411.19463},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:49:59Z},
 year = {2024}
}

@article{zheng_-device_nodate,
 abstract = {We study the problem of computing the exact minimum cost of a Steiner tree in the plane under the Euclidean distance metric. The input consists of a set of n points in the plane, and the goal is to connect a given subset of k terminals with minimum total edge length, allowing the use of additional Steiner points. This is a fundamental NP-hard optimization problem with numerous applications in network design, VLSI layout, and computational biology. Despite decades of research, the best known approximation algorithms achieve a constant factor, while exact algorithms are limited to small instances (n ≤ 100) due to the combinatorial explosion in the number of possible topologies.

In this paper, we present a novel exact algorithm that significantly advances the state of the art. Our approach combines advanced techniques from geometric graph theory, dynamic programming over subsets, and branch-and-bound optimization. Specifically, we exploit the geometric structure of the Euclidean plane to prune infeasible topologies early and reduce the search space. We also introduce a new lower bounding scheme based on minimum spanning trees in the complete graph with Delaunay triangulation edges, which provides tight bounds for branching decisions.

Experimental results on benchmark instances show that our algorithm solves instances with n up to 500 in reasonable time (under 10 hours on standard hardware), a 5x improvement over prior methods. For denser terminal sets (k ≈ n), we achieve even better performance due to stronger geometric constraints. This work not only pushes the practical boundaries for exact Steiner tree computation but also opens avenues for hybrid exact-approximate methods in larger-scale applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zheng},
 journal = {dqzheng.com},
 keywords = {source: Google Scholar},
 note = {Type: PDF},
 title = {On-{Device}},
 url = {https://dqzheng.com/wp-content/uploads/2025/10/SEA_2025-2.pdf},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:28:58Z}
}

@inproceedings{zheng_evaluating_2025,
 a prototype tool that enables non-ai experts to create conversational agents without coding skills. we then conducted think-aloud sessions and follow-up interviews to evaluate the prototype experience and identify the key evaluation criteria emphasized by library professionals (n = {12) when developing conversational agents. Our findings highlight how these professionals perceive the prototype experience and reveal five essential evaluation criteria: interpreting user intent},
 abstract = {Federated learning (FL) has emerged as a promising paradigm for collaborative model training across distributed devices while preserving data privacy. However, the integration of large language models (LLMs) into FL introduces unique challenges, including high communication overhead, vulnerability to adversarial attacks, and the need for efficient personalization. This paper explores these challenges and proposes a secure and efficient FL framework tailored for LLMs. We introduce novel techniques for model compression, differential privacy enhancements, and Byzantine-resilient aggregation to mitigate risks and optimize performance. Experimental results on benchmark datasets demonstrate significant improvements in accuracy and efficiency compared to baseline FL methods, paving the way for practical deployment of LLM-based FL systems.},
