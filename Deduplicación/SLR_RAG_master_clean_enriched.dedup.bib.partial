 year = {2024}
}

@article{sharma_enhancing_2025,
 abstract = {Large language models (LLMs) have shown remarkable success in generating human-like text, but their potential in creative writing, particularly in collaborative storytelling, remains underexplored. In this paper, we introduce StoryWeaver, a novel framework that enables seamless collaboration between human writers and LLMs in crafting interactive narratives. StoryWeaver leverages LLMs to dynamically generate plot suggestions, character dialogues, and branching story paths based on user inputs, while incorporating real-time feedback mechanisms to align with the writer's creative vision. Through a series of user studies involving 120 participants, we demonstrate that StoryWeaver significantly enhances narrative creativity, engagement, and coherence compared to traditional writing tools. Our findings highlight the model's ability to act as an intuitive co-author, reducing writer's block and fostering innovative storytelling experiences. We also discuss ethical considerations, such as authorship attribution and bias mitigation, paving the way for future advancements in AI-assisted creative writing.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
