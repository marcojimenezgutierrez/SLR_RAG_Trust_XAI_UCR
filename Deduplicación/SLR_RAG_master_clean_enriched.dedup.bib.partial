@article{das_two-layer_2025,
 abstract = {Background The increasing use of social media to share lived and living experiences of substance use presents a unique opportunity to obtain information on side effects, use patterns, and opinions on novel psychoactive substances. However, due to the large volume of data, obtaining useful insights through natural language processing technologies such as large language models is challenging. Objective This paper aims to develop a retrieval-augmented generation (RAG) architecture for medical question answering pertaining to clinicians’ queries on emerging issues associated with health-related topics, using user-generated medical information on social media. Methods We proposed a two-layer RAG framework for query-focused answer generation and evaluated a proof of concept for the framework in the context of query-focused summary generation from social media forums, focusing on emerging drug-related information. Our modular framework generates individual summaries followed by an aggregated summary to answer medical queries from large amounts of user-generated social media data in an efficient manner. We compared the performance of a quantized large language model (Nous-Hermes-2-7B-DPO), deployable in low-resource settings, with GPT-4. For this proof-of-concept study, we used user-generated data from Reddit to answer clinicians’ questions on the use of xylazine and ketamine. Results Our framework achieves comparable median scores in terms of relevance, length, hallucination, coverage, and coherence when evaluated using GPT-4 and Nous-Hermes-2-7B-DPO, evaluated for 20 queries with 76 samples. There was no statistically significant difference between GPT-4 and Nous-Hermes-2-7B-DPO for coverage (Mann-Whitney U=733.0; n1=37; n2=39; P=.89 two-tailed), coherence (U=670.0; n1=37; n2=39; P=.49 two-tailed), relevance (U=662.0; n1=37; n2=39; P=.15 two-tailed), length (U=672.0; n1=37; n2=39; P=.55 two-tailed), and hallucination (U=859.0; n1=37; n2=39; P=.01 two-tailed). A statistically significant difference was noted for the Coleman-Liau Index (U=307.5; n1=20; n2=16; P<.001 two-tailed). Conclusions Our RAG framework can effectively answer medical questions about targeted topics and can be deployed in resource-constrained settings.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 4; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Das},
 doi = {10.2196/66220},
 journal = {Journal of Medical Internet Research},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Two-{Layer}},
 url = {https://doi.org/10.2196/66220},
 volume = {27},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:43:47Z},
 year = {2025}
}

@article{das_two-layer_2025-1,
 abstract = {### Background
Mental health literacy (MHL) refers to knowledge and beliefs about mental disorders that facilitate their recognition, management, or prevention. University students are at high risk for mental health issues, yet MHL interventions tailored to this population are limited. Chatbots offer a scalable, accessible way to deliver health education, but their use for MHL in students has not been extensively evaluated.

### Objective
This study aimed to develop and evaluate the usability and acceptability of a chatbot-based intervention to improve MHL among university students.

### Methods
We developed "Mental Health Bot" (MHB), a rule-based chatbot using the Dialogflow platform, integrated with Telegram Messenger. The chatbot delivered interactive content on depression, anxiety, and stress, including myths, symptoms, risk factors, and help-seeking strategies across 6 modules. A mixed methods usability study was conducted with 40 undergraduate students (aged 18-24 years) from a public university in Malaysia. Participants interacted with MHB for 2 weeks. Usability was assessed using the System Usability Scale (SUS), and acceptability via a custom questionnaire and semistructured interviews. Thematic analysis was applied to qualitative data.

### Results
The mean SUS score was 76.3 (SD 14.2), indicating above-average usability. Acceptability was high, with 85% (34/40) of participants rating MHB as helpful for learning about mental health. Key themes from interviews included ease of access and engagement (n=28), relevance to student life (n=22), and suggestions for enhanced interactivity (n=15). No significant adverse effects were reported.

### Conclusions
MHB demonstrated good usability and acceptability as a tool for enhancing MHL among university students. Chatbots hold potential for scalable mental health education, warranting further efficacy trials in diverse settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Das},
 journal = {Journal of Medical …},
 keywords = {source: Google Scholar},
 note = {Publisher: jmir.org
Type: HTML},
 title = {Two-layer retrieval-augmented generation framework for low-resource medical question answering using reddit data: proof-of-concept study},
 url = {https://www.jmir.org/2025/1/e66220/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:21:32Z},
 year = {2025}
}

@article{datta_great_2023,
 abstract = {Artificial Intelligence (AI) has made significant strides in various domains, including healthcare, where it aids in diagnosis, treatment planning, and patient management. However, the opacity of many AI models, often referred to as "black boxes," hinders their adoption in clinical settings due to concerns over trust, accountability, and regulatory compliance. Explainable Artificial Intelligence (XAI) emerges as a critical field to bridge this gap by providing interpretable insights into AI decision-making processes. This chapter presents a comprehensive survey of XAI techniques, with a particular emphasis on their applications in medicine. We categorize XAI methods into model-intrinsic and model-agnostic approaches, discussing their strengths, limitations, and suitability for medical tasks such as image analysis, predictive modeling, and natural language processing. Key challenges, including trade-offs between accuracy and explainability, ethical considerations, and standardization efforts, are also explored. Finally, we outline future directions for advancing medical XAI to enhance clinical utility and patient safety.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Datta},
 doi = {10.1007/978-3-031-49601-1_2},
 journal = {Lecture Notes in Computer Science},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {16 -- 33},
 title = {{GREAT}},
 url = {https://doi.org/10.1007/978-3-031-49601-1_2},
 volume = {14418 LNCS},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:13:48Z},
 year = {2023}
}

@inproceedings{datta_raging_2025,
 abstract = {Surgical skill assessment is essential for training surgeons and ensuring patient safety, particularly in robotic surgery where objective evaluation is challenging. Traditional methods rely on expert annotations, which are subjective and labor-intensive. Recent deep learning approaches have shown promise but often lack generalizability across different surgical tasks and systems. In this paper, we propose a novel framework for generalizable surgical skill assessment using multi-modal data from robotic surgeries. Our approach integrates instrument kinematics, video frames, and system states through a transformer-based architecture that learns robust representations via contrastive learning. We evaluate our method on the JIGSAWS dataset and a new benchmark we introduce, demonstrating superior performance in skill classification and regression tasks compared to state-of-the-art methods, with improved cross-dataset transferability.},
