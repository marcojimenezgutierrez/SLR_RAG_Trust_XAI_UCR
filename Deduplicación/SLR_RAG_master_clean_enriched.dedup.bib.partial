 title = {Hierarchical {Index}},
 url = {https://doi.org/10.1109/tmc.2025.3564937},
 volume = {24},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:11:10Z},
 year = {2025}
}

@inproceedings{wang_hiyo-encoder_2025,
 abstract = {Spectral computed tomography (CT) enables material decomposition and quantitative imaging by acquiring X-ray projections at multiple energy levels. However, the increased number of measurements leads to longer scan times and higher radiation doses. To address this, we propose a deep learning-based method for reconstructing spectral CT images from few-view projections. Our approach uses a cascaded convolutional neural network (CNN) architecture consisting of a sinogram enhancement module and an image reconstruction module. The sinogram enhancement module employs a U-Net to denoise and enhance the sparse multi-energy sinograms, while the image reconstruction module uses a residual dense block-based network to generate high-quality multi-channel spectral images. The network is trained end-to-end on simulated datasets generated from a clinical CT scanner model and evaluated on both simulated and experimental datasets. Quantitative results demonstrate that our method outperforms conventional filtered back-projection (FBP) and total variation (TV) minimization techniques in terms of peak signal-to-noise ratio (PSNR), structural similarity index (SSIM), and material decomposition accuracy, achieving up to 5 dB improvement in PSNR and reducing decomposition errors by 20%. Our approach shows promise for low-dose spectral CT imaging in clinical applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Wang},
 booktitle = {Proceedings of {SPIE}},
 doi = {10.1117/12.3068397},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 title = {{HIYO}},
 url = {https://doi.org/10.1117/12.3068397},
 volume = {13692},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:51:09Z},
 year = {2025}
}

@inproceedings{wang_how_2025,
 abstract = {Social robots are increasingly deployed in public spaces to provide information, assistance, and entertainment. However, their design often overlooks the diverse needs and expectations of users in these dynamic environments. This paper presents a design framework for social robots in public spaces, grounded in a mixed-methods study involving 120 participants across three cities. We identify key design dimensions including embodiment, interaction modalities, contextual awareness, and ethical considerations. Our framework offers practical guidelines for designers and developers to create more inclusive and effective social robots that enhance user experience while respecting social norms and privacy. Through case studies of existing deployments, we demonstrate the framework's applicability and discuss implications for future research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
