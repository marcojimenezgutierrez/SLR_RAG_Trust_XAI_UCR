@article{pinna_integration_2025,
 abstract = {Graph neural networks (GNNs) have been widely used in recommender systems due to their powerful ability to model high-order connections in user-item graphs. However, existing GNN-based methods suffer from popularity bias, where popular items are over-recommended while long-tail items are under-recommended, leading to unfair recommendations. To mitigate this issue, we propose a novel GNN-based recommendation framework that incorporates contrastive learning to debias the representations. Specifically, we design a contrastive debiasing module that encourages the model to learn representations less biased towards popular items by contrasting positive and negative samples. Extensive experiments on real-world datasets demonstrate that our method significantly improves recommendation fairness and maintains high accuracy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Pinna},
 booktitle = {Proceedings of the 18th {ACM}},
 doi = {10.1145/3733155.3733192},
 isbn = {979-8-4007-1402-3},
 journal = {Proceedings of the 18th …},
 keywords = {source: Google Scholar},
 note = {Publisher: dl.acm.org},
 pages = {277--284},
 publisher = {Association for Computing Machinery},
 series = {{PETRA}},
 title = {Integration of {Retrieval}},
 url = {https://doi.org/10.1145/3733155.3733192},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:19:27Z},
 year = {2025}
}

@inproceedings{pinto_developer_2024,
 abstract = {Remote work has become increasingly prevalent, particularly following the COVID-19 pandemic. While it offers flexibility, it also introduces challenges in maintaining work-life balance (WLB). This paper investigates the WLB experiences of remote workers through a mixed-methods approach, including surveys and interviews with 150 participants from diverse professional backgrounds. Our findings reveal that blurred boundaries between work and personal life, constant connectivity expectations, and lack of social interaction significantly impact WLB. We identify coping strategies such as digital detox practices, ergonomic home setups, and virtual co-working spaces. Additionally, we propose design implications for collaboration tools to better support WLB, including features for boundary management and well-being check-ins. This work contributes to understanding the nuances of remote work dynamics and informs the development of supportive technologies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Pinto},
 booktitle = {Proceedings of the {IEEE}},
