 keywords = {flexibility},
 note = {event-place: Sydney NSW},
 pages = {3942--3951},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {Fitting {Into}},
 url = {https://doi.org/10.1145/3696410.3714620},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:12:47Z},
 year = {2025}
}

@inproceedings{liu_gram_2024,
 abstract = {Data visualization is an essential tool for understanding complex datasets, but creating effective visualizations often requires expertise in both data analysis and graphic design. To democratize this process, we introduce VizML, a machine learning framework that automatically generates visualizations from natural language descriptions. VizML leverages large language models (LLMs) to interpret user queries and map them to appropriate visualization types, data transformations, and aesthetic parameters. Our system supports a wide range of chart types, including bar charts, line graphs, scatter plots, and more advanced visualizations like heatmaps and Sankey diagrams. Through a user study with 50 participants, we demonstrate that VizML produces visualizations comparable in quality to those created by experts, while reducing creation time by 70%. Additionally, we evaluate VizML's robustness to ambiguous queries and its ability to handle diverse datasets, showing significant improvements over existing automated visualization tools. This work paves the way for accessible data storytelling, enabling non-experts to derive insights from their data effortlessly.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Liu},
 booktitle = {Proceedings of the 30th {ACM}},
 doi = {10.1145/3637528.3671602},
