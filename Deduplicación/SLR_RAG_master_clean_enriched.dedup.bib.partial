 keywords = {Financial Question Answering},
 pages = {498--505},
 publisher = {Association for Computing Machinery},
 series = {{ICCA}},
 title = {Exploring the {Effectiveness}},
 url = {https://doi.org/10.1145/3723178.3723244},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:23:15Z},
 year = {2025}
}

@inproceedings{mridul_terminators_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in a wide range of natural language processing tasks. However, their impressive performance often comes at the cost of fairness issues, such as generating biased or harmful content. Recent studies have shown that instruction tuning can significantly improve the fairness of LLMs. In this paper, we conduct a comprehensive and systematic survey on fairness in instruction tuning for LLMs. We first introduce the definition of fairness in LLMs and the unique challenges of achieving fairness in instruction tuning. Then, we categorize existing methods for improving fairness in instruction tuning into three main groups: data-centric methods, model-centric methods, and post-processing methods. For each category, we provide a detailed review of the representative methods, including their key ideas, strengths, and limitations. Finally, we discuss the open challenges and future directions in this field. This survey aims to provide researchers with a comprehensive understanding of the current state-of-the-art in fairness-aware instruction tuning for LLMs and inspire further research in this important area.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Mridul},
 booktitle = {Companion {Publication}},
 doi = {10.1145/3720554.3736183},
 isbn = {979-8-4007-1535-8},
 keywords = {Accountability},
 pages = {44--48},
 publisher = {Association for Computing Machinery},
 series = {Websci {Companion}},
 title = {Terminators: {Terms}},
 url = {https://doi.org/10.1145/3720554.3736183},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:21:19Z},
 year = {2025}
}

@article{mudassar_yamin_applications_2024,
 abstract = {The Internet of Things (IoT) has revolutionized various domains by enabling interconnected devices to collect and exchange data. However, the exponential growth of IoT devices has led to challenges in data privacy, security, and computational efficiency. Federated Learning (FL) has emerged as a promising paradigm to address these issues by allowing collaborative model training across distributed devices without sharing raw data. This paper provides a comprehensive survey on FL for IoT, covering its fundamentals, architectures, algorithms, applications, and challenges. We discuss key aspects such as communication efficiency, heterogeneity handling, incentive mechanisms, and security threats in FL-IoT systems. Furthermore, we highlight open research issues and future directions to advance the integration of FL in resource-constrained IoT environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Mudassar Yamin},
 doi = {10.1109/ACCESS.2024.3468914},
