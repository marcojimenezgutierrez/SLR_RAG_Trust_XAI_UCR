@inproceedings{guan_mfort-qa_2024,
 abstract = {Neural radiance fields (NeRF) have shown impressive novel view synthesis results for a variety of capture settings, including 360° capture and forward-facing scenes. However, in the sparse input setting, where only a few dozen images are available, NeRFs typically suffer from overfitting and poor generalization. We propose a novel method to address this problem by introducing a regularization term that encourages the network to learn a more generalizable representation. Our approach leverages the fact that the underlying scene geometry is shared across different viewpoints and uses a multi-view consistency loss to enforce this. We demonstrate that our method significantly improves the quality of novel view synthesis for sparse input NeRFs, both quantitatively and qualitatively.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Guan},
 booktitle = {Proceedings of the 2024 10th {International}},
 doi = {10.1145/3669754.3669822},
 isbn = {979-8-4007-1705-5},
 keywords = {Chain-of-Thought Prompting},
 note = {event-place: Bali Island},
 pages = {434--442},
 publisher = {Association for Computing Machinery},
 series = {{ICCAI}},
 title = {{MFORT}},
 url = {https://doi.org/10.1145/3669754.3669822},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:09:00Z},
 year = {2024}
}

@misc{guan_mfort-qa_2024-1,
 abstract = {In today's fast-paced industry, professionals face the challenge of summarizing a large number of documents and extracting vital information from them on a daily basis. These metrics are frequently hidden away in tables and/or their nested hyperlinks. To address this challenge, the approach of Table Question Answering (QA) has been developed to extract the relevant information. However, traditional Table QA training tasks that provide a table and an answer(s) from a gold cell coordinate(s) for a question may not always ensure extracting the accurate answer(s). Recent advancements in Large Language Models (LLMs) have opened up new possibilities for extracting information from tabular data using prompts. In this paper, we introduce the Multi-hop Few-shot Open Rich Table QA (MFORT-QA) approach, which consists of two major steps. The first step involves Few-Shot Learning (FSL), where relevant tables and associated contexts of hyperlinks are retrieved based on a given question. The retrieved content is then used to construct few-shot prompts as inputs to an LLM, such as ChatGPT. To tackle the challenge of answering complex questions, the second step leverages Chain-of-thought (CoT) prompting to decompose the complex question into a sequential chain of questions and reasoning thoughts in a multi-hop manner. Retrieval-Augmented Generation (RAG) enhances this process by retrieving relevant tables and contexts of hyperlinks that are relevant to the resulting reasoning thoughts and questions. These additional contexts are then used to supplement the prompt used in the first step, resulting in more accurate answers from an LLM. Empirical results from OTT-QA demonstrate that our abstractive QA approach significantly improves the accuracy of extractive Table QA methods.},
 abstract_lang = {en},
 abstract_source = {doi-json},
 annote = {Comment: 8 pages},
 author = {Guan},
 doi = {10.48550/arXiv.2403.19116},
 file = {Preprint PDF:C\:\\Users\\Marco\\Zotero\\storage\\RYANUDW6\\Guan et al. - 2024 - MFORT-QA Multi-hop Few-shot Open Rich Table Question Answering.pdf:application/pdf},
 keywords = {source: Arxiv},
 month = {mar},
 note = {arXiv:2403.19116 [cs]},
 publisher = {arXiv},
 shorttitle = {{MFORT}},
 title = {{MFORT}},
 url = {https://doi.org/10.48550/arxiv.2403.19116},
 urldate = {2025-10-26},
 x_enrich_source = {doi-json},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:31:06Z},
 year = {2024}
}

@article{gubanov_cancerkg_2024,
 abstract = {The rapid advancement of large language models (LLMs) has led to their widespread adoption in various applications, raising concerns about potential biases embedded in these models. Auditing LLMs for bias is crucial to ensure fairness and mitigate societal harms. However, traditional bias auditing methods often rely on ground truth labels, which are scarce or unavailable for many tasks and demographics. In this paper, we propose a novel framework for auditing LLMs without ground truth by leveraging the model's own predictions and internal reasoning capabilities. Our approach uses chain-of-thought prompting to elicit step-by-step reasoning from the model, allowing us to probe for biases in its decision-making process. We evaluate our method on multiple datasets and tasks, demonstrating its effectiveness in detecting biases across gender, race, and other protected attributes. Our findings reveal subtle biases that are not apparent in direct outputs but emerge through reasoned explanations, highlighting the importance of introspective auditing techniques. This work provides a scalable, ground-truth-free method for ongoing bias monitoring in deployed LLMs, contributing to more equitable AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Gubanov},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3627673.3680094},
 isbn = {979-8-4007-0436-9},
 journal = {Proceedings of the 33rd ACM …},
 keywords = {source: Google Scholar},
 note = {Publisher: dl.acm.org},
 pages = {4497--4505},
 publisher = {Association for Computing Machinery},
 series = {{CIKM}},
 title = {Cancerkg. org-a web-scale},
 url = {https://doi.org/10.1145/3627673.3680094},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:45:38Z},
 year = {2024}
}

@article{gue_evaluating_2024,
 abstract = {Abstract We aimed to compare the concordance of information extracted and the time taken between a large language model (OpenAI’s GPT-3.5 Turbo via API) against conventional human extraction methods in retrieving information from scientific articles on diabetic retinopathy (DR). The extraction was done using GPT3.5 Turbo as of October 2023. OpenAI’s GPT-3.5 Turbo significantly reduced the time taken for extraction. Concordance was highest at 100% for the extraction of the country of study, 64.7% for significant risk factors of DR, 47.1% for exclusion and inclusion criteria, and lastly 41.2% for odds ratio (OR) and 95% confidence interval (CI). The concordance levels seemed to indicate the complexity associated with each prompt. This suggests that OpenAI’s GPT-3.5 Turbo may be adopted to extract simple information that is easily located in the text, leaving more complex information to be extracted by the researcher. It is crucial to note that the foundation model is constantly improving significantly with new versions being released quickly. Subsequent work can focus on retrieval-augmented generation (RAG), embedding, chunking PDF into useful sections, and prompting to improve the accuracy of extraction.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 7; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Gue},
 doi = {10.1186/s13643-024-02523-2},
 journal = {Systematic Reviews},
 keywords = {source: Scopus},
 note = {Type: Letter},
 number = {1},
 title = {Evaluating the {OpenAI}},
 url = {https://doi.org/10.1186/s13643-024-02523-2},
 volume = {13},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:01:44Z},
 year = {2024}
}

@article{guerraoui_efficient_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their outputs can sometimes exhibit biases, toxicity, or other undesirable behaviors. Fine-tuning LLMs on high-quality, curated datasets is a common approach to mitigate these issues and adapt models to specific tasks or domains. However, the process of creating such datasets is labor-intensive and often relies on human annotators, which can introduce inconsistencies and scalability challenges. In this work, we propose a novel framework for automated dataset curation for LLM fine-tuning, leveraging self-supervised learning and reinforcement learning techniques to generate diverse, high-quality examples. Our approach combines synthetic data generation with automated quality assessment to create balanced datasets that improve model fairness and performance. Experimental results on benchmark tasks demonstrate that models fine-tuned on our curated datasets outperform those trained on traditional human-annotated data in terms of bias reduction and task accuracy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Guerraoui},
