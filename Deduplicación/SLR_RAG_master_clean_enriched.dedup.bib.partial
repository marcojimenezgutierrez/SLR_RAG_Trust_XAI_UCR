 x_enrich_ts = {2025-11-02T09:59:24Z},
 year = {2024}
}

@article{tang_adapting_2025,
 abstract = {Inductive logic programming (ILP) is a form of statistical relational learning that is concerned with learning logical programs from examples. Despite recent advances in ILP, learning programs that are robust to noisy data remains a significant challenge. In this paper, we propose a new approach to robust ILP that learns programs that are robust to noisy data by learning programs that are robust to small perturbations in the input data. We show that our approach is able to learn programs that are more robust to noisy data than state-of-the-art ILP systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Tang},
 journal = {Proceedings of the AAAI Conference on …},
 keywords = {source: Google Scholar},
 note = {Publisher: ojs.aaai.org},
 title = {Adapting to non-stationary environments: {Multi}},
 url = {https://ojs.aaai.org/index.php/AAAI/article/view/33380},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
