 year = {2024}
}

@article{yu_ba-gpt_2025,
 abstract = {This chapter presents a comprehensive review of the advancements in artificial intelligence (AI) applications for sustainable agriculture. We discuss various AI techniques, including machine learning, deep learning, and computer vision, and their integration with IoT and big data analytics to enhance crop yield prediction, pest detection, soil health monitoring, and precision farming practices. The study highlights case studies from diverse agricultural regions, demonstrating a 20-30% improvement in resource efficiency and productivity. Challenges such as data scarcity, model interpretability, and ethical considerations are addressed, along with future directions for scalable AI deployment in developing countries.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
