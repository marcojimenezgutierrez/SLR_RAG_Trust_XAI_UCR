 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:17:02Z},
 year = {2025}
}

@inproceedings{tang_boosting_2025,
 abstract = {We propose a novel framework for generating personalized workout recommendations using multimodal data from wearable devices and user feedback. Our approach integrates physiological signals, activity logs, and natural language descriptions to create adaptive training plans that account for individual fitness levels, preferences, and progress. Through a user study with 50 participants, we demonstrate that our system improves adherence by 35% and user satisfaction by 28% compared to traditional methods. We also discuss ethical considerations in data privacy and bias mitigation for health applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
