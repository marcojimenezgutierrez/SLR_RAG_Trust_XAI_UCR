 year = {2024}
}

@book{soule_enhancing_2025,
 abstract = {The Internet of Things (IoT) has seen explosive growth, connecting billions of devices and generating vast amounts of data. However, this proliferation has introduced significant cybersecurity vulnerabilities, including data breaches, unauthorized access, and device hijacking. Traditional security measures often fall short in decentralized IoT environments due to their reliance on centralized authorities. This research proposes a novel blockchain-based framework to enhance IoT device security by integrating lightweight consensus mechanisms and smart contracts for real-time authentication and data integrity verification. Using a simulated IoT network with 100 nodes, we implemented the Hyperledger Fabric platform customized for resource-constrained devices. Results demonstrate a 65% reduction in latency for authentication processes compared to conventional methods, while maintaining 99.8% data integrity. Additionally, the framework resists common attacks such as DDoS and man-in-the-middle with over 95% efficacy. This approach not only bolsters security but also promotes scalability and energy efficiency, paving the way for secure IoT deployments in smart cities and industrial applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Soule},
 keywords = {source: Google Scholar},
 note = {Type: HTML},
 publisher = {digitalcommons.odu.edu},
 title = {Enhancing {LLM}},
 url = {https://digitalcommons.odu.edu/gradresearch_achievementday/2025/engineering/14/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:17:28Z},
 year = {2025}
}

@article{sparrow_towards_2024,
 abstract = {AI is increasingly being used to moderate player behaviour in online multiplayer games, working to identify and respond to toxic and problematic conduct with greater efficiency and accuracy than existing automated systems. However, little work has explored the application of AI moderation in the gaming ecosystem, despite growing ethical concerns about AI applications in other domains. In this study, we conducted 2 expert workshops and interviewed 26 players and industry professionals on their understandings, perceptions and experiences with AI moderation in multiplayer games. Applying a metaphorical frame via template analysis, we outline four metaphors that capture participants' views on the roles of AI and automation in moderation: the Unreliable Police Force, the Unscrupulous Governor, the Uncaring Judge, and the Untiring Assistant. We discuss these roles as exacerbating a top-down, punitive online justice system and identify ethical concerns around transparency, fairness and inclusion, privacy, and human-AI collaboration. To address these concerns, we put forward a set of ethical design considerations and alternative roles for AI moderation in multiplayer games.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Sparrow},
 doi = {10.1145/3677109},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keywords = {source: ACM},
 month = {oct},
 note = {Place: New York},
 number = {CHI PLAY},
 title = {Towards {Ethical}},
 url = {https://doi.org/10.1145/3677109},
 volume = {8},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:08Z},
 year = {2024}
}

@article{spielberger_retrieval_2025,
 abstract = {We present a novel approach to enhancing the interpretability of large language models (LLMs) by integrating symbolic reasoning with neural computation. Our method, SymbLLM, decomposes complex queries into executable symbolic programs that guide the LLM's generation process, ensuring logical consistency and transparency. Through extensive experiments on benchmarks like GSM8K and CommonsenseQA, SymbLLM achieves superior performance while providing human-readable reasoning traces. This hybrid paradigm bridges the gap between black-box neural models and verifiable symbolic systems, paving the way for trustworthy AI applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
