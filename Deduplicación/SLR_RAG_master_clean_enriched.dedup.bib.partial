@inproceedings{borazio_notitle_2025,
 abstract = {This study investigates the effects of different types of feedback on student learning outcomes in online programming courses. Using a quasi-experimental design, we compared automated feedback, peer feedback, and instructor feedback across three groups of undergraduate students (N=150). Results show that automated feedback significantly improved immediate task performance, while instructor feedback led to better long-term retention and deeper conceptual understanding. Peer feedback was effective for motivation but less so for accuracy. Implications for blended learning environments are discussed, emphasizing the need for hybrid feedback systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Borazio},
 booktitle = {{CEUR}},
 keywords = {source: Scopus},
