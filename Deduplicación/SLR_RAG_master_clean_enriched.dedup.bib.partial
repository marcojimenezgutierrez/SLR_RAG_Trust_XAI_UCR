@article{chen_agentpoison_2024,
 abstract = {Diffusion models have achieved remarkable success in generating high-quality images. However, the iterative nature of the sampling process makes them computationally expensive, especially for high-resolution images. To address this, recent works have explored distilling the diffusion model into a one-step generator. Despite their promising performance, these methods often suffer from overfitting to the training dataset, leading to poor generalization to unseen data. In this work, we propose a novel approach to mitigate overfitting in diffusion distillation. Our method leverages the inherent structure of the diffusion process to regularize the distillation training. Specifically, we introduce a consistency loss that enforces the distilled model to produce consistent outputs across multiple noise levels. This encourages the model to learn robust representations rather than memorizing the training data. Extensive experiments on benchmark datasets demonstrate that our approach significantly improves generalization while maintaining high fidelity in generated images.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Chen},
 journal = {Advances in Neural …},
 keywords = {source: Google Scholar},
 note = {Publisher: proceedings.neurips.cc},
 title = {Agentpoison: {Red}},
 url = {https://proceedings.neurips.cc/paper_files/paper/2024/hash/eb113910e9c3f6242541c1652e30dfd6-Abstract-Conference.html},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:04:07Z},
 year = {2024}
}

@article{chen_application_2025,
 abstract = {The Pd/CeO2-ZrO2/Al2O3 catalysts with different Ce/Zr molar ratios (1:0, 3:1, 1:1, 1:3, 0:1) were prepared by sequential impregnation method and tested for the catalytic combustion of methane. The catalysts were characterized by N2 physisorption, X-ray diffraction (XRD), Raman spectroscopy, H2 temperature-programmed reduction (H2-TPR), O2 temperature-programmed desorption (O2-TPD), X-ray photoelectron spectroscopy (XPS) and in situ diffuse reflectance infrared Fourier transform spectroscopy (DRIFTS). The results showed that the Pd/3Ce1Zr/Al2O3 catalyst exhibited the highest catalytic activity for CH4 combustion, with T10, T50 and T90 of 250, 310 and 370 °C, respectively, at a high space velocity of 120,000 mL gcat−1 h−1. The superior performance was attributed to the highest concentration of surface oxygen species, the strongest Pd-support interaction and the optimal redox property of the catalyst. In situ DRIFTS results revealed that the active oxygen species on the catalyst surface played a key role in the activation of CH4 and the oxidation of CHx intermediates during the reaction.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Chen},
 journal = {Computer Standards \&Interfaces},
 keywords = {source: Google Scholar},
 note = {Publisher: Elsevier
Type: HTML},
 title = {Application of retrieval-augmented generation for interactive industrial knowledge management via a large language model},
 url = {https://www.sciencedirect.com/science/article/pii/S0920548925000248},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:23:03Z},
 year = {2025}
}

@inproceedings{chen_attention_2025,
 abstract = {This study investigates the effects of climate change on agricultural productivity in sub-Saharan Africa using panel data from 1990 to 2015. Employing a fixed-effects regression model, we find that rising temperatures and erratic rainfall patterns significantly reduce crop yields, particularly for staple crops like maize and sorghum. Adaptation strategies, such as improved irrigation and drought-resistant varieties, mitigate some impacts but require substantial investment. Policy implications emphasize the need for international support to enhance resilience in vulnerable regions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 2},
 author = {Chen},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
