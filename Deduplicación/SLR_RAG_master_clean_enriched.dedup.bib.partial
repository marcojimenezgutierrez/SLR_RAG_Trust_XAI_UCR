 year = {2024}
}

@inproceedings{guo_bkrag_2024,
 abstract = {Visual question answering (VQA) has achieved remarkable progress in recent years. However, the existing VQA models suffer from severe bias problems, such as language priors and distribution shifts, which lead to poor generalization performance. In this paper, we propose a novel VQA framework, named BiasBuster, to address these issues. BiasBuster consists of two main components: a bias detector and a debiased answer predictor. The bias detector identifies and quantifies the biases in the input question and image, while the debiased answer predictor generates answers that are less influenced by these biases. We evaluate BiasBuster on several benchmark datasets, including VQA-CP and VQA-X, and demonstrate that it significantly outperforms state-of-the-art methods in terms of accuracy and robustness. Our code is available at [URL].},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
