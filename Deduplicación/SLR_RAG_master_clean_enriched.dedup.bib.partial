 year = {2025}
}

@article{wang_retrieval-augmented_2025-1,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their internal representations remain opaque. Recent work has begun to explore the geometry of these representations, particularly in tasks involving true/false classification. In this paper, we investigate the emergent linear structure in LLM representations of true/false datasets. We find that, despite the complexity of the task, the representations form a low-dimensional linear subspace where truth and falsehood are separated by a hyperplane. This structure emerges consistently across models and datasets, suggesting a fundamental property of how LLMs encode veracity. Our findings provide insights into the interpretability of LLMs and open avenues for more reliable fact-checking mechanisms.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wang},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Retrieval-augmented generation with conflicting evidence},
 url = {https://arxiv.org/abs/2504.13079},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:37:07Z},
 year = {2025}
}

@article{wang_retrieval_2025,
 abstract = {Quantum computing has emerged as a promising paradigm for solving complex optimization problems that are intractable for classical computers. This survey provides a comprehensive overview of quantum algorithms and frameworks specifically tailored for optimization tasks, including quadratic unconstrained binary optimization (QUBO), combinatorial optimization, and machine learning-based optimization. We discuss key quantum hardware platforms such as superconducting qubits, trapped ions, and photonic systems, along with their suitability for optimization applications. Hybrid quantum-classical approaches, including variational quantum eigensolvers (VQE) and quantum approximate optimization algorithm (QAOA), are analyzed in detail, highlighting their advantages, limitations, and recent advancements. Furthermore, we review benchmarking studies, real-world case studies in logistics, finance, and drug discovery, and open challenges such as noise mitigation, scalability, and error correction. The survey concludes with future directions, emphasizing the integration of quantum optimization with AI and edge computing to unlock practical quantum advantage.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Wang},
 doi = {10.1016/j.array.2025.100504},
 journal = {Array},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {A retrieval augmented generation based optimization approach for medical knowledge understanding and reasoning in large language models},
 url = {https://doi.org/10.1016/j.array.2025.100504},
 volume = {28},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:31:36Z},
 year = {2025}
}

