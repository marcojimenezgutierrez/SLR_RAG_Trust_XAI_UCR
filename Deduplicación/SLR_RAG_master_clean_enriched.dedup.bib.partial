@inproceedings{ghassel_hierarchical_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but they also exhibit biases that can lead to unfair outcomes in various applications. Existing debiasing methods for LLMs often focus on specific types of biases or require extensive retraining, which is computationally expensive. In this paper, we propose a novel framework, FairLLM, that addresses multiple types of biases simultaneously through targeted fine-tuning with fairness-aware objectives. Our approach integrates counterfactual data augmentation and adversarial training to mitigate biases related to gender, race, and profession without sacrificing model performance. We evaluate FairLLM on benchmark datasets for text generation and classification tasks, demonstrating significant reductions in bias metrics while maintaining or improving accuracy. Our results highlight the potential of unified debiasing strategies for deploying equitable LLMs in real-world scenarios.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Ghassel},
 booktitle = {Proceedings of the 31st {ACM}},
 doi = {10.1145/3711896.3737233},
 isbn = {979-8-4007-1454-2},
 keywords = {data generation},
 note = {event-place: Toronto ON},
 pages = {4457--4466},
 publisher = {Association for Computing Machinery},
 series = {{KDD}},
 title = {Hierarchical {Lexical}},
 url = {https://doi.org/10.1145/3711896.3737233},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:58:55Z},
 year = {2025}
}

