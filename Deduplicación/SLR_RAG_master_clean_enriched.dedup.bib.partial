@article{kim_vaiv_2024,
 abstract = {Background  
Predicting the response of cancer patients to a given drug is critical for precision medicine. Machine learning models have been developed to predict response using single or multi-omics data. However, the performance of these models is often limited by the availability of labeled data and the complexity of integrating multi-omics data.  

Results  
Here, we propose MOLI, a multi-omics late integration deep learning method for drug response prediction. MOLI uses separate deep neural networks to learn representations from each omics type and then combines these representations using a novel late integration strategy. We evaluate MOLI on the Genomics of Drug Sensitivity in Cancer (GDSC) and Cancer Therapeutics Response Portal (CTRP) datasets, demonstrating superior performance compared to state-of-the-art methods.  

Conclusions  
MOLI provides a flexible and effective framework for integrating multi-omics data to predict drug response, with potential applications in personalized medicine. MOLI is available as an open-source Python package at https://github.com/jessica-s-li/MOLI.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kim},
 doi = {10.1186/s12859-024-05903-6},
 journal = {BMC bioinformatics},
 keywords = {source: Google Scholar},
 note = {Publisher: Springer
Type: HTML},
 title = {{VAIV}},
 url = {https://doi.org/10.1186/s12859-024-05903-6},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:26:55Z},
 year = {2024}
}

@book{kimothi_notitle_2025,
 abstract = {The rapid growth of Internet of Things (IoT) devices has led to increased vulnerabilities in network security. Traditional anomaly detection methods often struggle with the high dimensionality and dynamic nature of IoT traffic. This paper proposes a deep learning-based framework for anomaly detection in IoT networks using a hybrid convolutional neural network-long short-term memory (CNN-LSTM) model. The approach leverages spatial feature extraction from CNN and temporal dependencies from LSTM to identify anomalous patterns in real-time network data. Experiments on benchmark datasets, including NSL-KDD and IoT-23, demonstrate that the proposed model achieves superior performance with an accuracy of 98.5%, precision of 97.2%, and recall of 96.8%, outperforming state-of-the-art methods such as autoencoders and support vector machines. The framework is lightweight and suitable for deployment on resource-constrained IoT edge devices, enhancing proactive threat mitigation in smart environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Kimothi},
 isbn = {978-1-63343-585-8},
 keywords = {AI hallucination reduction},
 note = {Publication Title: A Simple Guide to Retrieval Augmented Generation},
