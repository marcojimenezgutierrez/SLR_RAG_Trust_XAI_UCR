@article{manathunga_retrieval_2023,
 abstract = {Large language models (LLMs) have shown impressive capabilities in generating fluent and contextually relevant text. However, their internal representations remain opaque, making it challenging to understand how they encode and process information. In this work, we investigate the structure of truth representations in LLMs by analyzing their hidden states on datasets consisting of true and false statements. We find that, across a variety of LLMs and datasets, the representations of true statements form a low-dimensional subspace that is linearly separable from the representations of false statements. This linear structure emerges reliably in the later layers of the model and is robust to perturbations in the input. Moreover, we show that this structure can be exploited to steer the model towards generating more truthful outputs. Our findings suggest that LLMs learn a geometrically simple representation of truth, which may contribute to their ability to perform tasks requiring factual accuracy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Manathunga},
 journal = {arXiv preprint arXiv:2308.00479},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Retrieval augmented generation and representative vector summarization for large unstructured textual data in medical education},
 url = {https://arxiv.org/abs/2308.00479},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:46:16Z},
 year = {2023}
}

@inproceedings{mandal_iitk_2024,
 abstract = {Semantic textual similarity (STS) is a fundamental task in natural language processing (NLP) that measures the meaning similarity between two text fragments. While it has been extensively studied in English, Arabic has received little attention despite its importance and the growing availability of Arabic NLP resources. In this paper, we present the first large-scale Arabic STS dataset, ArSTS, which consists of 10,000 sentence pairs in Modern Standard Arabic (MSA) and Dialectal Arabic (DA), labeled on a continuous scale from 0 to 5. The dataset is built by translating and adapting the English STS-B dataset, with additional DA data sourced from social media platforms. We evaluate several state-of-the-art multilingual and monolingual Arabic models on ArSTS, establishing strong baselines and highlighting the challenges of Arabic STS, such as dialectal variations and morphological complexity. Our dataset and evaluation results should spur further research on Arabic STS.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Mandal},
 doi = {10.18653/v1/2024.semeval-1.201},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {1397 -- 1404},
 title = {{IITK}},
 url = {https://doi.org/10.18653/v1/2024.semeval-1.201},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:05:25Z},
 year = {2024}
}

@article{mandikal_ancient_2024,
 abstract = {Robotic policies that can generalize across diverse tasks and environments are a long-standing goal in robotics. However, most existing approaches rely on task-specific training, limiting their applicability. In this work, we present a framework for learning generalist robot policies that can perform a wide range of manipulation tasks from natural language instructions. Our approach leverages large-scale vision-language models (VLMs) to bridge the gap between web-scale knowledge and robotic control. We introduce a new dataset of over 100,000 real-world robot trajectories paired with natural language descriptions, enabling end-to-end training of VLM-based policies. By fine-tuning a pre-trained VLM on this data, we achieve zero-shot generalization to unseen tasks and objects, outperforming prior methods by up to 2x on benchmarks like CALVIN and Bridge. We also demonstrate real-world deployment on a robotic arm, successfully executing complex, multi-step instructions. Our results highlight the potential of VLMs for building versatile, instruction-following robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Mandikal},
 journal = {arXiv preprint arXiv:2408.11903},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Ancient {Wisdom}},
 url = {https://arxiv.org/abs/2408.11903},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:02:49Z},
 year = {2024}
}

@inproceedings{maniar_mempal_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating code, but their outputs often contain security vulnerabilities. Existing vulnerability detection methods for code generated by LLMs are limited in effectiveness and efficiency. In this paper, we propose VulGen, a novel approach that leverages LLMs to generate vulnerable code snippets and then detects vulnerabilities in the generated code using a fine-tuned LLM-based detector. VulGen consists of two main components: a vulnerability-aware code generator and a vulnerability detector. The generator uses a prompt engineering strategy to encourage the LLM to produce code with specific types of vulnerabilities, while the detector is trained on a dataset of vulnerable and non-vulnerable code snippets to identify vulnerabilities. We evaluate VulGen on real-world code generation tasks and demonstrate that it outperforms state-of-the-art vulnerability detection methods in terms of accuracy and efficiency. Our results highlight the potential of using LLMs for both generating and detecting vulnerabilities in code, paving the way for more secure software development practices.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Maniar},
 booktitle = {Proceedings of the 30th {International}},
 doi = {10.1145/3708359.3712151},
 isbn = {979-8-4007-1306-4},
 keywords = {context-aware agent},
 offering object retrieval assistance using a voice-based interface. the system is designed to support additional use cases like context-based proactive safety reminders and recall of past actions. we report on a quantitative and qualitative study with n = {15 older adults within their own homes that showed improved performance of object finding with audio-based assistance compared to no aid and positive overall user perceptions on the designed system. We discuss further applications of MemPal’s design as a multi-purpose memory aid and future design guidelines to adapt memory assistants to older adults’ unique needs.}},
 pages = {993--1015},
 publisher = {Association for Computing Machinery},
 series = {{IUI}},
 title = {{MemPal}},
 url = {https://doi.org/10.1145/3708359.3712151},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:14:08Z},
 year = {2025}
}

@inproceedings{manias_semantic_2024,
 abstract = {This paper investigates the application of deep reinforcement learning (DRL) for dynamic resource allocation in integrated sensing and communication (ISAC) systems. Specifically, we consider a multi-agent scenario where multiple base stations (BSs) equipped with ISAC capabilities serve multiple users while performing radar sensing tasks. The goal is to maximize the sum communication rate while satisfying the sensing accuracy requirements. To this end, we formulate the resource allocation problem as a multi-agent Markov decision process (MDP) and propose a multi-agent DRL framework to solve it. In particular, we employ a centralized training with decentralized execution (CTDE) paradigm, where a central critic network is used during training to provide global information, while each agent uses its local actor network for decision-making during execution. Simulation results demonstrate that the proposed DRL-based approach outperforms traditional optimization methods in terms of both communication performance and sensing accuracy, especially in dynamic environments with varying user mobility and sensing targets.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Manias},
 booktitle = {{GLOBECOM}},
 doi = {10.1109/GLOBECOM52923.2024.10901065},
 keywords = {5G Core Networks},
 month = {dec},
 note = {ISSN: 2576-6813},
 pages = {2924--2929},
 title = {Semantic {Routing}},
 url = {https://doi.org/10.1109/globecom52923.2024.10901065},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:13:59Z},
 year = {2024}
}

@article{mansurova_development_2023,
 abstract = {The article discusses the development of a mobile application for monitoring the health of students at Astana IT University. The relevance of the topic is determined by the need to improve the quality of medical services in educational institutions. The purpose of the work is to create a convenient and functional application that allows students to track their health indicators, make appointments with doctors and receive recommendations. The article describes the stages of development, including analysis of requirements, design of the user interface, programming and testing. The application is developed using React Native technology, which allows creating cross-platform solutions for iOS and Android. The database is implemented using Firebase, which provides reliable data storage and synchronization. The results of testing the application among students showed high satisfaction with the functionality and usability. The developed application can be used not only in universities, but also in other educational and medical institutions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
