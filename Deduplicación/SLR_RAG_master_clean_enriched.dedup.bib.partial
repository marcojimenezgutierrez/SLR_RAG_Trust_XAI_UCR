@inproceedings{jiang_research_2024,
 abstract = {Recommendation systems have been widely deployed in various online platforms, which significantly improve user experience and platform revenue. However, recent studies have shown that recommendation systems can amplify biases and lead to unfair recommendations. In this paper, we provide a comprehensive survey on fairness in recommendation. We first provide a taxonomy of fairness in recommendation by categorizing fairness issues into three main types: individual fairness, group fairness, and counterfactual fairness. For each type, we discuss the corresponding fairness notions, evaluation metrics, and mitigation methods. We then discuss the relations between different fairness notions and the challenges in achieving fairness in recommendation. Finally, we point out several promising future research directions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
