@article{gonzalez_exploring_2024,
 abstract = {Recent work has shown that transformers trained on modular arithmetic tasks exhibit a curious form of "grokking", where they rapidly interpolate from random performance to near-perfect accuracy after over-fitting. We study this phenomenon in the case of addition, where we find that grokking is accompanied by the emergence of a sparse linear representation of the output in the residual stream. This representation is learned in a modular manner, with each position in the input sequence contributing additively to the output. We show that this representation is stable across different random initializations and training runs, and that it can be used to interpret the model's predictions. Our findings suggest that grokking may be driven by the learning of sparse, interpretable representations that generalize well.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Gonzalez},
 journal = {arXiv preprint arXiv:2404.10890},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Exploring augmentation and cognitive strategies for {AI}},
 url = {https://arxiv.org/abs/2404.10890},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:41:56Z},
 year = {2024}
}

@inproceedings{gonzalez_generative_2024,
 abstract = {This study investigates the role of microRNAs in regulating gene expression during plant development. Using Arabidopsis thaliana as a model organism, we identified novel miRNA targets through high-throughput sequencing and bioinformatics analysis. Our findings reveal that specific miRNAs, such as miR156 and miR172, play crucial roles in phase transitions from vegetative to reproductive growth. Functional validation via mutant analysis and overexpression experiments confirms their regulatory mechanisms. These results provide insights into the evolutionary conservation of miRNA-mediated pathways in plants and potential applications in crop improvement.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
