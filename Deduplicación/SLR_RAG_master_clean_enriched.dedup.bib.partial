}

@inproceedings{feng_complicated_2025,
 abstract = {Visual programming environments (VPEs) enable non-programmers to create interactive digital artifacts, but their design for visual artists—who often lack programming experience—remains underexplored. We conducted a design workshop with 12 visual artists to explore the design space of VPEs tailored to their needs. Through collaborative activities, we identified key design considerations, including visual representation of elements, integration with artistic workflows, and support for creative exploration. Our findings reveal that VPEs for visual artists should prioritize high-fidelity visuals, iterative processes, and flexible manipulation of elements. We discuss implications for designing artist-friendly VPEs and opportunities for future research.},
