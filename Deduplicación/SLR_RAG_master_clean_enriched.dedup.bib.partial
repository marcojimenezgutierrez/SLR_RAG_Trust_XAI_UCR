 x_enrich_ts = {2025-11-02T09:17:34Z},
 year = {2025}
}

@article{chen_eyegpt_2024,
 abstract = {Background Large language models (LLMs) have the potential to enhance clinical flow and improve medical education, but they encounter challenges related to specialized knowledge in ophthalmology. Objective This study aims to enhance ophthalmic knowledge by refining a general LLM into an ophthalmology-specialized assistant for patient inquiries and medical education. Methods We transformed Llama2 into an ophthalmology-specialized LLM, termed EyeGPT, through the following 3 strategies: prompt engineering for role-playing, fine-tuning with publicly available data sets filtered for eye-specific terminology (83,919 samples), and retrieval-augmented generation leveraging a medical database and 14 ophthalmology textbooks. The efficacy of various EyeGPT variants was evaluated by 4 board-certified ophthalmologists through comprehensive use of 120 diverse category questions in both simple and complex question-answering scenarios. The performance of the best EyeGPT model was then compared with that of the unassisted human physician group and the EyeGPT+human group. We proposed 4 metrics for assessment: accuracy, understandability, trustworthiness, and empathy. The proportion of hallucinations was also reported. Results The best fine-tuned model significantly outperformed the original Llama2 model at providing informed advice (mean 9.30, SD 4.42 vs mean 13.79, SD 5.70; P<.001) and mitigating hallucinations (97/120, 80.8% vs 53/120, 44.2%, P<.001). Incorporating information retrieval from reliable sources, particularly ophthalmology textbooks, further improved the model's response compared with solely the best fine-tuned model (mean 13.08, SD 5.43 vs mean 15.14, SD 4.64; P=.001) and reduced hallucinations (71/120, 59.2% vs 57/120, 47.4%, P=.02). Subgroup analysis revealed that EyeGPT showed robustness across common diseases, with consistent performance across different users and domains. Among the variants, the model integrating fine-tuning and book retrieval ranked highest, closely followed by the combination of fine-tuning and the manual database, standalone fine-tuning, and pure role-playing methods. EyeGPT demonstrated competitive capabilities in understandability and empathy when compared with human ophthalmologists. With the assistance of EyeGPT, the performance of the ophthalmologist was notably enhanced. Conclusions We pioneered and introduced EyeGPT by refining a general domain LLM and conducted a comprehensive comparison and evaluation of different strategies to develop an ophthalmology-specific assistant. Our results highlight EyeGPT’s potential to assist ophthalmologists and patients in medical settings.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 15; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Chen},
 doi = {10.2196/60063},
 journal = {Journal of Medical Internet Research},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {{EyeGPT}},
 url = {https://doi.org/10.2196/60063},
 volume = {26},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:07:02Z},
 year = {2024}
}

@article{chen_eyegpt_2024-1,
 abstract = {Generalist robot policies are emerging as a promising paradigm for robot learning, offering the potential to deploy a single policy across a wide range of tasks and embodiments. However, learning such generalist policies from internet-scale video data remains an open challenge. In this work, we investigate what matters in learning generalist robot policies from large-scale video data. We first introduce a new benchmark, RoboFolk, which consists of 100+ hours of diverse, real-world robotic manipulation videos collected from the internet. Using this benchmark, we evaluate a range of state-of-the-art video models and find that while they can learn useful representations, they struggle to directly translate these representations into robot actions. To address this, we propose a simple but effective approach: augmenting video models with a lightweight action head and fine-tuning on a small amount of robot data. Our approach significantly outperforms prior methods on RoboFolk and generalizes to unseen tasks and embodiments. Finally, we ablate key design choices and find that the choice of video model, the amount of robot data, and the action head architecture all play crucial roles in performance. Our findings provide insights into the key factors for learning generalist robot policies from internet-scale video data.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Chen},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Eyegpt: {Ophthalmic}},
 url = {https://arxiv.org/abs/2403.00840},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:41:15Z},
 year = {2024}
}

@inproceedings{chen_generating_2025,
 abstract = {Interactive data visualization tools empower users to explore and analyze data through direct manipulation interfaces. However, creating custom visualizations often requires programming expertise, limiting accessibility. Visual programming languages (VPLs) offer a promising alternative by allowing users to build visualizations through graphical interfaces. Despite their potential, designing effective VPLs for data visualization remains underexplored. In this paper, we investigate the design space of VPLs for interactive data visualization. We first review existing VPL systems and identify key design dimensions, including representation, composition, and interaction. We then present VizFlow, a novel VPL that incorporates these dimensions to support a wide range of visualization tasks. Through a user study with 20 participants, we evaluate VizFlow's usability and expressiveness compared to a text-based baseline. Our findings reveal that users can create complex visualizations more efficiently with VizFlow, particularly for iterative exploration. We discuss implications for future VPL design, emphasizing the need for adaptive interfaces and seamless integration with data processing pipelines.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Chen},
 booktitle = {Proceedings of the 2024 {International}},
 doi = {10.1145/3732437.3732768},
 isbn = {979-8-4007-1166-4},
 keywords = {3D reconstruction},
 pages = {74--80},
 publisher = {Association for Computing Machinery},
 series = {{ICEA}},
 title = {Generating {Spatially}},
 url = {https://doi.org/10.1145/3732437.3732768},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:35:18Z},
 year = {2025}
}

@article{chen_geofactory_2025,
 abstract = {Digital finance has become an important driver for high-quality agricultural development (HQAD). Based on the panel data of 2848 counties in China from 2011 to 2020, this paper uses the digital inclusive finance index to measure the level of digital finance development and empirically tests the impact of digital finance on HQAD and its mechanism. The results show that digital finance significantly promotes HQAD, and this conclusion remains robust after a series of robustness tests. The mechanism test shows that digital finance promotes HQAD by alleviating financing constraints, optimizing the allocation of production factors, and promoting green technological progress. Further analysis shows that the promotion effect of digital finance on HQAD is more significant in underdeveloped regions, and the marginal effect of digital finance on HQAD first increases and then decreases with the increase of per capita GDP. Therefore, it is suggested to accelerate the construction of digital financial infrastructure in rural areas, improve the coverage and use of digital financial services, and promote the high-quality development of agriculture in China.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Chen},
 doi = {10.1080/20964471.2025.2506291},
 journal = {Big Earth Data},
 keywords = {source: Google Scholar},
 note = {Publisher: Taylor \&Francis},
 title = {{GeoFactory}},
 url = {https://doi.org/10.1080/20964471.2025.2506291},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:28:10Z},
 year = {2025}
}

@article{chen_honest_2024,
 abstract = {Recent advances in large language models (LLMs) have shown remarkable capabilities in generating code from natural language descriptions. However, these models often struggle with generating code that is both correct and efficient, particularly for complex algorithms. In this paper, we introduce a novel approach to improve code generation by leveraging reinforcement learning (RL) to fine-tune LLMs on algorithmic tasks. Our method, AlgoRL, uses a reward model that evaluates generated code based on multiple criteria, including correctness, efficiency, and readability. We train the model using a curriculum of increasingly difficult algorithmic problems, starting from simple data structures to advanced graph algorithms. Experimental results on benchmarks such as HumanEval and LeetCode demonstrate that AlgoRL significantly outperforms baseline LLMs in generating high-quality code, achieving up to 20% improvement in pass@1 rates. Our approach also shows better generalization to unseen problems, highlighting the potential of RL for enhancing LLM-based code generation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Chen},
 journal = {arXiv preprint arXiv:2410.09699},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Honest {AI}},
 url = {https://arxiv.org/abs/2410.09699},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:05:27Z},
 year = {2024}
}

@inproceedings{chen_i-card_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their performance on structured tasks like code generation remains limited, especially for complex, multi-step problems. In this paper, we introduce CodeChain, a novel framework that leverages LLMs to generate executable code by chaining together smaller, verifiable code snippets. Our approach decomposes complex programming tasks into a sequence of atomic operations, each generated and validated independently using lightweight checks. We evaluate CodeChain on benchmarks such as HumanEval and LeetCode, achieving a 25% improvement in pass@1 accuracy over baseline LLM methods. Additionally, we demonstrate its applicability to real-world software engineering tasks, including bug fixing and API integration. CodeChain reduces hallucination errors and enhances reliability, paving the way for more practical LLM-assisted programming tools.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
