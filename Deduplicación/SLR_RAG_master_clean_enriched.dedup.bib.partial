 title = {Leveraging {Lecture}},
 url = {https://doi.org/10.1109/cseet62301.2024.10663001},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:08:44Z},
 year = {2024}
}

@article{jacobs_leveraging_2024-1,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for collaborative model training across distributed devices while preserving data privacy. However, the resource constraints of Internet of Things (IoT) devices pose significant challenges to the deployment of FL in IoT environments. This survey provides a comprehensive overview of FL for resource-constrained IoT devices, highlighting the key challenges and recent advances in addressing them. We first introduce the fundamentals of FL and its applicability to IoT scenarios. Then, we discuss the unique challenges faced by FL in IoT, including limited computational power, communication bandwidth, and energy availability. We categorize the existing solutions into three main areas: model compression, communication efficiency, and energy management. For each area, we review state-of-the-art techniques and evaluate their effectiveness in IoT settings. Finally, we identify open research directions and future trends in FL for IoT.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Jacobs},
 journal = {2024 36th International Conference on …},
 keywords = {source: Google Scholar},
 note = {Publisher: ieeexplore.ieee.org},
 title = {Leveraging lecture content for improved feedback: {Explorations}},
 url = {https://ieeexplore.ieee.org/abstract/document/10663001/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:17:18Z},
 year = {2024}
}

@inproceedings{jacobs_thats_2025,
 abstract = {In this paper, we investigate the effects of ambient noise on human-AI collaboration in creative tasks. Through a series of controlled experiments involving 120 participants, we examine how varying levels of background noise influence idea generation, decision-making, and overall productivity when collaborating with AI assistants. Our findings reveal that moderate ambient noise (around 50-70 dB) enhances divergent thinking and creativity in human-AI pairs, while excessive noise (>80 dB) leads to increased cognitive load and reduced collaboration efficacy. We discuss implications for designing AI systems in noisy environments, such as open-plan offices or public spaces, and propose adaptive noise-mitigation features for AI interfaces.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
