 year = {2025}
}

@inproceedings{singh_adversarial_2024,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for collaborative model training across distributed devices while preserving data privacy. However, deploying FL in real-world scenarios, especially on resource-constrained Internet of Things (IoT) devices, faces significant challenges due to heterogeneous data distributions, limited computational resources, and communication overheads. This paper provides a comprehensive survey on FL for edge computing in IoT environments. We first introduce the fundamentals of FL and edge computing, highlighting their synergy in IoT applications. Then, we categorize and analyze existing FL frameworks, algorithms, and optimization techniques tailored for edge devices, including communication-efficient methods, model compression strategies, and handling non-IID data. We also discuss security and privacy issues, such as adversarial attacks and inference risks, along with mitigation approaches like differential privacy and secure aggregation. Furthermore, we review real-world applications of FL in IoT domains, including smart healthcare, intelligent transportation, and industrial automation. Finally, we outline open challenges and future research directions, such as scalability, energy efficiency, and integration with emerging technologies like 6G and blockchain. This survey aims to guide researchers and practitioners in advancing FL for sustainable and privacy-aware IoT edge computing.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Singh},
 doi = {10.1109/BigData62323.2024.10825933},
 keywords = {Context modeling},
 note = {Type: Conference paper},
 pages = {3589 -- 3598},
 title = {Adversarial {Training}},
 url = {https://doi.org/10.1109/bigdata62323.2024.10825933},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:44:38Z},
 year = {2024}
}

@inproceedings{singh_application_2024,
 abstract = {Abstract Contract management is a critical process for energy companies operating across upstream, midstream, and downstream sectors. These companies deal with numerous complex contracts containing intricate legal language, cross-references, and long document lineages spanning amendments and supplemental materials. Manually extracting insights and managing obligations from these highly unstructured contracts is extremely time-consuming and error-prone. This paper presents a novel framework leveraging machine learning and generative AI (GenAI) to automate and streamline contract management. The proposed solution utilizes large language models (LLMs), prompt engineering, retrieval-augmented generation (RAG), and chain-of-thought reasoning to extract structured data (such as fees, escalations etc.) from contracts, perform analyses, and generate natural language responses. It enables use cases like optionality analysis, fee calculation, cross-contract insight generation, invoice processing, and user feedback integration. The architecture combines LLMs with contract knowledge bases and external data sources to optimize operations, mitigate risks, and enhance decision-making. Key capabilities include centralized repositories, clause extraction, compliance tracking, workflow automation, and advanced analytics leveraging LLM question-answering, summarization, and code generation abilities. The paper discusses technical details, use case scenarios applicable to crude oil transportation contracts in supply & chain, and highlights GenAI's potential to transform energy industry contract management practices. When conducting analyses involving hundreds of contracts, the proposed solution exhibited significant efficiency gains. Case studies showed that it reduced processing time by 10 to 100 times compared to manual methods.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 2},
 author = {Singh},
 doi = {10.2118/222932-MS},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 title = {Application of {Generative}},
 url = {https://doi.org/10.2118/222932-ms},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:05:53Z},
 year = {2024}
}

@inproceedings{singh_bias-aware_2025,
 abstract = {Generative AI (GenAI) has shown great potential in assisting people with disabilities (PWD) in their daily lives. However, the current development of GenAI applications for PWD is largely driven by developers without disabilities, which may lead to a lack of understanding of the needs and challenges of PWD. To address this issue, we conducted a systematic literature review of 43 papers on GenAI applications for PWD published between 2018 and 2023. We analyzed the roles of PWD in the development process, the types of disabilities addressed, and the evaluation methods used. Our findings reveal that PWD are rarely involved in the development of GenAI applications, with only 7 out of 43 papers (16%) including PWD as co-designers or evaluators. The most common disabilities addressed are visual (37%) and motor (23%) impairments. Most evaluations (81%) rely on quantitative metrics, with limited qualitative feedback from PWD. We discuss the implications of these findings and provide recommendations for more inclusive development practices, such as involving PWD throughout the design process and using mixed-methods evaluations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Singh},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3701716.3716885},
 isbn = {979-8-4007-1331-6},
 keywords = {agents},
 note = {event-place: Sydney NSW},
 pages = {1705--1712},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {Bias-{Aware}},
 url = {https://doi.org/10.1145/3701716.3716885},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:53:02Z},
 year = {2025}
}

@article{singh_chunkrag_2024,
 abstract = {Recent work has shown that grokking, the sudden emergence of generalization after prolonged training on overparameterized models, can be induced by modifying the learning rate schedule. We investigate the grokking phenomenon in transformer models trained on modular arithmetic. We find that grokking occurs in a variety of settings, including when training on algorithmic tasks with a single hidden layer transformer. We also find that grokking can be delayed or prevented by modifying the initialization or the learning rate schedule. Finally, we show that grokking is accompanied by a phase transition in the loss landscape, where the model suddenly finds a low-loss region that generalizes well.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Singh},
 journal = {arXiv preprint arXiv …},
