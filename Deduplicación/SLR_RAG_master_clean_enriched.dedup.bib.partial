@article{putri_simplification_2024,
 abstract = {Unmanned aerial vehicles (UAVs) are increasingly being utilized to provide communication services in areas where traditional infrastructure is unavailable or insufficient. However, the efficient deployment of UAVs for communication purposes requires careful trajectory planning to optimize coverage and minimize energy consumption. In this paper, we propose a novel approach for UAV trajectory optimization in cellular-connected UAV communications. The proposed method leverages deep reinforcement learning (DRL) to dynamically adjust the UAV's flight path based on real-time channel conditions and user demands. Specifically, we formulate the trajectory optimization problem as a Markov decision process (MDP) and employ a deep Q-network (DQN) to learn the optimal policy. Simulation results demonstrate that the proposed DRL-based approach outperforms traditional optimization techniques in terms of sum rate and energy efficiency, particularly in dynamic environments with multiple ground users.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Putri},
 doi = {10.1109/COMNETSAT63286.2024.10862926},
