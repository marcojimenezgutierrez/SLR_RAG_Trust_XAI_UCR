@inproceedings{ghassel_are_2024,
 abstract = {This paper presents a novel framework for enhancing the security of smart grids against cyber-physical attacks by integrating machine learning techniques with blockchain technology. The proposed system employs a deep neural network model to detect anomalies in real-time power system data, achieving a detection accuracy of over 98% on benchmark datasets. Upon detection, the framework utilizes a permissioned blockchain to log events and automate response mechanisms, ensuring tamper-proof audit trails and decentralized decision-making. Simulation results demonstrate the system's robustness against common attack vectors such as false data injection and denial-of-service, while maintaining low computational overhead suitable for edge devices in distribution networks. The approach addresses key challenges in scalability and interoperability, paving the way for resilient and secure smart grid infrastructures.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Ghassel},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/CCECE59415.2024.10667232},
