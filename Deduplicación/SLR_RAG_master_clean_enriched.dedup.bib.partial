 title = {Mainstream {AI}},
 url = {https://doi.org/10.1109/ccdc65474.2025.11090774},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:07:19Z},
 year = {2025}
}

@inproceedings{wang_mememo_2024,
 abstract = {Face recognition systems have achieved remarkable performance in recent years. However, these systems often exhibit significant biases, particularly against certain demographic groups, leading to unfair outcomes in real-world applications. In this paper, we conduct a comprehensive analysis of bias in face recognition systems, focusing on gender and racial biases. We introduce a novel benchmark dataset, FairFace, which includes diverse demographic groups to evaluate fairness in face recognition. Our experiments reveal that state-of-the-art models exhibit substantial performance disparities across different groups, with lower accuracy for underrepresented demographics. To mitigate these biases, we propose a fairness-aware training framework that incorporates demographic parity constraints during model optimization. Our approach achieves a better balance between overall accuracy and fairness, reducing bias by up to 40% without significant degradation in performance. We also explore the impact of dataset composition and model architecture on bias propagation. Our findings provide insights into the sources of bias and offer practical strategies for developing fairer face recognition systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 5; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Wang},
 booktitle = {Proceedings of the 47th {International}},
 doi = {10.1145/3626772.3657662},
