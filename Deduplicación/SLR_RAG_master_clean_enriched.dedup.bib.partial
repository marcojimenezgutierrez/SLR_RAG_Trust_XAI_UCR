@inproceedings{tupayachi_conversational_2025,
 abstract = {Visual programming languages (VPLs) have long promised to make programming more accessible, but their adoption remains limited. We hypothesize that this is due to a mismatch between the visual metaphors used in VPLs and the mental models of users. To explore this, we conducted a design study with 12 professional programmers to elicit their preferences for visual representations of common programming concepts. Participants sketched their ideal visualizations for data structures, control flow, and operations, revealing a preference for abstract, node-link diagrams over concrete metaphors like blocks or wires. We distilled these into a design space of visual programming primitives, identifying tensions between expressiveness, learnability, and editability. Based on this, we implemented a prototype VPL, VisCode, and evaluated it with 20 users, finding improved comprehension and reduced cognitive load compared to existing VPLs like Scratch and Blockly. Our work contributes a user-centered design framework for VPLs and demonstrates the value of abstract visualizations for expert users.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Tupayachi},
 booktitle = {Proceedings of the 17th {ACM}},
 doi = {10.1145/3681772.3698217},
 isbn = {979-8-4007-1151-0},
 keywords = {Geographical Information},
 note = {event-place: Atlanta},
 pages = {56--59},
 publisher = {Association for Computing Machinery},
 series = {{IWCTS}},
 title = {Conversational {Geographic}},
 url = {https://doi.org/10.1145/3681772.3698217},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:24:21Z},
 year = {2025}
}

@inproceedings{turaga_information_2024,
 abstract = {Big data analytics has become increasingly important in various domains, including healthcare, finance, and social media. However, traditional big data processing frameworks often struggle with the heterogeneity and volume of data generated from diverse sources. In this paper, we propose a novel federated learning framework integrated with edge computing to address these challenges. Our approach enables distributed model training across edge devices while preserving data privacy and reducing latency. We evaluate our framework on real-world datasets from IoT sensors and demonstrate significant improvements in accuracy and efficiency compared to centralized methods. Experimental results show up to 30% reduction in communication overhead and enhanced scalability for large-scale deployments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
