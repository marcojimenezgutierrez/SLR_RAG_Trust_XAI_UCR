@book{shirdel_aprescot_2025,
 abstract = {This paper introduces a novel framework for privacy-preserving data sharing in federated learning environments. We address the challenges of secure aggregation and differential privacy in distributed systems by proposing a lightweight cryptographic protocol that minimizes communication overhead while ensuring strong privacy guarantees. Our approach leverages homomorphic encryption and secure multi-party computation to enable efficient model updates across heterogeneous devices. Extensive experiments on real-world datasets demonstrate that our framework achieves up to 5x faster training times compared to state-of-the-art methods, with negligible impact on model accuracy. We also provide formal proofs of security and discuss practical deployment considerations for edge computing scenarios.},
