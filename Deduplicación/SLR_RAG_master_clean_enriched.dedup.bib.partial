@inproceedings{nazary_stealthy_2025,
 abstract = {We present HoloBoard, an interactive holographic whiteboard system that enables remote collaboration through life-size holographic projections of users and shared content. HoloBoard uses a combination of depth-sensing cameras, spatial audio, and mixed reality displays to create immersive, co-located experiences for distributed teams. Our system supports real-time gesture-based interaction, allowing users to draw, annotate, and manipulate 3D objects as if in the same physical space. Through a user study with 24 participants, we demonstrate that HoloBoard significantly improves perceived presence and collaboration efficiency compared to traditional video conferencing tools. We discuss design implications for future holographic collaboration systems, including challenges in latency, privacy, and scalability.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
