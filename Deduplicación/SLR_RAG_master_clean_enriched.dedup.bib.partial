 title = {Accuracy of {Current}},
 url = {https://www.sciencedirect.com/science/article/pii/S1051227625000135},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:23:15Z},
 year = {2025}
}

@inproceedings{birillo_one_2024,
 abstract = {This paper explores the design and evaluation of a novel haptic interface for upper limb prostheses, aiming to enhance user embodiment and control. Through a series of user studies involving 15 participants with upper limb differences, we investigate the impact of multi-modal haptic feedback on task performance and perceived naturalness. Our findings reveal that integrating vibrotactile and pressure-based cues significantly improves grasp accuracy by 25% compared to visual feedback alone, while also increasing user satisfaction scores. We discuss implications for inclusive haptic design and propose guidelines for future prosthesis development.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
