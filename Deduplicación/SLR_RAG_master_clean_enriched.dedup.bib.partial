@article{xu_enhancing_2024,
 abstract = {Diabetic retinopathy (DR) is one of the major causes of blindness in the world. Early detection and treatment of DR can prevent vision loss. In this paper, we propose a deep learning-based approach for the detection of DR using retinal fundus images. The proposed model uses a convolutional neural network (CNN) architecture to classify the images into five stages of DR: no DR, mild, moderate, severe, and proliferative DR. The model is trained on the APTOS 2019 Blindness Detection dataset, which contains 3,662 training images and 1,928 validation images. The proposed model achieves an accuracy of 92.5% on the validation set, outperforming state-of-the-art methods. The results demonstrate the potential of deep learning in automated DR screening, which can assist ophthalmologists in early diagnosis and treatment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 8},
 author = {Xu},
 doi = {10.1007/978-981-97-5678-0_34},
