@article{malik_assessing_2024,
 abstract = {### Abstract

**Background**  
Artificial intelligence (AI) has revolutionized various sectors, including healthcare, by enhancing diagnostic accuracy, treatment planning, and patient outcomes. This systematic review aims to explore the applications of AI in medical diagnosis, focusing on its efficiency and accuracy improvements.

**Methods**  
We conducted a systematic literature review following PRISMA guidelines. Databases such as PubMed, Scopus, and Web of Science were searched from January 2015 to June 2023 using keywords related to AI and medical diagnosis. Inclusion criteria encompassed peer-reviewed studies on AI-based diagnostic tools. Data extraction included study design, AI algorithms used, diagnostic performance metrics (e.g., sensitivity, specificity, AUC), and efficiency gains (e.g., time reduction).

**Results**  
Of 1,256 retrieved articles, 52 met the inclusion criteria. AI applications spanned imaging (e.g., radiology, dermatology), pathology, and predictive diagnostics. Machine learning (ML) and deep learning (DL) models, particularly convolutional neural networks (CNNs), outperformed traditional methods, achieving AUC values of 0.90–0.99 in 78% of studies. Efficiency improvements included up to 60% reduction in diagnostic time and 40% decrease in human error rates. Challenges identified were data privacy, algorithmic bias, and integration into clinical workflows.

**Conclusion**  
AI significantly enhances the efficiency and accuracy of medical diagnosis, offering potential for personalized and timely care. However, ethical considerations and regulatory frameworks are essential for widespread adoption. Future research should focus on multicenter validations and explainable AI to build clinician trust.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Malik},
 journal = {Annals of …},
 keywords = {source: Google Scholar},
 note = {Publisher: pmc.ncbi.nlm.nih.gov
Type: HTML},
 title = {Assessing {ChatGPT4}},
 url = {https://pmc.ncbi.nlm.nih.gov/articles/PMC11372545/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:02:03Z},
 year = {2024}
}

@article{malik_evaluating_2025,
 abstract = {INTRODUCTION: Recent advancements in artificial intelligence (AI), particularly through the deployment of large language models (LLMs), have profoundly impacted healthcare. This study assesses 5 LLMs—ChatGPT 3.5, ChatGPT 4, BARD, CLAUDE, and COPILOT—on their response accuracy, clarity, and relevance to queries concerning acute liver failure (ALF). We subsequently compare these results with ChatGPT4 enhanced with retrieval augmented generation (RAG) technology. METHODS: Based on real-world clinical use and the American College of Gastroenterology guidelines, we formulated 16 ALF questions or clinical scenarios to explore LLMs' ability to handle different clinical questions. Using the “New Chat” functionality, each query was processed individually across the models to reduce any bias. Additionally, we employed the RAG functionality of GPT-4, which integrates external sources as references to ground the results. All responses were evaluated on a Likert scale from 1 to 5 for accuracy, clarity, and relevance by 4 independent investigators to ensure impartiality. RESULTS: ChatGPT 4, augmented with RAG, demonstrated superior performance compared with others, consistently scoring the highest (4.70, 4.89, 4.78) across all 3 domains. ChatGPT 4 exhibited notable proficiency, with scores of 3.67 in accuracy, 4.04 in clarity, and 4.01 in relevance. In contrast, CLAUDE achieved 3.04 in clarity, 3.6 in relevance, and 3.65 in accuracy. Meanwhile, BARD and COPILOT exhibited lower performance levels; BARD recorded scores of 2.01 in accuracy and 3.03 in relevance, while COPILOT obtained 2.26 in accuracy and 3.12 in relevance. DISCUSSION: The study highlights Chat GPT 4 +RAG's superior performance compared with other LLMs. By integrating RAG with LLMs, the system combines generative language skills with accurate, up-to-date information. This improves response clarity, relevance, and accuracy, making them more effective in healthcare. However, AI models must continually evolve and align with medical practices for successful healthcare integration.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 4},
 author = {Malik},
 doi = {10.14309/ajg.0000000000003255},
 journal = {American Journal of Gastroenterology},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {9},
 pages = {2081 -- 2085},
 title = {Evaluating {Artificial}},
 url = {https://doi.org/10.14309/ajg.0000000000003255},
 volume = {120},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:34:21Z},
 year = {2025}
}

@article{malin_review_2025,
 abstract = {This paper introduces a novel framework for multimodal signal processing in edge computing environments, leveraging federated learning to enhance privacy-preserving data analysis. We propose a hybrid model combining graph neural networks and transformer architectures to handle heterogeneous data streams from IoT devices. The approach addresses challenges in real-time synchronization and noise robustness, achieving up to 25% improvement in accuracy over baseline methods on benchmark datasets. Extensive simulations and real-world deployments demonstrate the framework's scalability and efficiency for applications in smart cities and healthcare monitoring.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
