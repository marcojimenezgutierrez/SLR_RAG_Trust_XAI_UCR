 pages = {2250--2261},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {{ColaCare}},
 url = {https://doi.org/10.1145/3696410.3714877},
 x_enrich_source = {x-ai/grok-4-fast},
