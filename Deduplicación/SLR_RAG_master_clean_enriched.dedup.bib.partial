 title = {Hallucination-aware {Optimization}},
 url = {https://arxiv.org/abs/2412.06007},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:05:46Z},
 year = {2024}
}

@inproceedings{liu_heterrag_2025,
 abstract = {People with upper-body mobility impairments often face barriers to accessing computing devices due to challenges with traditional input modalities like keyboards and mice. Haptic wearables offer a promising alternative, but their design for this population remains underexplored. To investigate the design space, we conducted a study with 12 participants with upper-body mobility impairments. Participants tested prototypes varying in form factor, placement, and haptic feedback type to perform computing tasks. Our findings reveal preferences for discreet, lightweight wearables placed on the lower body, with short, distinct vibrations providing clear feedback. Participants appreciated the privacy and accessibility of haptic input but noted challenges with precision and fatigue. We contribute design implications to guide the development of inclusive haptic wearables for accessible computing.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Liu},
 booktitle = {Proceedings of the 52nd {Annual}},
 doi = {10.1145/3695053.3731089},
