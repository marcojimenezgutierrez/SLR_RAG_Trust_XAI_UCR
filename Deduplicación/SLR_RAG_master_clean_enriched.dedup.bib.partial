@inproceedings{yuan_scx_2025,
 abstract = {This paper presents Echo, a novel audio-based interface for exploring interactive audio spaces in virtual reality (VR). While VR has traditionally relied on visual feedback, audio-driven experiences can enhance immersion and accessibility for users with visual impairments or in low-light environments. Echo enables users to navigate and interact with dynamic soundscapes using spatial audio cues, head tracking, and gesture-based controls. We conducted a user study with 24 participants, including those with varying levels of visual ability, to evaluate Echo's usability, immersion, and effectiveness in spatial awareness tasks. Results show that Echo significantly improves navigation accuracy (p < 0.01) and user engagement compared to traditional audio-only VR systems. Our findings highlight the potential of audio-centric design in making VR more inclusive and suggest directions for future multimodal interfaces.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
