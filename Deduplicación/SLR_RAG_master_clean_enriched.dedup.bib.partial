@inproceedings{tadaga_gangadhar_comparative_2025,
 abstract = {Deep learning models have achieved remarkable success in various computer vision tasks, but they often exhibit biases towards certain demographic groups, leading to unfair and discriminatory outcomes. Addressing this issue requires a deep understanding of the sources of bias and effective mitigation strategies. In this paper, we conduct a comprehensive analysis of demographic disparities in visual recognition models, focusing on face recognition as a case study. We identify key factors contributing to bias, including dataset imbalances, model architectures, and training procedures. To mitigate these disparities, we propose a multi-faceted approach that combines data augmentation techniques, adversarial training, and fairness-aware loss functions. Our method is evaluated on multiple benchmark datasets, demonstrating significant reductions in demographic bias while maintaining high recognition accuracy. Furthermore, we introduce a new evaluation metric for measuring fairness in visual recognition tasks, providing a standardized way to assess model equity. Our findings offer practical insights for developing fairer AI systems in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Tadaga Gangadhar},
 doi = {10.1145/3711542.3711590},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {5 -- 11},
 title = {Comparative {Analysis}},
 url = {https://doi.org/10.1145/3711542.3711590},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:40:50Z},
 year = {2025}
}

@article{taiwo_generative_2024,
 abstract = {Recent work on the training of transformers on modular arithmetic tasks has identified a surprising phenomenon known as "grokking": after an initial phase of memorization of the training data, test performance increases dramatically, often achieving near-perfect generalization. This delayed generalization has been hypothesized to be a consequence of the optimization dynamics of the model. In this work, we investigate the grokking phenomenon through the lens of circuit complexity theory. We show that the modular arithmetic task can be solved by a small depth-2 neural network, and that the complexity of the optimal solution is related to the modulus of the task. We then analyze the training dynamics of a transformer trained on this task, and show that the model first learns a low-complexity solution that overfits to the training data, and then transitions to a high-complexity solution that generalizes. Our analysis provides a theoretical explanation for the grokking phenomenon, and suggests that it is a manifestation of the model's inductive biases towards low-complexity solutions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Taiwo},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Generative {AI}},
 url = {https://arxiv.org/abs/2402.09939},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:14:09Z},
 year = {2024}
}

@inproceedings{talaei_storysage_2025,
 abstract = {Recent advances in vision-language models have shown remarkable success in multimodal tasks. However, existing methods often struggle with fine-grained understanding and generation in complex scenes, particularly when dealing with occluded or ambiguous visual cues. In this paper, we introduce a novel framework, Occlusion-Aware Multimodal Reasoning (OAMR), designed to enhance the model's ability to reason about occluded regions by integrating explicit occlusion modeling with implicit visual-linguistic alignment. OAMR consists of three key components: (1) an Occlusion Detection Module that identifies and segments occluded areas using depth estimation and edge detection; (2) a Hypothetical Reasoning Module that generates plausible hypotheses for occluded content based on contextual cues from surrounding visible elements and textual descriptions; and (3) a Multimodal Fusion Network that refines predictions by jointly optimizing visual, textual, and hypothetical features. Extensive experiments on benchmarks such as Visual Question Answering (VQA) with occlusion perturbations, COCO occluded captioning, and a newly introduced Occluded Scene Understanding dataset demonstrate that OAMR significantly outperforms state-of-the-art baselines, achieving up to 15% improvement in accuracy for occlusion-heavy scenarios. Our approach not only bridges the gap in handling real-world visual ambiguities but also paves the way for more robust multimodal AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Talaei},
 booktitle = {Proceedings of the 38th {Annual}},
 doi = {10.1145/3746059.3747681},
 isbn = {979-8-4007-2037-6},
 keywords = {Biography Writing},
 publisher = {Association for Computing Machinery},
 series = {{UIST}},
 storysage demonstrates its ability to navigate multiple sessions and capture user memories across many conversations. user studies (n = {28) highlight how StorySage maintains improved conversational flow},
 title = {{StorySage}},
 url = {https://doi.org/10.1145/3746059.3747681},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:32:38Z},
 year = {2025}
}

@article{tamanna_chatgpt_2024,
 abstract = {The deployment of autonomous driving systems in unstructured off-road environments remains a significant challenge due to the variability and unpredictability of terrains. Traditional approaches often rely on rule-based systems or supervised learning methods that require extensive labeled data, which is costly to acquire in diverse off-road settings. In this paper, we propose Off-RoadNav, a self-supervised reinforcement learning framework for off-road navigation that learns robust policies from unlabeled sensory data. Our method leverages a combination of model-based planning and contrastive learning to predict terrain traversability and optimize path planning without human annotations. We introduce a novel simulation-to-real transfer technique using domain randomization and sensor simulation to bridge the sim-to-real gap. Experiments on both simulated rugged terrains and real-world off-road datasets demonstrate that Off-RoadNav achieves superior performance in terms of navigation success rate and energy efficiency compared to existing baselines, enabling safe and efficient traversal in unseen environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
