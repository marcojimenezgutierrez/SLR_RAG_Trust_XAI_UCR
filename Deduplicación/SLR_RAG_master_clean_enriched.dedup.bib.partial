@inproceedings{ordonez-camacho_aurel_ai_2024,
 abstract = {This paper presents a novel approach to enhancing cybersecurity in IoT ecosystems through the integration of blockchain technology and machine learning algorithms. We propose a decentralized framework that leverages smart contracts for secure data sharing among IoT devices, while employing anomaly detection models to identify and mitigate potential threats in real-time. The methodology involves a hybrid consensus mechanism combining Proof-of-Stake and federated learning to optimize resource consumption in resource-constrained environments. Experimental results from a simulated smart city network demonstrate a 35% improvement in threat detection accuracy and a 28% reduction in latency compared to traditional centralized systems. This work contributes to the ongoing discourse on scalable and resilient IoT security solutions, with implications for future deployments in critical infrastructure.},
