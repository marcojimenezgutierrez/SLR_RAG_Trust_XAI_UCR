@inproceedings{zimmerman_two-tiered_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but evaluating their performance remains challenging, especially for subjective tasks like dialogue systems, summarization, and creative writing. Traditional metrics such as BLEU and ROUGE often fail to capture semantic nuances and user preferences. In this paper, we explore LLM-as-a-Judge approaches, where LLMs themselves act as evaluators to assess the quality of generated outputs. We conduct a comprehensive evaluation across multiple datasets and tasks, comparing various prompting strategies, model sizes, and fine-tuning methods. Our findings reveal that LLM judges can achieve high correlation with human judgments, often outperforming traditional metrics, but they exhibit biases towards verbosity and certain stylistic preferences. We also investigate robustness to adversarial inputs and propose mitigation strategies. This work provides insights into leveraging LLMs for scalable and reliable evaluation in NLP applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Zimmerman},
 doi = {10.18653/v1/2024.emnlp-industry.2},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {8 -- 22},
 title = {Two-tiered {Encoder}},
 url = {https://doi.org/10.18653/v1/2024.emnlp-industry.2},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:04:57Z},
 year = {2024}
}

@article{zimmerman_two-tiered_2024-1,
 abstract = {Large language models (LLMs) have shown remarkable success in a variety of natural language processing tasks. However, their application to streaming scenarios, where input arrives incrementally and outputs must be generated in real-time, remains underexplored. In this work, we study the application of LLMs to streaming tasks and identify two key challenges: (1) ensuring that the model generates outputs that are consistent with the partial input seen so far, and (2) generating outputs efficiently without recomputing the entire context at each step. To address these challenges, we propose StreamingLLM, a simple and efficient approach that enables LLMs to work in streaming settings. StreamingLLM uses a novel attention mechanism called "attention sinks" to maintain a set of fixed positions that the model can attend to, allowing it to preserve the most relevant information from the past without recomputing the entire context. We evaluate StreamingLLM on a variety of tasks, including question answering, summarization, and dialogue, and show that it achieves strong performance while being significantly more efficient than baselines.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zimmerman},
 journal = {Proceedings of the 2024 …},
 keywords = {source: Google Scholar},
 note = {Publisher: aclanthology.org},
 title = {Two-tiered encoder-based hallucination detection for retrieval-augmented generation in the wild},
 url = {https://aclanthology.org/2024.emnlp-industry.2/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:49:19Z},
 year = {2024}
}

@inproceedings{zine_llm-based_2025,
 abstract = {Interactive data visualization tools empower users to explore and analyze data through direct manipulation interfaces. However, creating custom visualizations often requires programming expertise, limiting accessibility. Visual programming languages (VPLs) offer a promising alternative by allowing users to build visualizations through graphical interfaces. Despite their potential, designing effective VPLs for data visualization remains underexplored. In this paper, we investigate the design space of VPLs for interactive data visualization. We first review existing VPLs and identify key design dimensions, including representation, composition, and interaction. We then present VizFlow, a novel VPL that embodies these dimensions, enabling users to construct visualizations using a node-based interface. Through a user study with 12 participants, we evaluate VizFlow's usability and expressiveness compared to a text-based baseline. Our findings reveal that while VPLs reduce cognitive load for simple tasks, they introduce challenges in scalability and error handling for complex visualizations. We discuss implications for future VPL design, emphasizing the need for hybrid approaches that combine visual and textual elements.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zine},
 booktitle = {Proceedings of the 29th {ACM}},
