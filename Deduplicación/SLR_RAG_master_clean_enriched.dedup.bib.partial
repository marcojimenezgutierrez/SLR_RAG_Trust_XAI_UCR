}

@inproceedings{sun_research_2025,
 abstract = {Augmented reality (AR) headsets are becoming increasingly popular, but their adoption is hindered by usability issues, particularly for users with visual impairments. This paper explores the design and evaluation of an AR system that leverages audio and haptic feedback to assist visually impaired users in navigating indoor environments. Through a series of user studies involving 20 participants, we demonstrate that our multimodal approach significantly improves navigation accuracy and user confidence compared to traditional screen-based aids. Our findings contribute to the growing body of research on inclusive AR technologies, offering insights for future developments in accessible computing.},
