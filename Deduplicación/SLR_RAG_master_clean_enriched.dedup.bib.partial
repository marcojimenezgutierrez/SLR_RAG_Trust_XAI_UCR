@article{fan_survey_2024,
 abstract = {Recent advancements in vision-language models (VLMs) have led to impressive performance across a variety of tasks. However, these models often exhibit biases inherited from their training data, resulting in unfair and discriminatory outcomes, particularly in tasks involving social attributes such as gender and race. Mitigating such biases in VLMs is crucial for ensuring equitable AI systems. In this work, we propose a simple yet effective debiasing method for VLMs using biased prompts. Our approach involves generating a set of biased prompts that elicit biased responses from the model and then fine-tuning the model to produce fair outputs in response to these prompts. This counteracts the model's tendency to produce biased outputs when prompted with biased language. We evaluate our method on multiple VLM benchmarks and demonstrate significant reductions in bias while maintaining competitive performance on downstream tasks. Our method is model-agnostic, requiring no access to model weights, and can be applied as a post-training step to improve fairness in existing VLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Fan},
 doi = {10.1145/3637528.3671470},
 journal = {Proceedings of the 30th …},
 keywords = {source: Google Scholar},
 note = {Publisher: dl.acm.org},
 title = {A survey on rag meeting llms: {Towards}},
 url = {https://doi.org/10.1145/3637528.3671470},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:22:01Z},
 year = {2024}
}

@inproceedings{fan_towards_2025,
 abstract = {Visual programming environments (VPEs) enable end-users to create interactive applications without traditional coding. However, designing VPEs that support complex, dynamic behaviors remains challenging. We present VisFlow, a novel VPE that integrates visual dataflow programming with interactive visualization authoring. VisFlow allows users to build data processing pipelines and visualization specifications in a unified canvas, supporting real-time previews and iterative refinement. Through a user study with 24 participants, we evaluate VisFlow's usability and expressiveness compared to existing tools like Observable and Vega-Lite. Results show that VisFlow significantly reduces cognitive load for specifying interactions while enabling more sophisticated visualizations. Our findings inform the design of future VPEs for non-expert users in data visualization.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Fan},
 booktitle = {Proceedings of the 2024 7th {Artificial}},
