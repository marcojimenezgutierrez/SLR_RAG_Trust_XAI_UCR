 year = {2024}
}

@article{sun_when_2025,
 abstract = {Traditional Medicine (TM) is the oldest healthcare form and has been increasingly adopted as the primary or complementary medical therapy in the world. However, TM's practical development remains highly challenging. While artificial intelligence (AI) has become powerful in advancing modern medicine, limited attention has been paid to its potential and usage in TM. This study addresses this gap through a probe-based interview study with 16 TM clinicians, examining their experiences, perceptions, and expectations of AI-empowered clinical support systems. Our findings reveal that despite numerous AI-CDS systems, their practical usage in TM settings was still limited. We identify a series of practical challenges when integrating AI-CDS into TM clinical scenarios, largely due to TM's unique features and the significant data work challenges these features present. We end by critically discussing the potential issues that may arise when integrating AI into practical TM scenarios, and proposing a series of practical recommendations for future studies.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Sun},
 doi = {10.1145/3757705},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keywords = {adoption},
 month = {oct},
 note = {Place: New York},
 number = {7},
 title = {When {Traditional}},
 url = {https://doi.org/10.1145/3757705},
 volume = {9},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:23Z},
 year = {2025}
}

@inproceedings{sundar_revolutionizing_2024,
 abstract = {Smart homes are becoming increasingly popular, offering convenience and comfort to users. However, the integration of various Internet of Things (IoT) devices in smart homes raises significant security and privacy concerns. Traditional centralized authentication mechanisms are vulnerable to single points of failure and malicious attacks. To address these challenges, this paper proposes a blockchain-based decentralized authentication framework for smart home systems. The framework leverages blockchain technology to provide secure, tamper-proof authentication and access control. We design a smart contract-based system that enables dynamic role-based access management and ensures data integrity. The proposed approach is evaluated through simulations, demonstrating enhanced security, reduced latency, and improved scalability compared to existing methods. Our results indicate that the framework effectively mitigates common threats such as unauthorized access and data breaches in smart home environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Sundar},
 booktitle = {2024 2nd {International}},
 doi = {10.1109/ICSSAS64001.2024.10760285},
 keywords = {Accuracy},
