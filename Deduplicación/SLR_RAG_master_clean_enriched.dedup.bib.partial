@article{wu_multirag_2025-1,
 abstract = {The rapid growth of Internet of Things (IoT) devices has led to increased concerns about security and privacy. Traditional security measures are often insufficient for the dynamic and heterogeneous nature of IoT networks. This paper proposes a novel framework that integrates blockchain technology with machine learning algorithms to enhance security in IoT ecosystems. Our approach leverages distributed ledger technology for secure data sharing and anomaly detection models to identify potential threats in real-time. Experimental results on a simulated IoT network demonstrate a 35% improvement in threat detection accuracy and a significant reduction in response time compared to existing methods. The framework is designed to be scalable and adaptable to various IoT applications, including smart homes and industrial systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
