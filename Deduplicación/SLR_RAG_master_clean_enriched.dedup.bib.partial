@inproceedings{singla_hicon_2024,
 abstract = {The rapid growth of the Internet of Things (IoT) has led to the development of smart agriculture systems that can monitor and optimize farming processes. This paper proposes an IoT-based smart agriculture system that integrates sensors for soil moisture, temperature, humidity, and pH levels, along with machine learning algorithms for predictive analytics. The system uses Arduino as the microcontroller to collect data from sensors and transmit it to a cloud platform via Wi-Fi. Machine learning models, including Random Forest and Support Vector Machine, are employed to predict crop yield and detect anomalies in environmental conditions. The prototype was tested in a controlled greenhouse environment, demonstrating improved water usage efficiency by 25% and early detection of pest infestations. This approach aims to enhance sustainable farming practices and support farmers in decision-making.},
