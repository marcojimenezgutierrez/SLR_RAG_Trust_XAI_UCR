@inproceedings{chu_chatasd_2024,
 abstract = {This paper presents a novel approach to generating privacy-preserving synthetic speech that allows users to control aspects of the output, such as emotion and accent, while minimizing the risk of speaker identification. We introduce Echo, a text-to-speech (TTS) system that leverages diffusion models and federated learning to create diverse voices without relying on real user data. Our method ensures that the generated speech does not leak personal information, addressing key concerns in voice assistants and audiobooks. Evaluations show that Echo achieves high naturalness scores (MOS 4.2/5) and strong privacy guarantees, outperforming baselines in unlinkability tests. We discuss ethical implications and deployment challenges for real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
