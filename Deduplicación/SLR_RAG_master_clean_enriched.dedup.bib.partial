 year = {2024}
}

@inproceedings{gopi_enhancing_2024,
 abstract = {This full paper presents the design, implementation, and evaluation of an innovative active learning strategy for teaching digital logic design using interactive simulations and gamification elements. The approach, termed LogicQuest, integrates a web-based simulation environment with quest-based challenges to engage undergraduate students in exploring combinational and sequential logic circuits. We detail the pedagogical framework, technical architecture, and assessment metrics employed in a semester-long deployment with 120 second-year electrical engineering students. Quantitative analysis of pre- and post-intervention quizzes, along with qualitative feedback from surveys, indicates statistically significant improvements in conceptual understanding (p < 0.01) and student motivation (effect size d = 0.72). Challenges encountered, such as scalability in large classes and integration with existing curricula, are discussed, alongside recommendations for broader adoption in STEM education.},
 abstract_lang = {en},
