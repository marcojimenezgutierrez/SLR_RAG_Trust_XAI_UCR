@inproceedings{nickel_integrating_2025,
 abstract = {With the proliferation of Internet of Things (IoT) devices, managing network traffic and ensuring security have become increasingly complex. Traditional anomaly detection methods often struggle with the scale and heterogeneity of IoT networks. This paper proposes a federated learning framework for distributed anomaly detection in IoT environments. By enabling edge devices to collaboratively train models without sharing raw data, our approach preserves privacy while improving detection accuracy. We evaluate the framework using real-world IoT datasets, demonstrating superior performance in terms of precision, recall, and latency compared to centralized methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Nickel},
 booktitle = {{NOMS}},
 doi = {10.1109/NOMS57970.2025.11073741},
