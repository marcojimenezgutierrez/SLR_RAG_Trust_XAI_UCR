@inproceedings{tvarozek_what_2025,
 abstract = {This paper introduces a novel framework for enhancing knowledge inference in large language models through iterative prompting techniques. We propose a multi-stage prompting strategy that leverages chain-of-thought reasoning combined with external knowledge retrieval to improve factual accuracy and logical consistency in generated responses. Experimental results on benchmark datasets such as TruthfulQA and HellaSwag demonstrate significant improvements, with up to 15% gains in accuracy over baseline models. Our approach is computationally efficient and adaptable to various domains, paving the way for more reliable AI systems in knowledge-intensive tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
