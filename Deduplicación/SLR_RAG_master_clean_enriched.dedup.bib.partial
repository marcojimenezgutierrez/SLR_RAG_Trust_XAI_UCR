@article{luo_agentauditor_2025,
 abstract = {Recent advances in large language models (LLMs) have shown remarkable capabilities in generating human-like text. However, their performance in structured tasks, such as mathematical reasoning, remains limited. In this paper, we introduce a novel framework, MathChain, which leverages chain-of-thought prompting combined with external symbolic computation to enhance LLMs' mathematical reasoning abilities. By decomposing complex problems into intermediate steps and verifying each step using a symbolic solver, MathChain achieves state-of-the-art results on benchmarks like GSM8K and MATH, outperforming previous methods by up to 15%. Our approach bridges the gap between neural and symbolic reasoning, paving the way for more reliable AI systems in scientific and engineering applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
