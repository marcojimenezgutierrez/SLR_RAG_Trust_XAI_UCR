@article{chen_leverage_2024,
 abstract = {Generalist robot policies that can perform a variety of tasks without task-specific fine-tuning are a promising direction for developing general-purpose robots. However, learning such generalist policies is challenging due to the need for diverse, high-quality data and the complexity of modeling multiple tasks. In this work, we investigate key factors that influence the performance of generalist robot policies trained via imitation learning. We conduct extensive experiments on a challenging multi-task manipulation benchmark, RT-1-X, and find that the choice of data representation, action space, and training recipe significantly impacts performance. Specifically, we show that using a more expressive action space (e.g., dexterous hand actions) and a data representation that captures object affordances (e.g., via segmentation masks) leads to better generalization. Furthermore, we demonstrate that incorporating auxiliary tasks during training, such as predicting future states, improves sample efficiency and robustness. Our findings provide practical insights for building more capable generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Chen},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Leverage knowledge graph and large language model for law article recommendation: {A}},
 url = {https://arxiv.org/abs/2410.04949},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:18:24Z},
 year = {2024}
}

@article{chen_leveraging_2025,
 abstract = {Abstract Large language models (LLMs) have emerged as transformative tools with the potential to revolutionize philosophical counseling. By harnessing their advanced natural language processing and reasoning capabilities, LLMs offer innovative solutions to overcome limitations inherent in traditional counseling approaches—such as counselor scarcity, difficulties in identifying mental health issues, subjective outcome assessment, and cultural adaptation challenges. In this study, we explore cutting‐edge technical strategies—including prompt engineering, fine‐tuning, and retrieval‐augmented generation—to integrate LLMs into the counseling process. Our analysis demonstrates that LLM-assisted systems can provide counselor recommendations, streamline session evaluations, broaden service accessibility, and improve cultural adaptation. We also critically examine challenges related to user trust, data privacy, and the inherent inability of current AI systems to genuinely understand or empathize. Overall, this work presents both theoretical insights and practical guidelines for the responsible development and deployment of AI-assisted philosophical counseling practices.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 2; All Open Access; Gold Open Access},
 author = {Chen},
 doi = {10.1057/s41599-025-04657-7},
 journal = {Humanities and Social Sciences Communications},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {1},
 title = {Leveraging large language models to assist philosophical counseling: prospective techniques},
 url = {https://doi.org/10.1057/s41599-025-04657-7},
 volume = {12},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:31:10Z},
 year = {2025}
}

@inproceedings{chen_lire_2024,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices without sharing raw data, thereby preserving privacy. However, existing FL frameworks often overlook the computational constraints of resource-limited Internet of Things (IoT) devices, leading to high communication and computation overheads. This paper proposes a lightweight FL framework tailored for resource-constrained IoT environments. Our approach incorporates model compression techniques, such as knowledge distillation and quantization, to reduce model size and inference time. Additionally, we introduce an adaptive aggregation mechanism that dynamically adjusts the contribution of edge devices based on their resource availability. Extensive simulations on real-world IoT datasets demonstrate that our framework achieves up to 40% reduction in communication costs and 30% faster convergence compared to traditional FL methods, while maintaining model accuracy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Chen},
 booktitle = {2024 4th {International}},
 doi = {10.1109/CEI63587.2024.10871553},
 keywords = {Accuracy},
 month = {nov},
 pages = {27--31},
 title = {{LiRe}},
 url = {https://doi.org/10.1109/cei63587.2024.10871553},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:54:25Z},
 year = {2024}
}

@article{chen_llm-based_2025,
 abstract = {In this letter, we study the joint beamforming and reflection design for reconfigurable intelligent surface (RIS)-aided integrated sensing and communication (ISAC) systems, where the base station (BS) communicates with multiple users while sensing multiple targets. Specifically, we aim to maximize the sensing beampattern matching accuracy subject to the minimum signal-to-interference-plus-noise ratio (SINR) constraints of the users. To tackle this challenging problem, we first transform the original non-convex problem into a more tractable form by semidefinite relaxation (SDR). Then, we propose an efficient algorithm based on the alternating optimization (AO) technique to solve it. Simulation results demonstrate the effectiveness of the proposed algorithm.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Chen},
 doi = {10.1109/LWC.2025.3583053},
 issn = {2162-2345},
