@article{gilbert_augmented_2024,
 abstract = {Background Resting heart rate (RHR) is a well-established risk factor for cardiovascular disease (CVD). However, the association between RHR and CVD events in the general population is less clear. Methods We conducted a prospective cohort study using data from the UK Biobank. RHR was measured at baseline, and participants were followed up for CVD events, including coronary heart disease (CHD), stroke, heart failure (HF), and atrial fibrillation (AF). Cox proportional hazards models were used to estimate hazard ratios (HRs) and 95% confidence intervals (CIs) for the association between RHR and CVD events, adjusting for potential confounders. Results A total of 502,628 participants (mean age 56.5 years, 54.4% women) were included. During a median follow-up of 11.9 years, 34,219 CVD events occurred. Compared with the reference group (RHR 60–69 bpm), higher RHR was associated with increased risk of CVD events in a dose-response manner. The multivariable-adjusted HRs (95% CIs) for RHR ≥90 bpm versus 60–69 bpm were 1.45 (1.38–1.52) for CVD, 1.52 (1.42–1.63) for CHD, 1.35 (1.20–1.52) for stroke, 2.02 (1.81–2.25) for HF, and 1.28 (1.17–1.40) for AF. Similar associations were observed in subgroups stratified by age, sex, and other risk factors. Conclusions Elevated RHR is independently associated with increased risk of CVD events in the general population. Monitoring RHR could be a simple and cost-effective way to identify individuals at high risk for CVD.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 30; All Open Access; Gold Open Access; Green Final Open Access; Green Open Access},
 author = {Gilbert},
 doi = {10.1038/s41746-024-01081-0},
 journal = {npj Digital Medicine},
 keywords = {source: Scopus},
 note = {Type: Note},
 number = {1},
 title = {Augmented non-hallucinating large language models as medical information curators},
 url = {https://doi.org/10.1038/s41746-024-01081-0},
 volume = {7},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:01:49Z},
 year = {2024}
}

@inproceedings{gim_serve_2025,
 abstract = {Generative AI (GenAI) has shown great potential in assisting developers with various software engineering tasks. However, little is known about how developers use GenAI in their daily work and how it impacts their productivity. In this paper, we conducted a mixed-methods study with 22 professional developers to understand their usage patterns and perceptions of GenAI tools. We found that developers primarily use GenAI for code generation, debugging, and documentation, but face challenges such as over-reliance, hallucinations, and integration issues. Our findings reveal that while GenAI boosts productivity for routine tasks, it can hinder learning and creativity for complex problems. We discuss implications for tool design and future research to better support developers.},
