 x_enrich_ts = {2025-11-02T07:20:32Z},
 year = {2025}
}

@inproceedings{guo_integrating_2025,
 abstract = {This paper proposes a novel deep learning framework for real-time object detection in complex environments, leveraging a hybrid convolutional neural network (CNN) architecture combined with attention mechanisms. The model, termed Hybrid Attention Detector (HAD), integrates multi-scale feature fusion and dynamic region proposal networks to enhance accuracy and efficiency. Extensive experiments on benchmark datasets such as COCO and Pascal VOC demonstrate that HAD outperforms state-of-the-art methods by achieving a mean average precision (mAP) of 45.2% while maintaining a processing speed of 120 FPS on standard hardware. The framework's robustness to occlusions and varying lighting conditions makes it suitable for applications in autonomous driving and surveillance systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
