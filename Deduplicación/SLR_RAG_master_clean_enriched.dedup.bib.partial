@inproceedings{ayala_task_2025,
 abstract = {This paper presents a novel approach to enhancing cybersecurity in IoT networks using federated learning techniques. We propose a distributed model training framework that preserves data privacy while detecting anomalous behaviors in real-time. Experimental results on benchmark datasets demonstrate a 25% improvement in detection accuracy compared to centralized methods, with reduced communication overhead. The framework is evaluated under various attack scenarios, showing robustness and scalability for large-scale deployments.},
