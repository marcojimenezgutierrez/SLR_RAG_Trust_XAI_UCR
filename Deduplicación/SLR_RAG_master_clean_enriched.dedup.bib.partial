 year = {2025}
}

@inproceedings{wang_collaboration_2025,
 abstract = {We present HaptiPulse, a novel wearable haptic system designed to provide immersive tactile feedback for virtual reality (VR) experiences. Unlike traditional haptic devices that rely on vibrations or rigid actuators, HaptiPulse uses soft pneumatic actuators to deliver nuanced pressure and shear forces on the user's skin, mimicking real-world textures and interactions. Our system consists of a flexible sleeve worn on the forearm, integrated with a compact air pump and solenoid valves for precise control. We conducted user studies with 24 participants to evaluate HaptiPulse's effectiveness in enhancing presence and embodiment in VR scenarios, such as virtual object manipulation and social interactions. Results show significant improvements in realism perception (p < 0.01) and task performance compared to vibrotactile baselines. We discuss design implications, technical challenges, and future applications in gaming, training, and therapy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wang},
 booktitle = {Proceedings of the 48th {International}},
