@inproceedings{aneja_beyond_2025,
 abstract = {Social media platforms have become a primary source of news for many users, yet the spread of misinformation poses significant challenges. This paper introduces MisinfoGuard, a novel framework for detecting and mitigating misinformation on social media using a combination of graph neural networks (GNNs) and large language models (LLMs). We model user interactions and content propagation as dynamic graphs, where nodes represent posts and users, and edges capture sharing and engagement patterns. By integrating GNNs for structural analysis with LLMs for semantic understanding, MisinfoGuard achieves superior performance in early detection of false information cascades. Experiments on real-world datasets from Twitter and Facebook demonstrate that our approach reduces misinformation spread by up to 45% compared to state-of-the-art baselines, while maintaining low false positive rates.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
