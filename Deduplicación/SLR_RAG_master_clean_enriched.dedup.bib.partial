 isbn = {979-8-4007-1744-4},
 keywords = {Accuracy and comprehensiveness in knowledge retrieval},
 note = {Type: Conference paper},
 pages = {660--667},
 publisher = {Association for Computing Machinery},
 series = {{ICCIP}},
 title = {{URAG}},
 url = {https://doi.org/10.1145/3708657.3708763},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:18:25Z},
 year = {2025}
}

@inproceedings{sonkar_dynamic_2025,
 abstract = {This paper proposes a novel framework for secure data transmission in optical networks using quantum key distribution integrated with machine learning-based anomaly detection. We address the challenges of eavesdropping and cyber threats in high-speed optical communication systems by combining QKD protocols with deep neural networks for real-time threat identification. Simulation results demonstrate a 30% improvement in detection accuracy and enhanced key generation rates compared to traditional methods. The framework is evaluated on a testbed simulating 400Gbps fiber optic links, showing robustness against various attack scenarios.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
