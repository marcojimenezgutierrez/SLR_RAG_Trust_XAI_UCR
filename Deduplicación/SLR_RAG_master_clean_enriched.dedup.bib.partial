@inproceedings{difallah_wikirag_2025,
 abstract = {Haptic feedback is a promising modality for wearable assistive technologies, but current designs often overlook the needs of people with upper-body mobility impairments. We conducted a co-design study with 12 participants with upper-body mobility impairments to explore inclusive design considerations for wearable haptic devices. Through workshops and iterative prototyping, we identified key challenges, including device placement, actuation methods, and feedback interpretability. Participants emphasized the importance of customizable, low-profile designs that accommodate varying levels of dexterity and sensation. Our findings highlight the need for modular systems that allow users to adapt devices to their specific impairments and preferences. We contribute design guidelines and a prototype framework to support the development of accessible wearable haptics, promoting greater inclusivity in assistive technology.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
