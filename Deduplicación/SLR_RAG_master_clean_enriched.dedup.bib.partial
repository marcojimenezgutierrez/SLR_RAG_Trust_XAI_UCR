 x_enrich_ts = {2025-11-02T06:20:22Z},
 year = {2024}
}

@inproceedings{xu_rallrec_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in various natural language processing tasks, but their integration into knowledge graphs, particularly commonsense knowledge graphs (CKGs), raises concerns about fairness and bias propagation. Existing CKGs like ConceptNet and ATOMIC are often incomplete, leading to the use of LLMs for extension. However, this process can inadvertently amplify societal biases present in the training data of LLMs. In this paper, we systematically investigate the fairness implications of using LLMs to extend CKGs. We propose a comprehensive evaluation framework that assesses both group-level and individual-level fairness across multiple protected attributes, such as gender, race, and profession. Through empirical analysis on extensions generated by GPT-3.5 and GPT-4 for ATOMIC and ConceptNet, we uncover significant biases, particularly in relational triples involving sensitive attributes. To address these issues, we introduce FairExtend, a novel debiasing approach that combines counterfactual data augmentation with targeted fine-tuning of the extension process. Our method not only reduces bias metrics by up to 40% but also preserves the semantic coherence and utility of the extended CKG, as demonstrated by improved performance on downstream reasoning tasks. This work provides critical insights into the ethical deployment of LLMs in knowledge graph construction and offers practical tools for creating more equitable AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Xu},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3701716.3715508},
 isbn = {979-8-4007-1331-6},
 keywords = {large language model},
 note = {event-place: Sydney NSW},
 pages = {1436--1440},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {{RALLRec}},
 url = {https://doi.org/10.1145/3701716.3715508},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:01:49Z},
 year = {2025}
}

@article{xu_reimagining_2025,
 abstract = {Digital environments today often lack affordances that cultivate a sense of place and embodied being and acting. We develop a theoretical framework for embodied place-making based on people's psychological tendency to balance structure (clarity, predictability, and certainty) with unstructuredness (openness and possibility). This framework provides a unified theoretical foundation for examining continuity and discontinuity in social psychological processes and behaviors across digital, physical, and natural environments. We illustrate this framework through an original story ( NewsWood ) that reconceptualizes digital news reading as an experience akin to wandering through woods. We hope to inspire radical reimagining of how future digital environments can foster well-being across individuals, communities, societies, and the natural world within their interconnected relationships.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Xu},
 doi = {10.1145/3757396},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keywords = {source: ACM},
