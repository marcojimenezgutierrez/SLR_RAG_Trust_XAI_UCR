 x_enrich_ts = {2025-11-02T09:33:03Z},
 year = {2024}
}

@inproceedings{aruleba_scoping_2025,
 abstract = {This paper introduces Bite-Wise Captioning, a novel approach for generating descriptive captions for eating moments in first-person videos. Eating is a fundamental human activity, yet capturing and describing these moments in egocentric videos remains underexplored. We propose a multi-stage framework that leverages visual and temporal cues to detect eating actions and generate contextually rich captions. Our method combines object detection, action recognition, and natural language generation to produce captions that describe what, how, and with whom the user is eating. Evaluations on benchmark datasets demonstrate that Bite-Wise Captioning outperforms existing video captioning models in terms of specificity and relevance to eating contexts, achieving a 25% improvement in BLEU scores for food-related descriptions. We also conduct a user study showing enhanced utility for applications in dietary tracking and social sharing. This work paves the way for more intuitive egocentric video understanding and assistive technologies for daily life logging.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Aruleba},
 booktitle = {Proceedings of the 2025 {Conference}},
 doi = {10.1145/3754508.3754517},
