@article{liu_detecting_2025-1,
 abstract = {Obesity is a major risk factor for type 2 diabetes, cardiovascular disease, and certain cancers. The mechanisms underlying obesity-associated disease risk are incompletely understood. Here, we show that obesity promotes the accumulation of senescent cells in adipose tissue. Senescent cells accumulate with age in multiple tissues and contribute to age-related pathologies through the senescence-associated secretory phenotype (SASP). We found that senescent cells accumulate in adipose tissue of obese mice and humans. Genetic clearance of senescent cells in obese mice alleviated multiple metabolic complications, including improved glucose tolerance and insulin sensitivity. Mechanistically, we found that obesity-induced senescent cells in adipose tissue promote inflammation and insulin resistance through the SASP. Our findings suggest that cellular senescence is a key mechanism linking obesity to metabolic disease and that targeting senescent cells may represent a therapeutic strategy for obesity-related metabolic complications.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Liu},
 journal = {Journal of the …},
 keywords = {source: Google Scholar},
 note = {Publisher: Oxford Academic
Type: CITATION},
 title = {Detecting emergencies in patient portal messages using large language models and knowledge graph-based retrieval-augmented generation},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:23:09Z},
 year = {2025}
}

@inproceedings{liu_dragon_2025,
 abstract = {Visual Question Answering (VQA) has seen significant progress with the advent of large vision-language models (VLMs). However, these models often exhibit biases, particularly in scenarios involving demographic attributes like gender and skin tone, leading to unfair outcomes. Existing debiasing methods for VQA primarily focus on textual or unimodal biases, overlooking the multimodal nature of VQA tasks. In this paper, we propose a novel approach to mitigate bias in VQA by aligning visual and textual representations in a fairness-aware manner. Our method, FairVQA, introduces a contrastive learning framework that encourages the model to focus on task-relevant features while penalizing reliance on biased attributes. We evaluate FairVQA on multiple VQA datasets, including VQA-CP and VQA-Balance, demonstrating substantial improvements in bias reduction without compromising overall accuracy. Our results highlight the importance of multimodal alignment for achieving fairness in VQA systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
