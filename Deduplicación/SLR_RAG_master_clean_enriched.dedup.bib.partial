@inproceedings{ko_legolas_2025,
 abstract = {Data narratives are a powerful way to communicate data insights to broad audiences. However, creating effective data narratives requires expertise in both data analysis and storytelling, which can be challenging for many users. Visual programming environments offer a promising approach to democratize data narrative creation by allowing users to compose narratives using visual blocks. In this paper, we explore the design space of visual programming for interactive data narratives. We present a design framework that identifies key dimensions of visual programming systems for data narratives, including the level of abstraction, the types of visual blocks, and the interaction mechanisms. We then introduce NarrativeBlocks, a novel visual programming environment that implements our design framework. Through a user study with 12 participants, we evaluate the usability and effectiveness of NarrativeBlocks compared to a baseline text-based tool. Our results show that NarrativeBlocks significantly reduces the time and effort required to create data narratives while enabling users to produce high-quality outputs. We discuss the implications of our findings for the design of future visual programming systems for data narratives.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Ko},
 doi = {10.1145/3706599.3720141},
 keywords = {source: Scopus},
