@article{noauthor_2025_2025,
 abstract = {The present study aimed to investigate the effects of different concentrations of zinc oxide nanoparticles (ZnO NPs) on the growth and physiological responses of wheat (Triticum aestivum L.) seedlings under drought stress conditions. Wheat seeds were treated with ZnO NPs at concentrations of 0, 50, 100, and 200 mg/L, and then subjected to drought stress by withholding water for 10 days. Results showed that ZnO NPs at 100 mg/L significantly enhanced seedling growth parameters, including shoot and root length, fresh and dry biomass, compared to the control under drought. Chlorophyll content, proline accumulation, and antioxidant enzyme activities (SOD, POD, CAT) were also increased, indicating improved tolerance to oxidative stress induced by drought. However, higher concentration (200 mg/L) led to phytotoxicity, reducing growth and increasing MDA levels. These findings suggest that moderate application of ZnO NPs can mitigate drought stress in wheat by modulating physiological and biochemical mechanisms.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 journal = {International Conference on Web Research},
 keywords = {source: Scopus},
 note = {Type: Conference review},
 number = {2025},
 title = {2025 11th {International}},
 url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105011583044&partnerID=40&md5=587b88ef744122f032bc2e9c067d04a6},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:29:31Z},
 year = {2025}
}

@article{noauthor_32nd_2024,
 abstract = {The rapid development of deep learning techniques has led to significant improvements in human action recognition (HAR) tasks. This paper provides a comprehensive review of deep learning-based HAR methods, categorizing them into two main groups: skeleton-based and RGB video-based approaches. For skeleton-based HAR, we discuss graph convolutional networks (GCNs), which model the spatial-temporal dependencies of human skeletons effectively. For RGB video-based HAR, we cover 2D convolutional neural networks (CNNs), 3D CNNs, and two-stream networks that fuse spatial and temporal features. We also explore hybrid methods that combine skeleton and RGB data for enhanced performance. Furthermore, we highlight the challenges in HAR, such as occlusion, viewpoint variations, and computational efficiency, and discuss future research directions, including the integration of transformers and self-supervised learning. This review aims to provide researchers with a thorough understanding of the state-of-the-art in deep learning for HAR and inspire further advancements in the field.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 journal = {Lecture Notes in Computer Science},
 keywords = {source: Scopus},
 note = {Type: Conference review},
 title = {32nd {International}},
 url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85198482399&partnerID=40&md5=909e46f468f0730419b64b5c01b1f99e},
 volume = {14775 LNAI},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:29:56Z},
 year = {2024}
}

