@inproceedings{joy_ai-powered_2025,
 abstract = {This paper investigates the potential impacts of climate change on urban drainage infrastructure, focusing on increased precipitation intensities and their effects on system performance. A case study in a mid-sized U.S. city is used to model current and future scenarios using the EPA SWMM software. Results indicate that under RCP 8.5 projections, peak flows could increase by up to 25% by mid-century, necessitating adaptive design modifications such as larger pipe diameters and green infrastructure integration. The study recommends incorporating probabilistic climate projections into stormwater master planning to enhance resilience.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
