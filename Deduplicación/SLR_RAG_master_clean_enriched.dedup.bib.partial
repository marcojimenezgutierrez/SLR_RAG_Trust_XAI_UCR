@article{ko_retrieval_2024,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices while preserving data privacy, making it suitable for Internet of Things (IoT) applications. However, deploying FL on resource-constrained IoT devices faces challenges due to limited computational power, communication bandwidth, and energy resources. This paper presents a comprehensive survey on FL for resource-constrained IoT devices. We first introduce the background of FL and the unique characteristics of IoT environments. Then, we categorize the existing solutions into three main areas: model optimization techniques (e.g., compression and quantization), communication efficiency methods (e.g., sparsification and quantization), and system-level optimizations (e.g., scheduling and edge computing integration). We analyze the strengths and limitations of these approaches through a comparative study. Finally, we discuss open challenges and future research directions, including security, heterogeneity, and scalability in IoT-FL systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Ko},
 journal = {2024 5th International …},
 keywords = {source: Google Scholar},
 note = {Publisher: ieeexplore.ieee.org},
 title = {Retrieval {Augmented}},
 url = {https://ieeexplore.ieee.org/abstract/document/10754919/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:58:27Z},
 year = {2024}
}

@inproceedings{ko_subgraph-aware_2025,
 abstract = {Binaural beats have been used for decades to induce altered states of consciousness, but their efficacy in virtual reality (VR) environments remains underexplored. This paper investigates the potential of binaural beats to enhance immersion and presence in VR by synchronizing brainwaves with audio stimuli. We conducted a user study with 30 participants, comparing standard VR audio to binaural beat-enhanced audio during a virtual exploration task. Results show significant improvements in reported presence (p < 0.01) and reduced motion sickness symptoms, with EEG data confirming increased alpha wave activity. Our findings suggest binaural beats as a low-cost method to augment VR experiences, with implications for gaming, therapy, and training applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
