@inproceedings{koh_clara_2025,
 abstract = {This paper proposes a novel framework for privacy-preserving data sharing in mobile edge computing environments. We address the challenges of data heterogeneity and resource constraints by integrating federated learning with differential privacy mechanisms. Our approach ensures that sensitive user data remains local while enabling collaborative model training across distributed devices. Experimental evaluations on real-world datasets demonstrate significant improvements in model accuracy and privacy guarantees compared to baseline methods. The framework is designed to be lightweight, making it suitable for resource-limited mobile devices, and scalable for large-scale deployments.},
