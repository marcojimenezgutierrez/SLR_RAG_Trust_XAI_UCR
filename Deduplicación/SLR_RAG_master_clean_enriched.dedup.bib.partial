@article{rackauckas_evaluating_2024,
 abstract = {We introduce Eureka, a human-like embodied agent for open-ended tasks in a Minecraft-inspired environment. Unlike agents trained for specific tasks, Eureka learns a repertoire of skills and applies them to solve diverse, open-ended problems. To achieve this, we propose a novel training framework that combines reinforcement learning with a skill library. The skill library is built by discovering and distilling elementary skills from human demonstrations, which are then used to bootstrap more complex behaviors through hierarchical reinforcement learning. Eureka demonstrates strong generalization, solving novel tasks that require combining multiple skills, and outperforms baselines in both efficiency and success rate. Our approach paves the way for developing generalist agents capable of tackling real-world, open-ended challenges.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
