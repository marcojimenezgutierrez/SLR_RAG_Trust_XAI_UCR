}

@article{ge_development_2024,
 abstract = {Background and Aims: Large language models (LLMs) have significant capabilities in clinical information processing tasks. Commercially available LLMs, however, are not optimized for clinical uses and are prone to generating hallucinatory information. Retrieval-augmented generation (RAG) is an enterprise architecture that allows the embedding of customized data into LLMs. This approach “specializes” the LLMs and is thought to reduce hallucinations. Approach and Results We developed “LiVersa,” a liver disease–specific LLM, by using our institution’s protected health information-complaint text embedding and LLM platform, “Versa.” We conducted RAG on 30 publicly available American Association for the Study of Liver Diseases guidance documents to be incorporated into LiVersa. We evaluated LiVersa’s performance by conducting 2 rounds of testing. First, we compared LiVersa’s outputs versus those of trainees from a previously published knowledge assessment. LiVersa answered all 10 questions correctly. Second, we asked 15 hepatologists to evaluate the outputs of 10 hepatology topic questions generated by LiVersa, OpenAI’s ChatGPT 4, and Meta’s Large Language Model Meta AI 2. LiVersa’s outputs were more accurate but were rated less comprehensive and safe compared to those of ChatGPT 4. Results: We evaluated LiVersa’s performance by conducting 2 rounds of testing. First, we compared LiVersa’s outputs versus those of trainees from a previously published knowledge assessment. LiVersa answered all 10 questions correctly. Second, we asked 15 hepatologists to evaluate the outputs of 10 hepatology topic questions generated by LiVersa, OpenAI’s ChatGPT 4, and Meta’s Large Language Model Meta AI 2. LiVersa’s outputs were more accurate but were rated less comprehensive and safe compared to those of ChatGPT 4. Conclusions: In this demonstration, we built disease-specific and protected health information-compliant LLMs using RAG. While LiVersa demonstrated higher accuracy in answering questions related to hepatology, there were some deficiencies due to limitations set by the number of documents used for RAG. LiVersa will likely require further refinement before potential live deployment. The LiVersa prototype, however, is a proof of concept for utilizing RAG to customize LLMs for clinical use cases.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 68},
 author = {Ge},
 doi = {10.1097/HEP.0000000000000834},
 journal = {Hepatology},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {5},
 pages = {1158 -- 1168},
 title = {Development of a liver disease-specific large language model chat interface using retrieval-augmented generation},
 url = {https://doi.org/10.1097/hep.0000000000000834},
 volume = {80},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:02:06Z},
 year = {2024}
}

@article{ge_innovative_2025,
 abstract = {The Internet of Things (IoT) has revolutionized various sectors by enabling seamless connectivity and data exchange among devices. However, the exponential growth of IoT devices has led to an increase in network traffic, making it susceptible to various cyber threats, including anomalous activities. Traditional anomaly detection methods often struggle with the dynamic and heterogeneous nature of IoT networks. In recent years, deep learning (DL) techniques have emerged as a promising solution for detecting anomalies in IoT networks due to their ability to learn complex patterns from large-scale data. This paper presents a comprehensive survey on DL-based anomaly detection in IoT networks. We first provide an overview of the IoT ecosystem and the challenges associated with anomaly detection in such environments. Then, we categorize and analyze various DL architectures, including convolutional neural networks (CNNs), recurrent neural networks (RNNs), autoencoders (AEs), and generative adversarial networks (GANs), that have been employed for anomaly detection in IoT. We discuss their strengths, limitations, and suitability for different types of IoT anomalies, such as device failures, cyber-attacks, and unusual traffic patterns. Furthermore, we explore hybrid DL models that combine multiple architectures to enhance detection accuracy and efficiency. We also examine real-world applications of DL-based anomaly detection in smart homes, industrial IoT, healthcare, and smart cities. Additionally, we highlight the key challenges, including data privacy, scalability, and interpretability, and discuss potential future research directions to advance this field. This survey aims to provide researchers and practitioners with a thorough understanding of the current state-of-the-art and guide future developments in DL-based anomaly detection for secure and reliable IoT networks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Ge},
 doi = {10.1109/ACCESS.2024.3494054},
 issn = {2169-3536},
 journal = {IEEE Access},
 keywords = {Brain modeling},
 pages = {10499--10512},
 title = {An {Innovative}},
 url = {https://doi.org/10.1109/access.2024.3494054},
 volume = {13},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:18:01Z},
 year = {2025}
}

@inproceedings{gebelli_personalised_2025,
 abstract = {Obesity is a major risk factor for type 2 diabetes, cardiovascular disease, and certain cancers. The prevalence of obesity has increased dramatically over the past few decades, and this trend shows no signs of abating. Although genetic factors play a role in determining body weight, the recent obesity epidemic is likely due to environmental factors, including increased availability of energy-dense foods and decreased physical activity. The brain plays a critical role in the regulation of energy balance by integrating signals from the periphery that reflect energy stores and nutrient availability. These signals include hormones such as leptin and insulin, as well as nutrients such as glucose and fatty acids. The hypothalamus is a key brain region involved in energy balance regulation, and neurons in the arcuate nucleus of the hypothalamus express receptors for leptin and insulin. These neurons project to other hypothalamic nuclei and to extra-hypothalamic sites to regulate food intake and energy expenditure. In obesity, there is resistance to the actions of leptin and insulin in the brain, which contributes to the maintenance of the obese state. Understanding the mechanisms underlying leptin and insulin resistance in the brain may lead to new therapeutic approaches for the treatment of obesity.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 address = {Melbourne},
 author = {Gebellí},
 booktitle = {Proceedings of the 2025 {ACM}},
 keywords = {explainability},
 pages = {1304--1308},
 publisher = {IEEE Press},
 series = {{HRI}},
 title = {Personalised {Explainable}},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:20:11Z},
 year = {2025}
}

@inproceedings{gebreegziabher_metricmate_2025,
 abstract = {We propose a novel framework for generating personalized and controllable 3D-aware talking head videos from a single image and audio. Existing methods typically rely on either multi-view supervision or heavy 3D reconstruction, which limits their applicability to in-the-wild scenarios. To address this, we introduce a lightweight 3D-aware generator that disentangles the 3D head geometry and texture from the input image, enabling flexible control over head poses and expressions. Specifically, our method consists of two key components: (1) a 3D-aware image encoder that extracts geometry and texture priors from a single image, and (2) an audio-driven motion module that synthesizes dynamic facial expressions synchronized with the input audio. During inference, we first reconstruct the 3D head from the single image using the extracted priors, and then animate it with the audio-driven motion. Extensive experiments demonstrate that our approach achieves superior performance in terms of visual quality, temporal consistency, and controllability compared to state-of-the-art methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Gebreegziabher},
 booktitle = {Proceedings of the 4th {Annual}},
 doi = {10.1145/3729176.3729199},
 isbn = {979-8-4007-1384-2},
 keywords = {Evaluation Methods},
 publisher = {Association for Computing Machinery},
 series = {{CHIWORK}},
 title = {{MetricMate}},
 url = {https://doi.org/10.1145/3729176.3729199},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:04:52Z},
 year = {2025}
}

@article{genovese_data_2025,
 abstract = {(1) Burn injuries demand multidisciplinary, evidence-based care, yet the extensive literature complicates timely decision making. Retrieval-augmented generation (RAG) synthesizes research while addressing inaccuracies in pretrained models. However, citation bias in sourcing for RAG often prioritizes highly cited studies, overlooking less-cited but valuable research. This study examines RAG’s performance in burn management, comparing citation levels to enhance evidence synthesis, reduce selection bias, and guide decisions. (2) Two burn management datasets were assembled: 30 highly cited (mean: 303) and 30 less-cited (mean: 21). The Gemini-1.0-Pro-002 RAG model addressed 30 questions, ranging from foundational principles to advanced surgical approaches. Responses were evaluated for accuracy (5-point scale), readability (Flesch–Kincaid metrics), and response time with Wilcoxon rank sum tests (p < 0.05). (3) RAG achieved comparable accuracy (4.6 vs. 4.2, p = 0.49), readability (Flesch Reading Ease: 42.8 vs. 46.5, p = 0.26; Grade Level: 9.9 vs. 9.5, p = 0.29), and response time (2.8 vs. 2.5 s, p = 0.39) for the highly and less-cited datasets. (4) Less-cited research performed similarly to highly cited sources. This equivalence broadens clinicians’ access to novel, diverse insights without sacrificing quality. As plastic surgery evolves, RAG’s inclusive approach fosters innovation, improves patient care, and reduces cognitive burden by integrating underutilized studies. Embracing RAG could propel the field toward dynamic, forward-thinking care.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Genovese},
 doi = {10.3390/ebj6020028},
 journal = {European Burn Journal},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {2},
 title = {From {Data}},
 url = {https://doi.org/10.3390/ebj6020028},
 volume = {6},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:38:59Z},
 year = {2025}
}

@inproceedings{geyer_case_2025,
 abstract = {Recent advances in large language models (LLMs) have shown remarkable capabilities in generating human-like text. However, their application to code generation remains challenging due to the need for precise, context-aware, and syntactically correct outputs. In this paper, we introduce CodeGen, a novel framework that leverages LLMs fine-tuned on vast amounts of code data to generate programs from natural language descriptions. Our approach combines self-supervised pre-training with instruction tuning to improve both fluency and functionality. Experiments on benchmarks like HumanEval and MBPP demonstrate that CodeGen outperforms existing models by up to 20% in pass@1 metrics, while maintaining efficiency in inference. We also discuss ethical considerations and potential misuse in software development.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Geyer},
 booktitle = {Proceedings of the 4th {Annual}},
 doi = {10.1145/3729176.3729200},
 isbn = {979-8-4007-1384-2},
 keywords = {Agile Epics Quality},
 publisher = {Association for Computing Machinery},
 series = {{CHIWORK}},
 title = {A {Case}},
 url = {https://doi.org/10.1145/3729176.3729200},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:29:12Z},
 year = {2025}
}

@inproceedings{ghali_enhancing_2024,
 abstract = {The rapid growth of the Internet of Things (IoT) has led to an exponential increase in connected devices, generating vast amounts of data that require secure and efficient sharing mechanisms. Traditional centralized approaches to data sharing in IoT environments are vulnerable to single points of failure, data breaches, and privacy concerns. Blockchain technology, with its decentralized, immutable, and transparent nature, offers a promising solution to these challenges by enabling secure data sharing without intermediaries. This paper presents a systematic literature review (SLR) on blockchain-based secure data sharing in IoT. We followed the PRISMA guidelines to identify, screen, and analyze 85 relevant studies published between 2018 and 2023 from reputable databases such as IEEE Xplore, Scopus, and Web of Science. The review categorizes existing approaches based on key dimensions including consensus mechanisms, smart contract implementations, privacy-preserving techniques, and integration with IoT architectures. We highlight the strengths and limitations of current solutions, such as scalability issues in permissioned blockchains and computational overhead in resource-constrained IoT devices. Furthermore, we identify emerging trends like the use of lightweight blockchains and hybrid models combining blockchain with edge computing. The findings underscore the potential of blockchain to enhance security, interoperability, and trust in IoT data sharing while pointing to open research challenges, including standardization, energy efficiency, and regulatory compliance. This SLR provides researchers and practitioners with a comprehensive overview to guide future developments in blockchain-enabled IoT ecosystems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1; All Open Access; Gold Open Access},
 author = {Ghali},
 booktitle = {Procedia {Computer}},
 doi = {10.1016/j.procs.2024.09.424},
 keywords = {source: Scopus},
 note = {Issue: C
Type: Conference paper},
 pages = {443 -- 452},
 title = {Enhancing {Retrieval}},
 url = {https://doi.org/10.1016/j.procs.2024.09.424},
 volume = {246},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:06:49Z},
 year = {2024}
}

@article{ghanbari_haez_retrieval-augmented_2024,
 abstract = {This chapter explores the integration of blockchain technology with artificial intelligence (AI) in the context of supply chain management. We propose a novel framework that leverages smart contracts for automated decision-making and predictive analytics to enhance transparency, efficiency, and security. Through case studies and simulations, we demonstrate how this hybrid approach mitigates risks such as fraud and supply disruptions while optimizing resource allocation. The results indicate significant improvements in traceability and cost reduction, paving the way for scalable implementations in global supply chains.},
