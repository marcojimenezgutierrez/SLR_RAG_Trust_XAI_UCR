 x_enrich_ts = {2025-11-02T07:42:28Z},
 year = {2020}
}

@inproceedings{bruzzone_generative_2024,
 abstract = {The rapid growth of electric vehicles (EVs) has led to significant challenges in power grid management, particularly in terms of load balancing and energy distribution. This paper proposes a multi-agent system (MAS) framework for smart grid management that integrates renewable energy sources and EV charging stations. The system employs autonomous agents representing grid components, EVs, and renewable sources to optimize energy flow through negotiation and coordination protocols. Simulation results using JADE platform demonstrate improved grid stability, reduced peak loads by up to 25%, and enhanced integration of intermittent renewables. The approach offers a scalable solution for future smart grids facing increasing electrification demands.},
 abstract_lang = {en},
