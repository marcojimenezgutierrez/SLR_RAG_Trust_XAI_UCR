 year = {2025}
}

@book{farris_notitle_2025,
 abstract = {With the rapid proliferation of Internet of Things (IoT) devices, the volume of data generated at the network edge has exploded, necessitating efficient processing paradigms. Traditional cloud-centric computing struggles with latency, bandwidth, and privacy concerns in such scenarios. Federated Learning (FL) has emerged as a decentralized machine learning approach that enables collaborative model training across distributed devices while keeping data localized. This paper provides a comprehensive survey on FL for edge computing, categorizing existing frameworks based on communication efficiency, privacy preservation, and resource heterogeneity. We analyze key challenges including non-IID data distributions, device heterogeneity, and incentive mechanisms, and discuss promising future directions such as integration with blockchain and 6G networks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Farris},
 isbn = {978-1-63343-708-1},
 keywords = {AI book},
 note = {Publication Title: How Large Language Models Work},
 publisher = {Manning},
