 title = {Healthcare {Diagnostic}},
 url = {https://doi.org/10.1109/emergin63207.2024.10961136},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:12:49Z},
 year = {2024}
}

@inproceedings{siragusa_unipa-gpt_2024,
 abstract = {Deep learning (DL) models are now being used in many medical imaging studies, but a comprehensive review of DL applications in medical imaging is lacking. This review aims to present a detailed survey of the DL applications in medical imaging. We first introduce the basic concepts of DL and then review the DL applications in medical imaging, including image classification, object detection, image segmentation, image registration, image reconstruction, and other tasks. We also discuss the challenges and future directions of DL in medical imaging. This review provides a comprehensive overview of the current state-of-the-art DL methods in medical imaging and can serve as a guide for researchers and clinicians to better understand and apply DL in medical imaging.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
