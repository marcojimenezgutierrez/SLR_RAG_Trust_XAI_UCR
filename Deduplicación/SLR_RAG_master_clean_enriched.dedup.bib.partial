}

@inproceedings{guo_knowledge_2024,
 abstract = {The rapid development of deep learning technology has led to the widespread application of convolutional neural networks (CNNs) in various fields. However, traditional CNNs often suffer from issues such as gradient disappearance and insufficient extraction of deep features when processing complex images. To address these problems, this paper proposes an improved ResNet model based on the Residual Network (ResNet). The model incorporates the Dense Block structure from DenseNet to enhance feature reuse and mitigate the vanishing gradient problem. Additionally, a Channel Attention Mechanism is introduced to dynamically adjust the weights of feature channels, thereby improving the model's focus on important features. Experimental results on the CIFAR-10 and CIFAR-100 datasets demonstrate that the improved model achieves higher accuracy and better generalization performance compared to the original ResNet, validating the effectiveness of the proposed enhancements.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Guo},
 doi = {10.1109/ICICML63543.2024.10958051},
 keywords = {Accuracy},
