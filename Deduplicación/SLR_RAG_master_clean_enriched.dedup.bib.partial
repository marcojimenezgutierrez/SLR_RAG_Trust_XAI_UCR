@article{zeeshan_llm-based_2025,
 abstract = {The rapid evolution of wireless communications has led to the exploration of reconfigurable intelligent surfaces (RISs) as a transformative technology for future networks. This article presents a comprehensive survey on RIS-assisted wireless communications, covering fundamental principles, key enabling technologies, and emerging applications. We first introduce the basic concepts of RIS, including its working mechanism and channel modeling. Then, we discuss the design challenges and optimization techniques for RIS deployment, such as passive beamforming, active RIS, and hybrid architectures. Furthermore, we review the state-of-the-art in RIS hardware implementations and experimental validations. Finally, we outline future research directions, including integration with 6G technologies, security aspects, and practical deployment considerations.},
