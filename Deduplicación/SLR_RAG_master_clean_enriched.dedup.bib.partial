 year = {2025}
}

@inproceedings{yu_llms_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating fluent and coherent text. However, they often produce factually incorrect or inconsistent content, known as hallucinations. Detecting hallucinations in LLMs is crucial for their safe and reliable deployment. Existing methods for hallucination detection typically rely on external knowledge sources or reference texts, which may not always be available or accurate. In this paper, we propose a novel approach for fine-grained hallucination detection that operates without external references. Our method leverages the internal consistency of the model's generations by prompting the LLM to self-evaluate its outputs at the sentence level. We introduce a new benchmark dataset, HalluQA, consisting of question-answering pairs with fine-grained hallucination annotations. Experimental results demonstrate that our approach achieves state-of-the-art performance in detecting hallucinations, outperforming baselines by up to 15% in F1 score. Our work provides a scalable and reference-free solution for enhancing the trustworthiness of LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 2},
 author = {Yu},
 doi = {10.18653/v1/2024.findings-emnlp.794},
