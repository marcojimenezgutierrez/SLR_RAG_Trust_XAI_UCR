@inproceedings{zhang_enhancing_2023,
 abstract = {Interactive data analysis often involves iterative exploration, where users repeatedly adjust their analysis to gain insights. However, existing visual programming languages (VPLs) for data processing are often rigid, making it difficult for users to experiment and iterate quickly. In this paper, we explore the design space of VPLs for interactive data processing, focusing on three key dimensions: expressiveness, interactivity, and usability. We present a novel VPL called DataFlow, which allows users to build data processing pipelines through a drag-and-drop interface with real-time previews and automatic error correction. Through a user study with 20 participants, we evaluate DataFlow against two baselines: a text-based scripting environment (Python with Pandas) and a commercial VPL (Tableau Prep). Results show that DataFlow significantly reduces task completion time (by 35%) and error rates (by 42%) while maintaining comparable accuracy, highlighting the potential of adaptive VPLs for exploratory data analysis.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhang},
 booktitle = {Proceedings of the {Fourth}},
