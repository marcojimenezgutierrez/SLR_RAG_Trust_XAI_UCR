@article{neumann_llm-driven_2025,
 abstract = {This article explores the integration of project-based learning (PBL) in electrical engineering education, focusing on its impact on student outcomes. A systematic literature review was conducted, analyzing 52 studies published between 2010 and 2023. The findings indicate that PBL enhances critical thinking, teamwork, and practical skills, though challenges such as resource constraints and assessment difficulties persist. Recommendations for effective implementation in diverse educational settings are provided.},
