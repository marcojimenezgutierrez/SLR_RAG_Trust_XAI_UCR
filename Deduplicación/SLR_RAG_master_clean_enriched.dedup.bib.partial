 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Dynamic {Superblock}},
 url = {https://doi.org/10.1145/3726302.3730183},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:17:38Z},
 year = {2025}
}

@inproceedings{carmel_liverag_2025,
 abstract = {Data narratives are a powerful medium for communicating data stories, but creating them requires expertise in both data analysis and storytelling. Visual programming environments have the potential to democratize data narrative creation by allowing users to build interactive visualizations through direct manipulation. However, little is known about how to design such environments to support the creation of data narratives. In this paper, we explore the design space of visual programming for data narratives through two studies. First, we conducted a formative study with 12 data narrative creators to understand their workflows and needs. Based on these findings, we designed Narratize, a visual programming environment for creating data narratives. We then evaluated Narratize with 16 participants, who created data narratives using it. Our results show that Narratize enables users to create data narratives more efficiently and with higher quality than a baseline tool, and that it supports a range of workflows. We discuss implications for the design of visual programming environments for data narratives and opportunities for future research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
