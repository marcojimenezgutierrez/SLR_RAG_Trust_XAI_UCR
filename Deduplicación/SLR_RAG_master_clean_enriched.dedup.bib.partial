@inproceedings{sankararaman_provenance_2024,
 abstract = {Large language models (LLMs) have revolutionized various natural language processing tasks, but their application in knowledge-intensive scenarios, such as question answering over knowledge bases (KBQA), remains challenging due to the need for extensive training data and domain-specific knowledge. In this paper, we propose a novel unsupervised in-context learning approach to bootstrap LLMs for few-shot KBQA. Our method leverages the LLM's inherent reasoning capabilities to generate synthetic training examples from a small set of seed queries and schema information, without requiring labeled data. We then use these examples to guide the LLM in performing KBQA through in-context learning. Experiments on three benchmark datasets demonstrate that our approach significantly outperforms standard few-shot prompting and achieves competitive performance with supervised fine-tuning, while being fully unsupervised and adaptable to new domains with minimal setup.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
