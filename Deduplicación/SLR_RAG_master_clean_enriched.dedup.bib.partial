 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:05:19Z},
 year = {2024}
}

@inproceedings{singh_leftovers_2024,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their ability to perform complex reasoning remains a significant challenge. In this paper, we explore the potential of LLMs to perform chain-of-thought (CoT) reasoning without explicit prompting. We introduce a novel training approach that encourages the model to internally generate intermediate reasoning steps during inference, mimicking human-like thought processes. Our method, dubbed Implicit Chain-of-Thought (ICoT), leverages self-supervised learning on synthetic reasoning traces derived from existing datasets. Experiments on arithmetic, commonsense, and symbolic reasoning benchmarks demonstrate that ICoT significantly improves performance over standard fine-tuning, approaching the effectiveness of explicit CoT prompting while reducing inference latency. We further analyze the internal representations to show that ICoT models develop emergent reasoning capabilities, paving the way for more efficient and generalizable LLM reasoning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Singh},
 booktitle = {Proceedings of the 15th {ACM}},
 doi = {10.1145/3629526.3645045},
