@inproceedings{lin_novel_2024,
 abstract = {Large language models (LLMs) have shown remarkable success in various natural language processing tasks. Recently, there has been a growing interest in leveraging the power of LLMs for recommender systems. In this paper, we provide a systematic and comprehensive survey on the LLM-based recommendation systems. First, we introduce the fundamentals of LLMs and recommender systems. Then, we present the recent advances in LLM-based recommendation from four perspectives: general-purpose LLM-based recommendation, domain-specific LLM-based recommendation, LLM-based recommendation enhancement, and LLM-based user interest modeling. We also discuss the challenges and future directions in this field. This survey aims to provide researchers with a comprehensive understanding of the current state-of-the-art and inspire further research in LLM-based recommendation systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
