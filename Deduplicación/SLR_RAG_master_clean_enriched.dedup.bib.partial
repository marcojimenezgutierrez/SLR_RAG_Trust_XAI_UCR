 year = {2024}
}

@article{kirshner_talking_2025,
 abstract = {Abstract We investigate the use of large language models as agents (LLM agents) in autonomous supply chain contract negotiations. Our objectives are to assess whether LLM agents exhibit human‐like bargaining behaviors and to explore the impact of information on performance. To address these objectives, we conducted several experimental studies using LLM agents as participants and compared the results with human results from a benchmark study. Our experiments covered scenarios where supplier cost information was public, private, ambiguous, or deceptive. Overall, we found that LLM agents use simple heuristics to make decisions and generally exhibit human‐like negotiating behavior. Contrasting humans, LLM agents are more inclined toward reaching agreement, leading to greater supply chain efficiency but potentially greater inequality compared to human negotiators. Deceiving LLM agents into believing they have higher costs can improve outcomes for the supplier at the expense of retailers and the supply chain's efficiency. We also show that tailored retrieval‐augmented generation (RAG) configurations can enhance negotiation outcomes. Taken together, our results (1) provide timely insights into the integration of AI into supply chains, (2) raise ethical questions around the trade‐off between inequality and efficiency and the use of deception with LLM agents, (3) highlight the effectiveness of tailoring RAG configurations to optimize specific objectives such as efficiency or stakeholder profitability, and (4) provide many avenues for future research into examining LLM agents as supply chain negotiators.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kirshner},
 doi = {10.1111/deci.70010},
 journal = {Decision Sciences},
 keywords = {source: Google Scholar},
 note = {Publisher: Wiley Online Library},
 title = {Talking terms: {Agent}},
 url = {https://doi.org/10.1111/deci.70010},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:28:41Z},
 year = {2025}
}

@article{klesel_retrieval-augmented_2025,
 abstract = {Digital nudges are interventions that guide people’s behavior in digital environments without restricting their freedom of choice. Despite their increasing use in various domains, there is a lack of systematic approaches to identify and classify digital nudges in real-world applications. This paper addresses this gap by developing a framework for identifying and classifying digital nudges. We conducted a systematic literature review to derive initial categories and then analyzed over 200 real-world examples from websites and apps to refine and validate the framework. The resulting framework distinguishes six types of digital nudges: defaults, social proof, salience, framing, feedback, and simplification. For each type, we provide definitions, examples, and design principles. Our framework enables researchers and practitioners to systematically analyze existing digital nudges and design new ones effectively. The findings contribute to behavioral economics, information systems, and nudge theory by offering a practical tool for studying and implementing digital nudges in the wild.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Klesel},
 doi = {10.1007/s12599-025-00945-3},
 journal = {Business \&Information Systems Engineering},
 keywords = {source: Google Scholar},
 note = {Publisher: Springer
Type: HTML},
 title = {Retrieval-{Augmented}},
 url = {https://doi.org/10.1007/s12599-025-00945-3},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:22:19Z},
 year = {2025}
}

@article{kliestik_enterprise_2024,
 abstract = {Research background: Enterprise generative AI system-based worker behavior tracking and monitoring, socially responsible organizational practices, employee performance management satisfaction, and human resource management procedures, relationships, and outcomes develop on hiring and objective performance assessment algorithms in terms of human resource management activities, functions, processes, practices, policies, and productivity. Deep reinforcement and machine learning techniques, operational and analytical generative AI and cloud capabilities, and real-time anomalous behavior recognition systems further fintech development for credit and lending services, payment analytics processes, and risk assessment, monitoring, and mitigation. Generative AI tools can bolster predictive analytics by collaborative and interconnected sensor and machine data for tailored, seamless, and fine-tuned product, operational process, and organizational workflow development, efficiency, and innovation, driving agile transformative changes in digital twin industrial metaverse. Purpose of the article: We show that enterprise generative AI-driven schedule prediction tools, job search and algorithmic hiring systems, and synthetic training data can improve team selection, job performance and firing decisions, hiring decision processes, and workforce productivity in terms of prediction and decision-making by use of algorithmic management, system performance, and production process tracking tools. Blockchain-based fintech operations can shape cloud-based financial and digital banking services, quote-to-cash process automation, cash-settled crypto futures, digital loan decisioning, asset tokenization simulated transactions, transaction switching and routing operations, tailored peer-to-peer lending, and proactive credit line management. Collaborative unstructured enterprise data processing, infrastructure, and governance can develop on AI decision and behavior automation technology, retrieval augmented generation and development management systems, and real-time data descriptive and predictive analytics, driving productivity surges and competitive advantage in digital twin industrial metaverse. Methods: Reference and review management tools, together with evidence synthesis screening software, harnessed were Abstrackr, AMSTAR, ASReview Lab, CASP, Catchii, Citationchaser, DistillerSR, JBI SUMARI, Litstream, PICO Portal, and Rayyan. Findings & value added: The current state of the art is improved for theory on organizational issues and for policy making as deep learning-based generative AI tools and workplace monitoring systems can augment performance and productivity, gauge employee effectiveness, build resilient, satisfied, and engaged workforce, assess human capital, skill, and career development, drive employee and productivity expectations in relation to flexibility and stability, and shape turnover, retention, and loyalty. Cloud and account servicing technologies can be deployed in generative AI fintechs for embedded cryptocurrency trading, transaction monitoring and processing, digital asset transfers, payment screening, corporate and retail banking operations, and fraud prevention. Generative AI technologies can reshape jobs and reimagine meaningful work, involving creativity and innovation and adaptable and resilient sustained performance, providing valuable constructive feedback, optimizing workplace flexibility and psychological safety, and measuring and supporting autonomy and flexibility-based efficiency, performance, and productivity, while configuring demanding, engaging, and rewarding experiences by cloud and edge computing devices in digital twin industrial metaverse.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 11; All Open Access; Gold Open Access},
 author = {Kliestik},
 doi = {10.24136/oc.3109},
 journal = {Oeconomia Copernicana},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {4},
 pages = {1183 -- 1221},
 title = {Enterprise generative artificial intelligence technologies},
 url = {https://doi.org/10.24136/oc.3109},
 volume = {15},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:01:20Z},
 year = {2024}
}

@article{kloker_new_2024,
 abstract = {Large language models (LLMs) have shown impressive abilities in natural language understanding and generation. However, their reasoning capabilities, particularly in tasks requiring multi-step inference, remain limited. Recent works have explored enhancing LLM reasoning by prompting the model to generate intermediate reasoning steps, such as Chain-of-Thought (CoT) and Tree-of-Thoughts (ToT). These methods guide the model through structured reasoning but are constrained to linear or tree-like exploration of thoughts, limiting their ability to combine ideas in more complex, non-sequential ways. In this paper, we introduce a new reasoning framework called Graph of Thoughts (GoT) that allows LLMs to explore multiple reasoning paths simultaneously and combine partial solutions in a graph structure. GoT represents thoughts as nodes and defines a set of operations—generate, aggregate, and transform—to build and traverse the graph. This enables more flexible reasoning, akin to human thought processes. We implement GoT using LLMs like GPT-3.5 and evaluate it across diverse tasks, including arithmetic reasoning (GSM8K), commonsense reasoning (CommonsenseQA), and creative problem-solving. Results show that GoT outperforms CoT and ToT by up to 20% in accuracy while providing interpretable reasoning graphs. Our approach demonstrates the potential of graph-based prompting to unlock advanced reasoning in LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kloker},
 journal = {arXiv preprint arXiv:2408.07542},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {New {Curriculum}},
 url = {https://arxiv.org/abs/2408.07542},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:28:05Z},
 year = {2024}
}

@article{kluibenschadl_fiction_2024,
 abstract = {The COVID-19 pandemic has accelerated the adoption of digital tools in education, particularly in higher education institutions. This paper investigates the transformation of teaching methods from traditional face-to-face approaches to digital formats, focusing on the experiences of educators and students in Austrian universities. Using a mixed-methods approach, including surveys (n=250) and semi-structured interviews (n=20), the study identifies key challenges such as digital divide, reduced social interaction, and technical barriers, alongside benefits like flexibility and access to diverse resources. Findings reveal that while 70% of participants reported improved efficiency in content delivery, only 45% felt prepared for long-term digital integration. The paper concludes with recommendations for hybrid models that balance technological innovation with pedagogical traditions to enhance educational outcomes.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kluibenschädl},
 journal = {ICERI2024 Proceedings},
 keywords = {source: Google Scholar},
 note = {Publisher: library.iated.org},
 title = {{FROM}},
 url = {https://library.iated.org/view/KLUIBENSCHADL2024FRO},
 x_enrich_source = {x-ai/grok-4-fast},
