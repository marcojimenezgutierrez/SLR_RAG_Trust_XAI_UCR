@article{tozuka_application_2025,
 abstract = {Purpose To investigate the utility of a deep learning (DL)-based algorithm for automated detection of mediastinal lymph node metastasis in patients with lung cancer using contrast-enhanced computed tomography (CT). Methods This retrospective study included 200 patients with lung cancer who underwent contrast-enhanced CT and had pathological confirmation of mediastinal lymph node status. A DL model based on a 3D convolutional neural network was trained on 150 cases and tested on 50 cases. The model’s performance was evaluated using sensitivity, specificity, accuracy, and area under the receiver operating characteristic curve (AUC). Results The DL model achieved a sensitivity of 92.3%, specificity of 88.5%, accuracy of 90.0%, and AUC of 0.94 for detecting mediastinal lymph node metastasis. Interobserver agreement between radiologists and the DL model was substantial (kappa = 0.78). Conclusion The DL-based algorithm demonstrated high diagnostic performance for automated detection of mediastinal lymph node metastasis on contrast-enhanced CT, potentially aiding in the efficient triage of patients for further evaluation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 16},
 author = {Tozuka},
 doi = {10.1007/s11604-024-01705-1},
