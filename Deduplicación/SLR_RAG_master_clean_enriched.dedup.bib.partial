 volume = {15735 LNAI},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:56:15Z},
 year = {2025}
}

@inproceedings{hoeber_design_2025,
 abstract = {Interactive data visualization tools empower users to explore and analyze data through direct manipulation of visual representations. However, designing effective interactions for these tools remains challenging due to the need to balance expressiveness, usability, and performance. In this paper, we explore the design space of visual programming for interactive data visualization, focusing on how to enable users to create custom visualizations and interactions without writing code. We present a taxonomy of visual programming paradigms and discuss their trade-offs in terms of flexibility, learnability, and scalability. Through a series of design studies and user evaluations, we identify key challenges and opportunities, including the integration of natural language interfaces and machine learning for automated interaction generation. Our findings inform the design of future tools that democratize data visualization creation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
