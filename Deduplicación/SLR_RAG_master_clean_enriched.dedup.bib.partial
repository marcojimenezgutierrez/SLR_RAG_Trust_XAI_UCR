@inproceedings{varshney_ragnet_2025,
 abstract = {This paper proposes a novel approach for enhancing the efficiency of electric vehicle (EV) charging stations through the integration of blockchain technology and smart contracts. The proposed system addresses key challenges such as load balancing, payment security, and energy management in decentralized charging networks. By leveraging blockchain's immutability and transparency, the system ensures secure and tamper-proof transactions between EV users and charging providers. Smart contracts automate the charging process, including reservation, authentication, and billing, reducing latency and human intervention. Simulation results demonstrate a 25% improvement in charging throughput and a 30% reduction in operational costs compared to traditional centralized systems. The approach also incorporates renewable energy integration for sustainable charging, making it suitable for smart city applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
