@article{beauchemin_quebec_2024,
 abstract = {This study investigates the role of artificial intelligence in enhancing cybersecurity measures within financial institutions. Drawing on data from 150 banks across Europe, we employ structural equation modeling to examine how AI-driven anomaly detection impacts fraud prevention and operational efficiency. Results indicate a significant positive correlation between AI adoption and reduced financial losses, with implications for regulatory frameworks and future technological integrations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
