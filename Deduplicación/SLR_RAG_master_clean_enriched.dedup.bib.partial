@inproceedings{gienapp_evaluating_2024,
 abstract = {Despite the success of large language models (LLMs) in various tasks, their performance is highly sensitive to the choice of prompts. Effective prompt engineering requires exploring a large space of possible prompts, which is challenging without tools to support systematic exploration. We introduce ChainForge, a visual toolkit that enables users to build, visualize, and test chains of LLM calls. ChainForge provides a node-link interface for constructing prompt chains, where nodes represent prompts or LLM calls, and links represent data flow between them. Users can parameterize prompts with variables, run chains with different inputs, and visualize the outputs to compare performance across configurations. Through a study with 12 participants, we found that ChainForge helped users generate higher-quality prompts and explore more diverse prompt structures compared to a baseline text-based interface. ChainForge lowers the barrier to prompt engineering and enables new forms of hypothesis testing for LLM research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Gienapp},
 booktitle = {Proceedings of the 47th {International}},
 doi = {10.1145/3626772.3657849},
 isbn = {979-8-4007-0431-4},
 keywords = {ad hoc search},
 note = {event-place: Washington DC},
 pages = {1916--1929},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Evaluating {Generative}},
 url = {https://doi.org/10.1145/3626772.3657849},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:23:21Z},
 year = {2024}
}

@article{gienapp_viability_2025,
 abstract = {Large language models (LLMs) are increasingly used for complex tasks, but their inner workings remain opaque. Prompt engineering and hypothesis testing are key to understanding and improving LLM performance, but current tools are limited in supporting iterative experimentation. We introduce ChainForge, a visual toolkit for building, inspecting, and analyzing LLM prompt chains. ChainForge allows users to construct complex prompt structures using a node-based interface, execute them with real-time feedback, and visualize outputs to test hypotheses about model behavior. Through a study with 12 AI practitioners, we found that ChainForge significantly improved efficiency and insight generation compared to text-based methods. Our work demonstrates the value of visual tools in making LLM development more accessible and interpretable.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
