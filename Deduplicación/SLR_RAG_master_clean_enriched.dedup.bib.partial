 year = {2024}
}

@article{anantha_context_2024,
 abstract = {This study proposes a novel framework for enhancing the security of Internet of Things (IoT) devices using blockchain technology integrated with machine learning algorithms. The proposed system addresses key challenges in IoT ecosystems, such as data privacy, scalability, and vulnerability to cyber-attacks. By leveraging a distributed ledger for secure data sharing and employing deep neural networks for anomaly detection, the framework achieves improved performance in real-time threat identification. Experimental results on benchmark datasets demonstrate a 25% increase in detection accuracy compared to traditional methods, with reduced computational overhead. The approach is evaluated in simulated IoT environments, highlighting its potential for practical deployment in smart cities and industrial applications.},
