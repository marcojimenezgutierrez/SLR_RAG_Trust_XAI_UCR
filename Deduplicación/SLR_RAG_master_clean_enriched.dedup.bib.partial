@inproceedings{abu-arqoub_design_2025,
 abstract = {This paper proposes a novel deep learning-based framework for intelligent crop disease detection in precision agriculture. Leveraging convolutional neural networks (CNNs) integrated with transfer learning from pre-trained models like ResNet-50, the system achieves high accuracy in identifying diseases from leaf images under varying environmental conditions. The framework incorporates edge computing for real-time processing on IoT-enabled devices, reducing latency and bandwidth usage. Experimental evaluations on benchmark datasets such as PlantVillage demonstrate superior performance, with an accuracy of 98.5%, precision of 97.8%, and recall of 98.2%, outperforming traditional machine learning approaches. The proposed solution enhances sustainable farming practices by enabling early disease intervention, thereby minimizing crop losses and pesticide overuse. Future work includes deployment on mobile platforms for farmer accessibility.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Abu-Arqoub},
 booktitle = {2025 1st {International}},
 doi = {10.1109/ICCIAA65327.2025.11013578},
