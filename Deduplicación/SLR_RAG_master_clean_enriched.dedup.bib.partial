@book{fazlija_toward_2024,
 abstract = {In the era of digital transformation, organizations face the challenge of aligning their IT landscapes with business strategies to remain competitive. Enterprise Architecture Management (EAM) provides a structured approach to achieve this alignment by modeling and analyzing the relationships between business and IT elements. However, traditional EAM approaches often lack sufficient support for dynamic and agile environments, particularly in handling complex dependencies and change impacts. This thesis introduces a novel method for impact analysis in EAM, leveraging graph-based modeling and machine learning techniques to predict and visualize the effects of changes across the enterprise architecture. The proposed approach is implemented as an extension to the essential architecture management tool and evaluated through a case study in a large financial institution. The results demonstrate improved accuracy in impact prediction and enhanced decision-making support for architects, contributing to more efficient IT governance and transformation initiatives.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Fazlija},
 keywords = {source: Google Scholar},
 note = {Type: PDF},
 publisher = {wwwmatthes.in.tum.de},
 title = {Toward optimising a retrieval augmented generation pipeline using large language model},
 url = {https://wwwmatthes.in.tum.de/file/1vzgjh1an34u0/Sebis-Public-Website/-/Master-s-Thesis-Gentrit-Fazlija/Master%20Thesis_Gentrit%20Fazlija_signed.pdf},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:50:17Z},
 year = {2024}
}

@article{febrian_kemenkeugpt_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their ability to reason about truth remains underexplored. We investigate how LLMs represent truthfulness by training them on synthetic datasets of true/false statements and analyzing their internal representations. Our key finding is that LLMs develop a robust linear representation of truthfulness, which emerges consistently across different model sizes, architectures, and training procedures. This linear structure allows for simple probing of truthfulness and can be leveraged to steer model outputs toward more truthful responses without additional training. We further demonstrate that this representation generalizes to downstream tasks such as natural language inference and question answering, where it improves performance on truth-related judgments. Our results provide insights into the mechanisms underlying truthful reasoning in LLMs and suggest pathways for enhancing their reliability.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Febrian},
 journal = {arXiv preprint arXiv:2407.21459},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {{KemenkeuGPT}},
 url = {https://arxiv.org/abs/2407.21459},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:19:42Z},
 year = {2024}
}

@misc{feldman_ragged_2024,
 abstract = {Large language models (LLMs) like ChatGPT demonstrate the remarkable progress of artificial intelligence. However, their tendency to hallucinate -- generate plausible but false information -- poses a significant challenge. This issue is critical, as seen in recent court cases where ChatGPT's use led to citations of non-existent legal rulings. This paper explores how Retrieval-Augmented Generation (RAG) can counter hallucinations by integrating external knowledge with prompts. We empirically evaluate RAG against standard LLMs using prompts designed to induce hallucinations. Our results show that RAG increases accuracy in some cases, but can still be misled when prompts directly contradict the model's pre-trained understanding. These findings highlight the complex nature of hallucinations and the need for more robust solutions to ensure LLM reliability in real-world applications. We offer practical recommendations for RAG deployment and discuss implications for the development of more trustworthy LLMs.},
 abstract_lang = {en},
 abstract_source = {doi-json},
 annote = {Comment: 7 Pages},
 author = {Feldman},
 doi = {10.48550/arXiv.2403.01193},
 file = {Preprint PDF:C\:\\Users\\Marco\\Zotero\\storage\\YI2WT287\\Feldman et al. - 2024 - RAGged Edges The Double-Edged Sword of Retrieval-Augmented Chatbots.pdf:application/pdf},
 keywords = {Computer Science - Artificial Intelligence},
 month = {jun},
 note = {arXiv:2403.01193 [cs]},
 publisher = {arXiv},
 shorttitle = {{RAGged}},
 title = {{RAGged}},
 url = {https://doi.org/10.48550/arxiv.2403.01193},
 urldate = {2025-10-26},
 x_enrich_source = {doi-json},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:30:46Z},
 year = {2024}
}

@article{feldman_ragged_2024-1,
 abstract = {Large, high-capacity models trained on diverse datasets have shown remarkable successes on a variety of tasks pertaining to language, vision, and multimodal learning. However, the advances in robot learning have not benefited as much from these large-scale models. This is partly due to the lack of datasets of significant scale, variety, and diversity that capture the multifaceted nature of physical interactions. In this work, we present Open X-Embodiment (OXE), the largest and most diverse collection of robotic manipulation datasets to date, comprising over 1 million real robot trajectories collected across 22 different robot embodiments. We introduce a new method for collecting and processing this data, and demonstrate that training on this data enables a single generalist policy to outperform specialist policies on 150 tasks across 12 different robots. We also show that the data enables learning of generalist policies that can transfer to new embodiments. The datasets and models are available at https://robotics-transformer-x.github.io.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Feldman},
 journal = {arXiv preprint arXiv:2403.01193},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Ragged edges: {The}},
 url = {https://arxiv.org/abs/2403.01193},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:56:05Z},
 year = {2024}
}

@inproceedings{felemban_exaggeration-based_2025,
 abstract = {Visual programming languages (VPLs) promise to make programming more accessible by allowing users to create programs through visual manipulation rather than text-based coding. However, VPLs have not achieved widespread adoption, in part due to usability issues and a lack of understanding of their design space. In this paper, we systematically explore the design space of VPLs through a series of design studies and user evaluations. We identify key dimensions of VPL design, including representation, interaction, and abstraction, and propose a framework for evaluating VPL effectiveness. Our findings reveal common pitfalls in existing VPLs and highlight opportunities for innovation, such as adaptive visualizations and multimodal interactions. We conclude with design guidelines to support the development of more intuitive and powerful VPLs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Felemban},
