 pages = {3659--3669},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{PSCon}},
 url = {https://doi.org/10.1145/3726302.3730278},
 x_enrich_source = {x-ai/grok-4-fast},
