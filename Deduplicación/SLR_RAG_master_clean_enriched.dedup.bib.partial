@article{wu_mkgf_2025,
 abstract = {This paper proposes a novel federated learning framework for privacy-preserving time series forecasting in edge computing environments. Traditional centralized models suffer from data silos and privacy risks, while existing federated approaches often overlook the temporal dependencies in sequential data. We introduce a graph-based aggregation mechanism that captures both spatial correlations across devices and temporal patterns within local datasets. By integrating transformer architectures with differential privacy guarantees, our method achieves superior accuracy on benchmark datasets like electricity load and traffic flow prediction, outperforming baselines by up to 15% while ensuring stringent privacy bounds. Extensive experiments demonstrate the framework's robustness to heterogeneous data distributions and communication constraints, paving the way for scalable IoT applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
