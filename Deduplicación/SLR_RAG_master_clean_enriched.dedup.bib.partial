@inproceedings{kang_tldr_2024,
 abstract = {Fairness in machine learning has become a critical concern, particularly in visual recognition tasks where demographic disparities can lead to biased outcomes. Existing debiasing methods often focus on specific protected attributes like race or gender but struggle with intersectional fairness and real-world deployment. In this paper, we propose a comprehensive framework for mitigating demographic disparities in visual recognition models. Our approach integrates adversarial training with attribute-specific regularization to balance performance across diverse subgroups. We evaluate our method on multiple benchmarks, including facial recognition and object detection datasets, demonstrating significant reductions in bias metrics such as demographic parity and equalized odds, while maintaining overall accuracy. Our findings highlight the importance of intersectional considerations and provide practical strategies for deploying fairer AI systems in sensitive applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Kang},
