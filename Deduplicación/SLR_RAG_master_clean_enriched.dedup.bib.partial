@inproceedings{zhu_collaborative_2025,
 abstract = {Visual Question Answering (VQA) systems have achieved remarkable success in recent years, yet they often suffer from biases inherited from training data, leading to unfair and unreliable predictions. Existing debiasing methods primarily focus on removing dataset biases but overlook model biases, resulting in limited generalization to out-of-distribution data. In this paper, we propose a novel framework, FairVLM, to mitigate biases in vision-language models (VLMs) for VQA tasks. FairVLM integrates a bias detection module and a fairness-aware fine-tuning strategy, which dynamically identifies and penalizes biased predictions during training. Our approach leverages counterfactual reasoning to generate bias-free samples and employs a contrastive loss to align model representations with fairness objectives. Extensive experiments on multiple VQA benchmarks, including VQA-CP and VQA-X, demonstrate that FairVLM significantly reduces bias (up to 25% improvement in worst-group accuracy) while preserving overall performance. Our method also shows strong generalization to unseen bias types, highlighting its robustness in real-world scenarios.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhu},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3696410.3714908},
