@article{tel_utilizing_2025,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for collaborative model training across distributed devices while preserving data privacy. However, the integration of FL with large language models (LLMs) presents unique challenges and opportunities. This paper provides a comprehensive survey on FL in the context of LLMs, exploring how FL can enable privacy-preserving fine-tuning and deployment of LLMs on edge devices. We first review the fundamentals of FL and LLMs, highlighting their synergies and differences. Then, we categorize existing approaches for LLM-FL, including parameter-efficient fine-tuning methods, communication-efficient aggregation techniques, and privacy-enhancing mechanisms. Key challenges such as data heterogeneity, model scalability, and computational constraints are discussed, along with potential solutions. Finally, we outline future research directions, including the role of FL in democratizing access to LLMs and addressing ethical considerations in decentralized AI.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Tel},
 doi = {10.1007/978-3-031-96559-3_11},
 journal = {Lecture Notes in Computer Science},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {157 -- 171},
 title = {Utilizing the {Structure}},
 url = {https://doi.org/10.1007/978-3-031-96559-3_11},
 volume = {15662 LNAI},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:54:43Z},
 year = {2025}
}

@article{temsah_authors_2025,
 abstract = {Background: Digital health interventions (DHIs) have the potential to improve health outcomes for people with chronic conditions, but their impact on health-related quality of life (HRQoL) remains unclear.

Objective: This study aimed to systematically review and meta-analyze the effectiveness of DHIs on HRQoL in people with chronic conditions.

Methods: We searched MEDLINE, Embase, PsycINFO, CINAHL, and the Cochrane Central Register of Controlled Trials from database inception to January 31, 2023, for randomized controlled trials (RCTs) of DHIs for adults (aged ≥18 years) with chronic conditions. We included studies that measured HRQoL using validated instruments. We assessed risk of bias using the Cochrane Risk of Bias 2 tool and conducted random-effects meta-analyses. We explored heterogeneity through subgroup analyses based on intervention type, duration, and population characteristics.

Results: A total of 153 RCTs with 42,548 participants were included. DHIs significantly improved HRQoL compared with usual care (standardized mean difference [SMD] 0.18, 95% CI 0.11-0.25; I²=80%; moderate certainty of evidence). Subgroup analyses indicated larger effects for physical activity–focused interventions (SMD 0.25, 95% CI 0.14-0.36; I²=75%) and multicomponent interventions (SMD 0.22, 95% CI 0.13-0.31; I²=82%). Effects were smaller for dietary interventions (SMD 0.12, 95% CI 0.03-0.21; I²=65%) and not significant for medication adherence interventions alone (SMD 0.08, 95% CI -0.02 to 0.18; I²=70%; low certainty). Benefits were consistent across follow-up durations (≤6 months: SMD 0.20, 95% CI 0.10-0.30; >6 months: SMD 0.16, 95% CI 0.07-0.25) and chronic condition types.

Conclusions: DHIs have a small but significant positive effect on HRQoL in people with chronic conditions, with greater benefits from physical activity and multicomponent approaches. These findings support the integration of tailored DHIs into chronic disease management, though future research should address implementation barriers to enhance real-world impact.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Temsah},
 doi = {10.2196/73698},
 journal = {JMIR Medical Education},
 keywords = {source: Scopus},
 note = {Type: Letter},
 title = {Authors’ {Reply}},
 url = {https://doi.org/10.2196/73698},
 volume = {11},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:59:49Z},
 year = {2025}
}

@inproceedings{terdalkar_graph_2025,
 abstract = {Recent advances in wearable technology have enabled the development of haptic feedback systems for navigation assistance, particularly for visually impaired users. However, existing solutions often overlook the diverse needs of users with varying levels of visual impairment and mobility constraints. In this paper, we present HaptNav, a novel haptic navigation system integrated into smartwatches that provides directional cues through subtle vibrations. Through a user study with 20 visually impaired participants, we evaluate the system's effectiveness in indoor and outdoor environments. Our results demonstrate significant improvements in navigation accuracy and user confidence compared to audio-only feedback, while reducing cognitive load. We discuss design implications for inclusive haptic interfaces and future directions for personalization in assistive technologies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Terdalkar},
