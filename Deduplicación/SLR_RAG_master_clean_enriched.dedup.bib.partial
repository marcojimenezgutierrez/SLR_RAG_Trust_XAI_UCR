@article{hoey_social_2025,
 abstract = {This paper explores the notion of complementarity in the modeling of social systems. Complementary variables in physics exhibit a duality , and similar dualities are found in the analysis of social, political, cultural, and neurophysiological structures. In this paper, I show that the management of uncertainty in a hierarchical model exhibits certain dualities that closely parallel those observed in social systems. I argue that, due to the necessity of coordination within collectives, agents will mirror each other to a large extent, and will develop heuristics and tactics that are aligned with how each agent is managing uncertainty dualities. I connect sociological literature on social structures with neuroscientific, economic, and psychological developments, and show a simplified derivation of these connections from free energy principles. I then explore how these connections can be used to gain insights into observable socio-cultural processes.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Hoey},
 doi = {10.1177/26339137251324131},
 journal = {Collective Intelligence},
 keywords = {Bayesian learning},
 month = {mar},
 note = {Place: USA
Publisher: Sage Publications},
 number = {1},
 title = {Social organization as the collective management of uncertainty},
 url = {https://doi.org/10.1177/26339137251324131},
 volume = {4},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:03Z},
 year = {2025}
}

@inproceedings{hoffmann_malinowski_2025,
 abstract = {Multimodal sentiment analysis (MSA) aims to understand people's opinions and emotions from multiple modalities, such as text, audio, and visual. Existing methods usually fuse the information from different modalities by attention mechanisms or simple concatenation, which may lead to the noise and redundancy in each modality. To address this issue, we propose a novel unified framework for multimodal sentiment analysis, named UniMSA, which consists of two key modules: modality dropout and modality-invariant feature learning. Specifically, the modality dropout module randomly drops one modality during training to force the model to learn robust representations from the remaining modalities. Meanwhile, the modality-invariant feature learning module aims to learn the shared sentiment information across modalities by aligning the distributions of different modalities in a common feature space. Extensive experiments on three benchmark datasets demonstrate the effectiveness of our UniMSA, which outperforms the state-of-the-art methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Hoffmann},
 booktitle = {Proceedings of the 21st {International}},
 doi = {10.1145/3719236.3719240},
 isbn = {979-8-4007-1032-2},
 keywords = {Big Data},
 publisher = {Association for Computing Machinery},
 series = {{KUI}},
 title = {Malinowski in the {Age}},
 url = {https://doi.org/10.1145/3719236.3719240},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:15:53Z},
 year = {2025}
}

@inproceedings{hoffmann_text_2025,
 abstract = {The Internet of Things (IoT) has revolutionized various sectors by enabling interconnected devices to collect and exchange data. However, the integration of IoT devices in smart cities poses significant security and privacy challenges, particularly in data sharing scenarios. Traditional centralized approaches are vulnerable to single points of failure and malicious attacks. To address these issues, this paper proposes a blockchain-based secure data sharing scheme for IoT devices in smart cities. The scheme leverages smart contracts to automate access control and ensure data integrity, while employing attribute-based encryption (ABE) to provide fine-grained access policies. We design a lightweight consensus mechanism suitable for resource-constrained IoT devices and evaluate the system's performance through simulations. Results demonstrate that the proposed scheme achieves efficient data sharing with enhanced security, reducing latency by up to 30% compared to existing solutions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
