 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:28:05Z},
 year = {2025}
}

@inproceedings{kim_re-rag_2024,
 abstract = {This paper introduces a novel framework for generating faithful abstractive summaries of open-domain videos. Unlike traditional video summarization methods that rely on extractive techniques or closed-domain assumptions, our approach leverages large language models (LLMs) fine-tuned on diverse video-text pairs to produce coherent, abstractive narratives that preserve key events and semantic content. We address challenges such as temporal alignment, visual grounding, and hallucination mitigation through a multi-stage pipeline involving video segmentation, multimodal feature extraction, and reinforcement learning from human feedback. Experiments on benchmarks like TVSum, SumMe, and ActivityNet demonstrate that our model outperforms state-of-the-art baselines in terms of ROUGE scores, semantic similarity, and human evaluation for faithfulness and fluency. Our work paves the way for more accessible and interpretable video understanding in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Kim},
