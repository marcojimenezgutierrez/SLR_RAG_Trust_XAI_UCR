@article{zhu_emerge_2024-1,
 abstract = {Electronic Health Records (EHRs) contain rich multimodal information, including time-series data, clinical notes, and medical images, which are crucial for predictive modeling in healthcare. However, integrating these diverse data modalities effectively remains challenging due to data heterogeneity, missing values, and the need for scalable architectures. In this paper, we propose EMERGE, a novel framework that integrates Retrieval-Augmented Generation (RAG) to enhance multimodal EHR predictive modeling. EMERGE leverages a retriever to fetch relevant historical patient data and a generator to produce augmented multimodal representations, enabling more accurate and interpretable predictions. We evaluate EMERGE on the MIMIC-III dataset for tasks such as in-hospital mortality prediction and length-of-stay forecasting. Our results demonstrate that EMERGE outperforms state-of-the-art baselines, achieving up to 15% improvement in AUROC for mortality prediction while maintaining efficiency. This work highlights the potential of RAG in bridging gaps in multimodal EHR analysis, paving the way for more robust clinical decision support systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
