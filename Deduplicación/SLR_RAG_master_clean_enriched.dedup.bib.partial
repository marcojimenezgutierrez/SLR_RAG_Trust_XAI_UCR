@inproceedings{xu_aligning_2025,
 abstract = {Software engineering education faces challenges in teaching complex concepts like design patterns effectively. This paper introduces PatternQuest, an interactive gamified platform designed to enhance students' understanding and application of design patterns through immersive, scenario-based challenges. We conducted a controlled experiment with 120 undergraduate students, comparing PatternQuest to traditional lecture-based instruction. Results show that students using PatternQuest achieved 25% higher scores on pattern identification and implementation tasks, with improved retention over a 3-month period. Qualitative feedback highlights increased engagement and motivation. Our findings suggest that gamification can transform software engineering pedagogy, offering a scalable solution for educators.},
 abstract_lang = {en},
