 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:11:46Z},
 year = {2024}
}

@inproceedings{wei_unleashing_2025,
 abstract = {In this paper, we investigate the impact of large language models (LLMs) on network traffic patterns, particularly focusing on the bursty nature of inference requests. As LLMs become integral to various applications, understanding their traffic characteristics is crucial for network resource management and QoS provisioning. We conduct a comprehensive analysis using real-world traces from popular LLM services, revealing that LLM traffic exhibits high variability in request sizes and inter-arrival times, leading to significant bursts. To mitigate these challenges, we propose a lightweight traffic shaping mechanism that leverages predictive prefetching based on user behavior patterns. Our evaluation demonstrates that this approach reduces peak loads by up to 40% while maintaining low latency, offering a practical solution for network operators deploying LLM-based services.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Wei},
 booktitle = {2025 {IEEE}},
 doi = {10.1109/IWQoS65803.2025.11143461},
 keywords = {Codes},
 month = {jul},
 note = {ISSN: 2766-8568},
 pages = {1--10},
 title = {Unleashing the {Power}},
