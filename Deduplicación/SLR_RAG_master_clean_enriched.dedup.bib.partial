@article{olawore_development_2024,
 abstract = {Multimodal learning aims to leverage information from multiple modalities to improve the performance of machine learning models. In this paper, we provide a comprehensive survey of deep learning methods for multimodal data fusion. We categorize the existing approaches into early, late, and hybrid fusion strategies, and discuss their applications in various domains such as healthcare, autonomous driving, and natural language processing. We also highlight the challenges in multimodal fusion, including data alignment, missing modalities, and interpretability, and outline promising future research directions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
