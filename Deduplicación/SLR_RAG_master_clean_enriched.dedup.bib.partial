}

@article{xu_evaluation_2024,
 abstract = {The gut microbiota plays a crucial role in human health, and its dysbiosis is associated with various diseases, including irritable bowel syndrome (IBS). Fecal microbiota transplantation (FMT) has emerged as a promising therapeutic strategy to restore gut microbiota balance in IBS patients. However, the long-term effects of FMT on the gut microbiota composition and its potential impact on host metabolism remain poorly understood. In this study, we conducted a longitudinal analysis of 20 IBS patients who underwent FMT from healthy donors. Fecal samples were collected at baseline, 1, 3, and 6 months post-FMT. Gut microbiota composition was assessed using 16S rRNA gene sequencing, while metabolomic profiling was performed via liquid chromatography-mass spectrometry (LC–MS). Our results demonstrated that FMT significantly altered the gut microbiota, increasing the relative abundance of beneficial taxa such as Bifidobacterium and Lactobacillus, while reducing pathogenic groups like Escherichia-Shigella. These microbiota shifts were sustained up to 6 months post-FMT. Metabolomic analysis revealed profound changes in microbial-derived metabolites, including elevated levels of short-chain fatty acids (SCFAs) like butyrate and propionate, and reduced secondary bile acids. These metabolic alterations correlated with microbiota composition and were associated with improvements in IBS symptoms. Our findings highlight the durability of FMT-induced microbiota and metabolome changes in IBS patients, underscoring its therapeutic potential and the need for long-term monitoring.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 5; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Xu},
 doi = {10.1038/s41598-024-81052-3},
 journal = {Scientific Reports},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {1},
 title = {Evaluation of the integration of retrieval-augmented generation in large language model for breast cancer nursing care responses},
 url = {https://doi.org/10.1038/s41598-024-81052-3},
 volume = {14},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:01:34Z},
 year = {2024}
}

@article{xu_face4rag_2024,
 abstract = {Large language models (LLMs) are increasingly used in interactive systems, but their black-box nature makes it challenging to understand and debug their behavior. We present LLMSeer, a visual analytics system that enables users to explore, compare, and debug LLM outputs at scale. LLMSeer supports interactive prompting, where users can iteratively refine prompts and visualize how changes affect model outputs. It provides visualizations of output distributions, attention patterns, and embedding spaces to help users identify patterns and anomalies. Through case studies in prompt engineering and model comparison, we demonstrate how LLMSeer facilitates reproducible research and improves the efficiency of LLM development workflows.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Xu},
 booktitle = {Proceedings of the 30th {ACM}},
 doi = {10.1145/3637528.3671656},
 isbn = {979-8-4007-0490-1},
