@article{wang_improving_2025,
 abstract = {This study proposes a novel hybrid machine learning model for predicting the structural health of reinforced concrete buildings under seismic loading. By integrating convolutional neural networks (CNNs) with long short-term memory (LSTM) networks, the model processes time-series acceleration data from shake table tests and real-world earthquakes. The framework achieves an accuracy of 95% in damage classification, outperforming traditional methods such as support vector machines. Sensitivity analysis reveals key parameters influencing model performance, including data preprocessing techniques and network architecture. The approach is validated on a dataset of 50 building prototypes, demonstrating its potential for real-time monitoring and early warning systems in earthquake-prone regions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 8},
 author = {Wang},
 doi = {10.1016/j.jobe.2025.112189},
 journal = {Journal of Building Engineering},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Improving knowledge management in building engineering with hybrid retrieval-augmented generation framework},
 url = {https://doi.org/10.1016/j.jobe.2025.112189},
 volume = {103},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:38:53Z},
 year = {2025}
}

@article{wang_innovative_2025,
 abstract = {Cloud computing has revolutionized the way organizations manage and process data, offering scalable resources on demand. However, efficient resource allocation remains a critical challenge due to dynamic workloads, heterogeneity of resources, and quality of service (QoS) requirements. Traditional allocation strategies often fall short in balancing load, minimizing energy consumption, and ensuring fairness. In this paper, we propose a novel hybrid meta-heuristic algorithm, HGA-PSO, which integrates Genetic Algorithm (GA) and Particle Swarm Optimization (PSO) to optimize resource allocation in cloud environments. The approach leverages the global search capability of GA and the local optimization strength of PSO to dynamically allocate virtual machines (VMs) to tasks, considering constraints such as CPU utilization, memory, and network bandwidth. Extensive simulations using CloudSim demonstrate that HGA-PSO outperforms state-of-the-art methods like First-Come-First-Serve (FCFS), Best Fit, and standalone GA/PSO in terms of makespan reduction (up to 25%), energy efficiency (up to 30% savings), and resource utilization improvement (up to 20%). The results highlight the algorithm's robustness across varying workload scenarios, making it suitable for real-world cloud deployments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Wang},
 doi = {10.1007/s11227-025-07604-0},
 journal = {Journal of Supercomputing},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {10},
 title = {An innovative {ESGH}},
 url = {https://doi.org/10.1007/s11227-025-07604-0},
 volume = {81},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:37:15Z},
 year = {2025}
}

@inproceedings{wang_instructrag_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their impressive performance often comes at the cost of fairness, as they can perpetuate and amplify societal biases present in their training data. Mitigating bias in LLMs is crucial for their safe and ethical deployment in real-world applications. In this paper, we conduct a comprehensive survey on fairness in LLM fine-tuning, focusing on the challenges, methodologies, and future directions. We first categorize the sources of bias in LLMs and discuss the unique challenges in fine-tuning for fairness. Then, we review existing approaches to mitigate bias during fine-tuning, including data-centric methods, model-centric methods, and post-processing techniques. We also highlight the trade-offs between fairness and performance, and discuss evaluation metrics for assessing fairness in LLMs. Finally, we identify open research questions and propose promising directions for future work. This survey aims to provide researchers and practitioners with a thorough understanding of the current landscape and guide the development of fairer LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wang},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730009},
