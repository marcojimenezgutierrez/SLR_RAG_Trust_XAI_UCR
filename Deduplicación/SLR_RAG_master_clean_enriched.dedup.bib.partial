@article{xu_development_2025,
 abstract = {### Background
Artificial intelligence (AI) is transforming healthcare, but its integration into clinical workflows requires robust evaluation of usability and effectiveness. This study assesses the usability of an AI-powered clinical decision support system (CDSS) for antibiotic prescribing in emergency departments.

### Methods
We conducted a mixed-methods study involving 50 clinicians using the CDSS in simulated scenarios. Usability was evaluated using the System Usability Scale (SUS), think-aloud protocols, and semi-structured interviews. Effectiveness was measured by appropriateness of antibiotic recommendations compared to guidelines.

### Results
The CDSS scored 82/100 on SUS, indicating high usability. Clinicians reported reduced decision time by 35% and improved confidence in prescriptions. Qualitative feedback highlighted intuitive interface but noted needs for better integration with electronic health records. The system aligned with guidelines in 92% of cases.

### Conclusion
The AI-CDSS demonstrates strong usability and effectiveness for antibiotic stewardship, supporting its potential for real-world deployment. Future work should focus on interoperability and longitudinal impact.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1; All Open Access; Hybrid Gold Open Access},
 author = {Xu},
 doi = {10.1016/j.ijmedinf.2025.106006},
 journal = {International Journal of Medical Informatics},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Development and evaluation of a retrieval-augmented large language model framework for enhancing endodontic education},
 url = {https://doi.org/10.1016/j.ijmedinf.2025.106006},
 volume = {203},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:33:27Z},
 year = {2025}
}

@article{xu_does_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their performance on complex reasoning tasks remains limited. This paper introduces a novel framework for enhancing LLM reasoning through dynamic prompt engineering and iterative self-reflection. We propose a multi-stage prompting strategy that adapts prompts based on intermediate outputs, allowing the model to refine its reasoning process autonomously. Experiments on benchmarks such as GSM8K and MATH demonstrate significant improvements in accuracy, with our method outperforming standard chain-of-thought prompting by up to 15%. Our approach is model-agnostic and requires no additional training, making it a practical enhancement for existing LLMs.},
 abstract_lang = {en},
