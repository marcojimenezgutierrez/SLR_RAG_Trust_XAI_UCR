@inproceedings{wang_exploiting_2025,
 abstract = {Haptic feedback is a promising modality for enhancing user experiences in virtual and augmented reality (VR/AR) applications. However, current haptic devices often struggle with providing rich, multi-modal feedback that matches the complexity of real-world interactions. This paper introduces HapticsNet, a novel framework for generating dynamic, personalized haptic patterns using deep learning. By leveraging a dataset of over 10,000 real-world tactile interactions, our model learns to map visual and auditory cues to corresponding haptic signals, enabling seamless integration into VR/AR environments. We evaluate HapticsNet through user studies (N=48) demonstrating significant improvements in immersion and task performance compared to baseline methods. Our contributions include the open-source implementation and guidelines for deploying adaptive haptics in consumer devices.},
 abstract_lang = {en},
