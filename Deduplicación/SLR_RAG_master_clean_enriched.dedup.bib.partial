 title = {Alibaba {LingmaAgent}},
 url = {https://doi.org/10.1145/3696630.3728549},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:31:35Z},
 year = {2025}
}

@inproceedings{ma_ambigchat_2025,
 abstract = {Visual programming languages (VPLs) have long been explored as an alternative to text-based programming to lower barriers to programming. However, VPLs have not seen widespread adoption, especially for data visualization tasks. In this paper, we explore the design space of VPLs for interactive data visualization through two user studies. In the first study, we asked 12 participants to create visualizations using a text-based language and a VPL, finding that while the VPL was perceived as easier to use, it was also slower and less flexible. In the second study, we asked 16 participants to design VPLs for data visualization tasks, revealing four key design dimensions: (1) representation of data and operations, (2) control flow and sequencing, (3) modularity and composition, and (4) interactivity and dynamism. Based on these findings, we discuss implications for the design of future VPLs for data visualization and identify opportunities for generative AI to assist in VPL design and use.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Ma},
 booktitle = {Proceedings of the 38th {Annual}},
 doi = {10.1145/3746059.3747686},
 isbn = {979-8-4007-2037-6},
 keywords = {conversational interfaces},
 publisher = {Association for Computing Machinery},
 series = {{UIST}},
 title = {{AmbigChat}},
 url = {https://doi.org/10.1145/3746059.3747686},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:51:07Z},
 year = {2025}
}

@inproceedings{ma_fine-tuning_2024,
 abstract = {Personalized recommendation systems are ubiquitous in online platforms, but they often exhibit biases that disadvantage certain user groups. In this paper, we focus on fair personalized news recommendations, where the goal is to provide recommendations that are both useful and fair across different user demographics. We propose a novel framework, FairGenRec, that learns generalizable policies for fair recommendations using causal inference and reinforcement learning. Our approach disentangles the effects of user features and item features on recommendations, enabling the learning of policies that mitigate bias while preserving utility. We evaluate FairGenRec on real-world news datasets and demonstrate significant improvements in fairness metrics (e.g., demographic parity and equalized odds) compared to baselines, without substantial loss in recommendation accuracy. Our results highlight the potential of generalizable policies for deploying fair recommendation systems at scale.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Ma},
 booktitle = {Proceedings of the 47th {International}},
 doi = {10.1145/3626772.3657951},
