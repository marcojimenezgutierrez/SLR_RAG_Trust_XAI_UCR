@inproceedings{lin_athena_2025,
 abstract = {This paper proposes a novel federated learning framework for privacy-preserving anomaly detection in industrial IoT networks. Traditional centralized approaches suffer from data privacy risks and single-point failures, while federated learning enables collaborative model training without sharing raw data. We introduce a differential privacy mechanism integrated with secure multi-party computation to enhance security against inference attacks. Extensive simulations on real-world datasets demonstrate that our framework achieves 15% higher detection accuracy compared to baseline methods, with minimal communication overhead. The results highlight its potential for scalable deployment in edge computing environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
