@article{matys_aggtruth_2025,
 abstract = {Explainable Artificial Intelligence (XAI) aims to make the decisions of machine learning models more understandable to humans. Despite the growing number of XAI methods, there is a lack of standardized evaluation metrics to assess their quality. In this paper, we propose a novel framework for evaluating XAI methods based on three key dimensions: faithfulness, plausibility, and robustness. We apply this framework to several state-of-the-art XAI methods on image classification tasks and provide insights into their strengths and weaknesses. Our results highlight the need for more comprehensive evaluation strategies in XAI research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
