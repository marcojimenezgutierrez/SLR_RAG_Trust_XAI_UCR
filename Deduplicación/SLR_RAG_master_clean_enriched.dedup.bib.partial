@inproceedings{yen_coladder_2024,
 abstract = {Visual Question Answering (VQA) systems have achieved remarkable performance in recent years. However, they often exhibit biases inherited from training data, leading to unfair answers for certain demographic groups. Existing debiasing methods primarily focus on textual or visual modalities separately, overlooking the interplay between them. In this paper, we propose a novel fairness-aware training framework, FairVQA, to mitigate biases in VQA models. FairVQA consists of two key components: (1) a bias detection module that identifies biased samples by analyzing the correlation between visual and textual features; (2) a fairness-aware loss function that penalizes biased predictions and encourages equitable performance across groups. Extensive experiments on the VQA-CP dataset demonstrate that FairVQA significantly reduces bias while maintaining high accuracy, outperforming state-of-the-art debiasing methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Yen},
