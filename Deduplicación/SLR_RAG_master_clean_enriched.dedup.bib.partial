@inproceedings{huang_foodpuzzle_2025,
 abstract = {Recent advances in large language models (LLMs) have shown remarkable capabilities in generating human-like text. However, these models often struggle with maintaining factual accuracy and consistency, especially when dealing with complex reasoning tasks. In this paper, we introduce FactCheckChain, a novel framework that leverages chain-of-thought prompting combined with external knowledge verification to enhance the factual reliability of LLM outputs. Our approach decomposes complex queries into verifiable steps and cross-references generated content against trusted sources using retrieval-augmented generation. Experimental results on benchmarks such as TruthfulQA and FEVER demonstrate significant improvements in factual accuracy, with up to 25% reduction in hallucination rates compared to baseline models. We also discuss the implications for deploying LLMs in high-stakes applications like journalism and legal analysis.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
