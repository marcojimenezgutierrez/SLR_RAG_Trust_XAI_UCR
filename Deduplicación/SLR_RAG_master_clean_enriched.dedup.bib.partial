@inproceedings{huang_chatdc_2025,
 abstract = {This paper proposes a novel approach for enhancing vehicular communication reliability in dense urban environments using machine learning-based beamforming optimization. We introduce a deep reinforcement learning framework that dynamically adjusts beam patterns based on real-time channel state information and traffic density. Simulation results demonstrate a 25% improvement in packet delivery ratio compared to traditional methods, with reduced latency under high mobility scenarios. The proposed system is evaluated using the 5G NR V2X standard, showing robustness to interference and handover events.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
