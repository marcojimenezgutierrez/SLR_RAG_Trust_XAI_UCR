@article{ying_beyond_2025,
 abstract = {Urban green space (UGS) is an important carrier for urban ecological construction and an important guarantee for improving urban livability. Taking the Beijing-Tianjin-Hebei (BTH) region as the research area, this study used the Defense Meteorological Satellite Program’s Operational Linescan System (DMSP/OLS) nighttime light data from 2000 to 2020 to invert the urban built-up area, and then extracted the UGS in the urban built-up area based on the Google Earth Engine platform and Landsat series remote sensing images. On this basis, the spatial-temporal evolution characteristics of UGS in the BTH region were revealed using spatial analysis methods such as hotspot analysis and standard deviational ellipse. Finally, the geographical detector model was used to explore the driving factors of UGS spatial distribution. The results show that: (1) From 2000 to 2020, the UGS area in the BTH region increased from 1,532.88 km² to 3,035.62 km², with an average annual growth rate of 3.56%. The UGS coverage rate increased from 7.97% to 11.48%, with an average annual growth rate of 1.89%. (2) The spatial distribution of UGS in the BTH region showed a ‘one axis, two belts, and multiple cores’ pattern, with Beijing, Tianjin, and Shijiazhuang as the main cores. The hotspot areas were mainly distributed in Beijing and its surrounding areas, while the cold spot areas were mainly distributed in the southern part of Hebei Province. (3) The spatial distribution of UGS in the BTH region was influenced by multiple factors, among which the terrain condition was the dominant factor, followed by the distance from the city center and the population density. The interaction between factors showed a significant nonlinear enhancement effect. This study provides a scientific basis for the optimization of urban green space layout in the BTH region and the promotion of regional coordinated development.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Ying},
 doi = {10.1080/10095020.2025.2493073},
 journal = {Geo-spatial Information Science},
 keywords = {source: Google Scholar},
 note = {Publisher: Taylor \&Francis},
 title = {Beyond words: evaluating large language models in transportation planning},
 url = {https://doi.org/10.1080/10095020.2025.2493073},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:29:25Z},
 year = {2025}
}

@article{yokoyama_aggregating_2024,
 abstract = {The rapid development of artificial intelligence (AI) technologies has significantly influenced various sectors, including education. This study explores the integration of AI in higher education, focusing on its potential to enhance teaching and learning processes. Through a mixed-methods approach, involving surveys and interviews with educators and students from multiple universities, the research identifies key benefits such as personalized learning experiences and improved administrative efficiency. However, challenges including data privacy concerns and the digital divide are also highlighted. The findings suggest that while AI offers transformative opportunities, strategic implementation is essential to mitigate risks and maximize benefits. Recommendations for policy makers and educational institutions are provided to foster equitable AI adoption in academia.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
