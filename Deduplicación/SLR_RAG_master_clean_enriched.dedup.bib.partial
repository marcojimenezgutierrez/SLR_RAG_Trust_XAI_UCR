 year = {2024}
}

@inproceedings{zhu_enhancing_2024-1,
 abstract = {Abstract—With the rapid proliferation of Internet of Things (IoT) devices, ensuring robust security in IoT networks has become paramount. Traditional security mechanisms often fall short in addressing the dynamic and distributed nature of IoT environments. This paper introduces a novel hybrid framework that integrates blockchain technology with machine learning (ML) algorithms to enhance security in IoT networks. The proposed approach leverages blockchain for decentralized authentication and data integrity, while ML models are employed for anomaly detection and predictive threat analysis. We present a detailed architecture, including smart contracts for access control and a federated learning mechanism to train ML models without compromising data privacy. Experimental evaluations on a simulated IoT network demonstrate that our framework achieves a 25% improvement in detection accuracy and reduces latency by 18% compared to existing methods. The results underscore the efficacy of combining blockchain and ML for securing resource-constrained IoT ecosystems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Zhu},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/ICPADS63350.2024.00042},
