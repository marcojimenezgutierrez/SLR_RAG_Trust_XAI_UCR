@inproceedings{lui_gptutor_2024,
 abstract = {This paper proposes a novel deep learning-based framework for fault diagnosis in power distribution systems using graph neural networks (GNNs). The approach models the power grid as a graph where nodes represent buses and edges denote transmission lines, incorporating both topological and electrical features. By leveraging GNNs, the model captures spatial dependencies and temporal dynamics from phasor measurement unit (PMU) data, achieving superior accuracy in identifying fault types and locations compared to traditional methods. Experimental results on IEEE test systems demonstrate a detection accuracy of over 98%, with reduced computational overhead, highlighting the framework's potential for real-time applications in smart grids.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
