@inproceedings{cima_contextualized_2025,
 abstract = {We propose a novel framework for dense visual SLAM that leverages neural radiance fields to achieve high-fidelity, real-time dense reconstruction and tracking. Our method, Neural Dense SLAM (NeDSLAM), represents scenes as neural implicit functions conditioned on pose estimates, enabling efficient optimization of both geometry and appearance. By integrating a learned feature encoder and a differentiable rendering pipeline, NeDSLAM achieves superior performance in challenging environments with textureless regions and dynamic objects. Extensive experiments on benchmark datasets demonstrate that NeDSLAM outperforms state-of-the-art methods in accuracy and efficiency, paving the way for practical AR/VR applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Cima},
 booktitle = {Proceedings of the {ACM}},
