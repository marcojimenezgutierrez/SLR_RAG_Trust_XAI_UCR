 series = {{WWW}},
 title = {{OSPC}},
 url = {https://doi.org/10.1145/3589335.3665994},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:17:01Z},
 year = {2024}
}

@inproceedings{zhu_power_2025,
 abstract = {Large language models (LLMs) are increasingly used for generating code, but their outputs often require iterative refinement through prompt engineering. Existing tools for prompt engineering are either too simplistic or overly complex, lacking support for systematic exploration and hypothesis testing. We introduce ChainForge, a visual programming environment that enables users to iteratively craft, run, and refactor prompt chains—sequences of prompts that build on each other's outputs. ChainForge's node-link interface allows users to visually compose prompt chains, parameterize prompts with variables, and branch chains for comparative evaluation. It supports hypothesis testing by enabling users to systematically vary prompts and inputs, visualize LLM outputs in context, and aggregate results for analysis. Through a formative study with 12 LLM users, we identify needs for visual prompt engineering tools and refine ChainForge's design. A second study with 16 participants demonstrates that ChainForge helps users explore the prompt design space more effectively than a baseline text-based tool, leading to higher-quality prompt chains and greater confidence in their designs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhu},
 booktitle = {Proceedings of the 2025 {International}},
 doi = {10.1145/3733054.3733082},
