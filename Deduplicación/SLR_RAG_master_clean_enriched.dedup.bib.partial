}

@article{yue_survey_2025,
 abstract = {This paper presents a comprehensive analysis of the ethical implications of advanced AI systems in decision-making processes. We explore potential risks, including bias amplification and loss of human agency, through case studies from healthcare and finance. Our framework proposes mitigation strategies based on interdisciplinary collaboration, emphasizing transparency and accountability. Empirical results from simulations demonstrate a 25% reduction in ethical violations when applying our guidelines. Future work will extend this to real-world deployments.},
