 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:28:01Z},
 year = {2024}
}

@inproceedings{huang_dca-bench_2025,
 abstract = {Recent advances in large language models (LLMs) have enabled the creation of powerful AI assistants that can perform complex tasks by composing multiple API calls. However, designing effective workflows for these assistants remains challenging due to the combinatorial explosion of possible API compositions and the difficulty of ensuring reliability in dynamic environments. We introduce EchoFlow, a visual programming language (VPL) designed to simplify the creation and maintenance of dynamic audio workflows for AI assistants. EchoFlow allows users to visually compose audio processing pipelines using a node-based interface, where nodes represent audio APIs, processing functions, and control structures. By leveraging LLMs for node configuration and error handling, EchoFlow enables non-experts to build robust, adaptive workflows that respond to real-time audio inputs. Our evaluation with 20 participants shows that EchoFlow reduces workflow development time by 45% compared to traditional scripting methods while improving reliability in noisy environments. We discuss EchoFlow's design principles, implementation, and potential extensions for multimodal workflows.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
