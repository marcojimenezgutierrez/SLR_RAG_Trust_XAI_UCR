 year = {2024}
}

@article{thulke_task-oriented_2023,
 abstract = {Self-supervised learning (SSL) has achieved remarkable success in many domains, including speech processing. In this paper, we provide a comprehensive survey of SSL methods for speech and audio processing. We first introduce the general framework of SSL and discuss its advantages over supervised learning. Then, we categorize existing SSL approaches for speech into predictive, contrastive, and generative methods, and review representative works in each category. We also discuss the applications of SSL representations in various downstream tasks, such as automatic speech recognition, speaker verification, emotion recognition, and speech enhancement. Finally, we highlight the challenges and future directions for SSL in speech processing.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Thulke},
