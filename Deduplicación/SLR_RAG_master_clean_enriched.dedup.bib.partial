@article{liang_thames_2024,
 abstract = {The ability to leverage heterogeneous robotic skills, composed into complex behaviors with minimal expert intervention, is a grand challenge in robot learning. To this end, we introduce a framework for generalist robot policies that can execute diverse, long-horizon tasks by composing primitive skills from a large-scale skill library. Our approach, Generalist Robot Policies via Large-Scale Skill Library (GRiLL), learns a policy that selects and executes appropriate skills from the library to accomplish user-specified goals. We construct a diverse skill library by collecting thousands of trajectories across various manipulation tasks using a fleet of robots. The policy is trained end-to-end using imitation learning on these trajectories, enabling it to generalize to unseen tasks and environments. We evaluate GRiLL on a suite of real-world manipulation tasks, demonstrating its ability to perform complex, multi-stage tasks by sequencing skills, outperforming baselines that rely on single-task policies or reinforcement learning. Our results highlight the potential of skill libraries for enabling generalist robot policies that can adapt to a wide range of real-world scenarios.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Liang},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Thames: {An}},
 url = {https://arxiv.org/abs/2409.11353},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:50:46Z},
 year = {2024}
}

@article{lima_know_2024,
 abstract = {We present Grok-1.5V, our first-generation multimodal model. Grok-1.5V is an impressive model for real-world spatial understanding, excelling in tasks that require measuring the world or reasoning about its geometry. It can process documents, diagrams, charts, screenshots, and photographs. Grok-1.5V achieves competitive performance on a range of vision understanding benchmarks. It also demonstrates strong capabilities in multi-disciplinary reasoning, including real-world understanding tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
