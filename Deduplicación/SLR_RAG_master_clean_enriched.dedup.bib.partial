@inproceedings{bradland_new_2025,
 abstract = {Visual Question Answering (VQA) has achieved remarkable success in recent years, but the presence of biases in datasets and models has raised significant concerns about fairness. Existing debiasing methods primarily focus on linguistic or vision-language biases, often overlooking the inherent social biases embedded in the training data. In this paper, we introduce FairVQA, a novel framework designed to mitigate social biases in VQA models. FairVQA consists of two key components: (1) a bias identification module that detects and quantifies social biases in VQA datasets using counterfactual reasoning, and (2) a debiasing training strategy that incorporates adversarial learning to disentangle biased features from the model's representations. Extensive experiments on benchmark datasets such as VQA-CP and VQA-X demonstrate that FairVQA significantly reduces bias while maintaining or even improving overall performance. Our approach offers a promising step towards fairer and more equitable VQA systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Brådland},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3729882},
