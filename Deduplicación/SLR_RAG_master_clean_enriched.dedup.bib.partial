 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:35:35Z},
 year = {2025}
}

@inproceedings{farzi_does_2025,
 abstract = {Visual Question Answering (VQA) has achieved remarkable progress with the development of large-scale datasets and powerful pre-trained models. However, recent studies have revealed that VQA models suffer from severe bias, which leads to unfair decisions for different groups of people. In this paper, we conduct a comprehensive survey on fairness in VQA. We first provide a clear definition of fairness in VQA and categorize the existing fairness-aware VQA methods into three groups: data-centric methods, model-centric methods, and post-hoc methods. Then, we summarize the commonly used fairness evaluation metrics and representative datasets. Finally, we discuss the challenges and future directions in this field. This survey aims to provide researchers with a comprehensive understanding of fairness in VQA and inspire more fairness-aware VQA research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
