@inproceedings{bian_empowering_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) has led to the development of large language models (LLMs) capable of generating human-like text. However, these models often produce outputs that contain factual inaccuracies, biases, or harmful content, necessitating robust evaluation and mitigation strategies. In this paper, we introduce a novel framework for assessing the reliability of LLMs in generating safe and accurate responses to user queries. Our approach combines automated metrics with human evaluation to measure aspects such as factual correctness, toxicity, and coherence. Through extensive experiments on benchmark datasets, we demonstrate that our framework outperforms existing methods in identifying and mitigating risks associated with LLM outputs. Furthermore, we propose practical guidelines for deploying LLMs in real-world applications, emphasizing the importance of continuous monitoring and iterative improvement. Our work contributes to the ongoing effort to make AI systems more trustworthy and aligned with human values.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Bian},
 booktitle = {Proceedings of the 2025 {Applied}},
 doi = {10.1145/3744200.3744761},
 isbn = {979-8-4007-2009-3},
 keywords = {I-Ds},
 note = {event-place: Madrid},
