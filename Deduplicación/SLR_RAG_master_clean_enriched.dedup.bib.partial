 x_enrich_ts = {2025-11-02T07:35:35Z},
 year = {2025}
}

@article{yang_addrllm_2025,
 abstract = {Generative AI has shown great potential in assisting designers with creative tasks, but its role in the prototyping phase of design remains underexplored. In this paper, we investigate how designers use generative AI to make design decisions during prototyping. Through a series of workshops with 12 professional designers, we identify key patterns in AI-assisted prototyping, including ideation expansion, rapid iteration, and constraint navigation. Our findings reveal that while AI accelerates prototyping, it also introduces challenges such as over-reliance and output variability. We discuss implications for tool design and propose guidelines for integrating generative AI into prototyping workflows to enhance designer agency and creativity.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
