 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:22:28Z},
 year = {2025}
}

@article{shethiya_architecting_2024,
 abstract = {This study explores the integration of artificial intelligence (AI) in higher education, focusing on its potential to enhance personalized learning experiences. Drawing on a mixed-methods approach, including surveys of 500 students and interviews with 20 educators from universities in Southeast Asia, the research examines the adoption rates, perceived benefits, and challenges of AI tools such as adaptive learning platforms and chatbots. Findings indicate that while 78% of students report improved engagement and performance, barriers like data privacy concerns and digital divides persist. The paper proposes a framework for ethical AI implementation, emphasizing faculty training and inclusive design to maximize educational outcomes.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
