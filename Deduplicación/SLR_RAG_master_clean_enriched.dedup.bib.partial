@inproceedings{bhattacharya_show_2025,
 abstract = {Social media platforms are increasingly used for news dissemination, but the proliferation of misinformation undermines their reliability. This paper examines the dynamics of misinformation spread on Twitter by analyzing user engagement patterns. We collected a dataset comprising 500,000 tweets related to verified false news events from 2020-2023. Through network analysis and machine learning techniques, we identify key factors such as emotional language, source credibility, and temporal trends that amplify misinformation. Our results show that tweets with high emotional valence receive 3.5 times more retweets than neutral ones, accelerating diffusion. We introduce MisInfoGuard, a real-time detection system leveraging graph neural networks, which achieves 92% precision in flagging potential misinformation. This study provides actionable insights for platform designers to enhance content moderation and foster a healthier information ecosystem.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
