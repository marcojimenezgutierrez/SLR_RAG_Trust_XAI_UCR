@inproceedings{zhuang_document_2025,
 abstract = {We introduce FlexiSheet, a novel flexible, 3D-printable haptic display that enables dynamic tactile feedback on irregular surfaces. Unlike traditional pin-array displays, FlexiSheet uses a grid of soft pneumatic actuators embedded in a flexible silicone sheet, allowing it to conform to curved or deformable objects. We describe the design, fabrication, and control system, which supports multi-modal haptic patterns such as vibration, pressure, and shear. Through user studies, we evaluate its effectiveness for applications in virtual reality, medical training, and assistive technologies, demonstrating improved immersion and accessibility compared to rigid haptic interfaces. Our work provides a scalable platform for integrating haptics into everyday objects, paving the way for more intuitive human-computer interactions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
