@article{zhao_knowledge_2025,
 abstract = {This paper proposes a novel framework for enhancing cybersecurity in power systems through the integration of blockchain technology and machine learning algorithms. The approach addresses vulnerabilities in traditional supervisory control and data acquisition (SCADA) systems by implementing a decentralized ledger for secure data transmission and anomaly detection models for real-time threat identification. Simulation results demonstrate a 35% improvement in detection accuracy and reduced response times compared to conventional methods. The framework is evaluated on a testbed mimicking a microgrid environment, highlighting its scalability and robustness against common cyber-attacks such as false data injection.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
