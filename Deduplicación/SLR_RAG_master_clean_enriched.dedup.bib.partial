 year = {2025}
}

@inproceedings{feng_citygpt_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating code from natural language descriptions. However, they often produce code that is syntactically correct but semantically incorrect or inefficient, limiting their practical utility. To address this, we propose a collaborative framework called Chain-of-Agents (CoA), which leverages multiple specialized LLM agents to collaboratively refine and improve code generation. Each agent focuses on a specific aspect of code quality, such as correctness, efficiency, readability, and adherence to best practices. Through iterative communication and feedback loops, the agents build upon each other's outputs to produce high-quality code. Our experiments on benchmarks like HumanEval and MBPP demonstrate that CoA significantly outperforms single-agent baselines, achieving up to 15% improvement in pass@1 metrics. This work highlights the potential of multi-agent collaboration in enhancing LLM-based code generation tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Feng},
 booktitle = {Proceedings of the 31st {ACM}},
 doi = {10.1145/3711896.3736878},
