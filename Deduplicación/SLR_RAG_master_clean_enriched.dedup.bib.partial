 url = {https://doi.org/10.1145/3726302.3729928},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:34:50Z},
 year = {2025}
}

@inproceedings{wang_composable_2025,
 abstract = {Recent advancements in diffusion models have significantly improved the quality of image inpainting. However, existing methods often struggle with maintaining global consistency and handling complex structures, especially in multi-granularity scenarios where both local details and overall coherence are crucial. In this paper, we propose DiffuEraser, a novel diffusion-based inpainting framework that leverages multi-granularity guidance to achieve superior performance. Our approach integrates a hierarchical diffusion process with adaptive masking strategies, enabling the model to progressively refine inpainted regions from coarse to fine scales. By incorporating semantic priors and structural constraints, DiffuEraser ensures that the generated content aligns seamlessly with the surrounding context while preserving intricate details. Extensive experiments on benchmark datasets demonstrate that DiffuEraser outperforms state-of-the-art methods in terms of visual fidelity, user preference, and quantitative metrics such as FID and LPIPS.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
