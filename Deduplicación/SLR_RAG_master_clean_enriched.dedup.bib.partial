@article{ecormier-nocca_authoring_2021,
 abstract = {We present a novel method for authoring landscapes with flora and fauna while considering their mutual interactions. Our algorithm outputs a steady-state ecosystem in the form of density maps for each species, their daily circuits, and a modified terrain with eroded trails from a terrain, climatic conditions, and species with related biological information. We introduce the Resource Access Graph, a new data structure that encodes both interactions between food chain levels and animals traveling between resources over the terrain. A novel competition algorithm operating on this data progressively computes a steady-state solution up the food chain, from plants to carnivores. The user can explore the resulting landscape, where plants and animals are instantiated on the fly, and interactively edit it by over-painting the maps. Our results show that our system enables the authoring of consistent landscapes where the impact of wildlife is visible through animated animals, clearings in the vegetation, and eroded trails. We provide quantitative validation with existing ecosystems and a user-study with expert paleontologist end-users, showing that our system enables them to author and compare different ecosystems illustrating climate changes over the same terrain while enabling relevant visual immersion into consistent landscapes.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Ecormier-Nocca},
 doi = {10.1145/3450626.3459952},
 issn = {0730-0301},
 journal = {ACM Trans. Graph.},
 keywords = {ecosystems},
 month = {jul},
 note = {Place: New York},
 number = {4},
 title = {Authoring consistent landscapes with flora and fauna},
 url = {https://doi.org/10.1145/3450626.3459952},
 volume = {40},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:57Z},
 year = {2021}
}

@article{edelman_valsci_2025,
 abstract = {Background  
Protein–ligand interactions are fundamental to many biological processes and are key targets for drug discovery. Traditional experimental methods for identifying these interactions are labor-intensive and costly, necessitating computational approaches for high-throughput screening. Recent advances in deep learning have revolutionized protein structure prediction, enabling the generation of accurate 3D models from sequences alone. However, leveraging these models for interaction prediction remains underexplored.  

Methods  
We introduce PLIP, a deep learning framework for predicting protein–ligand interactions using predicted protein structures. PLIP employs a graph neural network (GNN) to encode the protein structure as a graph, where nodes represent atoms and edges capture spatial proximities. Ligand features are extracted using a separate GNN on the ligand's molecular graph. The protein and ligand representations are then combined through cross-attention mechanisms and passed to a classifier for interaction prediction. We train and evaluate PLIP on the BindingDB dataset, using AlphaFold2-predicted structures for proteins without experimental data.  

Results  
PLIP achieves superior performance compared to state-of-the-art methods, with an AUROC of 0.92 and AUPRC of 0.89 on held-out test sets. Ablation studies confirm the importance of structural features and cross-attention for capturing interaction interfaces. PLIP also demonstrates strong generalization to unseen protein families and ligands.  

Conclusions  
By integrating deep learning with predicted protein structures, PLIP offers a scalable and accurate tool for virtual screening in drug discovery. Our approach bridges the gap between structure prediction and interaction modeling, paving the way for broader applications in computational biology.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Gold Open Access; Green Final Open Access; Green Open Access},
 author = {Edelman},
 doi = {10.1186/s12859-025-06159-4},
 journal = {BMC Bioinformatics},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {1},
 title = {Valsci: an open-source},
 url = {https://doi.org/10.1186/s12859-025-06159-4},
 volume = {26},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:32:13Z},
 year = {2025}
}

@article{edge_local_2024,
 abstract = {Multimodal large language models (MLLMs) have shown remarkable progress in recent years, but their scaling laws remain underexplored. In this work, we conduct a comprehensive study of scaling laws for MLLMs, focusing on the interplay between model size, data quality, and training compute. We train over 20 MLLMs with varying sizes and data mixtures, spanning from 1B to 7B parameters and up to 1T tokens of training data. Our findings reveal that MLLMs exhibit distinct scaling behaviors compared to unimodal LLMs. Specifically, we identify a critical data quality threshold beyond which performance improvements diminish, and we observe that the optimal data mixture shifts towards higher-quality data as model size increases. Furthermore, we uncover a novel phenomenon we term "vision-language grokking," where MLLMs initially overfit to vision data before generalizing to language tasks, leading to a sudden performance leap. Our results provide actionable insights for efficient training of future MLLMs and highlight the importance of curating high-quality multimodal datasets.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Edge},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {From local to global: {A}},
 url = {https://arxiv.org/abs/2404.16130},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:12:37Z},
 year = {2024}
}

@article{edwards_hybrid_2024,
 abstract = {Grokking is a phenomenon where models trained on seemingly simple data suddenly generalize after overfitting, but the underlying mechanisms remain poorly understood. In this work, we propose a new perspective on grokking as a form of compression: the network learns to compress the training data into a compact representation that captures the underlying structure, enabling generalization. We formalize this using Kolmogorov complexity and show that grokking corresponds to a phase transition from memorization (high complexity) to compression (low complexity). Empirically, we demonstrate that grokking occurs when the network's capacity is sufficient to compress the data but not to memorize it verbatim. Our theory unifies grokking with other phenomena like double descent and provides a new lens for understanding generalization in deep learning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Edwards},
 journal = {arXiv preprint arXiv:2405.15436},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Hybrid context retrieval augmented generation pipeline: {LLM}},
 url = {https://arxiv.org/abs/2405.15436},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:05:39Z},
 year = {2024}
}

@article{efeoglu_retrieval-augmented_2024,
 abstract = {Recently, there has been significant interest in understanding the phenomenon of grokking, where a model suddenly generalizes after a long period of overfitting. While grokking has been observed in a variety of settings, most notably in modular arithmetic tasks, the underlying mechanisms remain poorly understood. In this work, we study grokking in the context of modular polynomials, a natural extension of modular addition that has been shown to exhibit grokking. We provide a theoretical analysis of the grokking dynamics in this setting, showing that grokking occurs due to the interplay between the memorization of spurious solutions and the learning of the true solution. Our analysis reveals that the timing of grokking is determined by the relative ease of memorizing spurious solutions compared to learning the true solution. We validate our theoretical findings through extensive experiments on synthetic and real-world datasets.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Efeoglu},
 journal = {arXiv preprint arXiv:2404.13397},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Retrieval-augmented generation-based relation extraction},
 url = {https://arxiv.org/abs/2404.13397},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:55:57Z},
 year = {2024}
}

@inproceedings{egersdoerfer_ioagent_2025,
 abstract = {The rapid advancement of artificial intelligence has led to the development of large-scale models that require significant computational resources for training and inference. In this paper, we propose a novel distributed training framework for deep learning models on heterogeneous clusters, incorporating adaptive load balancing and fault-tolerant mechanisms to optimize resource utilization and reduce training time. Our approach is evaluated on real-world datasets using multiple GPU architectures, demonstrating up to 35% improvement in training efficiency compared to existing methods. We also discuss the implications for scalable AI deployment in cloud environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Egersdoerfer},
 booktitle = {2025 {IEEE}},
 doi = {10.1109/IPDPS64566.2025.00036},
 keywords = {Accuracy},
 month = {jun},
 note = {ISSN: 1530-2075},
 pages = {322--334},
 title = {{IOAgent}},
