@article{zeng_worse_2025,
 abstract = {Generalist robot policies are emerging as an attractive alternative to domain-specific policies for robot learning. However, the performance of generalist policies lags behind domain-specific policies in most tasks. In this work, we investigate the potential of transfer learning to improve generalist robot policies. We first conduct a thorough empirical study of transfer learning for generalist robot policies. We find that transfer learning can significantly improve the performance of generalist policies, especially when the source and target tasks are similar. We then propose a simple yet effective transfer learning method for generalist robot policies, which we call Policy Distillation. Policy Distillation distills a generalist policy into a domain-specific policy using a small number of demonstrations. We show that Policy Distillation can achieve state-of-the-art performance on a range of robotic manipulation tasks, outperforming both domain-specific policies trained from scratch and generalist policies fine-tuned with reinforcement learning. Our results suggest that transfer learning is a promising direction for improving generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zeng},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
