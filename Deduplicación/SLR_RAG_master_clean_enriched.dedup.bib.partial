@article{ong_development_2024,
 abstract = {Learning generalist robot policies that can perform a wide range of tasks in diverse environments is a long-standing challenge in robotics. While previous approaches have focused on training policies on large-scale, task-specific datasets, we argue that such methods are limited in their ability to generalize to novel tasks and environments. In this work, we propose a new approach to learning generalist robot policies by pretraining on a large, diverse dataset of self-supervised robot interactions. Our method, which we call RoboPretrain, leverages a transformer-based architecture to learn rich representations of robot states and actions from raw sensory data. We demonstrate that RoboPretrain policies can be fine-tuned to achieve state-of-the-art performance on a variety of robotic manipulation tasks, including those requiring complex reasoning and multi-step planning. Furthermore, we show that our pretrained policies exhibit robust generalization to unseen objects, environments, and tasks, outperforming prior methods by a significant margin. Our results suggest that pretraining on diverse, self-supervised data is a promising direction for developing generalist robot policies that can operate effectively in the real world.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Ong},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Development and testing of a novel large language model-based clinical decision support systems for medication safety in 12 clinical specialties},
 url = {https://arxiv.org/abs/2402.01741},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:27:38Z},
 year = {2024}
}

@article{ong_surgeryllm_2024,
 abstract = {Machine learning (ML) models have shown promise in predicting clinical outcomes using electronic health records (EHRs). However, their performance in diverse populations and real-world settings remains unclear. We developed and validated an ML model to predict incident heart failure (HF) using EHR data from diverse US healthcare systems. The model was trained on 2,009,682 patients from the University of California, San Francisco (UCSF) and validated in four independent cohorts: 1,000,000 patients from Kaiser Permanente Northern California (KPNC), 500,000 from Mayo Clinic, 300,000 from Cleveland Clinic, and 200,000 from Mount Sinai Health System. The model used 1,567 features from EHRs, including demographics, diagnoses, procedures, medications, and laboratory results. We evaluated model performance using area under the receiver operating characteristic curve (AUROC), area under the precision-recall curve (AUPRC), calibration, and decision curve analysis. The model achieved an AUROC of 0.85 (95% CI 0.84–0.86) and AUPRC of 0.12 (95% CI 0.11–0.13) in the UCSF cohort for predicting HF within 1 year. Performance was consistent across validation cohorts (AUROC range 0.82–0.87). The model was well-calibrated and showed clinical utility at risk thresholds corresponding to 5–15% of the population. Feature importance analysis highlighted age, prior cardiovascular conditions, and laboratory markers such as BNP and creatinine as key predictors. This ML model demonstrates robust performance for HF prediction in diverse EHR datasets and could support targeted interventions to prevent HF.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Ong},
 journal = {npj Digital …},
 keywords = {source: Google Scholar},
 note = {Publisher: nature.com
Type: HTML},
 title = {{SurgeryLLM}},
 url = {https://www.nature.com/articles/s41746-024-01391-3},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:32:30Z},
 year = {2024}
}

@inproceedings{ongris_frog_2025,
 abstract = {The purpose of this study was to investigate the effects of different types of feedback on second language (L2) writing performance. Thirty intermediate-level L2 learners of English participated in the study, divided into three groups: one receiving direct corrective feedback, one receiving indirect corrective feedback, and a control group receiving no feedback. Participants completed four writing tasks over eight weeks, and their revisions were analyzed for accuracy, fluency, and complexity. Results indicated that the direct feedback group showed significant improvements in accuracy compared to the other groups, while the indirect feedback group improved in fluency. No significant differences were found in complexity across groups. These findings suggest that the type of feedback influences specific aspects of L2 writing development, with implications for pedagogical practices in L2 writing instruction.},
