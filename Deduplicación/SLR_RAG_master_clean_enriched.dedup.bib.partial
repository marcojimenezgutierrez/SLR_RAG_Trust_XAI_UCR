@inproceedings{darnell_empirical_2024,
 abstract = {Audio deepfakes, generated by advanced text-to-speech (TTS) and voice conversion (VC) techniques, pose significant threats to society. Existing audio deepfake detection methods primarily rely on hand-crafted acoustic features or deep neural networks (DNNs) trained on specific datasets, which often suffer from poor generalization to unseen attacks. In this paper, we propose a novel audio deepfake detection framework that leverages optimal transport (OT) to align feature distributions across different datasets, enhancing generalization. Specifically, we employ a contrastive learning approach with OT-based loss to learn robust representations invariant to dataset shifts. Our method is evaluated on multiple benchmark datasets, including ASVspoof 2019/2021 and In-the-Wild, demonstrating superior performance compared to state-of-the-art baselines, particularly in cross-dataset scenarios. This work advances the field towards more reliable and generalizable audio deepfake detection systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
