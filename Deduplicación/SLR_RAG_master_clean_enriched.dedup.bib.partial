 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:00:08Z},
 year = {2025}
}

@inproceedings{purohit_graphaide_2024,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices while keeping data localized, addressing privacy concerns in sensitive domains like healthcare. However, real-world FL deployments face challenges such as data heterogeneity, communication overhead, and vulnerability to adversarial attacks. In this paper, we propose FedHealth, a robust FL framework tailored for healthcare applications. FedHealth incorporates personalized model aggregation, differential privacy mechanisms, and anomaly detection to mitigate these issues. We evaluate FedHealth on benchmark healthcare datasets, including MIMIC-III and COVID-19 imaging, demonstrating improved accuracy (up to 15% over baselines) and enhanced privacy guarantees. Our results highlight FedHealth's potential for secure, scalable AI in healthcare informatics.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
