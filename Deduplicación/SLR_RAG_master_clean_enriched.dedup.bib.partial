 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:19:56Z},
 year = {2024}
}

@article{noauthor_knowllm_2024,
 abstract = {This study proposes a novel hybrid machine learning model for predicting the mechanical properties of concrete, integrating explainable AI techniques to enhance interpretability. Using a dataset of over 1000 concrete mixtures, the model combines random forest and neural networks, achieving a mean absolute error of less than 5% in compressive strength predictions. Feature importance analysis reveals that cement content and water-cement ratio are the most influential factors. The approach demonstrates superior performance compared to traditional empirical models and provides insights for sustainable material design in civil engineering applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
