@article{vakilzadeh_development_2025,
 abstract = {This study investigates the role of artificial intelligence (AI) in enhancing internal auditing processes within organizations. Drawing on a mixed-methods approach, including surveys of auditing professionals and case studies from leading firms, we examine how AI tools can improve risk assessment, fraud detection, and compliance monitoring. Our findings reveal that while AI adoption offers substantial efficiency gains, challenges such as data privacy, algorithmic bias, and skill gaps among auditors persist. We propose a framework for effective AI integration in internal auditing, emphasizing the need for robust governance and continuous training. This research contributes to the literature by providing empirical evidence on AI's practical applications and implications for the auditing profession.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Vakilzadeh},
 doi = {10.2308/ISYS-2024-041/13751},
 journal = {Journal of Information Systems},
 keywords = {source: Google Scholar},
