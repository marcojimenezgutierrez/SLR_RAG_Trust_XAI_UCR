@inproceedings{noauthor_proceedings_2024-3,
 abstract = {This study aimed to explore the relationship between childhood trauma, dissociation, and suicidal ideation in a sample of psychiatric inpatients. A total of 150 patients were assessed using the Childhood Trauma Questionnaire (CTQ), the Dissociative Experiences Scale (DES), and the Beck Scale for Suicidal Ideation (BSSI). Hierarchical multiple regression analyses were conducted to examine the unique contributions of childhood trauma and dissociation to suicidal ideation, controlling for relevant covariates. Results indicated that emotional abuse and emotional neglect were significantly associated with higher levels of suicidal ideation. Dissociation partially mediated the relationship between emotional abuse and suicidal ideation. These findings suggest that addressing dissociative symptoms may be important in the treatment of suicidal ideation among trauma-exposed individuals.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 booktitle = {Proceedings of {Machine}},
 keywords = {source: Scopus},
 note = {Type: Conference review},
