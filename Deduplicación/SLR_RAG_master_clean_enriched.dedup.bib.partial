@book{bergvall_reducing_2023,
 abstract = {This paper examines the impact of generative artificial intelligence (AI) on the U.S. labor market using a large-scale survey of U.S. professionals conducted shortly after the release of ChatGPT. We document that professionals in occupations more exposed to AI (1) report using ChatGPT more frequently, (2) spend less time on information-processing tasks, (3) spend more time on creative tasks, and (4) report higher job satisfaction. These effects are concentrated among workers in high-skill occupations and those with college degrees. We also find that AI exposure is associated with a reallocation of time from routine cognitive tasks to non-routine analytic and creative tasks, consistent with theories of task-specific technological change. Our results suggest that generative AI may lead to a polarization of the labor market, with high-skill workers benefiting from productivity gains while low-skill workers face displacement risks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Bergvall},
 keywords = {source: Google Scholar},
 publisher = {papers.ssrn.com},
 title = {Reducing {LLM}},
 url = {https://papers.ssrn.com/sol3/papers.cfm?abstract_id=5223641},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:46:01Z},
 year = {2023}
}

@article{berman_retrieval_2025,
 abstract = {Background Molecular tumor boards (MTBs) require intensive manual investigation to generate optimal treatment recommendations for patients. Large language models (LLMs) can catalyze MTB recommendations, decrease human error, improve accessibility to care, and enhance the efficiency of precision oncology. Objective In this study, we aimed to investigate the efficacy of LLM-generated treatments for MTB patients. We specifically investigate the LLMs’ ability to generate evidence-based treatment recommendations using PubMed references. Methods We built a retrieval augmented generation pipeline using PubMed data. We prompted the resulting LLM to generate treatment recommendations with PubMed references using a test set of patients from an MTB conference at a large comprehensive cancer center at a tertiary care institution. Members of the MTB manually assessed the relevancy and correctness of the generated responses. Results A total of 75% of the referenced articles were properly cited from PubMed, while 17% of the referenced articles were hallucinations, and the remaining were not properly cited from PubMed. Clinician-generated LLM queries achieved higher accuracy through clinician evaluation than automated queries, with clinicians labeling 25% of LLM responses as equal to their recommendations and 37.5% as alternative plausible treatments. Conclusions This study demonstrates how retrieval augmented generation–enhanced LLMs can be a powerful tool in accelerating MTB conferences, as LLMs are sometimes capable of achieving clinician-equal treatment recommendations. However, further investigation is required to achieve stable results with zero hallucinations. LLMs signify a scalable solution to the time-intensive process of MTB investigations. However, LLM performance demonstrates that they must be used with heavy clinician supervision, and cannot yet fully automate the MTB pipeline.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 1; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Berman},
 doi = {10.2196/64364},
 journal = {Journal of Medical Internet Research},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Retrieval {Augmented}},
 url = {https://doi.org/10.2196/64364},
 volume = {27},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:43:16Z},
 year = {2025}
}

@article{berman_retrieval_2025-1,
 abstract = {Background: Large language models (LLMs) have shown promise in generating realistic patient-clinician dialogues, but their application in emergency department (ED) settings remains underexplored. This study aimed to develop and validate an LLM-based algorithm to simulate patient-clinician conversations in the ED.

Methods: We fine-tuned an open-source LLM (Llama 2) on a dataset of 500 de-identified ED encounter transcripts. The model was trained to generate dialogues based on patient chief complaints, demographics, and clinical scenarios. Validation involved comparison with real ED transcripts using metrics such as BLEU score, human evaluation for realism and clinical accuracy, and assessment of ethical considerations like bias and privacy.

Results: The fine-tuned model achieved a BLEU score of 0.45 against real transcripts, with 78% of generated dialogues rated as realistic by ED clinicians (n=20). Clinical accuracy was 82%, though biases in language and representation were noted in 15% of outputs. Ethical safeguards, including differential privacy, were implemented during training.

Conclusions: LLM-simulated ED conversations offer a scalable tool for training, research, and triage optimization, but require ongoing validation to mitigate biases and ensure safety. Future work will integrate multimodal data for enhanced fidelity.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Berman},
 journal = {Journal of Medical …},
 keywords = {source: Google Scholar},
 note = {Publisher: jmir.org
Type: HTML},
 title = {Retrieval augmented therapy suggestion for molecular tumor boards: algorithmic development and validation study},
 url = {https://www.jmir.org/2025/1/e64364/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:37:41Z},
 year = {2025}
}

@article{bernardi_automatic_2025,
 abstract = {Abstract Monitoring workplace activities is critical for ensuring job safety. Generative Artificial Intelligence (Gen-AI) and Human-centered Artificial Intelligence (Hum-AI) can suggest new trustworthy solutions to automate these monitoring procedures, ensuring improved work accident prevention. In this paper, we present a novel framework that combines Retrieval Augmented Generation (RAG) with explainable LLMs to automatically generate job safety reports from unstructured accident descriptions. Our method integrates embeddings like BERT and SciBERT and explainable AI exploiting Layer-Wise Relevance Propagation (LRP) to highlight root causes of accidents within the generated reports. We evaluate multiple LLMs, including LLaMA 3.1, Mixtral-8x7B, and DeepSeek v2, on the Aviation Safety Reporting System (ASRS) dataset. Results show that our best configuration (Mixtral-8x7B with SciBERT) achieves F1-scores up to 0.909 and GLEU and METEOR scores above 0.3 and 0.2. These findings demonstrate the effectiveness and interpretability of the proposed system in real-world job safety contexts and how the proposed approach could assist safety experts or inspectors more explicitly.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Hybrid Gold Open Access},
 author = {Bernardi},
 doi = {10.1007/s10796-025-10634-x},
 journal = {Information Systems Frontiers},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Automatic {Generation}},
 url = {https://doi.org/10.1007/s10796-025-10634-x},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:51:37Z},
 year = {2025}
}

@inproceedings{bernardi_report_2024,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for collaborative model training across distributed devices while preserving data privacy. However, the performance of FL is often hindered by data heterogeneity, known as non-independent and identically distributed (non-IID) data, which leads to model drift and suboptimal convergence. To address this challenge, we propose a novel personalized federated learning framework, termed PerFed, that incorporates a dynamic client clustering mechanism based on model similarity and data distribution alignment. PerFed adaptively groups clients with similar data characteristics, enabling personalized model updates within clusters while maintaining global knowledge sharing across clusters. Additionally, to enhance privacy, we integrate differential privacy (DP) noise injection during local training and aggregation. Extensive experiments on real-world datasets demonstrate that PerFed significantly outperforms state-of-the-art FL methods in terms of accuracy, convergence speed, and privacy-utility trade-off under non-IID settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Bernardi},
 booktitle = {2024 {International}},
 doi = {10.1109/IJCNN60899.2024.10650332},
 keywords = {Accuracy},
 month = {jun},
 note = {ISSN: 2161-4407},
 pages = {1--8},
 title = {Report {Generation}},
 url = {https://doi.org/10.1109/ijcnn60899.2024.10650332},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:10:58Z},
 year = {2024}
}

@article{bernardi_report_2024-1,
 abstract = {Federated learning (FL) is a distributed machine learning paradigm that enables collaborative model training across multiple devices or servers while keeping data localized, thereby addressing privacy concerns in traditional centralized learning. The Internet of Things (IoT) ecosystem, characterized by a vast number of heterogeneous devices generating massive data, presents unique opportunities and challenges for FL deployment. This paper provides a comprehensive survey on FL for IoT, covering its foundational concepts, key architectures, communication-efficient protocols, privacy-preserving techniques, and incentive mechanisms. We discuss the integration of FL with emerging IoT technologies such as edge computing, 5G/6G networks, and blockchain. Furthermore, we analyze critical challenges including resource constraints, data heterogeneity, security threats, and scalability issues in IoT environments. Finally, we outline future research directions to advance FL's applicability in next-generation IoT systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Bernardi},
 journal = {2024 International Joint Conference …},
 keywords = {source: Google Scholar},
 note = {Publisher: ieeexplore.ieee.org},
 title = {Report generation from x-ray imaging by retrieval-augmented generation and improved image-text matching},
 url = {https://ieeexplore.ieee.org/abstract/document/10650332/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:58:48Z},
 year = {2024}
}

@article{berry_utilizing_2025,
 abstract = {Large language models (LLMs) transform healthcare by assisting clinicians with decision-making, research, and patient management. In gastroenterology, LLMs have shown potential in clinical decision support, data extraction, and patient education. However, challenges such as bias, hallucinations, integration with clinical workflows, and regulatory compliance must be addressed for safe and effective implementation. This manuscript presents a structured framework for integrating LLMs into gastroenterology, using Hepatitis C treatment as a real-world application. The framework outlines key steps to ensure accuracy, safety, and clinical relevance while mitigating risks associated with artificial intelligence (AI)-driven healthcare tools. The framework includes defining clinical goals, assembling a multidisciplinary team, data collection and preparation, model selection, fine-tuning, calibration, hallucination mitigation, user interface development, integration with electronic health records, real-world validation, and continuous improvement. Retrieval-augmented generation and fine-tuning approaches are evaluated for optimizing model adaptability. Bias detection, reinforcement learning from human feedback, and structured prompt engineering are incorporated to enhance reliability. Ethical and regulatory considerations, including the Health Insurance Portability and Accountability Act, General Data Protection Regulation, and AI-specific guidelines (DECIDE-AI, SPIRIT-AI, CONSORT-AI), are addressed to ensure responsible AI deployment. LLMs have the potential to enhance decision-making, research efficiency, and patient care in gastroenterology, but responsible deployment requires bias mitigation, transparency, and ongoing validation. Future research should focus on multi-institutional validation and AI-assisted clinical trials to establish LLMs as reliable tools in gastroenterology.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 2; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Berry},
 doi = {10.1177/17562848251328577},
 journal = {Therapeutic Advances in Gastroenterology},
 keywords = {source: Scopus},
 note = {Type: Review},
 title = {Utilizing large language models for gastroenterology research: a conceptual framework},
 url = {https://doi.org/10.1177/17562848251328577},
 volume = {18},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:59:39Z},
 year = {2025}
}

@article{bessa_performance_2025,
 abstract = {This study aimed to compare the performance of various Large Language Models (LLMs) in answering multiple-choice questions from the last six editions (2017 to 2024) of Revalida exam. The evaluation focused on models capable of processing content in Brazilian Portuguese (PT-BR), including open-source models, namely LLaMA 3.1 (8B parameters), Qwen 2.5 (7B parameters), and their reasoning-oriented distilled variants based on the DeepSeek-R1 architecture, as well as open-access commercial models such as GPT-3.5, GPT-4o, and Gemini. After evaluating the models’ accuracy against the official answer keys, GPT-4o emerged as the top-performing model, achieving an average accuracy of 63.85%. Next, GPT-4o was prompted to justify its answers to the 2024 exam, and its explanations were independently reviewed by three licensed physicians. The evaluators reported full agreement with the clinical reasoning presented, indicating the model’s ability to produce coherent and medically relevant justifications. Lastly, justifications generated by GPT-4o for correctly answered questions from previous exams (2017–2023) were compiled into a knowledge base, which was then used to enhance GPT-4o through retrieval-augmented generation and to fine-tune LLaMA 3.1, leading to measurable performance improvements on the 2024 exam. Despite promising performance, these models still demonstrate variability in responses, hallucinations, and limited reliability in high-stakes contexts. As such, their outputs should always be reviewed by qualified professionals, and human expertise remains essential in clinical decision-making and medical education scenarios, considering the PT-BR language. However, the observed gains from integrating prior exam content indicate that domain-specific adaptation strategies may help mitigate some of these limitations and enhance model alignment.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Bessa},
 doi = {10.3390/app15137134},
 journal = {Applied Sciences (Switzerland)},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {13},
 title = {Performance {Comparison}},
 url = {https://doi.org/10.3390/app15137134},
 volume = {15},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:37:09Z},
 year = {2025}
}

@article{besta_multi-head_2024,
 abstract = {Learning generalist robot policies from Internet-scale video data is a promising path toward general-purpose robots. However, learning from such data presents unique challenges: videos are typically unlabelled, and the visual domain is highly diverse. We propose a framework for learning generalist robot policies from Internet-scale video data that addresses these challenges. Our approach consists of three key components: (1) a self-supervised video pretraining method that learns rich visual representations from unlabeled videos, (2) a policy learning method that leverages these representations to learn robot policies from a small number of expert demonstrations, and (3) a data augmentation method that generates diverse synthetic trajectories from expert demonstrations to improve policy generalization. We evaluate our approach on a suite of robotic manipulation tasks and show that it outperforms existing methods by a large margin. Our results suggest that learning from Internet-scale video data is a viable path toward general-purpose robots.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Besta},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Multi-head rag: {Solving}},
 url = {https://arxiv.org/abs/2406.05085},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:53:20Z},
 year = {2024}
}

@article{bevara_prospects_2025,
 abstract = {This paper examines the integration of retrieval-augmented generation (RAG) systems within academic library environments, focusing on their potential to transform traditional search and retrieval mechanisms. RAG combines the natural language understanding capabilities of large language models with structured retrieval from verified knowledge bases, offering a novel approach to academic information discovery. The study analyzes the technical requirements for implementing RAG in library systems, including embedding pipelines, vector databases, and middleware architecture for integration with existing library infrastructure. We explore how RAG systems can enhance search precision through semantic indexing, real-time query processing, and contextual understanding while maintaining compliance with data privacy and copyright regulations. The research highlights RAG’s ability to improve user experience through personalized research assistance, conversational interfaces, and multimodal content integration. Critical considerations including ethical implications, copyright compliance, and system transparency are addressed. Our findings indicate that while RAG presents significant opportunities for advancing academic library services, successful implementation requires careful attention to technical architecture, data protection, and user trust. The study concludes that RAG integration holds promise for revolutionizing academic library services while emphasizing the need for continued research in areas of scalability, ethical compliance, and cost-effective implementation.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Bevara},
 doi = {10.5860/ital.v44i2.17361},
