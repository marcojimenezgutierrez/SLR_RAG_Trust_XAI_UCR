 keywords = {large language model},
 note = {event-place: Sacramento},
 pages = {870--882},
 publisher = {Association for Computing Machinery},
 series = {{ASE}},
 title = {{JavaBench}},
 url = {https://doi.org/10.1145/3691620.3695470},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:53:41Z},
 year = {2024}
}

@article{cao_learn_2023,
 abstract = {We advance the understanding of the grokking phenomenon -- the delayed generalization in neural networks where a model first memorizes the training data and then later learns a general solution -- by providing a mechanistic explanation for the internal representations that emerge during grokking. We focus on the task of modular addition, where we show that grokking corresponds to learning modular arithmetic circuits. We develop a progress measure that tracks the circuit's development, and use it to study the grokking dynamics. We find that grokking proceeds in three phases: first, the model memorizes the training data using a lookup table; second, it learns a low-complexity circuit that generalizes poorly; and third, it refines the circuit to a high-complexity one that generalizes well. We show that the second phase is necessary for grokking, and that the third phase can be accelerated by modifying the training procedure. Our work provides a concrete example of how mechanistic interpretability can be used to understand and control the training dynamics of neural networks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Cao},
 journal = {arXiv preprint arXiv:2311.01041},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Learn to refuse: {Making}},
 url = {https://arxiv.org/abs/2311.01041},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:27:17Z},
 year = {2023}
}

@article{cao_lego-graphrag_2025,
 abstract = {GraphRAG integrates (knowledge) graphs with large language models (LLMs) to improve reasoning accuracy and contextual relevance. Despite its promising applications and strong relevance to multiple research communities, such as databases and natural language processing, GraphRAG currently lacks modular workflow analysis, systematic solution frameworks, and insightful empirical studies. To bridge these gaps, we propose LEGO-GraphRAG , a modular framework that enables: 1 ) fine-grained decomposition of the GraphRAG workflow, 2 ) systematic classification of existing techniques and implemented GraphRAG instances, and 3 ) creation of new GraphRAG instances. Our framework facilitates comprehensive empirical studies of GraphRAG on large-scale real-world graphs and diverse query sets, revealing insights into balancing reasoning quality, runtime efficiency, and token or GPU cost, that are essential for building advanced GraphRAG systems.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Cao},
 doi = {10.14778/3748191.3748194},
 issn = {2150-8097},
 journal = {Proc. VLDB Endow.},
