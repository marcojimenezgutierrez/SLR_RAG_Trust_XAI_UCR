 keywords = {Extended Reality},
 publisher = {Association for Computing Machinery},
 series = {{CHItaly}},
 title = {Exploring {LLM}},
 url = {https://doi.org/10.1145/3750069.3750160},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:00:09Z},
 year = {2025}
}

@article{cordonnier_forming_2023,
 abstract = {We introduce the first solution for simulating the formation and evolution of glaciers, together with their attendant erosive effects, for periods covering the combination of glacial and inter-glacial cycles. Our efficient solution includes both a fast yet accurate deep learning-based estimation of highorder ice flows and a new, multi-scale advection scheme enabling us to account for the distinct time scales at which glaciers reach equilibrium compared to eroding the terrain. We combine the resulting glacial erosion model with finer-scale erosive phenomena to account for the transport of debris flowing from cliffs. This enables us to model the formation of terrain shapes not previously adequately modeled in Computer Graphics, ranging from U-shaped and hanging valleys to fjords and glacial lakes.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Cordonnier},
 doi = {10.1145/3592422},
 issn = {0730-0301},
 journal = {ACM Trans. Graph.},
 keywords = {erosion},
 month = {jul},
 note = {Place: New York},
 number = {4},
 title = {Forming {Terrains}},
 url = {https://doi.org/10.1145/3592422},
 volume = {42},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:24Z},
 year = {2023}
}

@inproceedings{cornacchia_between_2025,
 abstract = {Language models are powerful tools for a wide range of applications, but their black-box nature makes it difficult to understand and control their behavior. We introduce ChainForge, a visual toolkit for building, visualizing, and testing chains of language model prompts. ChainForge allows users to construct complex prompt chains using a drag-and-drop interface, visualize the flow of information through the chain, and test hypotheses about model behavior by running experiments with different inputs and parameters. We describe the design and implementation of ChainForge, and present case studies demonstrating its use in prompt engineering, debugging, and research. ChainForge is open-source and available at chainforge.ai.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Cornacchia},
 booktitle = {Proceedings of the 16th {ACM}},
