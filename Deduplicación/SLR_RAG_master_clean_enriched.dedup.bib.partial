@article{bui_cross-data_2024,
 abstract = {Audio deepfakes pose significant threats to society, necessitating robust detection methods. Existing approaches often suffer from poor generalization across diverse forgery techniques and unseen datasets. In this paper, we propose a novel framework that leverages Optimal Transport (OT) to align feature distributions between real and synthetic audio, enhancing the model's ability to capture subtle forgery artifacts. Our method, OT-ADF (Optimal Transport-based Audio Deepfake Detection), integrates OT distances into a contrastive learning paradigm, trained on a large-scale audio dataset. We evaluate OT-ADF on benchmark datasets including ASVspoof 2019/2021 and recent deepfake challenges, demonstrating superior performance in cross-dataset and cross-model generalization compared to state-of-the-art baselines. Ablation studies confirm the efficacy of OT in improving robustness against adversarial perturbations. Our approach offers a promising direction for scalable and reliable audio authenticity verification.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Bui},
 booktitle = {Proceedings of the 1st {ACM}},
