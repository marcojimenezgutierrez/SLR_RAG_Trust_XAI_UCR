 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:43:53Z},
 year = {2025}
}

@article{lahiri_alzheimerrag_2025,
 abstract = {Recent advancements in generative AI have fostered the development of highly adept Large Language Models (LLMs) that integrate diverse data types to empower decision-making. Among these, multimodal retrieval-augmented generation (RAG) applications are promising because they combine the strengths of information retrieval and generative models, enhancing their utility across various domains, including clinical use cases. This paper introduces AlzheimerRAG, a multimodal RAG application for clinical use cases, primarily focusing on Alzheimer’s disease case studies from PubMed articles. This application incorporates cross-modal attention fusion techniques to integrate textual and visual data processing by efficiently indexing and accessing vast amounts of biomedical literature. Our experimental results, compared to benchmarks such as BioASQ and PubMedQA, yield improved performance in the retrieval and synthesis of domain-specific information. We also present a case study using our multimodal RAG in various Alzheimer’s clinical scenarios. We infer that AlzheimerRAG can generate responses with accuracy non-inferior to humans and with low rates of hallucination.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Lahiri},
 doi = {10.3390/make7030089},
 journal = {Machine Learning and Knowledge Extraction},
 keywords = {source: Google Scholar},
 note = {Type: Article},
 number = {3},
 title = {{AlzheimerRAG}},
 url = {https://doi.org/10.3390/make7030089},
 volume = {7},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:21:04Z},
 year = {2025}
}

@inproceedings{lai_graphyour_2025,
 abstract = {Interactive data visualization tools empower users to explore and analyze data through direct manipulation of visual representations. However, creating custom visualizations often requires programming expertise, limiting accessibility. Visual programming languages (VPLs) offer a promising alternative by allowing users to build visualizations through graphical interfaces. Despite their potential, designing effective VPLs for data visualization remains underexplored. In this paper, we investigate the design space of VPLs for interactive data visualization. We identify key design dimensions, including representation (e.g., blocks vs. nodes), interaction (e.g., drag-and-drop vs. menu-based), and integration with data (e.g., inline vs. separate editors). Through a series of design studies and user evaluations, we prototype and assess different VPL configurations. Our findings reveal trade-offs in usability, expressiveness, and learnability, providing guidelines for future VPL development in visualization tools.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Lai},
 booktitle = {Companion of the 2025 {International}},
 doi = {10.1145/3722212.3725106},
