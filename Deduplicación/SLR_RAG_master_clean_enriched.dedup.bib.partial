 journal = {2024 7th …},
 keywords = {source: Google Scholar},
 note = {Publisher: ieeexplore.ieee.org},
 title = {Alleviating action hallucination for llm-based embodied agents via inner and outer alignment},
 url = {https://ieeexplore.ieee.org/abstract/document/10826957/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:03:42Z},
 year = {2024}
}

@inproceedings{li_alphafin_2024,
 abstract = {The rapid advancement of artificial intelligence (AI) has led to the development of deep learning (DL) models that can achieve human-level performance in many tasks, including medical image analysis. However, the application of DL in medical imaging is still in its early stages, and there are many challenges that need to be addressed. In this paper, we review the current state-of-the-art DL methods for medical image analysis, with a focus on imaging traits, technology trends, case studies with cancer applications, and future directions. We first introduce the basic concepts of DL and its applications in medical imaging. Then, we discuss the imaging traits that are important for DL-based medical image analysis, including image quality, modality, and anatomy. Next, we review the technology trends in DL for medical imaging, including convolutional neural networks (CNNs), generative adversarial networks (GANs), and transformer models. We also present case studies of DL applications in cancer imaging, including lung cancer, breast cancer, and prostate cancer. Finally, we discuss the challenges and future directions for DL in medical imaging, including interpretability, generalizability, and ethical considerations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 6},
 author = {Li},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {773 -- 783},
 title = {{AlphaFin}},
 url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85195934691&partnerID=40&md5=d7f5acab0a70f5aff9a75286b4203402},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:05:09Z},
 year = {2024}
}

@article{li_autosilicon_2025,
 abstract = {Hardware description language (HDL) code designing is a critical component of the chip design process, requiring substantial engineering and time resources. Recent advancements in large language models (LLMs), such as GPT series, have shown promise in automating HDL code generation. However, current LLM-based approaches face significant challenges in meeting real-world hardware design requirements, particularly in handling complex designs and ensuring code correctness. Our evaluations reveal that the functional correctness rate of LLM-generated HDL code significantly decreases as design complexity increases. In this article, we propose the AutoSilicon framework, which aims to scale up the hardware design capability of LLMs. AutoSilicon incorporates an agent system, which (1) allows for the decomposition of large-scale, complex code design tasks into smaller, simpler tasks; (2) provides a compilation and simulation environment that enables LLMs to compile and test each piece of code it generates; and (3) introduces a series of optimization strategies. Experimental results demonstrate that AutoSilicon can scale hardware designs to projects with code equivalent to over 10,000 tokens. In terms of design quality, it further improves the syntax correctness rate and functional correctness rate compared with approaches that do not employ any extensions. For example, compared to directly generating HDL code using GPT-4-turbo, AutoSilicon enhances the syntax correctness rate by an average of 35.8% and improves functional correctness by an average of 35.6%.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Li},
 doi = {10.1145/3737286},
 issn = {1084-4309},
 journal = {ACM Trans. Des. Autom. Electron. Syst.},
 keywords = {agent},
 month = {oct},
 note = {Place: New York},
 number = {6},
 title = {{AutoSilicon}},
 url = {https://doi.org/10.1145/3737286},
 volume = {30},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:01Z},
 year = {2025}
}

@inproceedings{li_benchmarking_2025,
 abstract = {This study examines the effects of economic policy uncertainty on corporate investment decisions in emerging markets. Using a panel dataset of firms from Brazil, India, China, and South Africa over the period 2000-2019, we employ a difference-in-differences approach to identify causal impacts. Our findings indicate that heightened policy uncertainty significantly reduces capital expenditures, with stronger effects in industries sensitive to regulatory changes. The results are robust to various specifications and suggest that uncertainty acts as a brake on long-term investment, exacerbating economic volatility in these markets.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Li},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {90296 -- 90318},
 title = {{BENCHMARKING}},
