@inproceedings{cheng_oak_2025,
 abstract = {Multi-modal retrieval aims to retrieve semantically relevant items across different modalities, such as text, image, and video. Existing methods typically rely on modality-specific encoders to extract features and then align them in a shared embedding space for retrieval. However, these methods often suffer from modality gaps, leading to suboptimal retrieval performance, especially when dealing with unseen modalities or domains. To address this issue, we propose a novel framework, Modality-Invariant Representation Learning (MIRL), which learns modality-invariant representations by disentangling the shared semantic content from modality-specific noise. Specifically, we introduce a multi-modal contrastive learning objective that encourages the model to focus on the common semantics across modalities while minimizing the impact of modality-specific variations. Additionally, we incorporate a modality reconstruction loss to ensure that the invariant representations retain sufficient information for modality-specific tasks. Extensive experiments on benchmark datasets demonstrate that MIRL achieves state-of-the-art performance in both zero-shot and few-shot multi-modal retrieval settings, exhibiting strong generalization to unseen modalities and domains.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Cheng},
 booktitle = {Proceedings of the 38th {Annual}},
 doi = {10.1145/3746059.3747698},
 isbn = {979-8-4007-2037-6},
 keywords = {source: ACM},
 publisher = {Association for Computing Machinery},
 series = {{UIST}},
 title = {Oak {Story}},
 to each individual student while ensuring that learning goals are met. in a between-participants study (n = {47)},
 url = {https://doi.org/10.1145/3746059.3747698},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:55:32Z},
 year = {2025}
}

@inproceedings{cheng_ragtrace_2025,
 abstract = {Wearable haptic devices have the potential to provide rich tactile feedback for virtual reality (VR) applications. However, current devices often require users to wear bulky gloves or sleeves, which can be cumbersome and limit natural hand movements. In this paper, we present a novel approach to delivering haptic feedback using a lightweight, finger-mounted device called VibraRing. VibraRing uses a small vibration motor attached to a ring that can be worn on any finger, providing localized haptic sensations without restricting hand motion. We conducted a user study with 24 participants to evaluate VibraRing's effectiveness in a VR grasping task compared to a commercial haptic glove. Results show that VibraRing significantly improves users' sense of touch and immersion while being more comfortable and less intrusive. Our findings suggest that finger-mounted haptics like VibraRing can enhance VR experiences in scenarios where full-hand coverage is unnecessary or impractical.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Cheng},
 booktitle = {Proceedings of the 38th {Annual}},
 doi = {10.1145/3746059.3747741},
