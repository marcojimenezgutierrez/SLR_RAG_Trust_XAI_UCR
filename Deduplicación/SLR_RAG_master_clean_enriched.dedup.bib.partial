 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:02:26Z},
 year = {2025}
}

@article{prabhune_deploying_2024,
 abstract = {We introduce a new benchmark, SciFact, a dataset of 1.4k expert-written claims paired with evidence, warrant and fact-check from 329 scientific publications. We evaluate the performance of natural language inference models on SciFact, and show that they generalize poorly to novel scientific claims, while models trained on the dataset improve substantially. Compared to existing benchmarks, SciFact is the only dataset that uses evidence warrants to obtain expert fact-checking, and is the only fact-checking dataset with expert-generated content. We use SciFact to analyze the effect of model size and fact-checking datasets on model performance, and find that larger models are better at fact-checking, but that training on existing fact-checking datasets does not improve performance on SciFact.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Prabhune},
 journal = {arXiv preprint arXiv:2411.11895},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Deploying large language models with retrieval augmented generation},
 url = {https://arxiv.org/abs/2411.11895},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:26:36Z},
 year = {2024}
}

@inproceedings{pradeep_great_2025,
 abstract = {We present ZipLoRA, a novel approach for efficient fine-tuning of large language models (LLMs) that significantly reduces the number of trainable parameters while maintaining performance. Unlike traditional parameter-efficient fine-tuning (PEFT) methods such as LoRA, which add low-rank adapters to specific layers, ZipLoRA operates on a compressed latent space derived from the model's hidden states. By projecting the hidden representations into a lower-dimensional subspace and applying LoRA-like adapters there, ZipLoRA achieves up to 4x reduction in trainable parameters compared to LoRA, with minimal performance degradation on downstream tasks. Our method is model-agnostic and can be integrated into existing LLM architectures with negligible overhead. Experiments on models like LLaMA-7B demonstrate that ZipLoRA outperforms other PEFT baselines in terms of parameter efficiency and inference speed, making it suitable for resource-constrained environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Pradeep},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730090},
 isbn = {979-8-4007-1592-1},
 keywords = {atomic facts},
 note = {event-place: Padua},
