 title = {Self {Supervised}},
 url = {https://doi.org/10.1145/3703412.3703421},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:55:41Z},
 year = {2025}
}

@inproceedings{heinrich_systematic_2025,
 abstract = {Generative AI has shown great potential in assisting developers with various software engineering tasks. However, integrating generative AI into Integrated Development Environments (IDEs) remains underexplored. In this paper, we present GenAIC, a framework that integrates generative AI into the IDE to assist developers in code generation tasks. GenAIC leverages large language models to generate code snippets based on natural language descriptions provided by developers. We conducted a user study with 20 professional developers to evaluate the effectiveness of GenAIC in improving code generation productivity and code quality. Our results show that GenAIC significantly reduces the time required for code generation tasks while maintaining or improving code quality. Additionally, we discuss the design implications and future directions for integrating generative AI into IDEs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
