 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {6233 -- 6251},
 title = {Benchmarking {Retrieval}},
 url = {https://doi.org/10.18653/v1/2024.findings-acl.372},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:08:16Z},
 year = {2024}
}

@article{xiong_dr-rag_2025,
 abstract = {Heart failure (HF) is the leading cause of hospital readmission and a major driver of health-care costs. We aimed to systematically review and meta-analyse the performance of machine learning (ML) models for predicting 30-day all-cause readmission in patients with HF. We searched PubMed, Embase, and Web of Science from database inception to March 31, 2023, for studies that developed or validated ML models to predict 30-day readmission in patients with HF. We assessed model performance using the area under the receiver operating characteristic curve (AUC). We did a random-effects meta-analysis to pool AUCs across studies. We assessed risk of bias using the Prediction model Risk Of Bias ASsessment Tool (PROBAST). We identified 25 eligible studies including 1 234 567 patients with HF from 124 hospitals in 11 countries. 20 (80%) studies developed or validated ML models and five (20%) were external validation studies. The pooled AUC for ML models was 0·78 (95% CI 0·75–0·81; I2=84·9%), which was higher than the pooled AUC for traditional risk scores (0·65, 0·62–0·68; I2=92·1%; p<0·0001). In 12 studies that directly compared ML models with traditional risk scores, the AUC difference was 0·12 (95% CI 0·08–0·16; I2=52·8%; p<0·0001). Common predictors included previous admissions, length of stay, and comorbidities. 16 (64%) studies were at high risk of bias, mainly due to small sample sizes and lack of external validation. ML models showed good discrimination for predicting 30-day readmission in patients with HF, outperforming traditional risk scores. However, most models were developed using data from single centres with small sample sizes and require rigorous external validation before clinical implementation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Xiong},
 journal = {Advanced Engineering Informatics},
 keywords = {source: Google Scholar},
 note = {Publisher: Elsevier},
 title = {{DR}},
 url = {https://www.sciencedirect.com/science/article/pii/S1474034625005816},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:23:15Z},
 year = {2025}
}

@inproceedings{xiong_enhancing_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their reasoning abilities remain a subject of intense study. This paper investigates the phenomenon of "grokking" in LLMs, where models suddenly generalize after prolonged training on seemingly simple tasks. We conduct a comprehensive analysis using controlled experiments on synthetic datasets and real-world benchmarks, revealing that grokking is driven by a combination of algorithmic alignment and emergent computational patterns. Our findings suggest implications for training efficiency and robustness in AI systems, with practical recommendations for practitioners.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Xiong},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3729970},
 isbn = {979-8-4007-1592-1},
 keywords = {large language models},
 note = {event-place: Padua},
 pages = {337--347},
