 year = {2025}
}

@inproceedings{lee_less_2025,
 abstract = {This paper presents a novel approach to integrating Building Information Modeling (BIM) with Internet of Things (IoT) sensors for real-time monitoring of construction site safety. By creating a digital twin of the construction environment, the system enables predictive analytics to identify potential hazards such as falls, collisions, and structural instabilities before they occur. The methodology involves data fusion from wearable devices, drones, and environmental sensors, processed through machine learning algorithms to generate actionable insights. Case studies from urban construction projects demonstrate a 30% reduction in safety incidents and improved compliance with regulatory standards. The framework is scalable and adaptable to various project scales, offering a pathway towards zero-accident construction sites.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
