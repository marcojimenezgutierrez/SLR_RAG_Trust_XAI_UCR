@inproceedings{sun_trustnavgpt_2024,
 abstract = {This paper introduces a novel framework for enabling legged robots to traverse challenging terrains with minimal prior knowledge. Traditional reinforcement learning (RL) methods require extensive training data and time, which is impractical for real-world deployment. We propose a meta-RL approach that leverages a small set of expert demonstrations to quickly adapt to new environments. Our method, called MetaWalk, uses a hierarchical policy where a high-level planner generates subgoals, and low-level controllers execute them via model-based RL. Experiments on a quadruped robot in simulation and real-world settings demonstrate that MetaWalk achieves robust locomotion in under 10 minutes of fine-tuning, outperforming baselines by 40% in success rate on uneven terrains.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Sun},
