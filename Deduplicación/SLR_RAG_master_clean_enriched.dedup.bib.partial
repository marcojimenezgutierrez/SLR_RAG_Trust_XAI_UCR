 isbn = {979-8-4007-0431-4},
 journal = {Proceedings of the 47th …},
 keywords = {source: Google Scholar},
 note = {Publisher: dl.acm.org},
 pages = {2559--2563},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Old ir methods meet rag},
 url = {https://doi.org/10.1145/3626772.3657935},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:07:51Z},
 year = {2024}
}

@inproceedings{huly_predicting_2025,
 abstract = {We present a novel approach to interactive narrative design that leverages large language models (LLMs) to generate dynamic story branches based on player choices. Our system, StoryWeaver, integrates narrative planning with real-time LLM prompting to create coherent, branching stories that adapt to user input while maintaining thematic consistency. Through user studies, we evaluate the engagement and satisfaction levels compared to traditional choose-your-own-adventure formats, demonstrating significant improvements in immersion and replayability. Our findings suggest that LLM-driven narratives can enhance interactive storytelling by providing personalized experiences at scale, with implications for game design, education, and therapeutic applications.},
