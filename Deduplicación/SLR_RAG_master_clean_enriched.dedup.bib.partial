}

@inproceedings{sun_docs2kg_2025,
 abstract = {Recent advancements in large language models (LLMs) have led to a surge in the development of LLM-based agents that can perform complex tasks by interacting with external tools. Despite their capabilities, these agents often struggle with tasks requiring multi-step reasoning and planning, especially when the tools are complex or the environment is dynamic. In this paper, we introduce ToolkenGPT, a novel framework that enhances LLM-based agents' ability to reason and plan by representing tools as "toolkens" -- structured, learnable embeddings that capture the semantics and usage patterns of tools. By integrating toolkens into the LLM's input and output spaces, ToolkenGPT enables the model to better understand tool functionalities, anticipate their effects, and generate more coherent action sequences. We evaluate ToolkenGPT on several benchmarks involving tool usage, including ALFWorld and WebShop, demonstrating significant improvements in task success rates and planning efficiency compared to existing baselines. Our approach not only bridges the gap between natural language reasoning and tool execution but also opens new avenues for developing more robust and interpretable LLM agents.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Sun},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3701716.3715309},
