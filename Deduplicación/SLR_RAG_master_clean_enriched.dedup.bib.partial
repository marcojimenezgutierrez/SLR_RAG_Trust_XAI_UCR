 year = {2024}
}

@inproceedings{argyrou_prompt2fashion_2024,
 abstract = {Social media platforms have become a primary source of news for many users, but the quality of content varies widely, and misinformation can spread rapidly. Large language models (LLMs) have shown promise in summarizing news articles, but they can also generate or amplify misinformation. In this paper, we investigate the risk of LLM-generated misinformation in news summarization. We conduct a systematic evaluation using a dataset of real news articles and their summaries generated by GPT-4. Our findings reveal that while LLMs produce coherent summaries, they occasionally introduce factual inaccuracies, particularly when dealing with complex or ambiguous information. We propose mitigation strategies, including fact-checking integration and prompt engineering, to reduce the propagation of misinformation. Our work highlights the need for careful deployment of LLMs in journalistic applications to maintain trust in digital news ecosystems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
