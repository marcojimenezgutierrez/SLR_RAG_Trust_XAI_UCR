@article{misrahi_adapting_2025,
 abstract = {Large, high-capacity models trained on diverse datasets have shown remarkable successes in understanding and generating natural language, images, and videos. Yet, while these models have been widely applied to tasks in these domains, they have not been widely applied to robotic control. This is largely due to the lack of datasets of comparable scale and diversity to those used for language, vision, and video. We address this by introducing Open X-Embodiment, the largest and most diverse dataset to date for robotic learning, comprising over 1 million real robot trajectories collected from 22 different robot embodiments across 527 skills, 150 different robots, and 84 different tasks. We also introduce RT-X, a new vision-language-action (VLA) model that builds on the success of large language models and vision-language models. RT-X is trained on the Open X-Embodiment dataset and demonstrates significant improvements over prior state-of-the-art models in a variety of robotic tasks, including language-conditioned manipulation, multi-task learning, and zero-shot generalization to new embodiments. We release the dataset, models, and code to facilitate future research in embodied AI.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Misrahi},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Adapting {Large}},
 url = {https://arxiv.org/abs/2504.02411},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:23:31Z},
 year = {2025}
}

@article{mitchell_using_2025,
 abstract = {Living evidence synthesis (LES) involves repeatedly updating a systematic review or meta-analysis at regular intervals to incorporate new evidence into the summary results. It requires a considerable amount of human time investment in the article search, collection, and data extraction phases. Tools exist to automate the retrieval of relevant journal articles, but pulling data out of those articles is currently still a manual process. In this article, we present a proof-of-concept Python program that leverages artificial intelligence (AI) tools (specifically, ChatGPT) to parse a batch of journal articles and extract relevant results, greatly reducing the human time investment in this action without compromising on accuracy. Our program is tested on a set of journal articles that estimate the mean incubation period for COVID-19, an epidemiological parameter of importance for mathematical modelling. We also discuss important limitations related to the total amount of information and rate at which that information can be sent to the AI engine. This work contributes to the ongoing discussion about the use of AI and the role such tools can have in scientific research.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 1; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Mitchell},
 doi = {10.1371/journal.pone.0320151},
 journal = {PLOS ONE},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {4 April},
 title = {Using artificial intelligence tools to automate data extraction for living evidence syntheses},
 url = {https://doi.org/10.1371/journal.pone.0320151},
 volume = {20},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:41:31Z},
 year = {2025}
}

@inproceedings{mittal_wavepulse_2025,
 abstract = {This paper explores the design and evaluation of a collaborative virtual reality (VR) system for remote co-design activities, focusing on how spatial audio and haptics can enhance user interaction in immersive environments. We conducted a user study with 24 participants to assess the system's effectiveness in supporting creative ideation and feedback exchange. Results indicate significant improvements in perceived collaboration quality and task efficiency compared to traditional video conferencing tools. Our findings contribute to the growing body of research on VR for design practices, offering implications for future developments in extended reality (XR) applications.},
