 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:42:46Z},
 year = {2024}
}

@inproceedings{yan_efficient_2024,
 abstract = {Simultaneous Localization and Mapping (SLAM) in dense environments is a long-standing challenge in robotics and computer vision. Recent neural implicit representations have shown great promise in high-quality reconstruction and novel view synthesis. However, they are not yet suitable for real-time SLAM in dense environments due to the high computational cost of neural networks. In this paper, we propose a novel neural implicit dense semantic SLAM system, called NIDS-SLAM, which achieves real-time performance by leveraging a hybrid explicit-implicit representation. Specifically, we maintain an explicit voxel grid for fast tracking and mapping, while using a compact neural implicit field to refine the geometry and semantics in a deferred manner. To enable accurate semantic understanding, we introduce a semantic consistency module that propagates semantic labels from sparse keyframes to the entire map using learned features. Extensive experiments on public datasets demonstrate that our system achieves state-of-the-art performance in both accuracy and efficiency, running at 20 FPS on a consumer GPU.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Yan},
 booktitle = {Proceedings of the 30th {ACM}},
 doi = {10.1145/3637528.3671873},
