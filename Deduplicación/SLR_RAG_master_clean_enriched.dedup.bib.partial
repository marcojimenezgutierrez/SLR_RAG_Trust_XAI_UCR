 year = {2024}
}

@article{wu_medical_2025,
 abstract = {We introduce a novel framework for generating faithful abstractive summaries of open-domain videos, addressing the challenge of maintaining factual accuracy while producing concise and coherent narratives. Our approach leverages a multimodal encoder-decoder architecture that jointly processes visual and textual inputs from videos, incorporating a faithfulness scoring mechanism to penalize hallucinations. Experiments on benchmark datasets demonstrate significant improvements in ROUGE scores and human evaluations of factual consistency compared to existing methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
