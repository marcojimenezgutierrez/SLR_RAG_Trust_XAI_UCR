@inproceedings{yao_news_2024,
 abstract = {Retrieval-augmented generation (RAG) has become a standard paradigm for integrating external knowledge into language generation. However, RAG often retrieves irrelevant documents, leading to suboptimal generation quality. Recent work has proposed to retrieve documents relevant to the query and the output to mitigate this issue. In this work, we show that naively retrieving documents relevant to both the query and the output is insufficient. We propose a simple approach to improve the relevance of retrieved documents by retrieving documents that are relevant to the query and dissimilar to the output. We call this approach Dissimilar Document Retrieval (DDR). DDR is based on the intuition that documents that are relevant to the query but dissimilar to the output are more likely to provide novel information that can improve the generation quality. We evaluate DDR on three question answering datasets and show that it outperforms state-of-the-art RAG methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 1},
 author = {Yao},
 booktitle = {Proceedings of the 2024 3rd {International}},
 doi = {10.1145/3689299.3689320},
 isbn = {979-8-4007-1831-1},
 keywords = {source: ACM},
 note = {event-place: Singapore},
 pages = {113--119},
 publisher = {Association for Computing Machinery},
 series = {{RAIIE}},
 title = {News {GPT}},
 url = {https://doi.org/10.1145/3689299.3689320},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:30:40Z},
 year = {2024}
}

@inproceedings{yao_readme_2024,
 abstract = {Recent advances in large language models (LLMs) have led to the development of long-context models capable of processing thousands of tokens in a single input. However, these models often struggle with faithful abstraction, where they fail to accurately summarize or extract key information from long documents without hallucinating or omitting details. In this work, we introduce a novel framework, Faithful Long-Context Abstraction (FLCA), which combines retrieval-augmented generation with a multi-stage verification process to ensure fidelity in abstractive tasks. Our approach leverages sparse attention mechanisms and contrastive fine-tuning to maintain coherence over extended contexts. Experiments on benchmarks such as LongBench and NarrativeQA demonstrate that FLCA outperforms state-of-the-art models by up to 15% in faithfulness metrics while preserving fluency. We further analyze the impact of context length on abstraction quality, revealing trade-offs that inform future model designs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Yao},
 doi = {10.18653/v1/2024.findings-emnlp.737},
