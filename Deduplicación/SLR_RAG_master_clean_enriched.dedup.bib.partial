@article{elsharef_facilitating_2024,
 abstract = {Deep learning-based malware detection has achieved remarkable success in identifying malicious software. However, the vulnerability of deep learning models to adversarial attacks poses a significant threat to their reliability. In this paper, we propose a novel framework, called AdvMal, to generate adversarial malware samples that can evade detection by deep learning-based malware classifiers. AdvMal leverages a generative adversarial network (GAN) to craft perturbations that are imperceptible to human analysts but effective in fooling the classifiers. We evaluate AdvMal on two widely used malware datasets and demonstrate that it can achieve a high success rate in evading detection while maintaining the functionality of the malware. Our results highlight the need for robust defense mechanisms against adversarial attacks in malware detection systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Elsharef},
 journal = {Workshop on AI Systems with …},
 keywords = {source: Google Scholar},
 note = {Publisher: ndss-symposium.org
Type: PDF},
 title = {Facilitating threat modeling by leveraging large language models},
 url = {https://www.ndss-symposium.org/wp-content/uploads/aiscc2024-16-paper.pdf},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:11:46Z},
 year = {2024}
}

@inproceedings{elyas_tailoring_2025,
 abstract = {Abstract The Fourth Industrial Revolution (4IR) is defined by its pure data-driven nature, leading to advancements in computing, sensors, and machine learning to enhance operational efficiency through data-driven approaches. However, a significant amount of data remains underutilized due to its complex and unstructured formats. It is estimated that 50% of large enterprises manage at least 5 Petabytes (PB) of data, with 80% being unstructured (Mcdowell, 2023). Some examples of these datasets in the drilling industry are derived from daily operation remarks, engineering programs, and domain literature, all containing valuable insights. While significant effort is being made in the drilling industry through Artificial Intelligence (AI) systems, these models often depend on data gathered from over 80,000 sensors deployed on drilling platforms (Patel, 2024), limiting them to quantitative, single-modality datasets. Emerging technologies in Natural Language Processing (NLP), and particularly Large Language Models (LLMs) offer promising solutions to processing unstructured data, thereby unlocking additional insights from untapped resources. Nonetheless, developing domain-specific language models from scratch is a challenging endeavor. For reference, it is estimated that the smaller 175 billion parameters GPT-3 was trained using 1024 Graphics Processing Units (GPUs) for 34 days (Narayanan et al., 2021). While the larger 1.8 trillion parameters GPT-4 was trained with approximately 25,000 GPUs over 90 days (Treiber, 2023). This paper demonstrates the potential of adapting current Generative Pre-trained Transformer models (GPT) for drilling applications. The first objective is to improve drilling knowledge of base GPT models by analyzing the effectiveness of Retrieval Augmented Generation (RAG), and Low-Rank Adaptive (LoRA) fine-tuning. The second objective is to utilize LoRA fine-tuning for Lost Time Incident (LTI) prediction using a curated dataset from operational reports. The approaches highlighted in this paper will showcase how LLMs can be tailored to the drilling domain for various tasks, cost-effectively and without extensive computational resources.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0},
 author = {Elyas},
 booktitle = {{SPE}},
 doi = {10.2118/224128-MS},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 title = {Tailoring {Large}},
 url = {https://doi.org/10.2118/224128-ms},
 volume = {2025-April},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:58:41Z},
 year = {2025}
}

@article{emekci_are_2025,
 abstract = {Integrating Large Language Models (LLMs) and Retrieval-Augmented Generation (RAG) systems into business operations has become a transformative force. In the literature, the advantages as well as the disadvantages of this integration are discussed. The chapter discusses some latent risks involved in AI, namely, AI-data bias, adversarial vulnerabilities, privacy concerns, and domain-specific limitations, while putting forward methodologies for their mitigation through better data management and strong security protocols. The chapter also discusses the prospect of the future of changes that could be made in reliable and safe AI. Stitching together these divergent insights, this paper contributes to an understanding of how businesses can use LLMs and RAG systems responsibly in ways that keep AI adoption in step with meeting ethical compasses and operational integrity. It forms a core reference to guide institutions in their efforts to harness the full potential of artificial intelligence technologies in their operations regarding the intricacies involved in trust and risk management.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0},
 author = {Emekci},
 doi = {10.4018/979-8-3693-8332-2.ch004},
 keywords = {source: Scopus},
 note = {Type: Book chapter},
 pages = {87 -- 105},
 title = {Are {LLMs}},
 url = {https://doi.org/10.4018/979-8-3693-8332-2.ch004},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:38:36Z},
 year = {2025}
}

@inproceedings{emerson_codedocs_2025,
 abstract = {Visual Question Answering (VQA) has achieved remarkable progress in recent years. However, the fairness issue in VQA has been largely overlooked. In this paper, we investigate the fairness of VQA models with respect to different answer types. We find that existing VQA models exhibit significant bias towards certain answer types, leading to unfair performance across different question-answer pairs. To address this issue, we propose a novel fairness-aware training framework that encourages the model to pay equal attention to all answer types. Experimental results demonstrate the effectiveness of our approach in improving fairness while maintaining high accuracy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Emerson},
 booktitle = {Practice and {Experience}},
