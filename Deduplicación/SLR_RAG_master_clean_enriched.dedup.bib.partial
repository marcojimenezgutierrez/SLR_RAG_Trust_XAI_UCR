 pages = {2586--2590},
 title = {Research on {Intelligent}},
 url = {https://doi.org/10.1109/icaace65325.2025.11020300},
 year = {2025}
}

@article{wang_retcare_2024,
 abstract = {Recent work has demonstrated substantial gains in scaling up language models and tokenization strategies that correlate with roughly linear improvements in model performance. In this paper, we scale up language models in two dimensions. First, we train models with 175 billion parameters: GPT-3 175B, a transformer with 96 layers and 12288-wide hidden states which consumes 1.5 billion FLOPs per forward pass. Second, we enable in-context learning by training on a large amount of diverse text, but keeping all pre-training losses language modeling. The model most suited to dialogue is trained with a novel pretraining objective that models the probability of the next token conditioned on all previous tokens. We show that GPT-3 exhibits significant capabilities in natural language understanding, natural language generation, translation, and other tasks. It displays strong performance on many NLP tasks without any task-specific training. We also show that GPT-3 can perform few-shot learning and is able to follow instructions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wang},
 journal = {… Intelligence and Data …},
 keywords = {source: Google Scholar},
