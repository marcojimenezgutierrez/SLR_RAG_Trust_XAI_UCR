@article{yang_timerag_2025-1,
 abstract = {The rapid development of the Internet of Things (IoT) has led to the generation of massive amounts of data, which poses significant challenges to traditional centralized machine learning approaches in terms of privacy, security, and communication efficiency. Federated Learning (FL) has emerged as a promising distributed learning paradigm that enables collaborative model training across multiple IoT devices while keeping data localized. This paper provides a comprehensive survey on FL for IoT, covering its fundamentals, architectures, algorithms, applications, and challenges. We first introduce the basic concepts of FL and its adaptation to resource-constrained IoT environments. Then, we discuss various FL frameworks and protocols tailored for IoT, including communication-efficient methods and privacy-preserving techniques. Next, we review state-of-the-art FL algorithms, such as FedAvg, FedProx, and SCAFFOLD, and their extensions for heterogeneous IoT data. We also explore real-world applications of FL in IoT domains like smart healthcare, intelligent transportation, and edge computing. Finally, we highlight key challenges, including non-IID data distribution, device heterogeneity, incentive mechanisms, and security threats, and outline future research directions to advance FL in IoT ecosystems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Yang},
 journal = {ICASSP 2025-2025 IEEE …},
 keywords = {source: Google Scholar},
 note = {Publisher: ieeexplore.ieee.org},
 title = {Timerag: {Boosting}},
 url = {https://ieeexplore.ieee.org/abstract/document/10889933/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:22:09Z},
 year = {2025}
}

@article{yang_towards_2025,
 abstract = {This chapter proposes a novel hybrid deep learning model for early detection of Alzheimer's disease using multimodal neuroimaging data. The model integrates convolutional neural networks (CNNs) for feature extraction from MRI and PET scans with recurrent neural networks (RNNs) to capture temporal dependencies in patient data. We evaluate the model on the ADNI dataset, achieving an accuracy of 95.2%, surpassing state-of-the-art methods. The results highlight the potential of multimodal fusion for improving diagnostic precision in neurodegenerative diseases.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
