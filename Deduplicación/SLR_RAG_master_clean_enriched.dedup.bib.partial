@inproceedings{shayaninasab_enhancing_2024,
 abstract = {This paper introduces EmoLLM, a novel framework that integrates emotional intelligence into large language models (LLMs) to enhance empathetic dialogue generation. By fine-tuning LLMs with a curated dataset of emotionally annotated conversations, EmoLLM learns to recognize subtle emotional cues in user inputs and respond with contextually appropriate empathy. Our approach leverages multimodal inputs, including text and sentiment analysis from facial expressions, to improve emotional accuracy. Experimental results on benchmark datasets demonstrate that EmoLLM outperforms state-of-the-art models in empathy scores and user satisfaction metrics, paving the way for more human-like AI interactions in mental health support and customer service applications.},
 abstract_lang = {en},
