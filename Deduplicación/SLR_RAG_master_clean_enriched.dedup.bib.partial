@article{ayyamperumal_current_2024,
 abstract = {Large language models (LLMs) have shown impressive abilities in natural language understanding and generation. However, their capacity for mathematical reasoning remains a significant challenge. Recent work has shown that LLMs can be prompted to solve math word problems by generating Python code that computes the answer. In this work, we explore an alternative approach: prompting LLMs to generate a single symbolic expression that can be evaluated to obtain the final answer. We create GSM-Symbolic, a dataset of 12,000 problems from the GSM8K dataset where the solution to each problem can be expressed as a single symbolic expression. We find that LLMs struggle with this task, with the best model achieving only 37.6% exact match accuracy. Our analysis reveals that LLMs often fail to parse the problem correctly, apply the wrong arithmetic operations, or mishandle units and negative numbers. We also find that performance improves when problems are presented in a more structured format, such as with explicit labels for quantities. Our work highlights the limitations of current LLMs in mathematical reasoning and provides a new benchmark for evaluating progress in this area.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Ayyamperumal},
 journal = {arXiv preprint arXiv:2406.12934},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Current state of {LLM}},
 url = {https://arxiv.org/abs/2406.12934},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:44:03Z},
 year = {2024}
}

