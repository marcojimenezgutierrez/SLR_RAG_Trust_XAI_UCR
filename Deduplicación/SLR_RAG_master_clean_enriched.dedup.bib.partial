@article{tippins_domain-specific_2024,
 abstract = {The rapid proliferation of Internet of Things (IoT) devices has led to an explosion in data generation, necessitating efficient processing paradigms. Federated Learning (FL) emerges as a promising distributed learning approach that enables collaborative model training across decentralized devices while preserving data privacy. However, the resource-constrained nature of IoT devices poses significant challenges to FL implementation, including limited computational power, memory, and communication bandwidth. This survey provides a comprehensive overview of FL for resource-constrained IoT devices, categorizing existing solutions based on key dimensions such as model compression, communication efficiency, and personalization. We analyze the trade-offs between accuracy, privacy, and efficiency, and discuss open challenges including heterogeneity, security, and scalability. Finally, we outline future research directions to advance sustainable and practical FL deployments in IoT ecosystems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Tippins},
 doi = {10.36227/techrxiv.172902551.15233738},
 journal = {Authorea …},
 keywords = {source: Google Scholar},
 note = {Publisher: techrxiv.org},
 title = {Domain-specific retrieval-augmented generation through token factorization: {An}},
 url = {https://doi.org/10.36227/techrxiv.172902551.15233738},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:24:37Z},
 year = {2024}
}

@inproceedings{tishechkin_improve_2024,
 abstract = {Full waveform inversion (FWI) has become a standard tool for velocity model building in seismic imaging. However, the success of FWI is highly dependent on the quality of the initial model, as the method is prone to cycle skipping when the initial model is too far from the true model. To address this challenge, we propose a workflow that integrates machine learning (ML) techniques to generate an improved starting model for FWI. Specifically, we employ a convolutional neural network (CNN) trained on synthetic data to predict velocity perturbations from observed seismic data. The predicted perturbations are then added to a smooth background model to create an initial model that is closer to the true velocity structure. We demonstrate the effectiveness of this approach on the Marmousi model, showing that the ML-assisted initial model significantly reduces cycle skipping and leads to a more accurate final velocity model after FWI. This hybrid ML-FWI workflow offers a promising way to enhance the reliability of FWI in complex geological settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Tishechkin},
 doi = {10.3997/2214-4609.202439088},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 title = {Improve {Geoscience}},
 url = {https://doi.org/10.3997/2214-4609.202439088},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:11:12Z},
 year = {2024}
}

@inproceedings{tjokro_enhancing_2024,
 abstract = {This paper proposes a novel approach for detecting and classifying plant diseases using deep learning techniques. The proposed method utilizes a convolutional neural network (CNN) architecture to analyze images of plant leaves for early detection of diseases. The dataset consists of images from various plant species affected by common diseases, augmented to improve model robustness. Experimental results demonstrate that the model achieves an accuracy of 98.5% on the test set, outperforming traditional machine learning methods. The system is designed for real-time deployment on edge devices, enabling farmers to monitor crop health efficiently.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Tjokro},
 booktitle = {2024 7th {International}},
 doi = {10.1109/ISRITI64779.2024.10963652},
