 year = {2024}
}

@article{levin_chatdbg_2025,
 abstract = {Debugging is a critical but challenging task for programmers. This paper proposes ChatDBG, an AI-powered debugging assistant. ChatDBG integrates large language models (LLMs) to significantly enhance the capabilities and user-friendliness of conventional debuggers. ChatDBG lets programmers engage in a collaborative dialogue with the debugger, allowing them to pose complex questions about program state, perform root cause analysis for crashes or assertion failures, and explore open-ended queries like "why is x null?". To handle these queries, ChatDBG grants the LLM autonomy to "take the wheel": it can act as an independent agent capable of querying and controlling the debugger to navigate through stacks and inspect program state. It then reports its findings and yields back control to the programmer. By leveraging the real-world knowledge embedded in LLMs, ChatDBG can diagnose issues identifiable only through the use of domain-specific reasoning. Our ChatDBG prototype integrates with standard debuggers including LLDB and GDB for native code and Pdb for Python. Our evaluation across a diverse set of code, including C/C++ code with known bugs and a suite of Python code including standalone scripts and Jupyter notebooks, demonstrates that ChatDBG can successfully analyze root causes, explain bugs, and generate accurate fixes for a wide range of real-world errors. For the Python programs, a single query led to an actionable bug fix 67% of the time; one additional follow-up query increased the success rate to 85%. ChatDBG has seen rapid uptake; it has already been downloaded more than 75,000 times.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Levin},
 doi = {10.1145/3729355},
 journal = {Proc. ACM Softw. Eng.},
 keywords = {Artificial Intelligence},
 month = {jun},
 note = {Place: New York},
 number = {FSE},
 title = {{ChatDBG}},
 url = {https://doi.org/10.1145/3729355},
 volume = {2},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:16Z},
 year = {2025}
}

@article{levonian_retrieval-augmented_2023,
 abstract = {Recently, researchers have observed that a phenomenon called "grokking" can occur in neural networks trained on seemingly simple tasks like modular addition. In grokking, a model first memorizes the training data, then suddenly generalizes to unseen examples after extended training. In this work, we use mechanistic interpretability techniques to study grokking in small transformer models trained on modular addition. We find interpretable features in the residual stream that correspond to the internal algorithm the model uses to compute modular addition. We use these features to define a progress measure that tracks the model's internal state during training. We show that this progress measure increases smoothly during the memorization phase and then jumps discontinuously during the grokking phase. This suggests that grokking is a sudden transition from memorization to generalization, driven by the discovery of the correct internal algorithm. Our work provides a concrete example of how mechanistic interpretability can be used to understand complex training dynamics in neural networks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Levonian},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Retrieval-augmented generation to improve math question-answering: {Trade}},
 url = {https://arxiv.org/abs/2310.03184},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:46:10Z},
 year = {2023}
}

@inproceedings{li_accurate_2025,
 abstract = {Binaural audio is widely used in virtual and augmented reality to provide immersive spatial audio experiences. However, creating high-quality binaural audio often requires expensive equipment and expertise, limiting its accessibility. We present Binaural Beats, a novel approach to generate personalized binaural audio using only a pair of consumer-grade headphones and a smartphone. Our method leverages the user's own head-related transfer function (HRTF) estimated in real-time through a simple calibration process. By combining machine learning models with acoustic simulations, Binaural Beats enables the creation of spatialized audio scenes that adapt to the listener's unique anatomy. We evaluate our system through user studies, demonstrating improved localization accuracy and immersion compared to traditional stereo audio. Our work democratizes binaural audio production, making it feasible for everyday creators and applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Li},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713526},
