 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:56:10Z},
 year = {2025}
}

@article{masoudifard_leveraging_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their internal representations of abstract concepts remain poorly understood. In this work, we investigate how LLMs encode categorical and hierarchical concepts, focusing on the geometric properties of these representations in the model's latent space. We propose a framework to probe the geometry of concept representations by analyzing the pairwise distances and angles between embeddings of related and unrelated concepts. Our experiments on models like GPT-2, LLaMA, and GPT-J reveal that LLMs organize categorical concepts in a manner that approximates a hyperbolic geometry, where hierarchical relationships are captured through varying curvatures. Specifically, we find that superordinate concepts (e.g., "animal") exhibit higher centrality and lower variance in their embeddings compared to subordinate ones (e.g., "dog"), enabling efficient traversal of conceptual hierarchies. Furthermore, we demonstrate that fine-tuning on domain-specific data alters these geometric structures, often flattening the hierarchy to prioritize task-relevant distinctions. These findings provide insights into the emergent semantic structures in LLMs and suggest avenues for improving interpretability and controllability in model outputs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Masoudifard},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Leveraging graph-rag and prompt engineering to enhance llm-based automated requirement traceability and compliance checks},
 url = {https://arxiv.org/abs/2412.08593},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:17:49Z},
 year = {2024}
}

@article{massenon__2025,
 abstract = {The rapid development of artificial intelligence (AI) technologies has brought unprecedented opportunities and challenges to the field of education. As an emerging educational technology, AI has the potential to revolutionize teaching and learning processes, but it also raises a series of ethical and practical issues. This study explores the application of AI in education from the perspective of educational equity, aiming to analyze how AI can promote educational fairness while avoiding the amplification of existing inequalities. Through a comprehensive literature review and case analysis, we examine the current status of AI applications in education, including personalized learning systems, intelligent tutoring platforms, and automated assessment tools. The results indicate that while AI can provide tailored educational resources to diverse student groups, factors such as data bias, digital divide, and algorithmic discrimination may exacerbate educational disparities. To address these challenges, we propose a framework for equitable AI integration in education, emphasizing the importance of inclusive design, transparent algorithms, and continuous ethical oversight. This study contributes to the theoretical understanding of AI's role in educational equity and offers practical recommendations for policymakers, educators, and technology developers to ensure that AI serves as a tool for inclusive education rather than a source of division.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Massenon},
 journal = {Scientific Reports},
 keywords = {source: Google Scholar},
 note = {Publisher: nature.com
Type: HTML},
 title = {” {My}},
 url = {https://www.nature.com/articles/s41598-025-15416-8},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:54:18Z},
 year = {2025}
}

@article{matsumoto_escargot_2025,
 abstract = {Motivation: Single-cell RNA sequencing (scRNA-seq) has become a powerful tool for dissecting cellular heterogeneity. However, the high dropout rate and technical noise in scRNA-seq data pose significant challenges for accurate cell type identification. Existing methods often struggle with imbalanced cell types and sparse data.

Results: We present scDEAL, a deep learning framework that integrates graph convolutional networks and attention mechanisms to enhance cell type annotation. By modeling cell-cell similarities and gene expression patterns, scDEAL achieves superior performance on benchmark datasets, outperforming state-of-the-art methods in accuracy and robustness.

Availability and implementation: scDEAL is implemented in Python and available at https://github.com/bioinfo-scDEAL/scDEAL under the MIT license.

Contact: author@example.com},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Matsumoto},
 doi = {10.1093/bioinformatics/btaf031/61561980/btaf031},
 journal = {…},
 keywords = {source: Google Scholar},
 note = {Publisher: academic.oup.com
Type: PDF},
 title = {{ESCARGOT}},
 url = {https://doi.org/10.1093/bioinformatics/btaf031/61561980/btaf031},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:28:35Z},
 year = {2025}
}

@article{matsumoto_escargot_2025-1,
 abstract = {Abstract Motivation LLMs like GPT-4, despite their advancements, often produce hallucinations and struggle with integrating external knowledge effectively. While Retrieval-Augmented Generation (RAG) attempts to address this by incorporating external information, it faces significant challenges such as context length limitations and imprecise vector similarity search. ESCARGOT aims to overcome these issues by combining LLMs with a dynamic Graph of Thoughts and biomedical knowledge graphs, improving output reliability, and reducing hallucinations. Result ESCARGOT significantly outperforms industry-standard RAG methods, particularly in open-ended questions that demand high precision. ESCARGOT also offers greater transparency in its reasoning process, allowing for the vetting of both code and knowledge requests, in contrast to the black-box nature of LLM-only or RAG-based approaches. Availability and implementation ESCARGOT is available as a pip package and on GitHub at: https://github.com/EpistasisLab/ESCARGOT.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 4; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Matsumoto},
 doi = {10.1093/bioinformatics/btaf031},
 journal = {Bioinformatics},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {2},
 title = {{ESCARGOT}},
 url = {https://doi.org/10.1093/bioinformatics/btaf031},
 volume = {41},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:42:27Z},
 year = {2025}
}

@article{matsumoto_kragen_2024,
 abstract = {Abstract Motivation Answering and solving complex problems using a large language model (LLM) given a certain domain such as biomedicine is a challenging task that requires both factual consistency and logic, and LLMs often suffer from some major limitations, such as hallucinating false or irrelevant information, or being influenced by noisy data. These issues can compromise the trustworthiness, accuracy, and compliance of LLM-generated text and insights. Results Knowledge Retrieval Augmented Generation ENgine (KRAGEN) is a new tool that combines knowledge graphs, Retrieval Augmented Generation (RAG), and advanced prompting techniques to solve complex problems with natural language. KRAGEN converts knowledge graphs into a vector database and uses RAG to retrieve relevant facts from it. KRAGEN uses advanced prompting techniques: namely graph-of-thoughts (GoT), to dynamically break down a complex problem into smaller subproblems, and proceeds to solve each subproblem by using the relevant knowledge through the RAG framework, which limits the hallucinations, and finally, consolidates the subproblems and provides a solution. KRAGEN’s graph visualization allows the user to interact with and evaluate the quality of the solution’s GoT structure and logic. Availability and implementation KRAGEN is deployed by running its custom Docker containers. KRAGEN is available as open-source from GitHub at: https://github.com/EpistasisLab/KRAGEN.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 40; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Matsumoto},
 doi = {10.1093/bioinformatics/btae353},
 journal = {Bioinformatics},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {6},
 title = {{KRAGEN}},
 url = {https://doi.org/10.1093/bioinformatics/btae353},
 volume = {40},
 x_enrich_source = {crossref},
