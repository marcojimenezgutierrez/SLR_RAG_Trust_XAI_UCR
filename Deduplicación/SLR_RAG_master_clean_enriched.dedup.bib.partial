@inproceedings{liu_can_2024,
 abstract = {Despite the remarkable success of vision-language models (VLMs) in various downstream tasks, they often inherit and amplify societal biases from their training data, leading to unfair and harmful predictions. Existing debiasing methods for VLMs are limited in scope, focusing primarily on specific bias types or relying on costly retraining. In this paper, we propose a novel debiasing framework, Biased Prompt Debiasing (BPD), which leverages the power of prompts to mitigate biases in VLMs without requiring model retraining. BPD consists of two key components: (1) Bias Identification, which systematically identifies biased prompts by analyzing the model's internal representations, and (2) Counterfactual Prompt Generation, which generates counterfactual prompts to counteract identified biases. We evaluate BPD on multiple VLMs and bias-sensitive tasks, demonstrating significant improvements in fairness metrics while maintaining overall performance. Our approach offers a scalable, efficient, and generalizable solution to bias mitigation in VLMs.},
