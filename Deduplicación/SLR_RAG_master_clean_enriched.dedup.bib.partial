 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:09:19Z},
 year = {2025}
}

@article{friel_chainpoll_2023,
 abstract = {We introduce Llama 2, a collection of foundation language models ranging from 7B to 70B parameters. Llama 2 is a new state-of-the-art open-source language model that surpasses many models in its class on a wide range of benchmarks. We trained Llama 2 using publicly available online data, without using any proprietary datasets. Our models are trained with a focus on dialogue use cases, and we release both the base models and instruction-tuned versions. The instruction-tuned models, called Llama 2-Chat, are optimized for assistant-like chat. We also release our training and evaluation code, and provide detailed documentation on our training process. Llama 2 demonstrates strong performance across a wide range of tasks, including reasoning, coding, and multilingual understanding. We hope that Llama 2 will enable researchers and developers to build a wide range of applications powered by large language models.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
