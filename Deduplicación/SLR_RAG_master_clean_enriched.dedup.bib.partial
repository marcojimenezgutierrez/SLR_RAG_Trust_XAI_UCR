@inproceedings{qiu_simplifying_2023,
 abstract = {Visual programming languages (VPLs) promise to make programming more accessible, but their adoption for data science tasks remains limited. We explore the design space of VPLs for interactive data processing through a systematic analysis of existing tools and a series of design studies. We identify key challenges, including expressiveness for complex data transformations, support for iteration and conditionals, and integration with visualization. Based on these insights, we propose a framework for designing VPLs that balance simplicity and power, featuring modular blocks for data manipulation, visual feedback for debugging, and extensibility for custom operations. We implemented a prototype and evaluated it with 24 participants, finding significant improvements in task completion time and user satisfaction compared to text-based alternatives like Python with Pandas. Our work provides guidelines for future VPL development and highlights opportunities for AI-assisted visual programming in data science.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
