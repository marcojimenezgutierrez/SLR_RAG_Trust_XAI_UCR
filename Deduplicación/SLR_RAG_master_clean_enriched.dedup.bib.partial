@article{finardi_chronicles_2024,
 abstract = {We study how vision-language models (VLM) can be trained on both vision-language tasks and vision-language-action tasks to transfer web knowledge to robotic control. Our approach, which we call RT-2 (Robotics Transformer 2), leverages a mixture of web-scale vision-language data and robotics data to train a VLA model. RT-2 is trained on a large-scale dataset of web images and videos paired with text, as well as robotics trajectories. We evaluate RT-2 on a diverse set of robotic tasks, including novel tasks that require reasoning, such as interpreting language, acquiring skills, and performing basic arithmetic. RT-2 shows improved generalization to novel objects and novel environments, and can be fine-tuned to achieve strong performance on a new set of tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
