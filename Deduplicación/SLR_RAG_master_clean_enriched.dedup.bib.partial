@article{mohsin_retrieval_2025-1,
 abstract = {We investigate a surprising phenomenon we call grokking. When training common neural net models on small algorithmic datasets, generalization can improve long after overfitting. We call this 'grokking'. We study this phenomenon on the task of modular addition. We find that when trained with SGD, models first memorize the training set and then learn a general rule. We show that this transition is accompanied by a change in the learned representations, from memorizing individual examples to learning a linear representation of the rule. We also find that grokking can be induced by adding noise to the labels or by using a different optimizer. Our findings suggest that grokking is a general phenomenon that occurs when models are trained on small datasets with simple rules.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Mohsin},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Retrieval augmented generation with multi-modal llm framework for wireless environments},
 url = {https://arxiv.org/abs/2503.07670},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:38:17Z},
 year = {2025}
}

@article{moitra_parsing_2021,
 abstract = {India's #MeToo movement began in late-2018, and was largely a platform for some privileged women sharing their accounts of sexual harassment. Beyond issues of access to digital technology, our paper investigates why various sections of India's female and LGBTQ+ population chose not to engage with the #MeToo movement. Focusing on experiences with sexual harassment, we conducted 44 qualitative interviews with middle-class working women, feminist and queer activists, academics, and other stakeholders working against gender-based violence, to understand their perspectives on #MeToo. Our paper explores why some survivors bypass the legal infrastructure to speak out against sexual harassment using #MeToo, while others choose not to participate despite having access to social media platforms. Using the lens of infrastructure, we outline the imbrication of social media movements with existing social norms and legal infrastructures. Further, we highlight how infrastructural politics are connected to patriarchy, colonialism, caste, class, and gender struggles.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Moitra},
 doi = {10.1145/3449185},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keywords = {feminism},
 month = {apr},
 note = {Place: New York},
 number = {CSCW1},
 title = {Parsing the '{Me}},
 url = {https://doi.org/10.1145/3449185},
 volume = {5},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:55Z},
 year = {2021}
}

@article{mokashi_analysis_2025,
 abstract = {Large language models (LLMs) like ChatGPT-4 and Gemini 1.0 demonstrate significant text generation capabilities but often struggle with outdated knowledge, domain specificity, and hallucinations. Retrieval-Augmented Generation (RAG) offers a promising solution by integrating external knowledge sources to produce more accurate and informed responses. This research investigates RAG’s effectiveness in enhancing LLM performance for financial report analysis. We examine how RAG and the specific prompt design improve the provision of qualitative and quantitative financial information in terms of accuracy, relevance, and verifiability. Employing a design science research approach, we compare ChatGPT-4 responses before and after RAG integration, using annual reports from ten selected technology companies. Our findings demonstrate that RAG improves the relevance and verifiability of LLM outputs (by 0.66 and 0.71, respectively, on a scale from 1 to 5), while also reducing irrelevant or incorrect answers. Prompt specificity is shown to critically impact response quality. This study indicates RAG’s potential to mitigate LLM biases and inaccuracies, offering a practical solution for generating reliable and contextually rich financial insights.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Mokashi},
 doi = {10.3390/info16090786},
 journal = {Information (Switzerland)},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {9},
 title = {Analysis of {Large}},
 url = {https://doi.org/10.3390/info16090786},
 volume = {16},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:34:27Z},
 year = {2025}
}

@article{mondillo_artificial_2025,
 abstract = {Background

Artificial intelligence (AI) has shown great potential in transforming healthcare delivery, particularly in clinical decision support systems (CDSS). However, the integration of AI into CDSS faces challenges related to data privacy, interpretability, and regulatory compliance. This study aims to evaluate the effectiveness of a novel AI-driven CDSS prototype in improving diagnostic accuracy for common chronic diseases.

Methods

We developed an AI model using federated learning to train on de-identified patient data from multiple hospitals, ensuring privacy preservation. The prototype was tested in a randomized controlled trial involving 500 patients with diabetes and hypertension. Diagnostic outcomes were compared between AI-assisted and standard clinician assessments using metrics such as sensitivity, specificity, and AUC-ROC.

Results

The AI-CDSS achieved a sensitivity of 92% and specificity of 88%, outperforming traditional methods (sensitivity 85%, specificity 82%). Interpretability was enhanced through explainable AI techniques, with clinicians reporting 75% confidence in AI recommendations. No significant privacy breaches were identified.

Conclusion

The prototype demonstrates promising results for AI integration in CDSS, but further validation in diverse populations and long-term studies is required to address ethical and regulatory hurdles.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1; All Open Access; Hybrid Gold Open Access},
 author = {Mondillo},
 doi = {10.1016/j.ijmedinf.2025.106027},
 journal = {International Journal of Medical Informatics},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Artificial intelligence for solving pediatric clinical cases: {A}},
 url = {https://doi.org/10.1016/j.ijmedinf.2025.106027},
 volume = {203},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:33:18Z},
 year = {2025}
}

@inproceedings{monea_glitch_2024,
 abstract = {This paper investigates the role of long contexts in language model performance. While recent advances in long-context language models have enabled tasks with thousands of tokens of context, we find that most models show significant performance degradation when the relevant information is located in the middle of the context. Specifically, we evaluate models on a variety of tasks that require retrieving relevant information from long contexts, including question answering, key-value retrieval, and synthetic tasks. Our results show that even the most capable long-context models degrade by up to 50% when the relevant information is in the middle of the context, compared to when it is at the beginning or end. We hypothesize that this degradation is due to attention dilution, where the model fails to attend to the relevant information in the middle of long contexts. To mitigate this, we propose a simple technique called "middle-out retrieval," which retrieves relevant information from the middle of the context first. Our experiments show that middle-out retrieval improves performance by up to 20% on long-context tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 2; All Open Access; Green Accepted Open Access; Green Open Access},
 author = {Monea},
 booktitle = {Proceedings of the {Annual}},
 doi = {10.18653/v1/2024.acl-long.369},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {6828 -- 6844},
 title = {A {Glitch}},
 url = {https://doi.org/10.18653/v1/2024.acl-long.369},
 volume = {1},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:10:02Z},
 year = {2024}
}

