@inproceedings{armant_can_2024,
 abstract = {The rapid development of artificial intelligence (AI) technologies has significantly impacted various sectors, including education. This study explores the integration of AI in higher education, focusing on personalized learning systems. Using a mixed-methods approach, we surveyed 500 students and conducted interviews with 20 educators across three universities. Findings reveal that AI-driven adaptive learning platforms enhance student engagement by 35% and improve learning outcomes in STEM courses. However, challenges such as data privacy concerns and algorithmic bias persist. We propose a framework for ethical AI implementation in academia to balance innovation with inclusivity.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Armant},
 booktitle = {{CEUR}},
 keywords = {source: Scopus},
