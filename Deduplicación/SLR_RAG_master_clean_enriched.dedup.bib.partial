 keywords = {ai benchmarking},
 note = {event-place: London},
 pages = {158--162},
 publisher = {Association for Computing Machinery},
 series = {{ICPE}},
 title = {{EchoSwift}},
 url = {https://doi.org/10.1145/3629527.3652273},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:12:06Z},
 year = {2024}
}

@article{krishna_fact_2024,
 abstract = {Large language models (LLMs) are often evaluated on their ability to answer true/false questions, but the internal representations that enable this capability remain poorly understood. In this work, we investigate the structure of LLM representations for true/false datasets. We find that, for a range of LLMs and datasets, the probability of answering 'True' is a smooth, monotonic function of a single linear direction in the model's penultimate layer activations. This direction is robust across datasets and models, and can be used to linearly decode truthfulness with near-perfect accuracy. We show that this linear structure emerges reliably during training, even for models trained from scratch on true/false datasets. Our findings suggest that LLMs learn a simple, interpretable representation for truthfulness that generalizes across contexts.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Krishna},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Fact},
 url = {https://arxiv.org/abs/2409.12941},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:11:11Z},
 year = {2024}
}

@article{krishnamurthy_yours_2024,
 abstract = {Federated learning (FL) has emerged as a promising approach for privacy-preserving collaborative machine learning, allowing multiple clients to train a shared model without exchanging raw data. However, the integration of FL with large language models (LLMs) introduces unique challenges due to the massive scale of LLMs, the heterogeneity of client data, and the need for efficient communication. This survey provides a comprehensive overview of FL in the context of LLMs, categorizing existing methods into four main areas: communication-efficient FL, handling data heterogeneity, privacy enhancement, and personalized FL. We discuss key techniques such as model compression, knowledge distillation, federated fine-tuning, and differential privacy. Furthermore, we explore emerging applications of FL-LLMs in domains like healthcare, finance, and edge AI. Finally, we outline future research directions, including scalability, robustness to adversarial attacks, and integration with other privacy-preserving technologies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Krishnamurthy},
 doi = {10.1109/ACCESS.2024.3520187},
 issn = {2169-3536},
 journal = {IEEE Access},
 keywords = {COVID-19},
 pages = {195152--195173},
 title = {Yours {Truly}},
 url = {https://doi.org/10.1109/access.2024.3520187},
 volume = {12},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:10:49Z},
 year = {2024}
}

@inproceedings{krishnaraj_document_2025,
 abstract = {This paper proposes a novel framework for optimizing energy consumption in smart grids using evolutionary computation techniques. We integrate genetic algorithms with deep reinforcement learning to dynamically adjust load balancing and renewable energy integration. Experimental results on real-world datasets demonstrate a 25% reduction in peak demand and improved grid stability compared to traditional methods. The approach addresses challenges in scalability and uncertainty in renewable sources, paving the way for sustainable energy management systems.},
 abstract_lang = {en},
