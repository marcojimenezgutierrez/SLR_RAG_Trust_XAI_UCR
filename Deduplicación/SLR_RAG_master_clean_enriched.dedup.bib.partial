@inproceedings{cahoon_optimizing_2025,
 abstract = {Visual question answering (VQA) models often rely on superficial cues in the image, leading to biased predictions. Existing debiasing methods typically require expensive human annotations to identify biases, which is impractical for real-world applications. In this paper, we propose a novel approach to debias VQA models without human intervention. Our method leverages the inherent structure of the VQA dataset to automatically detect and mitigate biases. Specifically, we introduce a bias detection module that identifies spurious correlations between image features and answers using counterfactual reasoning. We then employ a debiasing training strategy that encourages the model to focus on relevant visual evidence. Experiments on benchmark datasets like VQA-CP and VQA-E demonstrate that our approach significantly improves robustness and fairness, outperforming state-of-the-art methods while maintaining high accuracy on in-distribution data.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Cahoon},
 booktitle = {Proceedings of the 1st {Workshop}},
 doi = {10.1145/3737412.3743489},
