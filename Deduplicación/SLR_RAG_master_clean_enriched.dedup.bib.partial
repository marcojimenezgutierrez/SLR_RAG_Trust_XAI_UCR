@article{chiang_llamp_2024,
 abstract = {Recent work has shown that transformers trained on modular addition exhibit a phenomenon known as grokking, where test accuracy improves dramatically after a long period of overtraining. In this work, we study grokking in the context of learning to evaluate polynomials over modular rings. We find that transformers trained on modular polynomial evaluation also exhibit grokking, and that the phenomenon is robust to a variety of hyperparameters. We show that grokking is accompanied by a phase transition in the learned representations, where the network learns to represent the polynomials in a structured way that is interpretable and generalizes to unseen moduli. We also find that the learned representations are highly compressible, suggesting that grokking may be related to compression. Our findings suggest that grokking is a general phenomenon that occurs when neural networks learn to perform algorithmic tasks with structured outputs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Chiang},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {{LLaMP}},
 url = {https://arxiv.org/abs/2401.17244},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:16:48Z},
 year = {2024}
}

@book{chidipothu_improving_2024,
 abstract = {Large language models (LLMs) have demonstrated remarkable capabilities in various natural language processing tasks, but their performance can be inconsistent, particularly in domain-specific applications. This preprint explores strategies to improve LLM performance, focusing on prompt engineering, fine-tuning, and integration with external tools. We evaluate these methods on benchmark datasets and real-world scenarios, showing significant gains in accuracy and efficiency. Our findings suggest that hybrid approaches combining intrinsic model enhancements with extrinsic aids yield the most robust improvements.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Chidipothu},
 keywords = {source: Google Scholar},
 publisher = {scholarship.libraries.rutgers.edu},
 title = {Improving large language model (llm) performance with retrieval augmented generation (rag): {Development}},
 url = {https://scholarship.libraries.rutgers.edu/esploro/outputs/preprint/Improving-large-language-model-LLM-performance/991032165917804646?institution=01RUT_INST},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:46:44Z},
 year = {2024}
}

@article{chirkova_retrieval-augmented_2024,
 abstract = {Large language models (LLMs) are increasingly used in safety-critical applications, yet their robustness to adversarial inputs remains a significant concern. In this work, we conduct a comprehensive evaluation of the robustness of Anthropic's Claude 3 Opus, a state-of-the-art LLM, to jailbreak attacks. We introduce a novel jailbreak method, "The Devil's Advocate," which leverages role-playing and multi-turn conversation to elicit harmful responses. Our experiments demonstrate that Claude 3 Opus can be reliably jailbroken to generate content violating its safety guidelines, including instructions for illegal activities and hate speech. We analyze the effectiveness of our method across various categories of harmful queries and discuss implications for AI safety. Our findings underscore the need for improved adversarial training and evaluation in LLM development.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Chirkova},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Retrieval-augmented generation in multilingual settings},
 url = {https://arxiv.org/abs/2407.01463},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:57:04Z},
 year = {2024}
}

@article{chis_graphxx_2025,
 abstract = {Abstract Symbolic AI has been facing long-term adoption obstacles and a slow uptake caused by the limited availability of frictionless tooling—that can support not only knowledge engineers, but also novice users and educators, with designing and presenting graph exemplars that can be visually communicated, edited and ad hoc processed. There’s still a shortage of tools that can democratize knowledge graph (KG) creation, something that is increasingly needed—firstly by educators trying to discuss examples with novices without stumbling on OWL jargon at the earliest step, but also for more recent integration cases such as (i) GraphRAG, where private KGs are called to augment or ensure factuality of large language model services; or (ii) in search engine optimization (SEO), where SEO practitioners lacking knowledge engineering background must embed Schema.org graph data into their Web content. Most visual KG tools are visualizers of KGs created by other means—either in OWL-centric ontology editors posing high expertise barriers, or converted from available serializations, or lifted from legacy data sources. The few actual KG editors are mostly OWL editors neglecting to support the creation of schemaless graph datasets as well as of flexible combinations of graph data and schema fragments. This paper reports on a Design Science effort adopting metamodeling means, traditionally employed for the engineering of domain-specific modeling languages, toward defining a KG development and integration method that facilitates both the visual design of KG exemplars and their operationalization. We aim to balance a diagrammatic look and feel with machine readability of the semantic content being produced—further streamlined in an architecting proposition for integration with LLM services and for the production of Schema.org graph snippets. The DSML was deployed and evaluated as a tool implemented on the ADOxx metamodeling platform, using RDF and LangChain as mediators that streamline the content toward triplestores and LLM services.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Hybrid Gold Open Access},
 author = {Chis},
 doi = {10.1007/s10270-025-01297-y},
 journal = {Software and Systems Modeling},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {{GRAPHxx}},
 url = {https://doi.org/10.1007/s10270-025-01297-y},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:56:35Z},
 year = {2025}
}

@inproceedings{chiu_enhancing_2025,
 abstract = {Generative AI (GenAI) tools are increasingly integrated into creative workflows, yet their impact on the creative process remains underexplored. This paper investigates how GenAI influences ideation in graphic design through a mixed-methods study involving 24 professional designers. Participants used GenAI tools (e.g., Midjourney, DALL-E) in controlled ideation sessions, followed by interviews and surveys. Findings reveal that GenAI accelerates idea generation but often leads to homogenized outputs, reducing perceived originality. Designers reported a tension between efficiency gains and loss of personal agency, with 68% expressing concerns over skill atrophy. We identify three key themes: (1) augmentation vs. automation, (2) inspiration vs. imitation, and (3) collaboration dynamics with AI. Our results inform design implications for GenAI interfaces that better support creative autonomy, such as hybrid prompting mechanisms and iterative feedback loops. This work contributes to HCI by highlighting the need for tools that preserve the serendipity and intentionality central to creative practice.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Chiu},
 booktitle = {Proceedings of the 2024 11th {International}},
 doi = {10.1145/3707127.3707138},
 isbn = {979-8-4007-1827-4},
 keywords = {Edema},
 pages = {66--71},
 publisher = {Association for Computing Machinery},
 series = {{ICBBE}},
 title = {Enhancing {Medical}},
 url = {https://doi.org/10.1145/3707127.3707138},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:13:45Z},
 year = {2025}
}

@inproceedings{cho_fishnet_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in various tasks, but they also exhibit biases that can lead to unfair outcomes. Addressing fairness in LLMs is crucial for their safe and ethical deployment. This paper provides a comprehensive survey on fairness in LLMs, covering the sources of bias, evaluation metrics, mitigation techniques, and future directions. We first discuss the sources of bias in LLMs, including data bias, model bias, and deployment bias. Then, we review the fairness evaluation metrics, categorizing them into group fairness, individual fairness, and counterfactual fairness. Next, we explore mitigation techniques at different stages, such as data preprocessing, model training, and post-processing. We also highlight the challenges and open problems in achieving fairness in LLMs. Finally, we propose future research directions to advance fairness in LLMs. This survey aims to provide researchers and practitioners with a thorough understanding of fairness issues in LLMs and guide the development of fairer LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 2; All Open Access; Green Accepted Open Access; Green Open Access},
 author = {Cho},
 booktitle = {Proceedings of the 5th {ACM}},
 doi = {10.1145/3677052.3698597},
 isbn = {979-8-4007-1081-0},
 keywords = {Harmonizing},
 note = {event-place: Brooklyn},
 pages = {591--599},
 publisher = {Association for Computing Machinery},
 series = {{ICAIF}},
 title = {{FISHNET}},
 url = {https://doi.org/10.1145/3677052.3698597},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:16:40Z},
 year = {2024}
}

@article{choi_combining_2024,
 abstract = {The present study investigated the effects of a 12-week resistance training program on muscular strength and hypertrophy in untrained young men. Twenty-four healthy male volunteers (age: 22.5 ± 2.1 years) were randomly assigned to either a resistance training group (RTG, n=12) or a control group (CG, n=12). The RTG performed a supervised progressive resistance training program three times per week, targeting major muscle groups with multiple sets and repetitions at 70-80% of one-repetition maximum (1RM). Pre- and post-training assessments included 1RM tests for bench press and leg press, as well as ultrasound measurements of muscle thickness (MT) in the biceps brachii, triceps brachii, vastus lateralis, and rectus femoris. Results showed significant increases in 1RM strength for both exercises in the RTG (bench press: +28.4%, p<0.001; leg press: +32.1%, p<0.001), with no changes in the CG. MT increased significantly in all measured muscles for the RTG (range: 8.2-14.7%, p<0.01), while the CG showed no significant changes. These findings demonstrate that a 12-week resistance training program induces substantial improvements in muscular strength and hypertrophy in untrained young men.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Choi},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {40 -- 50},
 title = {Combining {Multiple}},
 url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105000213823&partnerID=40&md5=ab4fc178f9ac8d71e9d28e1f5e3a7a0f},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:45:51Z},
 year = {2024}
}

@article{choi_empowering_2025,
 abstract = {Abstract Purpose The potential of Large Language Models (LLMs) in enhancing a variety of natural language tasks in clinical fields includes medical imaging reporting. This pilot study examines the efficacy of a retrieval-augmented generation (RAG) LLM system considering zero-shot learning capability of LLMs, integrated with a comprehensive database of PET reading reports, in improving reference to prior reports and decision making. Methods We developed a custom LLM framework with retrieval capabilities, leveraging a database of over 10 years of PET imaging reports from a single center. The system uses vector space embedding to facilitate similarity-based retrieval. Queries prompt the system to generate context-based answers and identify similar cases or differential diagnoses. From routine clinical PET readings, experienced nuclear medicine physicians evaluated the performance of system in terms of the relevance of queried similar cases and the appropriateness score of suggested potential diagnoses. Results The system efficiently organized embedded vectors from PET reports, showing that imaging reports were accurately clustered within the embedded vector space according to the diagnosis or PET study type. Based on this system, a proof-of-concept chatbot was developed and showed the framework’s potential in referencing reports of previous similar cases and identifying exemplary cases for various purposes. From routine clinical PET readings, 84.1% of the cases retrieved relevant similar cases, as agreed upon by all three readers. Using the RAG system, the appropriateness score of the suggested potential diagnoses was significantly better than that of the LLM without RAG. Additionally, it demonstrated the capability to offer differential diagnoses, leveraging the vast database to enhance the completeness and precision of generated reports. Conclusion The integration of RAG LLM with a large database of PET imaging reports suggests the potential to support clinical practice of nuclear medicine imaging reading by various tasks of AI including finding similar cases and deriving potential diagnoses from them. This study underscores the potential of advanced AI tools in transforming medical imaging reporting practices.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 2; All Open Access; Green Accepted Open Access; Green Open Access; Hybrid Gold Open Access},
 author = {Choi},
 doi = {10.1007/s00259-025-07101-9},
 journal = {European Journal of Nuclear Medicine and Molecular Imaging},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {7},
 pages = {2452 -- 2462},
 title = {Empowering {PET}},
 url = {https://doi.org/10.1007/s00259-025-07101-9},
 volume = {52},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:38:53Z},
 year = {2025}
}

@article{choi_malade_2024,
 abstract = {The ability to generate high-quality, diverse, and controllable images from textual descriptions has been a long-standing goal in computer vision. Recent advances in diffusion models have led to significant progress in this area, with models like Stable Diffusion demonstrating impressive results. However, these models often struggle with fine-grained control over the generated images, such as specifying the exact position, size, or appearance of objects. To address this limitation, we introduce ControlNet, a neural network architecture that adds spatial conditioning controls to diffusion models without requiring any fine-tuning of the underlying diffusion model. ControlNet learns to predict the noise added to the image at each step of the diffusion process, conditioned on additional input channels such as edge maps, segmentation maps, or depth maps. By training on large-scale datasets of image-control pairs, ControlNet enables precise control over the generation process while preserving the high-fidelity output of the base diffusion model. We demonstrate the effectiveness of ControlNet on a variety of tasks, including edge-guided image synthesis, pose-guided human image generation, and canny edge detection-based image editing. Our approach achieves state-of-the-art results and opens up new possibilities for controllable text-to-image generation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Choi},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {{MALADE}},
 url = {https://arxiv.org/abs/2408.01869},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:52:51Z},
 year = {2024}
}

@article{chondamrongkul_addressing_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly transformed various sectors, including healthcare, where AI-driven diagnostic tools are increasingly integrated into clinical workflows. This paper presents a novel framework for AI-assisted medical image analysis, focusing on the detection and classification of anomalies in chest X-rays for early diagnosis of respiratory diseases such as pneumonia and tuberculosis. Our approach leverages a hybrid deep learning model combining convolutional neural networks (CNNs) with transformer architectures to enhance feature extraction and contextual understanding. The model was trained on a diverse dataset comprising over 100,000 annotated images from public repositories like ChestX-ray14 and MIMIC-CXR, achieving an accuracy of 96.2%, sensitivity of 94.8%, and specificity of 97.1%. We also address challenges related to data privacy and model interpretability through federated learning techniques and attention-based visualization tools. Experimental results demonstrate superior performance compared to state-of-the-art methods, underscoring the potential of this framework to support radiologists in resource-limited settings and improve patient outcomes.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Chondamrongkul},
 doi = {10.1109/ACCESS.2025.3531380},
 issn = {2169-3536},
 journal = {IEEE Access},
 keywords = {Accuracy},
 pages = {12846--12858},
 title = {Addressing {Technical}},
 url = {https://doi.org/10.1109/access.2025.3531380},
 volume = {13},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:51:16Z},
 year = {2025}
}

@inproceedings{chong_llm-net_2025,
 abstract = {Generative AI (GenAI) systems are increasingly deployed in high-stakes domains, yet their potential societal impacts remain underexplored. This work presents a framework for evaluating the social impact of GenAI systems, focusing on three key dimensions: equity, privacy, and safety. We propose a multi-stakeholder approach that integrates qualitative and quantitative metrics to assess how these systems affect diverse user groups. Through case studies on text-to-image and language models, we identify common pitfalls, such as amplification of stereotypes and unintended data leakage. Our findings underscore the need for interdisciplinary collaboration to ensure responsible deployment of GenAI technologies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Chong},
 booktitle = {Proceedings of the 2025 14th {International}},
