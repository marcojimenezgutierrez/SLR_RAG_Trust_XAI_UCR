 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:40:25Z},
 year = {2024}
}

@inproceedings{mei-seung_navigating_2024,
 abstract = {Visual question answering (VQA) has achieved remarkable progress with the development of large vision-language models (LVLMs). However, recent studies have revealed that LVLMs suffer from severe position bias in VQA, where the model overly relies on the position of the answer options rather than the image content. This bias leads to unreliable performance in real-world applications. Existing debiasing methods mainly focus on training a visual reasoning model to generate unbiased visual features, which requires additional training costs and may not be applicable to black-box LVLMs. In this paper, we propose a simple yet effective inference-time debiasing method, called Position-Biased Option Repositioning (PBOR), to mitigate position bias in LVLMs for VQA. Specifically, PBOR first estimates the position bias of each answer option by prompting the LVLMs to answer the question with the options in different positions. Then, PBOR repositions the options with high position bias to less biased positions to reduce the impact of position bias. Extensive experiments on multiple VQA datasets demonstrate the effectiveness of PBOR in mitigating position bias and improving the robustness of LVLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Mei-seung},
 booktitle = {Proceedings of the 2024 10th {International}},
 doi = {10.1145/3678610.3678630},
 isbn = {979-8-4007-1679-9},
 keywords = {source: ACM},
 pages = {76--81},
 publisher = {Association for Computing Machinery},
 series = {{ICSLT}},
 title = {Navigating the “{Cooked}},
 url = {https://doi.org/10.1145/3678610.3678630},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:51:00Z},
 year = {2024}
}

@article{mei_survey_2025,
 abstract = {The increasing availability of large-scale, diverse datasets has enabled the development of foundation models that exhibit remarkable generalization capabilities across a wide range of downstream tasks. However, these models often struggle with tasks requiring precise spatial reasoning and physical understanding, such as robotic manipulation. To address this gap, we introduce RoboFlamingo, a novel approach that leverages a vision-language model (VLM) to generate natural language descriptions of visual observations, which are then used to condition a pre-trained language model for action prediction. By combining the strengths of VLMs for high-level planning with language models for low-level control, RoboFlamingo achieves state-of-the-art performance on several robotic manipulation benchmarks, including simulated and real-world tasks. Our method demonstrates improved sample efficiency and robustness to distribution shifts, paving the way for more generalist robotic policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Mei},
 journal = {arXiv preprint arXiv:2504.08748},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {A survey of multimodal retrieval-augmented generation},
 url = {https://arxiv.org/abs/2504.08748},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:23:21Z},
 year = {2025}
}

@misc{melton_evaluating_2025,
 abstract = {Applications of generative Large Language Models LLMs are rapidly expanding across various domains, promising significant improvements in workflow efficiency and information retrieval. However, their implementation in specialized, high-stakes domains such as hazardous materials transportation is challenging due to accuracy and reliability concerns. This study evaluates the performance of three fine-tuned generative models, ChatGPT, Google's Vertex AI, and ORNL Retrieval Augmented Generation augmented LLaMA 2 and LLaMA in retrieving regulatory information essential for hazardous material transportation compliance in the United States. Utilizing approximately 40 publicly available federal and state regulatory documents, we developed 100 realistic queries relevant to route planning and permitting requirements. Responses were qualitatively rated based on accuracy, detail, and relevance, complemented by quantitative assessments of semantic similarity between model outputs. Results demonstrated that the RAG-augmented LLaMA models significantly outperformed Vertex AI and ChatGPT, providing more detailed and generally accurate information, despite occasional inconsistencies. This research introduces the first known application of RAG in transportation safety, emphasizing the need for domain-specific fine-tuning and rigorous evaluation methodologies to ensure reliability and minimize the risk of inaccuracies in high-stakes environments.},
 abstract_lang = {en},
 abstract_source = {doi-json},
 annote = {Comment: 14 pages},
 author = {Melton},
 doi = {10.48550/arXiv.2504.07022},
 file = {Preprint PDF:C\:\\Users\\Marco\\Zotero\\storage\\L2IQY7LP\\Melton et al. - 2025 - Evaluating Retrieval Augmented Generative Models for Document Queries in Transportation Safety.pdf:application/pdf},
 keywords = {source: Arxiv},
 month = {apr},
 note = {arXiv:2504.07022 [cs]},
 publisher = {arXiv},
 title = {Evaluating {Retrieval}},
 url = {https://doi.org/10.48550/arxiv.2504.07022},
