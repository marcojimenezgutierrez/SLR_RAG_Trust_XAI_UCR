@inproceedings{signe_substring_2025,
 abstract = {We present Amodal 3D Gaussian Splatting (A3DGS), a novel method for reconstructing complete 3D shapes from partial observations, enabling amodal perception in novel view synthesis. Unlike existing methods that struggle with occlusions and incomplete views, A3DGS leverages 3D Gaussians to represent both visible and occluded regions, ensuring holistic scene understanding. Our approach integrates a shape completion network with Gaussian splatting, trained on synthetic and real-world datasets to generalize across diverse scenarios. Experiments demonstrate superior performance in amodal completion and novel view rendering compared to state-of-the-art baselines.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
