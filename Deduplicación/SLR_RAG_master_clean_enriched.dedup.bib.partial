@inproceedings{kamra_enhancing_2024,
 abstract = {The rapid proliferation of Internet of Things (IoT) devices has led to an exponential increase in data generation, necessitating efficient and secure data management solutions. Traditional centralized systems often face challenges such as single points of failure, scalability issues, and privacy concerns. Blockchain technology, with its decentralized and immutable nature, offers a promising alternative for secure data sharing in IoT environments. This paper proposes a blockchain-based framework for secure and efficient data sharing among IoT devices. The framework integrates smart contracts for access control and data provenance, ensuring transparency and tamper-proof records. We employ a consortium blockchain model to balance decentralization with performance requirements suitable for resource-constrained IoT devices. Additionally, we incorporate lightweight cryptographic techniques to minimize computational overhead. Experimental evaluations using a simulated IoT network demonstrate that the proposed framework achieves reduced latency in data transactions compared to traditional methods, while maintaining high levels of security and privacy. The results highlight the framework's potential for real-world deployment in smart city applications and industrial IoT scenarios.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Kamra},
 booktitle = {2024 5th {International}},
 doi = {10.1109/C2I663243.2024.10895931},
