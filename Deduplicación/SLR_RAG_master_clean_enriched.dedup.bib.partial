 pages = {591--602},
 publisher = {Association for Computing Machinery},
 series = {{KDD}},
 title = {{CityGPT}},
 url = {https://doi.org/10.1145/3711896.3736878},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:36:31Z},
 year = {2025}
}

@inproceedings{feng_cmdbench_2024,
 abstract = {Web accessibility remains a significant challenge for visually impaired users, who often rely on screen readers to navigate complex web pages. However, current screen readers struggle with dynamic content, spatial layouts, and interactive elements, leading to disorientation and inefficiency. We introduce EchoMouse, a tangible device that enables visually impaired users to physically explore and interact with web pages using a mouse-like interface augmented with spatial audio feedback. By mapping web elements to a physical surface, EchoMouse allows users to "feel" the page structure through haptics and hear descriptions via bone-conduction audio as they move a cursor. Our user study with 12 visually impaired participants demonstrates that EchoMouse significantly improves navigation speed and accuracy compared to traditional screen readers, while reducing cognitive load. We discuss design implications for inclusive web tools and future integrations with AI-driven content adaptation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Feng},
 booktitle = {Proceedings of the {Conference}},
 doi = {10.1145/3665601.3669846},
