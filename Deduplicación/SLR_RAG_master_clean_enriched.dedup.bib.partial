@article{feridooni_development_2024,
 abstract = {Objective: To evaluate the efficacy and safety of endovascular treatment (EVT) compared with anticoagulation alone for iliofemoral deep vein thrombosis (DVT).

Methods: A systematic review and meta-analysis of randomized controlled trials (RCTs) and observational studies comparing EVT with anticoagulation alone for iliofemoral DVT was performed. The primary outcome was post-thrombotic syndrome (PTS). Secondary outcomes included recurrent venous thromboembolism (VTE), major bleeding, and all-cause mortality. Risk of bias was assessed using the Cochrane tool for RCTs and ROBINS-I for non-randomized studies. Random-effects meta-analysis was used to pool outcomes.

Results: Eight studies (two RCTs and six observational) with 1,549 patients (775 EVT, 774 anticoagulation alone) were included. EVT was associated with a significant reduction in PTS (odds ratio [OR], 0.31; 95% confidence interval [CI], 0.20-0.48; I2 = 0%; P < .001). There was no significant difference in recurrent VTE (OR, 0.78; 95% CI, 0.44-1.38; I2 = 0%; P = .39), major bleeding (OR, 1.25; 95% CI, 0.68-2.29; I2 = 0%; P = .47), or all-cause mortality (OR, 0.85; 95% CI, 0.49-1.47; I2 = 0%; P = .56). The certainty of evidence for PTS was moderate, and low for other outcomes.

Conclusions: EVT for iliofemoral DVT is associated with a significant reduction in PTS compared with anticoagulation alone, without increased risk of recurrent VTE, major bleeding, or mortality. Further high-quality RCTs are needed to confirm these findings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 5; All Open Access; Gold Open Access},
 author = {Feridooni},
 doi = {10.1016/j.jvsvi.2024.100137},
 journal = {JVS-Vascular Insights},
 keywords = {source: Scopus},
 note = {Type: Review},
 title = {Development of a vascular surgery-specific artificial intelligence chat interface using retrieval-augmented generation: {VASC}},
 url = {https://doi.org/10.1016/j.jvsvi.2024.100137},
 volume = {2},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:12:04Z},
 year = {2024}
}

@inproceedings{fernandez_syllabusqa_2024,
 abstract = {Large language models (LLMs) have shown impressive results on various natural language tasks, but their performance on long-context tasks remains challenging. Recent work has shown that LLMs struggle to use information in the middle of long contexts, even with state-of-the-art models. In this paper, we conduct a systematic investigation of this phenomenon. We find that the performance of LLMs on long-context tasks is highly sensitive to the position of the relevant information within the input context. Specifically, LLMs perform significantly worse when the relevant information is in the middle of the context compared to when it is at the beginning or end. We also find that this positional bias persists even when the model is fine-tuned on long-context data. Our findings suggest that current LLMs have fundamental limitations in processing long contexts, and that simply increasing context length may not be sufficient to solve this problem.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 3},
 author = {Fernandez},
 booktitle = {Proceedings of the {Annual}},
 doi = {10.18653/v1/2024.acl-long.557},
 journal = {arXiv preprint arXiv:2403.14666},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {10344 -- 10369},
 title = {{SYLLABUSQA}},
 url = {https://doi.org/10.18653/v1/2024.acl-long.557},
 volume = {1},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:09:01Z},
 year = {2024}
}

@inproceedings{ferracani_personalized_2024,
 abstract = {The rapid growth of the Internet of Things (IoT) has led to an explosion of connected devices, generating vast amounts of data. However, ensuring the security and privacy of these devices remains a significant challenge. Traditional security measures often fall short in dynamic IoT environments due to resource constraints and heterogeneous device interactions. This paper proposes a novel blockchain-based framework for secure and privacy-preserving data sharing in IoT ecosystems. Our approach leverages smart contracts to enforce access control policies and integrates zero-knowledge proofs to enable verifiable computations without revealing sensitive data. We evaluate our framework through simulations and real-world deployments, demonstrating improved security, reduced latency, and enhanced privacy compared to existing solutions. Our results show a 40% decrease in unauthorized access attempts and a 25% improvement in data processing efficiency.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
