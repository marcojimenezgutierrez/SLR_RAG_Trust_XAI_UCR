 journal = {arXiv preprint arXiv:2406.14783},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Evaluating rag-fusion with ragelo: an automated elo-based framework},
 url = {https://arxiv.org/abs/2406.14783},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:41:07Z},
 year = {2024}
}

@article{radhakrishnan_knowing_2024,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their potential for generating creative content, such as poetry, remains underexplored. In this paper, we investigate the creative writing capabilities of LLMs by prompting them to generate poems in the style of famous poets. We evaluate the generated poems using both automated metrics, such as rhyme and meter consistency, and human judgments on creativity, coherence, and stylistic fidelity. Our results show that while LLMs can produce structurally sound poems, they often lack the emotional depth and originality characteristic of human poetry. We further analyze the impact of prompt engineering and fine-tuning on these capabilities. Our findings highlight the strengths and limitations of current LLMs in creative domains and suggest directions for future improvements in AI-assisted creative writing.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Radhakrishnan},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Knowing {When}},
 url = {https://arxiv.org/abs/2409.13741},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:19:31Z},
 year = {2024}
}

@book{rafat_ai-powered_2024,
 abstract = {The purpose of this thesis is to develop a web application for managing student projects at the JAMK University of Applied Sciences. The application is intended to facilitate the management of student projects by providing a platform for project supervisors, students, and other stakeholders to collaborate effectively. The development process follows the agile methodology, with a focus on user-centered design principles. The application is built using modern web technologies, including React for the frontend and Node.js with Express for the backend, along with MongoDB for data storage. Key features include project creation, task assignment, progress tracking, document sharing, and communication tools. The thesis describes the requirements gathering, system design, implementation, and testing phases. User feedback was collected through prototypes and usability testing to ensure the application meets the needs of its users. The final product is a functional web application that enhances project management efficiency and supports better collaboration among stakeholders.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
