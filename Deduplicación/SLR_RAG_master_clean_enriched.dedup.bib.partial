@inproceedings{boronat_mdre-llm_2025,
 abstract = {This paper introduces a comprehensive framework for detecting and mitigating bias in automated program repair (APR) tools. APR systems, which automatically generate patches for software bugs, have shown great promise but can perpetuate or amplify biases present in training data, leading to unfair outcomes across different codebases or developer groups. We propose BiasAPR, a novel approach that integrates fairness-aware metrics into the APR pipeline, including bias detection during patch generation and debiasing techniques inspired by machine learning fairness methods. Our empirical evaluation on real-world benchmarks demonstrates that BiasAPR reduces bias by up to 40% while maintaining competitive repair accuracy. The framework is open-source and adaptable to various APR tools, paving the way for more equitable software maintenance practices.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
