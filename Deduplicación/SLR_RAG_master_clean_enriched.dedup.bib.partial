 publisher = {Association for Computing Machinery},
 series = {{PROMISE}},
 title = {Designing and {Optimizing}},
 url = {https://doi.org/10.1145/3727582.3728687},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:19:34Z},
 year = {2025}
}

@article{al-zuraiqi_evaluating_2024,
 abstract = {The rapid proliferation of Internet of Things (IoT) devices has led to an exponential increase in data generation, necessitating efficient and privacy-preserving machine learning techniques. Federated Learning (FL) has emerged as a promising approach to train models collaboratively across distributed IoT devices without sharing raw data. However, the resource constraints of IoT devices, including limited computational power, storage, and battery life, pose significant challenges to the practical deployment of FL. This survey provides a comprehensive overview of FL techniques specifically designed for resource-constrained IoT environments. We categorize the existing methods into model optimization, communication efficiency, and system-level adaptations. Key techniques such as model compression, quantization, pruning, knowledge distillation, and efficient communication protocols are discussed in detail. Additionally, we explore advanced strategies like personalized FL, split learning, and edge computing integration to further mitigate resource limitations. The survey also addresses security and privacy concerns in FL for IoT and highlights open challenges and future research directions. By synthesizing the state-of-the-art, this work aims to guide researchers and practitioners in developing robust and efficient FL solutions for the IoT ecosystem.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Al-Zuraiqi},
 journal = {2024 International Conference on …},
 keywords = {source: Google Scholar},
