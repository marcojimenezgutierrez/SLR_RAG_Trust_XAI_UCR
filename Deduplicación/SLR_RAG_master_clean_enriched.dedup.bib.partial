 series = {{KDD}},
 title = {{WebGLM}},
 url = {https://doi.org/10.1145/3580305.3599931},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:20:27Z},
 year = {2023}
}

@article{liu_xrag_2025,
 abstract = {Developing generalist robot policies that can solve a wide variety of tasks in unstructured environments is a long-standing goal in robotics. However, most existing approaches focus on short-horizon tasks, such as grasping or short-term manipulation, and struggle with long-horizon tasks that require complex planning and execution. In this work, we study what matters in building long-horizon manipulation policies. We propose a framework for evaluating long-horizon policies based on their ability to solve diverse tasks in simulation and real-world settings. Through extensive experiments, we identify key factors that influence policy performance, including the choice of action space, the use of hierarchical planning, and the integration of visual and proprioceptive observations. Our findings suggest that combining low-level control policies with high-level planning can significantly improve performance on long-horizon tasks. We demonstrate the effectiveness of our approach on a suite of challenging manipulation tasks, including object rearrangement and tool use.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Liu},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
