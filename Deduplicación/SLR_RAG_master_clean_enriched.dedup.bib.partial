 keywords = {explainable recommendation},
 note = {event-place: Sydney NSW},
 pages = {240--251},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {G-{Refer}},
 url = {https://doi.org/10.1145/3696410.3714727},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:25:47Z},
 year = {2025}
}

@inproceedings{li_generating_2025,
 abstract = {This paper proposes a novel approach for audio-visual speech enhancement in noisy environments. We introduce a multi-modal transformer network that fuses audio and visual features to improve speech intelligibility. The model leverages cross-attention mechanisms to align lip movements with acoustic signals, achieving superior performance over traditional audio-only methods. Experiments on the AVSpeech dataset demonstrate a 2.5 dB gain in PESQ scores and reduced word error rates in downstream ASR tasks. Our method is efficient and deployable on edge devices, paving the way for real-world applications in hearing aids and teleconferencing.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Li},
 booktitle = {{ICASSP}},
 doi = {10.1109/ICASSP49660.2025.10889013},
 keywords = {Data privacy},
 month = {apr},
 note = {ISSN: 2379-190X},
 pages = {1--5},
 title = {Generating {Is}},
 url = {https://doi.org/10.1109/icassp49660.2025.10889013},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:50:32Z},
 year = {2025}
