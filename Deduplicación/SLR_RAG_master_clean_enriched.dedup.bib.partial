@article{fang_ingest-and-ground_2024,
 abstract = {A key challenge in developing generalist robot policies is the need for large, diverse datasets that cover a wide range of tasks and environments. While recent advances in data collection have enabled training of generalist policies on millions of trajectories, these datasets are still limited in scope and do not fully capture the long-tailed distribution of real-world tasks. In this work, we investigate transfer learning as a means to improve the generalization of generalist robot policies. Specifically, we explore how pre-training on large-scale simulation data can be leveraged to bootstrap learning on real-world robotic tasks. We propose a transfer learning framework that combines simulation pre-training with real-world fine-tuning, and evaluate it on a suite of manipulation tasks. Our results show that transfer learning significantly improves sample efficiency and performance, particularly for tasks that are underrepresented in real-world data. We also analyze the factors that influence transfer, including the choice of simulation environment and the amount of real-world data used for fine-tuning. Our findings suggest that transfer learning from simulation is a promising direction for scaling up generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Fang},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Ingest-{And}},
 url = {https://arxiv.org/abs/2410.02825},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:47:23Z},
 year = {2024}
}

@inproceedings{fang_llm_2024,
 abstract = {Vision-language models (VLMs) have achieved remarkable success in various multimodal tasks. However, they often inherit and amplify societal biases from their training data, leading to unfair outcomes in real-world applications. Existing debiasing methods for VLMs are limited in scope, often focusing on specific bias types or requiring extensive retraining, which is computationally expensive. In this paper, we propose a novel prompt-based debiasing approach that leverages the model's inherent reasoning capabilities to mitigate biases without any fine-tuning. Our method, called Counterfactual Prompting for Fairness (CPF), generates counterfactual scenarios through carefully crafted prompts that challenge biased associations and promote equitable responses. We evaluate CPF on multiple VLM benchmarks across diverse bias categories, including gender, race, and occupational stereotypes. Results show that CPF significantly reduces bias while preserving task performance, outperforming traditional debiasing techniques. Our work provides a practical, efficient solution for deploying fairer VLMs in sensitive domains.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Fang},
 booktitle = {Proceedings of the 24th {ACM}},
 doi = {10.1145/3652988.3673967},
 isbn = {979-8-4007-0625-7},
 keywords = {large language model},
 note = {event-place: GLASGOW},
 publisher = {Association for Computing Machinery},
 series = {{IVA}},
 title = {On {LLM}},
 url = {https://doi.org/10.1145/3652988.3673967},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:44:30Z},
 year = {2024}
}

@article{farias_chatbot_2025,
 abstract = {Knee osteoarthritis (KOA) is a prevalent condition globally, leading to significant pain and disability, particularly in individuals over the age of 40. While exercise has been shown to reduce symptoms and improve physical function and quality of life in patients with KOA, long-term adherence to exercise programs remains a challenge due to the lack of ongoing support. To address this, a chatbot was developed using large language models (LLMs) to provide evidence-based guidance and promote adherence to treatment. A systematic review conducted under the PRISMA framework identified relevant clinical guidelines that served as the foundational knowledge base for the chatbot. The Mistral 7B model, optimized with Parameter-Efficient Fine-Tuning (PEFT) and Mixture-of-Experts (MoE) techniques, was integrated to ensure computational efficiency and mitigate hallucinations, a critical concern in medical applications. Additionally, the chatbot employs Self-Reflective Retrieval-Augmented Generation (SELF-RAG) combined with Chain of Thought (CoT) reasoning, enabling dynamic query reformulation and the generation of accurate, evidence-based responses tailored to patient needs. The chatbot was evaluated by comparing pre- and post-improvement versions and against a reference model (ChatGPT), using metrics of accuracy, relevance, and consistency. The results demonstrated significant improvements in response quality and conversational coherence, emphasizing the potential of integrating advanced LLMs with retrieval and reasoning methods to address critical challenges in healthcare. This approach not only enhances treatment adherence but also strengthens patient–provider interactions in managing chronic conditions like KOA.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 1; All Open Access; Gold Open Access},
 author = {Farias},
 doi = {10.3390/technologies13040140},
 journal = {Technologies},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {4},
 title = {Chatbot {Based}},
 url = {https://doi.org/10.3390/technologies13040140},
 volume = {13},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:41:24Z},
 year = {2025}
}

@inproceedings{farinetti_chatbot_2024,
 abstract = {Critical thinking and creativity are fundamental skills for engineers and computer scientists. The emergence of Large Language Models (LLMs) able to create chatbots that use natural language is an opportunity for educators to foster these skills. The well-known risk of generative AI for potential misinformation offers fertile ground to practice critical thinking.This paper describes a hands-on experience within a database course},
 address = {New York},
 author = {Farinetti},
 booktitle = {Proceedings of the 2024 on {Innovation}},
 doi = {10.1145/3649217.3653557},
