 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:44:09Z},
 year = {2025}
}

@inproceedings{agliata_generative_2024,
 abstract = {The rapid growth of the Internet of Things (IoT) has led to an exponential increase in connected devices, generating vast amounts of data. However, ensuring the security and privacy of this data remains a significant challenge. Traditional centralized security mechanisms are often inadequate for distributed IoT environments. This paper proposes a novel hybrid approach that combines blockchain technology with federated learning to enhance security in IoT networks. Blockchain provides a decentralized and immutable ledger for secure data sharing, while federated learning enables collaborative model training without compromising data privacy. Our framework is evaluated through simulations on a real-world IoT dataset, demonstrating improved detection rates for cyber threats and reduced communication overhead compared to existing methods. The results highlight the potential of this integration for scalable and robust IoT security solutions.},
