@inproceedings{bhuvaji_retrieval-augmented_2025,
 abstract = {Bimanual 3D Interactions in Virtual Reality (VR) often rely on controllers, which can be cumbersome and limit natural interaction. We propose HandVR, a controller-free bimanual interaction technique that leverages hand tracking to enable intuitive 3D manipulation in VR. HandVR uses a combination of gesture recognition and physics-based simulation to allow users to grasp, rotate, and translate virtual objects using natural hand movements. Our evaluation shows that HandVR significantly improves task completion times and user satisfaction compared to traditional controller-based methods, while reducing physical fatigue.},
