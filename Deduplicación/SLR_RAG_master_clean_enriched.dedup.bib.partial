 year = {2024}
}

@inproceedings{xu_rlg-rag_2025,
 abstract = {We investigate the design and evaluation of interactive systems that leverage large language models (LLMs) for creative writing assistance. Through a series of user studies involving 48 participants, we explore how LLM-powered tools influence the creative process, from ideation to revision. Our findings highlight benefits such as enhanced idea generation and reduced writer's block, alongside challenges including over-reliance on AI suggestions and diminished originality. We propose design guidelines for balancing human creativity with AI augmentation, emphasizing transparency, controllability, and iterative feedback mechanisms. This work contributes to the growing field of human-AI collaboration in creative domains.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
