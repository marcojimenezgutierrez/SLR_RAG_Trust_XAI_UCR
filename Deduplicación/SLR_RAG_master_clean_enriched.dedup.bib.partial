 note = {event-place: Padua},
 pages = {78--91},
 publisher = {Association for Computing Machinery},
 series = {{ICTIR}},
 title = {Preaching to the {ChoIR}},
 url = {https://doi.org/10.1145/3731120.3744612},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
