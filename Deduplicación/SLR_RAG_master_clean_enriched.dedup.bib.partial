@article{mansurova_qa-rag_2024,
 abstract = {Large language models (LLMs) can store factual knowledge within their parameters and have achieved superior results in question-answering tasks. However, challenges persist in providing provenance for their decisions and keeping their knowledge up to date. Some approaches aim to address these challenges by combining external knowledge with parametric memory. In contrast, our proposed QA-RAG solution relies solely on the data stored within an external knowledge base, specifically a dense vector index database. In this paper, we compare RAG configurations using two LLMs—Llama 2b and 13b—systematically examining their performance in three key RAG capabilities: noise robustness, knowledge gap detection, and external truth integration. The evaluation reveals that while our approach achieves an accuracy of 83.3%, showcasing its effectiveness across all baselines, the model still struggles significantly in terms of external truth integration. These findings suggest that considerable work is still required to fully leverage RAG in question-answering tasks.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 14; All Open Access; Gold Open Access},
 author = {Mansurova},
 doi = {10.3390/bdcc8090115},
 journal = {Big Data and Cognitive Computing},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {9},
 title = {{QA}},
 url = {https://doi.org/10.3390/bdcc8090115},
 volume = {8},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:02:24Z},
 year = {2024}
}

@article{mao_fit-rag_2025,
 abstract = {Due to the extraordinarily large number of parameters, fine-tuning large language models (LLMs) to update long-tail or out-of-date knowledge is impractical in lots of applications. To avoid fine-tuning, we can alternatively treat a LLM as a black-box (i.e., freeze the parameters of the LLM) and augment it with a retrieval-augmented generation (RAG) system, namely black-box RAG. Recently, black-box RAG has achieved success in knowledge-intensive tasks and has gained much attention. Existing black-box RAG methods typically fine-tune the retriever to cater to LLMs’ preferences and concatenate all the retrieved documents as the input, which suffers from two issues: (1) Ignorance of Factual Information. The LLM preferred documents may not contain the factual information for the given question, which can mislead the retriever and hurt the effectiveness of black-box RAG; (2) Waste of Tokens. Simply concatenating all the retrieved documents brings large amounts of unnecessary tokens for LLMs, which degenerates the efficiency of black-box RAG. To address these issues, this article proposes a novel black-box RAG framework which utilizes the factual information in the retrieval and reduces the number of tokens for augmentation, dubbed FIT-RAG. FIT-RAG utilizes the factual information by constructing a bi-label document scorer which takes the factual information and LLMs’ preferences as labels respectively. Besides, it reduces the tokens by introducing a self-knowledge recognizer and a sub-document-level token reducer, which enables FIT-RAG to avoid unnecessary augmentation and reduce augmentation tokens as much as possible. FIT-RAG achieves both superior effectiveness and efficiency, which is validated by extensive experiments across three open-domain question-answering datasets: TriviaQA, NQ, and PopQA. FIT-RAG can improve the answering accuracy of Llama2-13B-Chat by 14.3% on TriviaQA, 19.9% on NQ and 27.5% on PopQA, respectively. Furthermore, it can save approximately half of the tokens on average across the three datasets.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Mao},
 doi = {10.1145/3676957},
 journal = {ACM Transactions on …},
 keywords = {source: Google Scholar},
 note = {Publisher: dl.acm.org},
 title = {{FIT}},
 url = {https://doi.org/10.1145/3676957},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:22:49Z},
 year = {2025}
}

@inproceedings{mao_multi-agent_2025,
 abstract = {People with visual impairments (PWVI) often rely on voice assistants for everyday tasks, yet these interfaces frequently fall short in providing accessible and intuitive interactions. This paper presents Echo, a novel voice user interface designed specifically for PWVI, emphasizing empathetic and inclusive design principles. Through a series of user studies involving 12 PWVI participants, we evaluate Echo's features, including adaptive audio cues, contextual feedback, and gesture integration via smart speakers. Our findings reveal significant improvements in task completion rates (up 35%) and user satisfaction compared to standard voice assistants like Alexa and Google Assistant. We discuss design implications for future accessible VUIs, highlighting the importance of co-design with PWVI to foster greater independence and empowerment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
