 keywords = {Artificial intelligence (AI)},
 publisher = {Association for Computing Machinery},
 series = {{UIST}},
 title = {"{This}},
 url = {https://doi.org/10.1145/3746059.3747597},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:57:33Z},
 year = {2025}
}

@inproceedings{tao_housing_2025,
 abstract = {Visual recognition systems have achieved remarkable performance in various tasks, but they often exhibit biases towards certain demographic groups, leading to unfair outcomes. This paper investigates effective strategies for mitigating bias in visual recognition models and proposes a comprehensive evaluation framework. We explore debiasing techniques such as adversarial training and data augmentation, and assess their impact on fairness metrics. Our experiments on benchmark datasets demonstrate significant improvements in fairness without substantial degradation in accuracy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
