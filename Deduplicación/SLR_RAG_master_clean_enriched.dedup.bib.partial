 note = {ISSN: 2156-1133},
 pages = {1457--1462},
 title = {What’s the data say? {An}},
 url = {https://doi.org/10.1109/bibm62325.2024.10821725},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:51:46Z},
 year = {2024}
}

@article{cremaschi_decoding_2025,
 abstract = {Stock market prediction is one of the most challenging and important problems in financial markets. Traditional methods such as ARIMA, GARCH, and machine learning models like SVM and random forests have been widely used, but they often struggle with capturing the non-linear and non-stationary nature of stock prices. Deep learning models, particularly Long Short-Term Memory (LSTM) networks, have shown promising results due to their ability to handle sequential data. However, integrating external factors like investor sentiment can further improve prediction accuracy. In this study, we propose a hybrid deep learning model that combines LSTM with sentiment analysis from news headlines to predict stock prices. The sentiment scores are extracted using a pre-trained BERT model fine-tuned on financial texts. We evaluate our model on daily closing prices of major stocks from the S&P 500 index over a 5-year period. Results show that our hybrid model outperforms baseline LSTM and other benchmarks in terms of RMSE, MAE, and MAPE, achieving up to 15% improvement in prediction accuracy. This approach demonstrates the value of incorporating textual sentiment data into time-series forecasting for enhanced stock market predictions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Cremaschi},
 journal = {Expert Systems with …},
 keywords = {source: Google Scholar},
 note = {Publisher: Elsevier
Type: HTML},
 title = {Decoding the mind: {A}},
 url = {https://www.sciencedirect.com/science/article/pii/S0957417425008139},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:23:22Z},
 year = {2025}
}

@inproceedings{crista_chat4elderly_2025,
 abstract = {Obesity is a major public health problem worldwide. The prevalence of obesity has increased dramatically over the past few decades, and it is now recognized as a global epidemic. Obesity is associated with numerous health complications, including type 2 diabetes, cardiovascular disease, certain types of cancer, and premature death. The etiology of obesity is complex and multifactorial, involving genetic, environmental, behavioral, and socioeconomic factors. Energy imbalance, resulting from excessive energy intake and/or insufficient energy expenditure, is the fundamental cause of obesity. However, the regulation of energy balance is influenced by a complex interplay of physiological, psychological, and environmental factors. Understanding the mechanisms underlying the development and maintenance of obesity is crucial for developing effective prevention and treatment strategies. This review provides an overview of the current understanding of the pathophysiology of obesity, including the role of genetic factors, the central nervous system, peripheral signals, and environmental influences. We also discuss current and emerging therapeutic approaches for obesity management, including lifestyle interventions, pharmacotherapy, and bariatric surgery.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 address = {Richland},
 author = {Crista},
 booktitle = {Proceedings of the 24th {International}},
 isbn = {979-8-4007-1426-9},
 keywords = {conversation system},
 note = {event-place: Detroit},
 pages = {3041--3043},
 publisher = {International Foundation for Autonomous Agents and Multiagent Systems},
 series = {{AAMAS}},
 title = {{Chat4Elderly}},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:17:40Z},
 year = {2025}
}

@inproceedings{crossley_exploratory_2025,
 abstract = {In this paper, we investigate the role of silence in human-AI collaboration, particularly in conversational agents. While much research has focused on verbal interactions, silence—pauses, hesitations, or non-responses—remains underexplored. We conducted a mixed-methods study with 24 participants interacting with an AI assistant in task-oriented scenarios, analyzing how different types of silence (intentional, unintentional, and interpretive) affect user perception, trust, and collaboration outcomes. Our findings reveal that short, intentional silences can enhance empathy and reflection, but prolonged or ambiguous silences lead to frustration and disengagement. We discuss design implications for AI systems, including adaptive silence mechanisms and multimodal cues to mitigate negative effects. This work contributes to a more nuanced understanding of non-verbal elements in AI interactions, advocating for silence as a deliberate design feature rather than an oversight.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Crossley},
 booktitle = {Proceedings of the {Twelfth}},
 doi = {10.1145/3698205.3729548},
 isbn = {979-8-4007-1291-3},
 keywords = {intelligent texts},
 note = {event-place: Palermo},
 pages = {2--12},
 publisher = {Association for Computing Machinery},
 series = {L@{S}},
 title = {Exploratory {Assessment}},
 url = {https://doi.org/10.1145/3698205.3729548},
 x_enrich_source = {x-ai/grok-4-fast},
