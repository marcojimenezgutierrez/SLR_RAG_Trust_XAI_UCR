@inproceedings{sun_scrag_2025,
 abstract = {This paper proposes a novel federated learning framework tailored for resource-constrained edge devices in smart cities. By integrating differential privacy mechanisms and adaptive aggregation strategies, our approach mitigates data leakage risks while optimizing model convergence under heterogeneous network conditions. Extensive simulations on real-world urban traffic datasets demonstrate a 25% improvement in accuracy compared to baseline methods, with reduced communication overhead. The framework's scalability is validated through deployment on IoT testbeds, highlighting its potential for privacy-preserving smart computing applications.},
