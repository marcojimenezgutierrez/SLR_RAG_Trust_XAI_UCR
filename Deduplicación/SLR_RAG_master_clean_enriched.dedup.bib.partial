 x_enrich_ts = {2025-11-02T10:05:42Z},
 year = {2024}
}

@book{su_implementing_2024,
 abstract = {This study investigates the neural mechanisms underlying decision-making in social contexts using functional magnetic resonance imaging (fMRI). Participants (N = 48) completed a task involving trust-based choices with confederates. Results reveal heightened activity in the ventromedial prefrontal cortex (vmPFC) during cooperative decisions, correlating with individual differences in empathy scores. Implications for understanding prosocial behavior are discussed.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
