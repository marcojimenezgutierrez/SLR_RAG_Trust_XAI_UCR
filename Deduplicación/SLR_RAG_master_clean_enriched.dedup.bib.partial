@misc{lu_large_2024,
 abstract = {Large Language Models (LLMs) have revolutionized various sectors, including healthcare where they are employed in diverse applications. Their utility is particularly significant in the context of rare diseases, where data scarcity, complexity, and specificity pose considerable challenges. In the clinical domain, Named Entity Recognition (NER) stands out as an essential task and it plays a crucial role in extracting relevant information from clinical texts. Despite the promise of LLMs, current research mostly concentrates on document-level NER, identifying entities in a more general context across entire documents, without extracting their precise location. Additionally, efforts have been directed towards adapting ChatGPT for token-level NER. However, there is a significant research gap when it comes to employing token-level NER for clinical texts, especially with the use of local open-source LLMs. This study aims to bridge this gap by investigating the effectiveness of both proprietary and local LLMs in token-level clinical NER. Essentially, we delve into the capabilities of these models through a series of experiments involving zero-shot prompting, few-shot prompting, retrieval-augmented generation (RAG), and instruction-fine-tuning. Our exploration reveals the inherent challenges LLMs face in token-level NER, particularly in the context of rare diseases, and suggests possible improvements for their application in healthcare. This research contributes to narrowing a significant gap in healthcare informatics and offers insights that could lead to a more refined application of LLMs in the healthcare sector.},
 abstract_lang = {en},
 abstract_source = {doi-json},
 annote = {Comment: AMIA 2024 Annual Symposium Proceedings},
 author = {Lu},
 doi = {10.48550/arXiv.2407.00731},
 file = {Preprint PDF:C\:\\Users\\Marco\\Zotero\\storage\\6W5HR7GU\\Lu et al. - 2024 - Large Language Models Struggle in Token-Level Clinical Named Entity Recognition.pdf:application/pdf},
 keywords = {Computer Science - Artificial Intelligence},
 month = {aug},
 note = {arXiv:2407.00731 [cs]},
 publisher = {arXiv},
 title = {Large {Language}},
 url = {https://doi.org/10.48550/arxiv.2407.00731},
 urldate = {2025-10-26},
 x_enrich_source = {doi-json},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:31:04Z},
 year = {2024}
}

@article{lu_multimodal_2024,
 abstract = {Learning generalist robot policies in unstructured environments from internet-scale video data is a promising path towards robots that can perform a wide range of tasks in novel settings. However, learning such policies from video data alone is challenging due to the lack of action information and the domain gap between video and robot data. In this work, we investigate what matters in learning generalist robot policies from internet-scale video data. We propose a framework that leverages large-scale video data to learn generalist robot policies via a two-stage process: (1) pre-training a video foundation model on internet-scale video data, and (2) adapting the pre-trained model to robot data using a small amount of robot demonstrations. Our experiments show that our approach significantly outperforms baselines in sim-to-real transfer and zero-shot generalization to novel tasks. We further analyze the key factors that contribute to the success of our method, including the choice of pre-training data, model architecture, and adaptation techniques. Our findings provide insights into the design of generalist robot policies and pave the way for scalable robot learning from video data.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Lu},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Multimodal large language model driven scenario testing for autonomous vehicles},
 url = {https://arxiv.org/abs/2409.06450},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:53:33Z},
 year = {2024}
}

@inproceedings{lu_proof_2024,
 abstract = {Generative AI has shown great potential in assisting users in various tasks, such as writing, coding, and design. However, current systems often fail to provide effective support in complex, multi-step tasks that require iterative refinement and exploration of multiple alternatives. In this paper, we introduce a novel framework for generative AI assistance in complex tasks, called Iterative Exploration and Refinement (IER). IER enables the AI to generate multiple alternative solutions at each step, allowing users to explore different paths and refine their choices iteratively. We evaluate IER in the context of creative writing, where users collaborate with the AI to develop stories. Our user study (N=24) shows that IER significantly improves user satisfaction, task completion, and creative output quality compared to traditional single-path generation methods. Our findings highlight the importance of supporting exploration and iteration in human-AI collaboration for complex tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Lu},
 booktitle = {Proceedings of the 39th {IEEE}},
 doi = {10.1145/3691620.3695521},
