@article{maheshwari_citefix_2025,
 abstract = {In this paper, we revisit the phenomenon of grokking from the perspective of algorithmic information theory. Grokking refers to the delayed generalization of neural networks trained on seemingly simple algorithmic tasks, where the network first memorizes the training data and only later discovers a general solution. We propose that grokking can be understood as a form of compression: the network initially learns a high-complexity memorization solution, and then transitions to a low-complexity generalization solution that compresses the training data more effectively. Using the concept of Kolmogorov complexity, we formalize this transition and show that it aligns with observed grokking behaviors in modular addition and other tasks. Our analysis provides a novel theoretical framework for understanding grokking and suggests new directions for training algorithms that accelerate the discovery of compressible solutions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Maheshwari},
 journal = {arXiv preprint arXiv:2504.15629},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {{CiteFix}},
 url = {https://arxiv.org/abs/2504.15629},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:18:30Z},
 year = {2025}
}

@article{mahmoud_o-ran_2025,
 abstract = {This paper introduces a novel framework for secure and efficient federated learning in heterogeneous edge computing environments. We address key challenges such as data heterogeneity, communication overhead, and privacy preservation by integrating differential privacy with adaptive aggregation techniques. Extensive simulations on real-world datasets demonstrate that our approach achieves up to 20% improvement in model accuracy compared to baseline methods, while ensuring stringent privacy guarantees. Our framework is particularly suited for IoT applications where resource constraints and data sensitivity are paramount.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
