@inproceedings{mayfield_evaluation_2024,
 abstract = {Inclusive design practices aim to create products and services that are accessible and usable by the widest range of people possible, including those with disabilities. However, older adults with cognitive impairments (OACIs) are often overlooked in these practices due to challenges in understanding their needs and involving them in the design process. This paper presents findings from a qualitative study involving 12 OACIs and 8 caregivers to explore inclusive design practices for OACIs. We identify key challenges in current practices, such as communication barriers, lack of tailored methods, and ethical concerns. Based on these insights, we propose a framework for inclusive design that emphasizes empathy-building, adaptive methods, and ethical considerations. Our framework includes practical guidelines and tools to support designers in creating more inclusive experiences for OACIs. This work contributes to the growing body of research on inclusive design by focusing on an underserved population and providing actionable recommendations for practitioners.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
