@inproceedings{duvvuru_llm-agents_2025,
 abstract = {This paper introduces a novel approach to automated program repair (APR) that leverages large language models (LLMs) to generate and validate repair patches. Traditional APR techniques often struggle with complex bugs due to limited search spaces and reliance on hand-crafted heuristics. Our method, LLM-Repair, integrates LLMs with dynamic analysis to explore a broader range of potential fixes, achieving higher success rates on real-world benchmarks. We evaluate LLM-Repair on the Defects4J dataset and Defects4J-v2, demonstrating improvements over state-of-the-art tools like SequenceR and TBar. Our results show that LLM-Repair successfully repairs 45% more bugs while reducing patch generation time by 30%. This work highlights the potential of LLMs in advancing APR, paving the way for more reliable software maintenance practices.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {Ottawa},
 author = {Duvvuru},
 booktitle = {Proceedings of the {IEEE}},
 doi = {10.1109/ICSE55347.2025.00223},
