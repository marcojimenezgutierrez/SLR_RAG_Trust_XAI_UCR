@article{rajapaksha_rag-based_2025,
 abstract = {This chapter explores the integration of blockchain technology with artificial intelligence (AI) in the context of supply chain management. We propose a hybrid framework that leverages blockchain for secure data sharing and AI for predictive analytics and optimization. The framework addresses key challenges such as data transparency, traceability, and decision-making efficiency in complex supply chains. Through a case study in the pharmaceutical industry, we demonstrate the practical implementation and evaluate its performance using metrics like transaction speed, accuracy, and cost reduction. Our results indicate significant improvements in supply chain resilience and sustainability, paving the way for future research in decentralized AI-driven systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
