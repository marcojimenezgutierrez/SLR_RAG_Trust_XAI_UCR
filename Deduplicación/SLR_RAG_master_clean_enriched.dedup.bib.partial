@article{kirchenbauer_hallucination_2024,
 abstract = {Abstract

This study investigates the psychological effects of exposure to deepfake videos on public trust in media and political figures. Using a between-subjects experimental design (N = 450), participants viewed either authentic videos, deepfake videos, or were informed about deepfake technology before viewing. Results indicate that exposure to deepfakes significantly erodes trust in the depicted individuals (F(2,447) = 12.45, p < .001, η² = .05), with informed participants showing moderated effects due to increased skepticism. Implications for misinformation mitigation strategies are discussed, emphasizing the role of media literacy education.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kirchenbauer},
 journal = {ArXiv Preprint. https://doi. org/10.31219/osf. io …},
 keywords = {source: Google Scholar},
 note = {Publisher: files.osf.io
Type: PDF},
 title = {Hallucination reduction in large language models with retrieval-augmented generation using wikipedia knowledge},
 url = {https://files.osf.io/v1/resources/pv7r5/providers/osfstorage/6657166cd835c421594ce333?format=pdf\&action=download\&direct\&version=1},
