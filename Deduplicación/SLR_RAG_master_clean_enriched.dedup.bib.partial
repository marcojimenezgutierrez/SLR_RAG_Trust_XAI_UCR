@inproceedings{khurana_table_2025,
 abstract = {People with upper limb difference (ULD) often face challenges in performing daily tasks that require fine motor skills and hand function. Wearable haptic devices have the potential to assist by providing tactile feedback, but current designs rarely consider the diverse needs of this population. To address this gap, we conducted a co-design workshop with 12 participants with ULD to explore inclusive design principles for wearable haptics. Through participatory activities, we identified key requirements including customization for varying limb configurations, comfort during prolonged use, intuitiveness in feedback delivery, and integration with existing assistive technologies. Participants emphasized the importance of modularity, sensory adaptability, and emotional considerations in design. Based on these insights, we propose a set of design guidelines and a prototype concept for an inclusive wearable haptic system. Our findings contribute to more equitable assistive technologies, highlighting the value of user-centered approaches in haptic design for accessibility.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
