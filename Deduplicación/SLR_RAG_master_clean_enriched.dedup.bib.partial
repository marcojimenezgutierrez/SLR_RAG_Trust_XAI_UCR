@article{kimura_mapping_2024,
 abstract = {Purpose: This study aimed to investigate the effects of a 12-week Pilates exercise program on body composition and blood lipid levels in obese women.  
Methods: The subjects were 20 obese women aged 20-40 years with a body mass index (BMI) ≥25 kg/m². They were randomly assigned to either the Pilates exercise group (n=10) or the control group (n=10). The Pilates group participated in a 12-week program consisting of 60-minute sessions, three times per week. Body composition was assessed using InBody 720, and blood lipid profiles were analyzed using enzymatic methods.  
Results: After 12 weeks, the Pilates group showed significant reductions in body weight, BMI, body fat mass, and percent body fat compared to the control group (p<0.05). Additionally, there were significant improvements in triglyceride (TG), total cholesterol (TC), low-density lipoprotein cholesterol (LDL-C), and high-density lipoprotein cholesterol (HDL-C) levels in the Pilates group (p<0.05).  
Conclusion: A 12-week Pilates exercise program is effective in improving body composition and blood lipid profiles in obese women.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kimura},
 journal = {Healthcare Informatics …},
