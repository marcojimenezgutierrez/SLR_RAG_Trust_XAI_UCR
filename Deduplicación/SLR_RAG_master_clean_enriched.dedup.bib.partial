 x_enrich_ts = {2025-11-02T07:37:11Z},
 year = {2025}
}

@article{mikulic_integrating_2025,
 abstract = {Diabetic retinopathy (DR) is one of the major complications of diabetes and a leading cause of blindness in working-age adults. Early detection and timely treatment can prevent or delay the progression of DR. In this paper, we propose a deep learning-based approach for automated detection and grading of DR using fundus images. The proposed model utilizes a convolutional neural network (CNN) architecture with transfer learning from pre-trained models like ResNet50 and EfficientNet. The model is trained and evaluated on the APTOS 2019 Blindness Detection dataset, achieving an accuracy of 92.5% for multi-class classification of DR severity levels. Our approach demonstrates superior performance compared to traditional methods and highlights the potential for AI-assisted screening in resource-limited settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
