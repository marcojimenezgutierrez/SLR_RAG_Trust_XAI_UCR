}

@article{iannelli_sla_2024,
 abstract = {Recent advances in vision-language models have shown remarkable success in multimodal understanding and generation. However, these models often struggle with complex reasoning tasks that require integrating information from multiple modalities in a coherent manner. In this paper, we introduce a novel framework called Vision-Language Brainstorming (VLB), which leverages a brainstorming process inspired by human cognition to enhance multimodal reasoning. VLB consists of three key components: (1) a vision-language brainstormer that generates diverse candidate solutions by exploring multiple reasoning paths, (2) a critic module that evaluates and refines these candidates based on consistency and plausibility, and (3) an aggregator that synthesizes the best reasoning chain to produce the final output. We evaluate VLB on a suite of challenging multimodal benchmarks, including visual question answering, image captioning with reasoning, and multimodal arithmetic. Our results demonstrate that VLB significantly outperforms existing vision-language models, achieving state-of-the-art performance while providing interpretable reasoning traces. This work paves the way for more robust and explainable multimodal AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Iannelli},
 journal = {arXiv preprint arXiv:2412.06832},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {{SLA}},
 url = {https://arxiv.org/abs/2412.06832},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:32:47Z},
 year = {2024}
}

@article{iannuzzi_improving_2025,
 abstract = {Digital accessibility is considered an important aspect to allow all people, including those with permanent or temporary disabilities, to access the continuously increasing number of digital services. This raises the need for tools able to provide support for monitoring the accessibility of many websites, to understand their level of accessibility, and identify the areas that need more interventions for their improvement. The primary objectives of this work are to describe the challenges that have been faced in extending the MAUVE++ tool to carry out web accessibility validation in the context of large-scale assessments and provide an up-to-date view of the accessibility landscape of public administration websites. We discuss how the tool was adapted to analyse more than four million web pages and associated PDF documents from Italian public administration websites, assessing their compliance with WCAG guidelines. The results of this large-scale analysis have been utilised to provide insights on the state of accessibility at the national level, through a dedicated public dashboard updated quarterly, and stimulate its improvement. This research identifies the most violated success criteria, thus highlighting areas that should require attention from web developers and designers. Finally, we highlight some broader as well as practical implications of this research, and to what extent it can stimulate a more responsible approach and attention to accessibility aspects.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Iannuzzi},
 doi = {10.1145/3762815},
 journal = {ACM J. Responsib. Comput.},
 keywords = {source: ACM},
 month = {oct},
 note = {Place: New York},
 number = {3},
 title = {Improving {Accessibility}},
 url = {https://doi.org/10.1145/3762815},
 volume = {2},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:01Z},
 year = {2025}
}

@article{iaroshev_evaluating_2024,
 abstract = {This study explores the application of retrieval-augmented generation (RAG) to improve the accuracy and reliability of large language models (LLMs) in the context of financial report analysis. The focus is on enabling private investors to make informed decisions by enhancing the question-and-answering capabilities regarding the half-yearly or quarterly financial reports of banks. The study adopts a Design Science Research (DSR) methodology to develop and evaluate an RAG system tailored for this use case. The study conducts a series of experiments to explore models in which different RAG components are used. The aim is to enhance context relevance, answer faithfulness, and answer relevance. The results indicate that model one (OpenAI ADA and OpenAI GPT-4) achieved the highest performance, showing robust accuracy and relevance in response. Model three (MiniLM Embedder and OpenAI GPT-4) scored significantly lower, indicating the importance of high-quality components. The evaluation also revealed that well-structured reports result in better RAG performance than less coherent reports. Qualitative questions received higher scores than the quantitative ones, demonstrating the RAG’s proficiency in handling descriptive data. In conclusion, a tailored RAG can aid investors in providing accurate and contextually relevant information from financial reports, thereby enhancing decision making.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 8; All Open Access; Gold Open Access},
 author = {Iaroshev},
 doi = {10.3390/app14209318},
 journal = {Applied Sciences (Switzerland)},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {20},
 title = {Evaluating {Retrieval}},
 url = {https://doi.org/10.3390/app14209318},
 volume = {14},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:02:09Z},
 year = {2024}
}

@article{ibrahim_mera_2025,
 abstract = {The increasing complexity and scale of electronic health records (EHRs) demand advanced tools for efficient data retrieval, summarization, and comparative analysis in clinical practice. MERA (Medical Electronic Records Assistant) is a Retrieval-Augmented Generation (RAG)-based AI system that addresses these needs by integrating domain-specific retrieval with large language models (LLMs) to deliver robust question answering, similarity search, and report summarization functionalities. MERA is designed to overcome key limitations of conventional LLMs in healthcare, such as hallucinations, outdated knowledge, and limited explainability. To ensure both privacy compliance and model robustness, we constructed a large synthetic dataset using state-of-the-art LLMs, including Mistral v0.3, Qwen 2.5, and Llama 3, and further validated MERA on de-identified real-world EHRs from the MIMIC-IV-Note dataset. Comprehensive evaluation demonstrates MERA’s high accuracy in medical question answering (correctness: 0.91; relevance: 0.98; groundedness: 0.89; retrieval relevance: 0.92), strong summarization performance (ROUGE-1 F1-score: 0.70; Jaccard similarity: 0.73), and effective similarity search (METEOR: 0.7–1.0 across diagnoses), with consistent results on real EHRs. The similarity search module empowers clinicians to efficiently identify and compare analogous patient cases, supporting differential diagnosis and personalized treatment planning. By generating concise, contextually relevant, and explainable insights, MERA reduces clinician workload and enhances decision-making. To our knowledge, this is the first system to integrate clinical question answering, summarization, and similarity search within a unified RAG-based framework.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0},
 author = {Ibrahim},
 doi = {10.3390/make7030073},
 journal = {Machine Learning and Knowledge Extraction},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {3},
 title = {{MERA}},
 url = {https://doi.org/10.3390/make7030073},
 volume = {7},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:34:23Z},
 year = {2025}
}

@article{ibrahim_understanding_2024,
 abstract = {Early parenting is one of the strongest predictors of child well-being. Online social communities have shown promise in supporting parents across a range of contexts. However, we only have a limited understanding of how posters and commenters interact within a forum, or how well commenter responses can support complex parenting questions, such as attempts to change a child's behaviour or to apply new parenting approaches. We start addressing this gap by combining an empirical analysis of 1 year of parent posts from an exemplar online forum (Mumsnet) with literature on parenting interventions from psychology. In particular, we examine the types of question parents of 2-5 year olds seek help for around their children's behaviour, and the challenges with the support that they do (or do not) receive from the Mumsnet community. Combining empirical and theory-driven insights, we outline an 'information-to-application' gap that conceptually underpins the difficulties observed, and suggest plausible research directions that could address such design problems.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Ibrahim},
 doi = {10.1145/3653690},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keywords = {online support systems},
 month = {apr},
 note = {Place: New York},
 number = {CSCW1},
 title = {Understanding {Online}},
 url = {https://doi.org/10.1145/3653690},
 volume = {8},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:16Z},
 year = {2024}
}

@article{ibrahimzada_alphatrans_2025,
 abstract = {Code translation transforms programs from one programming language (PL) to another. One prominent use case is application modernization to enhance maintainability and reliability. Several rule-based transpilers have been designed to automate code translation between different pairs of PLs. However, the rules can become obsolete as the PLs evolve and cannot generalize to other PLs. Recent studies have explored the automation of code translation using Large Language Models (LLMs). One key observation is that such techniques may work well for crafted benchmarks but fail to generalize to the scale and complexity of real-world projects with inter- and intra-class dependencies, custom types, PL-specific features, etc. We propose AlphaTrans, a neuro-symbolic approach to automate repository-level code translation. AlphaTrans translates both source and test code, and employs multiple levels of validation to ensure the translation preserves the functionality of the source program. To break down the problem for LLMs, AlphaTrans leverages program analysis to decompose the program into fragments and translates them in the reverse call order . We leveraged AlphaTrans to translate ten real-world open-source projects consisting of ⟨836, 8575, 2719⟩ (application and test) classes, (application and test) methods, and unit tests. AlphaTrans breaks down these projects into 17874 fragments and translates the entire repository. 96.40% of the translated fragments are syntactically correct, and AlphaTrans validates the translations’ runtime behavior and functional correctness for 27.03% and 25.14% of the application method fragments. On average, integrated translation and validation takes 34 hours (min=3, max=121) to translate a project, showing its scalability in practice. For the syntactically or semantically incorrect translations, AlphaTrans generates a report including existing translation, stack trace, test errors, or assertion failures. We provided these artifacts to two developers to fix the translation bugs in four projects. They fixed the issues in 20.1 hours on average (5.5 hours for the smallest and 34 hours for the largest project) and achieved all passing tests. Without AlphaTrans, translating and validating such big projects could take weeks, if not months.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Ibrahimzada},
 doi = {10.1145/3729379},
 integrated translation and validation takes 34 hours (min = {3},
 journal = {Proc. ACM Softw. Eng.},
 keywords = {Neuro-Symbolic Code Translation and Validation},
 max = {121) to translate a project},
 month = {jun},
 note = {Place: New York},
 number = {FSE},
 title = {{AlphaTrans}},
 url = {https://doi.org/10.1145/3729379},
 volume = {2},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T06:01:05Z},
 year = {2025}
}

@article{ieva_retrieval-augmented_2024,
 abstract = {Digital-twin platforms are increasingly adopted in energy infrastructure management for smart grids. Novel opportunities arise from emerging artificial intelligence technologies to increase user trust by enhancing predictive and prescriptive analytics capabilities and by improving user interaction paradigms. This paper presents a novel data-driven and knowledge-based energy digital-twin framework and architecture. Data integration and mining based on machine learning are integrated into a knowledge graph annotating asset status data, prediction outcomes, and background domain knowledge in order to support a retrieval-augmented generation approach, which enhances a conversational virtual assistant based on a large language model to provide user decision support in asset management and maintenance. Components of the proposed architecture have been mapped to commercial-off-the-shelf tools to implement a prototype framework, exploited in a case study on the management of a section of the high-voltage energy infrastructure in central Italy.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Ieva},
 doi = {10.3390/smartcities7060121},
 journal = {Smart Cities},
 keywords = {source: Google Scholar},
 note = {Type: Article},
 number = {6},
 pages = {3095 -- 3120},
 title = {A {Retrieval}},
 url = {https://doi.org/10.3390/smartcities7060121},
 volume = {7},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:21:41Z},
 year = {2024}
}

@book{iivanainen_investigating_2024,
 abstract = {e13637 Background: The recent development of advanced LLMs has been suggested to improve patient care across several areas such as clinical-decision support or helping to answer patients’ questions. Hallucinations have been identified as a blocker for the use of LLMs in routine clinical practice. ICL and Retrieval Augmented Generation (RAG) could improve the LLM performance and reduce hallucinations, consecutively making the use of LLMs possible in clinical practice. Methods: A method using ICL and RAG was developed on top of health AI platform (Gosta MedKit) to interpret the most recent ESMO (Dec 2022 for NSCLC, Mar 2021 for SCLC) and NCCN (Nov 2023 for NSCLC and SCLC) clinical guidelines for lung cancer. Guidelines (including tables and diagrams) were curated into a text format, and split and stored into a vector database. OpenAI’s GPT4 Turbo model version gpt-4-1106-preview (GPT4-T), having the knowledge cutoff in April 2023, was used in all implementations. 11 questions about SCLC and 13 questions about NSCLC treatment recommendations and definitions were developed to evaluate the performance of different settings: GPT4-T (existing knowledge of the model), ICL with maximum context (ICL-MC) length (128k tokens) and ICL with RAG (ICL-RAG) heuristically including only the most relevant parts from vector database. Question prompts were generated for different settings and guidelines (ESMO, NCCN and both combined) and two oncologists evaluated 216 different responses and their alignment with ESMO and NCCN guidelines. Results: For responses using ESMO guidelines having oncologists’ consensus, ICL-MC and ICL-RAG respectively provided accurate responses for 83.3% and 79.2% of questions vs. 62.5% for GPT4-T. For responses using NCCN guidelines having oncologist consensus, ICL-RAG provided accurate responses for 83.3%, GPT4-T for 75.0% and ICL-MC for 33.3% of questions. When more flexibility was allowed in results interpretation (alignment either with ESMO or NCCN), GPT4-T provided accurate response for 87.5% vs. 70.8% with ICL-RAG and 58.3% with ICL-MC. No consensus around hallucinations was reported for ICL approaches, whereas GPT4-T hallucinated the response for 4.2% of questions with ESMO guidelines. Conclusions: ICL seems to improve the LLM performance for stricter tasks such as providing responses according to specific guidelines and reducing hallucinations. ICL outperformed GPT4-T in case of ESMO guidelines. This highlights the importance of taking local and latest guidelines into account when LLMs are used across different health systems and regulatory environments. In line with earlier studies, longer context for ICL makes models forget crucial information, which can be mitigated with the use of RAG to improve ICL performance and reduce costs when using the models.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Iivanainen},
 doi = {10.1200/JCO.2024.42.16_suppl.e13637},
 keywords = {source: Google Scholar},
 publisher = {ascopubs.org},
 title = {Investigating large language model ({LLM}},
 url = {https://doi.org/10.1200/jco.2024.42.16_suppl.e13637},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:27:01Z},
 year = {2024}
}

@article{ilagan_virtual_2025,
 abstract = {Diabetic retinopathy (DR) is one of the major causes of blindness in the world. Early detection and treatment can prevent vision loss. In this paper, we propose a novel approach for detecting and classifying the severity of DR using machine learning techniques. We use a dataset of retinal fundus images from the APTOS 2019 Blindness Detection challenge. The images are preprocessed using techniques such as contrast enhancement and noise removal. We extract features using a combination of handcrafted features (e.g., blood vessel segmentation, lesion detection) and deep learning features from a pre-trained ResNet-50 model. These features are then fed into various classifiers including Support Vector Machine (SVM), Random Forest, and Gradient Boosting Machine (GBM). Experimental results show that the GBM classifier achieves the highest accuracy of 92.5% in classifying the severity levels of DR (No DR, Mild, Moderate, Severe, Proliferative). The proposed method outperforms state-of-the-art approaches in terms of accuracy and computational efficiency, making it suitable for deployment in resource-constrained environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Ilagan},
 doi = {10.1007/978-3-031-93415-5_15},
 journal = {Lecture Notes in Computer Science},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {253 -- 262},
 title = {A {Virtual}},
 url = {https://doi.org/10.1007/978-3-031-93415-5_15},
 volume = {15820 LNAI},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:57:09Z},
 year = {2025}
}

@article{ilapaka_comprehensive_2025,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for collaborative model training across distributed devices while preserving data privacy. However, the advent of large models, such as large language models (LLMs), introduces new challenges to FL due to their massive parameter sizes and computational demands. This survey provides a comprehensive overview of FL in the context of large models, highlighting key challenges and recent advancements. We first introduce the fundamentals of FL and large models, followed by an in-depth analysis of the challenges in applying FL to large models, including communication efficiency, model personalization, privacy preservation, and incentive mechanisms. We then review state-of-the-art techniques and methodologies proposed to address these challenges, categorizing them into communication optimization, personalization strategies, privacy-enhancing technologies, and incentive design. Furthermore, we discuss emerging applications of FL with large models in various domains, such as healthcare, finance, and edge computing. Finally, we outline future research directions to further advance FL in the era of large models.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Ilapaka},
 journal = {2025 7th International Congress on …},
 keywords = {source: Google Scholar},
 note = {Publisher: ieeexplore.ieee.org},
 title = {A {Comprehensive}},
 url = {https://ieeexplore.ieee.org/abstract/document/11017017/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:24:20Z},
 year = {2025}
}

@article{ilyas_enhancing_2025,
 abstract = {Large language models produce excellent outputs for queries highly relevant to their training data. Retrieval-augmented generation (RAG) is used to augment this training data with additional contextual information based on additional data. Although RAG improves text generation through context retrieval from this additional data, the basic RAG system has limitations in chunking, hallucinations, and reliance on augmented content for knowledge-intensive tasks. This chapter discusses several advanced techniques to enhance retrieval and generation tasks in an RAG pipeline. The chapter discusses advanced strategies for chunking, vectorization, and search processes. Moreover, reranking, filtering, query transformation, query routing, and response synthesis improve generated responses' relevance, coherence, and accuracy.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0},
 author = {Ilyas},
 doi = {10.4018/979-8-3693-6255-6.ch003},
 keywords = {source: Scopus},
 note = {Type: Book chapter},
 pages = {59 -- 80},
 title = {Enhancing the {RAG}},
 url = {https://doi.org/10.4018/979-8-3693-6255-6.ch003},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:41:32Z},
 year = {2025}
}

@inproceedings{imasaka_effect_2024,
 abstract = {Amodal perception is a critical yet challenging task in computer vision, which aims to perceive and understand the complete 3D shapes of objects, including occluded regions. Existing methods for amodal 3D perception often rely on depth sensors or multi-view images, limiting their applicability in real-world scenarios. In this paper, we propose a novel framework for generalizable amodal 3D Gaussian Splatting (GAmo3D), which reconstructs complete 3D shapes from single-view RGB images without requiring depth information or multi-view supervision. Our approach leverages 3D Gaussian Splatting to represent scenes efficiently and introduces a novel amodal completion module that predicts occluded regions using a diffusion-based generative model conditioned on visible parts. To enhance generalization, we incorporate a cross-scene consistency loss and a shape prior from large-scale 3D datasets. Extensive experiments on benchmarks like ScanNet and ARKitScenes demonstrate that GAmo3D outperforms state-of-the-art methods in amodal 3D reconstruction accuracy and generalization to unseen scenes, achieving up to 15% improvement in IoU metrics.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Imasaka},
 booktitle = {Proceedings of the 2024 {Annual}},
 doi = {10.1145/3673791.3698433},
 isbn = {979-8-4007-0724-7},
 keywords = {large language model},
 note = {event-place: Tokyo},
 pages = {249--258},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Effect of {LLM}},
 url = {https://doi.org/10.1145/3673791.3698433},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:37:34Z},
 year = {2024}
}

@book{indebetou_enhancing_2025,
 abstract = {Äldreomsorgen i Sverige står inför stora utmaningar med en åldrande befolkning och ökande krav på kvalitet och effektivitet. För att möta dessa utmaningar är det viktigt att utveckla metoder för att mäta och analysera kundnöjdhet bland brukare och anhöriga. Denna uppsats syftar till att utveckla en metod för att mäta och analysera kundnöjdhet inom äldreomsorgen, med fokus på hemtjänsten i en kommun i Västra Götaland.

Metoden baseras på en litteraturstudie och en empirisk undersökning med en enkätundersökning riktad till brukare och anhöriga. Enkätens frågor är utformade för att mäta nöjdhet med olika aspekter av hemtjänsten, såsom bemötande, tillförlitlighet och flexibilitet. Data analyserades med deskriptiv statistik och kvalitativ innehållsanalys.

Resultaten visar att brukare och anhöriga generellt är nöjda med hemtjänsten, men det finns förbättringsområden, särskilt kring kommunikation och individualisering av insatser. Metoden som utvecklats kan användas för kontinuerlig uppföljning och förbättringsarbete inom äldreomsorgen.

Slutsatsen är att en strukturerad metod för kundnöjdhetsmätning är värdefull för att identifiera styrkor och svagheter i tjänsten och därmed bidra till en högre kvalitet i äldreomsorgen.},
 abstract_lang = {sv},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Indebetou},
 keywords = {source: Google Scholar},
 publisher = {diva-portal.org},
 title = {Enhancing {Troubleshooting}},
 url = {https://www.diva-portal.org/smash/record.jsf?pid=diva2:1967184},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:16:57Z},
 year = {2025}
}

@inproceedings{inie_how_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their impressive performance often masks the presence of biases inherited from training data, leading to unfair outcomes in real-world applications. Addressing bias in LLMs is crucial for ensuring equitable and responsible AI deployment. In this paper, we conduct a comprehensive survey on debiasing methods for LLMs, with a particular focus on the fine-tuning stage. We categorize existing debiasing approaches into three main groups: data-centric, model-centric, and post-processing methods. For each category, we delve into the underlying principles, key techniques, strengths, limitations, and empirical insights from recent studies. Furthermore, we identify several open challenges and propose promising future research directions to advance fairness in LLM fine-tuning. Our survey aims to provide researchers and practitioners with a structured understanding of the current landscape and guide future efforts toward developing fairer LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Inie},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3714227},
 isbn = {979-8-4007-1394-1},
 keywords = {AI Hype},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {How {CO2STLY}},
 url = {https://doi.org/10.1145/3706598.3714227},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:30:17Z},
 year = {2025}
}

@article{iranmanesh_llm-assisted_2025,
 abstract = {We present ManiSkill3, a new benchmark for generalist robot manipulation that emphasizes long-horizon tasks requiring complex reasoning and planning. ManiSkill3 consists of 30 diverse manipulation tasks across different object categories, environments, and complexities, with episodes up to 200 steps long. To evaluate progress toward generalist policies, we introduce a new evaluation protocol that measures zero-shot generalization to unseen tasks and environments. We benchmark a range of state-of-the-art methods, including imitation learning, reinforcement learning, and vision-language-action models. Our results show that current approaches achieve low success rates (below 20%) on long-horizon tasks, highlighting key challenges such as sparse rewards, partial observability, and the need for hierarchical planning. We release ManiSkill3 and our baselines to facilitate future research on building generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Iranmanesh},
 journal = {arXiv preprint arXiv:2504.16813},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {{LLM}},
 url = {https://arxiv.org/abs/2504.16813},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:22:08Z},
 year = {2025}
}

@article{irrera_novel_2023,
 abstract = {In the last decade, scholarly graphs became fundamental to storing and managing scholarly knowledge in a structured and machine-readable way. Methods and tools for discovery and impact assessment of science rely on such graphs and their quality to serve scientists, policymakers, and publishers. Since research data became very important in scholarly communication, scholarly graphs started including dataset metadata and their relationships to publications. Such graphs are the foundations for Open Science investigations, data-article publishing workflows, discovery, and assessment indicators. However, due to the heterogeneity of practices (FAIRness is indeed in the making), they often lack the complete and reliable metadata necessary to perform accurate data analysis; e.g., dataset metadata is inaccurate, author names are not uniform, and the semantics of the relationships is unknown, ambiguous or incomplete. This work describes an open and curated scholarly graph we built and published as a training and test set for data discovery, data connection, author disambiguation, and link prediction tasks. Overall the graph contains 4,047 publications, 5,488 datasets, 22 software, 21,561 authors; 9,692 edges interconnect publications to datasets and software and are labeled with semantics that outline whether a publication is citing, referencing, documenting , supplementing another product. To ensure high-quality metadata and semantics, we relied on the information extracted from PDFs of the publications and the datasets and software webpages to curate and enrich nodes metadata and edges semantics. To the best of our knowledge, this is the first ever published resource, including publications and datasets with manually validated and curated metadata.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Irrera},
 doi = {10.1145/3597310},
 issn = {1936-1955},
 journal = {J. Data and Information Quality},
 keywords = {data curation},
 month = {aug},
 note = {Place: New York},
 number = {3},
 title = {A {Novel}},
 url = {https://doi.org/10.1145/3597310},
 volume = {15},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T06:01:10Z},
 year = {2023}
}

@inproceedings{irtiza_llm-sentry_2024,
 abstract = {The atmospheric pressure plasma jet (APPJ) is a promising tool for biomedical applications due to its non-thermal nature and ability to generate reactive species. However, the efficiency of APPJ in producing reactive oxygen and nitrogen species (RONS) is limited by the short plasma lifetime and low electron density. In this study, we investigate the enhancement of RONS production in an APPJ by applying a transverse magnetic field. The APPJ is generated using a dielectric barrier discharge (DBD) configuration with helium gas flow. A neodymium magnet is used to apply a magnetic field perpendicular to the plasma plume. Optical emission spectroscopy (OES) and electrical diagnostics are employed to characterize the plasma. The results show that the magnetic field significantly increases the electron density and reduces the electron temperature, leading to enhanced production of hydroxyl (OH) and nitric oxide (NO) radicals. The mechanism is attributed to the confinement of electrons by the magnetic field, which prolongs their path and increases collision frequency with gas molecules. This enhancement is crucial for improving the efficacy of APPJ in sterilization and wound healing applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Irtiza},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/TPS-ISA62245.2024.00036},
 keywords = {Defense},
 month = {oct},
 pages = {245--254},
 title = {{LLM}},
 url = {https://doi.org/10.1109/tps-isa62245.2024.00036},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:50:20Z},
 year = {2024}
}

@inproceedings{isahagian_publish-subscribe_2023,
 abstract = {Large Language Models (LLMs) have raised the expectations of users to be able to use natural language (NL) to interact with computer systems such as publish/subscribe systems. We introduce a design that extends existing pub/sub paradigms by adding support for NL queries to subscribe to publications of unstructured text messages. To make the system easier for users our system can also customize the notifications},
 address = {New York},
 author = {Isahagian},
 booktitle = {Proceedings of the 24th {International}},
 doi = {10.1145/3626564.3629099},
 isbn = {979-8-4007-0429-1},
