@article{huang_corgpt_2025,
 abstract = {Human action recognition is one of the most challenging tasks in the field of computer vision. In this paper, we propose a novel approach for human action recognition using a combination of dense trajectories and two-stream convolutional neural networks (CNNs). First, we extract dense trajectories from video frames to capture the motion information effectively. These trajectories are then used to compute optical flow features, which are fed into the flow stream of the two-stream CNN architecture. Simultaneously, the RGB frames are processed through the spatial stream to extract appearance features. The features from both streams are fused using a late fusion strategy to obtain a comprehensive representation of the action. The proposed method is evaluated on two widely used benchmark datasets: UCF101 and HMDB51. Experimental results demonstrate that our approach achieves superior performance compared to state-of-the-art methods, with accuracies of 94.2% on UCF101 and 70.5% on HMDB51.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Huang},
 doi = {10.1007/978-981-95-0027-7_24},
 journal = {Lecture Notes in Computer Science},
 keywords = {source: Scopus},
