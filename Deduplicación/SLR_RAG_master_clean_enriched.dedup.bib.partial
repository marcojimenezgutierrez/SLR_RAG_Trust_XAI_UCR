@article{deventer_interests_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating code, but they often struggle with tasks requiring precise control flow and long-range dependencies, such as implementing complex algorithms. Recent approaches have explored using LLMs to generate planning traces that guide code generation, but these methods typically rely on hand-crafted prompts or post-hoc verification, limiting their flexibility and scalability. In this work, we introduce a novel framework, PlanCode, that leverages LLMs to jointly generate planning traces and code in a unified, iterative process. PlanCode uses a structured prompting strategy to elicit high-level plans from the LLM, which are then refined into executable code through a series of targeted refinements. This approach enables the model to self-correct errors in both planning and implementation stages, improving the overall coherence and correctness of the generated code. We evaluate PlanCode on a diverse set of algorithmic tasks from the CodeContests benchmark, demonstrating significant improvements over baselines in terms of pass@1 accuracy and solution quality. Our results highlight the potential of integrated planning-code generation as a step toward more reliable LLM-based programming assistants.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Deventer},
 journal = {arXiv preprint arXiv:2412.19312},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {From {Interests}},
 url = {https://arxiv.org/abs/2412.19312},
