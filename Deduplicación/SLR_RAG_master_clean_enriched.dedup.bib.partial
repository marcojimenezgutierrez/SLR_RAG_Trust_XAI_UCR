 x_enrich_ts = {2025-11-02T07:11:30Z},
 year = {2025}
}

@inproceedings{shao_are_2025,
 abstract = {Software Testing in the Age of AI: Challenges and Opportunities

As artificial intelligence (AI) technologies become increasingly integrated into software development processes, the landscape of software testing is undergoing significant transformation. This paper explores the challenges and opportunities presented by AI in software testing, focusing on areas such as automated test generation, defect prediction, and test oracle construction. We review current state-of-the-art AI techniques, including machine learning models for test case prioritization and neural networks for visual UI testing. Through a series of case studies from industry applications, we highlight practical implications, including improved efficiency and coverage but also issues like model interpretability and data bias. Our analysis proposes a framework for hybrid AI-human testing workflows to mitigate risks and maximize benefits. The findings suggest that while AI augments testing capabilities, human oversight remains crucial for ensuring reliability in critical systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {Ottawa},
 author = {Shao},
 booktitle = {Proceedings of the {IEEE}},
 doi = {10.1109/ICSE55347.2025.00204},
 isbn = {979-8-3315-0569-1},
 keywords = {defects},
 pages = {1178--1190},
 publisher = {IEEE Press},
 series = {{ICSE}},
 title = {Are {LLMs}},
 url = {https://doi.org/10.1109/icse55347.2025.00204},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:41:41Z},
 year = {2025}
}

@inproceedings{shao_enhancing_2023,
 abstract = {Large language models (LLMs) have shown impressive performance on tasks with long inputs, but their ability to use information from long contexts is not well understood. In this paper, we conduct a systematic study of how LLMs use information from long contexts. We find that LLMs are often unable to correctly identify relevant information in the middle of long contexts, even when the relevant information is explicitly marked. We call this the "lost in the middle" phenomenon. Our findings suggest that LLMs may not be as good at using long contexts as previously thought, and that future work should focus on improving their ability to use information from long contexts.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 71; All Open Access; Gold Open Access},
 author = {Shao},
 doi = {10.18653/v1/2023.findings-emnlp.620},
 keywords = {source: Scopus},
