@inproceedings{kim_transdisciplinary_2025,
 abstract = {This paper introduces a novel framework for mitigating gender bias in visual recognition models. We propose a two-stage approach that first identifies biased features in the model's latent space and then applies targeted debiasing techniques using adversarial training and reweighting strategies. Our method achieves significant improvements in fairness metrics, such as demographic parity and equalized odds, while maintaining high accuracy on benchmark datasets like CelebA and UTKFace. Extensive experiments demonstrate the effectiveness of our framework across various architectures, including ResNet and Vision Transformers, highlighting its generalizability to real-world applications in facial recognition and beyond.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
