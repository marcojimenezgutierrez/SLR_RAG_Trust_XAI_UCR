@inproceedings{jia_agentir_2025,
 abstract = {Extended Reality (XR) technologies, encompassing Virtual Reality (VR), Augmented Reality (AR), and Mixed Reality (MR), have seen rapid advancements and widespread adoption across various domains. However, the accessibility of XR remains underexplored, particularly for users with disabilities. This paper presents a comprehensive survey of accessibility in XR, synthesizing existing research, identifying key challenges, and proposing future directions. We categorize accessibility barriers into perceptual, cognitive, motor, and situational impairments, and review current solutions such as adaptive interfaces, multimodal feedback, and inclusive design practices. Our analysis reveals gaps in standardization, evaluation methodologies, and long-term user studies. By highlighting these areas, we aim to guide researchers and practitioners toward more equitable XR experiences that accommodate diverse user needs.},
 abstract_lang = {en},
