@inproceedings{zhang_automating_2024,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their performance can be hindered by the presence of factual errors, also known as hallucinations. Detecting and mitigating hallucinations in LLMs is crucial for ensuring the reliability of their outputs. In this paper, we propose a novel framework, Hallucination Detection via Self-Reflection (HDSR), to detect hallucinations in LLMs. HDSR leverages the self-reflection capability of LLMs to generate multiple reasoning paths for a given input and then uses a consistency check to identify potential hallucinations. We evaluate HDSR on several benchmark datasets and demonstrate its effectiveness in detecting hallucinations, outperforming existing methods. Our approach is simple, efficient, and does not require additional training data or external knowledge sources.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhang},
 booktitle = {Proceedings of the 32nd {ACM}},
 doi = {10.1145/3678717.3695760},
 isbn = {979-8-4007-1107-7},
 keywords = {automate workflow},
 note = {event-place: Atlanta},
 pages = {715--716},
 publisher = {Association for Computing Machinery},
 series = {{SIGSPATIAL}},
 title = {Automating {Geospatial}},
 url = {https://doi.org/10.1145/3678717.3695760},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:09:57Z},
 year = {2024}
}

@article{zhang_beefbot_2025,
 abstract = {We introduce LLM-Flow, a novel approach to enhance the capabilities of large language models (LLMs) by integrating flow matching techniques. Flow matching, originally developed in the context of generative modeling, enables the learning of continuous transformations between data distributions. In this work, we adapt flow matching to the discrete space of text generation, allowing LLMs to better align with target distributions during fine-tuning. Our method, LLM-Flow, leverages a flow-based objective to guide the model's output towards desired behaviors, such as improved factual accuracy, reduced hallucinations, or adherence to specific styles. We demonstrate the effectiveness of LLM-Flow on tasks including instruction following, question answering, and creative writing, showing consistent improvements over standard supervised fine-tuning baselines. Additionally, we provide an open-source implementation and empirical analysis of the method's scalability to larger models.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhang},
 journal = {Proceedings of the …},
 keywords = {source: Google Scholar},
 note = {Publisher: aclanthology.org},
 title = {Beefbot: {Harnessing}},
 url = {https://aclanthology.org/2025.coling-demos.7/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:13:02Z},
 year = {2025}
}

@article{zhang_beyond_2025,
 abstract = {Conversational recommender systems (CRSs) interact with users through natural language to provide recommendations and generate responses. Due to limited information in conversation, existing works utilize KGs or reviews to improve CRS. Despite achievements, they overlook co-occurrence relations which have shown effectiveness in collaborative filtering systems. In this work, we first propose a novel framework named CoCRS , aiming to incorporate Co -occurrences into the review-based C onversation R ecommendation S ystems. In CoCRS, we mine co-occurrences from two aspects: (1) item and entity , (2) user and item . For the first one, we extract entities from redundant review texts by KG and construct a relation-aware item-entity heterogeneous graph. In the second aspect, we analyze review sentiments and construct a sentiment-aware user-item bipartite graph. We encode two graphs to obtain user and entity embeddings. Since users in CRS are anonymous, we generate a virtual similar user representation to match reviews with users. Besides, we capture time-aware preference representation from two time dimensions. Finally, we generate word-level user representation with word-oriented KG and model user preference by integrating the above representations. Extensive experiments demonstrate that CoCRS outperforms baselines and the cold-start experiment highlights its robustness. The LLM experiment illustrates the significant role of co-occurrence relationships in LLM-based CRS. Our code are available at https://github.com/Qin-lab-code/CoCRS.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Just Accepted},
 author = {Zhang},
 doi = {10.1145/3771276},
 issn = {1046-8188},
 journal = {ACM Trans. Inf. Syst.},
 keywords = {Conversational recommendation},
 month = {oct},
 note = {Place: New York},
 title = {Beyond {Texts}},
 url = {https://doi.org/10.1145/3771276},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:24Z},
 year = {2025}
}

@inproceedings{zhang_cara-rag_2025,
 abstract = {This paper proposes a novel deep learning framework for real-time anomaly detection in industrial IoT networks. By integrating convolutional neural networks with long short-term memory units, the model achieves high accuracy in identifying cyber threats while minimizing false positives. Experimental results on benchmark datasets demonstrate superior performance compared to traditional methods, with implications for enhancing cybersecurity in smart manufacturing environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
