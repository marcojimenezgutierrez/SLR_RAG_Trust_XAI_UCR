@inproceedings{nurhayati_performance_2024,
 abstract = {Abstract—With the rapid development of artificial intelligence technology, the application of deep learning in the field of medical image segmentation has become a research hotspot. However, due to the complex structure and fuzzy boundaries of medical images, the accuracy of segmentation is often not ideal. To address this issue, this paper proposes a medical image segmentation model based on an improved U-Net network structure. First, the ResNet residual module is introduced into the encoder to enhance the feature extraction capability of the network. Second, the attention mechanism is added to the decoder to focus on the important features and suppress irrelevant features. Finally, the Dice loss function is used to optimize the model training process. Experimental results on the ISIC2018 dataset show that the proposed model achieves a Dice coefficient of 92.3%, which is 3.2% higher than the original U-Net model, demonstrating the effectiveness of the proposed method.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
