}

@inproceedings{wallat_correctness_2025,
 abstract = {Visual Question Answering (VQA) systems have achieved remarkable success in recent years, but they often exhibit biases toward specific answer categories, leading to poor generalization on out-of-distribution data. Existing debiasing methods primarily focus on reducing reliance on spurious image-answer correlations, yet they overlook the fairness aspect concerning demographic attributes in the images. In this paper, we introduce FairVQA, a novel framework that mitigates bias in VQA models by incorporating fairness constraints during training. We propose a fairness-aware adversarial training approach that adversarially learns to remove sensitive attribute information from the visual features while preserving task-relevant information. To balance fairness and accuracy, we employ a multi-objective optimization strategy that jointly optimizes the VQA objective and the fairness discriminator loss. Extensive experiments on the VQA-CP dataset demonstrate that FairVQA significantly reduces bias across demographic groups, achieving up to 15% improvement in worst-group accuracy while maintaining competitive overall performance compared to state-of-the-art methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 0},
 author = {Wallat},
 booktitle = {Proceedings of the 2025 {International}},
