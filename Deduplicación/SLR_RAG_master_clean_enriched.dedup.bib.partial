@book{andersson_bridging_2024,
 abstract = {Digital transformation has become a critical imperative for organizations across industries, driven by rapid technological advancements and changing customer expectations. This thesis investigates the impact of digital transformation on organizational culture within the context of a Swedish bank. Using a qualitative case study approach, data were collected through semi-structured interviews with 15 employees at various organizational levels. The findings reveal that digital transformation influences organizational culture by fostering innovation, agility, and customer-centricity, while simultaneously challenging traditional norms, values, and behaviors. Key changes include a shift towards collaborative and data-driven decision-making, but also tensions arising from resistance to change and skill gaps. The study contributes to the literature by providing empirical insights into the cultural dynamics of digital transformation in a Nordic financial institution and offers practical recommendations for managing cultural shifts during such initiatives.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Andersson},
 keywords = {source: Google Scholar},
