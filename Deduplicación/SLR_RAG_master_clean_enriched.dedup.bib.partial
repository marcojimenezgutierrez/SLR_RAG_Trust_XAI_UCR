 year = {2024}
}

@inproceedings{qiu_unearthing_2024,
 abstract = {Recent advances in large language models (LLMs) have demonstrated impressive capabilities in generating human-like text. However, these models often exhibit biases inherited from their training data, leading to unfair outputs in downstream applications. In this paper, we propose a unified framework for fairness-aware fine-tuning of LLMs that integrates multiple fairness criteria, including demographic parity, equalized odds, and counterfactual fairness. Our approach leverages a novel regularization term that balances model performance with fairness constraints during the fine-tuning process. Through extensive experiments on benchmark datasets such as GLUE and BiasBench, we show that our method achieves significant reductions in bias metrics while maintaining competitive accuracy. Furthermore, we provide theoretical guarantees on the convergence of our optimization procedure and discuss practical implications for deploying fair LLMs in real-world scenarios.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
