@article{bu_rb-rag_2025,
 abstract = {This chapter presents a novel approach to enhancing the security of Internet of Things (IoT) devices through blockchain integration. We propose a decentralized framework that leverages smart contracts to manage access control and data integrity in resource-constrained environments. The methodology involves a hybrid consensus mechanism combining proof-of-stake and lightweight proof-of-authority to balance efficiency and security. Experimental results demonstrate a 40% reduction in latency compared to traditional centralized systems, while maintaining high resilience against common attacks such as DDoS and man-in-the-middle. The framework is evaluated on a simulated IoT network with 100 nodes, showing promising scalability for real-world deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
