@inproceedings{hussain_mitigating_2025,
 abstract = {This paper proposes a novel framework for adaptive control in multi-agent robotic systems, addressing challenges in dynamic environments. By integrating reinforcement learning with graph neural networks, the approach enables real-time coordination and fault tolerance among agents. Simulation results demonstrate improved performance in terms of convergence speed and robustness compared to traditional methods. The framework is validated on a swarm robotics platform, showing potential applications in industrial automation and search-and-rescue operations.},
