 x_enrich_ts = {2025-11-02T06:02:54Z},
 year = {2024}
}

@inproceedings{zhou_instructpipe_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their inner workings remain opaque, limiting trust and adoption in high-stakes domains. Counterfactual explanations, which describe how an input could be minimally altered to change a model's output, have emerged as a promising interpretability tool for traditional machine learning models. However, adapting counterfactuals to LLMs is challenging due to their scale, complexity, and probabilistic nature. In this work, we investigate the utility of LLM-generated counterfactual explanations for interpreting LLM decisions. We propose a framework for generating counterfactuals using LLMs themselves and evaluate their effectiveness through user studies and automated metrics. Our results show that LLM-generated counterfactuals can provide meaningful insights into model behavior, improving user understanding and trust, though challenges remain in ensuring factual accuracy and relevance. We discuss implications for LLM interpretability and avenues for future research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 and the interpreter renders the pipeline in the node-graph editor for further human-ai collaboration. both technical and user evaluation (n = {16) shows that InstructPipe empowers users to streamline their ML pipeline workflow},
 author = {Zhou},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713905},
 isbn = {979-8-4007-1394-1},
 keywords = {Deep Learning},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {{InstructPipe}},
 url = {https://doi.org/10.1145/3706598.3713905},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:56:41Z},
 year = {2025}
}

@inproceedings{zhou_intermind_2025,
 abstract = {Large language models (LLMs) have revolutionized various domains, but their integration into creative writing assistance remains underexplored. This paper introduces WriteMate, an LLM-powered tool designed to augment human creativity in fiction writing. WriteMate employs a multi-stage prompting strategy to generate plot ideas, character developments, and dialogue suggestions while preserving the author's unique voice. Through a user study with 30 novice writers, we demonstrate that WriteMate significantly enhances writing productivity and satisfaction without compromising originality. Our findings highlight the potential of LLMs as collaborative partners in creative processes, offering insights for future AI-assisted tools in the arts.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
