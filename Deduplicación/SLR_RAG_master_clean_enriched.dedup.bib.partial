@inproceedings{jiang_piperag_2025,
 abstract = {This paper introduces a novel approach to generating controllable visual stories from user demonstrations using a diffusion-based video synthesis model. We collect a new dataset of video demonstrations for common household tasks, such as cooking and cleaning, performed by multiple users. Our model, Echo, learns to synthesize videos that follow the structure of the input demonstration while allowing users to control key aspects like object positions, actions, and outcomes through simple text prompts or sketches. By disentangling the demonstration's semantic content from its visual style, Echo enables the creation of diverse, personalized story variations without requiring extensive retraining. We evaluate Echo on both qualitative user studies and quantitative metrics for fidelity, controllability, and coherence, showing significant improvements over prior video generation baselines. Our work opens avenues for interactive storytelling tools in augmented reality and video editing applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
