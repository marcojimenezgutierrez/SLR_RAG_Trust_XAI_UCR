@inproceedings{shen_retrieval-augmented_2025,
 abstract = {Data visualization is a powerful tool for exploring and communicating insights from data, but creating effective visualizations often requires expertise in both data analysis and visual design. Visual programming languages (VPLs) for data visualization aim to make this process more accessible by allowing users to create visualizations through direct manipulation of graphical elements. However, existing VPLs often fall short in supporting the full range of visualization tasks, particularly for interactive and dynamic visualizations. In this paper, we explore the design space of VPLs for interactive data visualization. We identify key challenges in current approaches, including limited expressiveness, steep learning curves, and poor integration with data processing pipelines. Through a series of design studies and prototypes, we propose a new framework that combines declarative specifications with direct manipulation interfaces, enabling users to iteratively refine visualizations while maintaining code readability and modularity. Our evaluation with domain experts and novice users demonstrates improved usability and expressiveness compared to state-of-the-art tools like Vega-Lite and Lyra.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Shen},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3731957},
