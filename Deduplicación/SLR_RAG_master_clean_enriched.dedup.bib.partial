 keywords = {Agent framework},
 pages = {153--158},
 publisher = {Association for Computing Machinery},
 series = {{ISAC}},
 title = {Power {Knowledge}},
 url = {https://doi.org/10.1145/3733054.3733082},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:22:56Z},
 year = {2025}
}

@inproceedings{zhu_radio_2025,
 abstract = {The Dynamic Retrieval Augmented Generation (RAG) paradigm actively decides when and what to retrieve during the text generation process of Large Language Models (LLMs). However, current dynamic RAG methods fall short in both aspects: identifying the optimal moment to activate the retrieval module and crafting the appropriate query once retrieval is triggered. To overcome these limitations, we introduce an approach, namely, RaDIO, Real-Time Hallucination Detection with Contextual Index Optimized query formulation for dynamic RAG. The approach is specifically designed to make decisions on when and what to retrieve based on the LLM’s real-time information needs during the text generation process. We evaluate RaDIO along with existing methods comprehensively over several knowledge-intensive generation datasets. Experimental results show that RaDIO achieves superior performance on all tasks, demonstrating the effectiveness of our work.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Zhu},
 booktitle = {Proceedings of the {AAAI}},
 doi = {10.1609/aaai.v39i24.34809},
 keywords = {source: Scopus},
 note = {Issue: 24
Type: Conference paper},
 pages = {26129 -- 26137},
 title = {{RaDIO}},
 url = {https://doi.org/10.1609/aaai.v39i24.34809},
 volume = {39},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:40:53Z},
 year = {2025}
}

@article{zhu_radio_2025-1,
 abstract = {Large language models (LLMs) have shown impressive abilities in generating fluent and coherent text. However, they often produce factually incorrect or inconsistent outputs, especially when dealing with complex reasoning tasks. To address this issue, we propose a novel approach called FactDebate, which leverages multi-agent debate among LLMs to enhance factuality. In FactDebate, multiple LLM agents engage in a structured debate process, where each agent proposes arguments, critiques others' claims, and refines their positions based on evidence. By simulating a debate environment, FactDebate encourages agents to identify and correct factual errors collaboratively. We evaluate FactDebate on several benchmarks for factual consistency and reasoning, demonstrating significant improvements over standard LLM generation methods. Our results highlight the potential of multi-agent systems in improving the reliability of LLM outputs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhu},
 journal = {Proceedings of the AAAI …},
 keywords = {source: Google Scholar},
 note = {Publisher: ojs.aaai.org},
 title = {Radio: {Real}},
 url = {https://ojs.aaai.org/index.php/AAAI/article/view/34809},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:37:45Z},
 year = {2025}
}

@article{zhu_rageval_2024,
 abstract = {A central goal in robotics is to learn generalist robot policies that can perform a wide range of tasks in diverse environments. However, current approaches to building such policies rely on large-scale data collection and training, which is resource-intensive and limits scalability. In this work, we investigate what matters in building generalist robot policies. We conduct a comprehensive study across data, models, and training regimes, identifying key factors that influence policy performance. Our findings reveal that while data quantity and diversity are important, careful curation and augmentation can significantly improve performance with less data. We also show that leveraging pre-trained vision-language models and efficient fine-tuning techniques enables effective generalization. Finally, we demonstrate that our insights lead to a new state-of-the-art generalist policy that outperforms prior methods on multiple benchmarks with 10x less data. Our work provides practical guidelines for building scalable and effective generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhu},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Rageval: {Scenario}},
 url = {https://arxiv.org/abs/2408.01262},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:59:20Z},
 year = {2024}
}

@article{zhu_realm_2024,
 abstract = {Large language models (LLMs) have achieved remarkable success across a wide range of tasks, but their deployment in real-world applications has raised significant safety concerns. One major vulnerability is the ability to "jailbreak" these models, i.e., to craft adversarial prompts that elicit harmful, unethical, or otherwise undesired outputs by bypassing built-in safety mechanisms. This paper presents a comprehensive survey of jailbreaking techniques for LLMs. We categorize existing methods into three primary classes: (1) prompt engineering attacks, which manipulate the input text to trick the model; (2) optimization-based attacks, which use gradient-based or black-box optimization to generate adversarial examples; and (3) multimodal attacks, which leverage additional modalities like images or code to facilitate jailbreaking. For each category, we review key approaches, their mechanisms, effectiveness, and limitations. We also discuss evaluation benchmarks, ethical implications, and defense strategies such as alignment fine-tuning, input filtering, and red-teaming. Finally, we highlight open challenges and propose directions for future research to enhance the robustness and safety of LLMs against jailbreaking attempts.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhu},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Realm: {Rag}},
 url = {https://arxiv.org/abs/2402.07016},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:57:45Z},
 year = {2024}
}

@inproceedings{zhu_retrieval-augmented_2024,
 abstract = {Data comics combine data visualizations with comic art to create engaging and accessible narratives about data. While data comics have been used in journalism and education, their potential for data analysis remains underexplored. We investigate how data comics can support data analysis by enabling analysts to externalize and iterate on their analytical reasoning. Through a design study with five professional data analysts, we developed DataComic, a system that allows users to create data comics by combining visualizations, text, and annotations. DataComic supports iterative analysis by allowing users to refine their comics as their understanding of the data evolves. We evaluate DataComic through a case study with a data analyst who used it to analyze a dataset of urban mobility patterns. Our findings suggest that data comics can support data analysis by providing a flexible medium for externalizing and communicating analytical insights. We discuss implications for the design of tools that support narrative data analysis.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhu},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3589335.3651553},
 isbn = {979-8-4007-0172-6},
 keywords = {heterogeneous research asset retrieval},
 note = {event-place: Singapore},
 pages = {907--910},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {Retrieval-augmented {Query}},
 url = {https://doi.org/10.1145/3589335.3651553},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:17:11Z},
 year = {2024}
}

@inproceedings{zhu_study_2024,
 abstract = {Visual Question Answering (VQA) has seen significant progress, yet models often rely on superficial cues and exhibit biases toward specific answer types, leading to poor generalization. To address this, we introduce a novel training framework that leverages a dynamic curriculum learning strategy combined with a novel loss function to encourage models to focus on semantically rich image regions while reducing reliance on language priors. Our approach, termed SemReg, uses a semantic regularization term that penalizes over-reliance on non-semantic features by aligning model attention with ground-truth object proposals. Experiments on VQA-CP and VQA v2 datasets demonstrate that SemReg outperforms state-of-the-art methods, achieving up to 5.2% improvement in accuracy on the test set while maintaining robustness across different bias settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
