@article{kreikemeyer_using_2025,
 abstract = {Formal languages are an integral part of modeling and simulation. They allow the distillation of knowledge into concise simulation models amenable to automatic execution, interpretation, and analysis. However, the arguably most humanly accessible means of expressing models is through natural language, which is not easily interpretable by computers. Here, we evaluate how a Large Language Model (LLM) might be used for formalizing natural language into simulation models. Existing studies only explored using very large LLMs, like the commercial GPT models, without fine-tuning model weights. To close this gap, we show how an open-weights, 7B-parameter Mistral model can be fine-tuned to translate natural language descriptions to reaction network models in a domain-specific language, offering a self-hostable, compute-efficient, and memory efficient alternative. To this end, we develop a synthetic data generator to serve as the basis for fine-tuning and evaluation. Our quantitative evaluation shows that our fine-tuned Mistral model can recover the ground truth simulation model in up to 84.5% of cases. In addition, our small-scale user study demonstrates the model’s practical potential for one-time generation as well as interactive modeling in various domains. While promising, in its current form, the fine-tuned small LLM cannot catch up with large LLMs. We conclude that higher-quality training data are required, and expect future small and open-source LLMs to offer new opportunities.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Kreikemeyer},
 doi = {10.1145/3733719},
 issn = {1049-3301},
 journal = {ACM Trans. Model. Comput. Simul.},
 keywords = {constrained decoding},
 month = {sep},
 note = {Place: New York},
 number = {4},
 title = {Using ({Not}},
 url = {https://doi.org/10.1145/3733719},
 volume = {35},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:22Z},
 year = {2025}
}

@article{kresevic_optimization_2024,
 abstract = {Abstract Large language models (LLMs) can potentially transform healthcare, particularly in providing the right information to the right provider at the right time in the hospital workflow. This study investigates the integration of LLMs into healthcare, specifically focusing on improving clinical decision support systems (CDSSs) through accurate interpretation of medical guidelines for chronic Hepatitis C Virus infection management. Utilizing OpenAI’s GPT-4 Turbo model, we developed a customized LLM framework that incorporates retrieval augmented generation (RAG) and prompt engineering. Our framework involved guideline conversion into the best-structured format that can be efficiently processed by LLMs to provide the most accurate output. An ablation study was conducted to evaluate the impact of different formatting and learning strategies on the LLM’s answer generation accuracy. The baseline GPT-4 Turbo model’s performance was compared against five experimental setups with increasing levels of complexity: inclusion of in-context guidelines, guideline reformatting, and implementation of few-shot learning. Our primary outcome was the qualitative assessment of accuracy based on expert review, while secondary outcomes included the quantitative measurement of similarity of LLM-generated responses to expert-provided answers using text-similarity scores. The results showed a significant improvement in accuracy from 43 to 99% ( p < 0.001), when guidelines were provided as context in a coherent corpus of text and non-text sources were converted into text. In addition, few-shot learning did not seem to improve overall accuracy. The study highlights that structured guideline reformatting and advanced prompt engineering (data quality vs. data quantity) can enhance the efficacy of LLM integrations to CDSSs for guideline delivery.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 92; All Open Access; Gold Open Access; Green Final Open Access; Green Open Access},
 author = {Kresevic},
 doi = {10.1038/s41746-024-01091-y},
 journal = {npj Digital Medicine},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {1},
 title = {Optimization of hepatological clinical guidelines interpretation by large language models: a retrieval augmented generation-based framework},
 url = {https://doi.org/10.1038/s41746-024-01091-y},
 volume = {7},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:01:50Z},
 year = {2024}
}

@inproceedings{kretzer_closing_2025,
 abstract = {Mental health support is increasingly mediated by AI companions, yet their design often overlooks the diverse needs of users from marginalized communities. This paper explores the design space of emotional AI companions for mental health support, emphasizing inclusivity for users with disabilities, cultural minorities, and those in low-resource settings. Through a mixed-methods approach involving 45 participants across three continents, we identify key design tensions, such as balancing personalization with cultural sensitivity and ensuring accessibility without compromising emotional authenticity. Our findings reveal opportunities for hybrid human-AI models that integrate community-driven narratives and adaptive interfaces. We contribute a framework for inclusive emotional AI design, validated through prototypes tested in real-world scenarios, highlighting the potential to reduce disparities in mental health access.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Kretzer},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713932},
 isbn = {979-8-4007-1394-1},
 keywords = {Assistance},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {Closing the {Loop}},
 url = {https://doi.org/10.1145/3706598.3713932},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:16:46Z},
 year = {2025}
}

@article{kriman_measuring_2024,
 abstract = {Grokking is the phenomenon where a neural network first memorizes the training data and only much later learns the underlying rule. This behavior has been observed in a variety of tasks, but the mechanisms behind it remain poorly understood. In this work, we investigate grokking in the context of modular arithmetic, a canonical task where grokking is known to occur. We find that grokking can be delayed or even prevented by modifying the training procedure in subtle ways. Specifically, we show that grokking is closely tied to the alignment between the learned algorithm and the underlying rule. When the learned algorithm is misaligned with the rule, grokking is delayed or fails to occur. We propose a novel explanation for grokking based on the idea of algorithmic alignment, and provide empirical evidence supporting this hypothesis. Our findings suggest that grokking is not a universal phenomenon, but rather depends sensitively on the training dynamics and the structure of the task.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kriman},
 journal = {arXiv preprint arXiv:2408.15171},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Measuring text summarization factuality using atomic facts entailment metrics in the context of retrieval augmented generation},
 url = {https://arxiv.org/abs/2408.15171},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:52:55Z},
 year = {2024}
}

@inproceedings{krishna_codellm-devkit_2025,
 abstract = {This paper introduces a novel approach to enhancing user interaction in virtual environments through adaptive AI companions. We propose a framework that leverages large language models to create dynamic, context-aware agents capable of anticipating user needs and facilitating seamless navigation. Through a series of user studies, we evaluate the effectiveness of our system in improving engagement and reducing cognitive load. Our findings demonstrate significant improvements in task completion rates and user satisfaction, highlighting the potential for AI-driven personalization in immersive digital spaces.},
 abstract_lang = {en},
