@inproceedings{neha_exploring_2025,
 abstract = {The rapid growth of Internet of Things (IoT) devices has led to significant challenges in ensuring secure communication and data privacy. This paper proposes a lightweight blockchain-based framework for secure data sharing among IoT devices in smart city environments. The framework utilizes a consortium blockchain to enable decentralized authentication and access control, reducing reliance on central authorities. We introduce an efficient consensus mechanism tailored for resource-constrained IoT nodes, achieving low latency and energy consumption. Experimental evaluations on a simulated smart city network demonstrate that our approach improves security against common attacks by 40% while maintaining a throughput of 150 transactions per second. The results highlight the framework's potential for scalable deployment in real-world IoT applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
