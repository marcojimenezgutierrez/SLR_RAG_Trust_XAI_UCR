@article{william_text_2024,
 abstract = {In the era of big data and advanced artificial intelligence, efficient information retrieval and generation have become paramount. Large Language Models (LLMs) have shown remarkable capabilities in generating human-like text; however, they often suffer from hallucinations and lack of access to up-to-date or domain-specific knowledge. Retrieval-Augmented Generation (RAG) addresses these limitations by combining retrieval mechanisms with generative models, enabling more accurate and contextually relevant responses. This paper explores the implementation of text embedding techniques within the RAG framework, integrated with LLMs, to enhance semantic search and information synthesis. We discuss the architecture, including embedding models like Sentence-BERT and vector databases such as FAISS, and evaluate the system's performance on tasks like question answering and document summarization. Results indicate improved precision and recall, demonstrating the efficacy of this hybrid approach in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {William},
 journal = {International Journal of Advanced Natural …},
 keywords = {source: Google Scholar},
 note = {Publisher: researchgate.net
Type: PDF},
 title = {Text {Embedding}},
 url = {https://www.researchgate.net/profile/Mubarak-Altamimi/publication/381105654_Text_Embedding_Implementation_Using_Retrieval_Augmented_Generation_RAG_Model_Combined_With_Large_Language_Model/links/665c78e30b0d2845747c0fe8/Text-Embedding-Implementation-Using-Retrieval-Augmented-Generation-RAG-Model-Combined-With-Large-Language-Model.pdf},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:49:35Z},
 year = {2024}
}

@article{williams_ai_2025,
 abstract = {Background Antimicrobial resistance (AMR) is a major global health threat, with antimicrobial use in animals contributing to its development and spread. Veterinary surgeons play a key role in antimicrobial stewardship (AMS), but little is known about their attitudes towards AMR and AMS in the UK. Objectives To explore UK veterinary surgeons' attitudes towards AMR and AMS, and identify perceived barriers and facilitators to AMS implementation. Methods An online survey was developed and distributed to UK veterinary surgeons via professional networks, social media and mailing lists. The survey included questions on demographics, attitudes towards AMR, knowledge and confidence in AMS, and perceived barriers and facilitators. Data were analysed using descriptive statistics and thematic analysis for open-ended responses. Results A total of 413 responses were received. Most respondents (91 per cent) agreed that AMR is a serious global problem, and 88 per cent believed that antimicrobial use in veterinary medicine contributes to AMR. However, only 52 per cent felt confident in their knowledge of AMS principles, and 43 per cent reported receiving formal training in AMS. Common barriers to AMS included client expectations for antimicrobials (68 per cent), time constraints in consultations (65 per cent) and lack of diagnostic tests (59 per cent). Facilitators included access to education (78 per cent) and guidelines (75 per cent). Conclusions UK veterinary surgeons demonstrate high awareness of AMR but variable confidence in AMS. Addressing identified barriers through targeted education, improved diagnostics and policy support could enhance AMS implementation in small animal practice.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Williams},
 doi = {10.1002/vetr.5339},
 journal = {Veterinary Record},
 keywords = {source: Scopus},
 note = {Type: Note},
 number = {6},
 pages = {219},
 title = {{AI}},
 url = {https://doi.org/10.1002/vetr.5339},
 volume = {196},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:41:45Z},
 year = {2025}
}

@article{wiratunga_cbr-rag_2024,
 abstract = {Cryptographic Protocols with Strong Asynchrony

We study the problem of implementing secure multiparty computation (MPC) in a setting where the network is asynchronous and the adversary can control the delivery time of all messages. In this setting, the adversary can delay the delivery of any message arbitrarily, but cannot reorder or drop messages. We focus on the case where the number of corrupted parties is bounded by a constant t < n/3, where n is the total number of parties.

Our main result is a protocol that achieves statistical security in this model, assuming a broadcast channel and a common reference string (CRS). The protocol has communication complexity O(n^2 \kappa) and computational complexity O(n \kappa), where \kappa is the security parameter. This is the first statistically secure protocol in this model with polynomial communication complexity.

We also show that our protocol can be extended to achieve computational security under standard assumptions, with improved efficiency. Our results significantly improve upon previous work, which either required stronger synchrony assumptions or had exponential communication complexity.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wiratunga},
 doi = {10.1007/978-3-031-63646-2_29},
 journal = {… Conference on Case …},
 keywords = {source: Google Scholar},
 note = {Publisher: Springer},
 title = {{CBR}},
 url = {https://doi.org/10.1007/978-3-031-63646-2_29},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:22:34Z},
 year = {2024}
}

@article{wojtasik_citeverifier_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) and machine learning (ML) technologies has significantly transformed various sectors, including healthcare. However, the integration of these technologies in healthcare also raises critical ethical concerns that must be addressed to ensure responsible and equitable implementation. This paper explores the ethical implications of AI and ML in healthcare, focusing on key issues such as bias and fairness, privacy and data security, transparency and accountability, and the potential impact on healthcare professionals and patients. By examining these challenges, we aim to provide insights into strategies for mitigating ethical risks and promoting the ethical use of AI and ML in healthcare. Our analysis draws on existing literature, case studies, and regulatory frameworks to highlight the importance of interdisciplinary collaboration and stakeholder engagement in developing ethical guidelines and policies. Ultimately, this work underscores the need for a balanced approach that harnesses the benefits of AI and ML while safeguarding patient rights and societal values.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Wojtasik},
 doi = {10.1007/978-3-031-97570-7_19},
 journal = {Lecture Notes in Computer Science},
 keywords = {source: Scopus},
