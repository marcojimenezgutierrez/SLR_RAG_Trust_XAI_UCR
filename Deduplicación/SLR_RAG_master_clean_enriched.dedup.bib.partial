 year = {2024}
}

@article{ogdu_adaptive_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly impacted various sectors, including healthcare, where AI-driven diagnostic tools are becoming increasingly prevalent. However, the integration of AI in medical diagnostics raises critical concerns regarding data privacy, algorithmic bias, and ethical implications. This paper explores the development of a novel AI framework for early detection of cardiovascular diseases using federated learning to address privacy issues while enhancing model accuracy. We propose a hybrid model combining convolutional neural networks (CNNs) and recurrent neural networks (RNNs) trained on distributed datasets from multiple hospitals. Experimental evaluations on benchmark datasets demonstrate that our approach achieves a 95% accuracy rate, outperforming traditional centralized models by 12%. Furthermore, we discuss the ethical considerations and regulatory challenges in deploying such systems, advocating for interdisciplinary collaboration to ensure equitable and responsible AI adoption in healthcare.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
