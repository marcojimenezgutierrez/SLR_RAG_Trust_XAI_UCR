@article{xu_context-aware_2023,
 abstract = {Medicine is a vast and complex field that encompasses a wide range of tasks, from diagnosing diseases to developing new treatments. The recent success of large language models (LLMs) in a variety of domains has sparked interest in their potential to assist with medical tasks. In this work, we explore the capabilities of Med-PaLM 2, a biomedical and clinical LLM, on a diverse set of medical tasks. We find that Med-PaLM 2 exhibits significant improvements over its predecessor, Med-PaLM, on a range of tasks, including medical question answering, clinical note summarization, and diagnostic dialogue. In particular, Med-PaLM 2 achieves state-of-the-art performance on the MedQA dataset, surpassing the pass rates of physicians on this benchmark. We also introduce a new evaluation framework for biomedical LLMs that includes tasks requiring multi-step reasoning and domain-specific knowledge. Our results demonstrate that Med-PaLM 2 has the potential to be a generalist biomedical AI system that can assist clinicians in a variety of tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Xu},
 journal = {arXiv preprint arXiv:2312.14335},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Context-aware decoding reduces hallucination in query-focused summarization},
 url = {https://arxiv.org/abs/2312.14335},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
