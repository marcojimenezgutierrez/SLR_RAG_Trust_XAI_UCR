 year = {2025}
}

@inproceedings{chen_autokg_2023,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for collaborative machine learning while preserving data privacy, particularly in sensitive domains like healthcare. However, the heterogeneous nature of healthcare data across institutions poses significant challenges to FL implementations. This paper presents a comprehensive survey of FL applications in healthcare, focusing on key challenges such as data heterogeneity, privacy preservation, and regulatory compliance. We categorize existing approaches based on FL architectures, privacy-enhancing techniques, and healthcare-specific use cases, including disease prediction, medical imaging, and electronic health records analysis. Furthermore, we propose a novel FL framework tailored for healthcare, incorporating vertical and horizontal FL strategies with advanced differential privacy mechanisms and secure multi-party computation. Evaluations on benchmark datasets demonstrate that our framework achieves superior performance in terms of accuracy and privacy compared to baseline methods, paving the way for scalable and privacy-preserving AI in healthcare.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Chen},
 booktitle = {2023 {IEEE}},
 doi = {10.1109/BigData59044.2023.10386454},
 keywords = {Big Data},
 month = {dec},
 pages = {3117--3126},
 title = {{AutoKG}},
 url = {https://doi.org/10.1109/bigdata59044.2023.10386454},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:15:32Z},
 year = {2023}
}

@article{chen_automatic_2025,
 abstract = {Database management system (DBMS) configuration debugging, e.g., diagnosing poorly configured DBMS knobs and generating troubleshooting recommendations, is crucial in optimizing DBMS performance. However, the configuration debugging process is tedious and, sometimes challenging, even for seasoned database administrators (DBAs) with sufficient experience in DBMS configurations and good understandings of the DBMS internals (e.g., MySQL or Oracle). To address this difficulty, we propose Andromeda, a framework that utilizes large language models (LLMs) to enable automatic DBMS configuration debugging. Andromeda serves as a natural surrogate of DBAs to answer a wide range of natural language (NL) questions on DBMS configuration issues, and to generate diagnostic suggestions to fix these issues. Nevertheless, directly prompting LLMs with these professional questions may result in overly generic and often unsatisfying answers. To this end, we propose a retrieval-augmented generation (RAG) strategy that effectively provides matched domain-specific contexts for the question from multiple sources. They come from related historical questions, troubleshooting manuals and DBMS telemetries, which significantly improve the performance of configuration debugging. To support the RAG strategy, we develop a document retrieval mechanism addressing heterogeneous documents and design an effective method for telemetry analysis. Extensive experiments on real-world DBMS configuration debugging datasets show that Andromeda significantly outperforms existing solutions.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Chen},
 doi = {10.1145/3709663},
 journal = {Proc. ACM Manag. Data},
 keywords = {database configuration debugging},
 month = {feb},
 note = {Place: New York},
 number = {1},
 title = {Automatic {Database}},
 url = {https://doi.org/10.1145/3709663},
 volume = {3},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:40:55Z},
 year = {2025}
}

@inproceedings{chen_behaviorally_2025,
 abstract = {This paper introduces a novel approach to adaptive user interfaces for mobile devices, focusing on dynamic layout adjustments based on user behavior and context. We present a machine learning framework that predicts optimal UI configurations in real-time, reducing cognitive load and improving task efficiency. Through user studies involving 120 participants, our system demonstrated a 25% increase in interaction speed compared to static interfaces. The framework is implemented as an open-source library compatible with Android and iOS, enabling seamless integration into existing applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 and evaluated it through a mixed-methods approach involving a quantitative question-ranking task (n = {7) and a qualitative focus group (n=4). Findings indicate strong performance for practical},
 author = {Chen},
 booktitle = {Proceedings of the {Mensch}},
 doi = {10.1145/3743049.3748567},
 isbn = {979-8-4007-1582-2},
