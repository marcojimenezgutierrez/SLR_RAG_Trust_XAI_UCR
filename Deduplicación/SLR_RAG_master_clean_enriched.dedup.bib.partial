}

@inproceedings{avula_measuring_2025,
 abstract = {Large language models (LLMs) are increasingly used for complex tasks that require iterative experimentation with prompts. However, existing prompt engineering tools are designed for single prompts and do not support the complex workflows required for iterative experimentation. We introduce ChainForge, a visual toolkit for prompt engineering and LLM hypothesis testing. ChainForge allows users to create, run, and debug complex prompt chains, visualize their execution, and compare results across multiple runs. We evaluate ChainForge with 16 users and find that it helps users create more complex prompt chains, debug issues faster, and gain deeper insights into LLM behavior. ChainForge is open-source and available at chainforge.ai.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
