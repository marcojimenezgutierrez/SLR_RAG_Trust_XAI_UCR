 pages = {272 -- 282},
 title = {{CorGPT}},
 url = {https://doi.org/10.1007/978-981-95-0027-7_24},
 volume = {15866 LNBI},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:53:33Z},
 year = {2025}
}

@article{huang_datagen_2024,
 abstract = {A central goal in machine learning is to understand why models generalize. One of the most important aspects of generalization is the ability to learn from small datasets. In this work, we study the phenomenon of grokking, where a model suddenly generalizes after a long period of overfitting on small algorithmic datasets. We show that grokking occurs in a variety of settings, including modular addition, sparse parity, and sparse linear regression. We find that grokking is driven by a combination of two factors: (1) the model memorizes the training data, and (2) the model learns a general solution that is robust to noise. We also find that grokking can be accelerated by techniques such as weight decay and data augmentation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Huang},
 journal = {The Thirteenth …},
 keywords = {source: Google Scholar},
