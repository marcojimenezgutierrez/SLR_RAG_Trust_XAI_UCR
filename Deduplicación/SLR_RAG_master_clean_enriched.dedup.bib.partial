@inproceedings{rani_enhance_2024,
 abstract = {Abstract—In the era of Industry 4.0, the integration of Internet of Things (IoT) devices with cloud computing has revolutionized industrial processes, enabling real-time monitoring and control. However, this integration introduces significant security challenges, particularly in ensuring secure communication between IoT devices and cloud platforms. This paper proposes a lightweight blockchain-based authentication and key agreement protocol for securing IoT-cloud communications. The protocol leverages elliptic curve cryptography (ECC) for efficient key generation and employs smart contracts to automate authentication processes, reducing computational overhead on resource-constrained IoT devices. We evaluate the proposed protocol using formal security analysis with the AVISPA tool and demonstrate its resistance to common attacks such as man-in-the-middle, replay, and impersonation. Performance analysis shows that our protocol achieves lower communication and computation costs compared to existing schemes, making it suitable for industrial IoT applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
