@inproceedings{dinu_evaluating_2025,
 abstract = {Many people with upper-body mobility impairments (UBMI) use wheelchairs for mobility. However, wheelchair use can lead to secondary complications, such as pressure injuries, due to prolonged sitting. Wearable haptic devices can provide timely feedback to prevent such injuries by alerting users to pressure buildup. Yet, little is known about the design requirements for such devices for people with UBMI. We conducted a co-design study with 12 participants with UBMI to explore the design space of wearable haptics for pressure injury prevention. Through a series of workshops, we identified key design considerations, including placement, intensity, and timing of haptic feedback, as well as social acceptability and comfort. Our findings highlight the need for customizable, unobtrusive haptic interfaces that integrate seamlessly with daily life. We discuss implications for designing inclusive wearable haptics and propose a framework for future development.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Dinu},
 booktitle = {Proceedings of the 18th {ACM}},
 doi = {10.1145/3733155.3734912},
