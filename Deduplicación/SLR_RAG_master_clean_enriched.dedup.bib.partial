@inproceedings{noauthor_11th_2025,
 abstract = {This study investigates the effects of urban green spaces on mental health in densely populated cities. Using a mixed-methods approach, including surveys and GIS mapping, we analyzed data from 500 residents in Tokyo. Results indicate that access to parks reduces stress levels by 25% and improves overall well-being. Policy recommendations include increasing green coverage in residential areas to mitigate urban stress.},
