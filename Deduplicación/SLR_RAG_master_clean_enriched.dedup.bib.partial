@inproceedings{pinto_lessons_2024,
 abstract = {Vision-language models (VLMs) have achieved remarkable success across various multimodal tasks. However, they often inherit and amplify societal biases present in their training data, leading to unfair and discriminatory outcomes. Existing debiasing methods for VLMs are limited in their effectiveness and generalizability. In this paper, we propose a novel debiasing approach, Biased Prompt Debiasing (BPD), which leverages biased prompts to mitigate bias in VLMs. Specifically, BPD identifies biased prompts from the training data and uses them to fine-tune the model, encouraging it to learn unbiased representations. Extensive experiments on multiple datasets demonstrate that BPD significantly reduces bias while maintaining or even improving model performance. Our work provides a simple yet effective strategy for promoting fairness in VLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Pinto},
 booktitle = {Proceedings of the 46th {International}},
 doi = {10.1145/3639477.3639751},
