@inproceedings{weerathunge_optimizing_2025,
 abstract = {This paper proposes a novel framework for autonomous robotic arm control in unstructured environments using reinforcement learning integrated with vision-based perception. The system employs a deep neural network to process RGB-D images from a mounted camera, enabling real-time object detection and pose estimation. We introduce a reward function that balances task completion, energy efficiency, and collision avoidance. Experiments conducted on a simulated UR5 robotic arm demonstrate a 25% improvement in success rate compared to traditional PID control methods, with an average task completion time reduced by 15%. Real-world validation on a physical setup confirms the framework's robustness to lighting variations and occlusions. Future work will explore multi-arm coordination for collaborative tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Weerathunge},
 booktitle = {2025 5th {International}},
 doi = {10.1109/ICARC64760.2025.10963313},
