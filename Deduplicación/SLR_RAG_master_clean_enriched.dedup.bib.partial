@inproceedings{liang_retrieval-augmented_2025,
 abstract = {This paper introduces a novel framework for audio source separation in reverberant environments using a combination of spatial and spectral features. We propose a deep neural network architecture that integrates convolutional recurrent networks with attention mechanisms to enhance separation performance. Experimental results on benchmark datasets demonstrate significant improvements in signal-to-distortion ratio (SDR) and perceptual quality metrics compared to state-of-the-art methods. The approach is particularly effective for real-world applications such as teleconferencing and hearing aids.},
