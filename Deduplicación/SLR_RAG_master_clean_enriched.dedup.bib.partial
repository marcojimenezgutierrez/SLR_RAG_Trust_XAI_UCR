@inproceedings{arabzadeh_benchmarking_2025,
 abstract = {We present Aura, a wearable device that detects and responds to users' emotional states through biofeedback and haptic stimulation. By monitoring heart rate variability and skin conductance, Aura provides subtle vibrations to promote relaxation during stressful moments. In a three-week field study with 24 participants, we found that Aura significantly reduced self-reported anxiety levels by 25% compared to a control condition. Our findings highlight the potential of emotion-aware wearables in everyday mental health support, with implications for designing empathetic technologies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
