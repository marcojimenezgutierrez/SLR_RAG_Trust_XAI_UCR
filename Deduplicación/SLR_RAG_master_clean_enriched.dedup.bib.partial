@inproceedings{lin_jupiter_2025,
 abstract = {Visual Question Answering (VQA) has achieved remarkable progress in recent years. However, the existing VQA models often suffer from bias, leading to unfair answers. In this paper, we propose a novel framework to mitigate bias in VQA. Specifically, we first identify the biased samples in the training set and then design a bi-level optimization strategy to debias the model. Extensive experiments on VQA-CP demonstrate the effectiveness of our method.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
