@article{al-machot_building_2025,
 abstract = {This paper presents a comprehensive survey on the application of explainable artificial intelligence (XAI) techniques in the context of medical imaging. We categorize existing XAI methods into model-agnostic and model-specific approaches, highlighting their strengths and limitations when applied to tasks such as disease diagnosis, segmentation, and classification in modalities like MRI, CT, and X-ray. Key challenges including interpretability trade-offs, clinical validation, and integration with regulatory frameworks are discussed. Furthermore, we outline emerging trends and future directions, emphasizing the need for user-centered XAI designs that enhance trust and adoption in healthcare settings.},
