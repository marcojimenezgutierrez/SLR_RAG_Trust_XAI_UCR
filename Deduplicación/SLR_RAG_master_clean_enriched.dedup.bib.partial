@article{qian_large_2025,
 abstract = {Urban green spaces (UGS) are increasingly recognized for their potential to support mental health, yet the role of UGS quality remains underexplored. This study investigates how the quality of UGS influences mental health outcomes, using data from a large-scale survey in European cities. We employ a novel UGS quality index that incorporates accessibility, biodiversity, maintenance, and amenities. Results from multilevel regression models reveal that higher UGS quality is associated with reduced symptoms of anxiety and depression, particularly among vulnerable populations such as low-income residents and the elderly. The findings underscore the importance of prioritizing quality over mere quantity in urban planning to maximize mental health benefits. Policy implications include targeted investments in UGS maintenance and design to enhance equitable access to high-quality green spaces.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Qian},
 journal = {Automation in Construction},
 keywords = {source: Google Scholar},
 note = {Publisher: Elsevier},
 title = {Large language model-empowered paradigm for automated geotechnical site planning and geological characterization},
 url = {https://www.sciencedirect.com/science/article/pii/S0926580525001438},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:22:50Z},
 year = {2025}
}

@inproceedings{qian_memorag_2025,
 abstract = {Recent advances in vision-language pre-training have demonstrated the effectiveness of masked language modeling (MLM) for vision tasks. However, MLM relies on large-scale image-text pairs, which are expensive to collect and may not generalize well to downstream tasks. In this paper, we propose a novel few-shot masked language modeling framework, EchoMask, that leverages echo state networks (ESNs) to enable efficient adaptation with limited data. ESNs, a type of reservoir computing, provide a lightweight reservoir layer that captures temporal dynamics without extensive training. We integrate ESNs into the masked modeling pipeline, allowing the model to echo and refine representations from few-shot examples. Experiments on benchmarks like Visual Question Answering and Image Captioning show that EchoMask outperforms standard few-shot methods by up to 15% while requiring 10x fewer parameters. Our approach bridges the gap between pre-trained models and few-shot learning, offering a scalable solution for resource-constrained settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Qian},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3696410.3714805},
