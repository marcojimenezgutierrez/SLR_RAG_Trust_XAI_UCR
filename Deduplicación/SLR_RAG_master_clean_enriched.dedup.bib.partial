 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:24:41Z},
 year = {2025}
}

@inproceedings{dewan_llm-driven_2025,
 abstract = {Interactive data visualization tools empower users to explore and analyze data through direct manipulation interfaces. However, creating custom visualizations often requires programming expertise, limiting accessibility. Visual programming languages (VPLs) offer a promising alternative by allowing users to build visualizations through graphical interfaces. Despite their potential, designing effective VPLs for data visualization remains underexplored. In this paper, we investigate the design space of VPLs for interactive data visualization. We first analyze existing VPLs and identify key design dimensions, including representation, composition, and interaction. We then present VizFlow, a novel VPL that embodies these dimensions, enabling users to create complex visualizations through a flow-based interface. Through a user study with 12 participants, we evaluate VizFlow's usability and expressiveness compared to a text-based baseline. Our findings reveal that while VPLs reduce cognitive load for simple tasks, they introduce challenges in scalability and error handling for complex visualizations. We discuss implications for future VPL design, emphasizing the need for hybrid approaches that combine visual and textual elements.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Dewan},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730223},
