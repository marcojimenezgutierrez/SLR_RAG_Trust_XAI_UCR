 x_enrich_ts = {2025-11-02T08:02:51Z},
 year = {2025}
}

@inproceedings{chen_llm-powered_2025,
 abstract = {This paper introduces a novel approach to enhancing the fairness in recommendation systems by integrating fairness constraints directly into the generative process of matrix factorization models. Traditional recommendation algorithms often suffer from bias amplification, leading to unfair recommendations for underrepresented groups. We propose FairGen, a generative model that incorporates adversarial training to mitigate biases while preserving recommendation accuracy. Through extensive experiments on real-world datasets, we demonstrate that FairGen significantly reduces demographic disparities in recommendations without substantial loss in utility metrics. Our method outperforms state-of-the-art fairness-aware baselines in both fairness and performance trade-offs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
