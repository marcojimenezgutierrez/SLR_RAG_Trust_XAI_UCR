 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:05:13Z},
 year = {2024}
}

@inproceedings{kim_thorr_2024,
 abstract = {This study investigates the role of machine learning algorithms in predicting stock market trends using historical data from major indices. We employ various models including random forests, support vector machines, and neural networks to analyze features such as volume, price volatility, and economic indicators. Results demonstrate that ensemble methods outperform individual models with an accuracy of up to 78% in short-term forecasts. The findings suggest practical implications for algorithmic trading and risk management in financial markets.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
