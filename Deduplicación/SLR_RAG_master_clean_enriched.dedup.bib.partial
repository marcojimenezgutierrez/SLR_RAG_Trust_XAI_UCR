@inproceedings{tang_fine-tuning_2024,
 abstract = {Visual Question Answering (VQA) models have achieved impressive performance on various benchmarks. However, recent studies have revealed that these models often exhibit biases toward certain social groups, leading to unfair predictions. Existing debiasing methods for VQA primarily focus on data-level interventions, such as removing or reweighting biased samples, but they often overlook the inherent biases embedded in the model parameters. In this paper, we propose a novel model-level debiasing approach, FairVLM, which mitigates bias in VQA models through fairness-aware regularization. Specifically, we introduce a fairness loss that penalizes biased predictions across demographic groups and a contrastive module that encourages the model to learn unbiased representations. Extensive experiments on multiple VQA datasets demonstrate that FairVLM significantly reduces bias while maintaining or even improving overall accuracy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Tang},
 booktitle = {Proceedings of the 2024 6th {International}},
 doi = {10.1145/3689218.3689235},
