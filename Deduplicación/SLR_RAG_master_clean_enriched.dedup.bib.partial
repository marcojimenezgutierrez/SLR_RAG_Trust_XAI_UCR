@article{he_external_2025,
 abstract = {This paper introduces a novel framework for explainable fuzzy systems using counterfactual explanations. Traditional fuzzy logic models often lack interpretability, making it challenging to understand decision-making processes in complex applications such as medical diagnosis and financial risk assessment. We propose a method that generates counterfactuals by perturbing input features while preserving the fuzzy rule structure, enabling users to comprehend "what-if" scenarios. The approach integrates gradient-based optimization with fuzzy membership functions to ensure linguistic interpretability. Extensive experiments on real-world datasets demonstrate that our framework achieves high fidelity in explanations, outperforming black-box methods like LIME and SHAP in terms of user comprehension and model consistency.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {He},
 doi = {10.1109/TFUZZ.2025.3581205},
