 volume = {37},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:15:04Z},
 year = {2024}
}

@article{leemann_auto-gda_2024,
 abstract = {Generalist robot policies are increasingly capable of performing diverse tasks in unstructured environments. However, current approaches to training such policies rely heavily on large-scale data collection and compute-intensive training procedures. In this work, we investigate what factors are most important for building effective generalist robot policies. We conduct a series of ablations on a state-of-the-art vision-language-action (VLA) model, RT-2, to understand the impact of data quality, quantity, and diversity, as well as model architecture and training objectives. Our findings reveal that high-quality, diverse data is crucial for generalization, while architectural choices like using a vision transformer backbone and cross-attention mechanisms significantly improve performance. We also find that incorporating language grounding and chain-of-thought reasoning enhances the model's ability to follow complex instructions. These insights guide the development of more efficient and effective generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Leemann},
 journal = {arXiv preprint arXiv …},
