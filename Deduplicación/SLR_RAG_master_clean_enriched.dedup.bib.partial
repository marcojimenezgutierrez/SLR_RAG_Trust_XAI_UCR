@inproceedings{mukhlis_novel_2024,
 abstract = {Plant diseases are a major threat to agricultural productivity, causing significant economic losses worldwide. Traditional methods of disease detection rely on manual inspection by experts, which is time-consuming, labor-intensive, and prone to errors. With the advent of deep learning techniques, automated plant disease detection using image processing has gained prominence. This paper proposes a novel deep learning-based approach for detecting plant diseases from leaf images. The proposed model employs a hybrid convolutional neural network (CNN) architecture that combines ResNet and DenseNet layers to extract robust features from leaf images. The model is trained and evaluated on the PlantVillage dataset, which includes images of healthy and diseased leaves from multiple plant species. Data augmentation techniques are applied to enhance the dataset's diversity and prevent overfitting. Experimental results show that the proposed model achieves an accuracy of 98.5%, precision of 98.2%, recall of 98.7%, and F1-score of 98.4%, outperforming state-of-the-art methods such as VGG16, AlexNet, and standard ResNet. The approach demonstrates high potential for real-time deployment in mobile applications for farmers, enabling early disease detection and timely intervention to minimize crop losses.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Mukhlis},
 doi = {10.1109/IDAP64064.2024.10710824},
 keywords = {Accuracy},
 note = {Type: Conference paper},
 title = {A {Novel}},
 url = {https://doi.org/10.1109/idap64064.2024.10710824},
 x_enrich_source = {x-ai/grok-4-fast},
