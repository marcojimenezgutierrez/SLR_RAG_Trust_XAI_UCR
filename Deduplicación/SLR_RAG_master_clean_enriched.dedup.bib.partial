@inproceedings{quinn_accelerating_2025,
 abstract = {People who are blind or low vision (BLV) use their smartphones for wayfinding, but the auditory displays of navigation apps are often overwhelming and disorienting. We investigate how to design auditory displays that support spatial exploration on the go. Through a design workshop with 11 BLV participants, we identified key design goals and generated 20+ ideas. We distilled these into four design dimensions: granularity, multimodality, adaptivity, and interactivity. We then developed prototypes along these dimensions and evaluated them in a field study with 12 BLV participants. Our findings reveal preferences for granular audio that provides just enough detail, multimodal cues that combine speech and non-speech audio, adaptive feedback that responds to user context, and interactive controls for on-demand information. We discuss implications for accessible auditory display design and opportunities for future research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 6},
