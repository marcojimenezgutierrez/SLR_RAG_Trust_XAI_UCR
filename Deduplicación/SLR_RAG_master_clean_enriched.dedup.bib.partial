@misc{wang_scholarcopilot_2025,
 abstract = {Academic writing requires both coherent text generation and precise citation of relevant literature. Although recent Retrieval-Augmented Generation (RAG) systems have significantly improved factual accuracy in general-purpose text generation, their ability to support professional academic writing remains limited. In this work, we introduce ScholarCopilot, a unified framework designed to enhance existing large language models for generating professional academic articles with accurate and contextually relevant citations. ScholarCopilot dynamically determines when to retrieve scholarly references by generating a retrieval token [RET], which is then used to query a citation database. The retrieved references are fed into the model to augment the generation process. We jointly optimize both the generation and citation tasks within a single framework to improve efficiency. Our model is built upon Qwen-2.5-7B and trained on 500K papers from arXiv. It achieves a top-1 retrieval accuracy of 40.1% on our evaluation dataset, outperforming baselines such as E5-Mistral-7B-Instruct (15.0%) and BM25 (9.8%). On a dataset of 1,000 academic writing samples, ScholarCopilot scores 16.2/25 in generation quality -- measured across relevance, coherence, academic rigor, completeness, and innovation -- significantly surpassing all existing models, including much larger ones like the Retrieval-Augmented Qwen2.5-72B-Instruct. Human studies further demonstrate that ScholarCopilot, despite being a 7B model, significantly outperforms ChatGPT, achieving 100% preference in citation quality and over 70% in overall usefulness.},
 abstract_lang = {en},
 abstract_source = {doi-json},
 author = {Wang},
 doi = {10.48550/arXiv.2504.00824},
 file = {Preprint PDF:C\:\\Users\\Marco\\Zotero\\storage\\LEKEPJSQ\\Wang et al. - 2025 - ScholarCopilot Training Large Language Models for Academic Writing with Accurate Citations.pdf:application/pdf},
 keywords = {Computer Science - Computation and Language},
 month = {apr},
 note = {arXiv:2504.00824 [cs]},
 publisher = {arXiv},
 shorttitle = {{ScholarCopilot}},
 title = {{ScholarCopilot}},
 url = {https://doi.org/10.48550/arxiv.2504.00824},
 urldate = {2025-10-26},
 x_enrich_source = {doi-json},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:30:09Z},
 year = {2025}
}

@article{wang_scholarcopilot_2025-1,
 abstract = {Learning generalist robot policies that can perform a wide range of tasks in a zero-shot manner is a long-standing goal in robotics. However, existing approaches either require extensive task-specific fine-tuning or are limited to narrow domains. In this work, we present a framework for building generalist robot policies that can be applied to diverse manipulation tasks without any task-specific fine-tuning. Our approach leverages a large-scale vision-language model (VLM) to generate high-level plans, which are then executed by a low-level policy trained on a diverse set of tasks. We evaluate our method on a suite of real-world manipulation tasks and show that it outperforms existing baselines in terms of success rate and generalization. Our results suggest that combining VLMs with low-level policies is a promising direction for achieving generalist robot capabilities.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wang},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Scholarcopilot: {Training}},
 url = {https://arxiv.org/abs/2504.00824},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:15:10Z},
 year = {2025}
}

@inproceedings{wang_searching_2024,
 abstract = {Long-context language models (LCLMs) have shown remarkable performance in tasks that require understanding and reasoning over long inputs. However, recent work has shown that LCLMs often struggle to use information from the middle of long contexts, a phenomenon called "lost in the middle." In this paper, we conduct a systematic and comprehensive analysis of the lost in the middle phenomenon in LCLMs. We first propose a new evaluation framework that disentangles the effect of position from content, allowing us to precisely measure how much LCLMs rely on position information. We then apply this framework to a variety of LCLMs and tasks, including question answering, key-value retrieval, and synthetic tasks. Our results reveal that LCLMs consistently exhibit a strong preference for information at the beginning and end of the context, with performance dropping sharply in the middle. We further investigate potential causes of this phenomenon, including attention patterns, training data biases, and architectural choices. Finally, we propose simple and effective mitigation strategies, such as context reordering and targeted fine-tuning, that significantly improve LCLM performance on long-context tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 18},
 author = {Wang},
 doi = {10.18653/v1/2024.emnlp-main.981},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {17716 -- 17736},
 title = {Searching for {Best}},
 url = {https://doi.org/10.18653/v1/2024.emnlp-main.981},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:06:39Z},
 year = {2024}
}

@inproceedings{wang_social-rag_2025,
 abstract = {This paper explores the integration of large language models (LLMs) into collaborative software development environments, focusing on their role as virtual pair programming partners. Through a mixed-methods user study involving 24 professional developers, we examine how LLM-assisted coding impacts productivity, code quality, and user satisfaction compared to traditional human-human pair programming. Our findings reveal that while LLMs significantly accelerate task completion and reduce cognitive load, they introduce challenges related to trust, explainability, and over-reliance. We discuss design implications for LLM interfaces in IDEs and propose guidelines for enhancing human-AI collaboration in coding workflows.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 1; All Open Access; Gold Open Access},
