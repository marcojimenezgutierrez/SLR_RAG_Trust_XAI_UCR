}

@article{tavasoli_responsible_2025,
 abstract = {Gemini 1.5 is the most capable and general model in the Gemini family of multimodal large language models. It is capable of reasoning over extremely long contexts, up to 1 million tokens, while retaining state-of-the-art performance. This technical report describes the design and evaluation of Gemini 1.5, including its architecture, training, and performance on various benchmarks. We highlight key innovations such as the use of a new mixture-of-experts architecture and efficient long-context training techniques. Gemini 1.5 achieves leading results on tasks spanning text, image, audio, and video modalities, with particular strengths in long-context understanding and multimodal reasoning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Tavasoli},
 journal = {arXiv preprint arXiv:2504.02165},
 keywords = {source: Google Scholar},
