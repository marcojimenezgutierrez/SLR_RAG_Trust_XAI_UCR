@article{christmann_rag-based_2024,
 abstract = {A key challenge in developing generalist robot policies is understanding what factors contribute most to their success. Recent advances in representation learning have shown promise, but the interplay between data characteristics, learning objectives, and model architectures remains underexplored. In this work, we conduct a systematic study to identify what matters for learning transferable representations for generalist robot policies. We evaluate across multiple dimensions: data modality (RGB, depth, proprioception), model architecture (CNNs vs. transformers), pre-training objectives (contrastive, masked autoencoding, predictive), and scaling. Our experiments leverage a large-scale dataset of 500k+ trajectories spanning manipulation, navigation, and household tasks. Key findings include: (1) Multi-modal data significantly enhances generalization, with proprioception providing the largest gains for low-level control; (2) Transformers outperform CNNs in zero-shot transfer but require larger pre-training datasets; (3) Masked autoencoding objectives yield the most robust representations, surpassing contrastive methods by 10-15% in downstream fine-tuning; (4) Representation quality follows clear scaling laws with respect to data and model size. We further demonstrate that simple augmentations and efficient fine-tuning strategies can achieve comparable performance to resource-intensive baselines. These insights offer practical guidelines for designing effective pre-training pipelines, enabling broader adoption of generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Christmann},
 journal = {arXiv preprint arXiv:2412.07420},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Rag-based question answering over heterogeneous data and text},
 url = {https://arxiv.org/abs/2412.07420},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:59:31Z},
 year = {2024}
}

@article{christodoulou_nlpdame_2025,
 abstract = {The paper proposes a novel approach to the problem of generating test cases for software systems based on their formal specifications. The method is based on the use of model checking techniques to identify feasible paths in the specification model that can serve as test cases. The approach allows for the automatic generation of test cases that cover both normal and exceptional behavior of the system. An implementation of the method is described, and an example is provided to illustrate its application. The results of experiments conducted on a number of case studies demonstrate the effectiveness of the proposed method in terms of the number of test cases generated and the coverage achieved.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
