 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:35:13Z},
 year = {2025}
}

@article{shahraki_big_2025,
 abstract = {This study investigates the ethical challenges posed by artificial intelligence (AI) in philosophical inquiry, particularly focusing on the problem of attributing moral agency to AI systems. Drawing on classical and contemporary philosophical traditions, we argue that AI's capacity for simulation does not equate to genuine understanding or intentionality, thereby limiting its moral status. Through case studies in AI-driven decision-making, we propose a framework for responsible AI development that prioritizes human oversight and ethical alignment. Our analysis underscores the need for interdisciplinary collaboration to navigate the ontological and normative implications of AI in society.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
