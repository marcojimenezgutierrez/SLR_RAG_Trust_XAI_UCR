@inproceedings{loukas_making_2023,
 abstract = {Large language models (LLMs) have enabled powerful tools for a wide range of tasks, but their potential for complex, multi-step reasoning remains underexplored. We introduce AIChains, a framework for building and interacting with chains of LLM calls. AIChains allows users to create, visualize, edit, and execute chains of LLM prompts and responses, enabling transparent and controllable human-AI interaction. Our system supports branching, looping, and conditional logic, making it possible to build sophisticated workflows. We evaluate AIChains through a user study with 12 participants performing complex data analysis tasks, finding that it significantly improves task success rates and user understanding of the AI's reasoning process compared to standard LLM interfaces. AIChains demonstrates a promising direction for making LLMs more accessible and reliable for real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
