@article{shawon_retrieval_2025,
 abstract = {Haptic feedback is a promising technology for enhancing accessibility in virtual reality (VR), but current wearable haptic devices are often designed for users with typical motor abilities, limiting their applicability for people with upper-body mobility impairments. In this paper, we explore the design of wearable haptics for users with upper-body mobility impairments through a two-phase user study. In Phase 1, we conducted semi-structured interviews with 12 participants with upper-body mobility impairments to understand their needs and challenges in using wearable haptics. Based on the findings, we developed design guidelines and prototypes for inclusive wearable haptics. In Phase 2, we evaluated these prototypes with 10 participants with upper-body mobility impairments in a VR navigation task. Our results show that inclusive design significantly improves task performance and user satisfaction compared to standard designs. We discuss implications for future haptic device design and accessibility in VR.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
