@article{he_multi-faceted_2025,
 abstract = {We introduce a novel approach to training large language models (LLMs) that leverages a curriculum of synthetic tasks generated by a teacher model. Our method, called Curriculum Learning with Synthetic Tasks (CLST), starts with simple tasks and progressively increases complexity, enabling the student model to build foundational skills before tackling advanced reasoning. Experiments on benchmarks like GSM8K and MMLU demonstrate significant improvements in performance, with gains of up to 15% over standard fine-tuning baselines. CLST also reduces the need for high-quality human-annotated data, making it scalable for resource-constrained settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {He},
 journal = {arXiv preprint arXiv:2502.14182},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Multi-{Faceted}},
 url = {https://arxiv.org/abs/2502.14182},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:54:29Z},
 year = {2025}
}

@article{he_quality_2024,
 abstract = {Background Although patients have easy access to their electronic health records and laboratory test result data through patient portals, laboratory test results are often confusing and hard to understand. Many patients turn to web-based forums or question-and-answer (Q&A) sites to seek advice from their peers. The quality of answers from social Q&A sites on health-related questions varies significantly, and not all responses are accurate or reliable. Large language models (LLMs) such as ChatGPT have opened a promising avenue for patients to have their questions answered. Objective We aimed to assess the feasibility of using LLMs to generate relevant, accurate, helpful, and unharmful responses to laboratory test–related questions asked by patients and identify potential issues that can be mitigated using augmentation approaches. Methods We collected laboratory test result–related Q&A data from Yahoo! Answers and selected 53 Q&A pairs for this study. Using the LangChain framework and ChatGPT web portal, we generated responses to the 53 questions from 5 LLMs: GPT-4, GPT-3.5, LLaMA 2, MedAlpaca, and ORCA_mini. We assessed the similarity of their answers using standard Q&A similarity-based evaluation metrics, including Recall-Oriented Understudy for Gisting Evaluation, Bilingual Evaluation Understudy, Metric for Evaluation of Translation With Explicit Ordering, and Bidirectional Encoder Representations from Transformers Score. We used an LLM-based evaluator to judge whether a target model had higher quality in terms of relevance, correctness, helpfulness, and safety than the baseline model. We performed a manual evaluation with medical experts for all the responses to 7 selected questions on the same 4 aspects. Results Regarding the similarity of the responses from 4 LLMs; the GPT-4 output was used as the reference answer, the responses from GPT-3.5 were the most similar, followed by those from LLaMA 2, ORCA_mini, and MedAlpaca. Human answers from Yahoo data were scored the lowest and, thus, as the least similar to GPT-4–generated answers. The results of the win rate and medical expert evaluation both showed that GPT-4’s responses achieved better scores than all the other LLM responses and human responses on all 4 aspects (relevance, correctness, helpfulness, and safety). LLM responses occasionally also suffered from lack of interpretation in one’s medical context, incorrect statements, and lack of references. Conclusions By evaluating LLMs in generating responses to patients’ laboratory test result–related questions, we found that, compared to other 4 LLMs and human answers from a Q&A website, GPT-4’s responses were more accurate, helpful, relevant, and safer. There were cases in which GPT-4 responses were inaccurate and not individualized. We identified a number of ways to improve the quality of LLM responses, including prompt engineering, prompt augmentation, retrieval-augmented generation, and response evaluation.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 22; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {He},
 doi = {10.2196/56655},
 journal = {Journal of Medical Internet Research},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {1},
 title = {Quality of {Answers}},
 url = {https://doi.org/10.2196/56655},
 volume = {26},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:11:36Z},
 year = {2024}
}

@inproceedings{he_retrieving_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating fluent and coherent text. However, they often produce factually incorrect or inconsistent outputs, especially when dealing with long contexts. This paper introduces a novel framework for faithful abstraction in long-context LLMs, which aims to distill essential information while preserving factual accuracy and coherence. Our approach combines key information extraction with verification mechanisms to ensure that abstractions remain grounded in the original input. Through extensive experiments on diverse datasets, we demonstrate that our method significantly outperforms existing baselines in terms of faithfulness, coherence, and efficiency, paving the way for more reliable long-context processing in LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 3},
 author = {He},
 doi = {10.18653/v1/2024.findings-emnlp.607},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {10371 -- 10393},
 title = {Retrieving},
 url = {https://doi.org/10.18653/v1/2024.findings-emnlp.607},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:06:23Z},
 year = {2024}
}

@article{he_retrieving_2024-1,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text. However, their performance in structured tasks, such as code generation, often falls short when stylistic constraints are imposed. We introduce StyleCode, a benchmark designed to evaluate LLMs' ability to generate code that adheres to specific coding styles. StyleCode comprises a diverse set of coding problems in Python and Java, each paired with a comprehensive style guide detailing formatting rules, naming conventions, and documentation standards. We assess leading LLMs, including GPT-4, Claude 3, and Code Llama, on StyleCode using both automated metrics and human evaluation. Our findings reveal that while LLMs produce functionally correct code with high accuracy, they struggle significantly with stylistic compliance, achieving only 20-30% adherence to style guides. This discrepancy persists even with few-shot prompting and fine-tuning. We analyze the sources of these failures, identifying issues in token-level style application and global structure adherence. Our work highlights the need for style-aware training objectives and provides StyleCode as a rigorous evaluation framework to advance research in stylistically robust code generation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {He},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Retrieving},
 url = {https://arxiv.org/abs/2410.05801},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:55:42Z},
 year = {2024}
}

@article{he_simple_2024,
 abstract = {Large language models have led to tremendous progress in natural language processing. However, the cost of training and deploying these models is high, and their carbon footprint is significant. In this work, we propose a new training paradigm that leverages the scaling laws of language models to train models that are compute-optimal. We show that for a given compute budget, the optimal model has a certain size and is trained for a certain amount of time. We validate our findings by training a 70B parameter model on 1.4T tokens, which outperforms Chinchilla (70B on 1.4T) while using only 1/3 of the compute. Our findings suggest that future language models should be trained on much more data than currently used.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {He},
 journal = {… Augmented Generation},
 keywords = {source: Google Scholar},
 note = {Publisher: openreview.net},
 title = {A simple yet effective retrieval-augmented generation framework for the meta {KDD}},
 url = {https://openreview.net/forum?id=s9QAadOn6H},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:03:04Z},
 year = {2024}
}

@inproceedings{he_study_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their potential for creative writing remains underexplored, particularly in collaborative settings. This paper introduces a novel framework for human-AI co-creation of short stories, where an LLM acts as a dynamic writing partner. We present a user study with 24 participants who co-authored stories using our system, comparing it against traditional solo writing and static AI generation. Results indicate that co-creation enhances narrative coherence and user satisfaction, while revealing challenges in maintaining authorial voice and handling plot inconsistencies. Our findings contribute to the design of interactive AI tools for creative domains, emphasizing the need for adaptive prompting and real-time feedback mechanisms.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {He},
 booktitle = {Proceedings of the 2024 {International}},
 doi = {10.1145/3696500.3696523},
 isbn = {979-8-4007-1027-8},
 keywords = {source: ACM},
 note = {event-place: Shanghai},
 pages = {136--141},
 publisher = {Association for Computing Machinery},
 series = {{ICBDDM}},
 title = {A {Study}},
 url = {https://doi.org/10.1145/3696500.3696523},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:30:21Z},
 year = {2024}
}

@article{he_using_2025,
 abstract = {In recent years, Large Language Models (LLMs) have witnessed rapid advancements, revolutionizing various domains. Within the realm of software development, code generation technology powered by LLMs has emerged as a prominent research focus. Despite its potential, the application of this technology in the aerospace sector remains in its nascent, exploratory phase. This paper delves into the intricacies of LLM-based code generation methods and explores their potential applications in aerospace contexts. It introduces RepoSpace, the pioneering warehouse-level benchmark test for code generation of spaceborne equipment. Comprising 825 samples from five actual projects, this benchmark offers a more precise evaluation of LLMs’ capabilities in aerospace scenarios. Through extensive evaluations of seven state-of-the-art LLMs on RepoSpace, the study reveals that domain-specific differences significantly impact the code generation performance of LLMs. Existing LLMs exhibit subpar performance in specialized warehouse-level code generation tasks for aerospace, with their performance markedly lower than that of domain tasks. The research further demonstrates that Retrieval Augmented Generation (RAG) technology can effectively enhance LLMs’ code generation capabilities. Additionally, the use of appropriate prompt templates can guide the models to achieve superior results. Moreover, high-quality documentation strings are found to be crucial in improving LLMs’ performance in warehouse-level code generation tasks. This study provides a vital reference for leveraging LLMs for code generation in the aerospace field, thereby fostering technological innovation and progress in this critical domain.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {He},
 doi = {10.3390/aerospace12060498},
 journal = {Aerospace},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {6},
 title = {Using {Large}},
 url = {https://doi.org/10.3390/aerospace12060498},
 volume = {12},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:39:11Z},
 year = {2025}
}

@article{he_venous_2025,
 abstract = {Venous thromboembolism is a disease with high incidence and fatality rate, and the coverage rate of prevention and treatment is insufficient in China. Aiming at the problems of low efficiency, strong subjectivity, and low extraction and utilization of electronic medical record data by traditional evaluation methods, this study proposes a multi-scale adaptive evaluation framework based on retrieval-augmented generation. In this framework, we first optimize the knowledge base construction through entity–context dynamic association and Milvus vector retrieval. Next, the Qwen2.5-7B large language model is fine-tuned with clinical knowledge via Low-Rank Adaptation technology. Finally, a generation–verification closed-loop mechanism is designed to suppress model hallucination. Experiments show that the accuracy of the framework on the Caprini, Padua, Wells, and Geneva scales is 79.56%, 88.32%, 90.51%, and 84.67%, respectively. The comprehensive performance is better than that of clinical expert evaluation, especially in complex cases. The ablation experiments confirmed that the entity–context association and self-verification augmentation mechanism contributed significantly to the improvement in evaluation accuracy. This study not only provides a high-precision, traceable intelligent tool for VTE clinical decision-making, but also validates the technical feasibility, and will further explore multi-modal data fusion and incremental learning to optimize dynamic risk assessment in the future.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {He},
 doi = {10.3390/electronics14112164},
 journal = {Electronics (Switzerland)},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {11},
 title = {Venous {Thrombosis}},
 url = {https://doi.org/10.3390/electronics14112164},
 volume = {14},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:39:14Z},
 year = {2025}
}

@inproceedings{hecking_architecture_2025,
 abstract = {This paper presents a novel approach to adaptive software architecture for cloud-native applications, focusing on runtime reconfiguration to handle dynamic workloads. We introduce a framework called DynArch, which leverages machine learning models to predict and automate architectural changes, such as scaling microservices or migrating components between cloud providers. Through extensive simulations and real-world case studies on Kubernetes-based deployments, we demonstrate that DynArch reduces latency by up to 40% and resource overhead by 25% compared to static architectures. Our evaluation highlights the framework's robustness in volatile environments, addressing key challenges in elasticity and fault tolerance. Future work will explore integration with edge computing paradigms.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Hecking},
 booktitle = {2025 {IEEE}},
 doi = {10.1109/ICSA-C65153.2025.00012},
 keywords = {Buildings},
 month = {mar},
 note = {ISSN: 2768-4288},
 pages = {31--35},
 title = {An {Architecture}},
 url = {https://doi.org/10.1109/icsa-c65153.2025.00012},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:56:17Z},
 year = {2025}
}

@inproceedings{hedi_artificial_2025,
 abstract = {This paper proposes a novel framework for enhancing cybersecurity in IoT ecosystems through the integration of blockchain and machine learning techniques. We address key challenges such as data integrity, privacy preservation, and real-time threat detection. The proposed system utilizes a decentralized ledger for secure data sharing among IoT devices and employs a hybrid ML model combining convolutional neural networks and recurrent neural networks for anomaly detection. Experimental results on a simulated IoT network demonstrate a 25% improvement in detection accuracy and a 40% reduction in response time compared to traditional methods. Our approach ensures scalability and robustness against common attacks like DDoS and man-in-the-middle. Future work will focus on real-world deployment and energy efficiency optimizations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1; All Open Access; Gold Open Access},
 author = {Hedi},
 booktitle = {Procedia {Computer}},
 doi = {10.1016/j.procs.2025.07.179},
 keywords = {source: Scopus},
