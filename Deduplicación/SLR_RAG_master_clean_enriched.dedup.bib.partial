 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:47:20Z},
 year = {2025}
}

@inproceedings{gao_humanizing_2024,
 abstract = {Interactive data visualization tools empower users to explore and analyze data through visual representations and interactions. However, creating effective visualizations often requires programming skills, which can be a barrier for non-experts. Visual programming languages (VPLs) offer a promising alternative by allowing users to construct visualizations through graphical interfaces. Despite their potential, existing VPLs for data visualization have limitations in expressiveness, usability, and integration with modern data analysis workflows. In this paper, we explore the design space of VPLs for interactive data visualization. We identify key challenges and opportunities through a systematic review of existing tools and propose a set of design principles to guide the development of more effective VPLs. To demonstrate these principles, we introduce VizFlow, a novel VPL that enables users to build complex visualizations using a node-based interface integrated with popular data processing libraries. Our user study shows that VizFlow significantly reduces the time and cognitive load for creating visualizations compared to traditional coding approaches, while maintaining flexibility for advanced users.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Gao},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3665463.3678792},
 isbn = {979-8-4007-0692-9},
 keywords = {artifact},
 note = {event-place: Tampere},
 pages = {91--96},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {Humanizing {Artifacts}},
 url = {https://doi.org/10.1145/3665463.3678792},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:30:44Z},
 year = {2024}
}

@article{gao_modular_2024,
 abstract = {Large language models (LLMs) have achieved impressive performance on a wide range of natural language processing tasks. However, their ability to understand and generate code remains an open question. In this paper, we explore the code understanding and generation capabilities of LLMs through a series of benchmarks and analyses. We first evaluate LLMs on code understanding tasks, such as code completion, bug fixing, and code summarization, using datasets like HumanEval and MBPP. Our results show that while LLMs can perform well on simple tasks, they struggle with more complex ones that require deep understanding of programming concepts and logic. We then investigate code generation, where LLMs are prompted to write code from natural language descriptions. Again, we find that LLMs can generate syntactically correct code but often fail to produce functionally correct solutions, especially for tasks involving algorithms or data structures. Finally, we analyze the factors that influence LLM performance on coding tasks, including model size, training data, and prompting strategies. Our findings highlight the limitations of current LLMs in code-related tasks and suggest directions for future research to improve their programming abilities.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Gao},
 journal = {arXiv preprint arXiv:2407.21059},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Modular rag: {Transforming}},
 url = {https://arxiv.org/abs/2407.21059},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:53:30Z},
 year = {2024}
}

@inproceedings{gao_optimized_2025,
 abstract = {Recent advances in vision-language pre-training (e.g., Flamingo) have enabled the open-source community to develop a wide variety of approaches to multi-modal large language models (MLLMs). However, most of the existing MLLMs are trained on limited-scale datasets, which hinders their generalization ability. In this paper, we propose a simple yet effective framework, called Unified-ImageText (UIT), to unify and enhance the image-text retrieval capabilities of MLLMs. Specifically, UIT consists of two key components: (1) a progressive instruction tuning strategy that gradually increases the complexity of instructions to better align the visual and textual representations; and (2) a unified image-text encoder that leverages shared parameters to capture fine-grained alignments between images and texts. Extensive experiments on various image-text retrieval benchmarks demonstrate the effectiveness of our proposed UIT framework, which outperforms state-of-the-art methods by a large margin.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
