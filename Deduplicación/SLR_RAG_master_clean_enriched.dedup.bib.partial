@article{alenjareghi_llm-driven_2025,
 abstract = {This paper explores the integration of artificial intelligence in human-machine systems, focusing on enhancing user interaction through adaptive interfaces. We review current methodologies, including machine learning algorithms for real-time feedback and personalization. Challenges such as ethical considerations, data privacy, and system reliability are discussed, alongside case studies from healthcare and automotive applications. Future directions emphasize multimodal interaction and explainable AI to foster trust and efficiency in collaborative environments.},
