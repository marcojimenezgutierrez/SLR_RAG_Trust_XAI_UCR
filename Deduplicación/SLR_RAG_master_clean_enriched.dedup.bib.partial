@inproceedings{rau_context_2025,
 abstract = {We introduce EchoTrace, a novel earbud-based system for continuous respiration monitoring using in-ear acoustic signals. Unlike prior work that relies on specialized hardware or obtrusive sensors, EchoTrace leverages commodity earbuds with built-in microphones to capture subtle acoustic reflections from breathing-induced chest movements. Our approach employs a lightweight signal processing pipeline to extract respiration rate and pattern from the ear canal's acoustic environment, achieving high accuracy (MAE of 0.8 breaths/min) across diverse activities and user anatomies. We evaluate EchoTrace in real-world scenarios, demonstrating its potential for unobtrusive health monitoring in everyday earbud use.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Rau},
