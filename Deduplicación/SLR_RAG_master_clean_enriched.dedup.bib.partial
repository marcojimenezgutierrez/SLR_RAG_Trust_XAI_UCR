@inproceedings{kan_abcm_2025,
 abstract = {Data visualization is a critical tool for understanding complex datasets, yet creating interactive visualizations remains challenging for non-experts. Visual programming languages (VPLs) promise to democratize visualization creation by allowing users to build visualizations through direct manipulation rather than code. However, the design space of VPLs for interactive data visualization is underexplored. We contribute a systematic exploration of this design space through the development and evaluation of VizFlow, a novel VPL that integrates data processing, visualization, and interactivity in a unified canvas. VizFlow enables users to construct dataflows visually, connecting data sources to transformations, marks, and interactions via nodes and wires. Through a study with 12 participants, we found that VizFlow supports rapid prototyping of interactive visualizations and lowers barriers for beginners, while offering scalability for complex tasks. Our work provides design guidelines for VPLs in visualization and an open-source tool to support future research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Kan},
 booktitle = {Proceedings of the 2025 5th {International}},
 doi = {10.1145/3760269.3760353},
 isbn = {979-8-4007-1431-3},
 keywords = {Agent-based system},
 pages = {540--546},
 publisher = {Association for Computing Machinery},
 series = {{ACAIB}},
