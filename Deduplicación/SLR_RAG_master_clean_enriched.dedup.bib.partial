@inproceedings{sharifymoghaddam_rankllm_2025,
 abstract = {Visual Question Answering (VQA) has made significant strides, yet its fairness remains underexplored, potentially leading to biased outcomes in real-world applications. This paper investigates social biases in VQA models, focusing on gender and occupational stereotypes embedded in visual-linguistic reasoning. Through comprehensive analysis on benchmark datasets, we reveal that state-of-the-art models exhibit pronounced biases, particularly in profession-related queries, where female subjects are disproportionately underrepresented in high-status roles. To address this, we introduce FairVQA, a novel framework that integrates counterfactual data augmentation, adversarial debiasing, and fairness-aware fine-tuning. Our approach not only mitigates biases—reducing gender bias by up to 45%—but also preserves or enhances overall VQA performance. Extensive experiments demonstrate the generalizability of FairVQA across diverse datasets and model architectures, paving the way for equitable AI systems in multimodal tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Sharifymoghaddam},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730331},
