 pages = {489 -- 504},
 title = {Development and {Evaluation}},
 url = {https://doi.org/10.1007/978-981-96-5511-3_38},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:47:27Z},
 year = {2025}
}

@article{maklad_retrieval_2025,
 abstract = {The Internet of Things (IoT) has revolutionized various sectors by enabling interconnected devices to collect and exchange data. However, the integration of IoT with cloud computing introduces significant security and privacy challenges, particularly in data sharing scenarios. This chapter proposes a blockchain-based framework for secure data sharing in IoT environments. The framework leverages smart contracts to enforce access control policies and ensure data integrity, while incorporating lightweight cryptographic techniques suitable for resource-constrained IoT devices. We evaluate the proposed system through simulations, demonstrating improved security, reduced latency, and enhanced privacy compared to existing centralized approaches. The results highlight the potential of blockchain technology in addressing key vulnerabilities in IoT-cloud ecosystems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
