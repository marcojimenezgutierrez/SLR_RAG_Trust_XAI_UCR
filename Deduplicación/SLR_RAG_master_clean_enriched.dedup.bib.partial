 title = {Enwar: {A}},
 url = {https://arxiv.org/abs/2410.18104},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:41:42Z},
 year = {2024}
}

@inproceedings{nazar_nextg-gpt_2025,
 abstract = {The rapid growth of Internet of Things (IoT) devices has led to an exponential increase in data generation, necessitating efficient data processing and storage solutions. Traditional cloud-centric approaches face challenges such as latency, bandwidth limitations, and privacy concerns. Fog computing emerges as a promising paradigm to address these issues by bringing computation closer to the data sources. This paper proposes a novel fog computing framework for IoT data management, integrating edge devices, fog nodes, and cloud resources in a hierarchical manner. We introduce an adaptive resource allocation algorithm that dynamically optimizes task offloading based on real-time network conditions and device capabilities. The framework incorporates lightweight machine learning models for anomaly detection and predictive maintenance directly at the fog layer, reducing data transmission to the cloud by up to 70%. Simulation results using NS-3 demonstrate improved latency (average reduction of 45%) and energy efficiency compared to baseline methods. Our approach also ensures data privacy through federated learning techniques, making it suitable for sensitive IoT applications in smart cities and healthcare.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Nazar},
 booktitle = {2025 34th {International}},
 doi = {10.1109/ICCCN65249.2025.11133874},
