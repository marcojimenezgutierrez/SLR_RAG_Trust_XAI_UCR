}

@inproceedings{cao_companykg_2024,
 abstract = {Fairness in visual recognition has become a critical concern due to the widespread deployment of machine learning models in high-stakes applications. Despite significant advancements in bias mitigation techniques, several challenges remain, including the lack of comprehensive evaluation frameworks and the need for effective strategies that balance fairness and performance. In this paper, we propose a novel framework for assessing and improving fairness in visual recognition tasks. Our approach integrates multiple bias mitigation strategies, including adversarial training, reweighting, and data augmentation, and evaluates their impact using a diverse set of fairness metrics. We conduct extensive experiments on benchmark datasets such as CelebA and UTKFace, demonstrating that our combined strategy achieves superior fairness improvements without substantial performance degradation. Furthermore, we introduce a new evaluation protocol that considers intersectional biases, providing deeper insights into model behavior across demographic subgroups. Our findings highlight the importance of holistic approaches to fairness and offer practical guidelines for developing equitable visual recognition systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
