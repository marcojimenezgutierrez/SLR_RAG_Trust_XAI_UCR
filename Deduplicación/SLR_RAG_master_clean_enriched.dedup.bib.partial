@inproceedings{goel_x-lifecycle_2024,
 abstract = {This paper introduces a novel framework for designing inclusive human-AI teams, emphasizing human-centered principles to ensure equitable collaboration. Drawing from interdisciplinary insights in human-computer interaction, psychology, and organizational behavior, we propose a multi-layered design space that addresses key challenges such as trust, transparency, and role allocation in AI-assisted tasks. Through a series of case studies in domains like healthcare and education, we demonstrate how our framework can mitigate biases and enhance team performance. Our contributions include a set of design guidelines, an evaluation methodology, and open-source tools to support practitioners in developing AI teammates that prioritize human agency and diversity.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
