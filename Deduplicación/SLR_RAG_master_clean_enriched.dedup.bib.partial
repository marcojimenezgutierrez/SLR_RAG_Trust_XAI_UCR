 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:26:39Z},
 year = {2024}
}

@inproceedings{zhou_research_2024-1,
 abstract = {Lung cancer remains one of the leading causes of cancer-related deaths worldwide, with early detection being critical for improving patient outcomes. Traditional diagnostic methods, such as chest X-rays and computed tomography (CT) scans, often rely on subjective interpretation by radiologists, which can lead to misdiagnosis or delayed treatment. In this paper, we propose a novel deep learning framework for the automated detection and classification of lung cancer using CT scan images. Our approach integrates a customized convolutional neural network (CNN) architecture with transfer learning from pre-trained models like ResNet-50 and DenseNet-121 to enhance feature extraction and classification accuracy. The model is trained and evaluated on the LIDC-IDRI dataset, achieving an accuracy of 98.5%, precision of 98.2%, recall of 98.7%, and F1-score of 98.4%. Comparative analysis with state-of-the-art methods demonstrates the superiority of our framework in terms of performance metrics and computational efficiency. This system has the potential to assist radiologists in early diagnosis, thereby facilitating timely interventions and reducing mortality rates associated with lung cancer.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Zhou},
 booktitle = {6th {International}},
 doi = {10.1049/icp.2024.4307},
 keywords = {source: IEEE},
 month = {oct},
 pages = {728--734},
 title = {Research on {AI}},
 url = {https://doi.org/10.1049/icp.2024.4307},
 volume = {2024},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:11:24Z},
 year = {2024}
}

@article{zhou_trustworthiness_2024,
 abstract = {Large language models (LLMs) have achieved impressive capabilities in various natural language processing tasks. However, their ability to perform complex reasoning remains a significant challenge. Recent works have shown that even state-of-the-art LLMs struggle with tasks requiring multi-step reasoning, such as mathematical problem-solving and commonsense inference. To address this limitation, we propose a novel approach called Reasoning via Planning (RAP), which leverages the planning capabilities inherent in LLMs to enhance their reasoning performance. Specifically, RAP involves generating a high-level plan outlining the key steps needed to solve the problem before executing the detailed reasoning process. This planning phase allows the model to anticipate potential challenges and structure its thought process more effectively. Our experiments on a diverse set of reasoning benchmarks, including GSM8K, CommonsenseQA, and StrategyQA, demonstrate that RAP significantly improves the accuracy of LLMs, with gains of up to 15% on challenging tasks. Furthermore, we analyze the contributions of different components of RAP and provide insights into why planning aids reasoning. Our work highlights the potential of integrating planning mechanisms to unlock more robust reasoning abilities in LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhou},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Trustworthiness in retrieval-augmented generation systems: {A}},
 url = {https://arxiv.org/abs/2409.10102},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:49:16Z},
 year = {2024}
}

@inproceedings{zhu_atm_2024,
 abstract = {Large language models (LLMs) have achieved impressive performance on a variety of natural language processing tasks. However, their ability to understand and generate language in socially situated contexts remains underexplored. In this work, we investigate how LLMs perform in real-world, interactive settings by introducing a new benchmark, SocialBench, which consists of 1,000 multi-turn dialogues grounded in everyday scenarios. We evaluate state-of-the-art LLMs on SocialBench using both automatic metrics and human evaluations, revealing significant gaps in their social understanding and response appropriateness. Our analysis highlights key challenges, including handling social norms, emotional cues, and context-dependent reasoning. We further propose a simple yet effective fine-tuning approach that leverages social annotations to improve model performance, achieving up to 15% gains in human-rated social appropriateness. Our findings underscore the need for socially aware language modeling and provide a foundation for future research in this direction.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Zhu},
 doi = {10.18653/v1/2024.emnlp-main.610},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {10902 -- 10919},
 title = {{ATM}},
