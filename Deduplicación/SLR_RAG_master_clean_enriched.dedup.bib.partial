@inproceedings{liu_chatchisel_2024,
 abstract = {With the rapid development of 5G and IoT, the number of connected devices is exploding, and the demand for data storage and processing is increasing. Traditional centralized storage methods have problems such as single point of failure, data privacy leakage, and high latency. Blockchain technology, with its decentralization, immutability, and transparency, provides a new solution for data storage and sharing in IoT environments. This paper proposes a blockchain-based secure data sharing scheme for IoT. The scheme uses a consortium blockchain to store metadata and access policies, and uses IPFS to store actual data. Attribute-based encryption is used to encrypt data to achieve fine-grained access control. Smart contracts are used to automate the access control process. The security analysis shows that the scheme can effectively protect data privacy and integrity. The performance evaluation shows that the scheme has low storage overhead and high efficiency.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
