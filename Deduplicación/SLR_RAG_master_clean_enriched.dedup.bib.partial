 x_enrich_ts = {2025-11-02T10:01:41Z},
 year = {2024}
}

@inproceedings{wang_bingo_2025,
 abstract = {Visual Question Answering (VQA) has achieved remarkable progress with the advent of large vision-language models (LVLMs). However, the fairness issue in VQA has been largely overlooked, which may lead to biased predictions and hinder the widespread application of VQA systems. In this paper, we conduct a comprehensive survey on fairness in VQA. We first define the fairness in VQA and categorize the existing fairness-aware VQA methods into three groups: fairness in vision, language, and vision-language alignment. Then, we summarize the commonly used fairness evaluation metrics and datasets. Finally, we discuss the challenges and future directions for fairness in VQA. This survey aims to provide researchers with a comprehensive understanding of fairness in VQA and inspire further research in this direction.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
