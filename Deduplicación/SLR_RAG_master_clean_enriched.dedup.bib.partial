@inproceedings{brachman_building_2025,
 abstract = {This paper presents GenAIC, a framework that integrates generative AI into the frontend development workflow to enhance productivity and creativity. We conducted a formative study with 12 professional frontend developers to understand their current practices and pain points in using generative AI tools. Based on the findings, we designed GenAIC, which consists of three key components: (1) an AI-assisted code generation module that produces context-aware UI code snippets, (2) a visual editing interface for iterative refinement, and (3) a collaboration feature for team-based AI interactions. A user study with 20 developers showed that GenAIC significantly reduced development time by 35% and improved code quality, while also fostering more innovative design outcomes. Our work contributes to the HCI community by demonstrating how generative AI can be seamlessly embedded into professional workflows, with implications for tool design in creative domains.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 and users’ information needs. in our study (n = {24)},
