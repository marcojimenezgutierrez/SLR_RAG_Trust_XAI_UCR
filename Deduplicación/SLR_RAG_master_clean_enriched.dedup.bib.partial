@inproceedings{su_leveraging_2025,
 abstract = {This paper proposes a novel framework for accelerating federated learning in edge computing environments. We introduce a dynamic model aggregation technique that reduces communication overhead by 40% while maintaining model accuracy. Experimental results on benchmark datasets demonstrate the effectiveness of our approach in resource-constrained settings.},
