 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:17:18Z},
 year = {2024}
}

@book{tsai_comparative_2024,
 abstract = {Background: The gut microbiota plays a crucial role in human health, and its dysbiosis is associated with various diseases. Fecal microbiota transplantation (FMT) has emerged as a promising therapeutic strategy for restoring gut microbiota balance, particularly in conditions like Clostridioides difficile infection. However, the mechanisms underlying FMT's efficacy and its broader applications remain incompletely understood.

Methods: In this study, we conducted a comprehensive analysis of the gut microbiota in patients with recurrent Clostridioides difficile infection (rCDI) before and after FMT using 16S rRNA gene sequencing and metagenomic shotgun sequencing. We also investigated the functional changes in the microbiota through metabolomic profiling. Additionally, we explored the impact of FMT on immune responses by measuring cytokine levels and immune cell populations.

Results: Our results demonstrated a significant shift in the gut microbiota composition post-FMT, with an increase in beneficial bacteria such as Bifidobacterium and Lactobacillus, and a decrease in pathogenic taxa. Functional analysis revealed enhanced production of short-chain fatty acids (SCFAs), which correlated with improved clinical outcomes. Immunologically, FMT led to a reduction in pro-inflammatory cytokines and an increase in regulatory T cells, suggesting an immunomodulatory effect.

Conclusions: These findings highlight the multifaceted benefits of FMT in rCDI, involving microbiota restoration, metabolic reprogramming, and immune modulation. Our study provides insights into the therapeutic potential of FMT for other microbiota-related disorders and underscores the need for personalized approaches based on microbiota profiling.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Tsai},
 keywords = {source: Google Scholar},
 note = {Type: PDF},
 publisher = {assets-eu.researchsquare.com},
 title = {Comparative analysis of automatic literature review using {Mistral}},
 url = {https://assets-eu.researchsquare.com/files/rs-4022248/v1_covered_31b35741-397a-47a8-aa52-d71a4150153f.pdf},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:44:13Z},
 year = {2024}
}

@article{tsai_notitle_2025,
 abstract = {In the era of Industry 4.0, the Internet of Things (IoT) has become an integral part of our daily lives, connecting billions of devices and generating vast amounts of data. However, this proliferation has also introduced significant security challenges, particularly in detecting intrusions in IoT networks. Traditional intrusion detection systems (IDS) often struggle with the dynamic and heterogeneous nature of IoT environments. To address these challenges, this paper proposes a novel hybrid deep learning model that combines Convolutional Neural Networks (CNN) and Long Short-Term Memory (LSTM) networks, enhanced with a feature selection mechanism using the Boruta algorithm. The proposed model, named CNN-LSTM-Boruta, is designed to improve the accuracy and efficiency of intrusion detection in IoT networks. The model was evaluated using the CIC-IoT23 dataset, which contains real-world IoT network traffic data. Experimental results demonstrate that the CNN-LSTM-Boruta model achieves superior performance compared to state-of-the-art methods, with an accuracy of 99.85%, precision of 99.84%, recall of 99.86%, and F1-score of 99.85%. The feature selection step significantly reduces the dimensionality of the input data, leading to faster training times and lower computational overhead without compromising performance. This work contributes to the field of IoT security by providing a robust and efficient IDS that can adapt to the evolving threats in IoT ecosystems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Tsai},
 doi = {10.1007/s10586-025-05721-2},
 journal = {Cluster Computing},
 keywords = {source: Scopus},
 note = {Type: Article},
 url = {https://doi.org/10.1007/s10586-025-05721-2},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:31:16Z},
 year = {2025}
}

