@inproceedings{guo_streamlining_2025,
 abstract = {This paper proposes a novel framework for enhancing cybersecurity in IoT ecosystems through advanced machine learning techniques. We introduce a hybrid model combining convolutional neural networks (CNNs) and long short-term memory (LSTM) networks to detect anomalous behavior in real-time. The proposed system is evaluated on benchmark datasets, demonstrating superior accuracy and efficiency compared to existing methods. Experimental results show a detection rate of 98.5% with minimal false positives, making it suitable for resource-constrained devices. Future work will focus on integration with edge computing paradigms.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Guo},
