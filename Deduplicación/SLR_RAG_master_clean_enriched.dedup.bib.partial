 year = {2025}
}

@inproceedings{koziolek_llm-based_2024,
 abstract = {We present Aura, a novel interaction technique that enables users to interact with 3D objects in augmented reality (AR) using mid-air hand gestures without requiring physical controllers or markers. Aura leverages the smartphone's built-in sensors, including the front-facing camera and inertial measurement unit (IMU), to track hand movements and map them to intuitive 3D manipulations. Our approach combines computer vision for hand pose estimation with IMU data fusion for robust tracking in dynamic environments. We conducted a user study comparing Aura to traditional touch-based AR interactions, finding that Aura significantly improves task completion times and user satisfaction for complex 3D object manipulations, such as rotation and scaling, while reducing cognitive load. Aura demonstrates the potential for accessible, controller-free AR experiences on everyday mobile devices.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Koziolek},
 booktitle = {Proceedings of the 1st {International}},
 doi = {10.1145/3643795.3648384},
