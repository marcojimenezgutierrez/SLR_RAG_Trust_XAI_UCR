 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:01:13Z},
 year = {2024}
}

@inproceedings{shi_retrieval-enhanced_2024,
 abstract = {Visual Question Answering (VQA) has made significant progress in recent years. However, the presence of bias in VQA datasets and models has been a major concern, leading to unfair and unreliable performance. In this paper, we conduct a comprehensive survey on bias in VQA. We first categorize different types of biases in VQA, including language bias, vision bias, and decision bias. Then, we review existing methods for detecting and mitigating these biases, discussing their strengths and limitations. Finally, we propose a new benchmark for evaluating fairness in VQA models and outline future research directions to promote fair and robust VQA systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
