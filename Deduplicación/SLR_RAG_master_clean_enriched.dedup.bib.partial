 volume = {31},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T06:01:08Z},
 year = {2024}
}

@inproceedings{bayer_towards_2025,
 abstract = {Visual programming languages (VPLs) promise to make programming more accessible by allowing users to create programs through visual manipulation rather than text-based coding. However, despite decades of research, VPLs have not achieved widespread adoption. We hypothesize that this is due to a lack of systematic exploration of the design space of VPLs. To address this, we conducted a systematic literature review of 142 VPL systems and identified 12 design dimensions that capture the key aspects of VPL design. We then used these dimensions to analyze the design space and identify underexplored areas. Our findings reveal that most VPLs focus on a narrow subset of the design space, leaving opportunities for innovation in areas such as multi-paradigm support, integration with text-based languages, and advanced interaction techniques. This work provides a foundation for future VPL research and design, aiming to make visual programming more expressive, usable, and appealing to a broader audience.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Bayer},
 booktitle = {Proceedings of the 3rd {International}},
 doi = {10.1145/3719159.3721223},
