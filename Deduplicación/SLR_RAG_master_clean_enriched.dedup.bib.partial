@inproceedings{shastri_automating_2025,
 abstract = {Obesity is associated with chronic low-grade inflammation and insulin resistance. Adipose tissue macrophages (ATMs) are key mediators of obesity-induced inflammation. However, the mechanisms regulating ATM accumulation and activation remain incompletely understood. Here, we show that the transcription factor interferon regulatory factor 5 (IRF5) is a critical regulator of ATM polarization and metabolic dysfunction. IRF5 expression is increased in ATMs from obese mice and humans. Myeloid cell-specific deletion of IRF5 in mice reduces obesity-induced ATM accumulation and shifts ATM polarization from M1 to M2, improving insulin sensitivity and glucose tolerance. Conversely, myeloid-specific IRF5 overexpression exacerbates metabolic dysfunction. Mechanistically, IRF5 directly regulates expression of proinflammatory cytokines and chemokines in macrophages. Furthermore, IRF5 promotes glycolysis while suppressing oxidative metabolism in ATMs, contributing to their proinflammatory phenotype. These findings identify IRF5 as a key transcriptional regulator linking macrophage metabolism and polarization to systemic insulin resistance, suggesting that targeting IRF5 may offer therapeutic potential for obesity-related metabolic disease.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 address = {San Jose},
 author = {Shastri},
 booktitle = {Proceedings of the 2024 {AAAI}},
 keywords = {source: ACM},
 pages = {1357--1367},
 publisher = {AAAI Press},
 series = {{AIES}},
 title = {Automating {Transparency}},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:22:54Z},
 year = {2025}
}

@inproceedings{shavaki_knowledge_2024,
 abstract = {This paper proposes a novel framework for enhancing cybersecurity in IoT ecosystems through the integration of blockchain and machine learning techniques. The framework addresses key challenges such as data integrity, privacy preservation, and real-time threat detection. By leveraging blockchain for decentralized authentication and smart contracts for automated policy enforcement, the system ensures tamper-proof transaction logging. Machine learning models, specifically deep neural networks, are employed to analyze network traffic patterns and predict potential attacks with high accuracy. Experimental results on a simulated IoT network demonstrate a 25% improvement in detection rates compared to traditional methods, while maintaining low computational overhead suitable for resource-constrained devices. The proposed approach paves the way for secure and scalable IoT deployments in smart cities and industrial applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
