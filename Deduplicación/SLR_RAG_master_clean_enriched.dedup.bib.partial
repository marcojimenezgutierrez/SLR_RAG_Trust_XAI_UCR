 x_enrich_ts = {2025-11-02T09:13:01Z},
 year = {2024}
}

@inproceedings{obaid_seerahgpt_2024,
 abstract = {Abstract—With the rapid advancement of artificial intelligence (AI) and machine learning (ML), there is a growing need for efficient and scalable data processing frameworks. This paper proposes a novel distributed computing architecture for real-time AI model training using edge devices. We introduce a hybrid federated learning approach that combines centralized coordination with decentralized data processing to minimize latency and enhance privacy. Our framework leverages containerization technologies like Docker and orchestration tools such as Kubernetes to deploy ML models across heterogeneous edge nodes. Experimental results on a simulated IoT network demonstrate a 40% reduction in training time compared to traditional cloud-based methods, while maintaining model accuracy above 95%. The proposed system is particularly suited for applications in smart cities and industrial IoT, where data locality and low-bandwidth constraints are critical.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Obaid},
 booktitle = {2024 18th {International}},
 doi = {10.1109/ICOSST64562.2024.10871159},
 keywords = {source: IEEE},
 month = {dec},
