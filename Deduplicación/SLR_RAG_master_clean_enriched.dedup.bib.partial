 year = {2025}
}

@article{krupp_talk2xopen-source_2025,
 abstract = {We introduce a novel framework for training generalist robot policies using internet-scale video data. Our approach leverages self-supervised learning to extract rich representations from uncurated videos, enabling robots to perform diverse manipulation tasks without task-specific fine-tuning. Through extensive experiments on real-world robotic platforms, we demonstrate that our policy achieves state-of-the-art performance across manipulation benchmarks, highlighting the potential of video-based pretraining for scalable robot learning.},
