@inproceedings{akilesh_multi-agent_2025,
 abstract = {Cloud computing has revolutionized the way data is stored and accessed, but it faces significant security challenges, particularly in data sharing. Traditional methods often lack transparency and trust among participants. This paper proposes a novel approach for secure data sharing in cloud computing using blockchain technology. We integrate blockchain's decentralized ledger with smart contracts to ensure immutable records and automated access control. The proposed system employs attribute-based encryption (ABE) for fine-grained access policies, combined with blockchain for auditability. Experimental results demonstrate that our approach reduces latency by 25% compared to existing solutions while enhancing security against unauthorized access. The framework is evaluated on a simulated cloud environment using Hyperledger Fabric, showing robustness against common attacks like man-in-the-middle and data tampering.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
