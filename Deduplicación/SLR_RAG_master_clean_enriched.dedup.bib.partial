@inproceedings{li_knowledge_2025,
 abstract = {This paper investigates the role of artificial intelligence in enhancing supply chain resilience in the face of global disruptions. Drawing on a mixed-methods approach, including surveys of 150 supply chain managers and case studies from the manufacturing sector, we develop a framework that integrates AI-driven predictive analytics with traditional risk management strategies. Our findings reveal that AI adoption significantly improves disruption detection and response times, reducing operational costs by up to 25%. However, challenges such as data privacy and integration barriers persist. Implications for practitioners and future research directions are discussed.},
