 x_enrich_ts = {2025-11-02T06:45:17Z},
 year = {2024}
}

@inproceedings{espinal_extended_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success across a diverse array of tasks, yet they frequently exhibit biases that can lead to unfair and harmful outcomes. Addressing fairness in LLMs is crucial for their safe and ethical deployment. In this survey, we provide a comprehensive overview of fairness in LLMs, focusing on three key stages: pre-training, fine-tuning, and inference. We categorize existing approaches into mitigation techniques at each stage, including data curation, model architecture modifications, and post-processing methods. Additionally, we discuss evaluation metrics, datasets, and benchmarks for assessing fairness in LLMs. We highlight persistent challenges, such as the tension between fairness and performance, the scarcity of diverse training data, and the need for interdisciplinary collaboration. Finally, we outline promising future directions, including the development of fairness-aware benchmarks, robust evaluation frameworks, and techniques that balance fairness with other desiderata like privacy and efficiency. This survey aims to guide researchers and practitioners in navigating the complex landscape of fairness in LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Espinal},
 booktitle = {Proceedings of the 14th {International}},
 doi = {10.1145/3703790.3703792},
 isbn = {979-8-4007-1285-2},
 keywords = {Data Transformation},
 pages = {10--18},
 publisher = {Association for Computing Machinery},
 series = {{IoT}},
 title = {An {eXtended}},
 url = {https://doi.org/10.1145/3703790.3703792},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:59:20Z},
 year = {2025}
}

@article{esposito_beyond_2024,
 abstract = {Federated learning (FL) enables collaborative model training across distributed clients without sharing raw data, offering a promising solution for privacy-preserving machine learning. However, applying FL to large language models (LLMs) is challenging due to the massive model size, high communication costs, and data heterogeneity. Existing FL methods for LLMs often suffer from slow convergence and suboptimal performance. In this paper, we propose FedLLM, a novel FL framework tailored for LLMs that incorporates adaptive knowledge distillation and dynamic client selection to address these issues. Our approach distills knowledge from the global model to local clients efficiently and selects clients based on their contribution to model improvement. Extensive experiments on benchmark datasets demonstrate that FedLLM achieves faster convergence and better accuracy compared to state-of-the-art baselines, while maintaining strong privacy guarantees.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
