@article{tamber_benchmarking_2025,
 abstract = {Building generalist robot policies that can perform a variety of tasks in a zero-shot manner is a grand challenge in robotics. Recent advances in large language models (LLMs) and vision-language models (VLMs) have shown promise in this direction, but their application to robotics remains limited. In this work, we study what matters in building robot foundation models. We first introduce a new benchmark, RoboFEx, which consists of 100 diverse, long-horizon tasks spanning manipulation, navigation, and interaction. We then train a series of robot foundation models on large-scale data and evaluate them on RoboFEx. Our findings reveal that scaling data and model size leads to significant improvements, but the choice of data modality and architecture is crucial. Specifically, models that integrate visual and language inputs perform best, and incorporating proprioceptive data further boosts performance. We also find that pre-training on simulation data followed by fine-tuning on real data is effective. Finally, we release our models and data to facilitate future research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Tamber},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Benchmarking {LLM}},
 url = {https://arxiv.org/abs/2505.04847},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:12:58Z},
 year = {2025}
}

@article{tampubolon_retrieval_2025,
 abstract = {This paper proposes a novel framework for enhancing data security in cloud computing environments using blockchain technology. The framework integrates smart contracts to automate access control and ensures data integrity through distributed ledger mechanisms. Experimental results demonstrate a 30% improvement in response time and a significant reduction in unauthorized access attempts compared to traditional methods. The approach is scalable and suitable for enterprise-level applications.},
