 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:54:01Z},
 year = {2025}
}

@inproceedings{chakrabarti_inside_2025,
 abstract = {Virtual reality (VR) has become increasingly popular, but its accessibility for users with visual impairments remains limited. While audio-based navigation aids exist, they often fail to provide the spatial awareness needed for complex environments. We introduce HapticGuide, a wearable haptic navigation system designed to assist visually impaired users in VR. HapticGuide uses a belt of eight vibration motors to deliver directional cues, allowing users to navigate virtual spaces intuitively through tactile feedback. In a user study with 12 visually impaired participants, we found that HapticGuide significantly improved navigation performance compared to audio-only guidance, with users reporting higher confidence and lower cognitive load. Our findings highlight the potential of haptic interfaces to enhance VR accessibility and inform future inclusive design practices.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Chakrabarti},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730315},
 isbn = {979-8-4007-1592-1},
 keywords = {children},
 note = {event-place: Padua},
 pages = {3244--3254},
 publisher = {Association for Computing Machinery},
