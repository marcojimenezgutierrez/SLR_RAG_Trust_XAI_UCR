 doi = {10.1145/3726302.3731969},
 isbn = {979-8-4007-1592-1},
 keywords = {data efficiency},
 note = {event-place: Padua},
 pages = {4385--4389},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Data-efficient {Meta}},
 url = {https://doi.org/10.1145/3726302.3731969},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:03:26Z},
 year = {2025}
}

@article{belkhouribchia_large_2025,
 abstract = {The integration of large language models (LLMs) into clinical nutrition marks a transformative advancement, offering promising solutions for enhancing patient care, personalizing dietary recommendations, and supporting evidence-based clinical decision-making. Trained on extensive text corpora and powered by transformer-based architectures, LLMs demonstrate remarkable capabilities in natural language understanding and generation. This review provides an overview of their current and potential applications in clinical nutrition, focusing on key technologies including prompt engineering, fine-tuning, retrieval-augmented generation, and multimodal integration. These enhancements increase domain relevance, factual accuracy, and contextual responsiveness, enabling LLMs to deliver more reliable outputs in nutrition-related tasks. Recent studies have shown LLMs’ utility in dietary planning, nutritional education, obesity management, and malnutrition risk assessment. Despite these advances, challenges remain. Limitations in reasoning, factual accuracy, and domain specificity, along with risks of bias and hallucination, underscore the need for rigorous validation and human oversight. Furthermore, ethical considerations, environmental costs, and infrastructural integration must be addressed before widespread adoption. Future directions include combining LLMs with predictive analytics, integrating them with electronic health records and wearables, and adapting them for multilingual, culturally sensitive dietary guidance. LLMs also hold potential as research and educational tools, assisting in literature synthesis and patient engagement. Their transformative promise depends on cross-disciplinary collaboration, responsible deployment, and clinician training. Ultimately, while LLMs are not a replacement for healthcare professionals, they offer powerful augmentation tools for delivering scalable, personalized, and data-driven nutritional care in an increasingly complex healthcare environment.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Belkhouribchia},
 doi = {10.3389/fnut.2025.1635682},
 journal = {Frontiers in Nutrition},
 keywords = {source: Scopus},
 note = {Type: Review},
 title = {Large language models in clinical nutrition: an overview of its applications},
 url = {https://doi.org/10.3389/fnut.2025.1635682},
 volume = {12},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:51:24Z},
 year = {2025}
}

@article{belyi_luna_2024,
 abstract = {Generalist robot policies that can solve a wide variety of tasks are a promising approach to enabling robots to perform diverse and complex activities in unstructured environments. However, current methods for training such policies often require large amounts of data and compute, and they struggle to generalize to novel tasks. In this work, we investigate what factors are most important for building generalist robot policies. We conduct a series of experiments on a set of simulated robotic manipulation tasks, varying the policy architecture, training data, and training procedure. Our results show that the choice of policy architecture is critical: transformer-based policies significantly outperform recurrent policies, even when trained on the same data. We also find that the quality and diversity of the training data are more important than the quantity, and that simple data augmentation techniques can substantially improve performance. Finally, we demonstrate that our findings transfer to real-world robotic manipulation tasks, where a transformer-based policy trained on a small amount of diverse data achieves strong generalization to unseen tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Belyi},
 journal = {arXiv preprint arXiv:2406.00975},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Luna: an evaluation foundation model to catch language model hallucinations with high accuracy and low cost},
 url = {https://arxiv.org/abs/2406.00975},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:17:21Z},
 year = {2024}
}

@article{belyi_luna_2025,
 abstract = {This paper explores the application of large language models (LLMs) in industrial settings for automated customer support. We present a case study from a major e-commerce platform where LLMs were integrated to handle routine inquiries, reducing response times by 40%. However, challenges such as hallucination and context loss were observed. To address these, we propose a hybrid system combining LLMs with rule-based verification and external knowledge retrieval. Our evaluation on real-world datasets shows improved accuracy and user satisfaction. We discuss deployment considerations, ethical implications, and scalability for enterprise use.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Belyi},
 journal = {Proceedings of the 31st …},
 keywords = {source: Google Scholar},
