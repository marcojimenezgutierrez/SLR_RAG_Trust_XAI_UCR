@inproceedings{heydari_context_2024,
 abstract = {The rapid growth of Internet of Things (IoT) devices has led to an increase in security threats, making intrusion detection systems (IDS) essential for protecting networks. Traditional IDS methods often struggle with the high volume and complexity of IoT traffic. This paper proposes a deep learning-based IDS that utilizes a hybrid model combining Convolutional Neural Networks (CNN) and Long Short-Term Memory (LSTM) networks to improve detection accuracy and efficiency. The model is trained and evaluated on the CICIDS2017 dataset, achieving a detection accuracy of 99.2%, precision of 99.1%, recall of 99.3%, and F1-score of 99.2%. Comparative analysis with existing methods demonstrates the superiority of the proposed approach in handling imbalanced data and real-time detection, offering a robust solution for securing IoT environments.},
