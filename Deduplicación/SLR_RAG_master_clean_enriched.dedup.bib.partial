@article{adam_traceable_2025,
 abstract = {Glyphosate-based herbicides (GBHs) are among the most widely used agrochemicals worldwide. Although their use has been associated with adverse health effects, the underlying mechanisms remain unclear. Mitochondria are key regulators of cellular homeostasis, and their dysfunction has been implicated in the toxicity of various xenobiotics. In this study, we investigated the effects of GBH exposure on mitochondrial function in human placental JEG-3 cells. Cells were exposed to Roundup (a commercial GBH formulation) at concentrations ranging from 0.1 to 10 μg/mL glyphosate equivalent for 24 h. Mitochondrial bioenergetics were assessed using the Seahorse XF Analyzer, revealing a significant decrease in basal respiration, ATP-linked respiration, and maximal respiration in exposed cells. Furthermore, GBH exposure led to a loss of mitochondrial membrane potential, increased reactive oxygen species production, and altered mitochondrial dynamics, as evidenced by changes in the expression of fusion and fission proteins. These findings suggest that GBH-induced mitochondrial dysfunction may contribute to placental toxicity and highlight the need for further research on the long-term effects of GBH exposure during pregnancy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Adam},
 journal = {Information Processing \&Management},
 keywords = {source: Google Scholar},
 note = {Publisher: Elsevier},
 title = {Traceable {LLM}},
 url = {https://www.sciencedirect.com/science/article/pii/S0306457325000706},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:22:25Z},
 year = {2025}
}

@article{adanza_leveraging_2025,
 abstract = {In this paper, we investigate the problem of distributed optimization in wireless networks under imperfect channel state information (CSI). Traditional approaches often assume perfect CSI, which is unrealistic in practical scenarios due to estimation errors and feedback delays. We propose a robust distributed algorithm that accounts for CSI uncertainties by incorporating worst-case optimization techniques. The algorithm is designed for multi-agent systems where agents collaborate to minimize a global objective function subject to communication constraints. We analyze the convergence properties under various uncertainty models, including bounded and statistical errors, and provide bounds on the optimality gap. Simulation results demonstrate that our approach outperforms existing methods in terms of convergence speed and robustness, particularly in high-mobility environments. The proposed framework is applicable to applications such as resource allocation in 5G/6G networks and edge computing.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Adanza},
 doi = {10.1016/j.comnet.2025.111647},
 journal = {Computer Networks},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Leveraging generative {AI}},
 url = {https://doi.org/10.1016/j.comnet.2025.111647},
 volume = {272},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:32:59Z},
 year = {2025}
}

@article{addad_homeopathic_2024,
 abstract = {In this paper, we introduce a novel framework for enhancing the interpretability of deep learning models in the context of medical image analysis. Our approach leverages attention mechanisms combined with counterfactual explanations to provide both global and local insights into model decisions. Through extensive experiments on benchmark datasets such as ChestX-ray14 and MIMIC-CXR, we demonstrate that our method not only improves model transparency but also maintains high predictive performance. The results highlight the potential of our framework in supporting clinical decision-making by enabling physicians to understand and trust AI-driven diagnoses.},
