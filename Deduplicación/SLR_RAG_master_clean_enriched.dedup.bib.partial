 keywords = {agent planning},
 note = {event-place: Padua},
 pages = {1413--1422},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{InstructRAG}},
 url = {https://doi.org/10.1145/3726302.3730009},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:18:39Z},
 year = {2025}
}

@inproceedings{wang_intent-driven_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their potential in supporting collaborative creativity remains underexplored. We introduce GenAIC, an open-source platform designed to facilitate the study of generative AI in collaborative ideation processes. GenAIC enables multiple users to engage in real-time collaboration, where they can prompt LLMs to generate ideas, iterate on suggestions, and integrate contributions from both human and AI participants. The platform captures comprehensive interaction logs, including prompts, responses, edits, and timestamps, to support empirical analysis of human-AI dynamics in creative tasks. We detail the architecture of GenAIC, including its integration with state-of-the-art LLMs, user interface design for seamless collaboration, and data export features for research. Through initial evaluations, we demonstrate GenAIC's utility in investigating how AI influences idea diversity, convergence, and participant satisfaction in group ideation. This work provides a foundational tool for researchers exploring AI-augmented creativity and offers insights into designing collaborative AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wang},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3718958.3750537},
