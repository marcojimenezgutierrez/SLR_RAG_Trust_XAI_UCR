@inproceedings{muller_grouse_2025,
 abstract = {This study investigates the impact of climate change on agricultural productivity in sub-Saharan Africa using panel data from 1990 to 2015. Employing a fixed-effects regression model, we find that rising temperatures and erratic rainfall patterns significantly reduce crop yields, particularly for staple crops like maize and sorghum. Adaptation strategies, such as improved irrigation and drought-resistant varieties, show potential to mitigate these effects, but implementation barriers remain high. Policy recommendations include increased investment in climate-resilient agriculture to ensure food security.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
