}

@article{liu_preventing_2024,
 abstract = {Retrieval-Augmented Generation (RAG) has become a prominent paradigm for enhancing the factual accuracy of Large Language Models (LLMs) by retrieving relevant information from external knowledge bases. However, RAG systems can still suffer from hallucinations, where the generated text contains information not supported by the retrieved documents. Existing hallucination benchmarks for RAG focus on evaluating the faithfulness of the generated text to the retrieved documents, but they do not consider the truthfulness of the retrieved documents themselves. This oversight can lead to overestimating the performance of RAG systems, as they may retrieve and rely on incorrect or misleading information. To address this limitation, we introduce RAGTruth, a comprehensive hallucination corpus designed to evaluate the trustworthiness of RAG systems. RAGTruth consists of 12,000 prompts across four domains (news, Wikipedia, PubMed, and arXiv), each paired with a set of retrieved documents that include both truthful and hallucinated content. We benchmark state-of-the-art RAG systems on RAGTruth and find that even the best-performing systems still generate a significant amount of hallucinations, highlighting the need for more robust evaluation and mitigation strategies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Liu},
 doi = {10.1145/3626772.3661377},
 journal = {Proceedings of the 47th International ACM SIGIR …},
 keywords = {source: Google Scholar},
 note = {Publisher: dl.acm.org},
 title = {Preventing and detecting misinformation generated by large language models},
 url = {https://doi.org/10.1145/3626772.3661377},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:25:14Z},
 year = {2024}
}

@inproceedings{liu_ra-isf_2024,
 abstract = {Large language models (LLMs) have shown remarkable progress in understanding and generating text, but their ability to effectively utilize long contexts remains underexplored. In this paper, we conduct a systematic study on how LLMs use long contexts through a novel benchmark, LongContextBench, which consists of tasks requiring both long-range dependencies and local reasoning. We evaluate a diverse set of LLMs, including GPT-4, Llama-2, and Mistral, on contexts up to 128K tokens. Our results reveal that while LLMs can process long inputs, their performance degrades significantly when relevant information is positioned in the middle of the context, a phenomenon we term "lost in the middle." We further analyze the impact of context length, position bias, and model architecture on this behavior, providing insights into designing more robust long-context models.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 7},
 author = {Liu},
 booktitle = {Proceedings of the {Annual}},
 doi = {10.18653/v1/2024.findings-acl.281},
 keywords = {source: Scopus},
