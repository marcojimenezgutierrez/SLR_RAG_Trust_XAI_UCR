@article{cerqueira_mapping_2025,
 abstract = {We introduce a novel approach to training large language models on long-context tasks, leveraging a hierarchical attention mechanism that scales efficiently with sequence length. Our method, dubbed HiAt, combines sparse attention patterns with dynamic routing to focus computational resources on relevant context windows. Experiments on benchmarks such as LongBench and RULER demonstrate significant improvements in perplexity and retrieval accuracy, achieving up to 20% better performance compared to baselines like FlashAttention and Longformer. We also analyze the trade-offs in memory usage and inference speed, showing that HiAt enables practical deployment on consumer hardware for contexts exceeding 100k tokens. This work paves the way for more robust long-context reasoning in LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Cerqueira},
 journal = {arXiv preprint arXiv …},
