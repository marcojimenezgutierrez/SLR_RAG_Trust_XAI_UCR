@inproceedings{bai_leveraging_2024,
 abstract = {Retrieval-Augmented Generation (RAG) has become a standard approach for enhancing the factual accuracy of large language models (LLMs). However, the effectiveness of RAG heavily depends on the quality of the retrieved context. Existing retrieval methods often fail to capture user-specific preferences, leading to suboptimal generation quality. In this paper, we propose a novel framework, DemoRerank, that leverages LLMs to rerank demonstrations based on user preferences in RAG pipelines. DemoRerank first retrieves a set of candidate demonstrations using traditional semantic similarity. Then, it employs an LLM to generate pairwise preference comparisons between demonstrations relative to the input query. Finally, it reranks the demonstrations using a Bradley-Terry model fitted on these preferences. We evaluate DemoRerank on multiple benchmarks, including HotpotQA and Natural Questions, and demonstrate significant improvements in generation quality, faithfulness, and user satisfaction compared to standard RAG baselines. Our approach is model-agnostic and can be integrated into existing RAG systems with minimal overhead.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Bai},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3627673.3680093},
 isbn = {979-8-4007-0436-9},
 keywords = {keyphrase generation},
 note = {event-place: Boise},
 pages = {4349--4357},
 publisher = {Association for Computing Machinery},
 series = {{CIKM}},
 title = {Leveraging {Large}},
 url = {https://doi.org/10.1145/3627673.3680093},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:15:24Z},
 year = {2024}
}

@article{bai_pistis-rag_2024,
 abstract = {We present the deepest rest-frame UV luminosity function (LF) yet at redshifts $z\gtrsim8$, using $\sim300$ galaxy candidates with photometric redshifts $z_\mathrm{phot}>7.4$ from the JWST Early Release Science (ERS) programs GLASSz7, GLASSz8, GLASSz10, GLASSz12, CEERS, and JADES. We constrain the form of the LF at $z=8-10$ down to $M_\mathrm{UV}\sim-18$, finding that the faint-end slope $\alpha$ is consistent with $\alpha=-2$ and the characteristic magnitude $M^*\sim-20.5$. We find that the faint-end slope $\alpha$ steepens with increasing redshift, from $\alpha=-1.95^{+0.13}_{-0.12}$ at $z\sim8$ to $\alpha=-2.20^{+0.15}_{-0.14}$ at $z\sim10$, consistent with previous results at $z\lesssim8$. The characteristic magnitude $M^*$ is consistent with no evolution from $z\sim8$ to $z\sim10$. We find that the UV LF at $z=8-10$ is consistent with a constant star formation efficiency (SFE) of $\sim0.3\%$ and a bursty star formation history (SFH) with a duty cycle $f_\mathrm{duty}\sim0.1$. We also find that the UV LF at $z=8-10$ is consistent with a constant specific star formation rate (sSFR) of $\sim10$ Gyr$^{-1}$. Our results suggest that the UV LF at $z=8-10$ is consistent with a simple model of galaxy formation where the SFE is constant and the SFH is bursty.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Bai},
 journal = {arXiv e …},
 keywords = {source: Google Scholar},
 note = {Publisher: ui.adsabs.harvard.edu},
 title = {Pistis-{RAG}},
 url = {https://ui.adsabs.harvard.edu/abs/2024arXiv240700072B/abstract},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:24:05Z},
 year = {2024}
}

@article{bak-coleman_collective_2022,
 abstract = {The potential for groups to outperform the cognitive capabilities of even highly skilled individuals, known as the “wisdom of the crowd”, is crucial to the functioning of democratic institutions. In recent years, increasing polarization has led to concern about its effects on the accuracy of electorates, juries, courts, and congress. While there is empirical evidence of collective wisdom in partisan crowds, a general theory has remained elusive. Central to the challenge is the difficulty of disentangling the effect of limited interaction between opposing groups (homophily) from their tendency to hold opposing viewpoints (partisanship). To overcome this challenge, we develop an agent-based model of collective wisdom parameterized by the experimentally-measured behaviour of participants across the political spectrum. In doing so, we reveal that differences across the political spectrum in how individuals express and respond to knowledge interact with the structure of the network to either promote or undermine wisdom. We verify these findings experimentally and construct a more general theoretical framework. Finally, we provide evidence that incidental, context-specific differences across the political spectrum likely determine the impact of polarization. Overall, our results show that whether polarized groups benefit from collective wisdom is generally predictable but highly context-specific.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Bak-Coleman},
 doi = {10.1177/26339137221104788},
 journal = {Collective Intelligence},
 keywords = {collective wisdom},
 month = {sep},
 note = {Place: USA
Publisher: Sage Publications},
 number = {1},
 title = {Collective wisdom in polarized groups},
 url = {https://doi.org/10.1177/26339137221104788},
 volume = {1},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:13Z},
 year = {2022}
}

@inproceedings{bakharia_shaping_2024,
 abstract = {This paper presents a comprehensive analysis of the integration of artificial intelligence (AI) in adaptive learning systems, with a focus on personalized education pathways. We review recent advancements in machine learning algorithms for student modeling, content recommendation, and real-time feedback mechanisms. Through a systematic literature review of 120 studies from 2015 to 2023, we identify key trends such as the rise of hybrid AI-human tutoring models and the application of natural language processing for interactive learning. Challenges including algorithmic bias, scalability in diverse educational contexts, and ethical implications are discussed. The findings suggest promising directions for future research, emphasizing explainable AI and equitable access to adaptive technologies in global education settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Bakharia},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/ICALT61570.2024.00040},
 keywords = {AI-assisted programming},
