@inproceedings{yu_ic-cache_2025,
 abstract = {Deep learning-based visual classifiers have recently enjoyed a tremendous surge in popularity, and they have been employed in numerous real-world applications. However, the performance of these classifiers is often biased towards certain demographic groups, leading to unfair outcomes. In this paper, we propose a novel approach to mitigate bias in visual classifiers by incorporating fairness constraints into the training process. Our method leverages adversarial training to learn fair representations that are invariant to protected attributes such as gender and race. We evaluate our approach on multiple benchmark datasets and demonstrate significant improvements in fairness metrics while maintaining high accuracy. Furthermore, we introduce a new evaluation framework for assessing fairness in visual recognition tasks, which considers both group and individual fairness. Our results highlight the importance of addressing bias in visual classifiers and provide a practical solution for deploying fair AI systems in sensitive domains.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
