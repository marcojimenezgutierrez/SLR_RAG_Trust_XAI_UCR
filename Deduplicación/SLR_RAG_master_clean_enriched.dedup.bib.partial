@article{khan_rfsensinggpt_2025,
 abstract = {In this paper, we investigate the problem of resource allocation in cognitive radio networks with underlay spectrum sharing. We propose a novel deep reinforcement learning framework that enables secondary users to dynamically optimize power allocation and channel selection while minimizing interference to primary users. Through extensive simulations, we demonstrate that our approach achieves up to 30% higher throughput compared to traditional optimization methods, with improved convergence speed and robustness to imperfect channel state information. The proposed algorithm is implementable in real-time scenarios and paves the way for practical deployment in 6G cognitive networks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
