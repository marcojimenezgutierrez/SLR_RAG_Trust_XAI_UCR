 keywords = {deep learning},
 note = {event-place: Sydney},
 pages = {661--678},
 publisher = {Association for Computing Machinery},
 series = {{ACM}},
 title = {{NetLLM}},
 url = {https://doi.org/10.1145/3651890.3672268},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:59:07Z},
 year = {2024}
}

