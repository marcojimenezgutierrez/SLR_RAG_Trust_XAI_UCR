@article{rosenthal_clapnq_2025,
 abstract = {Abstract Retrieval Augmented Generation (RAG) has become a popular application for large language models. It is preferable that successful RAG systems provide accurate answers that are supported by being grounded in a passage without any hallucinations. While considerable work is required for building a full RAG pipeline, being able to benchmark performance is also necessary. We present CLAPnq, a benchmark Long-form Question Answering dataset for the full RAG pipeline. CLAPnq includes long answers with grounded gold passages from Natural Questions (NQ) and a corpus to perform either retrieval, generation, or the full RAG pipeline. The CLAPnq answers are concise, 3x smaller than the full passage, and cohesive, meaning that the answer is composed fluently, often by integrating multiple pieces of the passage that are not contiguous. RAG models must adapt to these properties to be successful at CLAPnq. We present baseline experiments and analysis for CLAPnq that highlight areas where there is still significant room for improvement in grounded RAG. CLAPnq is publicly available at https://github.com/primeqa/clapnq.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 2; All Open Access; Gold Open Access},
 author = {Rosenthal},
 doi = {10.1162/tacl_a_00729},
 journal = {Transactions of the Association for Computational Linguistics},
 keywords = {source: Scopus},
 note = {Type: Article},
 pages = {53 -- 72},
 title = {{CLAPnq}},
 url = {https://doi.org/10.1162/tacl_a_00729},
 volume = {13},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:42:45Z},
 year = {2025}
}

@inproceedings{ross_rarr_2025,
 abstract = {We present EchoTrace, a novel audio-based navigation system designed to assist visually impaired users in exploring complex indoor environments. Traditional navigation aids often rely on visual cues or pre-mapped data, which can be limiting in dynamic or unfamiliar spaces. EchoTrace leverages echolocation-inspired audio feedback, using ultrasonic sensors integrated into wearable devices to generate real-time spatial audio cues that mimic natural echolocation. Through a series of user studies involving 20 visually impaired participants, we evaluate EchoTrace's effectiveness in tasks such as obstacle avoidance, pathfinding, and object localization. Results show a 35% improvement in navigation accuracy compared to baseline haptic feedback systems, with users reporting higher confidence and reduced cognitive load. We discuss design implications, accessibility challenges, and future directions for integrating EchoTrace with smart home ecosystems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Ross},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730337},
 isbn = {979-8-4007-1592-1},
 keywords = {large language models (llms).},
