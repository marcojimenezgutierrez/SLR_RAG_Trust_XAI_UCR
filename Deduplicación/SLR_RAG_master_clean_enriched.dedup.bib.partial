 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:49:11Z},
 year = {2025}
}

@inproceedings{dou_design_2024,
 abstract = {Social Virtual Reality (Social VR) has emerged as a promising platform for remote social interaction, yet it often falls short in conveying nuanced emotional cues, leading to potential miscommunications. This paper introduces "Emotional Echo," a design concept that visually manifests a user's emotional state within the shared virtual environment to foster empathy and connection among co-located avatars. Through iterative design workshops with 15 participants and a subsequent user study (N=24), we explored various implementations of Emotional Echo, including ambient particle effects, environmental color shifts, and avatar aura modifications. Our findings reveal that while Emotional Echo significantly enhances perceived empathy (p<0.01) and social presence, it also raises concerns around privacy and emotional overload. We discuss design implications for balancing expressiveness with user control, contributing guidelines for emotionally aware Social VR systems that support deeper interpersonal understanding without compromising immersion.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
