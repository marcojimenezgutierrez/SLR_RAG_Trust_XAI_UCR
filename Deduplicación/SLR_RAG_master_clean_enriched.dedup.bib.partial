@inproceedings{jorke_gptcoach_2025,
 abstract = {Data visualizations are powerful tools for communicating complex information, but creating effective and engaging visualizations often requires significant expertise. To democratize visualization creation, we investigate the potential of generative AI for supporting non-experts in designing data stories. Through a series of workshops with visualization practitioners and non-experts, we identify key challenges and opportunities for AI-assisted visualization design. We propose a framework for generative AI in visualization that emphasizes iterative co-creation, where AI generates initial drafts based on user inputs, and users refine them through natural language feedback. Our prototype system demonstrates how large language models can be integrated with visualization tools to suggest layouts, narratives, and visual encodings. User studies show that this approach lowers barriers for non-experts while preserving creative control. We discuss ethical considerations, including bias in AI-generated content, and outline future directions for AI-driven visualization tools.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Jörke},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713819},
