 x_enrich_ts = {2025-11-02T06:41:48Z},
 year = {2025}
}

@article{hu_lrp4rag_2024,
 abstract = {Learning generalist robot policies in a scalable manner is an important yet challenging problem. While there has been significant progress in vision-language models, much less is known about how to leverage Internet-scale video data for robot learning. In this work, we propose a framework for learning generalist robot policies from Internet-scale video data. Our approach consists of three key components: (1) a video encoder that learns representations from Internet-scale video data, (2) a policy network that conditions on these representations to output actions, and (3) a training procedure that leverages self-supervised learning to align the policy with the video representations. We evaluate our approach on a suite of robotic manipulation tasks and show that it outperforms existing methods by a significant margin. Our results suggest that Internet-scale video data is a promising source for learning generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Hu},
 journal = {arXiv preprint arXiv:2408.15533},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Lrp4rag: {Detecting}},
 url = {https://arxiv.org/abs/2408.15533},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:16:37Z},
 year = {2024}
}

@article{hu_openmae_2025,
 abstract = {This paper introduces OpenMAE, a novel data enrichment framework utilizing open-world sensor data streams to facilitate efficient masked autoencoder (MAE) pretraining on vibration signals. Due to highly sparse event occurrences and inevitable distributional shifts from downstream tasks, directly concatenating large-scale open-domain data with limited in-domain data during pretraining leads to degraded downstream task performance. The problem is further complicated by missing knowledge of open-world sensor environments and associated physical event semantics. Against these challenges, OpenMAE makes the following contributions to vibration MAE pretraining with open-domain data: First, it automatically filters out uninformative samples based on the event activeness and information consistency without relying on human annotations; Second, to mind the gap between open-domain and in-domain distributions, OpenMAE develops a novel data mixing method, FreqCutMix, that combines two data types in the frequency domain as augmented pretraining samples, preserving both events-of-interest semantics from in-domain data and real-world diversity from open-domain data. The open-domain data scale in data mixing is dynamically increased as pretraining progresses to stabilize the model convergence. We download over 5 million open-world vibration samples from the Raspberry Shake datacenter1 and conduct extensive experiments with two applications (i.e., indoor activity and outdoor transportation analysis). The evaluation results show OpenMAE improves downstream task accuracies by up to 23% and achieves enhanced generalizability into diverse downstream tasks, domain variations, and sensor-to-target distances.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Hu},
 doi = {10.1145/3729485},
 journal = {Proc. ACM Interact. Mob. Wearable Ubiquitous Technol.},
 keywords = {Self-Supervised Learning},
 month = {jun},
 note = {Place: New York},
 number = {2},
 title = {{OpenMAE}},
 url = {https://doi.org/10.1145/3729485},
 volume = {9},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:49Z},
 year = {2025}
}

@article{hu_patchwork_2025,
 abstract = {Grokking as Algorithmic Generalization: A New Perspective on the Phenomenon

Grokking is a phenomenon in machine learning where a model, after overfitting to the training data for a long time, suddenly generalizes well on the test set. Despite its importance, the underlying mechanisms remain poorly understood. In this work, we propose a new perspective on grokking as a form of algorithmic generalization, where the model learns a concise, interpretable algorithm that captures the underlying structure of the data. We support this view with empirical evidence from modular addition tasks, showing that grokking corresponds to the emergence of explicit, human-interpretable representations of the addition operation in the model's activations. Furthermore, we demonstrate that this algorithmic generalization can be accelerated by modifying the training procedure to encourage the learning of such representations early on. Our findings suggest that grokking is not merely a quirk of overparameterized models but a fundamental process of discovering efficient computational strategies, with implications for improving generalization in deep learning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Hu},
 journal = {arXiv preprint arXiv:2505.07833},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Patchwork: {A}},
 url = {https://arxiv.org/abs/2505.07833},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:20:38Z},
 year = {2025}
}

@article{hu_position_2025,
 abstract = {Robotic policies have traditionally been developed for narrow sets of tasks, limiting their applicability in real-world scenarios. Recent advances in foundation models have sparked interest in developing generalist robot policies capable of handling diverse tasks. However, it remains unclear what factors are most important for building such policies. In this work, we conduct a systematic study to understand the key ingredients for generalist robot policies. We investigate the roles of model architecture, data diversity, training objectives, and scaling. Through extensive experiments on simulated and real robotic tasks, we find that a combination of large-scale diverse datasets, transformer-based architectures, and multi-task pretraining followed by task-specific finetuning yields the best generalization. Our findings provide actionable insights for the community aiming to build versatile robotic agents.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Hu},
 journal = {arXiv preprint arXiv …},
