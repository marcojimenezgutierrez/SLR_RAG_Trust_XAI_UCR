@inproceedings{deeksha_emu-llm_2025,
 abstract = {We propose a novel framework for generating diverse and controllable 3D-aware images from a single 2D image using diffusion models. Our approach leverages a pre-trained 2D diffusion model and a 3D-aware generator to produce multi-view consistent images that can be controlled via text prompts or other conditions. By disentangling the 3D structure from the 2D appearance, our method enables flexible editing and novel view synthesis while maintaining high fidelity. Extensive experiments demonstrate superior performance over existing methods in terms of diversity, consistency, and controllability.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
