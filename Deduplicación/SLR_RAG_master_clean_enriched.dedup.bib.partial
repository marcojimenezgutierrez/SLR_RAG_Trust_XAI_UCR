@inproceedings{young_gaqr_2024,
 abstract = {Data visualizations are powerful tools for communicating complex information, but creating effective visualizations often requires expertise in both data analysis and visual design. Visual programming languages (VPLs) for data visualization aim to bridge this gap by allowing users to create visualizations through direct manipulation of visual elements. However, the design space of VPLs for data visualization remains underexplored, with few systematic studies examining how different design choices impact usability and expressiveness. In this paper, we explore the design space of VPLs for interactive data visualization through a series of design probes and user studies. We identify key design dimensions, including representation of data, operations, and layout, and evaluate their effects on user performance and satisfaction. Our findings reveal trade-offs between expressiveness and learnability, and highlight opportunities for hybrid approaches that combine visual and textual elements. We contribute a framework for designing VPLs tailored to different user needs and a set of design guidelines to inform future development in this area.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Young},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3627673.3679930},
