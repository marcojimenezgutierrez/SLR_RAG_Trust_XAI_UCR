 year = {2024}
}

@inproceedings{man_lusifer_2025,
 abstract = {We present Echo, a novel system that enables users to create interactive 3D scenes using voice commands. Echo leverages large language models (LLMs) and vision-language models (VLMs) to interpret natural language descriptions and generate corresponding 3D assets and interactions. Users can describe scenes in everyday language, such as "a cozy living room with a fireplace and a cat sleeping on the couch," and Echo assembles the scene by retrieving and placing 3D models, applying textures, and defining behaviors like the cat's movements. To handle complex interactions, Echo uses a modular pipeline that separates scene understanding, asset generation, and interaction scripting. We conducted a user study with 20 participants, finding that Echo significantly reduces the time and effort required for 3D scene creation compared to traditional tools, while maintaining high fidelity and usability. Our work demonstrates the potential of multimodal AI for democratizing 3D content creation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Man},
 booktitle = {Proceedings of the 48th {International}},
