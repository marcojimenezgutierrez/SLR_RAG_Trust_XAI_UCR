 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:14:46Z},
 year = {2024}
}

@article{xu_align-grag_2025,
 abstract = {Robot policies trained with reinforcement learning (RL) have demonstrated remarkable success in specific domains, such as manipulation and locomotion. However, these policies often fail to generalize to novel tasks or environments, limiting their practical utility. To address this, we propose a representation learning approach that enables generalist robot policies capable of zero-shot generalization to unseen tasks. Our method, called Generalist Representation Learning (GRL), leverages a large-scale dataset of robot interactions to learn a compact, semantically meaningful latent space. We evaluate GRL on a suite of diverse manipulation tasks, showing that policies trained in this space achieve superior performance and generalization compared to standard RL baselines. Our results suggest that effective representation learning is a key enabler for developing versatile, general-purpose robot agents.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
