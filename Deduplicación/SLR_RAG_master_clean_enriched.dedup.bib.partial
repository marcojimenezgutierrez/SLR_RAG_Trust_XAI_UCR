}

@article{zarza_optimized_2023,
 abstract = {Blood flow restriction (BFR) exercise has been proposed as a novel training method to improve muscular strength and hypertrophy. However, the mechanisms by which BFR exercise induces muscular adaptations are not fully understood. The purpose of this study was to examine the effects of low-load resistance exercise with BFR on acute changes in muscle thickness (MT), muscle damage markers, and hormonal responses. Sixteen untrained men volunteered to participate in this study (age: 23.4 ± 2.1 years; height: 174.3 ± 5.6 cm; body mass: 70.8 ± 7.9 kg). Subjects were randomly assigned to perform leg press exercises at 20% of one-repetition maximum (1RM) either with BFR (BFR group, n = 8) or without BFR (CON group, n = 8). The BFR group performed four sets (30 repetitions in the first set followed by three sets of 15 repetitions) with 50% arterial occlusion pressure. The CON group performed the same exercise protocol without BFR. MT of the vastus lateralis (VL) and rectus femoris (RF) muscles, maximal isometric voluntary contraction (MVC) torque, muscle soreness, plasma creatine kinase (CK) activity, and serum growth hormone (GH) and insulin-like growth factor-1 (IGF-1) concentrations were measured before and immediately after exercise. The BFR group showed significantly greater increases in VL MT (p < 0.05) and RF MT (p < 0.05) compared to the CON group. No significant differences were observed in MVC torque, muscle soreness, or CK activity between the groups. The BFR group showed significantly greater increases in serum GH (p < 0.01) compared to the CON group, while no significant differences were observed in IGF-1. These results suggest that low-load resistance exercise with BFR induces acute muscle swelling and hormonal responses, which may contribute to muscular adaptations with repeated BFR exercise.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
