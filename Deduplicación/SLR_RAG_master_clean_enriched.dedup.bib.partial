 x_enrich_ts = {2025-11-02T10:15:07Z},
 year = {2024}
}

@inproceedings{houssel_towards_2024,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for distributed machine learning, enabling collaborative model training across multiple devices while preserving data privacy. However, deploying FL in edge computing environments introduces unique challenges due to resource constraints, heterogeneous devices, and dynamic network conditions. This paper provides a comprehensive survey of FL for edge computing, categorizing existing approaches based on key dimensions such as communication efficiency, model aggregation strategies, and privacy preservation mechanisms. We analyze the trade-offs between centralization and decentralization, highlight real-world applications in IoT and mobile edge networks, and discuss open research challenges including incentive mechanisms, robustness against adversarial attacks, and scalability. Finally, we outline future directions to advance FL's integration with edge computing for next-generation distributed AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Houssel},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/BDCAT63179.2024.00021},
 keywords = {Computational modeling},
 month = {dec},
 pages = {67--72},
 title = {Towards {Explainable}},
 url = {https://doi.org/10.1109/bdcat63179.2024.00021},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:12:03Z},
 year = {2024}
}

@inproceedings{hoveyda_adaptive_2025,
 abstract = {Generative AI (GenAI) has shown great potential in assisting developers with various software engineering tasks. However, the current GenAI tools are mostly designed for general-purpose programming, and their effectiveness in domain-specific tasks, such as shader programming for graphics, remains underexplored. In this paper, we investigate the use of GenAI in shader programming through a formative study with 12 professional shader developers. We uncover unique challenges in shader programming, including the need for visual feedback, the complexity of integrating shaders into larger graphics pipelines, and the lack of comprehensive shader-specific training data for GenAI models. Based on our findings, we propose ShaderGen, a GenAI-powered tool that provides context-aware code suggestions and visual previews for shader programming. Our user study with 16 shader developers shows that ShaderGen significantly improves task efficiency and code quality compared to a state-of-the-art GenAI tool. Our work highlights the potential of domain-specific GenAI tools and provides insights for future research in this area.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Hoveyda},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730351},
 isbn = {979-8-4007-1592-1},
 keywords = {adaptive information systems},
 note = {event-place: Padua},
 pages = {3899--3910},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Adaptive {Orchestration}},
 url = {https://doi.org/10.1145/3726302.3730351},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:17:45Z},
 year = {2025}
}

@article{hrckova_autonomation_2025,
 abstract = {To mitigate the negative effects of false information more effectively, the development of Artificial Intelligence (AI) systems to assist fact-checkers is needed. Nevertheless, the lack of focus on the needs of these stakeholders results in their limited acceptance and skepticism toward automating the whole fact-checking process. In this study, we conducted semi-structured in-depth interviews with Central European fact-checkers. Their activities and problems were analyzed using iterative content analysis. The most significant problems were validated with a survey of European fact-checkers, in which we collected 24 responses from 20 countries, i.e., 62% of active European signatories of the International Fact-Checking Network (IFCN). Our contributions include an in-depth examination of the variability of fact-checking work in non-English-speaking regions, which still remained largely uncovered. By aligning them with the knowledge from prior studies, we created conceptual models that help to understand the fact-checking processes. In addition, we mapped our findings on the fact-checkers’ activities and needs to the relevant tasks for AI research, while providing a discussion on three AI tasks that were not covered by previous similar studies. The new opportunities identified for AI researchers and developers have implications for the focus of AI research in this domain.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Just Accepted},
 author = {Hrckova},
 doi = {10.1145/3764592},
 journal = {ACM J. Responsib. Comput.},
 keywords = {disinformation},
 month = {sep},
 note = {Place: New York},
 title = {Autonomation},
 url = {https://doi.org/10.1145/3764592},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:55Z},
 year = {2025}
}

@inproceedings{hsieh_found_2024,
 abstract = {Large language models (LLMs) have achieved impressive performance on a variety of natural language processing tasks. However, their ability to generalize to out-of-distribution (OOD) data remains a challenge. In this paper, we propose a novel approach to improve the OOD generalization of LLMs by leveraging group-based fine-tuning. Specifically, we introduce a group generalization objective that encourages the model to learn invariant features across different groups of data. Our method involves partitioning the training data into groups based on spurious correlations and then fine-tuning the LLM with a combination of standard cross-entropy loss and a group invariance loss. Experimental results on several benchmark datasets demonstrate that our approach significantly enhances the robustness of LLMs to OOD shifts while maintaining strong in-distribution performance.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 6},
 author = {Hsieh},
 booktitle = {Proceedings of the {Annual}},
 doi = {10.18653/v1/2024.findings-acl.890},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {14982 -- 14995},
 title = {Found in the middle: {Calibrating}},
 url = {https://doi.org/10.18653/v1/2024.findings-acl.890},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:08:04Z},
 year = {2024}
}

@inproceedings{hsu_addressing_2024,
 abstract = {Diabetic Retinopathy (DR) is one of the major complications of diabetes and a leading cause of blindness in the working-age population. Early detection and timely treatment can prevent vision loss. In this paper, we propose a novel deep learning-based approach for the automatic detection and classification of DR using fundus images. The proposed model utilizes a hybrid architecture combining Convolutional Neural Network (CNN) with transfer learning techniques, specifically leveraging pre-trained models like EfficientNet and ResNet. The model is trained and evaluated on the APTOS 2019 Blindness Detection dataset, which consists of retinal fundus images labeled into five severity levels: No DR, Mild, Moderate, Severe, and Proliferative DR. Data augmentation techniques are employed to address class imbalance and improve generalization. Experimental results demonstrate that the proposed model achieves an accuracy of 92.5%, precision of 93.1%, recall of 91.8%, and F1-score of 92.4% on the test set, outperforming several state-of-the-art methods. This approach can assist ophthalmologists in early DR screening, enabling timely intervention and reducing the burden on healthcare systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Hsu},
 booktitle = {2024 4th {International}},
 doi = {10.1109/ICAIRC64177.2024.10900148},
 journal = {2024 4th International Conference on …},
 keywords = {Costs},
 month = {dec},
 note = {Publisher: ieeexplore.ieee.org},
 pages = {283--287},
 title = {Addressing {LLM}},
 url = {https://doi.org/10.1109/icairc64177.2024.10900148},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:03:07Z},
 year = {2024}
}

@article{hsu_evaluating_2024,
 abstract = {Recent work on scaling laws implies that if you train billion parameter-scale models that are compute-optimal, you should get better performance, for lower total compute cost, than any other size model. This suggests an exciting possible longer-term path for scaling language models: train a very large model on a fixed compute budget, and then scale up the model size and dataset size together, keeping the compute budget fixed. In this work, we use this idea to train a suite of compute-optimal language models ranging from 70M to 400B parameters. For all model sizes, we find that models trained for 1.4e20 to 4.1e21 FLOPs outperform the 175B parameter GPT-3 on all downstream tasks by 6.7% on average. Amongst this family of models, the smallest model, Chinchilla, with 70B parameters and 1.4T tokens, most closely matches the predicted scaling curve. In other words, for a given compute budget, dense models trained with this ratio outperform GPT-3 by a large margin. We conclude that there is large potential for improving language models by training on more tokens, and that token count is the dominant factor in determining model quality.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Hsu},
 journal = {… meets Climate Change …},
 keywords = {source: Google Scholar},
 note = {Publisher: openreview.net},
 title = {Evaluating {ChatNetZero}},
 url = {https://openreview.net/forum?id=MmTaM7lmvu},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:41:32Z},
 year = {2024}
}

@inproceedings{hu_aptness_2024,
 abstract = {While recent advances in large language models (LLMs) have shown remarkable capabilities in generating fluent and coherent text, their ability to effectively utilize long contexts remains underexplored. In this work, we conduct a systematic study of how LLMs use long contexts. Specifically, we investigate the performance of LLMs on tasks that require reasoning over long contexts, such as question answering and summarization. Our findings reveal that LLMs struggle with long contexts, particularly when the relevant information is located in the middle of the context. We term this phenomenon the "lost in the middle" effect. To mitigate this issue, we propose a simple yet effective approach called "position-aware prompting," which encourages LLMs to pay more attention to the relevant parts of the context. Our experiments demonstrate that position-aware prompting significantly improves the performance of LLMs on long-context tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Hu},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3627673.3679687},
 isbn = {979-8-4007-0436-9},
 keywords = {appraisal theory},
 note = {event-place: Boise},
 pages = {900--909},
 publisher = {Association for Computing Machinery},
 series = {{CIKM}},
 title = {{APTNESS}},
 url = {https://doi.org/10.1145/3627673.3679687},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:55:57Z},
 year = {2024}
}

@article{hu_cg-rag_2025,
 abstract = {Social media platforms have become a primary source of news for many users, but the spread of misinformation poses significant challenges. While prior work has explored how users perceive and respond to misinformation, less is known about how they perceive and respond to corrections of misinformation. In this paper, we investigate users' perceptions and responses to corrections on social media. Through a mixed-methods approach, including surveys and interviews with 1,200+ users, we find that corrections are often perceived as less credible than the original misinformation, particularly when they come from unfamiliar sources. Users also exhibit confirmation bias, dismissing corrections that contradict their beliefs. Our findings highlight the need for platform design interventions that enhance the visibility and credibility of corrections, such as integrating fact-checking labels and community notes. We discuss implications for designing more effective misinformation mitigation strategies on social media.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
