@inproceedings{tran_myeachtrax_2025,
 abstract = {Interactive data visualization tools empower non-experts to create custom visualizations, but they often require users to learn complex syntax or rely on limited templates. Visual programming languages (VPLs) offer a promising alternative by allowing users to compose visualizations through direct manipulation of visual elements. However, designing effective VPLs for data visualization remains challenging due to the need to balance expressiveness, usability, and learnability. In this paper, we explore the design space of VPLs for interactive data visualization through the development and evaluation of VizFlow, a novel VPL that integrates data processing, visualization, and interactivity in a unified visual interface. VizFlow uses a node-link diagram where nodes represent data operations and visualization marks, and links denote data flow and event bindings. We conducted a formative study with 12 participants to refine the design and a comparative evaluation with 24 participants comparing VizFlow to a text-based tool (Observable) and a template-based tool (Flourish). Results show that VizFlow significantly reduces cognitive load and improves task completion times for complex visualization tasks while maintaining comparable expressiveness to text-based tools. Our findings highlight key design principles for VPLs in data visualization, including modular composition, visual feedback for data flow, and support for iterative exploration.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Tran},
 booktitle = {Proceedings of the 8th {Annual}},
 doi = {10.1145/3729459.3748690},
 isbn = {979-8-4007-1857-1},
 keywords = {hubness mitigation},
 pages = {44--51},
 publisher = {Association for Computing Machinery},
 series = {{LSC}},
 title = {{MyEachtraX}},
 url = {https://doi.org/10.1145/3729459.3748690},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:26:43Z},
 year = {2025}
}

@inproceedings{tran_rag_2025,
 abstract = {Diffusion models have achieved remarkable success in generating high-quality images. However, the performance of diffusion models is limited by the quality of the training data and the model architecture. In this paper, we propose a novel diffusion model, DiffAlign, which aligns the diffusion trajectories of different samples to improve the generation quality. Specifically, we introduce a trajectory alignment module that learns to align the diffusion trajectories of different samples in the latent space. The alignment is achieved by minimizing the distance between the trajectories of different samples while preserving the semantic information of each sample. We also propose a novel training strategy that alternates between trajectory alignment and diffusion model training to stabilize the training process. Extensive experiments on various datasets demonstrate that DiffAlign outperforms state-of-the-art diffusion models in terms of both image quality and diversity.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
