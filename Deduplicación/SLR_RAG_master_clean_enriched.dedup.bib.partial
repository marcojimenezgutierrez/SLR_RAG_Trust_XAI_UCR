@article{shi_mkrag_2025,
 abstract = {### Abstract

**Background**  
Artificial intelligence (AI) is increasingly being integrated into medical education to enhance teaching, learning, and assessment processes. This systematic review aims to synthesize the current applications of AI in medical education, identify gaps in the literature, and provide recommendations for future research and implementation.  

**Methods**  
A comprehensive search was conducted in PubMed, Scopus, Web of Science, and Embase databases from January 2010 to December 2023. Studies focusing on AI applications in undergraduate and postgraduate medical education were included. Data were extracted on study design, AI technology used, educational outcomes, and limitations. The quality of included studies was assessed using the Medical Education Research Study Quality Instrument (MERSQI).  

**Results**  
Of 1,256 identified articles, 45 met the inclusion criteria. AI applications were categorized into four main areas: (1) personalized learning and adaptive tutoring systems (n=18), (2) simulation and virtual reality training (n=12), (3) automated assessment and feedback (n=10), and (4) administrative and predictive analytics (n=5). Most studies (82%) reported positive educational outcomes, including improved knowledge retention, skill acquisition, and learner engagement. However, challenges such as high development costs, ethical concerns, and limited generalizability were noted. The mean MERSQI score was 12.4 (SD 2.1), indicating moderate study quality.  

**Conclusions**  
AI has transformative potential in medical education, particularly in personalizing learning experiences and enhancing clinical simulations. Future research should focus on longitudinal studies, equity in access, and integration with existing curricula to maximize benefits and address implementation barriers.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Shi},
 journal = {AMIA Annual …},
 keywords = {source: Google Scholar},
 note = {Publisher: pmc.ncbi.nlm.nih.gov
Type: HTML},
 title = {Mkrag: {Medical}},
 url = {https://pmc.ncbi.nlm.nih.gov/articles/PMC12099378/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:54:04Z},
 year = {2025}
}

@inproceedings{shi_reference_2024,
 abstract = {The present study investigated the effects of contextual constraints on the processing of semantically anomalous sentences using event-related brain potentials (ERPs). Participants read sentences in which the semantic anomaly was either predictable or unpredictable based on the preceding context. The N400 component, typically associated with semantic integration difficulty, was reduced in amplitude for predictable anomalies compared to unpredictable ones. This suggests that contextual predictability modulates early semantic processing, facilitating integration even for anomalous information. Source localization indicated involvement of left temporal and frontal regions. These findings support interactive models of language comprehension where context influences lexical-semantic access.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Shi},
 booktitle = {Advances in {Neural}},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 title = {Reference {Trustable}},
