@article{noauthor_sigir-ap_2024,
 abstract = {The emergence of deep learning (DL) in the last few years has significantly advanced the field of medical image analysis. This paper reviews the current state of DL in medical image analysis, focusing on the most commonly used architectures and their applications in various medical imaging modalities. We discuss convolutional neural networks (CNNs), recurrent neural networks (RNNs), generative adversarial networks (GANs), and transformer-based models, highlighting their strengths and limitations. Case studies in radiology, pathology, and dermatology demonstrate the progress and challenges in tasks such as segmentation, classification, detection, and synthesis. Future directions include improving interpretability, handling data scarcity, and integrating multimodal data for more robust clinical decision support.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 keywords = {source: Scopus},
 note = {Type: Conference review},
 title = {{SIGIR}},
