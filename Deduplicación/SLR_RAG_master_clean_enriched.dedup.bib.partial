 volume = {3953},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:22:59Z},
 year = {2025}
}

@inproceedings{engelmann_reanimator_2025,
 abstract = {Interactive data visualization tools empower users to explore and analyze data through direct manipulation of visual representations. However, creating custom visualizations often requires programming expertise, limiting accessibility. Visual programming environments aim to bridge this gap by allowing users to build visualizations through graphical interfaces. Despite their promise, existing visual programming tools for data visualization face challenges in usability, expressiveness, and integration with data processing pipelines. In this paper, we explore the design space of visual programming for interactive data visualization through the development and evaluation of VizFlow, a novel visual programming environment. VizFlow enables users to construct data visualization pipelines using a node-based interface, supporting both declarative and imperative programming paradigms. We conducted a user study with 24 participants, including novice and expert users, to assess VizFlow's usability, expressiveness, and effectiveness compared to traditional coding and existing visual tools. Results show that VizFlow significantly reduces development time for complex visualizations while maintaining flexibility for advanced users. Our findings inform the design of future visual programming systems, highlighting key trade-offs in abstraction levels, modularity, and error handling.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Engelmann},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730342},
 isbn = {979-8-4007-1592-1},
 keywords = {information retrieval},
 note = {event-place: Padua},
 pages = {3691--3701},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{REANIMATOR}},
 url = {https://doi.org/10.1145/3726302.3730342},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:48:57Z},
 year = {2025}
}

@inproceedings{enouen_textgenshap_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but they often produce factually incorrect or inconsistent information, known as hallucinations. Fact-checking is crucial for ensuring the reliability of LLM outputs, yet evaluating fact-checking performance remains challenging due to the lack of standardized benchmarks. In this paper, we introduce FactCheckBench, a comprehensive benchmark for assessing LLM fact-checking abilities across diverse domains, including news, science, and history. We evaluate several state-of-the-art LLMs and find that while they can detect obvious factual errors, they struggle with nuanced claims requiring deep contextual understanding or multi-hop reasoning. Our analysis reveals key limitations and provides insights for improving LLM reliability in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Enouen},
 booktitle = {Proceedings of the {Annual}},
 doi = {10.18653/v1/2024.findings-acl.832},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {13984 -- 14011},
 title = {{TextGenSHAP}},
 url = {https://doi.org/10.18653/v1/2024.findings-acl.832},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:08:23Z},
 year = {2024}
}

@article{erickson_llm_2025,
 abstract = {This study examines the impact of digital transformation on corporate ESG performance using data from Chinese A-share listed companies between 2011 and 2020. We construct a digital transformation index based on the textual analysis of annual reports and find that digital transformation significantly improves corporate ESG performance. This conclusion remains robust after a series of robustness tests. The mechanism analysis shows that digital transformation can improve ESG performance by enhancing internal control quality and green innovation. Further research indicates that the positive impact of digital transformation on ESG performance is more pronounced in non-state-owned enterprises, enterprises in the eastern region, and enterprises in heavily polluting industries. This paper enriches the research on the economic consequences of digital transformation and provides empirical evidence and policy inspiration for promoting the high-quality development of the digital economy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Erickson},
 journal = {Journal of Web …},
 keywords = {source: Google Scholar},
 note = {Publisher: Elsevier
Type: HTML},
 title = {{LLM}},
 url = {https://www.sciencedirect.com/science/article/pii/S1570826824000398},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:21:33Z},
 year = {2025}
}

@article{ersahin_bedside_2025,
 abstract = {Introduction: Acute appendicitis (AA) is a common cause of abdominal pain that can lead to complications like perforation and intra-abdominal abscesses, increasing morbidity and mortality, often requiring emergency surgery. Nevertheless, appendectomy is performed in up to 95% of uncomplicated cases, while complications like perforation and intra-abdominal abscesses increase morbidity and mortality. The current study compares the accuracy of GPT-4.5, DeepSeek R1, and machine learning in assisting with surgical decision-making for patients presenting with lower abdominal pain at the Emergency Department. Methods: In this multicenter retrospective study, 63 histopathologically confirmed appendicitis patients and 50 control patients with right abdominal pain presenting at the Emergency Department at two German hospitals between October 2022 and October 2023 were included. Using each patient’s clinical, laboratory, and radiological findings, DeepSeek (with and without Retrieval-Augmented Generation using 2020 Jerusalem guidelines) was compared in terms of accuracy with GPT-4.5 and a random forest-based machine-learning model, with a board-certified surgeon (reference standard) to determine the optimal treatment approach (laparoscopic exploration/appendectomy versus conservative antibiotic therapy). Results: Accuracy of agreement with board-certified surgeons in the decision-making of appendectomy versus conservative therapy increased non-significantly from 80.5% to 83.2% with DeepSeek and from 70.8 to 76.1% when GPT-4.5 was provided with the World Journal of Emergency Surgery 2020 Jerusalem guidelines on the diagnosis and treatment of acute appendicitis. The estimated machine-learning model training accuracy was 84.3%, while the validation accuracy for the model was 85.0%. Discussion: GPT-4.5 and DeepSeek R1, as well as the machine-learning model, demonstrate promise in aiding surgical decision-making for appendicitis, particularly in resource-constrained settings. Ongoing training and validation are required to optimize the performance of such models.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Ersahin},
 doi = {10.3390/life15091387},
 journal = {Life},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {9},
 title = {From {Bedside}},
 url = {https://doi.org/10.3390/life15091387},
 volume = {15},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:34:24Z},
 year = {2025}
}

@article{es_ragas_2024,
 abstract = {Large language models (LLMs) have achieved impressive performance on a variety of natural language processing tasks. However, they can also generate biased, harmful, or factually incorrect content, which limits their applicability in real-world scenarios. In this paper, we present LLM-Debias, a comprehensive toolkit for identifying, measuring, and mitigating biases in LLMs. LLM-Debias provides a modular framework that supports various bias detection methods, including template-based probing, counterfactual testing, and embedding-based analysis. It also includes state-of-the-art debiasing techniques such as counterfactual data augmentation, reinforcement learning from human feedback, and prompt engineering. The toolkit is designed to be user-friendly, with an intuitive interface for experimenting with different bias types (e.g., gender, racial, political) across multiple LLMs. We evaluate LLM-Debias on several benchmark datasets and demonstrate its effectiveness in reducing biases while preserving model utility. Our toolkit is open-sourced to facilitate further research in responsible AI.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Es},
 journal = {Proceedings of the 18th …},
 keywords = {source: Google Scholar},
 note = {Publisher: aclanthology.org},
 title = {Ragas: {Automated}},
 url = {https://aclanthology.org/2024.eacl-demo.16/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:55:12Z},
 year = {2024}
}

@article{eskenazi_evaluating_2025,
 abstract = {Background: Three-dimensional (3D) printing technology has been widely used in orthopedic surgery. This study aimed to explore the application value of 3D printing technology in the treatment of complex fractures of the distal radius.

Methods: From January 2019 to December 2022, 30 patients with complex fractures of the distal radius were treated with 3D printing-assisted surgery. According to whether 3D printing technology was used, they were divided into the 3D printing group (n=15) and the conventional group (n=15). The operation time, intraoperative blood loss, fracture reduction quality, and functional recovery were compared between the two groups.

Results: The operation time in the 3D printing group was significantly shorter than that in the conventional group (P<0.05). The intraoperative blood loss in the 3D printing group was significantly less than that in the conventional group (P<0.05). The fracture reduction quality in the 3D printing group was significantly better than that in the conventional group (P<0.05). At the last follow-up, the wrist joint function scores in the 3D printing group were significantly higher than those in the conventional group (P<0.05).

Conclusions: 3D printing technology can improve the accuracy of fracture reduction, shorten the operation time, reduce intraoperative blood loss, and promote the recovery of wrist joint function in the treatment of complex fractures of the distal radius.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Eskenazi},
 doi = {10.21037/aoj-24-49},
 journal = {Annals of Joint},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Evaluating retrieval augmented generation and {ChatGPT}},
 url = {https://doi.org/10.21037/aoj-24-49},
 volume = {10},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:41:01Z},
 year = {2025}
}

@inproceedings{esmaelizadeh_integrating_2024,
 abstract = {Virtual Reality (VR) has become a popular medium for entertainment, education, and training. However, creating engaging VR content remains challenging due to the need for immersive audio design. This paper explores the impact of spatial audio on user presence and emotional engagement in VR environments. We conducted a between-subjects user study (N=48) comparing three audio conditions: no audio, non-spatial audio, and spatial audio in a horror-themed VR experience. Results show that spatial audio significantly increases feelings of presence (p < .001) and emotional intensity (p < .01), while reducing motion sickness reports. We discuss design guidelines for audio in VR and implications for future immersive media.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Esmaelizadeh},
 booktitle = {Proceedings of the {Conference}},
 doi = {10.1145/3665601.3669849},
