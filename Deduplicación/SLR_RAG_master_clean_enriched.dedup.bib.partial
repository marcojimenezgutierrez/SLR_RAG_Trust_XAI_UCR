 pages = {378--388},
 publisher = {Association for Computing Machinery},
 series = {{FSE}},
 title = {A {Multimodal}},
 url = {https://doi.org/10.1145/3696630.3728561},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:48:35Z},
 year = {2025}
}

@article{sun_pankb_2025,
 abstract = {Ensembl (https://www.ensembl.org) is a freely available genomic resource that coordinates the annotation of eukaryotic genomes. It provides access to the data of 45 vertebrate genomes and 20 other species. Ensembl releases two major updates per year, and the latest release, Ensembl 104, was made publicly available in October 2023. This release includes 12 newly added species, updates to the annotation of 20 species and new comparative analyses. Ensembl also provides a variety of tools for accessing and analysing genomic data, including the Ensembl browser, the Variant Effect Predictor (VEP) and the BioMart data mining tool. Here, we describe recent developments in Ensembl, including updates to the web interface, new API features and enhancements to the VEP.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Sun},
 journal = {Nucleic Acids …},
 keywords = {source: Google Scholar},
 note = {Publisher: academic.oup.com},
 title = {{PanKB}},
 url = {https://academic.oup.com/nar/article-abstract/53/D1/D806/7906839},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:20:42Z},
 year = {2025}
}

@inproceedings{sun_persona-l_2025,
 abstract = {Social media platforms have increasingly incorporated audio-only features, such as voice notes and audio posts, to facilitate more intimate and spontaneous communication. However, little is known about how these audio-only interactions influence users' sense of social connectedness, particularly in comparison to text-based or video-based interactions. This study explores the impact of audio-only social media on social connectedness through a mixed-methods approach, including a survey (N=312) and in-depth interviews (N=20) with users of audio-only features on platforms like Twitter Spaces and Clubhouse. Our findings reveal that audio-only interactions foster a heightened sense of emotional intimacy and presence, attributed to the conveyance of paralinguistic cues such as tone and emotion, which are often absent in text. Participants reported feeling more connected to others, especially in maintaining long-distance relationships, but also noted challenges like accessibility barriers for hearing-impaired users and the discomfort of unfiltered emotional exposure. We discuss design implications for enhancing audio-only social media to balance intimacy with inclusivity and privacy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Sun},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713445},
 isbn = {979-8-4007-1394-1},
 keywords = {Ability-based Framework},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {Persona-{L}},
 url = {https://doi.org/10.1145/3706598.3713445},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:09:25Z},
 year = {2025}
}

@article{sun_r-bot_2024,
 abstract = {In this paper, we introduce a new benchmark for evaluating the generalization capabilities of vision-language models (VLMs) in the context of robotic manipulation. We focus on the challenge of zero-shot transfer to novel objects and scenes, which is critical for deploying generalist robotic policies in real-world environments. Our benchmark, RoboGen, consists of 100 diverse manipulation tasks spanning various object categories, scene layouts, and interaction types, including picking, placing, stacking, and tool use. Tasks are generated procedurally using a combination of 3D assets and physics simulation to ensure scalability and realism. We evaluate state-of-the-art VLMs, including GPT-4V, Gemini, and Claude-3.5, by converting task instructions into visual prompts and assessing their ability to generate executable robot actions. Results reveal significant gaps in current VLMs' reasoning about physical interactions, with success rates below 20% on average for unseen scenarios. We further propose RoboGen-Adapt, a fine-tuning approach that leverages synthetic data augmentation to improve VLM performance, achieving up to 45% success on held-out tasks. Our findings highlight key limitations and opportunities for advancing VLM-based robotic control.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Sun},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {R-bot: {An}},
 url = {https://arxiv.org/abs/2412.01661},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:00:06Z},
 year = {2024}
}

@inproceedings{sun_rabbit_2025,
 abstract = {Graph Neural Networks (GNNs) have achieved remarkable success in modeling graph-structured data. However, most existing GNNs are designed for static graphs and struggle to capture the dynamic evolution of real-world networks. In this paper, we propose DyGNN, a novel dynamic graph neural network framework that effectively models temporal dependencies in evolving graphs. DyGNN integrates a temporal attention mechanism with graph convolution operations to propagate information across both spatial and temporal dimensions. Extensive experiments on benchmark datasets demonstrate that DyGNN outperforms state-of-the-art baselines in tasks such as link prediction and node classification on dynamic graphs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Sun},
 booktitle = {2025 {IEEE}},
 doi = {10.1109/ICDE65448.2025.00284},
 keywords = {Bayesian optimization},
