@inproceedings{jayawardene_tablinkllm_2024,
 abstract = {Large language models (LLMs) have demonstrated remarkable capabilities in understanding and generating human-like text, enabling the development of autonomous agents that can perform complex tasks by interacting with external environments. This paper presents a comprehensive survey on LLM-based autonomous agents, focusing on their architectures, key components, applications, and challenges. We first introduce the foundational concepts of autonomous agents and discuss how LLMs serve as the core reasoning engine. Then, we categorize the architectures of LLM-based agents into single-agent and multi-agent systems, and delve into essential components such as perception, memory, planning, and action execution. Furthermore, we review diverse applications including software engineering, web navigation, robotics, and scientific discovery. Finally, we identify current limitations and outline promising future research directions to advance the field.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Jayawardene},
 doi = {10.1109/WI-IAT62293.2024.00035},
 keywords = {source: Scopus},
