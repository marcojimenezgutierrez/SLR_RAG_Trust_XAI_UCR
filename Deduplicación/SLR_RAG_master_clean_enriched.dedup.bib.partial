 keywords = {source: Google Scholar},
 note = {Publisher: dl.acm.org},
 pages = {517--527},
 publisher = {Association for Computing Machinery},
 series = {{ESEM}},
 title = {Beyond words: {On}},
 url = {https://doi.org/10.1145/3674805.3695401},
 x_enrich_source = {x-ai/grok-4-fast},
