@inproceedings{tu_r-eval_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating code, but their outputs can be brittle and hard to control, especially for complex, multi-step programming tasks. Visual programming environments offer an intuitive way to compose programs by connecting visual blocks, but integrating LLMs into such environments remains underexplored. We present LLMChain, a visual programming system that enables users to build LLM-powered applications by chaining prompts and connecting them to visual blocks for data flow and control. LLMChain supports iterative prompt refinement, intermediate output inspection, and integration with external APIs. Through a study with 12 developers, we found that LLMChain significantly reduces the time to prototype LLM applications and improves perceived control over the model's behavior compared to text-based prompting. Our system demonstrates a promising direction for making LLM programming more accessible and reliable.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
