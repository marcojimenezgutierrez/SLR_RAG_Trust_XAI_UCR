 title = {Auto-{GDA}},
 url = {https://arxiv.org/abs/2410.03461},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:03:13Z},
 year = {2024}
}

@inproceedings{leemann_auto-gda_2025,
 abstract = {This study investigates the impact of climate change on agricultural productivity in sub-Saharan Africa, using panel data from 1990 to 2020 across 20 countries. Employing a fixed-effects regression model augmented with instrumental variables to address endogeneity, we find that rising temperatures and erratic precipitation patterns have led to a 15-20% decline in crop yields, particularly for staple crops like maize and sorghum. Adaptation strategies, such as improved irrigation and drought-resistant varieties, mitigate losses by up to 40%, but their adoption remains low due to financial and infrastructural constraints. Policy recommendations include increased investment in climate-resilient agriculture and international support for smallholder farmers.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Leemann},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {90986 -- 91017},
 title = {{AUTO}},
 url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105010261957&partnerID=40&md5=00d53ba28c1e27e4ef4a44edcafa83b5},
