 year = {2025}
}

@inproceedings{shen_iotcoder_2024,
 abstract = {Visual programming languages (VPLs) promise to make programming more accessible, but their design for non-programmers remains underexplored. We investigate VPLs for visual artists---a group with little programming experience but strong aesthetic and creative needs---through three design workshops with 18 artists. Participants created mockups of VPLs for artistic tasks, revealing tensions between expressiveness and simplicity, the importance of visual metaphors from art practices, and challenges in integrating VPLs with existing tools. Based on these insights, we designed ArtScript, a VPL that uses node-based visual scripting inspired by artists' sketching and diagramming habits. A study with 12 artists showed ArtScript supported rapid prototyping of interactive art while feeling intuitive, though scalability for complex projects remains a challenge. Our work contributes design guidelines for artist-centered VPLs and highlights opportunities for VPLs to bridge creative domains.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Shen},
