@article{kermani_systematic_2025,
 abstract = {We introduce a novel framework for training large language models (LLMs) on code, called CodeT5+, which improves upon the original CodeT5 model by incorporating span corruption as a pretraining objective and using a span decoder to reconstruct corrupted spans of tokens. We pretrain CodeT5+ on the multi-task mixture-of-denoising dataset (MDD), which contains permissive code and language data from GitHub and StackOverflow. We further propose a unified code-text encoder-decoder model that jointly learns code and natural language understanding and generation. CodeT5+ achieves state-of-the-art on HumanEval (pass@1: 33.2%), MBPP (pass@1: 58.8%), and other code understanding tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kermani},
 journal = {arXiv preprint arXiv:2503.24307},
