@misc{pahwa_reliable_2024,
 abstract = {Obesity is associated with chronic low-grade inflammation and insulin resistance. Adipose tissue macrophages (ATMs) are key players in obesity-induced inflammation. We investigated whether ATMs are involved in the development of insulin resistance in diet-induced obese mice. We found that ATMs accumulated in adipose tissue of obese mice and that their accumulation correlated with adipocyte size and body weight. ATMs were the major source of tumor necrosis factor-α (TNF-α) in adipose tissue. Depletion of macrophages by clodronate liposomes improved insulin sensitivity in obese mice. Furthermore, we found that ATMs in obese mice were predominantly of the classically activated (M1) phenotype, whereas ATMs in lean mice were predominantly of the alternatively activated (M2) phenotype. The M1 phenotype of ATMs in obese mice was associated with increased expression of inflammatory genes. Our results suggest that ATMs play a critical role in obesity-induced insulin resistance and that the phenotypic switch of ATMs from M2 to M1 may be a key event in the development of insulin resistance in obesity.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Pahwa},
 keywords = {source: Google Scholar},
 note = {Type: CITATION},
 title = {Reliable {Medical}},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:58:24Z},
 year = {2024}
}

@inproceedings{painter_enhancing_2023,
 abstract = {The rapid growth of Internet of Things (IoT) devices has led to an exponential increase in data generation, necessitating efficient and secure data management solutions. Traditional centralized data storage and processing systems face challenges such as scalability, latency, and security vulnerabilities. This paper proposes a novel federated learning framework integrated with blockchain technology to enable privacy-preserving and decentralized data processing for IoT ecosystems. By leveraging federated learning, the model training occurs locally on edge devices, minimizing data transmission and enhancing privacy. Blockchain ensures secure and tamper-proof aggregation of model updates through a consensus mechanism. We evaluate the proposed framework using real-world IoT datasets, demonstrating improvements in accuracy, reduced communication overhead, and enhanced security compared to baseline methods. The results highlight the potential of this approach for scalable and trustworthy IoT applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Painter},
 booktitle = {2023 {International}},
 doi = {10.1109/CSCI62032.2023.00015},
