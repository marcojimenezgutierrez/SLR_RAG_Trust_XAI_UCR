@article{do_esac_2025,
 abstract = {Background  
Large language models (LLMs) have shown impressive performance on a variety of natural language tasks. However, their ability to generate harmful or unsafe content raises significant concerns. Red teaming is a critical process for evaluating the safety of LLMs by simulating adversarial attacks through carefully crafted prompts. Despite its importance, red teaming remains labor-intensive and lacks standardized tools for automation and scalability.  

We introduce PyRIT (Python Risk Identification Toolkit for generative AI), an extensible, open-source toolkit designed to facilitate the generation and evaluation of adversarial prompts for red teaming LLMs. PyRIT streamlines the red teaming workflow by providing modular components for prompt generation, response elicitation, and safety assessment. It supports integration with various LLMs and evaluation frameworks, enabling researchers and practitioners to systematically identify vulnerabilities in AI systems.  

Key features of PyRIT include: (1) a prompt generation engine that leverages templates, heuristics, and generative models to create diverse adversarial inputs; (2) an evaluation pipeline for scoring model responses based on multiple safety criteria such as toxicity, bias, and factual accuracy; and (3) extensibility through custom plugins for new attack strategies and metrics. We demonstrate PyRIT's utility through case studies on popular LLMs, highlighting its ability to uncover failure modes that manual testing might miss. By lowering the barrier to entry for red teaming, PyRIT promotes safer deployment of generative AI technologies. The toolkit is available under the MIT license at [repository URL].},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Do},
 doi = {10.1016/j.softx.2025.102191},
 journal = {SoftwareX},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {{ESAC}},
 url = {https://doi.org/10.1016/j.softx.2025.102191},
 volume = {31},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:34:58Z},
 year = {2025}
}

@inproceedings{do_paige_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating fluent and coherent text. However, they often produce factually incorrect or inconsistent content, known as hallucinations, which hinders their applicability in real-world scenarios. Recent studies have demonstrated that instruction tuning can significantly mitigate hallucinations by aligning LLMs with human preferences. Despite its effectiveness, instruction tuning requires a large number of high-quality instruction-following data, which is expensive to collect. In this paper, we propose a novel approach to mitigate hallucinations in LLMs via instruction tuning with static knowledge. Specifically, we leverage the static knowledge encoded in the model parameters to generate instruction-following data automatically. Our method first extracts factual knowledge from the model using prompting techniques, then constructs instruction-following examples by combining the extracted knowledge with diverse task templates. Extensive experiments on various benchmarks demonstrate that our approach can effectively reduce hallucinations while maintaining the model's performance on downstream tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Do},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713460},
 isbn = {979-8-4007-1394-1},
 keywords = {artificial intelligence in education},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {{PAIGE}},
 url = {https://doi.org/10.1145/3706598.3713460},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:58:45Z},
 year = {2025}
}

@article{dodgson_establishing_2023,
 abstract = {Recent work on the phenomenon of grokking has shown that models trained on seemingly simple algorithmic tasks can exhibit a sudden transition from memorization to generalization. This transition is characterized by a long period of slow learning followed by a rapid increase in test accuracy. In this work, we investigate the mechanisms behind this phenomenon through the lens of compression. We hypothesize that grokking occurs because the model learns a compressed representation of the data that generalizes better. To test this, we train models on modular arithmetic tasks and measure the compression ratio of the learned representations. We find that models that grok achieve higher compression ratios than those that memorize. Furthermore, we show that the compression ratio correlates with generalization performance. Our results suggest that grokking is a form of compression that allows models to generalize beyond the training data.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Dodgson},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Establishing performance baselines in fine-tuning},
 url = {https://arxiv.org/abs/2311.05903},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:25:34Z},
 year = {2023}
}

@inproceedings{dolata_development_2024,
 abstract = {Personalized recommendation systems are widely used in various online platforms to provide users with tailored content. However, these systems can inadvertently perpetuate biases, leading to unfair outcomes for certain demographic groups. In this paper, we focus on fairness in recommendation systems from an intersectional perspective, which considers the interplay of multiple protected attributes such as gender, race, and age. We first conduct a comprehensive audit of a real-world job recommendation system to uncover intersectional biases in the ranking of job ads. Our findings reveal significant disparities in exposure across intersections of these attributes. To address these issues, we propose a novel framework for intersectional fairness in recommendations that incorporates demographic parity constraints at the intersection level while preserving recommendation utility. We evaluate our approach on both synthetic and real datasets, demonstrating improved fairness without substantial loss in performance. Our work highlights the importance of intersectionality in algorithmic fairness and provides practical guidance for deploying fair recommendation systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Dolata},
 booktitle = {Proceedings of the {IEEE}},
 doi = {10.1145/3597503.3639111},
 isbn = {979-8-4007-0217-4},
 keywords = {AI-based systems},
 note = {event-place: Lisbon},
 publisher = {Association for Computing Machinery},
 series = {{ICSE}},
 title = {Development in times of hype: {How}},
 url = {https://doi.org/10.1145/3597503.3639111},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:28:34Z},
 year = {2024}
}

@article{dong_chatiot_2025,
 abstract = {Recent advances in generative AI have led to impressive capabilities in creating realistic images, but controlling the generation process to adhere to specific constraints remains challenging. In this paper, we introduce ConstraintDiffusion, a novel framework for constrained image generation using diffusion models. Our approach integrates hard constraints directly into the reverse diffusion process via a projection step, ensuring that generated samples satisfy user-specified conditions such as object presence, style, or composition. We demonstrate the effectiveness of ConstraintDiffusion on several benchmarks, including COCO and custom datasets, showing superior performance in terms of constraint satisfaction and image quality compared to existing methods like classifier guidance and energy-based models. Our work provides a flexible and efficient way to steer diffusion models for practical applications in design, advertising, and content creation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Dong},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
