@article{muhamed_ccrs_2025,
 abstract = {We introduce a novel approach to training diffusion models for high-resolution image synthesis that leverages a cascaded pipeline of super-resolution models. Our method, called Cascaded Diffusion Models (CDM), consists of a base text-to-image diffusion model trained on low-resolution images, followed by a series of super-resolution diffusion models that progressively upsample the output to higher resolutions. This architecture allows for efficient training on large-scale datasets while achieving state-of-the-art results on high-resolution benchmarks. We demonstrate the effectiveness of CDM on class-conditional and text-conditional generation tasks, showing improved sample quality and diversity compared to previous methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
