 year = {2025}
}

@inproceedings{tsutsui_case_2024,
 abstract = {We present a novel approach for high-fidelity 3D content creation from multi-view images. Our method, ZipLoRA, enables the generation of any subject in any style by effectively merging multiple Low-Rank Adaptations (LoRAs) of large-scale diffusion models. Unlike prior works that struggle with merging multiple LoRAs due to catastrophic forgetting or style leakage, ZipLoRA introduces a zippering mechanism that disentangles subject and style representations during the merging process. This allows for seamless integration of diverse subjects and styles without compromising fidelity or coherence. Extensive experiments demonstrate that ZipLoRA outperforms existing methods in generating photorealistic and stylized 3D assets, achieving superior visual quality and controllability.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Tsutsui},
