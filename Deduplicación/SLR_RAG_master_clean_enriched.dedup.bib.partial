 x_enrich_ts = {2025-11-02T09:41:52Z},
 year = {2024}
}

@article{al_atraqchi_large_2025,
 abstract = {Multimodal learning has been a popular topic in machine learning research in recent years. It aims to build models that can process and relate information from multiple modalities. In this paper, we provide a comprehensive survey of deep learning methods for multimodal data fusion. We first introduce the basic concepts of multimodal learning and data fusion. Then, we categorize the existing deep learning methods for multimodal data fusion into three main categories: early fusion, late fusion, and hybrid fusion. For each category, we discuss the representative methods, their advantages and disadvantages, and the application scenarios. Finally, we discuss the challenges and future directions in this field.},
