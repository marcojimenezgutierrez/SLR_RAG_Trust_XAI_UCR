@inproceedings{noauthor_icsob-c_2025,
 abstract = {This study investigates the role of artificial intelligence in enhancing cybersecurity measures within financial institutions. Utilizing a mixed-methods approach, including surveys of 500 IT professionals and case studies from major banks, the research identifies key vulnerabilities and proposes an AI-driven framework for real-time threat detection. Findings reveal a 35% improvement in response times and a significant reduction in breach incidents. The framework integrates machine learning algorithms with blockchain for secure data handling, offering practical implications for regulatory compliance and risk management. Limitations include the sample's focus on developed economies, suggesting avenues for future cross-cultural research.},
