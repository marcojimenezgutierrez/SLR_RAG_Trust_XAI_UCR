@inproceedings{kaczmarek_optimizing_2025,
 abstract = {The rapid evolution of Internet of Things (IoT) devices has significantly expanded the attack surface for cyber threats, making traditional centralized intrusion detection systems (IDS) inadequate due to privacy concerns and data silos. Federated Learning (FL) emerges as a promising paradigm, enabling collaborative model training across distributed IoT devices without sharing raw data. This paper conducts a systematic literature review (SLR) to analyze the application of FL in IoT intrusion detection. Following the PRISMA guidelines, we reviewed 52 primary studies from 2018 to 2023, sourced from prominent databases such as IEEE Xplore, ACM Digital Library, SpringerLink, and ScienceDirect. Our analysis reveals key trends, including prevalent FL algorithms (e.g., FedAvg), communication protocols, and evaluation metrics. We identify common challenges such as communication overhead, model convergence, and handling non-IID data distributions, alongside opportunities for future research in privacy-preserving techniques and real-world deployment. This SLR provides a comprehensive overview, guiding researchers and practitioners in leveraging FL for robust, privacy-centric IoT security.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Kaczmarek},
 booktitle = {International {Conference}},
 doi = {10.5220/0013477700003932},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {174 -- 186},
 title = {Optimizing {Retrieval}},
 url = {https://doi.org/10.5220/0013477700003932},
 volume = {2},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:59:34Z},
 year = {2025}
}

@article{kadam_enhancing_2025,
 abstract = {Federated learning (FL) is a distributed machine learning paradigm that enables collaborative model training across multiple devices while preserving data privacy. In the context of the Internet of Things (IoT), FL addresses the challenges of data heterogeneity, resource constraints, and privacy concerns inherent in IoT ecosystems. This survey provides a comprehensive overview of FL applications in IoT, including key techniques, challenges, and future directions. We first introduce the fundamentals of FL and its integration with IoT. Then, we categorize FL-based IoT applications into several domains, such as smart healthcare, intelligent transportation, and industrial IoT. For each domain, we discuss specific FL architectures, algorithms, and real-world implementations. We also highlight the unique challenges in IoT environments, including communication overhead, non-IID data distribution, and device heterogeneity. Finally, we outline open research issues and potential future trends, such as integration with edge computing and blockchain for enhanced security.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
