}

@inproceedings{xu_design_2025,
 abstract = {This paper explores the integration of artificial intelligence in software architecture design processes. We propose a novel AI-driven framework that automates the generation and optimization of architectural patterns for large-scale systems. By leveraging machine learning algorithms on historical design data, our approach reduces design time by up to 40% while improving scalability and maintainability. Case studies from industrial applications demonstrate the framework's effectiveness in handling complex, distributed environments.},
