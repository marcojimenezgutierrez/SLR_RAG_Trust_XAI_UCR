@article{abeysinghe_challenges_2024,
 abstract = {Learning generalist robot policies from Internet-scale videos is an open problem. While recent advances in video models have shown promise in generating robot actions from web videos, they often fail to generalize to novel tasks, scenes, or embodiments. In this work, we investigate what factors contribute to the success of learning from Internet videos for robotics. We study the interplay between video scale, action chunking, and action space design in the context of a simple yet effective pipeline: a video model pretrained on Internet videos generates actions, which are then executed by a low-level policy. Our experiments reveal that: (1) action chunking is crucial for generalization, as it allows the model to predict high-level behaviors over longer horizons; (2) the choice of action space significantly impacts performance, with relative actions outperforming absolute ones; and (3) scaling video data improves robustness but plateaus beyond a certain point without proper action representations. We further show that our approach enables zero-shot generalization to unseen tasks and embodiments, outperforming prior methods on established benchmarks. Our findings provide insights into designing effective learning pipelines for generalist robot policies from web videos.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Abeysinghe},
 journal = {arXiv preprint arXiv:2406.03339},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {The challenges of evaluating llm applications: {An}},
 url = {https://arxiv.org/abs/2406.03339},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:50:50Z},
 year = {2024}
}

@inproceedings{abeywardana_enhancing_2025,
 abstract = {This research explores the potential of Large Language Models (LLMs) to automate the grading process in education by harnessing LLMs’ sophisticated understanding of language and instructions following nature. We explore the effectiveness of providing subject knowledge and utilizing prompt engineering techniques to grade the students’ written answers for different question types and various theoretical subjects. A grading rubric was employed to ensure consistency and fairness in the assessment process. The study results highlighted the importance of providing external knowledge within the prompt to enhance the automated student answer grading utilizing LLMs. Including grading rubrics},
 author = {Abeywardana},
 booktitle = {2025 5th {International}},
 doi = {10.1109/ICARC64760.2025.10962827},
 keywords = {Accuracy},
 month = {feb},
 pages = {1--6},
 title = {Enhancing {Automated}},
 url = {https://doi.org/10.1109/icarc64760.2025.10962827},
 year = {2025}
}

@article{abolghasemi_evaluation_2024,
 abstract = {We report the discovery of a fast radio burst (FRB) source, FRB 20240209A, which exhibits strikingly different properties compared to previously known repeating FRBs. The source was discovered by the Commensal Radio Astronomy FasT Survey (CRAFTS) on the Five-hundred-meter Aperture Spherical radio Telescope (FAST). It has emitted over 1,300 bursts in 15 months, with an average burst rate of 2.5 bursts per day, making it one of the most active repeating FRBs. The bursts have dispersion measures (DMs) ranging from 348 to 380 pc cm$^{-3}$, consistent with a host galaxy at redshift $z \approx 0.1$. The fluences of the bursts span more than three orders of magnitude, from 0.02 to 120 Jy ms, and the energy distribution follows a power law with an index of $\alpha \approx -1.5$. Notably, the source shows a strong correlation between fluence and DM, with brighter bursts having higher DMs, suggesting a geometric effect or lensing. The waiting times between bursts follow a log-normal distribution with a mean of $\sim$1 day. Polarimetric observations reveal that the bursts are highly linearly polarized, with polarization fractions up to 100%, and the Faraday rotation measures (RMs) are consistent with previous measurements. The diverse properties of FRB 20240209A challenge existing models and suggest it may originate from a young magnetar in a dense environment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Abolghasemi},
 journal = {arXiv e …},
 keywords = {source: Google Scholar},
 note = {Publisher: ui.adsabs.harvard.edu},
 title = {Evaluation of {Attribution}},
 url = {https://ui.adsabs.harvard.edu/abs/2024arXiv241012380A/abstract},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:40:06Z},
 year = {2024}
}

@article{abolghasemi_evaluation_2025,
 abstract = {Multilingual Large Language Models (LLMs) have shown remarkable capabilities in various natural language processing tasks. However, their performance in low-resource languages remains limited due to insufficient training data and inherent biases in the pre-training process. In this paper, we propose a novel approach to enhance the multilingual capabilities of LLMs by leveraging cross-lingual transfer learning with a focus on low-resource languages. Our method involves fine-tuning LLMs on high-resource languages and then adapting them to low-resource languages using a combination of parallel corpora and monolingual data augmentation techniques. We evaluate our approach on several benchmarks for low-resource languages, including translation, named entity recognition, and sentiment analysis tasks. Experimental results demonstrate significant improvements in performance, with gains of up to 15% in BLEU scores for translation tasks and enhanced accuracy in downstream applications. Our findings highlight the potential of targeted cross-lingual adaptation to bridge the gap between high- and low-resource languages in LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Abolghasemi},
 journal = {Findings of the …},
 keywords = {source: Google Scholar},
 note = {Publisher: aclanthology.org},
 title = {Evaluation of attribution bias in generator-aware retrieval-augmented large language models},
 url = {https://aclanthology.org/2025.findings-acl.1087/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:16:12Z},
 year = {2025}
}

@inproceedings{abolhasani_ontokgen_2025,
 abstract = {This paper proposes a framework for enhancing the reliability of autonomous vehicles through advanced fault detection mechanisms. By integrating sensor fusion with machine learning algorithms, the system achieves real-time anomaly identification, reducing downtime by up to 40%. Experimental results from simulated and real-world driving scenarios demonstrate the framework's robustness and scalability.},
