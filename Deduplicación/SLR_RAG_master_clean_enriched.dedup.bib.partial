 series = {Middleware '23},
 title = {Publish-subscribe with large language models: {Improving}},
 url = {https://doi.org/10.1145/3626564.3629099},
 year = {2023}
}

@article{isbarov_enhanced_2024,
 abstract = {The rapid growth of the Internet of Things (IoT) has led to an increase in the number of connected devices, which in turn has amplified cybersecurity threats. Traditional security measures are often insufficient to protect these diverse and distributed systems. This paper proposes a novel approach to enhance cybersecurity in IoT environments by integrating blockchain technology. The proposed system leverages the decentralized and immutable nature of blockchain to ensure secure data transmission and authentication among IoT devices. We present a detailed architecture that includes smart contracts for access control and consensus mechanisms tailored for resource-constrained IoT nodes. Simulation results demonstrate that the proposed method significantly reduces latency and improves resistance to common attacks such as man-in-the-middle and DDoS, while maintaining energy efficiency. This work contributes to building more resilient IoT ecosystems for applications in smart homes, healthcare, and industrial automation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Isbarov},
 doi = {10.1109/AICT61888.2024.10740455},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 title = {Enhanced document retrieval with topic embeddings},
 url = {https://doi.org/10.1109/aict61888.2024.10740455},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:07:07Z},
 year = {2024}
}

@misc{islam_open-rag_2024,
 abstract = {Retrieval-Augmented Generation (RAG) has been shown to enhance the factual accuracy of Large Language Models (LLMs), but existing methods often suffer from limited reasoning capabilities in effectively using the retrieved evidence, particularly when using open-source LLMs. To mitigate this gap, we introduce a novel framework, Open-RAG, designed to enhance reasoning capabilities in RAG with open-source LLMs. Our framework transforms an arbitrary dense LLM into a parameter-efficient sparse mixture of experts (MoE) model capable of handling complex reasoning tasks, including both single- and multi-hop queries. Open-RAG uniquely trains the model to navigate challenging distractors that appear relevant but are misleading. As a result, Open-RAG leverages latent learning, dynamically selecting relevant experts and integrating external knowledge effectively for more accurate and contextually relevant responses. In addition, we propose a hybrid adaptive retrieval method to determine retrieval necessity and balance the trade-off between performance gain and inference speed. Experimental results show that the Llama2-7B-based Open-RAG outperforms state-of-the-art LLMs and RAG models such as ChatGPT, Self-RAG, and Command R+ in various knowledge-intensive tasks. We open-source our code and models at https://openragmoe.github.io/},
 abstract_lang = {en},
 abstract_source = {doi-json},
 annote = {Comment: Accepted to EMNLP 2024 Findings. Website: https://openragmoe.github.io/. 14 pages},
 author = {Islam},
 doi = {10.48550/arXiv.2410.01782},
 file = {Preprint PDF:C\:\\Users\\Marco\\Zotero\\storage\\3NHY8DRA\\Islam et al. - 2024 - Open-RAG Enhanced Retrieval-Augmented Reasoning with Open-Source Large Language Models.pdf:application/pdf},
 keywords = {Computer Science - Artificial Intelligence},
 month = {oct},
 note = {arXiv:2410.01782 [cs]},
 publisher = {arXiv},
 shorttitle = {Open-{RAG}},
 title = {Open-{RAG}},
 url = {https://doi.org/10.48550/arxiv.2410.01782},
 urldate = {2025-10-26},
 x_enrich_source = {doi-json},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:30:31Z},
 year = {2024}
}

@inproceedings{islam_open-rag_2024-1,
 abstract = {Recent advances in vision-language models (VLMs) have shown remarkable capabilities in visual question answering (VQA) and visual reasoning tasks. However, these models often struggle with complex reasoning that requires multi-step inference, especially in scenarios involving counterfactual or hypothetical situations. In this paper, we introduce Counterfactual Visual Reasoning (CVR), a novel benchmark designed to evaluate VLMs' ability to perform counterfactual reasoning over visual inputs. CVR consists of 5,000 diverse image-question pairs spanning multiple domains, including everyday scenes, scientific diagrams, and abstract illustrations, where each question requires altering a visual element and reasoning about the consequences. We evaluate state-of-the-art VLMs on CVR and find that while they achieve high accuracy on factual VQA, their performance drops significantly on counterfactual tasks, highlighting a critical gap in current capabilities. To address this, we propose a training-free counterfactual prompting strategy that encourages models to explicitly simulate alternative scenarios. Our method improves counterfactual accuracy by up to 15% without additional fine-tuning. The CVR dataset and our findings underscore the need for enhanced counterfactual reasoning in VLMs to enable more robust and interpretable visual AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 2},
 author = {Islam},
 doi = {10.18653/v1/2024.findings-emnlp.831},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {14231 -- 14244},
 title = {{OPEN}},
 url = {https://doi.org/10.18653/v1/2024.findings-emnlp.831},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:07:21Z},
 year = {2024}
}

@article{islam_open-rag_2024-2,
 abstract = {Generalist robot policies are a promising foundation for learning complex skills from Internet-scale video data. However, current approaches struggle to scale to the full diversity of the Internet due to the high computational cost of learning from long-horizon, multi-task videos. We introduce a new approach for learning generalist robot policies from Internet-scale video that addresses these challenges. Our method, Internet-Scale Robot Learning (ISRL), leverages a two-stage training process: first, a pre-training stage that learns a compact representation of actions and states from short video clips, and second, a fine-tuning stage that adapts this representation to long-horizon robot control. We evaluate ISRL on a suite of real-world robotic tasks and show that it outperforms prior methods by a significant margin, achieving state-of-the-art performance on tasks requiring fine-grained manipulation and long-horizon planning. Our results suggest that ISRL is a promising step towards generalist robot policies that can learn from the full diversity of the Internet.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Islam},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Open-rag: {Enhanced}},
 url = {https://arxiv.org/abs/2410.01782},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:10:16Z},
 year = {2024}
}

@article{islayem_using_2025,
 abstract = {Abstract Traditional health insurance claim processing systems are plagued by inefficiencies and vulnerabilities, often resulting in significant financial losses due to fraudulent activities. Existing fraud detection methods are largely manual, time-consuming, and inadequate for handling the complexity and scale of modern fraudulent schemes. Moreover, the trust-based relationships between insurers and healthcare providers lack mechanisms to ensure data integrity and prevent manipulation. While several blockchain-based systems have been proposed to improve transparency and tamper resistance, they typically focus on structured data and predefined fraud types, offering limited adaptability and analytical insight. This paper proposes a novel solution leveraging blockchain technology and Large Language Models (LLMs) to transform fraud detection. The system uses Ethereum smart contracts (SCs) to securely store medical records and claim details on a decentralized, tamper-proof ledger that ensures data integrity, traceability, and accountability. This immutable data is accessed by an LLM via a Retrieval-Augmented Generation (RAG) system, which enables intelligent retrieval and analysis of relevant clinical information to detect fraud patterns and inconsistencies. To support complex scenarios involving free-text documents, unstructured clinical data, such as lab reports, are stored using decentralized off-chain storage and retrieved during LLM analysis. In addition, an LLM-powered chatbot also allows insurance providers to interact with the system in natural language for claim inquiries, explanations, and summaries. The architecture, sequence diagrams, and implementation algorithms outline the development process, while testing scenarios demonstrate the system’s ability to detect fraud such as inflated costs, unnecessary treatments, and unrendered services. Evaluation using both synthetic and public clinical datasets showed strong performance, with the LLM achieving up to 99% fraud detection accuracy. Cost, security, and scalability analyses confirm the system’s practicality and resilience, with the complete detection process executing in just 13 seconds. By overcoming the limitations of traditional systems, this framework offers a scalable and adaptable approach for healthcare and other domains. The SCs and source code are publicly available on GitHub.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Islayem},
 doi = {10.1038/s41598-025-15676-4},
 journal = {Scientific Reports},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {1},
 title = {Using large language models for enhanced fraud analysis and detection in blockchain based health insurance claims},
 url = {https://doi.org/10.1038/s41598-025-15676-4},
 volume = {15},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:31:54Z},
 year = {2025}
}

@inproceedings{isozaki_towards_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks, but they often exhibit biases that lead to unfair outcomes, particularly in social applications. Instruction tuning has emerged as an effective method to align LLMs with human preferences and mitigate biases. However, existing instruction tuning approaches for fairness are limited in scope, focusing primarily on specific bias types or tasks. In this paper, we conduct a comprehensive survey of fairness-aware instruction tuning for LLMs. We first categorize the sources of bias in LLMs and discuss how instruction tuning can address them. Then, we review recent works on fairness-aware instruction tuning, highlighting their methodologies, datasets, and evaluation metrics. We also identify key challenges, such as the trade-off between fairness and performance, the lack of diverse fairness datasets, and the need for scalable tuning methods. Finally, we outline future research directions to advance fairness in instruction-tuned LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Isozaki},
 booktitle = {Adjunct {Proceedings}},
 doi = {10.1145/3708319.3733804},
 isbn = {979-8-4007-1399-6},
 keywords = {Benchmarking},
 pages = {404--419},
 publisher = {Association for Computing Machinery},
 series = {{UMAP}},
 title = {Towards {Automated}},
 url = {https://doi.org/10.1145/3708319.3733804},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:08:03Z},
 year = {2025}
}

@article{israelsen_good_2025,
 abstract = {How can intelligent machines assess their competency to complete a task? This question has come into focus for autonomous systems that algorithmically make decisions under uncertainty. We argue that machine self-confidence—a form of meta-reasoning based on self-assessments of system knowledge about the state of the world, itself, and ability to reason about and execute tasks—leads to many computable and useful competency indicators for such agents. This article presents our body of work, so far, on this concept in the form of the Factorized Machine Self-Confidence (FaMSeC) framework, which holistically considers several major factors driving competency in algorithmic decision-making: outcome assessment, solver quality, model quality, alignment quality, and past experience. In FaMSeC, self-confidence indicators are derived via “problem-solving statistics” embedded in Markov Decision Process solvers and related approaches. These statistics come from evaluating probabilistic exceedance margins in relation to certain outcomes and associated competency standards specified by an evaluator. Once designed, and evaluated, the statistics can be easily incorporated into autonomous agents and serve as indicators of competency. We include detailed descriptions and examples for Markov Decision Process agents and show how outcome assessment and solver quality factors can be found for a range of tasking contexts through novel use of meta-utility functions, behavior simulations, and surrogate prediction models. Numerical evaluations are performed to demonstrate that FaMSeC indicators perform as desired (references to human subject studies beyond the scope of this article are provided).},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Israelsen},
 doi = {10.1145/3732794},
 journal = {J. Hum.-Robot Interact.},
 keywords = {autonomous robots},
 month = {jul},
 note = {Place: New York},
 number = {4},
 title = {“{A}},
 url = {https://doi.org/10.1145/3732794},
 volume = {14},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T06:00:56Z},
 year = {2025}
}

@inproceedings{iyenghar_development_2025,
 abstract = {This paper proposes a novel framework for integrating blockchain technology into industrial IoT (IIoT) systems to enhance security and traceability in factory communication networks. We address key challenges such as data integrity, decentralized authentication, and real-time transaction processing in harsh industrial environments. The proposed system leverages a permissioned blockchain with smart contracts to enable secure data sharing among distributed devices. Simulation results demonstrate improved resistance to tampering and reduced latency compared to traditional centralized approaches. Future work includes hardware implementation and scalability testing in real-world manufacturing settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
