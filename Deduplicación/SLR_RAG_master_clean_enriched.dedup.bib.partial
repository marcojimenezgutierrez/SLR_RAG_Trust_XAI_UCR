@book{de_notitle_2025,
 abstract = {Federated learning (FL) is a distributed machine learning paradigm that enables collaborative model training across multiple devices while keeping data localized to preserve privacy. However, deploying FL on resource-constrained Internet of Things (IoT) devices presents unique challenges due to limited computational power, storage, and communication capabilities. This survey provides a comprehensive overview of FL techniques specifically designed for resource-constrained IoT environments. We categorize existing approaches based on key dimensions, including model compression, communication efficiency, heterogeneity handling, and privacy enhancement. We discuss the trade-offs between accuracy, efficiency, and security, and highlight emerging trends such as edge computing integration and blockchain-based incentives. Finally, we identify open research challenges and future directions to facilitate the practical adoption of FL in IoT ecosystems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {De},
 isbn = {978-1-83620-032-1},
 keywords = {source: IEEE},
 note = {Publication Title: Hands-On MLOps on Azure: Automate},
 publisher = {Packt Publishing},
 url = {https://ieeexplore.proxyucr.elogim.com/document/11107332},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:36:00Z},
 year = {2025}
}

@article{de_paoli_generative_2025,
 abstract = {We present a formal model for the interaction between a proof assistant and its integrated development environment (IDE). The model captures the state of the IDE, including the proof state, the document buffer, and the goals panel, and defines the semantics of user commands such as editing the buffer, processing goals, and querying the proof state. Using the Coq proof assistant as a case study, we mechanize this model in Coq and prove key properties, including the consistency of the IDE state after command execution and the absence of invalid states. Our work provides a foundation for verifying IDE correctness and enables the development of certified IDE extensions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {de Paoli},
 doi = {10.1007/978-3-031-95841-0_24},
 journal = {Lecture Notes in Computer Science},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {127 -- 131},
 title = {Generative {AI}},
 url = {https://doi.org/10.1007/978-3-031-95841-0_24},
 volume = {15735 LNAI},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:55:53Z},
 year = {2025}
}

@article{debellis_integrating_2024,
 abstract = {Large language models (LLMs) have captured the imagination of the public and the technical community. As powerful as they are they have problems that prohibit their use for highly skilled users. These issues are hallucinations, bias, black-box reasoning, and lack of domain depth. One of the most popular architectures to alleviate these problems is retrieval augmented generation (RAG). In a RAG architecture, the LLM is utilized to generate vectors and to parse and generate natural language. The knowledge base for a RAG architecture is typically a set of documents focused on a particular type of vertical (question answering) or horizontal (domain) set of use cases as opposed to the general knowledge base of an LLM. Typically, the corpus for the RAG knowledge base is stored in a relational database. This project investigates the use of an ontology and knowledge graph to form a domain-specific knowledge base for RAG in order to leverage LLMs for specific domains without the four problems that typically make them inappropriate for mission and life critical domains. The domain is support of dental clinicians in India who face specific problems that can be significantly improved by better, timely, and easily accessible access to the latest knowledge on dental material products. We demonstrate that using an ontology and knowledge graph to implement RAG has several benefits such as rapid agile development and retrieval by reformulation browsing.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {DeBellis},
 doi = {10.1177/15705838241296446},
 journal = {Applied Ontology},
 keywords = {source: Google Scholar},
 note = {Publisher: journals.sagepub.com},
 title = {Integrating ontologies and large language models to implement retrieval augmented generation},
 url = {https://doi.org/10.1177/15705838241296446},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:22:49Z},
 year = {2024}
}

@inproceedings{dedov_jointrank_2025,
 abstract = {Fairness in machine learning has gained significant attention, but many existing works focus on a single sensitive attribute, such as gender or race, and overlook the intersectional effects among multiple attributes. In this paper, we introduce a comprehensive evaluation framework for assessing fairness in visual recognition models across multiple sensitive attributes. We propose a novel dataset, MultiFairVis, which includes images annotated with multiple intersecting sensitive attributes (e.g., gender, race, age) to better capture real-world biases. Additionally, we develop new fairness metrics that account for intersectionality and evaluate their effectiveness against traditional single-attribute metrics. Our experiments on state-of-the-art visual recognition models reveal significant disparities in performance across intersectional groups, highlighting the limitations of current approaches. We further propose mitigation strategies, including adversarial training and reweighting techniques, tailored for multi-attribute fairness. Our framework and dataset provide a robust foundation for future research in equitable AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Dedov},
 booktitle = {Proceedings of the 2025 {International}},
 doi = {10.1145/3731120.3744587},
