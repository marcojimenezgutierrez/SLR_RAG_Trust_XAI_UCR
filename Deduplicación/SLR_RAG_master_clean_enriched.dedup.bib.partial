 title = {A {Novel}},
 url = {https://doi.org/10.1109/urtc65039.2024.10937570},
 year = {2024}
}

@inproceedings{snyder_early_2024,
 abstract = {Social media platforms have become a primary source for detecting and analyzing real-world events, but the scarcity of labeled data poses a significant challenge for training effective event detection models. In this paper, we investigate the potential of Large Language Models (LLMs) for data augmentation in social media event detection. We propose a novel framework that leverages the generative capabilities of LLMs to create synthetic event-related posts, thereby enriching the training dataset. Our approach involves prompt engineering to generate contextually relevant and diverse synthetic data that mimics real-world social media content. We evaluate our method on benchmark datasets for event detection, demonstrating significant improvements in model performance metrics such as precision, recall, and F1-score. Additionally, we conduct a qualitative analysis to assess the quality and realism of the generated data. Our findings highlight the efficacy of LLMs in addressing data scarcity issues and open avenues for further research in LLM-assisted data augmentation for social NLP tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
