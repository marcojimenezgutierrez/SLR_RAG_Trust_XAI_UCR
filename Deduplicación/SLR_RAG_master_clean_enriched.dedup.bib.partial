@inproceedings{golgoon_mechanistic_2024,
 abstract = {Visual Question Answering (VQA) systems have achieved remarkable performance in recent years, but they often exhibit biases towards certain demographics, leading to unfair outcomes. In this paper, we investigate fairness in VQA from a novel perspective: the interaction between visual and textual modalities. We propose a framework to measure and mitigate bias in VQA models by disentangling the contributions of images and questions to biased predictions. Our approach involves creating a fairness-aware dataset and training models that balance performance across demographic groups. Experiments on standard VQA benchmarks demonstrate that our method significantly reduces bias while maintaining high accuracy, paving the way for more equitable AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Golgoon},
 booktitle = {Proceedings of the 5th {ACM}},
 doi = {10.1145/3677052.3698612},
