 isbn = {979-8-4007-0490-1},
 journal = {Proceedings of the 30th ACM …},
 keywords = {source: Google Scholar},
 note = {Publisher: dl.acm.org},
 pages = {1119--1130},
 publisher = {Association for Computing Machinery},
 series = {{KDD}},
 title = {Prompt perturbation in retrieval-augmented generation based large language models},
 url = {https://doi.org/10.1145/3637528.3671932},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:21:26Z},
 year = {2024}
}

@article{hu_rag_2024,
 abstract = {Large, high-capacity models trained on broad data can provide a strong foundation for generalizing to new tasks and environments. However, the lack of large-scale datasets in the robotics domain limits the ability to train such models. To address this, we present Open X-Embodiment (OXE): a large-scale collection of diverse, robot learning datasets totaling over one million trajectories and 500,000 hours of data. OXE encompasses a wide variety of robot embodiments, tasks, and environments, including both real and simulated data. We also introduce RT-X, a vision-language-action (VLA) model trained on OXE, which demonstrates strong performance on a range of robotic manipulation tasks. Our results show that scaling up robot learning datasets and models leads to significant improvements in generalization and performance. We release all datasets and models to enable further research in the field.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
