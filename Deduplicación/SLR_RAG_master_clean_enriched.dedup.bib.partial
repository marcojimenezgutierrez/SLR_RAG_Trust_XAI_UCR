@inproceedings{chakraborty_empirical_2025,
 abstract = {We propose a novel neural representation for 3D flows, termed Neural Implicit Flow (NIFlow), which enables efficient modeling and editing of dynamic scenes from monocular videos. Unlike existing methods that rely on explicit voxel grids or point clouds, NIFlow implicitly represents the 3D flow field using a neural network conditioned on time and space. This allows for compact storage and fast inference while capturing complex motion patterns. We demonstrate the effectiveness of NIFlow in video editing tasks, such as object insertion, motion transfer, and scene inpainting, achieving superior quality and efficiency compared to state-of-the-art approaches.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
