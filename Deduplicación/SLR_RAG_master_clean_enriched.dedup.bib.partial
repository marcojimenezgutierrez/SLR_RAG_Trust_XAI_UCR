@inproceedings{muthyala_so_2024,
 abstract = {Fairness in machine learning has gained significant attention, particularly in the context of visual recognition tasks where biased models can perpetuate societal inequalities. This paper explores strategies for mitigating bias in deep learning models for image classification. We propose a comprehensive framework that integrates debiasing techniques at both the data and model levels, including targeted data augmentation and adversarial training. Through extensive experiments on benchmark datasets such as CelebA and UTKFace, we demonstrate that our approach achieves substantial reductions in demographic parity gaps while maintaining high classification accuracy. Our findings provide practical insights for developing fairer AI systems in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
