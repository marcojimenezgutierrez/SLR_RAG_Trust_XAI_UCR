@inproceedings{yen_code_2025,
 abstract = {Recent advancements in wearable technology have introduced smart glasses as a promising tool for enhancing the daily lives of people with visual impairments (PVI). However, the design of these devices often prioritizes sighted users, resulting in accessibility barriers for PVI. This paper presents insights from a qualitative study involving 12 PVI participants who interacted with prototype smart glasses. Through semi-structured interviews and usability testing, we uncover critical design requirements, including intuitive audio feedback, customizable gesture controls, and seamless integration with screen readers. Our findings highlight the need for inclusive design principles that address privacy concerns, battery life, and social acceptability. We contribute a set of guidelines to inform future iterations of smart eyewear, fostering greater independence and user satisfaction for PVI.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Yen},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713822},
