@article{khurana_why_2024,
 abstract = {Interactive data visualization tools empower users to explore and analyze data through direct manipulation of visual representations. However, creating effective visualizations often requires programming expertise, limiting accessibility. Visual programming languages (VPLs) offer a promising alternative by allowing users to construct visualizations through graphical interfaces. Despite their potential, designing VPLs for data visualization remains underexplored. In this paper, we investigate the design space of VPLs for interactive data visualization. We first review existing VPLs and identify key design dimensions, including representation, composition, abstraction, and interaction. We then present a prototype VPL, VisFlow, that embodies these dimensions and supports a range of visualization tasks. Through a user study with 12 participants, we evaluate VisFlow's usability and expressiveness compared to a text-based tool. Our findings reveal trade-offs in learnability, efficiency, and flexibility, informing future VPL designs. We discuss implications for democratizing data visualization and outline open challenges in the field.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
