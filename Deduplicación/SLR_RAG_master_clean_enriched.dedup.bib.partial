@inproceedings{xu_automating_2024,
 abstract = {This paper presents a comprehensive survey of the integration of generative AI (GenAI) tools, such as large language models (LLMs), into computer science (CS) curricula across various educational levels. Drawing from responses by 178 CS educators worldwide, we identify key trends, challenges, and opportunities in teaching GenAI. Our findings reveal that while 70% of educators incorporate GenAI into their courses, primarily through lectures and assignments, significant barriers persist, including ethical concerns, assessment difficulties, and resource limitations. We propose a framework for GenAI curriculum design that emphasizes interdisciplinary approaches, hands-on projects, and ethical training to prepare students for an AI-driven future. This work provides actionable insights for educators aiming to adapt CS education to the rapid evolution of AI technologies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
