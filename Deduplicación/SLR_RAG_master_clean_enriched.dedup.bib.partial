@inproceedings{li_novel_2025,
 abstract = {Large language models (LLMs) have revolutionized various domains, including data engineering, by enabling natural language interactions with data systems. However, their integration into data engineering workflows remains nascent, with significant potential for automating tasks such as data cleaning, schema design, query optimization, and ETL processes. This paper surveys the current landscape of LLM applications in data engineering, categorizing existing approaches, evaluating their strengths and limitations, and identifying key challenges like hallucination, privacy concerns, and scalability. We propose a taxonomy of LLM-driven data engineering tasks and discuss future directions, including hybrid systems combining LLMs with traditional data tools, fine-tuning strategies for domain-specific data tasks, and ethical considerations for deployment in enterprise environments. Through case studies and benchmarks, we demonstrate how LLMs can enhance productivity while highlighting areas needing further research to realize their full potential.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Li},
