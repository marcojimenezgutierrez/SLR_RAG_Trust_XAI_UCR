@inproceedings{sikder_efficient_2025,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for privacy-preserving collaborative model training across distributed devices. However, traditional FL methods often suffer from high communication overhead and vulnerability to malicious participants, especially in heterogeneous environments like the Internet of Things (IoT). To address these challenges, we propose FedSecure, a secure and efficient FL framework that integrates differential privacy (DP) with secure multi-party computation (SMPC) to protect model updates while minimizing communication costs. Our approach employs a novel aggregation protocol based on homomorphic encryption, allowing for efficient secure summation without revealing individual contributions. Extensive experiments on benchmark datasets demonstrate that FedSecure achieves up to 40% reduction in communication overhead compared to state-of-the-art baselines, while maintaining model accuracy and providing strong privacy guarantees against inference attacks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
