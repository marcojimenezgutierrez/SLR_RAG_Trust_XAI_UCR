@inproceedings{wright_using_2025,
 abstract = {The purpose of this study was to examine the relationship between transformational leadership and innovative work behavior in the context of small and medium-sized enterprises (SMEs) in Vietnam. Drawing on social exchange theory and the componential theory of creativity, we proposed a moderated mediation model in which knowledge sharing mediates the relationship between transformational leadership and innovative work behavior, and organizational politics moderates the relationship between transformational leadership and knowledge sharing. Data were collected from 312 employees and their supervisors in 120 SMEs in Vietnam. Results from structural equation modeling showed that transformational leadership was positively related to innovative work behavior through knowledge sharing. Furthermore, organizational politics weakened the relationship between transformational leadership and knowledge sharing. The findings contribute to the literature on leadership and innovation by highlighting the mediating role of knowledge sharing and the moderating role of organizational politics in the transformational leadership–innovative work behavior linkage. Implications for theory and practice are discussed.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Wright},
 booktitle = {{CEUR}},
 keywords = {source: Scopus},
