 keywords = {distributed inference},
 note = {event-place: London},
 pages = {201--210},
 publisher = {Association for Computing Machinery},
 series = {{ICPE}},
 title = {Leftovers for {LLaMA}},
 url = {https://doi.org/10.1145/3629526.3645045},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:10:26Z},
 year = {2024}
}

@inproceedings{singh_meqa_2025,
 abstract = {Recent advances in large language models (LLMs) have enabled the creation of powerful AI assistants capable of performing complex tasks. However, these models often struggle with long-term planning and maintaining consistency over extended interactions. In this paper, we introduce a novel framework for enhancing LLM-based agents with hierarchical planning capabilities, drawing inspiration from cognitive architectures. Our approach decomposes tasks into high-level goals and low-level actions, allowing for more robust execution in dynamic environments. We evaluate our system on a suite of benchmarks, including multi-step reasoning and real-world task automation, demonstrating significant improvements in success rates and efficiency compared to baseline methods. Our findings suggest that integrating structured planning can bridge the gap between current LLM limitations and human-like problem-solving.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
