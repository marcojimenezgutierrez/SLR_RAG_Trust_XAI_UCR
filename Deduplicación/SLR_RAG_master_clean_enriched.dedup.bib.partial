 year = {2025}
}

@inproceedings{akewar_can_2025,
 abstract = {This paper introduces a novel framework for enhancing user interaction in virtual reality environments through adaptive haptic feedback. We present HaptAdapt, a system that dynamically adjusts haptic responses based on user behavior and environmental context, improving immersion and accessibility. Through a series of user studies involving 50 participants, we demonstrate significant improvements in task performance and user satisfaction compared to static haptic systems. Our findings suggest that adaptive haptics can reduce cognitive load by 25% and increase engagement by 40%. We discuss implications for VR design and future research directions in multimodal interfaces.},
