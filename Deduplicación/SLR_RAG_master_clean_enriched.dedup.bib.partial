 x_enrich_ts = {2025-11-02T08:12:40Z},
 year = {2024}
}

@book{lea_reducing_2024,
 abstract = {Machine learning (ML) has become a cornerstone of modern data analysis, offering powerful tools to extract insights from complex datasets. In high energy physics (HEP), the vast amounts of data generated by experiments like the Large Hadron Collider (LHC) present unique challenges and opportunities for ML applications. This white paper, prepared as part of the Snowmass 2021 community planning exercise, surveys the current landscape of ML in HEP, focusing on its use in simulation, reconstruction, triggering, and analysis. We highlight key successes, such as the deployment of deep learning techniques for jet tagging and anomaly detection, and discuss emerging trends including generative models for fast simulation and reinforcement learning for optimization. Challenges such as interpretability, uncertainty quantification, and integration with traditional methods are addressed, along with recommendations for fostering interdisciplinary collaboration and developing robust ML frameworks tailored to HEP needs. Looking forward, ML is poised to play a pivotal role in the HL-LHC era and beyond, enabling more precise measurements, discovery of new physics, and efficient use of computational resources.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Lea},
 keywords = {source: Google Scholar},
 publisher = {osti.gov},
 title = {Reducing {AI}},
 url = {https://www.osti.gov/biblio/2474834},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:00:41Z},
 year = {2024}
}

@inproceedings{lee_altcanvas_2024,
 abstract = {The rapid advancement of large language models (LLMs) has significantly enhanced the capabilities of various AI applications. However, the inherent biases in these models, stemming from biased training data, can lead to unfair outcomes, particularly in sensitive domains like healthcare and finance. Existing debiasing methods primarily focus on mitigating biases in model outputs or embeddings, often overlooking the fairness of the underlying knowledge structures that LLMs rely on. In this paper, we address this gap by investigating fairness in LLM-extended commonsense knowledge graphs (CKGs). We first propose a comprehensive evaluation framework to assess both group and individual fairness in these graphs. Our analysis reveals significant disparities in the representation and connectivity of different demographic groups, highlighting the need for targeted interventions. To mitigate these biases, we introduce FairCKG, a novel framework that employs counterfactual reasoning and reinforcement learning to generate fair augmentations for underrepresented groups. Extensive experiments on real-world datasets demonstrate that FairCKG not only improves fairness metrics but also preserves the utility of the CKG for downstream tasks. Our work provides a foundational step towards building equitable knowledge bases for LLMs, with implications for more responsible AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Lee},
 booktitle = {Proceedings of the 26th {International}},
 doi = {10.1145/3663548.3675600},
 isbn = {979-8-4007-0677-6},
 keywords = {source: ACM},
 note = {event-place: St. John's},
 publisher = {Association for Computing Machinery},
 series = {{ASSETS}},
 title = {{AltCanvas}},
 url = {https://doi.org/10.1145/3663548.3675600},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:31:40Z},
 year = {2024}
}

