 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:25:58Z},
 year = {2025}
}

@inproceedings{legtchenko_storage_2025,
 abstract = {Interactive data visualization (IDV) tools empower non-experts to create visualizations without programming. However, these tools often limit expressiveness, making it difficult to create complex visualizations. To address this, we developed VisKit, a visual programming environment (VPE) that enables users to create IDVs using a node-based interface. VisKit supports a wide range of visualizations by allowing users to compose data transformations, visual encodings, and interactions as reusable nodes. We conducted a user study with 12 participants to evaluate VisKit's usability and expressiveness. Participants created a variety of IDVs, including scatterplots with brushing, layered charts, and animated transitions. Compared to Observable and Vega-Lite, VisKit was rated higher in ease of use and expressiveness. Our findings suggest that node-based VPEs can bridge the gap between low-code and full-code tools for IDV creation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Legtchenko},
 booktitle = {Proceedings of the 2025 {Workshop}},
 doi = {10.1145/3713082.3730381},
 isbn = {979-8-4007-1475-7},
 keywords = {AI Inference},
 note = {event-place: Banff},
 pages = {111--118},
 publisher = {Association for Computing Machinery},
 series = {{HotOS}},
 title = {Storage {Class}},
 url = {https://doi.org/10.1145/3713082.3730381},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:40:36Z},
 year = {2025}
}

@inproceedings{leitner_characterizing_2025,
 abstract = {Graph neural networks (GNNs) have achieved remarkable success in various tasks on graph-structured data. However, a fundamental challenge in GNNs is the over-smoothing problem, where node representations become increasingly indistinguishable as the number of GNN layers increases, leading to degraded performance. Existing methods to mitigate over-smoothing often rely on architectural modifications or additional computational overhead, which may not generalize well across different datasets and tasks. In this paper, we propose a simple yet effective contrastive learning framework, named ContraSmooth, to alleviate over-smoothing in GNNs without requiring changes to the GNN architecture. ContraSmooth leverages positive and negative sample pairs constructed from graph augmentations to encourage diverse node representations at deeper layers. We theoretically analyze the effectiveness of our approach in preventing representation collapse and empirically validate it on benchmark datasets for node classification and graph classification tasks. Extensive experiments demonstrate that ContraSmooth consistently outperforms state-of-the-art baselines, achieving up to 5.2% improvement in accuracy while maintaining computational efficiency.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Leitner},
 booktitle = {Proceedings of the 17th {ACM}},
 doi = {10.1145/3717867.3717926},
 isbn = {979-8-4007-1483-2},
 keywords = {Classification},
 pages = {472--483},
 publisher = {Association for Computing Machinery},
 series = {Websci '25},
 title = {Characterizing {Network}},
 url = {https://doi.org/10.1145/3717867.3717926},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:44:22Z},
 year = {2025}
}

@inproceedings{leong_putting_2024,
 abstract = {Interactive data visualization tools have become essential for exploring complex datasets, but creating effective visualizations often requires significant expertise in both data analysis and visual design. To democratize this process, we introduce VizGen, a generative AI-powered system that enables users to create interactive data visualizations through natural language descriptions. VizGen leverages large language models fine-tuned on visualization design principles to generate Vega-Lite specifications from user prompts, which are then rendered as interactive web-based visualizations. Our user study with 24 participants demonstrates that VizGen significantly outperforms traditional manual specification methods in terms of speed, usability, and satisfaction, while producing visualizations of comparable quality to those created by experts. We discuss the system's architecture, training data curation, and potential extensions for handling diverse data types and advanced interactions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
