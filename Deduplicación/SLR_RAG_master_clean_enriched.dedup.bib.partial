}

@book{yan_corrective_2024,
 abstract = {We investigate a phenomenon we call "grokking", in which a model trained on a small algorithmic dataset suddenly generalizes after a long period of overtraining. We find that grokking occurs reliably across a variety of tasks and architectures, and that it is accompanied by a sharp increase in the model's test accuracy. We argue that grokking provides a new lens through which to view the generalization of neural networks, and that it suggests new directions for understanding and improving the generalization of these models.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
