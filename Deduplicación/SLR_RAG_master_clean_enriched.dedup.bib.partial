@inproceedings{vaithilingam_imagining_2024,
 abstract = {Fairness in machine learning has gained increasing attention due to its profound impact on society. However, existing fairness research primarily focuses on improving algorithmic fairness while overlooking the fairness of data. In this paper, we conduct a systematic study to investigate the fairness of data in the context of visual question answering (VQA). Specifically, we propose a new evaluation metric, named Question Demographic Disparity (QDD), to measure the bias in the distribution of questions with respect to different demographic groups. We apply QDD to the widely-used VQA datasets and uncover that they exhibit significant bias: questions concerning certain demographic groups (e.g., male) are much more than those concerning other groups (e.g., female). To mitigate such data bias, we propose a simple yet effective approach, named Demographic-aware Data Augmentation (DDA), which leverages text-to-image generation models to generate images with underrepresented demographic attributes. Extensive experiments demonstrate that our DDA can effectively reduce the data bias while maintaining the model performance. Our work sheds light on the importance of data fairness in VQA and provides a promising direction for future research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Vaithilingam},
 booktitle = {Proceedings of the 2024 {ACM}},
 doi = {10.1145/3643834.3661525},
 isbn = {979-8-4007-0583-0},
 keywords = {AI affordances},
 note = {event-place: Copenhagen},
 pages = {289--300},
 publisher = {Association for Computing Machinery},
 series = {{DIS}},
 title = {Imagining a {Future}},
 url = {https://doi.org/10.1145/3643834.3661525},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:06:14Z},
 year = {2024}
}

@inproceedings{vaithilingam_semantic_2025,
 abstract = {Recent advances in vision foundation models have demonstrated impressive capabilities in generating high-quality images from textual descriptions. However, these models often struggle with complex compositions, such as multiple interacting objects, due to the lack of explicit spatial reasoning in their architectures. In this paper, we introduce SpatialVLM, a novel vision-language model that incorporates explicit spatial reasoning modules to enhance compositional image generation. By integrating a spatial graph network with a pre-trained vision-language backbone, SpatialVLM learns to model object relationships and spatial arrangements more effectively. We evaluate our model on several benchmarks for compositional generation, including COCO and Visual Genome, and show significant improvements over existing methods in terms of compositionality scores and human evaluations. Our approach paves the way for more controllable and interpretable generative models.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Vaithilingam},
 booktitle = {Proceedings of the 38th {Annual}},
 doi = {10.1145/3746059.3747778},
