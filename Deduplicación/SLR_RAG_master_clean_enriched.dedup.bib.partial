 title = {Fine-{Tuning}},
 url = {https://doi.org/10.1109/icdmw65004.2024.00026},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:18:11Z},
 year = {2024}
}

@article{anand_sciphyrag_2023,
 abstract = {We introduce new batching techniques for vector commitments and accumulators. For vector commitments, our technique allows proving a claim about a committed vector in constant time, independent of the vector’s length. For accumulators, our technique allows batching membership proofs for multiple elements into a single proof of constant size. Both constructions are based on standard assumptions and achieve full security. Our accumulator construction is based on RSA and can be used to build stateless blockchains. We also show how to apply our batching techniques to build an efficient IOP for batch proving Reed-Solomon openings, which is a key subroutine in many cryptographic protocols. Our constructions are practical and we implement them to show that they scale well.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 7},
 author = {Anand},
 doi = {10.1007/978-3-031-49601-1_4},
 journal = {Lecture Notes in Computer Science},
 keywords = {source: Scopus},
