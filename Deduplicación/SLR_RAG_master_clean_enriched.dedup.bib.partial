 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:52:48Z},
 year = {2024}
}

@inproceedings{sharma_integrating_2025,
 abstract = {This paper proposes a novel framework for enhancing cybersecurity in IoT ecosystems using machine learning techniques. The approach integrates anomaly detection with blockchain for secure data transmission. Experimental results demonstrate a 25% improvement in detection accuracy compared to traditional methods. The framework is evaluated on real-world datasets, showing robustness against common attacks such as DDoS and man-in-the-middle. Future work includes scalability testing in large-scale deployments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
