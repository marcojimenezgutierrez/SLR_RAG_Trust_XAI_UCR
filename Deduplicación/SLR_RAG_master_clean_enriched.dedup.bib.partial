 keywords = {ai for science},
 note = {event-place: Sydney NSW},
 pages = {1645--1648},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {Using {Large}},
 url = {https://doi.org/10.1145/3701716.3717752},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:13:36Z},
 year = {2025}
}

@inproceedings{urban_demonstrating_2024,
 abstract = {Social media platforms have become a primary source of news for many users, but the spread of misinformation poses significant challenges. Detecting misinformation at scale requires reliable signals, yet most approaches rely on content-based features that are susceptible to manipulation. In this work, we propose a novel approach to misinformation detection that leverages social context signals derived from user interactions and network structures. Specifically, we model the propagation patterns of news articles as diffusion processes on social graphs and extract features such as cascade shapes, temporal dynamics, and community engagement metrics. Our method uses a graph neural network (GNN) architecture to learn representations of these propagation patterns, which are then fed into a classifier for misinformation prediction. We evaluate our approach on real-world datasets from Twitter and Facebook, demonstrating significant improvements over state-of-the-art baselines in terms of accuracy, F1-score, and robustness to adversarial attacks. Our findings highlight the potential of social context as a complementary signal to content analysis for building more reliable misinformation detection systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Urban},
 booktitle = {Companion of the 2024 {International}},
 doi = {10.1145/3626246.3654732},
 isbn = {979-8-4007-0422-2},
 keywords = {large language models},
 note = {event-place: Santiago AA},
 pages = {472--475},
 publisher = {Association for Computing Machinery},
 series = {{SIGMOD}},
 title = {Demonstrating {CAESURA}},
 url = {https://doi.org/10.1145/3626246.3654732},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:10:56Z},
 year = {2024}
}

@article{vach_evaluating_2025,
 abstract = {Abstract Purpose To investigate the feasibility of Retrieval-augmented Generation (RAG)-enhanced Large Language Models (LLMs) in answering questions about two German neurovascular guidelines. Methods Four LLMs (GPT-4o-mini, Llama 3.1 405B Instruct Turbo, Mixtral 8 × 22B Instruct, and Claude 3.5 Sonnet) with RAG as well as GPT-4o-mini without RAG were evaluated for generating answers about two German neurovascular guidelines (“S3 Guideline for Diagnosis, Treatment, and Follow-up of Extracranial Carotid Stenosis” and “S2e Guideline for Acute Therapy of Ischemic Stroke”). The answers were classified as “correct”, “inaccurate”, or “incorrect” by two neurovascular experts in consensus. Additionally, retrieval performance of five retrieval strategies was analyzed on a synthetic dataset of 384 questions. Results Claude Sonnet 3.5 achieved the highest answer correctness (70.6% correct, 10.6% wrong), followed by Llama 3.1 (64.7%, 15.3% wrong), GPT-4o-mini with RAG (57.6%, 15.3% wrong), and Mixtral (56.6%, 17.6% wrong). GPT-4o-mini without RAG performed significantly worse (20.0%, 32.9% wrong). Retrieval errors were the primary cause of incorrect answers (80%). For retrieval, BM25 achieved the highest accuracy (82.0%), outperforming vector-based methods like “BAAI/bge-m3” (78.4%). Conclusion RAG significantly improves LLM accuracy for medical guideline question answering compared to the inherent knowledge of pretrained LLMs alone while still showing significant error rates. Improved accuracy and confidence metrics are needed for safer implementation in clinical routine. Additionally, our results demonstrate the strong performance of general LLMs in medical question answering for non-English languages, such as German, even without specific training.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Hybrid Gold Open Access},
 author = {Vach},
 doi = {10.1007/s00062-025-01562-z},
 journal = {Clinical Neuroradiology},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Evaluating {Retrieval}},
 url = {https://doi.org/10.1007/s00062-025-01562-z},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:50:46Z},
 year = {2025}
}

@article{vaidyanathan_survival_2025,
 abstract = {Mortality estimation remains a key issue in cancers affecting the Brain, Central Nervous System (CNS), and Bone, among others. The recent integration of LLM-based reasoning into tools that aid cancer prognosis has been particularly encouraging. This prompts us to examine further their stated efficacy and devise workarounds to reduce hallucinations using retrieval augmented generation. We study the clinical, pathological and demographic logs of patients recorded in the National Institutes of Health (NIH) Surveillance, Epidemiology, and End Results (SEER) database and develop an integrated methodology that is user-friendly and responds to n-shot queries with or without context. We first build a set of custom SEER embeddings using DistilBERT, which we use to test tree-based models in answering 'yes/no' type 5-year survivability questions given patient profiles. We extend the limited binary response capability of the prior models by using TabLLM, HyDE-RAG, and Step-Back RAG on the BCNS cancer data and extend them to Bone Cancer data from SEER using GraphRAG, as the attributes are similar. The conversation-friendly models are able to take different context lengths and types into account and provide reasoning about their responses. We successfully show that the extensive patient records in the SEER database can be utilized to develop a powerful conversational agent that is not only able to classify mortality outcomes but also reason about the response by leveraging latent inter-relationships among the unique clinical variables.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Vaidyanathan},
