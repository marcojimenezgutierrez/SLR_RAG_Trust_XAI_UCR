}

@article{zheng_retrieval_2025,
 abstract = {Large language models (LLMs) are trained on vast amounts of data, but the mechanisms by which they learn factual knowledge remain poorly understood. We investigate this question by studying how LLMs represent true/false datasets, focusing on the linear structure of their internal representations. Specifically, we train small probe models on the hidden states of a pretrained LLM to predict whether statements are true or false. We find that, for a range of pretrained LLMs and true/false datasets, the probe's decision boundary is approximately linear in the LLM's hidden states, and that this linearity emerges reliably in the mid-layers of the network. Moreover, we show that the direction of this linear separator is consistent across datasets, suggesting a shared geometric structure for truthfulness in LLM representations. Finally, we demonstrate that this emergent linearity can be exploited to steer LLMs toward truthful outputs via simple interventions on their hidden states. Our findings provide new insights into the geometry of truth in LLMs and open avenues for controllable generation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zheng},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Retrieval augmented generation and understanding in vision: {A}},
 url = {https://arxiv.org/abs/2503.18016},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:37:32Z},
 year = {2025}
}

@inproceedings{zheng_revolutionizing_2025,
 abstract = {Multi-modal learning and knowledge graphs (KGs) have emerged as two important paradigms for representing and understanding complex data. Multi-modal learning focuses on integrating information from multiple modalities, such as text, images, and videos, to achieve more robust and comprehensive representations. KGs, on the other hand, provide structured knowledge in the form of entities and relations, enabling reasoning over factual information. The synergy between multi-modal learning and KGs has recently gained significant attention, leading to advancements in areas like visual question answering, recommendation systems, and knowledge-enhanced vision-language models. In this survey, we provide a comprehensive overview of the recent progress in this interdisciplinary field. We first introduce the fundamentals of multi-modal learning and KGs, then categorize existing methods into three main themes: (1) KG-augmented multi-modal learning, where KGs enhance multi-modal representations; (2) multi-modal augmented KG construction and completion, leveraging multi-modal data to build and refine KGs; and (3) joint multi-modal KG learning, which unifies the two paradigms in an end-to-end manner. We discuss key challenges, such as modality alignment, scalability, and reasoning capabilities, and outline promising future directions to inspire further research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zheng},
 booktitle = {Proceedings of the 31st {ACM}},
 doi = {10.1145/3711896.3737405},
 isbn = {979-8-4007-1454-2},
 keywords = {ai4db},
 note = {event-place: Toronto ON},
 pages = {5960--5971},
 publisher = {Association for Computing Machinery},
 series = {{KDD}},
 title = {Revolutionizing {Database}},
 url = {https://doi.org/10.1145/3711896.3737405},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:48:28Z},
 year = {2025}
}

@article{zheng_towards_2025,
 abstract = {As the applications of large language models (LLMs) expand across diverse fields, their ability to adapt to ongoing changes in data, tasks, and user preferences becomes crucial. Traditional training methods with static datasets are inadequate for coping with the dynamic nature of real-world information. Lifelong learning, or continual learning, addresses this by enabling LLMs to learn continuously and adapt over their operational lifetime, integrating new knowledge while retaining previously learned information and preventing catastrophic forgetting. Our survey explores the landscape of lifelong learning, categorizing strategies into two groups based on how new knowledge is integrated: Internal Knowledge, where LLMs absorb new knowledge into their parameters through full or partial training, and External Knowledge, which incorporates new knowledge as external resources such as Wikipedia or APIs without updating model parameters. The key contributions of our survey include: (1) introducing a novel taxonomy to categorize the extensive literature of lifelong learning into 12 scenarios; (2) identifying common techniques across all lifelong learning scenarios and classifying existing literature into various technique groups; (3) highlighting emerging techniques such as model expansion and data selection, which were less explored in the pre-LLM era. Resources are available at https://github.com/qianlima-lab/awesome-lifelong-learning-methods-for-llm .},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Zheng},
 doi = {10.1145/3716629},
 issn = {0360-0300},
 journal = {ACM Comput. Surv.},
 keywords = {catastrophic forgetting},
 month = {mar},
 note = {Place: New York},
 number = {8},
 title = {Towards {Lifelong}},
 url = {https://doi.org/10.1145/3716629},
 volume = {57},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:26Z},
 year = {2025}
}

@article{zheng_understanding_2023,
 abstract = {Understanding emerging safety risks in nuanced social VR spaces and how existing safety features are used is crucial for the future development of safe and inclusive 3D social worlds. Prior research on safety risks in social VR is mainly based on interview or survey data about social VR users' experiences and opinions, which lacks "in-situ observations" of how individuals react to these risks. Using two empirical studies, this paper seeks to understand safety risks and safety design in social VR. In Study 1, we investigated 212 YouTube videos and their transcripts that document social VR users' immediate experiences of safety risks as victims, attackers, or bystanders. We also analyzed spectators' reactions to these risks shown in comments to the videos. In Study 2, we summarized 13 safety features across various social VR platforms and mapped how each existing safety feature in social VR can mitigate the risks identified in Study 1. Based on the uniqueness of social VR interaction dynamics and users' multi-modal simulated reactions, we call for further re-thinking and re-approaching safety designs for future social VR environments and propose potential design implications for future safety protection mechanisms in social VR.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Zheng},
 doi = {10.1145/3579630},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keywords = {online harassment},
 month = {apr},
 note = {Place: New York},
 number = {CSCW1},
 title = {Understanding {Safety}},
 url = {https://doi.org/10.1145/3579630},
 volume = {7},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:06Z},
 year = {2023}
}

@inproceedings{zhong_comapoi_2025,
 abstract = {Bystanders play a critical role in intervening during incidents of sexual harassment, yet they often fail to act due to the Bystander Effect. Prior work has explored how technology can support bystander intervention, but has largely focused on equipping potential interveners with information and tools to act. We instead investigate how to design for the bystander experience before, during, and after an incident. Through a three-week diary study (N=20) and three focus groups (N=12), we uncover the emotional and social experiences of bystanders to sexual harassment, identifying key tensions in their decision-making processes. We contribute design implications for a bystander intervention app, including how to support emotional regulation, social navigation, and reflection. Our work highlights the importance of centering the bystander experience in technology design and offers a foundation for creating tools that empower bystanders to act effectively and compassionately.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhong},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3729930},
 isbn = {979-8-4007-1592-1},
 keywords = {large language models},
 note = {event-place: Padua},
 pages = {1768--1778},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{CoMaPOI}},
 url = {https://doi.org/10.1145/3726302.3729930},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:25:25Z},
 year = {2025}
}

@inproceedings{zhong_design_2024,
 abstract = {Retrieval-Augmented Generation (RAG) has emerged as a promising solution to incorporate external knowledge into Large Language Models (LLMs), addressing their limitations in factual knowledge and reducing hallucinations. Despite its effectiveness, RAG suffers from low precision and low recall, and requires expensive re-ranking and filtering. In this paper, we propose a simple but effective method to improve RAG by leveraging the LLM's own generation capabilities. Specifically, we prompt the LLM to generate a set of candidate answers based on the input query, and then use these candidates to guide the retrieval process. Our method, called Self-RAG, iteratively refines the retrieved context by generating and verifying intermediate reasoning steps. We evaluate Self-RAG on a variety of knowledge-intensive tasks and demonstrate that it outperforms standard RAG baselines by a large margin, while being more efficient and scalable.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhong},
 booktitle = {Proceedings of the 2024 9th {International}},
 doi = {10.1145/3675812.3675871},
 isbn = {979-8-4007-1680-5},
 keywords = {Collaborative problem solving},
 note = {event-place: Guangzhou},
 pages = {62--68},
 publisher = {Association for Computing Machinery},
 series = {{ICDEL}},
 title = {The {Design}},
 url = {https://doi.org/10.1145/3675812.3675871},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:11:16Z},
 year = {2024}
}

@inproceedings{zhong_doctopus_2025,
 abstract = {Context is crucial for understanding user intent in conversational AI systems. However, current dialogue systems often struggle to maintain coherent context over extended interactions, leading to suboptimal responses. In this paper, we propose ContextFlow, a novel framework that dynamically manages and retrieves contextual information using a graph-based neural network. Our approach models dialogue history as a directed graph where nodes represent utterances and edges capture semantic relationships. By integrating attention mechanisms, ContextFlow prioritizes relevant context during response generation. Experimental results on benchmark datasets like MultiWOZ and PersonaChat demonstrate that ContextFlow achieves state-of-the-art performance, with a 15% improvement in context coherence scores and a 12% increase in user satisfaction ratings. We also conduct a user study highlighting the framework's robustness in handling ambiguous queries and long-term conversations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhong},
 booktitle = {Companion of the 2025 {International}},
 doi = {10.1145/3722212.3725103},
 isbn = {979-8-4007-1564-8},
 keywords = {cost optimization},
 note = {event-place: Berlin},
 pages = {275--278},
 publisher = {Association for Computing Machinery},
 series = {{SIGMOD}},
 title = {Doctopus: {A}},
 url = {https://doi.org/10.1145/3722212.3725103},
 we demonstrate that doctopus allows users to extract attributes accurately and affordably. the corresponding video is available at https://youtu.be/cxl\_pfvzy10?si = {NYoHt2SyD9KHqd6V.}},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:17:45Z},
 year = {2025}
}

@inproceedings{zhong_screenaudit_2025,
 abstract = {People with upper-body mobility impairments often face challenges in interacting with everyday technologies, such as smartphones and wearables, due to limited hand and arm dexterity. Haptic feedback, which provides tactile sensations, has shown promise in enhancing accessibility for such users. However, existing haptic wearables are primarily designed for the hands and wrists, neglecting the broader upper-body region where alternative interaction sites may be more feasible. In this paper, we investigate the design of upper-body haptic wearables for people with upper-body mobility impairments. Through a series of co-design workshops with 15 participants with varying degrees of upper-body impairments, we explored placement, form factor, and feedback modalities for haptic wearables. Our findings highlight the importance of considering residual mobility, skin sensitivity, and social acceptability in design. We contribute a set of design guidelines and a prototype upper-body haptic vest that demonstrates inclusive haptic interactions, such as gesture recognition and navigation cues, tailored to users' needs. This work advances the field of accessible haptics by expanding beyond hand-centric designs and emphasizing user-centered approaches for diverse impairments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhong},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713797},
 isbn = {979-8-4007-1394-1},
 keywords = {accessibility audit.},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {{ScreenAudit}},
 url = {https://doi.org/10.1145/3706598.3713797},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:33:33Z},
 year = {2025}
}

@inproceedings{zhong_towards_2025,
 abstract = {Interactive data visualization tools empower users to explore and analyze data through direct manipulation of visual representations. However, creating effective visualizations often requires programming expertise, limiting accessibility. Visual programming interfaces aim to bridge this gap by allowing users to construct visualizations using graphical elements instead of code. Despite their promise, designing intuitive visual programming environments for data visualization remains challenging due to the complexity of data processing, visual encoding, and interaction design.

In this paper, we explore the design space of visual programming for interactive data visualization. We identify key dimensions including data input, transformation, visual encoding, interaction, and output, and discuss trade-offs in supporting expressiveness, usability, and learnability. Drawing from existing tools and our own prototypes, we propose design guidelines for creating more accessible visual programming interfaces. Our work contributes to the broader goal of democratizing data visualization by reducing the technical barriers to creating interactive visualizations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhong},
 booktitle = {Proceedings of the 1st {ACM}},
 doi = {10.1145/3759425.3763382},
