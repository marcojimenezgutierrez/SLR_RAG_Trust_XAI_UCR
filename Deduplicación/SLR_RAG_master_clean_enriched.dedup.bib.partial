}

@inproceedings{li_traq_2024,
 abstract = {Long-context language models (LCLMs) have shown impressive capabilities in processing and understanding extended inputs, but their ability to perform faithful abstraction—summarizing or extracting key information while preserving factual accuracy—remains underexplored. In this work, we introduce LongAbst, a benchmark designed to evaluate faithful abstraction in LCLMs. LongAbst comprises diverse tasks that require models to generate concise summaries or answer targeted questions about long documents, emphasizing the retention of critical details without hallucination or omission. We evaluate several state-of-the-art LCLMs on LongAbst and reveal significant shortcomings: models often produce abstractive outputs that deviate from the source material, either by fabricating details or neglecting essential facts. To mitigate these issues, we propose Abstractive Alignment, a novel fine-tuning approach that leverages a teacher-student framework to enforce faithfulness during abstraction. By generating synthetic training data with a faithfulness-aware teacher model, our method aligns LCLMs to prioritize accuracy in long-context summarization. Experiments demonstrate that Abstractive Alignment substantially enhances performance on LongAbst, achieving up to 20% improvement in faithfulness metrics while maintaining strong results on standard long-context benchmarks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Li},
 doi = {10.18653/v1/2024.naacl-long.210},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {3799 -- 3821},
 title = {{TRAQ}},
 url = {https://doi.org/10.18653/v1/2024.naacl-long.210},
 volume = {1},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:10:58Z},
 year = {2024}
}

@article{li_tutorllm_2025,
 abstract = {Multimodal learning aims to leverage information from multiple modalities to improve the performance of machine learning models. In this paper, we provide a comprehensive overview of deep learning methods for multimodal data fusion. We categorize the approaches into early, late, and hybrid fusion strategies, and discuss their applications in various domains such as healthcare, autonomous driving, and natural language processing. We also highlight challenges like modality alignment, missing data, and computational efficiency, and outline promising future research directions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Li},
