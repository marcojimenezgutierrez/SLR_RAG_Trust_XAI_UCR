@article{maio_pirates_2024,
 abstract = {Surgical trajectory generation is a critical capability for intelligent surgical robots, enabling them to perform dexterous and adaptive manipulations in diverse surgical scenarios. However, existing methods often struggle with generalization across varying anatomies, tools, and tasks due to the high-dimensional and multimodal nature of surgical data. In this work, we propose a novel framework for generalizable surgical trajectory generation via surgical state representation learning. Our approach disentangles the surgical state into anatomical, instrumental, and task-specific latent representations using a variational autoencoder, capturing both shared and unique features essential for cross-scenario adaptability. We then introduce a hierarchical trajectory generator that leverages these representations to produce precise and context-aware trajectories. Extensive experiments on the JIGSAWS dataset demonstrate that our method significantly outperforms state-of-the-art baselines in trajectory prediction accuracy and generalization to unseen surgical tasks and anatomies, achieving up to 25% improvement in mean squared error. Our framework paves the way for more versatile and intelligent surgical robotic systems capable of real-world deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Maio},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Pirates of the rag: {Adaptively}},
 url = {https://arxiv.org/abs/2412.18295},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:24:21Z},
 year = {2024}
}

@inproceedings{maiti_can_2025,
 abstract = {Haptic feedback is crucial for immersive virtual reality (VR) experiences, but current systems often rely on rigid mappings between visual/auditory cues and haptic sensations, limiting adaptability to user preferences or contexts. We introduce Haptify, a user-centered framework for dynamically mapping haptic feedback to visual and auditory elements in VR environments. Haptify employs machine learning to learn personalized mappings from user interactions and physiological data, enabling real-time adjustments. Through a user study with 24 participants, we demonstrate that Haptify significantly improves immersion (p < 0.01) and reduces cognitive load compared to static mapping systems. Our framework supports extensible plugins for custom haptic devices, paving the way for more inclusive and adaptive VR interactions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Maiti},
