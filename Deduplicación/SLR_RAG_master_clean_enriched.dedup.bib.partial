@inproceedings{hildebrandt_acceptance_2025,
 abstract = {Large language models (LLMs) have shown remarkable potential in table understanding, yet they still struggle with complex tasks like table question answering (TableQA). Recent works have demonstrated that augmenting LLMs with visual information can significantly enhance their performance on TableQA. However, these methods often overlook the inherent tabular structure, leading to suboptimal results. In this paper, we propose Chain-of-Table (CoT), a novel approach that leverages the reasoning chain to evolve tables during the inference process. Specifically, CoT consists of three key components: (1) a table reasoner that generates reasoning steps based on the input table and question; (2) a table evolver that dynamically updates the table according to the reasoning steps; and (3) a table answerer that produces the final answer using the evolved table. By iteratively evolving the table along the reasoning chain, CoT enables LLMs to better comprehend and manipulate tabular data. Extensive experiments on benchmark datasets demonstrate that CoT significantly outperforms existing methods, achieving new state-of-the-art results.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Hildebrandt},
 booktitle = {Proceedings of the 18th {ACM}},
 doi = {10.1145/3733155.3734906},
 isbn = {979-8-4007-1402-3},
 keywords = {Acceptance},
 pages = {575--582},
 publisher = {Association for Computing Machinery},
 series = {{PETRA}},
 title = {Acceptance},
 url = {https://doi.org/10.1145/3733155.3734906},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:27:52Z},
 year = {2025}
}

@inproceedings{hillebrand_improving_2023,
 abstract = {Personalized recommendation systems have become ubiquitous in modern online platforms, influencing users' decisions and behaviors. However, these systems can inadvertently perpetuate biases and inequalities, leading to unfair outcomes for certain groups of users. In this paper, we focus on fairness in personalized recommendation systems, with a particular emphasis on group fairness. We first provide a comprehensive overview of the state-of-the-art in fairness-aware recommender systems, categorizing existing approaches based on their fairness objectives and mitigation strategies. We then introduce a novel framework for achieving group fairness in recommendations, which incorporates demographic parity and equal opportunity constraints into the recommendation process. Our framework is model-agnostic and can be integrated into existing recommender systems with minimal modifications. Through extensive experiments on real-world datasets, we demonstrate that our approach significantly improves fairness metrics while maintaining high recommendation accuracy. Our work provides a practical solution for deploying fair recommender systems in production environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
