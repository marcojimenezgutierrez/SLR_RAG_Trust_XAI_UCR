@inproceedings{mulayim_large_2024,
 abstract = {Recommendation systems have been widely deployed in various online platforms, such as e-commerce, social media, and content streaming services, to provide personalized suggestions to users. However, recent studies have shown that these systems can inadvertently amplify biases present in the training data, leading to unfair recommendations for certain demographic groups. In this paper, we propose a novel framework for debiasing recommendation systems by integrating counterfactual fairness into the ranking process. Our approach leverages generative models to simulate counterfactual scenarios and adjust recommendations accordingly, ensuring equitable treatment across protected attributes like gender and age. Through extensive experiments on benchmark datasets, we demonstrate that our method achieves significant improvements in fairness metrics while maintaining high recommendation accuracy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
