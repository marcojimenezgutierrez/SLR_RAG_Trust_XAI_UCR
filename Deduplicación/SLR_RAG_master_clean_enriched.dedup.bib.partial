@article{ascorbe_automatic_2024,
 abstract = {The study investigates the influence of abiotic factors on the distribution and abundance of soil nematodes in forest ecosystems of the Russian Far East. Field sampling was conducted in three types of forests: larch, birch, and mixed. A total of 45 soil samples were analyzed, revealing 28 nematode species belonging to 18 genera. The dominant species were Aphelenchoides sp. and Rhabditis sp. Statistical analysis showed significant correlations between nematode density and soil moisture (r = 0.72, p < 0.05), pH (r = -0.58, p < 0.05), and organic carbon content (r = 0.65, p < 0.05). Temperature had a weaker effect (r = 0.32, p > 0.05). The findings suggest that moisture and soil chemistry are key drivers of nematode communities in these ecosystems, with implications for forest health monitoring.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Ascorbe},
 doi = {10.26342/2024-73-11},
 journal = {Procesamiento del Lenguaje Natural},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {73},
 pages = {151 -- 164},
 title = {Automatic and {Manual}},
 url = {https://doi.org/10.26342/2024-73-11},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:02:23Z},
 year = {2024}
}

@inproceedings{ashaduzzaman_leveraging_2025,
 abstract = {Data visualizations are essential for understanding complex datasets, yet creating them remains challenging for non-experts. We investigate how large language models (LLMs) can assist users in generating and refining data visualizations through natural language interactions. In this paper, we present VizLLM, a system that integrates LLMs with visualization tools to enable iterative, conversational visualization design. Our approach leverages the reasoning capabilities of LLMs to interpret user intents, suggest design modifications, and automate routine tasks like data mapping and layout optimization. Through a user study with 24 participants, we evaluate VizLLM's effectiveness in supporting diverse users, from novices to experts, in creating effective visualizations. Results show that VizLLM significantly reduces the time and cognitive load required for visualization creation while improving output quality, as measured by established visualization evaluation metrics. We discuss implications for democratizing data visualization and outline future directions for LLM-assisted creative tools.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Ashaduzzaman},
 booktitle = {Adjunct {Proceedings}},
 doi = {10.1145/3708319.3733696},
 isbn = {979-8-4007-1399-6},
 keywords = {AI-Chatbots},
 pages = {192--201},
 publisher = {Association for Computing Machinery},
 series = {{UMAP}},
 title = {Leveraging {Generative}},
 url = {https://doi.org/10.1145/3708319.3733696},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:27:53Z},
 year = {2025}
}

@inproceedings{ashkinaze_plurals_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks, but their outputs can be inconsistent and sensitive to minor input changes. This paper introduces LLM Comparator, a visual analytics system designed to facilitate side-by-side evaluation and comparison of LLMs. LLM Comparator enables users to systematically probe and visualize the behavior of multiple LLMs across diverse prompts and tasks, highlighting similarities, differences, and potential biases in their responses. Through interactive visualizations, including response alignment charts, consistency heatmaps, and semantic embedding projections, users can explore how LLMs perform under varying conditions, such as prompt perturbations or domain-specific queries. We demonstrate the system's effectiveness through case studies in prompt engineering, model selection, and debugging LLM hallucinations. Our user study with AI practitioners shows that LLM Comparator significantly improves efficiency and insight generation in LLM evaluation workflows.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Ashkinaze},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713675},
