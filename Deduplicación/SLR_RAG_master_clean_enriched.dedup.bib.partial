 year = {2024}
}

@inproceedings{frey_pots_2025,
 abstract = {Deep learning models have achieved remarkable success in various computer vision tasks. However, these models often exhibit biases inherited from training data, leading to unfair outcomes for certain demographic groups. In this paper, we propose a comprehensive framework for bias mitigation in visual recognition tasks. Our approach integrates fairness-aware data augmentation, adversarial debiasing, and post-hoc calibration techniques to reduce demographic disparities while preserving model utility. We evaluate our method on multiple benchmark datasets, including CelebA and UTKFace, demonstrating significant improvements in fairness metrics such as demographic parity and equalized odds, with minimal impact on overall accuracy. Our findings highlight the importance of multi-stage debiasing strategies for achieving equitable AI systems in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Frey},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3701716.3715194},
