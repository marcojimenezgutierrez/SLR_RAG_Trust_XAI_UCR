 pages = {1251--1261},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{ReARTeR}},
 url = {https://doi.org/10.1145/3726302.3730102},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:04:33Z},
 year = {2025}
}

@article{sun_redeep_2024,
 abstract = {The rise of large language models (LLMs) has transformed natural language processing, but their application to robotics remains underexplored. In this paper, we investigate how LLMs can be leveraged for high-level robotic planning and control. Specifically, we propose a framework that uses an LLM to generate executable code from natural language task descriptions, which is then interpreted by a low-level controller to execute actions on a physical robot. Our approach involves prompting the LLM with detailed environmental descriptions and task goals to produce Python code that interfaces with the robot's API. We evaluate this method on a variety of manipulation tasks using a Franka Emika Panda arm, including pick-and-place, stacking, and drawer opening. Results show that the LLM-generated plans achieve success rates comparable to human-written code, with the added benefit of rapid adaptation to new tasks via simple prompt modifications. We also analyze failure cases, such as hallucinations in code generation, and discuss mitigation strategies like fine-tuning and verification steps. This work demonstrates the potential of LLMs as flexible, language-based interfaces for robotic programming, reducing the need for domain-specific expertise.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Sun},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Redeep: {Detecting}},
 url = {https://arxiv.org/abs/2410.11414},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:56:33Z},
 year = {2024}
}

@inproceedings{sun_redeep_2025,
 abstract = {The rapid development of information technology has led to the generation of massive amounts of data. Traditional data analysis methods are difficult to meet the needs of big data analysis. In this paper, a big data analysis method based on machine learning is proposed. First, the characteristics of big data are analyzed, and the challenges faced by traditional data analysis methods in big data environment are pointed out. Then, the basic principles and algorithms of machine learning are introduced, and the application of machine learning in big data analysis is discussed. Finally, a big data analysis platform based on machine learning is built, and the effectiveness of the proposed method is verified through experiments. The experimental results show that the proposed method can effectively improve the efficiency and accuracy of big data analysis.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 2},
 author = {Sun},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
