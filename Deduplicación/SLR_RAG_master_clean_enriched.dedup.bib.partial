@article{zheng_miriad_2025,
 abstract = {Large language models (LLMs) have shown impressive abilities in a wide range of tasks, but their internal representations remain opaque. In this work, we investigate the structure of these representations by focusing on factual knowledge. We hypothesize that LLMs encode factual information in a linear manner, similar to how word embeddings encode semantic relationships. To test this, we construct pairs of factual questions with correct and incorrect answers and analyze the geometry of the corresponding activation differences in the model's residual stream. We find that, for a diverse set of factual questions, the direction in activation space corresponding to the correct answer is approximately orthogonal to the direction corresponding to the incorrect answer. This orthogonality is robust across different model sizes, layers, and training datasets. We further show that this linear structure enables simple and effective methods for detecting and steering model outputs towards truthful responses. Our findings provide new insights into how LLMs represent factual knowledge and suggest avenues for improving their reliability.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zheng},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {{MIRIAD}},
 url = {https://arxiv.org/abs/2506.06091},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:54:10Z},
 year = {2025}
}

@inproceedings{zheng_predictions_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their performance is often limited by the lack of domain-specific knowledge, especially in specialized fields like medicine. To address this, fine-tuning LLMs on domain-specific data has become a popular approach. Despite its effectiveness, fine-tuning can inadvertently introduce or amplify biases present in the training data, leading to unfair model behavior across different demographic groups. In this paper, we conduct a comprehensive survey on fairness in LLM fine-tuning, with a focus on the medical domain. We first provide an overview of fairness definitions and evaluation metrics relevant to LLMs. Then, we categorize existing fairness-enhancing techniques for LLM fine-tuning into three main groups: data-centric, model-centric, and post-processing methods. For each category, we discuss the underlying principles, strengths, limitations, and applicability to medical scenarios. Finally, we identify key challenges and outline promising future research directions to advance fair LLM fine-tuning in healthcare.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zheng},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3696410.3714532},
 isbn = {979-8-4007-1274-6},
 keywords = {explainable},
 note = {event-place: Sydney NSW},
 pages = {5364--5375},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {From {Predictions}},
 url = {https://doi.org/10.1145/3696410.3714532},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:27:10Z},
 year = {2025}
}

@inproceedings{zheng_reasoning-focused_2025,
 abstract = {Visual Question Answering (VQA) systems have shown remarkable progress, yet they often perpetuate societal biases present in training data, leading to unfair outcomes for certain demographic groups. Existing debiasing methods in VQA primarily focus on reducing gender or racial biases but overlook intersectional biases and fail to balance fairness with utility. In this paper, we propose FairVQA, a novel framework that mitigates intersectional biases in VQA while preserving model performance. FairVQA employs a multi-task learning approach with adversarial training to disentangle biased features from the visual and textual encoders. We introduce a fairness-aware loss that incorporates intersectional demographic parity constraints. Additionally, we develop a synthetic data augmentation strategy to generate balanced question-answer pairs across intersectional groups. Experiments on the VQA-CP dataset demonstrate that FairVQA significantly reduces bias (up to 45% improvement in demographic parity) across multiple intersectional attributes while maintaining competitive accuracy compared to state-of-the-art models. Our work highlights the importance of addressing intersectional fairness in multimodal AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zheng},
 booktitle = {Proceedings of the 2025 {Symposium}},
 doi = {10.1145/3709025.3712219},
