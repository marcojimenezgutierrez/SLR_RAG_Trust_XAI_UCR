@inproceedings{venkatakrishnan_semantic_2024,
 abstract = {Visual programming languages (VPLs) enable users to create data processing pipelines by composing visual elements. However, existing VPLs often require users to learn complex visual syntaxes and lack support for interactive data exploration. We conducted a design study with 12 data analysts to explore the design space of VPLs for interactive data processing. Based on the findings, we propose a set of design guidelines and implement a prototype VPL called VisFlow. Our evaluation with 16 data analysts shows that VisFlow significantly improves the efficiency and effectiveness of data processing tasks compared to a baseline VPL.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
