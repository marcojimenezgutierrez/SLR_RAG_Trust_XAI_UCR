@inproceedings{sanjani_performance_2025,
 abstract = {This paper presents a novel approach for detecting and classifying plant leaf diseases using deep learning techniques. The proposed method leverages convolutional neural networks (CNNs) to analyze images of plant leaves, achieving high accuracy in identifying common diseases such as rust, blight, and mosaic. The dataset comprises over 50,000 annotated images from various crop types, including tomato, potato, and rice. Preprocessing steps include image augmentation and normalization to enhance model robustness. Experimental results demonstrate an accuracy of 98.5% on the test set, outperforming traditional machine learning methods. The system is designed for real-time deployment on edge devices, facilitating early disease detection in agricultural settings to minimize crop losses.},
