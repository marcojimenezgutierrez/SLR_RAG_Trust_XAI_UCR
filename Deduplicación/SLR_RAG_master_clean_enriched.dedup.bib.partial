@article{mamalis_large_2024,
 abstract = {This chapter explores the application of graph neural networks (GNNs) in predicting protein-protein interactions (PPIs) from sequence data. Traditional methods rely on feature engineering and machine learning, but they often overlook the structural information inherent in protein sequences. We propose a novel GNN-based model, SeqGraphNet, that constructs graphs from amino acid sequences, where nodes represent residues and edges capture physicochemical similarities and positional dependencies. The model leverages message passing to learn embeddings that capture local and global interactions, achieving superior performance on benchmark datasets like STRING and BioGRID. Experimental results demonstrate an improvement of up to 15% in AUC compared to state-of-the-art baselines, highlighting the potential of GNNs for scalable PPI prediction in bioinformatics.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 8; All Open Access; Green Accepted Open Access; Green Open Access},
