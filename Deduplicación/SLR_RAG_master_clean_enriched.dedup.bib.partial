@inproceedings{okutan_leveraging_2024,
 abstract = {The rapid development of artificial intelligence (AI) technology has brought new opportunities and challenges to the field of education. As an important branch of AI, educational robots have been widely used in teaching activities, which can effectively improve students' learning interest and motivation. However, the current educational robots still have some problems, such as single function, poor interactivity and high cost. In order to solve these problems, this paper designs and implements an intelligent educational robot based on AI technology. The robot integrates voice recognition, natural language processing, machine learning and other AI technologies, which can realize human-computer interaction, personalized learning guidance and intelligent evaluation and other functions. Through the experimental verification, the intelligent educational robot designed in this paper can effectively improve students' learning effect and teaching efficiency, and has a good application prospect.},
