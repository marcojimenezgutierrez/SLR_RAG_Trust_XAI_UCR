@inproceedings{wu_orchid_2025,
 abstract = {We present StoryMaker, a novel system that enables users to create interactive data narratives by combining natural language prompts with visual programming. Unlike traditional tools that require manual coding or rigid templates, StoryMaker allows users to describe their narrative goals in plain English, which are then translated into executable visualizations and interactions via a low-code visual interface. Our user study with 24 participants demonstrates that StoryMaker significantly reduces the time and cognitive load required to author engaging data stories compared to baseline tools, while maintaining high expressiveness. We discuss design implications for hybrid natural language and visual programming paradigms in data storytelling.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wu},
 booktitle = {Proceedings of the 2025 {Conference}},
 doi = {10.1145/3698061.3726906},
