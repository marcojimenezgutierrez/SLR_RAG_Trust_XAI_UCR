@article{devine_aloftrag_2025,
 abstract = {The rapid advancement of large language models (LLMs) has led to their increased adoption in various tasks, including news summarization. However, the performance of LLMs in news summarization remains underexplored. In this paper, we conduct a comprehensive benchmark of LLMs for news summarization, evaluating their performance on a diverse set of news articles from various domains. We assess the models on key metrics such as factual consistency, coherence, and coverage. Our findings reveal that while LLMs demonstrate promising capabilities, they still face challenges in generating accurate and comprehensive summaries, particularly for complex news articles. We also investigate the impact of prompt engineering and fine-tuning on model performance, providing insights into effective strategies for enhancing LLM-based news summarization. This work contributes to the understanding of LLMs' potential and limitations in news summarization and offers practical recommendations for their deployment in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
