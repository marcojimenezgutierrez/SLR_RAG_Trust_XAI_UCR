@inproceedings{kanakaris_network-informed_2025,
 abstract = {Large Language Models (LLMs) have shown remarkable capabilities in generating human-like text, but their application in interactive systems remains underexplored. This paper introduces a novel framework for integrating LLMs into conversational agents that can engage in multi-turn dialogues with users. We propose a hybrid approach combining prompt engineering and fine-tuning to enhance the model's contextual understanding and response coherence. Through extensive user studies and evaluations on benchmark datasets, we demonstrate that our framework significantly improves user satisfaction and task completion rates compared to traditional rule-based agents. Our findings highlight the potential of LLMs to revolutionize human-computer interaction by enabling more natural and adaptive conversations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
