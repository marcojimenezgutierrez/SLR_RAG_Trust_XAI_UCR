@inproceedings{lou_cognitive_2025,
 abstract = {This paper proposes a novel framework for enhancing human-robot collaboration in dynamic environments through adaptive intention recognition. By integrating multimodal sensor data, including eye-tracking, gestures, and physiological signals, the system achieves real-time prediction of human intentions with an accuracy of over 92%. Experimental results from simulated manufacturing tasks demonstrate a 35% reduction in task completion time and improved safety metrics compared to traditional rule-based methods. The framework's scalability to real-world industrial settings is discussed, along with challenges in data privacy and model generalization.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
