 series = {{DEEM}},
 title = {Towards {Interactively}},
 url = {https://doi.org/10.1145/3650203.3663327},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:39:44Z},
 year = {2024}
}

@book{greengard_shining_2025,
 abstract = {Spatiotemporal data analysis is crucial in various domains, such as urban planning, climate science, and epidemiology. However, the sheer volume and complexity of such data pose significant challenges for effective visualization and analysis. This survey provides a comprehensive overview of visual analytics techniques for spatiotemporal data, categorizing them based on data types (e.g., point, trajectory, raster) and analysis tasks (e.g., pattern detection, anomaly identification, predictive modeling). We discuss key challenges, including scalability, interactivity, and integration with machine learning, and highlight emerging trends like immersive visualization and AI-assisted analysis. By synthesizing over 150 recent works, this survey aims to guide researchers and practitioners in selecting and developing appropriate visual analytics solutions for spatiotemporal data.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Greengard},
