@article{xu_automated_2024,
 abstract = {Wearable haptic devices have great potential to enhance immersion in virtual and augmented reality (VR/AR) experiences. However, most existing devices are designed for users with typical upper limb anatomy, limiting accessibility for people with upper limb differences (PULD). To address this, we conducted a multi-phase study involving 12 participants with PULD to explore inclusive design considerations for wearable haptics. Through interviews, co-design workshops, and prototype evaluations, we identified key challenges and opportunities, including the need for modular, customizable designs that accommodate diverse body types and movement capabilities. Our findings reveal preferences for non-invasive, lightweight devices that integrate with existing assistive technologies. We contribute design guidelines and a prototype framework to support more inclusive haptic experiences in VR/AR, emphasizing user-centered approaches to accessibility.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
