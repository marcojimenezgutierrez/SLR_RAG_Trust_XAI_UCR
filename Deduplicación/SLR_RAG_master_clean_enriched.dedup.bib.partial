 x_enrich_ts = {2025-11-02T07:42:44Z},
 year = {2021}
}

@inproceedings{coppolillo_engagement-driven_2025,
 abstract = {Haptic wearables have the potential to enhance accessibility in virtual reality (VR) by providing tactile feedback. However, current designs often overlook the diverse needs of users with upper-body mobility impairments, limiting their inclusivity. In this paper, we explore the design space of wearable haptics for VR, focusing on users with upper-body mobility impairments. Through a series of workshops and interviews with 12 participants, we identify key design considerations, including modularity, ease of donning/doffing, and customization. We present prototypes that address these needs and evaluate their usability. Our findings contribute to the development of more inclusive haptic interfaces for VR, ensuring that people with disabilities can fully participate in immersive experiences.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
