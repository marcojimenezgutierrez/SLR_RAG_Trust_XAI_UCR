 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:05:58Z},
 year = {2024}
}

@article{chang_main-rag_2024,
 abstract = {Robot policies that can generalize across diverse tasks and environments remain a longstanding challenge in robotics. Recent advances in representation learning have shown promise in enabling such generalization by learning structured world models from data. However, the key factors that make a representation effective for control---such as its ability to capture task-relevant dynamics, disentangle factors of variation, and support efficient planning---are not well understood. In this work, we conduct a systematic study of representation learning for robot control. We evaluate a range of methods, including autoencoders, contrastive learning, and world models, on a suite of simulated manipulation tasks. Our findings reveal that representations which explicitly model temporal dependencies and action effects significantly outperform static image-based representations. Furthermore, we show that incorporating auxiliary tasks, such as predicting future states or rewards, enhances generalization to unseen objects and scenes. Finally, we demonstrate that these insights transfer to real-world robotic experiments, where our approach enables zero-shot adaptation to novel tasks. Our results provide actionable guidelines for designing representations that unlock generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Chang},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Main-rag: {Multi}},
 url = {https://arxiv.org/abs/2501.00332},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:52:40Z},
 year = {2024}
}

@inproceedings{chatterjee_towards_2025,
 abstract = {Video Retrieval-Augmented Generation (RAG) Workflows augment user query contexts with stored video contexts to guide a Large Language Model (LLM) in providing more context-relevant answers. The challenge is to design a workflow where the video contexts can be generated with practical latency values. It is also important to ensure that the resources available to run the workflows are not under-utilized whenever possible. In this paper},
