@inproceedings{strubberg_ux_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their application to interactive storytelling remains underexplored. In this paper, we investigate how LLMs can be used to create dynamic, branching narratives in response to user inputs during storytelling sessions. We developed StoryWeaver, an LLM-powered system that generates story continuations based on user choices and feedback. Through a user study with 24 participants, we found that StoryWeaver significantly enhances user engagement and narrative satisfaction compared to traditional static stories. However, challenges such as narrative coherence and ethical concerns around content generation were identified. Our findings provide insights into designing LLM-based interactive storytelling tools and highlight opportunities for future research in personalized narrative experiences.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Strubberg},
 booktitle = {Proceedings of the 43rd {ACM}},
 doi = {10.1145/3711670.3764640},
 isbn = {979-8-4007-1444-3},
 keywords = {digital literacies},
 pages = {189--194},
 publisher = {Association for Computing Machinery},
 series = {{SIGDOC}},
 title = {From {UX}},
