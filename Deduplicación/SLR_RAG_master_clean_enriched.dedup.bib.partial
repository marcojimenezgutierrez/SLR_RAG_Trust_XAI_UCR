 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:07:26Z},
 year = {2024}
}

@inproceedings{andrews_aimoderator_2025,
 abstract = {Visual Question Answering (VQA) has achieved remarkable progress with the advent of large vision-language models (LVLMs). However, the fairness of these models remains underexplored, especially in terms of gender bias. Existing debiasing methods for VQA are tailored for traditional VQA models and are not directly applicable to LVLMs. In this paper, we conduct a comprehensive analysis of gender bias in LVLMs for VQA and propose a simple yet effective debiasing method, FairVQA, to mitigate gender bias in LVLMs. Specifically, we first construct a gender bias benchmark, BiasVQA, by augmenting the VQA v2 dataset with gender-related images and questions. Then, we propose a counterfactual data augmentation method to generate fair training data for LVLMs. Finally, we fine-tune LVLMs on the augmented data to obtain a fair VQA model. Extensive experiments on BiasVQA and other fairness benchmarks demonstrate the effectiveness of our method in reducing gender bias while maintaining the overall VQA performance.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 and determining whether aimoderator can improve subjective understanding. to evaluate these measures we conducted a mixed-method evaluation (n = {20) within-group design A-B study. Our analysis found AiModerator excelled in promoting engagement and satisfaction while delivering clear},
 author = {Andrews},
 booktitle = {Proceedings of the 30th {International}},
 doi = {10.1145/3708359.3712148},
 isbn = {979-8-4007-1306-4},
 keywords = {Hyper-contextualization},
 pages = {137--156},
 publisher = {Association for Computing Machinery},
 series = {{IUI}},
 title = {{AiModerator}},
