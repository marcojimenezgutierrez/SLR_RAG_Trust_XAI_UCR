@inproceedings{xu_grasp_2024,
 abstract = {Abstract—In the era of big data, privacy-preserving machine learning has become crucial, especially for sensitive applications like healthcare and finance. This paper introduces a novel federated learning architecture integrated with differential privacy mechanisms to enable secure collaborative model training across distributed devices. We address key challenges such as communication efficiency, model convergence, and robustness against adversarial attacks. Through extensive experiments on benchmark datasets including MNIST, CIFAR-10, and real-world medical records, our approach demonstrates superior performance in terms of accuracy (up to 15% improvement over baselines) and privacy guarantees (ε < 1.0). The proposed system is scalable and deployable in resource-constrained environments, paving the way for practical privacy-enhanced big data analytics.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Xu},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/BigData62323.2024.10825975},
 keywords = {Accuracy},
