@inproceedings{zhai_information_2025,
 abstract = {Visual programming languages (VPLs) have been proposed as a way to make programming more accessible to a wider audience. However, the design space of VPLs is vast, and it is unclear which design choices lead to effective VPLs. In this paper, we explore the design space of VPLs by conducting a systematic literature review of 50 VPLs. We identify key design dimensions, including representation, interaction, and abstraction, and analyze how they vary across VPLs. Our findings reveal patterns in successful VPL designs and provide guidance for future VPL development.},
