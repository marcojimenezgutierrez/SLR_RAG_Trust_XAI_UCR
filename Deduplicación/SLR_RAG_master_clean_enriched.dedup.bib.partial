@article{lu_scchat_2024,
 abstract = {Systematic errors in the measurement of gravitational waves from inspiralling compact binaries can bias estimates of their physical parameters. One such systematic arises from the finite extraction radius of numerical relativity simulations used to generate the surrogate models that are employed in gravitational wave data analysis. We investigate this systematic effect for the PhenomPv2 surrogate model by injecting a large set of simulated signals into LIGO/Virgo noise and performing parameter estimation with the SEOBNRv4_ROM and IMRPhenomPv2 waveform models. We find that the SEOBNRv4_ROM model, which is based on the same numerical relativity simulations as PhenomPv2 but uses a different extraction radius, produces unbiased estimates of the source parameters. In contrast, the IMRPhenomPv2 model, which is based on post-Newtonian theory calibrated to the same simulations, produces biased estimates of the source parameters. We conclude that the extraction radius used in the construction of surrogate models is an important consideration for gravitational wave data analysis.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Lu},
 doi = {10.1101/2024.10.01.616063.abstract},
 journal = {bioRxiv},
 keywords = {source: Google Scholar},
 note = {Publisher: biorxiv.org},
 title = {{scChat}},
 url = {https://doi.org/10.1101/2024.10.01.616063.abstract},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:27:54Z},
 year = {2024}
}

