@inproceedings{sahin_large_2024,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly impacted various sectors, including healthcare. This paper presents a comprehensive review of AI applications in medical diagnosis, focusing on machine learning and deep learning techniques for disease detection and prediction. We analyze recent studies on AI-driven tools for imaging analysis, such as X-ray and MRI interpretation, and predictive models for conditions like cancer and cardiovascular diseases. Key challenges, including data privacy, model interpretability, and integration with clinical workflows, are discussed. The findings highlight the potential of AI to enhance diagnostic accuracy and efficiency, while emphasizing the need for ethical guidelines and robust validation in real-world settings. Future directions include hybrid AI-human systems and federated learning to address current limitations.},
