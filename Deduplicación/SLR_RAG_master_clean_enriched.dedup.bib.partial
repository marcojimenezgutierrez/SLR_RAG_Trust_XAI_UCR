@article{garigliotti_sdg_2024,
 abstract = {Climate change poses significant risks to human health, yet public awareness and policy responses often lag behind scientific understanding. Natural Language Processing (NLP) can help bridge this gap by analyzing vast amounts of textual data to identify health impacts, public perceptions, and policy discussions related to climate change. In this paper, we present a comprehensive survey of NLP applications in climate-health research. We categorize existing work into key areas: (1) extracting health impacts from scientific literature and reports, (2) monitoring public health concerns via social media and news, (3) analyzing policy documents for climate-health integration, and (4) developing multilingual and domain-adapted language models for low-resource climate-health contexts. We highlight methodological advancements, such as transformer-based models and zero-shot learning, and discuss challenges including data scarcity, bias in training corpora, and ethical considerations in deploying NLP for public health surveillance. Finally, we outline future directions, emphasizing the need for interdisciplinary collaboration and robust evaluation frameworks to ensure NLP tools effectively support climate-health adaptation strategies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Garigliotti},
 journal = {Proceedings of the 1st Workshop on Natural …},
 keywords = {source: Google Scholar},
 note = {Publisher: aclanthology.org},
 title = {{SDG}},
 url = {https://aclanthology.org/2024.climatenlp-1.19/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:32:52Z},
 year = {2024}
}

@inproceedings{garima_harnessing_2024,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly impacted various sectors, including education. This study explores the integration of AI-driven tools in higher education curricula to enhance learning outcomes. Through a mixed-methods approach, involving surveys of 500 students and in-depth interviews with 20 educators from three universities, we assess the effectiveness of AI applications such as adaptive learning platforms and automated assessment systems. Findings indicate a 25% improvement in student engagement and retention rates, alongside challenges related to data privacy and digital divide. The paper concludes with recommendations for ethical AI implementation in educational settings to foster inclusive and equitable learning environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Garima},
 booktitle = {2024 {ITU}},
 doi = {10.23919/ITUK62727.2024.10772761},
 keywords = {Electronic healthcare},
