 year = {2025}
}

@inproceedings{tian_template-based_2025,
 abstract = {Generative AI has shown great potential in automating the creation of data visualizations, but current approaches often require users to provide detailed natural language specifications, which can be challenging for non-experts. To address this, we introduce VizGenie, a generative AI system that enables users to create data visualizations through a multimodal, interactive process. VizGenie combines natural language, sketching, and direct manipulation to guide the AI in generating visualizations that align with users' intentions. Our user study (N=24) demonstrates that VizGenie significantly outperforms a state-of-the-art baseline in terms of task completion time and user satisfaction, while enabling users to create more diverse and accurate visualizations. We discuss the design implications of our approach and opportunities for future work in multimodal generative AI for visualization.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
