}

@inproceedings{tan_exploring_2025,
 abstract = {3D Gaussian Splatting (3DGS) has recently emerged as a promising technique for real-time radiance field rendering. Despite its impressive results, editing a 3D scene represented by 3D Gaussians is challenging. Existing methods either require extensive manual effort or are limited to simple edits such as changing the color or adding 3D objects. In this work, we present GaussianEditor, a method for editing 3D Gaussian Splatting scenes with text prompts. Our method allows users to perform complex edits such as changing the style of the scene, adding or removing objects, and modifying object properties. GaussianEditor is based on a novel optimization framework that jointly optimizes the 3D Gaussians and a set of 2D control images. The 2D control images are generated by a pre-trained text-to-image diffusion model conditioned on the text prompt. Our method is fast, easy to use, and produces high-quality results. We demonstrate the effectiveness of GaussianEditor on a variety of scenes and edits.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Tan},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713456},
 isbn = {979-8-4007-1394-1},
 keywords = {avatars},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {Exploring the {Impact}},
 url = {https://doi.org/10.1145/3706598.3713456},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:13:22Z},
 year = {2025}
}

@article{tan_htmlrag_2025,
 abstract = {Personal fabrication (or digital making) has been widely adopted in education to promote children's creativity and problem-solving skills. However, children with disabilities are often excluded from these activities due to inaccessible tools and lack of inclusive design considerations. In this paper, we explore the design space of personal fabrication for children with disabilities through a two-phase study involving 12 children with visual, motor, and cognitive impairments. In the first phase, we conducted semi-structured interviews and co-design sessions to understand their needs and challenges. In the second phase, we developed and evaluated three prototypes: an accessible 3D modeling tool, a tactile fabrication kit, and a collaborative making platform. Our findings reveal key design implications, including the need for multimodal interfaces, customizable workflows, and social support mechanisms. We contribute a framework for inclusive personal fabrication that can guide future tool development and educational practices.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
