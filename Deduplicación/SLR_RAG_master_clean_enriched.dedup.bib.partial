 x_enrich_ts = {2025-11-02T09:32:13Z},
 year = {2024}
}

@inproceedings{yu_stateful_2025,
 abstract = {Despite recent advances in deep learning, visual recognition models often exhibit significant biases toward certain demographic groups, leading to unfair outcomes in real-world applications. This paper presents a comprehensive study on bias mitigation strategies for visual recognition tasks. We first analyze the sources of bias in popular datasets and models, identifying key factors such as imbalanced training data and spurious correlations. To address these issues, we propose a multi-stage debiasing framework that combines data augmentation, adversarial training, and fairness-aware fine-tuning. Our method is evaluated on multiple benchmarks, including CelebA, FFHQ, and RFW, across attributes like gender, race, and age. Experimental results demonstrate that our approach achieves substantial reductions in bias metrics—up to 40% improvement in demographic parity—while maintaining competitive accuracy. We also introduce a new evaluation metric, Bias-Accuracy Trade-off Index (BATI), to better quantify the fairness-utility balance. Our findings offer practical guidelines for developing equitable visual recognition systems and highlight directions for future research in fair AI.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Yu},
 booktitle = {Proceedings of the {Twentieth}},
