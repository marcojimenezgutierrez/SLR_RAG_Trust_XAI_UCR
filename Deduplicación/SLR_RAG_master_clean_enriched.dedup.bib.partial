 x_enrich_ts = {2025-11-02T06:34:38Z},
 year = {2025}
}

@inproceedings{jia_vqlens_2025,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices while preserving data privacy. However, applying FL to large language models (LLMs) is challenging due to the massive model size and communication overhead. Existing methods often rely on full model transmission or inefficient compression techniques, leading to high latency and privacy risks. In this paper, we propose FedLLM, a novel FL framework for LLMs that leverages low-rank adaptation (LoRA) and knowledge distillation to reduce communication costs and enhance efficiency. Specifically, we adapt LoRA for FL by training lightweight adapters on local data and aggregating them centrally, while using a teacher-student distillation mechanism to transfer knowledge from a global LLM teacher to local student models. Our approach significantly reduces the communication volume by up to 99% compared to full-parameter FL, while maintaining comparable performance on downstream tasks. Extensive experiments on benchmark datasets demonstrate the effectiveness of FedLLM in terms of accuracy, convergence speed, and privacy preservation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Jia},
 booktitle = {Companion of the 2025 {International}},
 doi = {10.1145/3722212.3725142},
