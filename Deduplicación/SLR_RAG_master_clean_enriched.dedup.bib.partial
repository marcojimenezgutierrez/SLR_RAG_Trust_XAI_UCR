@inproceedings{qiu_stella_2024,
 abstract = {The rapid growth of e-commerce has led to an explosion in the volume of user-generated reviews, providing a rich source of information for understanding consumer preferences and sentiments. Traditional sentiment analysis methods often struggle with the nuanced and context-dependent nature of review texts, particularly in multilingual settings. This paper proposes a novel multilingual sentiment analysis framework that leverages large language models (LLMs) fine-tuned on domain-specific review data to enhance accuracy and cultural relevance. We introduce a hybrid approach combining zero-shot prompting with supervised fine-tuning, incorporating cross-lingual transfer learning to handle low-resource languages. Experimental results on benchmark datasets from Amazon and Yelp demonstrate that our model outperforms state-of-the-art baselines by up to 15% in F1-score, particularly for aspect-based sentiment classification. The framework's adaptability to emerging e-commerce platforms underscores its potential for real-world deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Qiu},
