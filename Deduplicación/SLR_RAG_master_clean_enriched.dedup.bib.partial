 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:46:51Z},
 year = {2025}
}

@inproceedings{sun_largepig_2025,
 abstract = {Recent advancements in large language models (LLMs) have led to the development of conversational agents that can engage in open-domain dialogues with users. However, these agents often struggle with maintaining consistent personas and handling sensitive topics appropriately. In this paper, we introduce PersonaGuard, a framework that enhances the safety and consistency of LLM-based conversational agents by integrating persona-aware response generation with safety checks. PersonaGuard employs a dual-module architecture: a persona consistency module that ensures responses align with the agent's predefined persona, and a safety module that detects and mitigates harmful or inappropriate content. We evaluate PersonaGuard on multiple benchmarks, including persona consistency tasks and safety datasets, demonstrating significant improvements in both metrics compared to baseline models. Our results show that PersonaGuard reduces persona drift by 25% and harmful response rates by 40%, making it a robust solution for deploying safe, persona-driven conversational agents in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Sun},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3696410.3714800},
 isbn = {979-8-4007-1274-6},
 keywords = {hallucination},
 note = {event-place: Sydney NSW},
 pages = {4766--4779},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {{LargePiG}},
 url = {https://doi.org/10.1145/3696410.3714800},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:28:16Z},
 year = {2025}
}

@inproceedings{sun_multimodal_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their application in interactive systems remains underexplored, particularly in visual programming contexts. This paper introduces PromptChainer, a visual programming language (VPL) designed specifically for chaining LLM prompts. PromptChainer allows users to create complex prompt chains by visually connecting prompts, managing variables, and controlling execution flow without writing code. We conducted a formative study with 12 participants to understand user needs and iteratively designed the interface. In a controlled user study with 24 participants, we compared PromptChainer to a text-based baseline. Results show that novice users built more complex chains faster with PromptChainer and reported higher confidence, while experts appreciated its visual clarity for debugging and modification. Our findings highlight the potential of VPLs to democratize access to advanced LLM applications, and we discuss design implications for future tools.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Sun},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3696630.3728561},
