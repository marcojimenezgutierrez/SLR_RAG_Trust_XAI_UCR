 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:54:03Z},
 year = {2025}
}

@inproceedings{shi_generate-then-ground_2024,
 abstract = {Video summarization is a challenging task that requires generating concise and informative summaries of long videos. Existing methods often struggle with faithfulness, as they tend to hallucinate or omit key details. In this work, we propose a novel approach to faithful abstractive video summarization using a chain-of-density (CoD) prompting strategy. Inspired by recent advances in text summarization, we adapt CoD to the video domain by iteratively densifying the summary with more entities and details while maintaining factual consistency. Our method leverages a pre-trained vision-language model to generate dense entity descriptions from video frames and then uses a large language model to refine and summarize these descriptions into a coherent narrative. We evaluate our approach on the ActivityNet Captions and TVSum datasets, demonstrating significant improvements in faithfulness metrics such as FactKB and density scores, while achieving competitive ROUGE scores. Our results highlight the potential of CoD for generating faithful and dense video summaries.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 10},
 author = {Shi},
 booktitle = {Proceedings of the {Annual}},
 doi = {10.18653/v1/2024.acl-long.397},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {7339 -- 7353},
 title = {Generate-then-{Ground}},
 url = {https://doi.org/10.18653/v1/2024.acl-long.397},
 volume = {1},
 x_enrich_source = {x-ai/grok-4-fast},
