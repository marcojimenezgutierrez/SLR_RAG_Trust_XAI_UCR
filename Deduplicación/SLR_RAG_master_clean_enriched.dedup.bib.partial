@article{jones_shred_2022,
 abstract = {We present SHRED, a method for 3D SHape REgion Decomposition. SHRED takes a 3D point cloud as input and uses learned local operations to produce a segmentation that approximates fine-grained part instances. We endow SHRED with three decomposition operations: splitting regions, fixing the boundaries between regions, and merging regions together. Modules are trained independently and locally, allowing SHRED to generate high-quality segmentations for categories not seen during training. We train and evaluate SHRED with fine-grained segmentations from PartNet; using its merge-threshold hyperparameter, we show that SHRED produces segmentations that better respect ground-truth annotations compared with baseline methods, at any desired decomposition granularity. Finally, we demonstrate that SHRED is useful for downstream applications, out-performing all baselines on zero-shot fine-grained part instance segmentation and few-shot finegrained semantic segmentation when combined with methods that learn to label shape regions.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Jones},
 doi = {10.1145/3550454.3555440},
 issn = {0730-0301},
 journal = {ACM Trans. Graph.},
 keywords = {fine-grained components},
 month = {nov},
 note = {Place: New York},
 number = {6},
 title = {{SHRED}},
 url = {https://doi.org/10.1145/3550454.3555440},
 volume = {41},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:38Z},
 year = {2022}
}

@article{joren_sufficient_2024,
 abstract = {We present RT-2, a vision-language-action (VLA) model that learns from both internet-scale data and robotics data, and achieves seamless transfer of concepts from VLMs to robotic control. RT-2 utilizes a transformer-based architecture, which is trained on a large dataset of web-scale vision-language data and robotics trajectories. By co-fine-tuning on both datasets, RT-2 enables end-to-end learning for vision-language understanding and visuomotor control. We study RT-2's capabilities on a wide range of tasks, including novel tasks that require real-world reasoning, such as describing an object, taking actions based on language instructions, and performing basic reasoning in the form of simple arithmetic. We find that RT-2 has significantly improved generalization capabilities compared to prior robotic learning models. For example, RT-2 can follow language instructions, such as "pick up the rock", in novel scenes that contain objects that were not seen during training. We also find that RT-2 exhibits emergent reasoning capabilities that were not explicitly trained on, such as performing simple arithmetic using the shapes of objects. These emergent capabilities suggest that RT-2 has learned a general understanding of the world that can be applied to new tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Joren},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Sufficient context: {A}},
 url = {https://arxiv.org/abs/2411.06037},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:32:01Z},
 year = {2024}
}

