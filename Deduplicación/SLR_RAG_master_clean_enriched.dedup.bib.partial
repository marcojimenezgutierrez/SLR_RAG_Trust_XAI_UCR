 year = {2024}
}

@article{sharma_retrieval_2024,
 abstract = {Recent work has shown that the phenomenon of grokking in neural networks can be explained by a transition from memorization to generalization in the learned model. In this paper, we study grokking in the context of modular arithmetic tasks, where the model learns to compute modular polynomials. We show that grokking occurs in a variety of settings, including when the target function is a low-degree polynomial, and that the generalization error decreases exponentially during grokking. We provide a theoretical explanation for this phenomenon based on the geometry of the loss landscape and the dynamics of gradient descent. Our results suggest that grokking is a general phenomenon that occurs when the model learns a low-complexity representation of the target function.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
