 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Vitality 2: {Reviewing}},
 url = {https://arxiv.org/abs/2408.13450},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:26:40Z},
 year = {2024}
}

@article{anaguchi_reasoning_2024,
 abstract = {In this paper, we propose a novel federated learning framework for privacy-preserving anomaly detection in IoT networks. Traditional centralized approaches are vulnerable to data breaches and single points of failure, while federated learning enables collaborative model training without sharing raw data. Our framework incorporates differential privacy mechanisms and secure aggregation protocols to enhance security against adversarial attacks. We evaluate the proposed method on real-world IoT datasets, demonstrating superior detection accuracy and reduced communication overhead compared to baseline federated and centralized models. Experimental results show that our approach achieves up to 15% improvement in F1-score while maintaining strong privacy guarantees.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
