@inproceedings{feng_enabling_2024,
 abstract = {Visual localization and mapping are essential for robotics and augmented reality applications. Recent neural implicit representations have shown great promise in achieving high-fidelity reconstructions and dense semantic understanding of environments. However, existing approaches often struggle with real-time performance and generalization to unseen scenes. In this work, we propose Neural Implicit Dense Semantic SLAM (NIDS-SLAM), a novel framework that leverages neural implicit fields for simultaneous localization, mapping, and dense semantic segmentation in a unified manner. Our approach integrates a deformable neural radiance field with a semantic decoder to enable efficient online optimization of geometry, appearance, and semantics. By incorporating a robust pose estimation module and a novel regularization strategy, NIDS-SLAM achieves state-of-the-art accuracy and efficiency on challenging indoor and outdoor datasets, outperforming traditional and learning-based SLAM systems in terms of reconstruction quality and semantic consistency.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
