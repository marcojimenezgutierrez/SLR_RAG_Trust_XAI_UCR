 year = {2024}
}

@inproceedings{liu_siqa_2025,
 abstract = {This paper proposes a novel approach to blind source separation in reverberant environments using a transformer-based neural network architecture. We introduce a multi-head attention mechanism tailored for acoustic signals, which captures long-range dependencies in both time and frequency domains. The model is trained end-to-end on simulated reverberant mixtures, incorporating room impulse responses from various acoustic scenarios. Experimental results on benchmark datasets demonstrate superior performance over state-of-the-art methods, achieving up to 15% improvement in signal-to-distortion ratio (SDR). Our method also shows robustness to unseen reverberation conditions, making it suitable for real-world applications such as teleconferencing and hearing aids.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Liu},
 booktitle = {{ICASSP}},
