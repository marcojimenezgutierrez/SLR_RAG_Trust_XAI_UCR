@book{palmer_notitle_2024,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly impacted various sectors, including education. This paper explores the integration of AI in higher education, focusing on personalized learning systems. We propose a novel framework that leverages machine learning algorithms to adapt educational content to individual student needs, thereby enhancing engagement and learning outcomes. Through a case study involving a university course, we demonstrate the framework's effectiveness in improving student performance by 25%. The results highlight the potential of AI to transform traditional teaching methodologies, while also addressing ethical considerations such as data privacy and algorithmic bias.},
