 title = {Healai: {A}},
 url = {https://doi.org/10.1145/3616855.3635739},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:29:03Z},
 year = {2024}
}

@inproceedings{gozukara_rag_2025,
 abstract = {The proliferation of content within video streaming services presents a significant challenge for users seeking personalized recommendations and specific information. This research addresses this challenge by developing a Retrieval-Augmented Generation (RAG) chatbotn designed to enhance user experience through conversational AI. The primary contribution of this work is a novel Retrieval-Augmented Generation (RAG) architecture featuring a dual-retrieval system that combines semantic search for descriptive requests and structured queries for fact based inquiries. This approach grounds the Large Language Model (LLM) in a factual knowledge base},
 author = {Gözükara},
 booktitle = {2025 10th {International}},
 doi = {10.1109/UBMK67458.2025.11206833},
 keywords = {Accuracy},
 note = {ISSN: 2521-1641},
 pages = {1350--1355},
 title = {{RAG}},
 url = {https://doi.org/10.1109/ubmk67458.2025.11206833},
 year = {2025}
}

@inproceedings{grafberger_towards_2024,
 abstract = {This paper presents a novel approach to integrating large language models (LLMs) into the iOS app development process through a tool called GenAIC. We conducted a formative study with 12 professional iOS developers to understand their pain points and needs in the development workflow. Based on the findings, we designed GenAIC to assist in three key stages: ideation, implementation, and debugging. GenAIC leverages LLMs to generate Swift code snippets, suggest UI designs, and provide debugging advice tailored to iOS-specific constraints like SwiftUI and UIKit. Our evaluation with 16 iOS developers shows that GenAIC significantly reduces development time by 35% on average and improves code quality, while maintaining developer control over the process. We discuss implications for future AI-assisted development tools in mobile ecosystems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Grafberger},
 booktitle = {Proceedings of the {Eighth}},
