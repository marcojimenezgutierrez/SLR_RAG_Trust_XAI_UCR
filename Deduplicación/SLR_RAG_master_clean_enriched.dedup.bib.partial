@article{wang_biorag_2024,
 abstract = {Achieving generalist robot policies that can perform a wide range of tasks in diverse environments remains a central challenge in robotics. While large-scale data and compute have enabled recent advances, we investigate whether these are necessary or if more accessible approaches can yield strong generalization. We conduct a comprehensive study across data, architecture, and training paradigms, identifying key factors that enable effective generalist policies with modest resources. Our findings emphasize the importance of high-quality, diverse data over sheer volume, and demonstrate that transformer-based architectures with appropriate scaling outperform simpler baselines. We also explore curriculum learning and data augmentation, showing they enhance robustness without additional data. To validate these insights, we introduce a new benchmark of household manipulation tasks and train a generalist policy that achieves state-of-the-art performance using only 10 hours of real-world data on standard hardware. Our work provides actionable guidelines for developing accessible generalist robot policies, facilitating broader adoption in research and real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wang},
 journal = {arXiv preprint arXiv …},
