@inproceedings{shrestha_espn_2024,
 abstract = {Recommendation systems have been widely deployed in various online platforms, which significantly impact people's daily lives. However, recent studies have shown that recommendation systems can exhibit discriminatory behavior against certain social groups, which is known as bias. In this paper, we focus on gender bias in the job recommendation scenario. We first propose a bias measurement method to quantify the gender bias in the recommendation results. Then, we conduct an empirical analysis on the real-world job recommendation platform, and find that the recommendation results are biased against women. To mitigate the gender bias, we propose a novel debiasing method based on counterfactual fairness. Specifically, we first construct a causal graph to model the causal relationships among user gender, user profile, and job recommendation. Then, we use counterfactual fairness to generate unbiased recommendations by intervening on the user gender. Extensive experiments on real-world datasets demonstrate the effectiveness of our proposed method in mitigating gender bias while maintaining the recommendation utility.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Shrestha},
 booktitle = {Proceedings of the 2024 {ACM}},
 doi = {10.1145/3652024.3665515},
