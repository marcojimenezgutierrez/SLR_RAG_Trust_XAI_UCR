 year = {2025}
}

@article{wang_jmlr_2024,
 abstract = {In this paper, we present a new large-scale dataset and benchmark for robotic learning called Open X-Embodiment (OXE). The dataset consists of 1 million real robot trajectories collected from 22 different robot embodiments across 527 skills in 83 different environments. We also present RT-X, a new family of 22 foundation models for robotic manipulation trained on the OXE dataset. RT-X models are trained using a novel offline reinforcement learning method that scales to large datasets and diverse embodiments. We evaluate RT-X models on a set of 12 held-out tasks and show that they outperform existing methods by up to 2x. We also show that RT-X models can be fine-tuned to new embodiments and tasks with small amounts of data. Our results demonstrate the potential of large-scale, diverse datasets for enabling generalist robotic policies. The OXE dataset and RT-X models are publicly available at https://robotics-transformer-x.github.io.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wang},
 journal = {arXiv preprint arXiv:2402.17887},
 keywords = {source: Google Scholar},
