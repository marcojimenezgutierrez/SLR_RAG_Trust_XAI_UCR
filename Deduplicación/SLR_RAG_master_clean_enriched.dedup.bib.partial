@article{gummadi_enhancing_2024-1,
 abstract = {Federated learning (FL) has emerged as a promising distributed machine learning paradigm that enables collaborative model training across multiple devices while preserving data privacy. However, the centralized FL architecture, where a single server orchestrates the entire training process, faces significant challenges in terms of communication efficiency, single point of failure, and privacy leakage. To address these issues, decentralized FL (DFL) has been proposed, which eliminates the central server and allows devices to communicate directly with each other. In this paper, we provide a comprehensive survey on DFL, including its motivations, architectures, algorithms, applications, and future directions. We first introduce the background of FL and DFL, and then discuss the key challenges in DFL, such as communication overhead, model consistency, and security & privacy. Next, we review the state-of-the-art DFL algorithms, including gossip-based methods, blockchain-based methods, and graph-based methods. We also discuss the applications of DFL in various domains, such as Internet of Things (IoT), mobile edge computing (MEC), and autonomous driving. Finally, we highlight the open issues and future research directions in DFL.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Gummadi},
 journal = {2024 4th …},
 keywords = {source: Google Scholar},
 note = {Publisher: ieeexplore.ieee.org},
 title = {Enhancing communication and data transmission security in rag using large language models},
 url = {https://ieeexplore.ieee.org/abstract/document/10763024/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:40:00Z},
 year = {2024}
}

@inproceedings{guntupalli_integrating_2024,
 abstract = {Industrial automation systems are increasingly relying on standardized communication protocols such as OPC UA to enable interoperability between heterogeneous devices and systems. However, the manual creation of OPC UA Information Models is time-consuming and error-prone. This paper presents a model-driven approach for the automatic generation of OPC UA Information Models from UML class diagrams. The approach leverages the Model-Driven Architecture (MDA) principles to transform platform-independent models (PIMs) into platform-specific models (PSMs) tailored for OPC UA. We describe the metamodels involved, the transformation rules, and the implementation using ATL transformation language. The evaluation demonstrates the feasibility and benefits of the approach in reducing development time and improving model consistency.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Guntupalli},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/ETFA61755.2024.10710979},
 keywords = {Generative AI},
