 year = {2025}
}

@inproceedings{jiang_bridging_2024,
 abstract = {Articulated object manipulation is a long-standing challenge in robotics, requiring robots to understand object structures, infer affordances, and execute precise actions. While learning-based methods have shown promise, they often require extensive training data and struggle with generalization to novel objects. In this paper, we present a zero-shot approach for articulated object manipulation that leverages the reasoning capabilities of multimodal large language models (MLLMs). Our method, ArticulateGPT, decomposes the manipulation task into semantic understanding, part segmentation, affordance reasoning, and motion planning stages, all driven by natural language prompts to an MLLM. By combining MLLM outputs with visual perception and grasp planning, we enable robots to manipulate unseen articulated objects without task-specific training. We evaluate our approach on a diverse set of household objects and demonstrate significant improvements over prior zero-shot methods, achieving up to 70% success rate in real-world experiments. Our work highlights the potential of MLLMs as generalizable reasoning engines for robotic manipulation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Jiang},
 booktitle = {Companion {Publication}},
 doi = {10.1145/3678884.3681820},
