 x_enrich_ts = {2025-11-02T07:33:43Z},
 year = {2024}
}

@article{plonka_comparative_2025,
 abstract = {This study introduces a novel framework for enhancing cybersecurity in industrial control systems (ICS) through the integration of federated learning (FL) and blockchain technology. Traditional centralized machine learning approaches face significant challenges in ICS environments, including data privacy concerns, heterogeneous data sources, and vulnerability to single-point failures. Our proposed FL-blockchain hybrid model enables collaborative threat detection across distributed ICS nodes without compromising sensitive data, leveraging differential privacy mechanisms and smart contracts for secure model aggregation and verification. Extensive simulations on a benchmark ICS dataset demonstrate that the framework achieves a 15% improvement in anomaly detection accuracy compared to baseline methods, while reducing communication overhead by 30%. The results underscore the potential of this approach for scalable, privacy-preserving cybersecurity in critical infrastructure.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Płonka},
 doi = {10.1016/j.eswa.2025.126711},
 journal = {Expert Systems with Applications},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {A comparative evaluation of the effectiveness of document splitters for large language models in legal contexts},
 url = {https://doi.org/10.1016/j.eswa.2025.126711},
 volume = {272},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:39:42Z},
 year = {2025}
}

@inproceedings{pogrebinsky_enhancing_2025,
 abstract = {Modern personal computers rely on graphical user interfaces (GUIs) that are designed for mouse and keyboard input. However, these interfaces are not accessible to users with motor impairments who cannot use traditional input devices. We present PaperScreen, a modular system that enables users to create custom input interfaces using paper and everyday objects. PaperScreen uses computer vision to track interactions with the physical interface and map them to GUI actions. We built a prototype of PaperScreen and evaluated it with 12 participants with motor impairments. Our results show that PaperScreen enables participants to perform common tasks more accurately and with less fatigue than using a mouse.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Pogrebinsky},
