 pages = {5425--5429},
 publisher = {Association for Computing Machinery},
 series = {{CIKM}},
 title = {{CheckGuard}},
 url = {https://doi.org/10.1145/3627673.3679155},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:10:46Z},
 year = {2024}
}

@article{zhao_deriving_2025,
 abstract = {Background: The integration of simulation-based learning in nursing education has gained prominence, yet challenges remain in ensuring equitable access and effectiveness across diverse student populations. Aim: This study aimed to evaluate the impact of a hybrid simulation program incorporating virtual reality (VR) elements on nursing students' clinical competence and confidence. Design: A quasi-experimental design was employed with pre- and post-intervention assessments. Methods: Ninety undergraduate nursing students from a university in the United Kingdom participated. The intervention consisted of eight weeks of hybrid simulations, including two VR sessions. Data were collected using the Clinical Competence Questionnaire and a confidence scale, analyzed via paired t-tests and thematic analysis of qualitative feedback. Results: Significant improvements were observed in clinical competence (t(89) = -8.45, p < 0.001) and confidence levels (t(89) = -7.32, p < 0.001). Qualitative themes included enhanced situational awareness and reduced anxiety. Barriers such as technical issues were noted, suggesting the need for robust support systems. Conclusions: Hybrid VR simulation is a promising approach to bolster nursing education, particularly in resource-limited settings. Future research should explore long-term retention and scalability.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 3; All Open Access; Hybrid Gold Open Access},
 author = {Zhao},
 doi = {10.1016/j.nepr.2025.104284},
 journal = {Nurse Education in Practice},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Deriving insights from enhanced accuracy: {Leveraging}},
 url = {https://doi.org/10.1016/j.nepr.2025.104284},
 volume = {84},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:42:09Z},
 year = {2025}
}

@article{zhao_embodied_2024,
 abstract = {Recent advances in large language models (LLMs) have shown impressive performance on complex reasoning tasks. However, these models often struggle with tasks requiring step-by-step reasoning, especially when the reasoning process is not explicitly prompted. In this paper, we explore the idea of chain-of-thought (CoT) prompting, where the model is encouraged to generate a series of intermediate reasoning steps before arriving at the final answer. We find that CoT prompting significantly improves performance on arithmetic, commonsense, and symbolic reasoning tasks. The results demonstrate that CoT enables emergent abilities in LLMs that were previously not observed, highlighting the potential of prompting strategies to unlock more sophisticated reasoning capabilities.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
