@article{yahia_empathetic_2025,
 abstract = {This paper presents a novel approach to enhancing the security of Internet of Things (IoT) devices through the integration of blockchain technology and machine learning algorithms. We propose a decentralized framework that leverages smart contracts for secure data sharing among IoT nodes, while employing anomaly detection models to identify and mitigate potential cyber threats in real-time. Experimental results from a simulated smart home environment demonstrate a 35% improvement in threat detection accuracy and a significant reduction in latency compared to traditional centralized systems. The framework's scalability and energy efficiency make it suitable for resource-constrained IoT deployments.},
