 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:40:58Z},
 year = {2024}
}

@inproceedings{joshi_robust_2024,
 abstract = {This paper proposes a novel framework for optimizing resource allocation in cloud computing environments using reinforcement learning. The approach integrates deep Q-networks with multi-agent systems to dynamically manage virtual machine provisioning and workload balancing. Extensive simulations on real-world datasets demonstrate a 25% reduction in energy consumption and a 30% improvement in response time compared to traditional heuristic methods. The framework's adaptability to varying workloads makes it suitable for large-scale data centers.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
