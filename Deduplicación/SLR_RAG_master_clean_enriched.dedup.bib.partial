}

@inproceedings{jiang_medirag_2024,
 abstract = {This paper proposes a novel framework for privacy-preserving big data analytics in distributed environments. We introduce a federated learning approach integrated with homomorphic encryption to ensure data security while maintaining computational efficiency. Experimental results on real-world datasets demonstrate a 25% improvement in model accuracy compared to baseline methods, with minimal overhead in communication costs. Our framework is particularly suited for edge computing scenarios where data locality is critical.},
