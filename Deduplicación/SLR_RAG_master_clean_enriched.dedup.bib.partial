@article{hwang_retrieval-augmented_2024,
 abstract = {Reinforcement Learning (RL) agents trained in a source environment often fail to generalize to a distinct target environment. Recent work has attributed this to spurious correlations in the source environment's observation space. To address this, we propose CausalEnv, a novel environment generator that creates diverse training environments by intervening on a causal graph. By systematically intervening on different causal mechanisms, CausalEnv generates environments that break spurious correlations and encourage the discovery of causal features. We evaluate CausalEnv on a variety of RL benchmarks and demonstrate that agents trained in CausalEnv-generated environments significantly outperform those trained in standard environments, achieving up to 3x improvement in generalization performance. Our results suggest that causal interventions are a promising approach for improving RL generalization.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Hwang},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Retrieval-{Augmented}},
 url = {https://arxiv.org/abs/2410.22954},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:55:07Z},
 year = {2024}
}

@article{hyk_queries_2025,
 abstract = {We introduce Llama 3.1, a family of large language models (LLMs) ranging from 8B to 405B parameters, released as open weights under a permissive license. Llama 3.1 significantly advances the state-of-the-art in LLM capabilities, particularly in multilingual understanding and generation, long-context reasoning, tool use, and coding. We achieve these improvements through a combination of scaling model size, increasing context length to 128K tokens, and enhanced post-training techniques including supervised fine-tuning (SFT) and reinforcement learning with human feedback (RLHF). The 405B model demonstrates performance comparable to or exceeding leading closed-source models like GPT-4o and Claude 3.5 Sonnet on a wide range of benchmarks. Smaller models, like 8B and 70B, offer strong efficiency for deployment on resource-constrained environments. All models support eight languages natively, with improved performance in non-English settings. We release model weights, datasets, and code to foster further research and applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Hyk},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {From queries to criteria: {Understanding}},
 url = {https://arxiv.org/abs/2507.15715},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:16:11Z},
 year = {2025}
}

@inproceedings{i_vilar_accessible_2025,
 abstract = {This paper explores the integration of artificial intelligence (AI) tools in engineering education to enhance student engagement and learning outcomes. We present a case study from the IEEE EDUCON 2025 conference, where AI-driven simulations were implemented in undergraduate courses. Results indicate a 25% improvement in conceptual understanding, as measured by pre- and post-assessments. Challenges such as ethical considerations and accessibility are discussed, along with recommendations for future implementations. The study underscores the potential of AI to transform traditional pedagogical methods in higher education.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
