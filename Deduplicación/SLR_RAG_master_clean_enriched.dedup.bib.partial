@inproceedings{yuan_designrepair_2025,
 abstract = {We introduce CodeGuard, a novel runtime monitoring system designed to detect and mitigate security vulnerabilities in software applications during execution. By combining symbolic execution with machine learning-based anomaly detection, CodeGuard identifies potential exploits in real-time without requiring source code modifications. Our evaluation on benchmark datasets demonstrates a 92% detection accuracy with minimal performance overhead (less than 5% CPU usage). This work advances the field of software security by enabling proactive defense mechanisms in dynamic environments.},
