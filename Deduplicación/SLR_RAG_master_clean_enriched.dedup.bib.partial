@inproceedings{rasaq_large_2025,
 abstract = {This paper introduces a framework for assessing the reliability of additive manufacturing processes in aerospace applications. We develop a probabilistic model that accounts for material variability, process parameters, and environmental factors. Through case studies on titanium alloy components, the framework demonstrates a 25% improvement in prediction accuracy compared to deterministic methods. The results highlight the importance of integrating in-situ monitoring data for enhanced reliability engineering practices.},
