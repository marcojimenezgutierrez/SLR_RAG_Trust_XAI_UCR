 volume = {Part F723},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:51:49Z},
 year = {2025}
}

@inproceedings{kim_lapis_2024,
 abstract = {Vision-language models (VLMs) have achieved remarkable success in various vision tasks, but they often inherit biases from their training data, leading to unfair and unreliable predictions. Existing debiasing methods for VLMs are limited in their effectiveness and generalizability. In this paper, we propose a novel debiasing framework for VLMs that leverages the model's own generation capabilities to identify and mitigate biases. Our approach involves generating biased prompts using the VLM itself, which are then used to fine-tune the model in a way that reduces bias without sacrificing performance. We evaluate our method on multiple datasets and bias metrics, demonstrating significant improvements over state-of-the-art debiasing techniques. Our framework is simple, efficient, and applicable to a wide range of VLMs, paving the way for more equitable vision-language understanding.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
