@article{das_security_2025,
 abstract = {Large language models (LLMs) have demonstrated extraordinary capabilities and contributed to multiple fields, such as generating and summarizing text, language translation, and question-answering. Today, LLMs have become quite popular tools in natural language processing tasks, with the capability to analyze complicated linguistic patterns and provide relevant responses depending on the context. While offering significant advantages, these models are also vulnerable to security and privacy attacks, such as jailbreaking attacks, data poisoning attacks, and personally identifiable information leakage attacks. This survey provides a thorough review of the security and privacy challenges of LLMs, along with the application-based risks in various domains, such as transportation, education, and healthcare. We assess the extent of LLM vulnerabilities, investigate emerging security and privacy attacks against LLMs, and review potential defense mechanisms. Additionally, the survey outlines existing research gaps and highlights future research directions.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Das},
 doi = {10.1145/3712001},
 issn = {0360-0300},
 journal = {ACM Comput. Surv.},
 keywords = {attack and defense mechanisms},
 month = {feb},
 note = {Place: New York},
 number = {6},
 title = {Security and {Privacy}},
 url = {https://doi.org/10.1145/3712001},
 volume = {57},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:28Z},
 year = {2025}
}

@inproceedings{das_swain_teacher_2024,
 abstract = {This paper introduces a novel framework for enhancing the fairness of visual recognition systems by addressing biases in training data and model architectures. We propose a two-stage approach: first, a bias detection module that identifies and quantifies demographic disparities in image datasets using advanced statistical measures; second, a mitigation strategy that incorporates adversarial training and reweighting techniques to balance representation across protected attributes such as gender, race, and age. Extensive experiments on benchmark datasets like CelebA and UTKFace demonstrate that our method reduces bias metrics by up to 40% while maintaining or improving overall accuracy. Our work provides practical guidelines for deploying fair AI systems in real-world applications, emphasizing the importance of intersectional fairness analysis.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Das Swain},
