 x_enrich_ts = {2025-11-02T09:38:46Z},
 year = {2025}
}

@inproceedings{taveekitworachai_enhancing_2023,
 abstract = {Binary disassembly is a core technique for reverse engineering and has been extensively studied for decades. However, the field is still in its infancy when it comes to understanding the fundamental principles and the state-of-the-art techniques. In this systemization of knowledge (SoK) paper, we aim to fill this gap by providing a comprehensive survey of the disassembly techniques, their strengths and weaknesses, and the challenges ahead. We first introduce the disassembly problem and the challenges it poses. We then survey the existing disassembly techniques, including linear sweep, recursive traversal, and their variants. We also discuss the advanced techniques that leverage machine learning and other novel approaches. Finally, we discuss the evaluation metrics and benchmarks for disassembly and point out the future research directions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Taveekitworachai},
 booktitle = {Proceedings of the 13th {International}},
