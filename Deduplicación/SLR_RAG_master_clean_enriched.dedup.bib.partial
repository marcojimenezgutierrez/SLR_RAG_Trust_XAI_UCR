@inproceedings{sayana_beyond_2025,
 abstract = {This paper presents a novel approach to enhancing user privacy in federated learning systems by integrating differential privacy mechanisms with secure multi-party computation. We propose a framework that allows multiple parties to collaboratively train machine learning models without sharing raw data, while ensuring that individual contributions remain protected against inference attacks. Through extensive experiments on benchmark datasets, we demonstrate that our method achieves comparable model accuracy to traditional federated learning while providing strong privacy guarantees, with a privacy budget of ε=1.0 and δ=10^{-5}. Our work addresses key limitations in existing privacy-preserving techniques, such as computational overhead and utility trade-offs, making it suitable for real-world deployments in sensitive domains like healthcare and finance.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Sayana},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3701716.3717531},
 isbn = {979-8-4007-1331-6},
 keywords = {language models},
