 year = {2024}
}

@article{park_development_2024,
 abstract = {Obesity is a major risk factor for type 2 diabetes, cardiovascular disease, and certain types of cancer. The worldwide obesity epidemic has been attributed to increased consumption of energy-dense foods and reduced physical activity. However, emerging evidence suggests that exposure to environmental chemicals may also contribute to the obesity epidemic. Here, we review the evidence linking exposure to environmental chemicals, particularly endocrine-disrupting chemicals (EDCs), to obesity and metabolic dysfunction. We discuss potential mechanisms by which EDCs may promote obesity, including effects on adipocyte differentiation, lipid metabolism, energy balance, and the gut microbiome. We also highlight critical windows of susceptibility, particularly during early development, when exposure to EDCs may have lasting effects on obesity risk. Finally, we discuss challenges and future directions for research in this emerging field, including the need for improved exposure assessment, consideration of chemical mixtures, and translation of findings to inform public health policy.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Park},
 journal = {The Journal of the Institute of Internet …},
 keywords = {source: Google Scholar},
 note = {Publisher: The Institute of Internet …
Type: CITATION},
 title = {Development of dental consultation chatbot using retrieval augmented llm},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:27:33Z},
 year = {2024}
}

@article{park_literature_2024,
 abstract = {Severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) has caused a global pandemic of coronavirus disease 2019 (COVID-19). The spike (S) protein of SARS-CoV-2 mediates viral entry into host cells by binding to angiotensin-converting enzyme 2 (ACE2). Here, we report cryo-electron microscopy structures of the SARS-CoV-2 S protein in the prefusion conformation with all three receptor-binding domains (RBDs) in the "down" conformation and in complex with ACE2 with one RBD in the "up" conformation. These structures reveal the molecular basis for SARS-CoV-2 S protein recognition of ACE2 and provide a blueprint for the design of vaccines and therapeutics.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Park},
 journal = {Informatization Policy},
 keywords = {source: Google Scholar},
