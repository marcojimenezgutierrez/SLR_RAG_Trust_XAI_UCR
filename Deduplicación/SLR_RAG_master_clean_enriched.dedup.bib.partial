 year = {2025}
}

@inproceedings{khatua_policies_2025,
 abstract = {The rapid evolution of artificial intelligence (AI) technologies has led to their widespread adoption across various sectors, including healthcare, education, and finance. However, the integration of AI systems into these domains raises significant ethical concerns, particularly regarding bias, privacy, and accountability. This paper explores the ethical implications of AI deployment in high-stakes environments, drawing on case studies from medical diagnostics and autonomous vehicles. We propose a framework for ethical AI governance that emphasizes transparency, fairness, and human oversight. Through interdisciplinary analysis, we highlight the need for regulatory measures and stakeholder collaboration to mitigate risks and ensure equitable outcomes. Our findings underscore the importance of proactive ethical design in AI development to foster trust and societal benefit.},
 abstract_lang = {en},
