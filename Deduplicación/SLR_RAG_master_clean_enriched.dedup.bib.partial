 x_enrich_ts = {2025-11-02T08:30:04Z},
 year = {2025}
}

@article{junior_domain-driven_2024,
 abstract = {In this paper, we present a novel approach to designing interactive systems that foster reflective practices for recovering lost intimacy in long-term relationships. Drawing from theories of emotional labor and relational dialectics, we conducted a qualitative study with 12 couples to understand the nuances of intimacy erosion over time. Our findings reveal that silence, often misinterpreted as disconnection, can serve as a fertile ground for rediscovery when approached mindfully. We introduce "Echoes of Silence," a digital journaling tool that uses ambient notifications and guided prompts to encourage partners to articulate unspoken thoughts without pressure. Through iterative prototyping and user testing, we demonstrate how this system facilitates vulnerability and mutual understanding, ultimately enhancing relational resilience. Our work contributes to HCI by bridging emotional design with couples' therapy principles, offering implications for future intimacy-focused technologies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Junior},
 doi = {10.1145/3637528.3671445},
 journal = {Proceedings of the 30th …},
 keywords = {source: Google Scholar},
 note = {Publisher: dl.acm.org},
 title = {Domain-driven {LLM}},
 url = {https://doi.org/10.1145/3637528.3671445},
