@article{lee_performance_2024,
 abstract = {Offshore wind energy is a key component of the global transition to renewable energy sources, but its development can have significant environmental impacts. This review synthesizes the current state of knowledge on the environmental effects of offshore wind farms (OWFs) across multiple disciplines, including marine ecology, ornithology, marine mammals, fisheries, and socio-economics. We conducted a systematic literature review of 512 peer-reviewed articles published between 2000 and 2023, focusing on empirical studies from operational OWFs. Key findings indicate that OWFs affect benthic communities through habitat alteration and noise during construction, with recovery often observed post-construction. Avifauna and bats experience collision risks and displacement, particularly during migration. Marine mammals face disturbance from pile-driving noise, leading to temporary displacement. Fisheries are impacted by exclusion zones and habitat changes, though some studies report artificial reef effects enhancing fish biomass. Socio-economic impacts include conflicts with other marine users and tourism. Mitigation measures such as bubble curtains, seasonal construction windows, and post-construction monitoring are effective but require further optimization. Gaps in knowledge include long-term cumulative effects, interactions between stressors, and impacts in tropical regions. Future research should prioritize standardized monitoring protocols and adaptive management to minimize environmental risks while maximizing the benefits of offshore wind energy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Lee},
 journal = {Automation in Construction},
 keywords = {source: Google Scholar},
 note = {Publisher: Elsevier},
 title = {Performance comparison of retrieval-augmented generation and fine-tuned large language models for construction safety management knowledge retrieval},
 url = {https://www.sciencedirect.com/science/article/pii/S092658052400582X},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:23:29Z},
 year = {2024}
}

@inproceedings{lee_rag-enhanced_2025,
 abstract = {Generative artificial intelligence (AI) has shown remarkable capabilities in creating human-like text, but its potential for supporting creative writing remains underexplored. In this paper, we investigate how large language models (LLMs) can assist writers in generating story ideas and outlines. Through a series of experiments and a user study with 30 professional writers, we evaluate the effectiveness of LLM-assisted tools in enhancing creativity, productivity, and satisfaction. Our findings reveal that while LLMs can provide diverse and novel ideas, they often lack coherence and emotional depth, leading to mixed user perceptions. We discuss design implications for integrating generative AI into writing workflows and propose future directions for more empathetic and context-aware AI writing assistants.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
