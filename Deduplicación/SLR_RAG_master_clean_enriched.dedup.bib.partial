@inproceedings{aung_demand_2025,
 abstract = {Large language models (LLMs) have revolutionized code generation, but their integration into real-world software development workflows remains challenging due to issues like hallucination, lack of context awareness, and integration with existing tools. This paper evaluates the utility of LLM-driven code suggestions in practical scenarios through a controlled user study involving 30 professional developers. Participants completed coding tasks with and without LLM assistance, using tools like GitHub Copilot. Results show a 25% reduction in development time and improved code correctness, but highlight persistent problems such as over-reliance on suggestions leading to security vulnerabilities. We discuss implications for tool design, including hybrid human-AI systems, and propose mitigation strategies for LLM limitations in production environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
