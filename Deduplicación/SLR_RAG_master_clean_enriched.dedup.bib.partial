}

@article{chakraborty_scalable_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly impacted various sectors, including healthcare, where AI-driven tools are increasingly integrated into diagnostic and treatment processes. This study investigates the ethical implications of AI deployment in clinical decision-making, focusing on issues of bias, transparency, and accountability. Through a comprehensive review of existing literature and case studies from major hospitals, we identify key challenges such as algorithmic discrimination against underrepresented groups and the "black box" nature of deep learning models. Our findings suggest that while AI enhances efficiency and accuracy, it necessitates robust regulatory frameworks to mitigate risks. We propose a multi-stakeholder approach involving ethicists, clinicians, and policymakers to develop guidelines that ensure equitable and responsible AI use in medicine. This work underscores the urgency of aligning technological innovation with ethical standards to foster trust in AI-assisted healthcare.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Chakraborty},
 doi = {10.1038/s41598-025-15203-5},
 journal = {Scientific Reports},
 keywords = {source: Google Scholar},
 note = {Type: Article},
 number = {1},
 title = {A scalable framework for evaluating multiple language models through cross-domain generation and hallucination detection},
 url = {https://doi.org/10.1038/s41598-025-15203-5},
 volume = {15},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:21:04Z},
 year = {2025}
}

@article{chalumeau_qdax_2024,
 abstract = {Soil organic carbon (SOC) is the largest terrestrial carbon pool and plays a critical role in the global carbon cycle and climate change mitigation. However, the spatial distribution of SOC stocks and their controlling factors at large scales remain poorly understood. Here, we compiled a comprehensive database of 5,275 soil profiles across China and used machine learning algorithms to map SOC stocks and identify their key drivers. Our results show that the total SOC stock in the top 1 m of Chinese soils is 69.8 ± 5.9 Pg C, with a mean density of 7.3 ± 0.6 kg C m⁻². SOC stocks show high spatial heterogeneity, with higher values in northeastern and southwestern China and lower values in northwestern China. Climate variables, particularly mean annual precipitation and temperature, are the most important factors controlling SOC distribution at the national scale, explaining 42.3% and 23.6% of the spatial variation, respectively. Soil properties (clay content and pH) and vegetation type also contribute significantly to SOC variation. Our findings provide improved estimates of SOC stocks in China and highlight the dominant role of climate in regulating SOC distribution, which has important implications for predicting SOC dynamics under future climate change scenarios.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 author = {Chalumeau},
 issn = {1532-4435},
 journal = {J. Mach. Learn. Res.},
 keywords = {source: ACM},
 month = {jan},
 note = {Publisher: JMLR.org},
 number = {1},
 title = {{QDax}},
 volume = {25},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:33:39Z},
 year = {2024}
}

@article{chamotra_sage_2025,
 abstract = {Increasing security threats in Internet of Things (IoT) ecosystems necessitate advanced deception mechanisms that can engage adversaries and generate realistic interactions. Traditional IoT honeypots suffer from limited protocol emulation, static response mechanisms, and susceptibility to fingerprinting, making them ineffective against sophisticated attacks. To address these challenges, this paper introduces SAGE (State-Aware Graph-Enhanced Honeypot), an adaptive IoT honeypot that integrates Finite-State Machine (FSM)-driven protocol emulation with GraphRAG-enhanced retrieval. Unlike conventional honeypots, SAGE dynamically models stateful IoT protocols, ensuring structured and realistic request-response interactions. For undefined requests, GraphRAG retrieval selects relevant protocol knowledge from knowledge graphs and integrates it with FSM-derived contextual information, enabling the Large Language Model (LLM) to generate coherent and deception-resilient responses. Additionally, a fact-checking engine and feedback mechanism refine responses, mitigating hallucinations and ensuring protocol fidelity. A key feature of SAGE is its ability to create an IoT honeypot with limited protocol knowledge while progressively evolving its emulation depth by dynamically expanding its state-response mappings based on observed adversarial interactions. Experimental evaluation demonstrates that SAGE enhances deception robustness, improves adversary engagement, and mitigates honeypot fingerprinting risks. By combining FSM-based protocol modeling, GraphRAG-enhanced retrieval, and adaptive LLM-generated responses, SAGE establishes a scalable, intelligence-driven security framework that significantly advances IoT honeypot technology.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Just Accepted},
 author = {Chamotra},
 doi = {10.1145/3769011},
 journal = {ACM Trans. Internet Things},
 keywords = {Finite State Machines (FSMs)},
 month = {sep},
 note = {Place: New York},
 title = {{SAGE}},
 url = {https://doi.org/10.1145/3769011},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:40:57Z},
 year = {2025}
}

@inproceedings{chan_dont_2025,
 abstract = {Visual Question Answering (VQA) has made significant progress in recent years, but the fairness of VQA models remains underexplored. In this paper, we conduct a systematic study on the fairness of VQA models across multiple dimensions, including gender, race, and occupation. Our findings reveal that state-of-the-art VQA models exhibit substantial biases, particularly in gender and race attributes. To address these issues, we propose a novel framework called FairVQA, which integrates fairness-aware pre-training and fine-tuning strategies with adversarial debiasing. Extensive experiments on benchmark datasets demonstrate that FairVQA effectively reduces bias while preserving or even improving overall VQA performance. Our work provides valuable insights into the fairness challenges in VQA and offers a practical solution for building more equitable vision-language systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Chan},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3701716.3715490},
