 title = {Rag-thief: {Scalable}},
 url = {https://arxiv.org/abs/2411.14110},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:56:00Z},
 year = {2024}
}

@article{jiang_rago_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating code, but they often produce incorrect or inefficient code, especially for complex tasks. To address this, we propose Echo, a reflective LLM agent that iteratively refines its own code generation through self-reflection and feedback. Echo consists of three key components: a generator that produces initial code, a reflector that evaluates and critiques the generated code, and an executor that tests the code and provides feedback. By leveraging the LLM's ability to self-critique and revise, Echo achieves significant improvements in code correctness and efficiency. Our experiments on benchmarks such as HumanEval and MBPP demonstrate that Echo outperforms state-of-the-art baselines, generating correct code in up to 20% more cases while reducing execution time by 15%. Echo's modular design also allows for easy integration with existing LLM pipelines, making it a practical solution for enhancing code generation reliability.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
