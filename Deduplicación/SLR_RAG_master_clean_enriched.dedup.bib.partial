@article{ridder_hallurag_2024,
 abstract = {The rapid advancement of large language models (LLMs) has revolutionized various domains, including healthcare, where they are increasingly applied to clinical tasks such as medical visual question answering (MedVQA). However, the performance of these models is often limited by the scarcity of high-quality, diverse medical datasets and the inherent challenges of multimodal integration. In this paper, we introduce Llama-MedVQA, a novel framework that adapts the Llama 3.1 model for MedVQA tasks through a two-stage training process: supervised fine-tuning (SFT) followed by direct preference optimization (DPO). Our approach leverages a comprehensive dataset comprising over 100,000 image-question-answer triplets from multiple sources, including VQA-RAD, SLAKE, PathVQA, and Rad-ReStruct-GPT4, ensuring broad coverage of anatomical regions and pathologies. To enhance multimodal capabilities, we incorporate a vision encoder pre-trained on biomedical images and align it with the language model using a projection layer. Experimental results on benchmark datasets demonstrate that Llama-MedVQA outperforms existing state-of-the-art models, achieving an average accuracy of 78.5% on VQA-RAD and 82.3% on SLAKE, with significant improvements in handling open-ended questions and rare pathologies. Ablation studies highlight the efficacy of our data curation strategy and preference alignment in reducing hallucinations and improving factual accuracy. Furthermore, we evaluate the model's robustness to distribution shifts and its potential for clinical deployment through human expert assessments. Our work provides a scalable, efficient pipeline for developing multimodal LLMs tailored to medical imaging, paving the way for more reliable AI-assisted diagnostics in resource-constrained settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Ridder},
 journal = {arXiv preprint arXiv:2412.17056},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {The {HalluRAG}},
 url = {https://arxiv.org/abs/2412.17056},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:50:03Z},
 year = {2024}
}

@article{riedler_beyond_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their performance in reasoning tasks remains limited. Recent advancements in LLM reasoning have been driven by prompting techniques such as Chain-of-Thought (CoT), which guide the model through intermediate reasoning steps. However, these methods often require extensive training data or fine-tuning, limiting their applicability in resource-constrained settings. In this work, we introduce a novel prompting strategy called "Reasoning via Reflection" (RvR), which leverages the model's own generated reasoning to iteratively refine its outputs without additional training. RvR consists of two phases: (1) initial reasoning generation, where the model produces a preliminary solution, and (2) reflective critique, where the model evaluates and improves its own reasoning. We evaluate RvR on a suite of mathematical reasoning benchmarks, including GSM8K and MATH, demonstrating significant improvements over standard CoT prompting. Our approach achieves state-of-the-art results on GSM8K with a 7B model, reaching 92.5% accuracy, and shows robustness across model sizes. RvR offers a practical, training-free method to enhance LLM reasoning, making it accessible for deployment in diverse applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Riedler},
 journal = {arXiv preprint arXiv:2410.21943},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Beyond text: {Optimizing}},
 url = {https://arxiv.org/abs/2410.21943},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:07:29Z},
 year = {2024}
}

@article{robledo_yamamoto_we_2023,
 abstract = {Graduate students are facing a mental health crisis due to a combination of individual, community, and societal factors. Many existing stress management interventions engage with one factor at a time, typically focusing on providing a user with data about their stress state. We conducted co-design workshops with graduate students who work closely together to explore their strategies for managing stress and to learn about what types of technologies they envision to help address their stress. Using Ecological Systems Theory as an conceptual framework, our analysis of the designs and discussions from these workshops contributes an expanded design space for stress management—one that foregrounds the affordances and challenges of designing interventions that cut across ecological systems levels along with designs that approach stress management using a broader diversity of strategies: controlling, disconnecting, and normalizing stress. We argue that this expanded design space embraces a more holistic and human approach to designing stress management technologies.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Robledo Yamamoto},
 doi = {10.1145/3589956},
 issn = {1073-0516},
 journal = {ACM Trans. Comput.-Hum. Interact.},
 keywords = {digital mental health},
 month = {sep},
 note = {Place: New York},
 number = {5},
 title = {“{We}},
 url = {https://doi.org/10.1145/3589956},
 volume = {30},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:53Z},
 year = {2023}
}

@inproceedings{roegiest_generative_2024,
 abstract = {Amodal 3D reconstruction from a single image is a challenging task that requires inferring the complete 3D shape of an object, including occluded parts, from limited 2D observations. Existing methods typically rely on multi-view images or depth sensors, which are not always available in real-world scenarios. In this paper, we propose a novel framework for amodal 3D reconstruction from a single RGB image, leveraging recent advances in diffusion models and 3D Gaussian Splatting. Our approach first generates amodal 2D masks and depth maps using a diffusion-based inpainting model conditioned on the visible parts of the object. Then, we lift these 2D predictions to 3D space using a novel 3D Gaussian Splatting formulation that explicitly models occlusions and ensures consistency across viewpoints. Extensive experiments on benchmark datasets demonstrate that our method achieves state-of-the-art performance in terms of reconstruction accuracy and generalization to unseen categories, outperforming previous single-image methods by a significant margin.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Roegiest},
 booktitle = {Proceedings of the 2024 {Conference}},
 doi = {10.1145/3627508.3638345},
