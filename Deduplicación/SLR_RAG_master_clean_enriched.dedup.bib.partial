 journal = {arXiv preprint arXiv:2508.14064},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {An automatic patent literature retrieval system based on {LLM}},
 url = {https://arxiv.org/abs/2508.14064},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:24:24Z},
 year = {2025}
}

@article{ding_citations_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their outputs can sometimes be unreliable or biased. To address this, we propose a novel framework that leverages LLMs as judges to evaluate and improve the performance of other LLMs. Our approach involves a multi-agent system where multiple LLM-based agents collaborate to assess the quality of generated responses. Specifically, we design a chain-of-thought prompting strategy that enables agents to reason step-by-step about the correctness, coherence, and relevance of outputs. By aggregating judgments from these agents, we create a robust evaluation metric that outperforms traditional benchmarks. Experimental results on diverse tasks, including question answering and summarization, demonstrate that our framework not only provides more accurate assessments but also guides fine-tuning to enhance LLM reliability. This work paves the way for scalable, self-improving AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
