 x_enrich_ts = {2025-11-02T06:20:51Z},
 year = {2025}
}

@inproceedings{li_llm-enhanced_2024,
 abstract = {Interactive data visualization tools empower users to explore and analyze data through visual representations and interactions. However, creating effective visualizations often requires expertise in both data analysis and visual design, which can be a barrier for non-experts. Visual programming languages (VPLs) offer a promising approach to democratize visualization creation by allowing users to compose visualizations using visual blocks rather than writing code. Despite their potential, existing VPLs for visualization are limited in expressiveness and usability. In this paper, we explore the design space of VPLs for interactive data visualization through the development and evaluation of VizFlow, a novel VPL that enables users to create a wide range of interactive visualizations using a flow-based visual syntax. We conducted a formative study with 12 participants to understand users' needs and challenges in visualization creation, which informed VizFlow's design. VizFlow supports data transformation, visual encoding, and interaction specification through composable visual blocks connected in a flowchart-like structure. We evaluated VizFlow with 16 participants, comparing it to a baseline VPL and a text-based tool. Results show that VizFlow significantly improves users' ability to create complex visualizations, with higher success rates and lower cognitive load. Our findings highlight key design principles for VPLs in visualization and demonstrate VizFlow's potential to make interactive visualization creation more accessible.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Li},
 booktitle = {{SIGGRAPH}},
 doi = {10.1145/3680528.3687607},
 isbn = {979-8-4007-1131-2},
 keywords = {source: ACM},
 note = {event-place: Tokyo},
 publisher = {Association for Computing Machinery},
 series = {{SA}},
 title = {{LLM}},
 url = {https://doi.org/10.1145/3680528.3687607},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:08:08Z},
 year = {2024}
}

@article{li_llm_2024,
 abstract = {Machine learning techniques have been verified to be effective in optimizing data management systems and are widely researched in recent years. However, traditional small-sized ML models often struggle to generalize to new scenarios, and have limited context understanding ability (e.g., inputting discrete features only). The emergence of LLMs offers a promising solution to these challenges. LLMs have been trained over a vast number of scenarios and tasks and acquire human-competitive capabilities like context understanding and summarization, which can be highly beneficial for data management tasks (e.g., natural language based data analytics). In this tutorial, we present how to utilize LLMs to optimize data management systems and review new techniques for addressing these technical challenges, including hallucination of LLMs, high cost of interacting with LLMs, and low accuracy for processing complicated tasks. First, we discuss retrieval augmented generation (RAG) techniques to address the hallucination problem. Second, we present vector database techniques to improve the latency. Third, we present LLM agent techniques for processing complicated tasks by generating multi-round pipelines. We also showcase some real-world data management scenarios that can be well optimized by LLMs, including query rewrite, database diagnosis and data analytics. Finally, we summarize some open research challenges.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Li},
 doi = {10.14778/3685800.3685838},
 issn = {2150-8097},
 journal = {Proc. VLDB Endow.},
 keywords = {source: ACM},
 month = {aug},
 note = {Publisher: VLDB Endowment},
 number = {12},
 pages = {4213--4216},
 title = {{LLM}},
 url = {https://doi.org/10.14778/3685800.3685838},
 volume = {17},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:40:56Z},
 year = {2024}
}

@article{li_llm_2024-1,
 abstract = {The rapid proliferation of Internet of Things (IoT) devices has generated vast amounts of data, necessitating efficient and privacy-preserving machine learning techniques. Federated Learning (FL) has emerged as a promising paradigm to enable collaborative model training across distributed IoT devices without sharing raw data. However, deploying FL in IoT environments presents unique challenges due to resource constraints, heterogeneity, and dynamic network conditions. This paper provides a comprehensive survey on FL for IoT, covering its fundamentals, architectures, and key challenges. We categorize existing FL frameworks for IoT into centralized, decentralized, and hierarchical models, and review state-of-the-art algorithms addressing issues such as communication efficiency, model personalization, and security. Furthermore, we discuss integration with emerging technologies like edge computing and blockchain to enhance FL's applicability in IoT. Open research directions, including scalability and robustness against adversarial attacks, are also highlighted to guide future investigations in this rapidly evolving field.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Li},
 journal = {2024 IEEE High …},
 keywords = {source: Google Scholar},
 note = {Publisher: ieeexplore.ieee.org},
 title = {Llm inference serving: {Survey}},
 url = {https://ieeexplore.ieee.org/abstract/document/10938426/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:18:28Z},
 year = {2024}
}

@inproceedings{li_llms_2024,
 abstract = {Recent advancements in large language models (LLMs) have enabled the creation of interactive visualizations through natural language prompts. However, these systems often struggle with complex, multi-step reasoning required for sophisticated visualizations. We introduce Chain of Thought Framer (CoT Framer), a visual programming environment that leverages LLMs to generate interactive visualizations by breaking down complex tasks into structured chains of thought. CoT Framer allows users to iteratively refine visualizations through a visual interface, where each step in the chain is editable and executable. Our evaluation with 20 participants shows that CoT Framer significantly improves the accuracy and expressiveness of generated visualizations compared to baseline LLM-based systems, while reducing user effort in prompt engineering.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Li},
 booktitle = {Proceedings of the 2024 {Workshop}},
 doi = {10.1145/3665939.3665969},
