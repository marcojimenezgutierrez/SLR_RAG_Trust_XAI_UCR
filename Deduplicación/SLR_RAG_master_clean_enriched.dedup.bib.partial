@inproceedings{moutaoukkil_queries_2025,
 abstract = {This paper proposes a novel approach for enhancing the security of Internet of Things (IoT) devices using blockchain technology integrated with machine learning algorithms. The proposed system aims to address the vulnerabilities in traditional IoT networks by providing a decentralized authentication mechanism and anomaly detection capabilities. The blockchain ensures tamper-proof data storage and secure communication between devices, while machine learning models, specifically Long Short-Term Memory (LSTM) networks, are employed to predict and detect potential cyber threats in real-time. Experimental results demonstrate that the proposed framework achieves a detection accuracy of 98.5% with reduced latency compared to existing methods, making it suitable for resource-constrained IoT environments.},
