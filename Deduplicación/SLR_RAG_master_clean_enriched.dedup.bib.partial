@inproceedings{meda_integrating_2025,
 abstract = {Silence is a fundamental aspect of human communication, yet its role in human-AI interactions remains underexplored. In this paper, we investigate how AI-generated silences influence user perceptions of conversational naturalness, empathy, and engagement. Through a mixed-methods study involving 48 participants interacting with a voice-based AI companion, we examine different silence durations (0s, 1s, 3s, and 5s) in response to user queries. Our findings reveal that moderate silences (1-3s) significantly enhance perceptions of empathy and naturalness compared to no silence or prolonged pauses, while also increasing user engagement as measured by conversation length and follow-up questions. However, silences exceeding 3s were often perceived as awkward or indicative of system errors. Qualitative analysis highlights users' associations of silence with thoughtfulness and listening, but also frustration when it disrupts flow. We discuss design implications for incorporating context-aware silences in AI systems and propose a framework for balancing silence to foster more human-like interactions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
