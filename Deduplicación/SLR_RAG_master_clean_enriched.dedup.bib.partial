 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:21:30Z},
 year = {2025}
}

@inproceedings{fan_lessonplanner_2024,
 abstract = {Visual fairness in recognition tasks has become increasingly important as AI systems are deployed in real-world applications. However, achieving fairness is challenging due to the complex interplay between data biases, model architectures, and evaluation metrics. In this paper, we conduct a comprehensive study on fairness in visual recognition, focusing on effective strategies for bias mitigation and evaluation. We first analyze common sources of bias in visual datasets and models, including demographic disparities and intersectional effects. To mitigate these biases, we explore a range of techniques, such as data augmentation, adversarial training, and fairness-aware loss functions, evaluating their impact on both accuracy and fairness across multiple benchmarks. Our experiments reveal that while individual methods can reduce bias, combining them in a multi-stage pipeline yields the most robust results. Additionally, we introduce a novel evaluation framework that incorporates intersectional fairness metrics and real-world deployment considerations. Our findings provide practical guidelines for developing fairer visual recognition systems and highlight open challenges for future research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Fan},
 booktitle = {Proceedings of the 37th {Annual}},
 doi = {10.1145/3654777.3676390},
 isbn = {979-8-4007-0628-8},
 keywords = {Large language models},
 lessonplanner can significantly improve the quality of outcome lesson plans and ease users’ workload in the preparation process. our expert interviews (n = {6) further demonstrate LessonPlanner ’s usefulness in suggesting effective teaching strategies and meaningful educational resources. We discuss concerns on and design considerations for supporting teaching activities with LLMs.}},
 note = {event-place: Pittsburgh},
 publisher = {Association for Computing Machinery},
 series = {{UIST}},
 title = {{LessonPlanner}},
 url = {https://doi.org/10.1145/3654777.3676390},
