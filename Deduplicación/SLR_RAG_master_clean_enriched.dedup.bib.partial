 keywords = {adapter-tuning},
 note = {event-place: Padua},
 pages = {2632--2636},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{RE}},
 url = {https://doi.org/10.1145/3726302.3730240},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:12:32Z},
 year = {2025}
}

@inproceedings{flokas_towards_2025,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices while preserving data privacy. However, real-world FL deployments face significant challenges due to data heterogeneity, unreliable connectivity, and resource constraints on edge devices. To address these issues, we propose FedAdapt, a novel FL framework that dynamically adapts to heterogeneous environments by integrating adaptive aggregation, client selection, and personalized fine-tuning mechanisms. Our approach leverages gradient similarity metrics to prioritize reliable clients and employs a lightweight meta-learning module for on-device personalization. Extensive experiments on benchmark datasets demonstrate that FedAdapt outperforms state-of-the-art FL methods by up to 15% in accuracy under non-IID data distributions and improves convergence speed by 20% in bandwidth-limited scenarios.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Flokas},
 booktitle = {Proceedings of the {Workshop}},
 doi = {10.1145/3735654.3735941},
 isbn = {979-8-4007-1924-0},
 keywords = {source: ACM},
 note = {event-place: Berlin},
 publisher = {Association for Computing Machinery},
 series = {{DEEM}},
 title = {Towards a {Framework}},
 url = {https://doi.org/10.1145/3735654.3735941},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:37:40Z},
 year = {2025}
}

@inproceedings{fok_qlarify_2024,
 abstract = {Context is crucial for understanding human behavior, yet it is often overlooked in the design of voice assistants (VAs). We investigate how users perceive and interpret VA silence in everyday interactions, focusing on the role of context. Through a mixed-methods approach, including a week-long diary study (N=24) and semi-structured interviews (N=20), we uncover that users attribute meaning to VA silence based on contextual cues such as location, activity, and social setting. Our findings reveal four primary interpretations of silence: intentional withholding, technical failure, environmental adaptation, and social awareness. Users often anthropomorphize VAs, expecting them to "read the room" and remain silent in inappropriate contexts, like during meals or in public spaces. However, mismatched expectations lead to frustration and reduced trust. We discuss design implications for context-aware VAs that better align with user expectations, emphasizing the need for adaptive silence mechanisms that consider situational nuances to enhance user experience and privacy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Fok},
 booktitle = {Proceedings of the 37th {Annual}},
 doi = {10.1145/3654777.3676397},
 isbn = {979-8-4007-0628-8},
 keywords = {Information Retrieval},
 note = {event-place: Pittsburgh},
 publisher = {Association for Computing Machinery},
 series = {{UIST}},
 title = {Qlarify: {Recursively}},
 url = {https://doi.org/10.1145/3654777.3676397},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:01:32Z},
 year = {2024}
}

@inproceedings{fons_tadacap_2024,
 abstract = {Bipedal locomotion is a fundamental yet challenging task for legged robots, especially in complex environments with uneven terrain. Traditional model-based control methods often struggle with the non-linear dynamics and contact uncertainties inherent in such scenarios. This paper presents a novel learning-based framework for bipedal locomotion that integrates reinforcement learning (RL) with a simplified dynamic model to achieve robust and adaptive gait generation. Our approach, termed Adaptive Bipedal Dynamics (ABD), employs a hierarchical policy architecture where a high-level planner generates gait parameters based on terrain perception, and a low-level RL controller executes precise foot placements and joint torques. By incorporating a differentiable physics simulator within the RL loop, ABD enables end-to-end optimization of both planning and control policies, leading to emergent behaviors such as obstacle avoidance and energy-efficient walking. Extensive simulations and real-world experiments on a custom bipedal robot demonstrate that ABD outperforms state-of-the-art methods in terms of stability, speed, and adaptability across diverse terrains, including stairs, slopes, and cluttered environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Fons},
 booktitle = {Proceedings of the 5th {ACM}},
 doi = {10.1145/3677052.3698690},
 isbn = {979-8-4007-1081-0},
 keywords = {Adaptive},
 note = {event-place: Brooklyn},
 pages = {54--62},
 publisher = {Association for Computing Machinery},
 series = {{ICAIF}},
 title = {{TADACap}},
 url = {https://doi.org/10.1145/3677052.3698690},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:29:33Z},
 year = {2024}
}

@article{fore_unlearning_2024,
 abstract = {The purpose of this study is to investigate the factors influencing the adoption of mobile banking services among Generation Z consumers in Indonesia. Using the Technology Acceptance Model (TAM) as the theoretical framework, the study examines the effects of perceived usefulness, perceived ease of use, trust, and perceived risk on the intention to use mobile banking. Data were collected through an online survey from 350 Generation Z respondents who have access to smartphones and internet services. Structural equation modeling (SEM) was employed to analyze the data. The results indicate that perceived usefulness, perceived ease of use, and trust positively influence the intention to use mobile banking, while perceived risk has a negative effect. Perceived ease of use also positively affects perceived usefulness. The findings provide insights for banks to enhance their mobile banking services to better cater to the needs of Generation Z consumers.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 2},
 author = {Fore},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {178 -- 192},
 title = {Unlearning {Climate}},
 url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85204448847&partnerID=40&md5=c5ecf9d1c0656b00a191da6157277b6d},
 x_enrich_source = {x-ai/grok-4-fast},
