 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:18:00Z},
 year = {2024}
}

@article{park_system_2025,
 abstract = {The rapid growth of the Internet of Things (IoT) has led to the generation of massive amounts of data, which poses significant challenges for storage, processing, and analysis. Traditional cloud computing paradigms face limitations in handling this data due to latency, bandwidth, and privacy concerns. Fog computing emerges as a promising solution by extending cloud services to the network edge, enabling real-time processing and reduced latency. This chapter provides an overview of fog computing architectures, key enabling technologies, and applications in IoT scenarios. We discuss challenges such as resource management, security, and interoperability, and highlight future research directions to enhance the efficiency and scalability of fog-based IoT systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
