 year = {2025}
}

@article{gan_retrieval_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their performance on complex reasoning tasks remains inconsistent. This paper introduces a novel framework for enhancing LLM reasoning through dynamic prompt engineering and iterative self-refinement. We propose a multi-stage process where the model generates initial responses, evaluates them against predefined criteria, and refines outputs in subsequent iterations. Experiments on benchmarks such as GSM8K and CommonsenseQA demonstrate significant improvements, with accuracy gains of up to 15% over baseline methods. Our approach leverages the model's own capabilities for self-assessment, reducing reliance on external annotations and enabling scalable deployment in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Gan},
