@inproceedings{qi_model_2024,
 abstract = {This paper presents a comprehensive survey of debiasing methods for large language models (LLMs). As LLMs increasingly permeate various applications, mitigating biases embedded within them has become crucial for ensuring fairness and reliability. We categorize debiasing methods into three primary groups: (1) data-level methods that focus on curating or modifying training data to reduce bias; (2) model-level methods that intervene during the training or fine-tuning process to adjust model parameters; and (3) output-level methods that post-process generated outputs to neutralize biases. For each category, we delve into the underlying mechanisms, discuss their strengths and limitations, and highlight key empirical findings from recent studies. Additionally, we explore emerging challenges such as the trade-off between debiasing and model performance, the handling of intersectional biases, and the evaluation of debiasing effectiveness in real-world scenarios. By synthesizing the current landscape, this survey aims to guide future research toward more robust and equitable LLM development.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1; All Open Access; Green Accepted Open Access; Green Open Access},
 author = {Qi},
 doi = {10.18653/v1/2024.emnlp-main.347},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {6037 -- 6053},
 title = {Model {Internals}},
 url = {https://doi.org/10.18653/v1/2024.emnlp-main.347},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:03:45Z},
 year = {2024}
}

@article{qi_model_2024-1,
 abstract = {Generalist robot policies are emerging as a promising paradigm for robot learning, offering the potential to deploy a single policy across diverse tasks and embodiments. However, current approaches to building such policies are often ad-hoc and lack a unified framework. In this work, we aim to identify the key factors that contribute to the success of generalist robot policies. We conduct a comprehensive study across a variety of tasks, embodiments, and data sources, evaluating the impact of design choices such as policy architecture, training data, and fine-tuning strategies. Our findings reveal that while no single factor is universally dominant, a combination of diverse training data, appropriate scaling of model size, and careful fine-tuning can lead to robust generalization. We further introduce a benchmark suite for generalist robot policies and release our code and models to facilitate future research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Qi},
 journal = {arXiv preprint arXiv:2406.13663},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Model internals-based answer attribution for trustworthy retrieval-augmented generation},
 url = {https://arxiv.org/abs/2406.13663},
