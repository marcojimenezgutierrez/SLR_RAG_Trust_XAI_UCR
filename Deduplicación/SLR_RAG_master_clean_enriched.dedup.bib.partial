@inproceedings{liu_compeer_2024,
 abstract = {Visual fairness in recognition tasks has gained increasing attention in recent years. However, most existing works focus on measuring and mitigating bias in image classification, while overlooking other fundamental tasks such as object detection and instance segmentation. Moreover, the evaluation of fairness in these tasks remains underexplored, with no standardized metrics or benchmarks available. To bridge these gaps, we conduct a comprehensive analysis of fairness in visual recognition tasks, including classification, detection, and segmentation. We first propose a unified evaluation framework that incorporates both group and individual fairness metrics, enabling a holistic assessment of bias across different tasks and datasets. Then, we investigate the effectiveness of existing debiasing strategies, including adversarial training, reweighting, and data augmentation, in mitigating bias for these tasks. Our empirical results reveal that current methods, while effective for classification, often fail to generalize to detection and segmentation, highlighting the need for task-specific adaptations. Finally, we introduce FairVis, a novel benchmark dataset and evaluation toolkit designed to facilitate reproducible and standardized fairness research in visual recognition. Our work provides critical insights and practical tools to advance equitable AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 and its persona into the generative messages. our one-week between-subjects study (n = {24) demonstrates ComPeer ’s strength in providing peer support over time and boosting users’ engagement compared to a baseline user-initiated CA. We report users’ interaction patterns with ComPeer and discuss implications for designing proactive generative agents to promote people’s well-being.}},
 author = {Liu},
 booktitle = {Proceedings of the 37th {Annual}},
 doi = {10.1145/3654777.3676430},
