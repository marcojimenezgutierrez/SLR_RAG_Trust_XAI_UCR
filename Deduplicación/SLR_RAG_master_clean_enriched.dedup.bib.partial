}

@inproceedings{mahapatra_-storage_2025,
 abstract = {We present Haptics4All, a framework for designing inclusive haptic experiences for people with upper limb differences (PULD). Through a series of workshops with 12 PULD participants, we identified key design considerations, including modularity, adaptability, and social acceptability. Our framework emphasizes co-design principles to ensure haptic wearables are accessible and empowering. We developed prototypes demonstrating these principles, such as a modular armband that allows customization based on individual limb configurations. Findings highlight the importance of involving PULD in the design process to address overlooked needs, like fatigue reduction and intuitive controls. This work contributes to more equitable haptic technology, with implications for broader accessibility in interactive systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
