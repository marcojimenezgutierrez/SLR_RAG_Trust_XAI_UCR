}

@inproceedings{pan_acknowledge_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but they also exhibit biases that can lead to unfair outcomes in downstream applications. Existing debiasing methods for LLMs often require additional training data or fine-tuning, which can be computationally expensive and may not generalize well across tasks. In this paper, we propose a novel approach to mitigate bias in LLMs by leveraging knowledge distillation from a fairness-aware teacher model. Our method, FairDistil, distills the fairness properties of a large, bias-mitigated teacher model into a smaller, more efficient student model without requiring task-specific fine-tuning. We evaluate FairDistil on multiple bias benchmarks, including gender and racial stereotypes in text generation, and demonstrate that it achieves comparable performance to state-of-the-art debiasing techniques while reducing inference time by up to 50%. Our results highlight the potential of knowledge distillation as a scalable solution for fair LLM deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Pan},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713791},
 isbn = {979-8-4007-1394-1},
 keywords = {Affordance-based Interaction Planning},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {{ACKnowledge}},
 url = {https://doi.org/10.1145/3706598.3713791},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:14:02Z},
 year = {2025}
}

@inproceedings{pan_not_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their deployment in real-world applications raises concerns about potential social harms. This paper presents a comprehensive survey of methods for evaluating the social impact of LLMs, focusing on aspects such as bias, fairness, toxicity, and misinformation. We categorize evaluation approaches into intrinsic (model-inherent) and extrinsic (application-specific) methods, discussing datasets, metrics, and benchmarks used in each. Additionally, we highlight challenges in current evaluation practices, including the lack of standardized benchmarks and the subjectivity of human judgments. Finally, we propose directions for future research to develop more robust and holistic evaluation frameworks that align LLMs with societal values.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
