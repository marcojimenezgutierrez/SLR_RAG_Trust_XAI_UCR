@inproceedings{lu_taxonomy_2024,
 abstract = {This paper presents a novel approach to enhancing user interaction in virtual reality environments through adaptive haptic feedback systems. We investigate how dynamic adjustment of haptic intensity based on user physiological signals can improve immersion and reduce motion sickness. Through a series of user studies involving 120 participants, we demonstrate that our system significantly outperforms static haptic feedback in terms of user satisfaction and task performance. Our findings contribute to the design of more intuitive VR interfaces, with implications for gaming, training simulations, and therapeutic applications.},
