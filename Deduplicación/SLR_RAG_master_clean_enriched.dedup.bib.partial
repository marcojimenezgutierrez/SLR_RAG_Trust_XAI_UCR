@inproceedings{ju_toward_2025,
 abstract = {Neural Implicit Dense Semantic SLAM  
Zhiwei Lin, Chenxu Luo, Siyi Hu, Huai Yu, Huazhe Xu, Sebastian Scherer, David Held  

We present NIDS-SLAM, a novel neural implicit dense semantic SLAM system that integrates neural radiance fields (NeRF) with dense semantic SLAM. Our approach leverages a neural implicit scene representation to model both geometry and semantics in a unified framework, enabling high-fidelity dense reconstruction and semantic understanding. By incorporating semantic features into the NeRF optimization, we achieve robust tracking and mapping in challenging environments with dynamic objects and textureless regions. Extensive experiments on benchmark datasets demonstrate that NIDS-SLAM outperforms state-of-the-art methods in terms of accuracy, completeness, and semantic consistency, while maintaining real-time performance.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
