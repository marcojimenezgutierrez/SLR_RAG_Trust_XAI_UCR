@inproceedings{jiang_food_2025,
 abstract = {Abstract—This paper addresses the problem of distributed optimization over time-varying networks with adversarial disturbances. We propose a novel primal-dual algorithm that achieves sublinear regret bounds under mild assumptions on the network topology and disturbance magnitude. The algorithm incorporates adaptive step-sizes and gradient tracking mechanisms to handle the dynamic communication graph. Theoretical analysis establishes O(√T) regret for convex objectives, with extensions to strongly convex cases yielding logarithmic rates. Numerical simulations on multi-agent coordination tasks validate the robustness and efficiency of the approach compared to existing methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
