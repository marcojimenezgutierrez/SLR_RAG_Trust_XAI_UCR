}

@inproceedings{tevissen_towards_2024,
 abstract = {The rapid advancement of artificial intelligence (AI) and machine learning (ML) has significantly impacted various sectors, including healthcare. In healthcare, AI-driven systems are increasingly being integrated to enhance diagnostic accuracy, personalize treatment plans, and streamline administrative processes. However, the integration of AI in healthcare also raises critical ethical concerns, particularly regarding data privacy, algorithmic bias, and accountability. This paper explores the ethical implications of AI in healthcare, focusing on the balance between technological innovation and patient rights. Through a comprehensive review of existing literature and case studies, we identify key ethical challenges and propose a framework for ethical AI deployment in healthcare settings. Our findings underscore the need for robust regulatory frameworks, interdisciplinary collaboration, and continuous ethical oversight to ensure that AI technologies serve the best interests of patients while mitigating potential harms.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Tevissen},
 booktitle = {2024 16th {International}},
 doi = {10.1109/HSI61632.2024.10613524},
