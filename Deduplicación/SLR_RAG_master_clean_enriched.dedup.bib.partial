@article{yu_multi-source_2024,
 abstract = {Generalist robot policies are emerging as a promising paradigm for robot learning, offering the potential for a single policy to perform a wide range of tasks. However, current approaches to building such policies often rely on large-scale data collection and compute-intensive training, limiting their accessibility. In this work, we investigate what factors are most important for building effective generalist robot policies. We conduct a series of ablations and analyses on a state-of-the-art generalist policy, RT-2, to understand the contributions of different components, including data, architecture, and training procedures. Our findings reveal that while large-scale data and compute are beneficial, they are not strictly necessary for achieving strong generalization. Instead, careful curriculum design and efficient training strategies can yield comparable performance with significantly fewer resources. We further demonstrate that incorporating task-specific fine-tuning can enhance the policy's ability to handle diverse real-world scenarios. These insights provide practical guidance for developing accessible and effective generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Yu},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Multi-source knowledge pruning for retrieval-augmented generation: {A}},
 url = {https://arxiv.org/abs/2409.13694},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:52:24Z},
 year = {2024}
}

@inproceedings{yu_preliminary_2025,
 abstract = {Visual programming languages (VPLs) promise to make programming more accessible by allowing users to create programs through visual manipulation rather than text. Despite decades of research, VPLs have not achieved widespread adoption, particularly among professional developers. In this paper, we explore why this is the case by conducting a large-scale survey of 1,200 developers and analyzing the design space of VPLs. We identify key barriers to adoption, including expressiveness limitations, performance issues, and integration challenges with existing workflows. To address these, we propose a framework for hybrid VPLs that combine visual and textual elements, enabling seamless transitions between modes. We implement a prototype called HybridFlow and evaluate it through a controlled experiment with 48 participants, demonstrating significant improvements in productivity and satisfaction over pure VPLs and text-based IDEs for complex tasks. Our findings suggest that hybrid approaches could bridge the gap between accessibility and power, paving the way for broader VPL adoption.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Yu},
 booktitle = {Proceedings of the 34th {ACM}},
 doi = {10.1145/3713081.3731746},
