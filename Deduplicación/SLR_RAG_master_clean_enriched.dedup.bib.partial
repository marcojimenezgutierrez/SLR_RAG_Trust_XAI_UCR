@inproceedings{jiang_gats_2024,
 abstract = {Machine learning models for conditional image generation, such as Stable Diffusion, have shown impressive results in generating high-quality images. However, they can also produce content that does not align with the conditioning input, a phenomenon known as hallucination. In this work, we focus on detecting and mitigating hallucinations in text-to-image diffusion models. We first propose a simple yet effective method to detect hallucinations by leveraging the CLIP model to measure the alignment between the generated image and the text prompt. Our method achieves high accuracy in detecting hallucinations on various datasets. Then, we propose a novel training-free mitigation technique that uses a guidance mechanism to steer the generation process towards more faithful outputs. Our approach significantly reduces hallucinations while preserving image quality. Extensive experiments demonstrate the effectiveness of our method in both detection and mitigation of hallucinations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Jiang},
 booktitle = {Proceedings of the 47th {International}},
 doi = {10.1145/3626772.3661372},
