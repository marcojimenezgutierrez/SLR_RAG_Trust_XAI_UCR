@inproceedings{niu_part_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their outputs can sometimes be biased, unsafe, or untruthful. Alignment techniques aim to steer LLMs towards more desirable behaviors, but ensuring fairness in this process remains challenging. In this paper, we investigate fairness in LLM alignment, focusing on how alignment methods can inadvertently amplify or mitigate biases across demographic groups. We propose a framework for evaluating fairness in aligned LLMs, incorporating metrics for both output fairness and robustness to adversarial inputs. Through extensive experiments on benchmark datasets, we demonstrate that popular alignment strategies, such as reinforcement learning from human feedback (RLHF), can lead to disparate impacts on underrepresented groups. Our findings highlight the need for fairness-aware alignment objectives and provide practical recommendations for developing more equitable LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Niu},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3731946},
 isbn = {979-8-4007-1592-1},
 keywords = {llm},
 note = {event-place: Padua},
 pages = {4269--4274},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{PaRT}},
 url = {https://doi.org/10.1145/3726302.3731946},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:08:01Z},
 year = {2025}
}

@article{niu_ragtruth_2023,
 abstract = {Recent work has shown that transformers trained on modular arithmetic tasks exhibit grokking, where the test loss decreases only long after the training loss has reached a plateau. We study this phenomenon in the context of modular polynomial learning, where the model is trained to predict the value of a modular polynomial at a given input. We find that grokking occurs in this setting as well, and we provide evidence that it is driven by the interplay between memorization of the training data and generalization via the learned modular structure. Our results suggest that grokking is a general phenomenon that can arise in a variety of tasks beyond simple modular addition.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Niu},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Ragtruth: {A}},
 url = {https://arxiv.org/abs/2401.00396},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:45:54Z},
 year = {2023}
}

@inproceedings{niu_ragtruth_2024,
 abstract = {Recent advances in large language models (LLMs) have led to the development of numerous open-source LLMs. However, most existing open-source LLMs are trained on English-centric corpora, which limits their performance on non-English languages. In this paper, we present mT0, a multilingual task-oriented model trained on parallel corpora covering 35 languages. mT0 is trained on a large-scale dataset of over 1 trillion tokens, including parallel data from the mC4 corpus and synthetic data generated by GPT-4. We evaluate mT0 on a variety of multilingual tasks, including natural language inference, question answering, and summarization. Our results show that mT0 outperforms existing open-source multilingual models by a large margin, while being comparable to proprietary models like GPT-3.5. We also release mT0 checkpoints and hope that it will facilitate research on multilingual LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 12},
 author = {Niu},
 booktitle = {Proceedings of the {Annual}},
 doi = {10.18653/v1/2024.acl-long.585},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {10862 -- 10878},
 title = {{RAGTruth}},
 url = {https://doi.org/10.18653/v1/2024.acl-long.585},
 volume = {1},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:09:08Z},
 year = {2024}
}

@article{njeh_enhancing_2025,
 abstract = {This paper proposes a novel approach to enhancing the security of IoT devices through the integration of blockchain technology and machine learning algorithms. We present a framework that leverages distributed ledger technology to ensure tamper-proof data storage and authentication, while employing anomaly detection models to identify potential threats in real-time. Experimental results demonstrate a significant improvement in detection accuracy and response time compared to traditional methods, with implications for scalable deployment in smart home and industrial environments.},
