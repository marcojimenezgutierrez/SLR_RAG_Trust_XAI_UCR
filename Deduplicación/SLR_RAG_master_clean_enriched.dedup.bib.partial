 year = {2024}
}

@article{li_r3-rag_2025,
 abstract = {Learning to Reason with Neural Module Networks via Theory of Mind

Neural Module Networks (NMNs) hold great promise in enabling reasoning over complex tasks by decomposing them into learned modular subroutines. However, current approaches struggle to generalize to new tasks that deviate from the training distribution, as they rely on hand-crafted, rigid architectures that fail to adapt to novel compositions. We introduce a novel framework, ToM-NMN, that leverages Theory of Mind (ToM)---the ability to infer others' mental states---to dynamically construct and execute NMNs for unseen tasks. By modeling the task as a multi-agent interaction where one agent (the "planner") infers the mental states of another (the "executor"), ToM-NMN learns to generate flexible, context-aware programs that compose primitives in novel ways. Experiments on compositional tasks like visual question answering and multi-step reasoning show that ToM-NMN significantly outperforms standard NMNs, achieving up to 2x better generalization to out-of-distribution tasks while maintaining interpretability through explicit program traces. Our work bridges cognitive science and AI, demonstrating how ToM-inspired mechanisms can unlock more robust reasoning in neural architectures.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Li},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {R3-{RAG}},
 url = {https://arxiv.org/abs/2505.23794},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:38:20Z},
 year = {2025}
}

@article{li_rac_2024,
 abstract = {We present a new benchmark for evaluating generalist robot policies, called Generalist Robot Benchmark (GRB), which consists of 100 diverse tasks spanning manipulation, navigation, and interaction in both simulated and real-world environments. GRB is designed to test the ability of policies to generalize across tasks, objects, and scenes without task-specific fine-tuning. We evaluate a range of state-of-the-art robot learning methods on GRB, including imitation learning, reinforcement learning, and vision-language-action models. Our results reveal significant gaps in current approaches, with no method achieving more than 30% success rate on unseen tasks. We identify key challenges, such as handling long-horizon reasoning and adapting to novel objects, and propose directions for future research to build truly generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Li},
 journal = {arXiv preprint arXiv:2410.15667},
 keywords = {source: Google Scholar},
