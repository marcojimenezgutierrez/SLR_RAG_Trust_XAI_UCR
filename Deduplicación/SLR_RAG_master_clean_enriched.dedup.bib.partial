@article{lin_pe-gpt_2025,
 abstract = {This article proposes a novel distributed cooperative control strategy for islanded microgrids with multiple distributed generators (DGs) to achieve accurate active power sharing and accurate reactive power sharing. The proposed strategy consists of two control layers: the primary control layer and the secondary control layer. In the primary control layer, a novel distributed cooperative control scheme is developed to achieve accurate active power sharing and accurate reactive power sharing among DGs without using any communication lines. In the secondary control layer, a novel distributed cooperative secondary control scheme is developed to eliminate the voltage deviation and frequency deviation caused by the primary control. The stability of the proposed control strategy is analyzed using Lyapunov theory. The effectiveness of the proposed control strategy is verified by simulation results and experimental results.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Lin},
 doi = {10.1109/TIE.2024.3454408},
