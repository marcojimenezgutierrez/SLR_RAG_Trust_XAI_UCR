@inproceedings{xu_automated_2024-1,
 abstract = {Dynamic voltage and frequency scaling (DVFS) is a key technique for energy efficiency in GPUs, but traditional methods rely on heuristics that are workload-specific and require manual tuning. This paper introduces LLM4DVFS, a framework that uses large language models (LLMs) to automate DVFS policy generation for GPUs. By interpreting natural language descriptions of workloads and hardware constraints, our LLM-based approach generates adaptive DVFS schedules without domain-specific training. We evaluate LLM4DVFS on diverse GPU benchmarks, including MLPerf and Rodinia, using NVIDIA A100 GPUs. Results show up to 25% energy savings compared to state-of-the-art DVFS methods, with negligible performance overhead, demonstrating the potential of LLMs for hardware optimization tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Xu},
 booktitle = {2024 {ACM}},
 doi = {10.1109/MLCAD62225.2024.10740262},
 keywords = {Codes},
