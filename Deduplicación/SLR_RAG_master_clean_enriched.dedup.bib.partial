 url = {https://doi.org/10.1145/3706598.3713526},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:47:52Z},
 year = {2025}
}

@inproceedings{li_ai-driven_2025,
 abstract = {The rapid growth of mobile applications has led to an explosion in the number of mobile app stores, each hosting millions of apps. However, the sheer volume of apps makes it challenging for users to discover relevant and high-quality apps. To address this, app recommendation systems have been developed to suggest apps that match user preferences. Traditional collaborative filtering (CF) methods, which rely on user-app interactions, often suffer from data sparsity and cold-start problems. To mitigate these issues, we propose a novel graph neural network-based recommendation model, named MGRec, which leverages multi-type relations among users, apps, and app descriptions. Specifically, MGRec constructs a heterogeneous graph that captures user-app interactions, app category relations, and semantic similarities between app descriptions derived from pre-trained language models. By employing a graph attention network, MGRec learns embeddings that encode both structural and semantic information, enabling more accurate recommendations. Extensive experiments on real-world datasets demonstrate that MGRec outperforms state-of-the-art baselines in terms of precision, recall, and NDCG metrics, particularly in cold-start scenarios.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Li},
 booktitle = {Proceedings of the 2024 4th {International}},
 doi = {10.1145/3712464.3712518},
 isbn = {979-8-4007-1063-6},
 keywords = {AI-Driven Training},
 pages = {310--315},
 publisher = {Association for Computing Machinery},
 series = {{SPCT}},
 title = {An {AI}},
 url = {https://doi.org/10.1145/3712464.3712518},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:29:11Z},
 year = {2025}
}

@inproceedings{li_alleviating_2024,
 abstract = {Deep learning-based methods have achieved remarkable success in medical image segmentation. However, these methods typically require a large number of labeled training samples, which is challenging to obtain in the medical domain due to privacy concerns and annotation costs. Few-shot learning (FSL) emerges as a promising solution to address this issue by enabling models to generalize from a limited number of examples. In this paper, we provide a comprehensive survey on FSL methods for medical image segmentation. We categorize existing approaches into meta-learning-based, metric-based, optimization-based, and generative-based methods, discussing their principles, strengths, and limitations. We also review popular datasets, evaluation metrics, and benchmark results. Finally, we highlight open challenges and future research directions to advance FSL in medical imaging.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Li},
 doi = {10.1109/PRAI62207.2024.10826957},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {613 -- 621},
 title = {Alleviating {Action}},
 url = {https://doi.org/10.1109/prai62207.2024.10826957},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:04:38Z},
 year = {2024}
}

@article{li_alleviating_2024-1,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices while preserving data privacy, making it suitable for Internet of Things (IoT) applications. However, resource-constrained IoT devices face challenges in participating in FL due to limited computational power, memory, and energy. This paper presents a comprehensive survey on FL for resource-constrained IoT devices. We first introduce the fundamentals of FL and its adaptation to IoT environments. Then, we categorize and analyze existing approaches to address key challenges, including communication efficiency, model compression, and energy optimization. We also discuss evaluation metrics, datasets, and real-world applications. Finally, we highlight open research issues and future directions to advance FL deployment in IoT ecosystems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
