 year = {2025}
}

@inproceedings{liu_treatrag_2025,
 abstract = {Visual reinforcement learning (RL) has achieved remarkable success in solving complex control tasks from raw pixel inputs. However, the performance of visual RL agents often degrades significantly when tested in new environments due to the lack of generalization. Existing methods that aim to improve generalization typically focus on either data augmentation or domain randomization, which are limited in addressing the underlying issue of spurious correlations in visual observations. In this work, we propose a novel approach to learn causal invariant representations for visual RL agents. Our method leverages causal discovery to identify and disentangle the causal factors from spurious ones in the visual observations, and then learns invariant representations that capture the underlying causal structure. We evaluate our approach on several visual RL benchmarks, including DeepMind Control Suite and Meta-World, and demonstrate significant improvements in generalization performance compared to state-of-the-art baselines. Our results highlight the importance of causal reasoning in enabling robust visual RL agents.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Liu},
 booktitle = {Proceedings of the {Nineteenth}},
 doi = {10.1145/3705328.3748022},
