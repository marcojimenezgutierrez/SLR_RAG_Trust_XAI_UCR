@article{sirisha_analytical_2025,
 abstract = {In the era of big data, the rapid growth of data volume has brought new challenges to data storage and management. Traditional relational databases are facing bottlenecks in handling massive, unstructured, and semi-structured data. To address these issues, NoSQL databases have emerged as a promising solution due to their flexibility, scalability, and high performance. Among various NoSQL databases, graph databases stand out for their ability to efficiently store and query complex relationships between data entities. However, the performance of graph databases in handling large-scale graph data remains a critical research topic. This paper proposes a novel graph database storage and query optimization method based on adaptive indexing and parallel computing. The method first designs an adaptive indexing mechanism that dynamically adjusts the index structure according to the query patterns and data distribution, thereby reducing the index maintenance overhead while improving query efficiency. Second, it introduces a parallel computing framework that leverages multi-core processors and distributed systems to accelerate graph traversal and query processing. Experimental evaluations on real-world datasets demonstrate that the proposed method achieves significant improvements in query response time and throughput compared to existing graph database systems, particularly for complex join queries and large-scale graph analytics. The results highlight the effectiveness of combining adaptive indexing with parallel computing in enhancing the performance of graph databases for big data applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Sirisha},
 doi = {10.32604/cmc.2025.063721},
 journal = {Computers},
 keywords = {source: Scopus},
 note = {Type: Review},
 number = {3},
 pages = {4031 -- 4059},
 title = {An {Analytical}},
 url = {https://doi.org/10.32604/cmc.2025.063721},
 volume = {83},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:58:00Z},
 year = {2025}
}

@inproceedings{siro_llm4eval_2025,
 abstract = {Visual Question Answering (VQA) has emerged as a challenging multimodal task that requires models to provide accurate answers to questions about images. Despite significant progress, VQA models often exhibit biases towards certain demographics, leading to unfair and potentially harmful outcomes. In this paper, we present a comprehensive survey on fairness in VQA, exploring the sources of bias in datasets, models, and evaluation protocols. We categorize fairness issues into spurious correlations, demographic disparities, and intersectional biases, and review state-of-the-art methods for bias detection, measurement, and mitigation. Our analysis highlights the need for diverse, representative datasets and robust debiasing techniques to ensure equitable VQA systems. We also discuss open challenges and future directions, advocating for interdisciplinary approaches to advance fair AI in vision-language tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Siro},
