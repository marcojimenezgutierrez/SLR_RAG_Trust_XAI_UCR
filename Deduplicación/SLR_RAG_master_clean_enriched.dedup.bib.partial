@inproceedings{mazhar_figurative-cum-commonsense_2025,
 abstract = {People with upper-body mobility impairments often face challenges in interacting with wearable haptic devices, particularly those that rely on manual input or precise movements. To address this, we conducted a co-design study with 12 participants with upper-body mobility impairments to explore inclusive design principles for wearable haptics. Through iterative workshops, we identified key design considerations, including adaptability to varying impairment levels, intuitiveness of haptic feedback, and integration of multi-modal cues. Participants emphasized the need for customizable vibration patterns, adjustable intensity, and non-manual activation methods, such as voice or gesture approximations. Our findings highlight the importance of user-centered customization to enhance accessibility and user agency. We contribute a set of design guidelines and a prototype wearable haptic system that embodies these principles, demonstrating improved interaction efficacy in preliminary evaluations. This work advances the development of inclusive wearable technologies for diverse user needs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Mazhar},
 booktitle = {Proceedings of the {ACM}},
