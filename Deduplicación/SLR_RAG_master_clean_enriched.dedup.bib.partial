@article{jeong_retrieval-augmented_2024,
 abstract = {Obesity is a major risk factor for type 2 diabetes, cardiovascular disease, and certain types of cancer. The worldwide obesity epidemic has been attributed to increased consumption of energy-dense foods and reduced physical activity. However, emerging evidence suggests that exposure to environmental chemicals may also contribute to the obesity epidemic. Here, we review the evidence linking exposure to environmental chemicals, termed "obesogens," to obesity and metabolic disease. We discuss the mechanisms by which obesogens may act, including effects on adipocyte differentiation, lipid metabolism, energy balance, and metabolic homeostasis. We also discuss the developmental origins of obesity and metabolic disease, focusing on the role of early-life exposure to obesogens in programming later obesity risk. Finally, we discuss the challenges and opportunities for future research in this emerging field.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Jeong},
 journal = {International …},
