@inproceedings{sahin_adaptation_2025-1,
 abstract = {Abstract—In this study, we propose a novel deep learning-based approach for early detection of Alzheimer's disease using multimodal neuroimaging data. Our model integrates structural MRI and functional connectivity features extracted from resting-state fMRI scans. We employ a hybrid convolutional neural network (CNN) and graph neural network (GNN) architecture to capture both local and global brain patterns. The dataset consists of 1,200 subjects from the ADNI cohort, divided into cognitively normal, mild cognitive impairment, and Alzheimer's disease groups. Experimental results demonstrate that our method achieves an accuracy of 92.5%, surpassing traditional machine learning techniques by 8%. This framework holds promise for clinical applications in timely intervention and personalized treatment planning.},
