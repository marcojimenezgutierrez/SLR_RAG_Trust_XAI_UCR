@article{schaffer_multimodal_2025,
 abstract = {Abstract Human cells consist of a complex hierarchy of components, many of which remain unexplored 1,2 . Here we construct a global map of human subcellular architecture through joint measurement of biophysical interactions and immunofluorescence images for over 5,100 proteins in U2OS osteosarcoma cells. Self-supervised multimodal data integration resolves 275 molecular assemblies spanning the range of 10 −8 to 10 −5 m, which we validate systematically using whole-cell size-exclusion chromatography and annotate using large language models 3 . We explore key applications in structural biology, yielding structures for 111 heterodimeric complexes and an expanded Rag–Ragulator assembly. The map assigns unexpected functions to 975 proteins, including roles for C18orf21 in RNA processing and DPP9 in interferon signalling, and identifies assemblies with multiple localizations or cell type specificity. It decodes paediatric cancer genomes 4 , identifying 21 recurrently mutated assemblies and implicating 102 validated new cancer proteins. The associated Cell Visualization Portal and Mapping Toolkit provide a reference platform for structural and functional cell biology.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 3; All Open Access; Green Accepted Open Access; Green Open Access; Hybrid Gold Open Access},
 author = {Schaffer},
 doi = {10.1038/s41586-025-08878-3},
 journal = {Nature},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {8066},
 pages = {222 -- 231},
 title = {Multimodal cell maps as a foundation for structural and functional genomics},
 url = {https://doi.org/10.1038/s41586-025-08878-3},
 volume = {642},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:38:47Z},
 year = {2025}
}

@article{schlegel_general_2021,
 abstract = {State construction is important for learning in partially observable environments. A general purpose strategy for state construction is to learn the state update using a Recurrent Neural Network (RNN), which updates the internal state using the current internal state and the most recent observation. This internal state provides a summary of the observed sequence, to facilitate accurate predictions and decision-making. At the same time, specifying and training RNNs is notoriously tricky, particularly as the common strategy to approximate gradients back in time, called truncated Back-prop Through Time (BPTT), can be sensitive to the truncation window. Further, domain-expertise—which can usually help constrain the function class and so improve trainability—can be difficult to incorporate into complex recurrent units used within RNNs. In this work, we explore how to use multi-step predictions to constrain the RNN and incorporate prior knowledge. In particular, we revisit the idea of using predictions to construct state and ask: does constraining (parts of) the state to consist of predictions about the future improve RNN trainability? We formulate a novel RNN architecture, called a General Value Function Network (GVFN), where each internal state component corresponds to a prediction about the future represented as a value function. We first provide an objective for optimizing GVFNs, and derive several algorithms to optimize this objective. We then show that GVFNs are more robust to the truncation level, in many cases only requiring one-step gradient updates.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Schlegel},
 doi = {10.1613/jair.1.12105},
 issn = {1076-9757},
 journal = {J. Artif. Int. Res.},
 keywords = {source: ACM},
 month = {may},
 note = {Place: El Segundo},
 pages = {497--543},
 title = {General {Value}},
 url = {https://doi.org/10.1613/jair.1.12105},
 volume = {70},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:45Z},
 year = {2021}
}

@inproceedings{schmidt_detecting_2024,
 abstract = {Online advertising platforms use machine learning models to personalize ad recommendations to users based on their profiles and behaviors. However, these models can inadvertently amplify biases present in the training data, leading to unfair ad delivery across demographic groups. In this paper, we propose a user-centric framework for measuring and mitigating bias in personalized ad recommendations. Our approach focuses on ensuring equitable exposure and utility for users from different protected groups, such as gender or age. We introduce novel fairness metrics that capture disparities in ad relevance and click-through rates at the individual user level, while aggregating to group-level fairness. To mitigate bias, we develop a post-processing re-ranking algorithm that adjusts recommendations to balance fairness and performance without retraining the underlying model. Experiments on real-world datasets from a major ad platform show that our method reduces bias by up to 40% while maintaining over 95% of the original utility, outperforming existing baselines.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Schmidt},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3589335.3651489},
 isbn = {979-8-4007-0172-6},
 keywords = {advertising},
 note = {event-place: Singapore},
 pages = {722--725},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {Detecting {Generated}},
 url = {https://doi.org/10.1145/3589335.3651489},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:06:51Z},
 year = {2024}
}

@inproceedings{schneider_engineering_2025,
 abstract = {This paper explores the design and evaluation of a haptic feedback system for virtual reality environments, focusing on enhancing user immersion through multi-modal interactions. We present Haptix, a wearable device that delivers localized vibrations synchronized with visual and auditory cues. Through user studies involving 30 participants, we demonstrate significant improvements in presence and task performance compared to traditional VR setups. Our findings highlight the importance of adaptive haptic patterns for diverse user needs, with implications for gaming, training simulations, and therapeutic applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
