 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:48:15Z},
 year = {2024}
}

@inproceedings{liu_think_2025,
 abstract = {Code review is an essential software engineering practice that helps improve code quality and catch defects early. However, it is time-consuming and requires significant expertise. Recent advances in large language models (LLMs) have shown promise in assisting various software engineering tasks, including code review. In this paper, we conduct an empirical study to evaluate the effectiveness of LLMs in performing code reviews. We collect a dataset of 1,000 code changes from GitHub pull requests and prompt state-of-the-art LLMs, such as GPT-4 and CodeLlama, to review them. We assess the reviews based on criteria like bug detection, style suggestions, and overall usefulness, comparing them to human reviews. Our findings indicate that LLMs can identify common issues effectively but often miss subtle bugs and provide generic feedback. We also analyze the impact of prompt engineering and model size on review quality. The results suggest that LLMs can augment human code reviewers but are not yet ready to replace them. We discuss implications for tool development and future research directions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
