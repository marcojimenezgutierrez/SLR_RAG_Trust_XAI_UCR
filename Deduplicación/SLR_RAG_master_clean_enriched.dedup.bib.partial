@inproceedings{salemi_comparing_2025,
 abstract = {Haptic feedback is a promising modality for providing spatial information to people with visual impairments. However, the design space of haptic devices is vast, and it is challenging to select the appropriate device for a given use case. We present HaptiMap, an interactive web-based visualization tool that allows users to explore the design space of haptic devices. HaptiMap integrates a comprehensive database of 200+ haptic devices with a set of interactive visualizations that enable users to filter, compare, and analyze devices based on various attributes such as actuation technology, body location, and degrees of freedom. We conducted a user study with 12 experts in haptics and accessibility to evaluate HaptiMap's usability and utility. Participants found HaptiMap effective for exploring the design space and inspiring new ideas for haptic device design. Our findings suggest that HaptiMap can facilitate more informed decision-making in the selection and design of haptic devices for accessibility applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Salemi},
 booktitle = {Proceedings of the 2025 {International}},
 doi = {10.1145/3731120.3744595},
