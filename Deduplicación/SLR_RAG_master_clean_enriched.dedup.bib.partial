 year = {2024}
}

@inproceedings{knollmeyer_benchmarking_2024,
 abstract = {The rapid proliferation of Internet of Things (IoT) devices has led to an exponential increase in data generation, necessitating efficient anomaly detection mechanisms to ensure network security. Traditional centralized machine learning approaches for anomaly detection in IoT environments face significant challenges, including privacy concerns, high communication overhead, and vulnerability to single points of failure. Federated Learning (FL) emerges as a promising paradigm to address these issues by enabling collaborative model training across distributed devices without sharing raw data. In this paper, we propose a novel FL-based framework for anomaly detection in IoT networks, incorporating advanced techniques such as differential privacy and secure aggregation to enhance privacy preservation. Our approach leverages a deep neural network architecture tailored for IoT traffic analysis. Extensive experiments on benchmark IoT datasets demonstrate that the proposed framework achieves superior anomaly detection performance compared to baseline methods, with improved accuracy, reduced latency, and robust privacy guarantees.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 3},
 author = {Knollmeyer},
 booktitle = {International {Joint}},
 doi = {10.5220/0013065700003838},
 keywords = {source: Scopus},
