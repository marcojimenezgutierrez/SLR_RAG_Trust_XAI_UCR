 volume = {3},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:00:28Z},
 year = {2025}
}

@article{gutu_exploring_2024,
 abstract = {Semantic segmentation is one of the most fundamental and challenging tasks in remote sensing image interpretation. In recent years, deep learning techniques have achieved great success in semantic segmentation of remote sensing images. This paper presents a comprehensive survey on deep learning-based semantic segmentation methods for remote sensing images. First, we introduce the background and challenges of semantic segmentation for remote sensing images. Then, we categorize the existing methods into several groups, including encoder–decoder architectures, pyramid pooling modules, attention mechanisms, multi-scale feature fusion, and boundary refinement methods. For each category, we discuss the key ideas, advantages, and limitations. Finally, we highlight several promising research directions in this field.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
