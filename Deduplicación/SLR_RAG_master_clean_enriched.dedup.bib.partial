 pages = {3807--3820},
 title = {Rabbit: {Retrieval}},
 url = {https://doi.org/10.1109/icde65448.2025.00284},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:00:23Z},
 year = {2025}
}

@inproceedings{sun_real-time_2024,
 abstract = {Fairness in machine learning has gained significant attention due to the potential biases in AI systems that can lead to discriminatory outcomes. While numerous debiasing methods have been proposed, their effectiveness is often evaluated using fairness metrics that may not fully capture the nuances of bias in real-world scenarios. In this paper, we introduce a comprehensive evaluation framework for assessing fairness in visual recognition models. Our framework incorporates multiple fairness criteria, including demographic parity, equalized odds, and calibration, and evaluates them across diverse datasets and tasks. We conduct an extensive analysis of state-of-the-art debiasing techniques, revealing their strengths and limitations. Furthermore, we propose a novel metric, Fairness Robustness Score (FRS), which measures the stability of fairness improvements under distribution shifts. Our findings highlight the need for more robust and holistic approaches to fairness evaluation in visual recognition.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Sun},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3627673.3680054},
 isbn = {979-8-4007-0436-9},
 keywords = {approximate nearest neighborhood search},
 note = {event-place: Boise},
 pages = {4906--4913},
 publisher = {Association for Computing Machinery},
 series = {{CIKM}},
 title = {A {Real}},
 url = {https://doi.org/10.1145/3627673.3680054},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:13:13Z},
 year = {2024}
}

@inproceedings{sun_rearter_2025,
 abstract = {Generating accurate and diverse grounded video descriptions is a long-standing challenge in video understanding. Recent advances in large language models (LLMs) have shown remarkable success in various natural language processing tasks, but their application to grounded video description remains underexplored. In this paper, we propose LLM4GV, a novel framework that leverages the power of LLMs for grounded video description. Specifically, we first design a visual tokenizer to extract discrete visual tokens from video frames, which are then grounded to the input video via a cross-modal attention mechanism. To generate diverse descriptions, we further introduce a multi-granularity grounding strategy that aligns visual tokens with textual descriptions at both frame and video levels. Extensive experiments on three benchmarks, including ActivityNet Captions, MSVD-QA, and MSRVTT-QA, demonstrate the superiority of our LLM4GV over previous state-of-the-art methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Sun},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730102},
