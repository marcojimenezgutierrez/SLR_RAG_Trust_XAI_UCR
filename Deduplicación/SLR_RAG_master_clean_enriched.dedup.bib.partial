@inproceedings{peng_glitter_2025,
 abstract = {Vision-language models (VLMs) have achieved remarkable success in various multimodal tasks. However, they often exhibit social biases inherited from their training data, leading to unfair outcomes, especially in tasks involving demographic attributes like gender, race, and age. Existing debiasing methods for VLMs are limited, often focusing on specific biases or requiring extensive retraining. In this paper, we propose a novel debiasing approach for VLMs using biased prompts. Our method generates counterfactual prompts that explicitly counteract biased associations, enabling the model to produce fairer responses without modifying the underlying model parameters. We evaluate our approach on multiple benchmarks, including fairness in image captioning and visual question answering, demonstrating significant reductions in bias while maintaining or improving overall performance. Our work provides a simple, efficient, and generalizable solution to enhance fairness in VLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 and enhance metacognition via personalized reflection reports. a lab study within subjects (n = {12) demonstrates that Glitter improves discussion engagement},
