 volume = {656},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:31:32Z},
 year = {2025}
}

@inproceedings{zhang_agentfm_2025,
 abstract = {The rapid advancement of large language models (LLMs) has significantly enhanced the capabilities of conversational agents in various domains. However, their application in complex, multi-turn dialogues, particularly in sensitive areas like mental health support, remains underexplored. Existing LLM-based chatbots often struggle with maintaining context, empathy, and ethical boundaries in such scenarios. To address these challenges, we introduce MindCompanion, a novel LLM-powered conversational agent designed specifically for mental health support. MindCompanion leverages a hybrid architecture combining fine-tuned LLMs with rule-based safeguards to ensure safe, empathetic, and contextually relevant interactions. Our system incorporates a dynamic memory module to track user emotional states across sessions and a content moderation layer to prevent harmful advice. Preliminary evaluations with simulated users demonstrate that MindCompanion outperforms baseline chatbots in empathy (measured via human ratings) and adherence to therapeutic guidelines, while reducing instances of inappropriate responses by 40%. This work highlights the potential of specialized LLM agents in mental health applications and provides a framework for responsible deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhang},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3696630.3728492},
