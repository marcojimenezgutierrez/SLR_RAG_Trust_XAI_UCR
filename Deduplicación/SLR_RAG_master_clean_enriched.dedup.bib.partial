@incollection{ots_securing_2025,
 abstract = {This paper proposes a novel approach for enhancing the security of IoT devices using blockchain technology. We introduce a lightweight consensus mechanism tailored for resource-constrained environments, which significantly reduces computational overhead while maintaining robustness against common attacks such as Sybil and DDoS. Through extensive simulations and real-world deployments on Raspberry Pi-based networks, our system demonstrates a 40% improvement in transaction throughput and a 25% reduction in energy consumption compared to existing solutions like Ethereum-based IoT frameworks. The results highlight the feasibility of scalable, secure decentralized architectures for smart homes and industrial IoT applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
