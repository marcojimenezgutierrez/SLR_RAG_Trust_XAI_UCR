 pages = {79--82},
 publisher = {Association for Computing Machinery},
 series = {{CSCW}},
 title = {Bridging {Dictionary}},
 url = {https://doi.org/10.1145/3678884.3681820},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:12:11Z},
 year = {2024}
}

@article{jiang_efficient_2024,
 abstract = {Generalist robot policies are emerging as a promising paradigm for robot learning, offering the potential to solve a wide range of tasks with a single policy. However, current approaches to building such policies often rely on large-scale data collection and compute-intensive training, limiting their accessibility. In this work, we investigate what factors are most important for building effective generalist robot policies. We conduct a comprehensive study across data, model architecture, and training procedures, identifying key insights that enable strong performance with modest resources. Our findings suggest that careful curriculum design and data selection are more critical than model scale for achieving generalization. We demonstrate that a simple transformer-based policy, trained on a curated dataset of ~100 hours of diverse manipulation data, can solve over 100 tasks in simulation and transfer to a real robot with minimal fine-tuning. These results provide practical guidance for developing generalist robot policies that are both effective and accessible.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Jiang},
 journal = {arXiv preprint arXiv …},
