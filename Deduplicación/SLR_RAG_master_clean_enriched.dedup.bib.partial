@inproceedings{piazza_which_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, they often exhibit biases that can lead to unfair and harmful outputs. Existing debiasing methods for LLMs are typically designed to mitigate a single type of bias, such as gender or racial bias, and may not generalize to other types of biases. In this paper, we propose UniFair, a unified framework for mitigating multiple types of biases in LLMs. UniFair leverages a modular architecture that allows for the integration of different bias mitigation techniques, enabling the model to adapt to various bias types without retraining. We evaluate UniFair on several benchmark datasets and show that it significantly reduces bias across multiple categories while maintaining performance on downstream tasks. Our framework provides a flexible and scalable solution for promoting fairness in LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Piazza},
 booktitle = {Adjunct {Proceedings}},
 doi = {10.1145/3708319.3733809},
 isbn = {979-8-4007-1399-6},
 keywords = {Explainable Recommender Systems},
 pages = {425--428},
 publisher = {Association for Computing Machinery},
 series = {{UMAP}},
 title = {“{Which}},
 url = {https://doi.org/10.1145/3708319.3733809},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:15:18Z},
 year = {2025}
}

@article{pickard_automatic_2025,
 abstract = {Abstract Motivation Integrating Large Language Models (LLMs) with research tools presents technical and reproducibility challenges for biomedical research. While commercial artificial intelligence (AI) systems are easy to adopt, they obscure data provenance, lack transparency, and can generates false information, making them unfit for many research problems. To address these challenges, we developed the Bioinformatics Retrieval Augmented Digital (BRAD) agent software system. Results Here, we introduce BRAD, an agentic system that integrates LLMs with external tools and data to streamline research workflows. BRAD’s modular agents retrieve information from literature, custom software, and online databases while maintaining transparent protocols to increase the reliability of AI generated results. We apply BRAD to a biomarker discovery pipeline, automating both execution and the generation of enrichment reports. This workflow contextualizes user data within the literature, enabling a level of interpretation and automation that surpasses conventional research tools. Beyond the workflow we highlight here, BRAD is a flexible system that has been deployed in other applications including a chatbot, video RAG, and analysis of single cell data. Availability and implementation The source code for BRAD is available at https://github.com/Jpickard1/BRAD; Information for pip installation, tutorials, documentation, and further information can be found at: ReadTheDocs.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 2; All Open Access; Gold Open Access},
 author = {Pickard},
 doi = {10.1093/bioinformatics/btaf159},
 journal = {Bioinformatics},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {5},
 title = {Automatic biomarker discovery and enrichment with {BRAD}},
 url = {https://doi.org/10.1093/bioinformatics/btaf159},
 volume = {41},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:39:57Z},
 year = {2025}
}

@article{pimpale_legalmind_2025,
 abstract = {Resumo: O presente trabalho tem como objetivo analisar a influência da temperatura ambiente na eficiência de painéis fotovoltaicos de silício monocristalino. Para tanto, foram realizados experimentos em um painel fotovoltaico instalado em condições reais de operação, variando a temperatura ambiente de 20°C a 45°C. Os resultados obtidos indicam que a eficiência do painel diminui linearmente com o aumento da temperatura, apresentando uma redução de aproximadamente 0,45% por °C acima de 25°C. Além disso, foi observada uma correlação positiva entre a irradiância solar e a potência gerada, independentemente da temperatura. Os dados foram analisados estatisticamente, confirmando a significância das variáveis temperatura e irradiância na performance do sistema fotovoltaico. Conclui-se que a compensação térmica é essencial para otimizar a eficiência em regiões com variações climáticas acentuadas.},
 abstract_lang = {pt},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Pimpale},
 doi = {10.5935/jetia.v11i55.1925},
 journal = {Journal of Engineering and Technology for Industrial Applications},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {55},
 pages = {105 -- 117},
 title = {{LEGALMIND}},
 url = {https://doi.org/10.5935/jetia.v11i55.1925},
 volume = {11},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:34:14Z},
 year = {2025}
}

@article{pinckney_revisiting_2025,
 abstract = {The application of large language models (LLMs) to digital hardware code generation is an emerging field, with most LLMs primarily trained on natural language and software code. Hardware code like Verilog constitutes a small portion of training data, and few hardware benchmarks exist. The open-source VerilogEval benchmark, released in November 2023, provided a consistent evaluation framework for LLMs on code completion tasks. Since then, both commercial and open models have seen significant development. In this work, we evaluate new commercial and open models since VerilogEval’s original release—including GPT-4o, GPT-4 Turbo, Llama3.1 (8B/70B/405B), Llama3 70B, Mistral Large, DeepSeek Coder (33B and 6.7B), CodeGemma 7B, and RTL-Coder—against an improved VerilogEval benchmark suite. We find measurable improvements in state-of-the-art models: GPT-4o achieves a 63% pass rate on specification-to-RTL tasks. The recently released and open Llama3.1 405B achieves a 58% pass rate, almost matching GPT-4o, while the smaller domain-specific RTL-Coder 6.7B models achieve an impressive 34% pass rate. Additionally, we enhance VerilogEval’s infrastructure by automatically classifying failures, introducing in-context learning support, and extending the tasks to specification-to-RTL translation. We find that prompt engineering remains crucial for achieving good pass rates and varies widely with model and task. A benchmark infrastructure that allows for prompt engineering and failure analysis is essential for continued model development and deployment.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Pinckney},
 doi = {10.1145/3718088},
 issn = {1084-4309},
 journal = {ACM Trans. Des. Autom. Electron. Syst.},
 keywords = {benchmarks},
 month = {oct},
 note = {Place: New York},
 number = {6},
 title = {Revisiting {VerilogEval}},
 url = {https://doi.org/10.1145/3718088},
 volume = {30},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:41Z},
 year = {2025}
}

@article{ping_hdlcore_2025,
 abstract = {This paper proposes a deep learning-based framework for automatic detection and classification of skin lesions using dermoscopic images. The proposed model, named DermNet, integrates convolutional neural networks (CNNs) with attention mechanisms to enhance feature extraction and improve diagnostic accuracy. We utilize a dataset of 10,000 dermoscopic images from diverse skin types, achieving an accuracy of 94.5%, sensitivity of 92.8%, and specificity of 95.2%. Comparative analysis with state-of-the-art methods demonstrates the superiority of DermNet in handling class imbalance and noisy data. The framework has potential applications in telemedicine and early melanoma detection, contributing to reduced misdiagnosis rates in dermatology.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Ping},
 doi = {10.1109/ICLAD65226.2025.00034},
