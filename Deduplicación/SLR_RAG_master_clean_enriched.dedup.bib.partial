@article{agater_slango_2025,
 abstract = {With the proliferation of Internet of Things (IoT) devices, there is an increasing demand for intelligent applications that can process data locally while preserving privacy. Federated Learning (FL) emerges as a promising paradigm to enable collaborative model training across distributed devices without sharing raw data. However, deploying FL on resource-constrained IoT devices poses significant challenges, including limited computational power, communication bandwidth, and heterogeneous data distributions. This chapter provides a comprehensive survey of FL techniques tailored for IoT environments. We first outline the fundamentals of FL and its adaptation to edge computing scenarios. Then, we categorize and analyze existing approaches to address key challenges such as model compression, communication efficiency, personalization, and security. Finally, we discuss open research issues and future directions to advance FL deployment in real-world IoT systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
