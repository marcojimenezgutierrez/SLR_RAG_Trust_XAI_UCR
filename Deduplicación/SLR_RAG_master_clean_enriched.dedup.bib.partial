 year = {2024}
}

@article{fayyazi_llm_2025,
 abstract = {We introduce a new benchmark for evaluating the reasoning capabilities of large language models, focusing on tasks that require understanding of physical intuition and causal reasoning. Our dataset, PhysInt, consists of 1,000 diverse problems spanning mechanics, electromagnetism, and thermodynamics, designed to test both qualitative and quantitative understanding. We evaluate several state-of-the-art models and find that while they perform well on simple tasks, performance drops significantly for those involving counterfactuals or multi-step causal chains. Our analysis reveals key failure modes and suggests directions for improving physical reasoning in AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
