@inproceedings{yang_evaluating_2025,
 abstract = {This paper presents HapticsCanvas, a web-based toolkit for designing and evaluating wearable haptic interfaces. It enables users to create custom haptic patterns using a visual interface and simulate them on a virtual body model. We conducted a study with 12 designers, finding that HapticsCanvas significantly reduced design time and improved pattern accuracy compared to traditional methods. The toolkit supports rapid prototyping and inclusive design practices for haptics in HCI applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
