 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:00:38Z},
 year = {2025}
}

@inproceedings{quinn_longsight_2025,
 abstract = {Interactive data visualization tools empower users to explore and analyze data through direct manipulation of visual representations. However, creating effective visualizations often requires programming knowledge, limiting accessibility. Visual programming languages (VPLs) offer a promising alternative by allowing users to build visualizations through graphical interfaces. Despite their potential, designing intuitive VPLs for data visualization remains challenging due to the complexity of data processing and visual encoding tasks. In this paper, we explore the design space of VPLs for interactive data visualization. We identify key design dimensions, including abstraction levels, interaction paradigms, and integration with existing tools. Through a series of design studies and user evaluations, we prototype and assess different VPL approaches, revealing trade-offs in usability, expressiveness, and learnability. Our findings inform the development of future VPLs that balance power and accessibility for diverse user groups, from novices to experts.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
