 publisher = {Association for Computing Machinery},
 series = {{CIKM}},
 title = {International {Workshop}},
 url = {https://doi.org/10.1145/3627673.3679083},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:14:52Z},
 year = {2024}
}

@inproceedings{wang_it_2025,
 abstract = {Mobile AR applications often rely on visual interfaces, which can exclude blind users. We propose a novel auditory display design that enables blind users to explore and interact with augmented reality content using spatial audio and gesture-based navigation. Through a user study with 12 blind participants, we evaluate our design's usability, effectiveness, and user satisfaction compared to a baseline screen reader approach. Results show that our auditory display significantly improves exploration accuracy (p < 0.01) and reduces task completion time by 35%, while participants reported higher confidence and enjoyment. We discuss implications for inclusive AR design, including the integration of non-visual cues for spatial awareness and the challenges of audio clutter in dynamic environments. Our work contributes a framework for auditory AR interfaces that can be adapted to various mobile applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wang},
 booktitle = {Proceedings of the 27th {International}},
