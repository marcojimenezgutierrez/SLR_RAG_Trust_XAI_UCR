@inproceedings{tian_customized_2024,
 abstract = {Diffusion models have achieved remarkable success in image inpainting, but they often suffer from inefficient inference and suboptimal inpainting quality, especially for large missing regions. To address these issues, we propose DiffuEraser, a novel diffusion-based inpainting framework that leverages an eraser guidance mechanism to improve both efficiency and quality. Specifically, our method introduces an eraser module that adaptively erases the known regions during the reverse diffusion process, allowing the model to focus more on the missing regions. This eraser guidance not only accelerates the inpainting process by reducing the number of sampling steps but also enhances the coherence and fidelity of the generated content. Extensive experiments on multiple benchmarks demonstrate that DiffuEraser outperforms state-of-the-art methods in terms of both inpainting quality and inference speed.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Tian},
 booktitle = {Proceedings of the 5th {ACM}},
 doi = {10.1145/3677052.3698637},
