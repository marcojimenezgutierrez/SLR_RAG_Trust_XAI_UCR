 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {Explainable {LLM}},
 url = {https://doi.org/10.1145/3701716.3715222},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:39:14Z},
 year = {2025}
}

@inproceedings{zhao_knoll_2025,
 abstract = {We present a novel approach to generating interactive 3D environments from 2D images using diffusion models. Our method, called SceneDiffuser, leverages a pre-trained 2D diffusion model to synthesize consistent multi-view images of a scene, which are then used to reconstruct a 3D representation. Unlike previous works that require explicit 3D supervision or multi-view datasets, SceneDiffuser operates solely on single images and text prompts, enabling zero-shot 3D scene generation. We demonstrate the effectiveness of our approach on diverse indoor and outdoor scenes, achieving high-fidelity 3D reconstructions with interactive capabilities. Our results show superior performance in terms of geometric consistency and visual quality compared to existing baselines.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
