@inproceedings{oreski_retrieval_2024,
 abstract = {This study investigates the impact of climate change on agricultural productivity in sub-Saharan Africa. Using panel data from 1990 to 2015 across 20 countries, we employ a fixed-effects regression model to estimate the effects of temperature and precipitation variations on crop yields. Results indicate a significant negative relationship between rising temperatures and maize, sorghum, and millet yields, with precipitation showing a non-linear effect. Adaptation strategies, such as improved irrigation and drought-resistant varieties, are recommended to mitigate these impacts. The findings underscore the urgency of integrating climate resilience into agricultural policies in the region.},
 abstract_lang = {en},
