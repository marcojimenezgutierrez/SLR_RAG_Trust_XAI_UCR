 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:21:25Z},
 year = {2025}
}

@article{soh_data_2024,
 abstract = {This book constitutes selected papers presented at the International Conference on Intelligent Systems Design and Applications (ISDA 2023), which was held in conjunction with the 23rd International Conference on Hybrid Intelligent Systems (HIS 2023) virtually during December 18–20, 2023. The ISDA 2023 received 456 papers from 78 countries, of which 128 were accepted (28%). All papers were evaluated by at least two reviewers, and about 30% of the submitted papers were accepted after a rigorous peer-review process. The conference is focused on all aspects of intelligent systems and their applications in science and technology. The book is a valuable resource for researchers and practitioners in the fields of artificial intelligence, machine learning, data science, and related areas.},
