@article{zhang_knowledge-enhanced_2025,
 abstract = {Background Sepsis is a severe syndrome of organ dysfunction caused by infection; it has high heterogeneity and high in-hospital mortality, representing a grim clinical challenge for precision medicine in critical care. Objective We aimed to extract reported sepsis biomarkers to provide users with comprehensive biomedical information and integrate retrieval augmented generation (RAG) and prompt engineering to enhance the accuracy, stability, and interpretability of clinical decisions recommended by large language models (LLMs). Methods To address the challenge, we established and updated the first knowledge-enhanced platform, MetaSepsisKnowHub, comprising 427 sepsis biomarkers and 423 studies, aiming to systematically collect and annotate sepsis biomarkers to guide personalized clinical decision-making in the diagnosis and treatment of human sepsis. We curated a tailored LLM framework incorporating RAG and prompt engineering and incorporated 2 performance evaluation scales: the System Usability Scale and the Net Promoter Score. Results The overall quantitative ratings of expert-reviewed clinical recommendations based on RAG surpassed baseline responses generated by 4 LLMs and showed a statistically significant improvement in textual questions (GPT-4: mean 75.79, SD 7.11 vs mean 81.59, SD 9.87; P=.02; GPT-4o: mean 70.36, SD 7.63 vs mean 77.98, SD 13.26; P=.02; Qwen2.5-instruct: mean 77.08 SD 3.75 vs mean 85.46, SD 7.27; P<.001; and DeepSeek-R1: mean 77.67, SD 3.66 vs mean 86.42, SD 8.56; P<.001), but no significant statistical differences could be measured in clinical scenarios. The RAG assessment score comparing RAG-based responses and expert-provided benchmark answers illustrated prominent factual correctness, accuracy, and knowledge recall compared to the baseline responses. After use, the average the System Usability Scale score was 82.20 (SD 14.17) and the Net Promoter Score was 72, demonstrating high user satisfaction and loyalty. Conclusions We highlight the pioneering MetaSepsisKnowHub platform, and we show that combining MetaSepsisKnowHub with RAG can minimize limitations on precision and maximize the breadth of LLMs to shorten the bench-to-bedside distance, serving as a knowledge-enhanced paradigm for future application of artificial intelligence in critical care medicine.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Zhang},
 doi = {10.2196/67201},
 journal = {Journal of Medical Internet Research},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {A {Knowledge}},
 url = {https://doi.org/10.2196/67201},
 volume = {27},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:57:02Z},
 year = {2025}
}

@inproceedings{zhang_knowpo_2025,
 abstract = {By integrating external knowledge, Retrieval-Augmented Generation (RAG) has become an effective strategy for mitigating the hallucination problems that large language models (LLMs) encounter when dealing with knowledge-intensive tasks. However, in the process of integrating external non-parametric supporting evidence with internal parametric knowledge, inevitable knowledge conflicts may arise, leading to confusion in the model's responses. To enhance the knowledge selection of LLMs in various contexts, some research has focused on refining their behavior patterns through instruction-tuning. Nonetheless, due to the absence of explicit negative signals and comparative objectives, models fine-tuned in this manner may still exhibit undesirable behaviors such as contextual ignorance and contextual overinclusion. To this end, we propose a Knowledge-aware Preference Optimization strategy, dubbed KnowPO, aimed at achieving adaptive knowledge selection based on contextual relevance in real retrieval scenarios. Concretely, we proposed a general paradigm for constructing knowledge conflict datasets, which comprehensively cover various error types and learn how to avoid these negative signals through preference optimization methods. Simultaneously, we proposed a rewriting strategy and data ratio optimization strategy to address preference imbalances. Experimental results show that KnowPO outperforms previous methods for handling knowledge conflicts by over 37%, while also exhibiting robust generalization across various out-of-distribution datasets.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Zhang},
 booktitle = {Proceedings of the {AAAI}},
 doi = {10.1609/aaai.v39i24.34783},
 keywords = {source: Scopus},
 note = {Issue: 24
Type: Conference paper},
 pages = {25895 -- 25903},
 title = {{KnowPO}},
 url = {https://doi.org/10.1609/aaai.v39i24.34783},
 volume = {39},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:40:52Z},
 year = {2025}
}

@inproceedings{zhang_large-language_2025,
 abstract = {Data narratives are a powerful way to communicate data insights to broad audiences. However, creating effective data narratives requires skills in data analysis, storytelling, and visualization design, which can be challenging for non-experts. Visual programming environments have shown promise in democratizing data analysis and visualization, but their application to data narratives remains underexplored. In this paper, we investigate the design space of visual programming for interactive data narratives through the development and evaluation of Narrato, a prototype environment that enables users to author data narratives using a visual programming paradigm. We first conducted a formative study with 12 narrative creators to understand their needs and challenges. Informed by the findings, we designed Narrato with three key features: a narrative structure builder, a modular visualization composer, and an interactive previewer. We then evaluated Narrato with 16 participants through a comparative user study against a text-based tool, revealing that while visual programming introduces a learning curve, it offers advantages in modularity and reusability for narrative creation. Our work contributes insights into the opportunities and challenges of visual programming for data narratives and provides design guidelines for future tools in this space.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhang},
 booktitle = {Proceedings of the 4th {International}},
 doi = {10.1145/3745034.3745043},
 isbn = {979-8-4007-1439-9},
 keywords = {Artificial Intelligence},
 pages = {50--55},
 publisher = {Association for Computing Machinery},
 series = {{IC}},
 title = {A large-language model-driven approach to chronic disease follow-up},
 url = {https://doi.org/10.1145/3745034.3745043},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:23:03Z},
 year = {2025}
}

@inproceedings{zhang_large_2025,
 abstract = {This paper presents a novel framework for multi-agent reinforcement learning in dynamic environments, focusing on collaborative task allocation among heterogeneous robots. We introduce a hierarchical policy architecture that integrates centralized training with decentralized execution, enabling efficient coordination without excessive communication overhead. Through extensive simulations and real-world experiments on a swarm robotic platform, our approach demonstrates superior performance in terms of task completion time and energy efficiency compared to state-of-the-art baselines. The results highlight the framework's robustness to environmental uncertainties and agent failures, paving the way for scalable applications in search-and-rescue operations and warehouse automation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
