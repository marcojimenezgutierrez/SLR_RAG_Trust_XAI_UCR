@inproceedings{omoush_advancing_2025,
 abstract = {Abstract—This paper proposes a novel framework for enhancing cybersecurity in IoT networks using machine learning techniques. We introduce a hybrid model combining convolutional neural networks (CNNs) and long short-term memory (LSTM) networks to detect anomalous behaviors in real-time. The proposed system is evaluated on benchmark datasets, achieving a detection accuracy of 98.5% with reduced false positives. Experimental results demonstrate the framework's robustness against various attack vectors, including DDoS and man-in-the-middle attacks. Future work will focus on integrating edge computing for improved scalability.},
