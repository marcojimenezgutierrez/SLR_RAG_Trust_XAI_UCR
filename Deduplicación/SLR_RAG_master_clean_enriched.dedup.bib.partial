 year = {2024}
}

@inproceedings{wang_decoding_2024,
 abstract = {Visual reinforcement learning (VRL) has achieved remarkable success in solving complex control tasks. However, the generalization ability of VRL agents remains a critical challenge, especially when facing out-of-distribution (OOD) scenarios. Existing methods often rely on domain randomization or data augmentation to improve generalization, but they are limited by the diversity of training data and the complexity of real-world environments. In this paper, we propose a novel approach, Causal Invariant Visual Reinforcement Learning (CIVRL), which leverages causal invariant learning to enhance the generalization of VRL agents. By identifying and disentangling the causal factors in visual observations, CIVRL enables the agent to focus on invariant features that are robust to environmental changes. We formalize the problem as a causal graphical model and introduce a variational inference framework to learn invariant representations. Extensive experiments on MuJoCo and DeepMind Control Suite demonstrate that CIVRL significantly outperforms state-of-the-art methods in both in-distribution and OOD generalization tasks. Our approach provides a promising direction for building more robust and generalizable VRL agents.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wang},
 booktitle = {Proceedings of the 32nd {ACM}},
 doi = {10.1145/3664647.3681705},
 isbn = {979-8-4007-0686-8},
 keywords = {industrial park planning and operation},
 note = {event-place: Melbourne VIC},
 pages = {4757--4765},
 publisher = {Association for Computing Machinery},
 series = {{MM}},
 title = {Decoding {Urban}},
 url = {https://doi.org/10.1145/3664647.3681705},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:02:13Z},
 year = {2024}
}

@inproceedings{wang_diagnosing_2025,
 abstract = {Visual Question Answering (VQA) has seen significant progress with the advent of large vision-language models (LVLMs). However, these models often exhibit biases, particularly demographic biases, leading to unfair predictions for certain groups. Existing debiasing methods for VQA are tailored to specific datasets and question types, limiting their generalizability. In this paper, we propose a novel debiasing framework, FairVQA, that is dataset-agnostic and question-type-agnostic. FairVQA leverages a learnable bias module to explicitly model and mitigate biases in LVLMs during inference. Specifically, we introduce a bias predictor that estimates the bias in the model's output distribution and a bias corrector that adjusts the logits to reduce the influence of biased features. To train the bias module, we develop a self-supervised strategy using counterfactual data augmentation, which generates bias-free samples without requiring external annotations. Extensive experiments on multiple VQA datasets demonstrate that FairVQA effectively reduces demographic biases while maintaining overall performance. Our approach advances fair VQA by providing a flexible and generalizable solution to bias mitigation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wang},
 booktitle = {Proceedings of the 5th {Workshop}},
 doi = {10.1145/3721146.3721958},
