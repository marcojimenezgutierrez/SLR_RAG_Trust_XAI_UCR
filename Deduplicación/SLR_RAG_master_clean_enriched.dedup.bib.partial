@article{shen_citelab_2025,
 abstract = {This demo presents LlamaIndex, an open-source framework for building LLM-powered Retrieval-Augmented Generation (RAG) applications. LlamaIndex provides tools for ingesting, indexing, querying, and evaluating RAG pipelines over custom data sources. We showcase how LlamaIndex can be used to build production-ready RAG applications, including advanced features like query transformation, multi-modal retrieval, and agentic workflows. Our demo includes a live interface where users can upload documents, query them using natural language, and visualize the retrieval and generation process.},
