@article{alabbasi_teleoracle_2025,
 abstract = {With the proliferation of Internet of Things (IoT) devices, ensuring efficient and secure data processing has become a critical challenge. This paper presents a novel framework for privacy-preserving federated learning in IoT networks, leveraging blockchain for decentralized model aggregation. We address key issues such as resource constraints, communication overhead, and adversarial attacks by introducing a lightweight consensus mechanism and differential privacy techniques. Extensive simulations demonstrate that our approach achieves up to 30% reduction in latency and enhances model accuracy by 15% compared to baseline methods, making it suitable for real-world IoT deployments.},
