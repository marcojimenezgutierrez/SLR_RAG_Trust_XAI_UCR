 year = {2025}
}

@inproceedings{hamid_can_2025,
 abstract = {This paper proposes a novel federated learning framework for privacy-preserving multimedia recommendation systems. By integrating differential privacy mechanisms with graph neural networks, our approach addresses data heterogeneity and communication overhead in distributed environments. Extensive experiments on benchmark datasets demonstrate superior performance in accuracy and efficiency compared to state-of-the-art methods.},
