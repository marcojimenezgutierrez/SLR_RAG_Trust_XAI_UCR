@article{mamalis_can_2023,
 abstract = {Recent advances in vision-language models have shown remarkable success in learning visual concepts from image-text pairs. However, these models often struggle with fine-grained spatial understanding and precise object localization. In this work, we introduce SpatialVLM, a novel vision-language model that enhances spatial reasoning capabilities by incorporating explicit spatial modeling into the multimodal fusion process. Our approach leverages a spatial attention mechanism to align visual features with textual descriptions at a granular level, enabling the model to reason about object positions, relations, and interactions more effectively. We evaluate SpatialVLM on a suite of spatial reasoning benchmarks, demonstrating significant improvements over existing models in tasks such as visual question answering with spatial queries and referring expression comprehension. Our findings highlight the importance of spatial awareness in advancing multimodal AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
