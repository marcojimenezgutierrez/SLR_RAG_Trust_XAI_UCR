 x_enrich_ts = {2025-11-02T10:09:45Z},
 year = {2025}
}

@article{noauthor_knowledgenlp_2024,
 abstract = {The COVID-19 pandemic has caused an unprecedented shock to the US economy. We use data from a survey of more than 5,800 small business owners conducted in April 2020 to document the immediate effects of the pandemic on their businesses. We find that small businesses have experienced a large and sudden reduction in revenues, with an average decline of 40% in April 2020 relative to pre-pandemic levels. Expectations about future revenues are also pessimistic, with businesses anticipating a further 20% decline over the next 6 months. Employment has fallen by 20% on average, and businesses expect further job losses. Access to credit has deteriorated, with many businesses unable to secure loans or lines of credit. These findings highlight the severe challenges facing small businesses and the potential for long-term economic damage if the pandemic is not brought under control.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 keywords = {source: Scopus},
 note = {Type: Conference review},
 title = {{KnowledgeNLP}},
