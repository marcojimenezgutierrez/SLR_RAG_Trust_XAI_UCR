@article{chavan_global-local_2025,
 abstract = {Obesity is a major risk factor for type 2 diabetes, cardiovascular disease, and certain types of cancer. The worldwide obesity epidemic has been attributed to increased consumption of energy-dense foods and reduced physical activity. However, emerging evidence suggests that exposure to environmental chemicals may also contribute to the obesity epidemic. Here we review the evidence linking exposure to environmental chemicals, particularly endocrine-disrupting chemicals (EDCs), to obesity and metabolic disorders. We discuss potential mechanisms by which EDCs may promote obesity, including effects on adipocyte differentiation, lipid metabolism, energy balance, and the gut microbiome. We also highlight critical windows of susceptibility during development when EDC exposure may have particularly profound effects on obesity risk later in life. Finally, we discuss challenges and future directions for research on environmental obesogens, including the need for improved exposure assessment, consideration of chemical mixtures, and translation of findings to public health interventions.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 author = {Chavan},
 issn = {1931-3357},
 journal = {J. User Exper.},
 keywords = {source: ACM},
