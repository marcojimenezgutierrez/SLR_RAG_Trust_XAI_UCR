 keywords = {AI-Ops},
 note = {event-place: World Trade Center},
 pages = {139--147},
 publisher = {Association for Computing Machinery},
 series = {{EuroMLSys}},
 title = {Diagnosing and {Resolving}},
 url = {https://doi.org/10.1145/3721146.3721958},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:48:39Z},
 year = {2025}
}

@inproceedings{wang_effects_2025,
 abstract = {While virtual reality (VR) headsets have become more accessible, the lack of haptic feedback limits the realism of VR experiences. We present RingHaptics, a wristband that provides multi-modal haptic feedback for VR. RingHaptics uses a pair of rotating rings with arrays of voice coil actuators to deliver a wide range of haptic sensations, including pressure, vibration, and shear forces. The rings can rotate independently to create directional cues and twisting sensations. We conducted a user study to evaluate RingHaptics' ability to convey different haptic stimuli compared to a commercial wristband. Results show that RingHaptics significantly outperforms in realism and discriminability for most stimuli. We also demonstrate applications in VR gaming and training.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
