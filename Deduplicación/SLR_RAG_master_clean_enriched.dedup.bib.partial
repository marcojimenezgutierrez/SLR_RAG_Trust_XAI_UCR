@inproceedings{liang_aligning_2024,
 abstract = {Gaussian Splatting has emerged as a promising approach for 3D reconstruction and novel view synthesis, offering high-quality results with real-time rendering capabilities. However, existing methods often struggle with generalization to unseen scenes, particularly in handling complex geometries and occlusions. In this paper, we introduce a novel framework for generalizable amodal 3D Gaussian Splatting that enables robust reconstruction from sparse views without relying on scene-specific optimization. Our approach leverages a neural field conditioned on monocular depth and segmentation cues to predict Gaussian parameters, ensuring consistency across diverse environments. We demonstrate superior performance on benchmarks like Replica and ScanNet, achieving state-of-the-art results in novel view synthesis and depth estimation tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Liang},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3627673.3679713},
