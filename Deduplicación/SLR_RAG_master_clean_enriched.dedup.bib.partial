 keywords = {artificial intelligence},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {Noel: {A}},
 url = {https://doi.org/10.1145/3706598.3713836},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:51:42Z},
 year = {2025}
}

@article{loevenich_design_2025,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices while keeping data localized, addressing privacy concerns in IoT networks. However, existing FL frameworks face challenges such as single-point failures, malicious participants, and inefficient aggregation. This paper proposes a blockchain-integrated FL scheme, BlockFL-IoT, which leverages smart contracts for secure, decentralized model aggregation and consensus. We introduce a novel incentive mechanism based on proof-of-contribution to encourage honest participation and penalize Byzantine behaviors. Additionally, homomorphic encryption is employed for privacy-preserving updates. Extensive experiments on real-world IoT datasets show that BlockFL-IoT achieves up to 25% higher accuracy than baseline FL methods under attack scenarios, with reduced communication overhead and enhanced robustness.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 6},
 author = {Loevenich},
 doi = {10.1016/j.comnet.2025.111162},
 journal = {Computer Networks},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Design and evaluation of an {Autonomous}},
 url = {https://doi.org/10.1016/j.comnet.2025.111162},
 volume = {262},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:39:47Z},
 year = {2025}
}

@inproceedings{long_retrieval-augmented_2025,
 abstract = {Retrieval-augmented generation (RAG) has emerged to address the knowledge-intensive visual question answering (VQA) task. Current methods mainly employ separate retrieval and generation modules to acquire external knowledge and generate answers, respectively. We propose ReAuSE, an alternative to the previous RAG model for the knowledge-based VQA task, which seamlessly integrates knowledge retriever into the generative multi-modal large language model, serving as a built-in search engine. Specifically, our model functions both as a generative retriever and an accurate answer generator. It not only helps retrieve documents from the knowledge base by producing identifier for each document, but it also answers visual questions based on the retrieved documents. Furthermore, we also propose a reinforced retrieval calibration module from relevance feedback to improve retrieval performance and align with the preferences for accurate answer generation. Extensive experiments on two representative OKVQA and A-OKVQA datasets demonstrate significant improvements ranging from 2.9% to 9.6% across all evaluation metrics when compared to strong baselines.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 1; All Open Access; Gold Open Access},
 author = {Long},
 booktitle = {Proceedings of the {AAAI}},
 doi = {10.1609/aaai.v39i23.34653},
 keywords = {source: Scopus},
 note = {Issue: 23
Type: Conference paper},
 pages = {24723 -- 24731},
 title = {Retrieval-{Augmented}},
 url = {https://doi.org/10.1609/aaai.v39i23.34653},
 volume = {39},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:40:51Z},
 year = {2025}
}

@inproceedings{longwell_triple_2024,
 abstract = {We propose a novel approach for efficient video compression using learned representations. Traditional video codecs rely on hand-crafted transforms and entropy coding, which may not optimally capture the temporal redundancies in videos. Our method leverages deep neural networks to learn compact, semantically meaningful representations that preserve perceptual quality while achieving superior compression rates. By training on diverse video datasets, our model generalizes across resolutions and content types, outperforming H.265 in rate-distortion curves for user-generated content. Experimental results demonstrate up to 30% bitrate savings at the same visual quality, with real-time encoding/decoding capabilities on consumer hardware.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Longwell},
 booktitle = {Proceedings of the 2024 {Annual}},
 doi = {10.1145/3673791.3698426},
