@article{lavrinovics_multihal_2025,
 abstract = {Generalist robot policies are increasingly important for real-world robotics applications, as they enable robots to perform a wide range of tasks with minimal task-specific fine-tuning. However, building such policies remains challenging due to the need for diverse, high-quality data and effective training methods. In this work, we explore key factors that influence the performance of generalist robot policies. We conduct extensive experiments on a large-scale robotic manipulation dataset and identify several critical design choices, including data selection, augmentation strategies, and model architectures. Our findings reveal that careful curation of demonstration data and appropriate use of data augmentation significantly improve policy generalization. Furthermore, we demonstrate that incorporating auxiliary tasks during training enhances the robustness of the policies. These insights provide practical guidelines for developing more capable generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Lavrinovics},
 journal = {arXiv preprint arXiv …},
