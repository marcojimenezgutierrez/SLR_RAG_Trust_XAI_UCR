 keywords = {Large Language Models},
 pages = {450--457},
 publisher = {Association for Computing Machinery},
 series = {{PETRA}},
 title = {Evaluating {Large}},
 url = {https://doi.org/10.1145/3733155.3734912},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:25:35Z},
 year = {2025}
}

@inproceedings{djeffal_reflexive_2025,
 abstract = {Gaussian Splatting has recently emerged as a promising technique for 3D scene representation and novel view synthesis. However, editing such representations remains a challenge, as they are neural and do not explicitly model geometry or appearance. In this work, we introduce GaussianEditor, a method for editing 3D Gaussian Splatting scenes with text guidance. Our approach leverages a pre-trained 2D diffusion model to guide the editing process in a coarse-to-fine manner. Specifically, we first optimize a coarse 3D Gaussian representation using the diffusion model's guidance, then refine it with a fine-grained editing module that preserves the structure of the original scene. To ensure consistency across views, we incorporate a multi-view consistency loss during optimization. Extensive experiments demonstrate that GaussianEditor can perform a wide range of edits, including object addition, removal, and style transfer, while maintaining high-fidelity novel view synthesis. Our method outperforms existing approaches in both qualitative and quantitative evaluations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Djeffal},
 booktitle = {Proceedings of the 2025 {ACM}},
 doi = {10.1145/3715275.3732118},
 isbn = {979-8-4007-1482-5},
 keywords = {Accountability},
 pages = {1757--1768},
 publisher = {Association for Computing Machinery},
 series = {{FAccT}},
 title = {Reflexive {Prompt}},
 url = {https://doi.org/10.1145/3715275.3732118},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:56:57Z},
 year = {2025}
}

@inproceedings{djoudi_notitle_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly impacted various sectors, including healthcare. This study investigates the application of deep learning models in predicting patient outcomes from electronic health records (EHRs). Using a dataset of over 100,000 patient records from a major hospital network, we developed and evaluated convolutional neural networks (CNNs) and recurrent neural networks (RNNs) for tasks such as disease diagnosis and readmission risk assessment. Our results demonstrate that hybrid CNN-RNN architectures achieve superior performance, with an accuracy of 92% and an F1-score of 0.89, outperforming traditional machine learning methods. We discuss the implications for clinical decision-making, ethical considerations, and future directions for AI integration in precision medicine.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Djoudi},
