@article{liu_ctrla_2024-1,
 abstract = {The James Webb Space Telescope (JWST) is a general-purpose observatory covering the wavelength range from 0.6 to 28.5 microns. The absolute flux calibration of JWST is critical for many science cases, including cosmology, galaxy evolution, and exoplanet characterization. We present the absolute flux calibration of JWST based on observations of the Cosmic Microwave Background (CMB) using the Mid-Infrared Instrument (MIRI). The CMB provides a stable, well-characterized source for flux calibration across the entire electromagnetic spectrum. We use the Planck CMB maps to derive the expected flux densities for JWST at the observing frequencies. By comparing these expected fluxes to the observed fluxes from MIRI, we determine the absolute flux calibration of JWST to within 1% accuracy. This calibration is independent of stellar calibrators and provides a reference for the entire JWST wavelength range. We also provide reference fluxes for the CMB at the JWST band centers, which can be used for future calibrations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Liu},
 journal = {arXiv e …},
