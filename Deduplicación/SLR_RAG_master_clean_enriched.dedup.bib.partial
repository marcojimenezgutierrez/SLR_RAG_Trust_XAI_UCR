 journal = {2024 IEEE 48th Annual …},
 keywords = {Cognition},
 month = {jul},
 note = {ISSN: 2836-3795},
 pages = {988--997},
 title = {Textual {Differential}},
 url = {https://doi.org/10.1109/compsac61105.2024.00135},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:09:29Z},
 year = {2024}
}

@inproceedings{yu_what_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but aligning them with human preferences remains a critical challenge. Reinforcement Learning from Human Feedback (RLHF) has been a popular method for this alignment, yet it requires extensive human annotations, which are costly and time-consuming. Recent works have explored using LLMs themselves to generate preference data for RLHF, termed LLM-as-a-Judge. However, these approaches often suffer from biases in the judge LLM and lack diversity in the generated preferences. In this paper, we propose a novel framework, LLM4Align, that leverages multiple LLMs to collaboratively generate high-quality and diverse preference data for aligning other LLMs. Specifically, we design a multi-agent debate mechanism where different LLMs act as debaters and judges to iteratively refine and diversify the preference signals. Our empirical results on various benchmarks demonstrate that LLM4Align significantly outperforms existing methods in terms of alignment quality and efficiency, achieving better performance with fewer human annotations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Yu},
 booktitle = {Proceedings of the 39th {IEEE}},
