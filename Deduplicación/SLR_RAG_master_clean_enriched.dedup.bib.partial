 series = {{CHI}},
 title = {The {Last}},
 url = {https://doi.org/10.1145/3706598.3713307},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:47:00Z},
 year = {2025}
}

@article{habib_taxtajweez_2024,
 abstract = {Fake news has become a significant threat to society, spreading rapidly through social media platforms and influencing public opinion. Traditional fake news detection methods often rely on linguistic features or network analysis, but they struggle with evolving tactics used by malicious actors. This paper proposes a novel approach that integrates knowledge graphs with large language models (LLMs) to enhance fake news detection. By constructing knowledge graphs from news articles and leveraging the reasoning capabilities of LLMs, our method captures semantic relationships and contextual nuances that are often missed by conventional techniques. We evaluate our approach on benchmark datasets and demonstrate significant improvements in accuracy and robustness compared to state-of-the-art methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
