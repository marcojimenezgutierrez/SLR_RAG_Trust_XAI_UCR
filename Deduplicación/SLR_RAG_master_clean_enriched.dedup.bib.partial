 title = {Chunkrag: {Novel}},
 url = {https://arxiv.org/abs/2410.19572},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:43:14Z},
 year = {2024}
}

@inproceedings{singh_finqapt_2024,
 abstract = {Personal fabrication (PF) enables end-users to create customized artifacts, but designing PF activities for children with disabilities remains underexplored. We conducted a three-phase study with 15 children with disabilities (ages 7-12) and their caregivers to understand their needs and design PF activities. In the first phase, we identified barriers and opportunities through interviews and observations. In the second phase, we co-designed PF kits with participants, focusing on adaptability, safety, and engagement. In the third phase, we evaluated the kits in workshops, measuring usability, enjoyment, and learning outcomes. Our findings reveal that children with disabilities benefit from modular, multi-sensory PF activities that accommodate varying motor and cognitive abilities. We contribute a set of design guidelines and example kits to support inclusive PF education.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Singh},
 booktitle = {Proceedings of the 5th {ACM}},
 doi = {10.1145/3677052.3698682},
