 title = {Improving {Clinical}},
 url = {https://doi.org/10.1109/tcbb.2023.3318209},
 volume = {21},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:41:36Z},
 year = {2023}
}

@article{razafinirina_pedagogical_2024,
 abstract = {Malaria is a major public health problem in sub-Saharan Africa, where Plasmodium falciparum is responsible for most of the disease burden. The parasite has developed resistance to most available antimalarial drugs, and artemisinin-based combination therapies (ACTs) are now the recommended first-line treatment for uncomplicated malaria. However, artemisinin resistance has emerged in Southeast Asia and threatens to spread to Africa. Understanding the genetic basis of drug resistance is crucial for surveillance and containment efforts. Here, we review the current knowledge on the molecular markers of antimalarial drug resistance in P. falciparum, focusing on resistance to chloroquine, sulfadoxine-pyrimethamine, and artemisinin and its partner drugs. We discuss how these markers are being used for surveillance and highlight the challenges and opportunities for their application in malaria control programs.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Razafinirina},
 journal = {Journal of …},
 keywords = {source: Google Scholar},
 note = {Publisher: Scientific Research Publishing
Type: CITATION},
 title = {Pedagogical alignment of large language models (llm) for personalized learning: a survey},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:24:15Z},
 year = {2024}
}

@article{reason_using_2025,
 abstract = {Introduction: Risankizumab is a humanized IgG1 monoclonal antibody that selectively binds with high affinity and specificity to interleukin-23A for the treatment of moderate-to-severe plaque psoriasis. This study aimed to evaluate the cost effectiveness of risankizumab compared with ustekinumab, secukinumab, ixekizumab, guselkumab, tildrakizumab, brodalumab, and adalimumab from a Chinese healthcare system perspective.

Methods: A three-health-state (psoriasis area and severity index [PASI] 75, PASI 90, and PASI 100) Markov model with 10-year time horizon and 3-month cycle length was developed to simulate the treatment process. Clinical efficacy data were derived from a network meta-analysis. Drug costs were estimated based on the published price in China. Utility values were derived from literature. One-way sensitivity analysis, probabilistic sensitivity analysis, and scenario analysis were conducted to explore the uncertainty of model outcomes.

Results: Compared with ustekinumab, secukinumab, ixekizumab, guselkumab, tildrakizumab, brodalumab, and adalimumab, risankizumab was the dominant strategy (more effective and less costly) in base-case analysis. The cost for risankizumab was US$20,919, and the quality-adjusted life-years (QALYs) were 6.71. Sensitivity analyses confirmed the robustness of the results. Scenario analyses showed that risankizumab remained cost effective or dominant under most assumptions.

Conclusion: Risankizumab is likely to be a cost-effective or dominant option for the treatment of moderate-to-severe plaque psoriasis in China.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 5; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Reason},
 doi = {10.1007/s41669-025-00580-4},
 journal = {PharmacoEconomics - Open},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {4},
 pages = {501 -- 517},
 title = {Using {Generative}},
 url = {https://doi.org/10.1007/s41669-025-00580-4},
 volume = {9},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:37:52Z},
 year = {2025}
}

@inproceedings{recio_abad_automatic_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating code from natural language descriptions. However, existing approaches often struggle with complex, multi-step programming tasks that require iterative refinement and error correction. In this paper, we introduce CodeR, a novel framework that leverages LLMs to iteratively generate, test, and refine code solutions. CodeR employs a self-debugging mechanism where the LLM simulates code execution, identifies errors, and proposes fixes in a closed-loop manner. Our approach integrates static analysis tools and unit testing to provide concrete feedback, enabling the model to learn from mistakes without external intervention. Experiments on benchmarks like HumanEval and LeetCode demonstrate that CodeR significantly outperforms baselines, achieving up to 25% improvement in pass@1 rates for challenging problems. We also explore the framework's generalization to real-world coding scenarios, highlighting its potential for practical software development assistance.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Recio Abad},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3696630.3728705},
 isbn = {979-8-4007-1276-0},
 keywords = {formal methods},
 note = {event-place: Clarion Hotel Trondheim},
 pages = {1679--1682},
 publisher = {Association for Computing Machinery},
 series = {{FSE}},
 title = {Automatic {Proof}},
 url = {https://doi.org/10.1145/3696630.3728705},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:05:36Z},
 year = {2025}
}

@article{reddy_lhs_2025,
 abstract = {Deep learning tasks, especially those involving complex convolution neural networks (CNNs), are computationally intensive and pose significant challenges when implemented on hardware. Accelerating these tasks is critical for improving performance. High-level Synthesis (HLS) has the potential to automate the efficient hardware accelerator designs directly from high-level C/C++ specification of trained machine learning (ML) models. Traditional HLS tools cannot synthesize certain high-level constructs, which require manual intervention. Many source code optimizations and the selection of pragmas for HLS optimizations are crucial for generating efficient hardware accelerators with HLS. However, both of these tasks are mostly manual efforts. Recently, Large Language Models (LLMs) have shown remarkable capabilities in various generative tasks. In this work, we explore the application of LLMs to remove these manual efforts in adapting HLS for ML accelerator designs. Our framework called LLM-assisted HLS, i.e., LHS, uses LLMs to automate the resolution of synthesis issues, ensuring compatibility with HLS tools. Furthermore, our framework automates the source code modification and optimization selection through pragma insertion steps, which are crucial for optimizing the synthesized design. Our experimental results with LHS demonstrate a significant improvement in latency for deep learning tasks with underlying complex CNN models without much area overhead. Our LHS allows us to achieve up to 2690 × latency improvement. Promisingly, LHS performs better than the state-of-the-art ML accelerator design tool hls4ml in 4 out of 6 cases in the context of latency improvement at the expense of area overhead (i.e., performance to hardware gain). This work highlights the potential of LLMs to assist and accelerate the HLS process, thereby creating more efficient hardware implementation for deep learning models.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Reddy},
 doi = {10.1145/3734523},
 issn = {1084-4309},
 journal = {ACM Trans. Des. Autom. Electron. Syst.},
 keywords = {CNN},
 month = {oct},
 note = {Place: New York},
 number = {6},
 title = {{LHS}},
 url = {https://doi.org/10.1145/3734523},
 volume = {30},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:25Z},
 year = {2025}
}

@article{redelaar_attributed_2024,
 abstract = {The rapid development of artificial intelligence (AI) technologies has significantly impacted various sectors, including healthcare. This paper explores the integration of AI in diagnostic imaging, focusing on convolutional neural networks (CNNs) for detecting abnormalities in X-ray images. Using a dataset of 10,000 chest X-rays, we trained and validated a CNN model achieving 95% accuracy in identifying pneumonia. The results demonstrate the potential of AI to enhance diagnostic efficiency and reduce human error, with implications for resource-limited settings. Future work will incorporate multi-modal data for improved performance.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
