@article{yusuf_rag-based_2024,
 abstract = {Federated Learning (FL) has emerged as a promising approach for privacy-preserving machine learning, particularly in healthcare where data sensitivity is paramount. This paper provides a comprehensive survey of FL applications in healthcare, focusing on challenges such as data heterogeneity, communication efficiency, and security. We review key techniques, including model aggregation methods, differential privacy mechanisms, and secure multi-party computation. Case studies in disease prediction, medical imaging, and personalized treatment are discussed, along with future directions for integrating FL with edge computing and blockchain to enhance scalability and trustworthiness in healthcare systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
