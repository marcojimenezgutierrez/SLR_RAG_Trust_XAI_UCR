 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:50:06Z},
 year = {2024}
}

@inproceedings{thakur_assessing_2025,
 abstract = {Personal fabrication tools, such as 3D printers and laser cutters, have become increasingly accessible, enabling users to create physical objects from digital designs. However, the design space of personal fabrication remains underexplored, particularly in terms of how users interact with these tools and the challenges they face. This paper presents a systematic review of 128 publications from 2013 to 2023 that investigate user interactions with personal fabrication tools. We identify key themes in user needs, tool affordances, and design challenges, and propose a framework for understanding the personal fabrication ecosystem. Our findings highlight opportunities for improving tool usability, supporting creative expression, and addressing accessibility barriers. This work contributes to the HCI community by synthesizing existing research and guiding future innovations in personal fabrication.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
