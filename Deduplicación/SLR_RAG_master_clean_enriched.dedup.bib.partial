@article{qu_pncd_2025,
 abstract = {Multimodal learning has achieved remarkable success in various tasks by integrating information from multiple modalities. However, existing methods often struggle with the challenge of aligning and fusing heterogeneous data effectively, especially when dealing with noisy or incomplete inputs. In this paper, we propose a novel deep multimodal fusion framework that leverages cross-modal attention mechanisms to dynamically weigh and integrate features from different modalities. Our approach introduces a hierarchical fusion strategy that captures both local and global interactions, enabling robust representation learning. Extensive experiments on benchmark datasets for tasks such as visual question answering, emotion recognition, and medical image analysis demonstrate that our method outperforms state-of-the-art baselines, achieving significant improvements in accuracy and generalization. We also provide insights into the interpretability of the fusion process through attention visualization.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
