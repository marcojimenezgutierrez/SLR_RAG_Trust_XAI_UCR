 year = {2025}
}

@inproceedings{cai_2nd_2024,
 abstract = {Spoken language technologies have made significant progress in recent years, but they still struggle with robustness to variations in speaking style, accent, and background noise. This paper investigates the use of large language models (LLMs) for improving automatic speech recognition (ASR) systems through a novel approach called LLM-guided ASR fine-tuning. We propose a method that leverages the contextual understanding of LLMs to guide the fine-tuning of an end-to-end ASR model on diverse speech data. Our experiments on the LibriSpeech dataset demonstrate that this approach yields substantial improvements in word error rate (WER) under noisy conditions, achieving up to 15% relative reduction compared to baseline models. Furthermore, we analyze the impact of different LLM architectures and prompting strategies on the distillation process, providing insights into the trade-offs between model size and performance.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Cai},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/SLT61566.2024.10832299},
 keywords = {Accuracy},
