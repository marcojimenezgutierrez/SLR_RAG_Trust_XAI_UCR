@article{wang_multi-agent_2025,
 abstract = {This paper proposes a novel deep learning-based approach for fault diagnosis in power distribution systems using graph neural networks (GNNs). The method models the power grid as a graph where nodes represent buses and edges represent transmission lines, incorporating both topological and electrical features. By leveraging GNNs, the model captures spatial dependencies and temporal dynamics from phasor measurement unit (PMU) data. Experimental results on the IEEE 33-bus distribution system demonstrate that the proposed method achieves 98.5% accuracy in identifying fault types and locations, outperforming traditional machine learning techniques by 15%. The approach enhances grid reliability and supports real-time decision-making for smart grid operations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
