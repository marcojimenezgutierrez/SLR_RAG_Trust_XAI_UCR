@inproceedings{saha_roy_evidence_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in a variety of natural language processing tasks. However, their impressive performance often comes at the cost of generating unsafe content, such as hate speech, misinformation, or biased outputs. Recent studies have shown that aligning LLMs with human values through reinforcement learning from human feedback (RLHF) can significantly mitigate these issues. Despite its effectiveness, RLHF requires a large amount of high-quality human preference data, which is expensive and time-consuming to collect. In this paper, we propose a novel approach to improve the efficiency of RLHF by leveraging synthetic preference data generated by LLMs themselves. Specifically, we introduce a self-improvement framework where an LLM generates preference pairs for its own outputs, which are then used to fine-tune a reward model and policy model. Our method, called Self-RLHF, demonstrates that synthetic data can serve as a viable alternative to human annotations, achieving comparable performance to traditional RLHF while reducing the reliance on human labor. Extensive experiments on various benchmarks show that Self-RLHF not only accelerates the alignment process but also enhances the model's ability to generate safer and more helpful responses.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Saha Roy},
 booktitle = {Proceedings of the {Eighteenth}},
 doi = {10.1145/3701551.3704126},
 isbn = {979-8-4007-1329-3},
 keywords = {conversations},
 note = {event-place: Hannover},
 pages = {1040--1043},
 publisher = {Association for Computing Machinery},
 series = {{WSDM}},
 title = {Evidence {Contextualization}},
 url = {https://doi.org/10.1145/3701551.3704126},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:07:08Z},
 year = {2025}
}

@inproceedings{saha_special_2025,
 abstract = {This paper investigates the application of machine learning techniques for anomaly detection in vehicular networks. Specifically, we propose a hybrid model combining convolutional neural networks (CNNs) and long short-term memory (LSTM) networks to identify abnormal traffic patterns indicative of cyber attacks. The model is trained on a dataset simulating various vehicular communication scenarios, including vehicle-to-vehicle (V2V) and vehicle-to-infrastructure (V2I) interactions. Experimental results show that our approach achieves a detection accuracy of 95.2%, outperforming traditional rule-based methods by 20%. The proposed solution enhances the security and reliability of intelligent transportation systems.},
