 series = {{LAK}},
 title = {Generative {Artificial}},
 url = {https://doi.org/10.1145/3636555.3636856},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:15:35Z},
 year = {2024}
}

@article{yan_multimodal_2025,
 abstract = {With the development of unmanned aerial vehicle (UAV) technology, the application of UAV in various fields is becoming more and more extensive. However, due to the limitation of shooting angle and shooting height, the target in UAV image is small and the background is complex, which brings great challenges to small target detection. In order to solve the above problems, this paper proposes an improved YOLOv5 model for small target detection in UAV images. Firstly, the C3 module in the backbone network is replaced by the C2f module to enhance the feature extraction ability of the model. Secondly, the coordinate attention (CA) mechanism is introduced into the neck network to enhance the model's attention to small targets. Thirdly, the loss function is improved by introducing the Wise-IoU (WIoU) loss function to improve the model's detection accuracy for small targets. Finally, experiments are carried out on the VisDrone2019 dataset, and the experimental results show that the improved model has higher detection accuracy and better detection effect for small targets in UAV images compared with the original YOLOv5 model.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
