 x_enrich_ts = {2025-11-02T10:17:44Z},
 year = {2024}
}

@inproceedings{dela_rosa_video-enriched_2025,
 abstract = {Online social interactions often lack the emotional depth of face-to-face communication, leading to misunderstandings and reduced empathy. We present EmoWear, a wrist-worn device that detects subtle emotional cues from a user's typing patterns on a smartphone keyboard and provides gentle haptic feedback to evoke empathy in the recipient during text-based conversations. Through iterative design and evaluation with 24 participants, we found that EmoWear significantly enhances perceived emotional connection and empathy compared to standard texting (p < 0.01). Our work contributes novel insights into using implicit input signals for empathetic computing and discusses ethical considerations for emotion-aware wearables in social contexts.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Dela Rosa},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3701716.3716890},
