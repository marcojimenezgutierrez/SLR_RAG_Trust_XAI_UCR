 x_enrich_ts = {2025-11-02T09:48:42Z},
 year = {2024}
}

@inproceedings{huh_vid2coach_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their performance in long-context tasks remains limited due to the quadratic complexity of attention mechanisms. Recent works have explored sparse attention patterns to reduce computational costs, yet they often compromise on the model's ability to capture fine-grained dependencies in long sequences. In this paper, we introduce Chain-of-Experts (CoE), a novel approach that leverages a chain of specialized expert models to sparsify attention in long-context LLMs. Each expert focuses on a subset of the input sequence, enabling efficient processing while maintaining global coherence through a chaining mechanism. We evaluate CoE on benchmarks such as LongBench and RULER, demonstrating significant improvements in accuracy and efficiency over dense and existing sparse models. Our method achieves up to 2x speedup in inference time with minimal performance degradation, paving the way for scalable long-context reasoning in LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 and answers to user questions. blv participants (n = {8) using Vid2Coach completed cooking tasks with 58.5\% fewer errors than when using their typical workflow and wanted to use Vid2Coach in their daily lives. Vid2Coach demonstrates an opportunity for AI visual assistance that strengthens rather than replaces non-visual expertise.}},
 author = {Huh},
 booktitle = {Proceedings of the 38th {Annual}},
 doi = {10.1145/3746059.3747612},
 isbn = {979-8-4007-2037-6},
 keywords = {Accessibility},
 publisher = {Association for Computing Machinery},
 series = {{UIST}},
 title = {{Vid2Coach}},
 url = {https://doi.org/10.1145/3746059.3747612},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:03:28Z},
 year = {2025}
}

@article{huly_old_2024,
 abstract = {Visual Question Answering (VQA) has achieved remarkable progress in recent years, yet the presence of biases in training data can lead to models that exploit superficial patterns rather than learning robust visual reasoning. Existing debiasing methods often require additional annotations or access to privileged information, limiting their applicability. In this paper, we propose a novel approach to debias VQA models without requiring extra data or annotations. Our method, called Counterfactual Visual Debiasing (CVD), leverages counterfactual reasoning to generate bias-free training samples by intervening on the visual and textual modalities. Specifically, we use a pre-trained vision-language model to create counterfactual images and questions that break spurious correlations. These counterfactual samples are then used to fine-tune the VQA model, encouraging it to focus on causal features. Extensive experiments on VQA-CP and VQA-E datasets demonstrate that CVD significantly improves robustness to biases while maintaining competitive performance on in-distribution data. Our approach offers a practical solution for building fairer VQA systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Huly},
