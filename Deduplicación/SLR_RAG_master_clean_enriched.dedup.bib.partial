@inproceedings{hidayaturrahman_retrieval-augmented_2024,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly impacted various sectors, including education. In the context of higher education, AI-driven tools are increasingly being integrated to enhance teaching and learning processes. This study explores the integration of AI in higher education, focusing on its potential to personalize learning experiences and improve student outcomes. Through a comprehensive review of existing literature and case studies from leading universities, we identify key benefits such as adaptive learning platforms, automated assessment systems, and intelligent tutoring systems. However, challenges including data privacy concerns, ethical implications, and the digital divide are also examined. The findings suggest that while AI holds transformative potential, its successful implementation requires careful consideration of pedagogical alignment and institutional readiness. Recommendations for policymakers and educators are provided to foster equitable and effective AI adoption in higher education.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {{Hidayaturrahman}},
 booktitle = {2024 {International}},
 doi = {10.1109/ICIMCIS63449.2024.10956838},
