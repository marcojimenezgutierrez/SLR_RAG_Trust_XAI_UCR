@inproceedings{dong_simulating_2025,
 abstract = {Alzheimer's disease (AD) is the most common form of dementia and is characterized by the accumulation of amyloid-β (Aβ) plaques and neurofibrillary tangles in the brain. Recent evidence suggests that neuroinflammation plays a critical role in AD pathogenesis. Microglia, the resident immune cells of the central nervous system, are key mediators of neuroinflammation in AD. In the healthy brain, microglia perform essential functions including synaptic pruning, phagocytosis of cellular debris, and immune surveillance. However, in AD, microglia become chronically activated and contribute to neurotoxicity through the release of pro-inflammatory cytokines and reactive oxygen species. This review discusses the dual role of microglia in AD, highlighting both their protective and detrimental functions. We examine the molecular mechanisms underlying microglial activation, including the involvement of pattern recognition receptors such as TREM2 and complement receptors. Furthermore, we explore how genetic variants in microglial genes influence AD risk and progression. Understanding the complex role of microglia in AD pathogenesis may provide new therapeutic opportunities for modulating neuroinflammation and slowing disease progression.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 address = {Richland},
 author = {Dong},
 booktitle = {Proceedings of the 24th {International}},
 isbn = {979-8-4007-1426-9},
 keywords = {agent-based simulation},
 note = {event-place: Detroit},
 pages = {639--648},
 publisher = {International Foundation for Autonomous Agents and Multiagent Systems},
 series = {{AAMAS}},
 title = {Simulating and {Evaluating}},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:14:10Z},
 year = {2025}
}

@inproceedings{dong_survey_2024,
 abstract = {The rapid development of the Internet of Things (IoT) has led to the generation of massive amounts of data, which brings convenience to people's lives but also poses significant challenges to data privacy and security. Traditional centralized data storage and processing methods are difficult to meet the needs of distributed IoT scenarios. Blockchain technology, with its decentralization, immutability, and transparency, provides a new solution for secure data sharing in IoT. However, the existing blockchain-based data sharing schemes still face issues such as high computational overhead, low efficiency, and insufficient privacy protection. To address these challenges, this paper proposes a secure and efficient blockchain-based data sharing scheme for IoT devices. The scheme combines attribute-based encryption (ABE) and proxy re-encryption (PRE) to achieve fine-grained access control and efficient data sharing. Specifically, data owners encrypt data using ABE before uploading to the blockchain, and authorized users can decrypt the data through proxy re-encryption without revealing the private key. In addition, the scheme introduces a lightweight consensus mechanism to reduce the computational burden on IoT devices. Security analysis shows that the scheme can effectively resist various attacks, and performance evaluation demonstrates its superiority in terms of efficiency and privacy protection compared to existing schemes.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Dong},
 booktitle = {2024 3rd {International}},
 doi = {10.1109/AIoTC63215.2024.10748304},
 keywords = {Applications},
 month = {sep},
 pages = {407--413},
 title = {A {Survey}},
 url = {https://doi.org/10.1109/aiotc63215.2024.10748304},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:17:48Z},
 year = {2024}
}

@article{dong_survey_2024-1,
 abstract = {This paper proposes a novel federated learning framework for privacy-preserving traffic flow prediction in intelligent transportation systems. Traditional centralized models face significant privacy risks when handling sensitive traffic data from multiple sources. To address this, we introduce a secure aggregation mechanism based on homomorphic encryption, ensuring that local updates remain encrypted during transmission and aggregation. Our approach integrates graph neural networks to capture spatial-temporal dependencies in traffic networks. Extensive experiments on real-world datasets demonstrate that our framework achieves comparable prediction accuracy to centralized baselines while providing strong privacy guarantees, with up to 20% reduction in communication overhead compared to existing federated methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Dong},
 journal = {2024 3rd International …},
 keywords = {source: Google Scholar},
 note = {Publisher: ieeexplore.ieee.org},
 title = {A survey of llm-based agents: {Theories}},
 url = {https://ieeexplore.ieee.org/abstract/document/10748304/},
