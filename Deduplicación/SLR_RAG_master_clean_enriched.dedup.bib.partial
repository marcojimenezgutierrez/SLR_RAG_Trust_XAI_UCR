 title = {Educational {Material}},
 url = {https://doi.org/10.1109/ialp68296.2024.11156564},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:14:11Z},
 year = {2025}
}

@inproceedings{rani_augmenting_2024,
 abstract = {Artificial intelligence (AI) is increasingly integrated into decision-making processes across various sectors, raising significant ethical concerns regarding bias, transparency, and accountability. This paper presents a comprehensive review of ethical challenges in AI systems, with a focus on societal impacts. We analyze key issues such as algorithmic discrimination, privacy erosion, and the digital divide, drawing from real-world examples in healthcare, finance, and criminal justice. A proposed ethical framework is introduced, emphasizing principles of fairness, explainability, and human oversight to guide AI development. The framework incorporates stakeholder engagement and continuous auditing mechanisms to mitigate risks and promote equitable outcomes. Findings suggest that interdisciplinary collaboration between technologists, ethicists, and policymakers is essential for responsible AI governance.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Rani},
