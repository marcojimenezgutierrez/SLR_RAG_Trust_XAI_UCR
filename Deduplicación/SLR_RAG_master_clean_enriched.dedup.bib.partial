 pages = {1607--1619},
 publisher = {Association for Computing Machinery},
 series = {{ASE}},
 title = {On the {Evaluation}},
 url = {https://doi.org/10.1145/3691620.3695529},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:49:55Z},
 year = {2024}
}

@inproceedings{yang_explaingen_2025,
 abstract = {Haptic feedback is a promising technology for enhancing user interaction with wearable devices, but its design often overlooks the needs of people with upper-body mobility impairments (UBMI). This work explores inclusive design principles for wearable haptics through a two-phase study involving 12 participants with UBMI. In Phase 1, we conducted semi-structured interviews to understand participants' experiences with existing haptic devices and identify barriers to accessibility. Findings revealed challenges such as inconsistent feedback perception due to varying motor control and the need for customizable intensity and placement. In Phase 2, we co-designed prototypes with participants, iterating on vibrotactile patterns, anatomical placement, and control mechanisms. Our results highlight three key design guidelines: (1) adaptive feedback modulation based on user motor capabilities, (2) multi-modal integration with visual and auditory cues, and (3) user-centric customization interfaces. These guidelines aim to foster more equitable haptic experiences, with implications for broader wearable technology adoption among diverse user groups.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Yang},
