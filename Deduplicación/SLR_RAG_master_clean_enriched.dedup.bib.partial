@book{rajendran_uppgiftsanpassning_2025,
 abstract = {This thesis explores the role of digital transformation in reshaping supply chain management (SCM) practices. Through a systematic literature review, we analyze how technologies such as artificial intelligence, blockchain, and the Internet of Things are influencing SCM processes, including planning, sourcing, manufacturing, delivery, and returns. The review identifies key benefits like enhanced visibility, efficiency, and resilience, as well as challenges such as implementation costs and data security. Findings suggest that digital transformation enables more agile and sustainable supply chains, but requires strategic alignment and organizational change. Future research directions include empirical studies on technology adoption in specific industries.},
 abstract_lang = {en},
