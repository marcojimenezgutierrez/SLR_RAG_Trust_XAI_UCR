@article{shojaee_federated_2025,
 abstract = {Gemini 1.5 is a new model family that builds on Gemini 1.0, our largest model to date, and demonstrates significant improvements in long-context understanding. Gemini 1.5 achieves state-of-the-art performance on a broad range of benchmarks, including Needle In A Haystack (NIAH), long-context versions of BIG-Bench Hard, and long-context versions of MMLU. We also introduce a new benchmark, MRCR (Multi-Query Retrieval on Context), to evaluate long-context retrieval. Gemini 1.5-Flash is a new model in the Gemini family that is optimized for efficiency and latency. It achieves competitive performance on a wide range of tasks while being significantly faster than Gemini 1.0 Pro. Gemini 1.5 models are available to developers and enterprise customers via the Gemini API in Google AI Studio and Vertex AI.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
