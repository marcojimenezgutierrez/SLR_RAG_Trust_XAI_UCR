@article{lin_scirgen_2025,
 abstract = {Social media platforms have become a primary source of information for many users, but the spread of misinformation poses significant challenges. In this paper, we propose a novel approach to detect misinformation by leveraging multimodal information from social media posts. Our method combines text analysis with image recognition to identify inconsistencies between the content and context. Experimental results on benchmark datasets demonstrate the effectiveness of our approach in improving detection accuracy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
