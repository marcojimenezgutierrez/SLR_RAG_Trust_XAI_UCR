 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:13:42Z},
 year = {2025}
}

@inproceedings{liu_opseval_2025,
 abstract = {Language models are powerful tools for a wide range of tasks, but their black-box nature makes it difficult to understand and control their behavior. We introduce ChainForge, a visual programming environment for building and testing LLM pipelines. ChainForge allows users to construct complex workflows by connecting LLM calls with data transformations, conditionals, and loops, all through a drag-and-drop interface. It supports rapid iteration by providing immediate feedback on outputs and enabling A/B testing of different prompts and models. We describe the design and implementation of ChainForge, and present case studies demonstrating its use in prompt engineering, hypothesis testing, and interactive applications. Our evaluation with 12 users shows that ChainForge significantly reduces the time and effort required for LLM experimentation compared to traditional coding approaches.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Liu},
 booktitle = {Proceedings of the 33rd {ACM}},
