@article{eghbali_-hallucinator_2024,
 abstract = {Recent work has shown that the phenomenon of grokking, where a model initially memorizes training data and then suddenly generalizes, can be induced by training on modular arithmetic tasks. We study the grokking phenomenon in the context of learning modular addition. We find that the generalization error decreases in a series of jumps, with the jumps corresponding to the learning of new algorithmic solutions. We show that the jumps can be predicted by a simple heuristic based on the compressibility of the learned representations. We also find that the learned representations are highly compressible, and that the compressibility increases as the model groks. Our results suggest that grokking is a form of compression, where the model learns to represent the training data in a more compact way, leading to better generalization.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Eghbali},
 journal = {arXiv preprint arXiv:2401.01701},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {De-{Hallucinator}},
 url = {https://arxiv.org/abs/2401.01701},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:27:26Z},
 year = {2024}
}

@inproceedings{ehl_supporting_2025,
 abstract = {Visual programming environments (VPEs) enable end-users to create data visualizations by composing visual modules, but their design space remains underexplored. We conducted a systematic review of 45 VPEs for data visualization and interviewed 12 experts to identify key design dimensions, including modularity, expressiveness, and usability. Based on these insights, we developed a design framework and prototyped three novel VPE interfaces to explore trade-offs in the design space. Our user study with 24 participants revealed preferences for hybrid approaches that balance visual simplicity with computational power. This work contributes a comprehensive understanding of VPE design and guidelines for future systems that empower non-experts in data visualization creation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Ehl},
 booktitle = {Proceedings of the 40th {ACM}},
 doi = {10.1145/3672608.3707798},
