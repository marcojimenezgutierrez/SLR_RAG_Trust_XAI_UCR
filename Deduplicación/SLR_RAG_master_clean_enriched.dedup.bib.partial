@inproceedings{al-zuraiqi_designing_2025,
 abstract = {Visual question answering (VQA) has achieved remarkable progress, yet the presence of biases in datasets and models poses significant challenges to fairness and generalization. While recent works have explored debiasing methods, they often overlook the interplay between different types of biases and the impact of spurious correlations on model robustness. In this paper, we systematically investigate bias mitigation in VQA from a multi-bias perspective, introducing a novel framework that disentangles and addresses linguistic, visual, and question-type biases. Our approach leverages adversarial training and counterfactual data augmentation to reduce reliance on spurious features, while preserving task performance. Extensive experiments on benchmark datasets like VQA-CP and VQA-X demonstrate that our method achieves superior bias reduction and improved out-of-distribution generalization compared to existing techniques. We further provide insights into bias propagation mechanisms and propose evaluation metrics tailored for multi-bias scenarios, paving the way for more equitable VQA systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Al-Zuraiqi},
 booktitle = {Proceedings of the 21st {International}},
 doi = {10.1145/3727582.3728687},
 isbn = {979-8-4007-1594-5},
 keywords = {alignment datasets},
