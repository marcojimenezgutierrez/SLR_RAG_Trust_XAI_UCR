@inproceedings{parikh_echoguide_2024,
 abstract = {Multimodal interfaces that combine visual, auditory, and tactile feedback are increasingly common, but they often exclude users with visual impairments (PVI) due to reliance on visual cues. We propose a framework for designing inclusive multimodal interfaces that prioritize accessibility from the outset. Through a series of user studies with 20 PVI participants, we evaluate the effectiveness of our framework in enhancing usability and satisfaction. Our findings reveal that integrating adaptive audio-haptic feedback significantly improves task completion rates by 35% compared to visual-only interfaces. We discuss implications for HCI practitioners and outline future directions for AI-driven personalization in accessible design.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
