 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:37:55Z},
 year = {2025}
}

@article{brehme_can_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their internal representations remain opaque. Recent work has demonstrated that LLMs store factual knowledge in a distributed manner, with individual neurons contributing to representations of specific facts. However, the scaling properties of this phenomenon---how the organization of factual knowledge evolves with model size---remain underexplored. In this work, we conduct a comprehensive empirical study of knowledge organization in LLMs spanning over 10 billion parameters. We introduce a novel metric, the Knowledge Capacity (KC), to quantify the amount of factual knowledge encoded in individual neurons. Our findings reveal that KC increases superlinearly with model size, indicating that larger models are not only more knowledgeable but also more efficient in how they encode facts. We further analyze the sparsity of knowledge representations, showing that larger models exhibit sparser, more modular encodings, where fewer neurons are responsible for representing a given fact. These results provide new insights into the emergent abilities of LLMs and suggest that scaling up model size enhances both the capacity and efficiency of knowledge storage.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Brehme},
 journal = {arXiv preprint arXiv:2504.20119},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Can {LLMs}},
 url = {https://arxiv.org/abs/2504.20119},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:17:47Z},
 year = {2025}
}

@inproceedings{breuer_data_2024,
 abstract = {Vision-language models (VLMs) have achieved remarkable success in various multimodal tasks. However, they often inherit and amplify societal biases present in their training data, leading to unfair outcomes, especially in tasks involving demographic attributes like gender, race, and age. Existing debiasing methods for VLMs are limited in scope, often focusing on specific biases or requiring access to model internals. In this paper, we propose a novel debiasing framework, Biased Prompt Debiasing (BPD), which mitigates biases in VLMs using only biased prompts during fine-tuning, without needing proprietary model details. BPD generates targeted biased prompts to elicit biased model responses, which are then used to counteract inherent biases through contrastive learning. We evaluate BPD on popular VLMs like CLIP and BLIP across multiple bias-sensitive benchmarks, including FairFace and CelebA. Results show significant reductions in bias metrics (up to 45% improvement in demographic parity) while preserving overall task performance. Our approach is simple, effective, and generalizable to black-box VLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Breuer},
 booktitle = {Proceedings of the 2024 {Annual}},
 doi = {10.1145/3673791.3698423},
