@inproceedings{noauthor_proceedings_2024-1,
 abstract = {The rapid development of information technology has led to the generation of massive amounts of data in various fields. Among these, educational data mining (EDM) has emerged as a promising approach to extract valuable insights from educational datasets. This paper proposes a novel framework for EDM that integrates deep learning techniques with traditional data mining methods to improve the accuracy of student performance prediction. The framework is evaluated on a real-world dataset from a higher education institution, demonstrating superior performance compared to baseline models. The results highlight the potential of this approach in enhancing personalized learning experiences and supporting educational decision-making.},
