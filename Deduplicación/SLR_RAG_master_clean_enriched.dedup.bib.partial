 year = {2025}
}

@inproceedings{lin_haprepair_2025,
 abstract = {Haptic feedback is essential for immersive virtual reality (VR) experiences, but current solutions often require bulky hardware or complex setups. This paper introduces HaptiCore, a compact, modular haptic system designed for easy integration into VR environments. HaptiCore leverages piezoelectric actuators to deliver high-fidelity vibrations and forces, enabling realistic touch sensations on various body parts. We describe the hardware architecture, including a central processing unit that supports real-time signal generation and synchronization with VR headsets. Through user studies, we evaluate HaptiCore's performance in tasks such as object manipulation and texture rendering, showing significant improvements in presence and task accuracy compared to baseline vibrotactile devices. Our system achieves low latency (<5ms) and high force output (up to 2N), making it suitable for consumer-grade VR applications. We also discuss software tools for developers to customize haptic patterns, paving the way for more accessible and expressive haptic interactions in VR.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
