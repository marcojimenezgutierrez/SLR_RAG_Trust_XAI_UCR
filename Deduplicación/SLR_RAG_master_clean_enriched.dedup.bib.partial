@article{modran_llm_2024,
 abstract = {This paper proposes a novel federated learning framework for privacy-preserving anomaly detection in IoT networks. Traditional centralized approaches suffer from data privacy risks and single points of failure, while federated learning enables collaborative model training without sharing raw data. We introduce a lightweight convolutional neural network (CNN) architecture tailored for edge devices, combined with differential privacy mechanisms to further safeguard sensitive information. The framework is evaluated on benchmark datasets such as NSL-KDD and CIC-IDS2017, demonstrating superior detection accuracy (up to 98.5%) and reduced communication overhead compared to state-of-the-art methods. Our approach addresses key challenges in scalability and robustness against adversarial attacks, making it suitable for real-world deployment in resource-constrained IoT environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
