@article{zhao_mdkag_2025,
 abstract = {With the accelerated digital transformation in education, the efficient integration of massive multimodal instructional resources and the support for interactive question answering (QA) remains a prominent challenge. This study introduces Multimodal Disciplinary Knowledge-Augmented Generation (MDKAG), a framework integrating retrieval-augmented generation (RAG) with a multimodal disciplinary knowledge graph (MDKG). MDKAG first extracts high-precision entities from digital textbooks, lecture slides, and classroom videos by using the Enhanced Representation through Knowledge Integration 3.0 (ERNIE 3.0) model and then links them into a graph that supports fine-grained retrieval. At inference time, the framework retrieves graph-adjacent passages, integrates multimodal data, and feeds them into a large language model (LLM) to generate context-aligned answers. An answer-verification module checks semantic overlap and entity coverage to filter hallucinations and triggers incremental graph updates when new concepts appear. Experiments on three university courses show that MDKAG reduces hallucination rates by up to 23% and increases answer accuracy by 11% over text-only RAG and knowledge-augmented generation (KAG) baselines, demonstrating strong adaptability across subject domains. The results indicate that MDKAG offers an effective route for scalable knowledge organization and reliable interactive QA in education.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Zhao},
 doi = {10.3390/app15169095},
 journal = {Applied Sciences (Switzerland)},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {16},
 title = {{MDKAG}},
 url = {https://doi.org/10.3390/app15169095},
 volume = {15},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:35:35Z},
 year = {2025}
}

@inproceedings{zhao_medrag_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, they often exhibit biases inherited from their training data, leading to unfair and discriminatory outputs. Mitigating such biases typically requires access to the model's internal parameters or retraining from scratch, which is computationally expensive and often impractical. In this paper, we propose FairDistil, a novel knowledge distillation framework designed to generate fair distilled models from potentially biased black-box teacher LLMs without accessing their parameters or training data. FairDistil leverages the teacher's outputs to guide the student model's training while incorporating fairness constraints through adversarial training and fairness-aware loss functions. This ensures that the distilled model not only mimics the teacher's performance but also reduces bias across multiple protected attributes. We evaluate FairDistil on several benchmark datasets for tasks such as sentiment analysis and toxicity detection, demonstrating significant bias reduction (up to 40% in disparity metrics) with only marginal performance drops compared to standard distillation baselines. Our approach is model-agnostic, scalable, and applicable to any API-accessible LLM, making it a practical solution for deploying fairer language models in resource-constrained settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhao},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3696410.3714782},
 isbn = {979-8-4007-1274-6},
 keywords = {decision support},
 note = {event-place: Sydney NSW},
 pages = {4442--4457},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {{MedRAG}},
 url = {https://doi.org/10.1145/3696410.3714782},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:22:17Z},
 year = {2025}
}

@inproceedings{zhao_model_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in various tasks, but they often exhibit biases inherited from their training data, leading to unfair outputs. Existing debiasing methods for LLMs primarily focus on post-hoc mitigation, which can be computationally expensive and may not fully address biases during fine-tuning. In this paper, we propose FairLLM, a novel framework that integrates adaptive bias correction directly into the fine-tuning process of LLMs. FairLLM dynamically identifies and corrects biases by leveraging a lightweight bias detector and an adaptive correction module, ensuring fairness without significantly compromising model performance. Our approach is model-agnostic and can be applied to various LLMs and downstream tasks. Extensive experiments on multiple datasets demonstrate that FairLLM achieves superior fairness metrics compared to state-of-the-art methods while maintaining competitive accuracy. Our work provides a practical and efficient solution for mitigating biases in LLMs during fine-tuning, paving the way for more equitable AI applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhao},
 booktitle = {Proceedings of the {Nineteenth}},
 doi = {10.1145/3705328.3748152},
