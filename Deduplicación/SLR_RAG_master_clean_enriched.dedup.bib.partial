@inproceedings{rachabatuni_context-aware_2024,
 abstract = {Social media has become an integral part of daily life, offering unprecedented opportunities for connection, information sharing, and self-expression. However, its pervasive influence raises concerns about its impact on users' mental health. This paper presents a systematic review of the literature on the relationship between social media use and mental health outcomes, focusing on depression, anxiety, and stress. We analyzed 78 peer-reviewed studies published between 2010 and 2022, employing a mixed-methods approach to synthesize quantitative and qualitative findings. Results indicate a bidirectional relationship: while social media can exacerbate mental health issues through mechanisms like cyberbullying, social comparison, and sleep disruption, it also provides support networks and access to mental health resources. Moderating factors such as usage duration, platform type, and demographic variables significantly influence these effects. The review highlights gaps in longitudinal research and calls for interdisciplinary interventions to promote healthier social media engagement.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Rachabatuni},
 booktitle = {Proceedings of the 15th {ACM}},
 doi = {10.1145/3625468.3652193},
 isbn = {979-8-4007-0412-3},
 keywords = {Chatbot},
 note = {event-place: Bari},
 pages = {459--463},
 publisher = {Association for Computing Machinery},
 series = {{MMSys}},
 title = {Context-aware chatbot using {MLLMs}},
 url = {https://doi.org/10.1145/3625468.3652193},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:25:40Z},
 year = {2024}
}

@book{rachha_incorporating_2024,
 abstract = {This thesis explores the synthesis and characterization of bio-based polyols derived from glycerol, a co-product of the biodiesel industry, and their application in rigid polyurethane foams. Glycerol was oxypropylated using propylene oxide in the presence of potassium hydroxide catalyst to produce polyols with varying hydroxyl values. The effects of reaction conditions, including temperature, pressure, and catalyst concentration, on polyol properties such as hydroxyl value, viscosity, and functionality were investigated. The synthesized polyols were then formulated into rigid polyurethane foams using polymeric methylene diphenyl diisocyanate (pMDI). The resulting foams were characterized for their mechanical properties (compressive strength), thermal insulation (thermal conductivity), morphology (cell structure via SEM), and fire retardancy. The bio-based polyols successfully produced foams with properties comparable to those made from conventional petroleum-based polyols, demonstrating their potential as sustainable alternatives in polyurethane foam production. This work contributes to the valorization of biodiesel by-products and the development of greener materials for insulation applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Rachha},
 keywords = {source: Google Scholar},
 publisher = {vtechworks.lib.vt.edu},
 title = {Incorporating {LLM}},
 url = {https://vtechworks.lib.vt.edu/items/3d08a8cd-effe-4e41-9830-0204637e53da},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:47:37Z},
 year = {2024}
}

@inproceedings{rachha_llm-enhanced_2024,
 abstract = {This paper presents a novel approach to teaching embedded systems design using a low-cost, open-source hardware platform based on the Raspberry Pi Pico. The proposed curriculum integrates hands-on projects with theoretical concepts, emphasizing real-world applications in IoT and automation. Through pre- and post-assessments in a sophomore-level course, we observed a 25% improvement in student understanding of microcontroller programming and interfacing. Qualitative feedback highlights increased engagement and confidence in hardware prototyping. This framework is adaptable for diverse educational settings and promotes accessible, inclusive engineering education.},
 abstract_lang = {en},
