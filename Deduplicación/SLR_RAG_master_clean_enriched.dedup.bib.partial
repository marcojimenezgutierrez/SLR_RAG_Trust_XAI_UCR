@inproceedings{ongris_towards_2024,
 abstract = {This paper proposes a new method for detecting fake news on social media using a combination of natural language processing and machine learning techniques. We utilize BERT for feature extraction and XGBoost for classification. The dataset consists of 10,000 news articles labeled as real or fake. Experimental results show that our model achieves an accuracy of 98.5%, outperforming baseline methods such as SVM and LSTM. The proposed approach is efficient and scalable for real-time fake news detection.},
