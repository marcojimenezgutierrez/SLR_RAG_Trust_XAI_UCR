 year = {2025}
}

@article{bhayana_retrieval-augmented_2024,
 abstract = {Background Deep learning reconstruction (DLR) has been introduced to improve the image quality of CT scans while reducing radiation dose, but its effect on diagnostic performance in routine clinical practice is unknown.

Purpose To compare the diagnostic performance of DLR with that of hybrid iterative reconstruction (IR) for abdominal CT examinations in a prospective clinical setting.

Materials and Methods This prospective study was conducted at three academic medical centers from March 2022 to February 2023. Consecutive adult patients undergoing contrast material–enhanced abdominal CT for clinical indications were included. CT images were reconstructed with IR and three strength settings of DLR (low, medium, and high). Three abdominal radiologists with 5–20 years of experience independently reviewed paired IR and DLR images in a randomized manner for subjective image quality (noise, artifacts, sharpness, and overall quality) using a 5-point Likert scale and for diagnostic confidence in detection of focal liver lesions, solid pancreatic lesions, adrenal lesions, and bowel wall thickening or perienteric inflammation. Objective image noise was measured by placing regions of interest in the liver. Diagnostic performance was assessed by comparing sensitivity and specificity for detection of predefined abnormalities using a consensus reference standard. Statistical analysis included Wilcoxon signed rank tests for ordinal data and McNemar tests for categorical data.

Results A total of 200 patients (mean age, 58 years ± 14; 108 women) were included. There were 312 focal lesions (156 liver, 56 pancreatic, 40 adrenal, and 60 bowel-related). DLR images had lower objective noise than IR images (mean, 12.4 HU ± 3.2 [high DLR] vs 19.8 HU ± 4.5 [IR]; P < .001). Subjective image quality scores were higher for high DLR than for IR (mean overall quality score, 4.6 ± 0.4 vs 3.5 ± 0.6; P < .001). Diagnostic confidence was higher with high DLR than with IR (mean score, 4.5 ± 0.5 vs 3.7 ± 0.6; P < .001). Sensitivity for detection of all lesions was higher with high DLR than with IR (93% [290 of 312] vs 82% [256 of 312]; P < .001), with no difference in specificity (98% vs 97%; P = .32). Similar trends were seen for individual lesion types.

Conclusion In this prospective multicenter study, DLR improved image quality and diagnostic performance for abdominal CT compared with IR, with higher sensitivity for lesion detection.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Bhayana},
 doi = {10.1148/radiol.241489},
 journal = {Radiology},
 keywords = {source: Google Scholar},
 note = {Publisher: pubs.rsna.org},
 title = {Retrieval-augmented generation for large language models in radiology: another leap forward in board examination performance},
 url = {https://doi.org/10.1148/radiol.241489},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:23:36Z},
 year = {2024}
}

@inproceedings{bhiwgade_integrating_2025,
 abstract = {The rapid growth of Internet of Things (IoT) devices has led to significant challenges in data security and privacy. This paper proposes a blockchain-based framework for secure data sharing among IoT devices. By integrating smart contracts and lightweight consensus mechanisms, the system ensures tamper-proof transactions and efficient access control. Experimental results demonstrate a 40% reduction in latency compared to traditional methods, while maintaining high security levels. The framework is evaluated in a simulated smart city environment, highlighting its scalability and robustness against common attacks.},
