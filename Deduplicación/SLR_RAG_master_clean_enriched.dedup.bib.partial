 year = {2025}
}

@inproceedings{gao_fast_2025,
 abstract = {Machine learning models, especially deep neural networks, have achieved remarkable success in various visual recognition tasks. However, these models often exhibit biases towards certain demographic groups, leading to unfair outcomes. In this paper, we investigate effective strategies for mitigating bias in visual recognition models. We propose a novel framework that combines data augmentation, adversarial training, and post-processing techniques to achieve fairness. Our experiments on multiple datasets demonstrate significant improvements in fairness metrics without substantial degradation in overall accuracy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Gao},
