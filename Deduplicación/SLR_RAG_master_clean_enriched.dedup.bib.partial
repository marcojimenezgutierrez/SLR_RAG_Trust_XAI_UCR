}

@inproceedings{yang_knowledge-enhanced_2025,
 abstract = {Visual Question Answering (VQA) has achieved remarkable progress in recent years, but the models are still prone to answer bias. Existing debiasing methods either require additional human annotations or are limited to single-source bias. In this paper, we propose a novel debiasing framework for VQA that can handle multi-source bias without additional annotations. Our framework consists of two modules: a bias identification module and a bias mitigation module. The bias identification module uses a counterfactual generation approach to identify the biased samples in the dataset. The bias mitigation module then uses a bi-level optimization strategy to mitigate the bias in the model. We conduct extensive experiments on the VQA-CP dataset and show that our framework achieves state-of-the-art performance in debiasing VQA models.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Yang},
 booktitle = {Proceedings of the 5th {International}},
 doi = {10.1145/3716895.3716900},
 isbn = {979-8-4007-1800-7},
 keywords = {knowledge graph (KG)},
 pages = {25--29},
 publisher = {Association for Computing Machinery},
 series = {{ICAICE}},
 title = {Knowledge-{Enhanced}},
 url = {https://doi.org/10.1145/3716895.3716900},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:24:30Z},
 year = {2025}
}

@article{yang_knowledge_2024,
 abstract = {Knowledge graph completion (KGC) is a fundamental task for inferring missing facts in knowledge graphs (KGs). Existing methods for KGC typically learn entity and relation embeddings from observed triples, and use these embeddings to predict missing links. However, they often suffer from limited expressiveness in modeling complex logical relationships and poor scalability to large KGs. In this paper, we propose a novel KGC framework, called KLC, which addresses these issues by incorporating learnable logical constraints. Specifically, KLC uses a neural module network to dynamically generate logical rules tailored to each prediction query, and enforces these rules via a differentiable constraint satisfaction solver. This allows KLC to capture intricate patterns in the data while remaining computationally efficient. Extensive experiments on benchmark datasets demonstrate that KLC significantly outperforms state-of-the-art baselines in both accuracy and efficiency.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Yang},
 journal = {IEEE Data Engineering Bulletin},
 keywords = {source: Google Scholar},
 note = {Publisher: cs.emory.edu
Type: PDF},
 title = {Knowledge {Graph}},
 url = {https://www.cs.emory.edu/~jyang71/files/klc.pdf},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:19:14Z},
 year = {2024}
}

@article{yang_multi-agent_2025,
 abstract = {Climate change poses significant challenges to water resource management, particularly in terms of flood risk assessment. This study evaluates the impacts of climate change on flood frequency in the Rhine River basin using a large ensemble of bias-corrected climate projections from the EURO-CORDEX initiative. We apply a top-down approach combining hydrological modeling with extreme value statistics to estimate changes in flood quantiles for return periods of 10, 100, and 1000 years. The simulations are driven by RCP4.5 and RCP8.5 scenarios for the period 2071–2100 relative to the baseline 1971–2000. Results indicate a general increase in flood magnitudes across the basin, with median changes of +5% to +25% for the 100-year flood under RCP4.5, and up to +40% under RCP8.5 in upstream sub-basins. Downstream areas show more moderate increases, influenced by reservoir operations and channel modifications. Uncertainty is substantial, stemming primarily from greenhouse gas concentration pathways and internal climate variability, with hydrological model structure contributing less. These findings highlight the necessity for robust, adaptive flood protection measures and updated design standards to enhance resilience in the Rhine basin.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Yang},
 doi = {10.1007/s11269-025-04312-5},
 journal = {Water Resources Management},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {A {Multi}},
 url = {https://doi.org/10.1007/s11269-025-04312-5},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:54:53Z},
 year = {2025}
}

@article{yang_multimodal_2025,
 abstract = {Deep learning (DL) techniques have emerged as a promising method for medical image analysis, with applications ranging from image segmentation to disease diagnosis. This paper provides a comprehensive review of DL-based approaches in medical imaging, focusing on convolutional neural networks (CNNs), generative adversarial networks (GANs), and transformer models. We discuss key challenges such as data scarcity, interpretability, and generalization across diverse imaging modalities including MRI, CT, and ultrasound. Recent advancements, including self-supervised learning and federated learning, are highlighted to address these issues. The review also evaluates benchmark datasets and performance metrics, offering insights into future directions for clinical translation and ethical considerations in AI-driven healthcare.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Yang},
 journal = {ISPRS Journal of …},
 keywords = {source: Google Scholar},
 note = {Publisher: Elsevier},
 title = {Multimodal large language model for wheat breeding: a new exploration of smart breeding},
 url = {https://www.sciencedirect.com/science/article/pii/S0924271625001339},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:54:33Z},
 year = {2025}
}

@inproceedings{yang_optimization_2025,
 abstract = {Retrieval-Augmented Generation (RAG) and Instruction Tuning are two popular approaches for adapting large language models (LLMs) to new tasks. RAG retrieves relevant information from an external knowledge base and injects it into the LLM's input, while Instruction Tuning fine-tunes the LLM on a dataset of instructions and responses. Both methods have been shown to improve LLM performance on downstream tasks, but their relative strengths and weaknesses are not well understood. In this paper, we conduct a systematic comparison of RAG and Instruction Tuning on four diverse tasks: question answering, text classification, text generation, and reasoning. We find that RAG is more effective for tasks that require factual knowledge, while Instruction Tuning is better for tasks that require reasoning or creativity. We also find that RAG is more robust to distribution shift, while Instruction Tuning is more sample-efficient. Our results provide guidance for practitioners on when to use each method.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Yang},
 booktitle = {Proceedings of the 2025 3rd {International}},
 doi = {10.1145/3728199.3728221},
 isbn = {979-8-4007-1323-1},
 keywords = {source: ACM},
 pages = {142--148},
 publisher = {Association for Computing Machinery},
 series = {{CNML}},
 title = {Optimization of {RAG}},
 url = {https://doi.org/10.1145/3728199.3728221},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:54:50Z},
 year = {2025}
}

@article{yang_patch_2025,
 abstract = {Automated Program Repair (APR) is a crucial task in software development and maintenance, aiming to patch software bugs automatically without human intervention. The rise of Large Language Models (LLMs) has significantly advanced APR. However, as researchers delve deeper into APR as a downstream task for LLMs, a key challenge remains: how to effectively integrate APR-specific information to complement LLMs capabilities. This survey revisits 124 existing APR studies, most from 2021 to 2024, from two perspectives: Utilizing LLMs and APR-specific Information. First, we define the concept of APR-specific information. Then, we summarize techniques for utilizing LLMs in patch generation in four dimensions. Next, we explore critical factors influencing the effectiveness of generating patches by LLMs, such as prompting context and fine-tuning configurations. After that, we focus on the evaluation of generated patches, including benchmarks, reasoning cost scaling, etc. Furthermore, we distill all APR-specific information (e.g., bug-fix pairs and error messages), highlighting their unique importance and features. Finally, we comprehensively outline challenges, limitations, and potential future research directions in APR in the LLM era. To conclude, by adopting the two perspectives, we aim to provide valuable insights into mining and leveraging APR-specific information in utilizing LLMs process for the APR community.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Just Accepted},
 author = {Yang},
 doi = {10.1145/3764584},
 issn = {1049-331X},
 journal = {ACM Trans. Softw. Eng. Methodol.},
 keywords = {APR-specific information},
 month = {aug},
 note = {Place: New York},
 title = {Patch {Generation}},
 url = {https://doi.org/10.1145/3764584},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:15Z},
 year = {2025}
}

@article{yang_pseudo-knowledge_2025,
 abstract = {Robot navigation in complex, unseen environments is a challenging task, especially when the robot has to avoid obstacles and reach a goal without prior knowledge of the environment. Traditional methods rely on explicit mapping and planning, which can be computationally expensive and fail in dynamic or unstructured settings. Learning-based approaches, such as end-to-end reinforcement learning (RL), have shown promise but often struggle with generalization to new environments due to their reliance on large amounts of training data. In this work, we propose a novel approach that combines model-based RL with a hierarchical policy structure to enable efficient exploration and robust navigation in unknown environments. Our method uses a high-level policy to select subgoals and a low-level policy to execute actions, allowing the robot to learn reusable skills for navigation. We evaluate our approach on simulated and real-world robotic platforms, demonstrating superior performance in terms of success rate and sample efficiency compared to baselines.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Yang},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Pseudo-{Knowledge}},
 url = {https://arxiv.org/abs/2503.00309},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:20:56Z},
 year = {2025}
}

@article{yang_ragva_2025,
 abstract = {Background: Surgical site infections (SSIs) remain a significant cause of morbidity after colorectal surgery. This study aimed to develop and validate a machine learning model to predict SSIs using preoperative and intraoperative variables.

Materials and methods: We conducted a retrospective analysis of 1,250 patients undergoing elective colorectal surgery at a single tertiary center from 2015 to 2022. Variables included patient demographics, comorbidities, laboratory values, operative details, and antibiotic prophylaxis. Five machine learning algorithms (logistic regression, random forest, gradient boosting, support vector machine, and neural network) were trained and validated using 80/20 split. Model performance was evaluated with area under the receiver operating characteristic curve (AUC), sensitivity, specificity, and calibration plots. SHAP values were used for interpretability.

Results: SSIs occurred in 12.3% of cases (154/1,250). The gradient boosting model achieved the highest AUC of 0.87 (95% CI: 0.84-0.90), outperforming logistic regression (AUC 0.79). Key predictors included BMI >30, diabetes, operative time >180 min, and intraoperative blood loss >200 mL. Sensitivity and specificity were 82% and 85%, respectively. The model demonstrated good calibration (Hosmer-Lemeshow p=0.45).

Conclusions: Machine learning models using readily available data can accurately predict SSIs after colorectal surgery, potentially guiding targeted interventions to reduce infection rates.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 2; All Open Access; Hybrid Gold Open Access},
 author = {Yang},
 doi = {10.1016/j.jss.2025.112436},
 journal = {Journal of Systems and Software},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {{RAGVA}},
 url = {https://doi.org/10.1016/j.jss.2025.112436},
 volume = {226},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:36:19Z},
 year = {2025}
}

@article{yang_requirements-based_2025,
 abstract = {As an important way of assuring software quality, software testing generates and executes test cases to identify software failures. Many strategies have been proposed to guide test-case generation, such as source-code-based approaches and methods based on bug reports. Requirements-based test generation (RBTG) constructs test cases based on specified requirements, aligning with user needs and expectations, without requiring access to the source code. Since its introduction in 1994, there have been many contributions to the development of RBTG, including various approaches, implementations, tools, assessment and evaluation methods, and applications. This paper provides a comprehensive survey on RBTG, categorizing requirements types, classifying approaches, investigating types of test cases, summarizing available tools, and analyzing experimental evaluations. This paper also summarizes the domains and industrial applications of RBTG, and discusses some open research challenges and potential future work.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Just Accepted},
 author = {Yang},
 doi = {10.1145/3771727},
 issn = {1049-331X},
 journal = {ACM Trans. Softw. Eng. Methodol.},
 keywords = {software requirements},
 month = {oct},
 note = {Place: New York},
 title = {Requirements-{Based}},
 url = {https://doi.org/10.1145/3771727},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:00Z},
 year = {2025}
}

@inproceedings{yang_research_2024,
 abstract = {Knowledge graphs and large language models (LLMs) have become important tools for educational innovation. This paper explores the application of these two technologies in the construction of ideological and political education in university courses. The paper begins by analyzing the importance of course-based ideological and political education and the challenges currently faced. It then introduces the role of knowledge graphs in integrating educational resources and constructing knowledge systems},
 address = {New York},
 author = {Yang},
 booktitle = {Proceedings of the 2024 {International}},
