@inproceedings{hou_llm-based_2024,
 abstract = {Abstract—In this paper, we propose a novel federated learning framework for privacy-preserving anomaly detection in IoT networks. Traditional anomaly detection methods often rely on centralized data collection, which raises significant privacy concerns. Our approach leverages federated learning to train a global model across distributed IoT devices without sharing raw data. We introduce a lightweight autoencoder-based model optimized for resource-constrained environments and incorporate differential privacy mechanisms to further enhance security. Experimental results on benchmark IoT datasets demonstrate that our framework achieves comparable accuracy to centralized methods while reducing communication overhead by up to 40% and ensuring strong privacy guarantees.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
