@inproceedings{deng_unveiling_2025,
 abstract = {This paper presents a novel approach to enhancing user privacy in federated learning systems by integrating differential privacy mechanisms with secure multi-party computation. We propose a framework that balances model utility and privacy guarantees, addressing key challenges such as communication overhead and convergence rates. Through extensive experiments on benchmark datasets, we demonstrate that our method outperforms existing baselines in terms of privacy preservation while maintaining comparable accuracy. Our contributions include a theoretical analysis of privacy leakage bounds and practical implementations for real-world deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
