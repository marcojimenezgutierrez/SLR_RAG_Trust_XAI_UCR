 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:00:13Z},
 year = {2025}
}

@inproceedings{dietz_workbench_2024,
 abstract = {This resource paper addresses the challenge of evaluating Information Retrieval (IR) systems in the era of autoregressive Large Language Models (LLMs). Traditional methods relying on passage-level judgments are no longer effective due to the diversity of responses generated by LLM-based systems. We provide a workbench to explore several alternative evaluation approaches to judge the relevance of a system's response that incorporate LLMs: 1. Asking an LLM whether the response is relevant; 2. Asking the LLM which set of nuggets (i.e.},
