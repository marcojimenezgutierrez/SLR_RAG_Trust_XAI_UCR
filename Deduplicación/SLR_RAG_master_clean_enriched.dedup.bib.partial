 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:31:04Z},
 year = {2025}
}

@inproceedings{li_omniquery_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text across various domains. However, their performance in structured tasks like code generation remains a challenge, particularly for low-resource languages. In this paper, we explore the potential of LLMs for generating code in underrepresented programming languages, focusing on R, a language widely used in statistical computing and data analysis. We fine-tune a state-of-the-art LLM on a curated dataset of R code snippets and evaluate its performance using both automated metrics and human evaluation. Our results indicate that while the model can produce syntactically correct R code for basic tasks, it struggles with domain-specific idioms and complex data manipulation functions. We further investigate the impact of prompt engineering and few-shot learning on improving generation quality. Our findings highlight the need for language-specific pretraining and suggest avenues for enhancing LLM applicability in niche programming ecosystems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
