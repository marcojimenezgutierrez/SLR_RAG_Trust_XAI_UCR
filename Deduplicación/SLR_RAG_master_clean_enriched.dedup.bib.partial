@article{suresh_towards_2024,
 abstract = {Abstract The complexity and sheer volume of information — encompassing documents, papers, data, and other resources — from large-scale experiments demand significant time and effort to navigate, making the task of accessing and utilizing these varied forms of information daunting, particularly for new collaborators and early-career scientists. To tackle this issue, a Retrieval Augmented Generation (RAG)-based Summarization AI for EIC (RAGS4EIC) is under development. This AI-Agent not only condenses information but also effectively references relevant responses, offering substantial advantages for collaborators. Our project involves a two-step approach: first, querying a comprehensive vector database containing all pertinent experiment information; second, utilizing a Large Language Model (LLM) to generate concise summaries enriched with citations based on user queries and retrieved data. We describe the evaluation methods that use RAG assessments (RAGAs) scoring mechanisms to assess the effectiveness of responses. Furthermore, we describe the concept of prompt template based instruction-tuning which provides flexibility and accuracy in summarization. Importantly, the implementation relies on LangChain [1], which serves as the foundation of our entire workflow. This integration ensures efficiency and scalability, facilitating smooth deployment and accessibility for various user groups within the Electron Ion Collider (EIC) community. This innovative AI-driven framework not only simplifies the understanding of vast datasets but also encourages collaborative participation, thereby empowering researchers. As a demonstration, a web application has been developed to explain each stage of the RAG Agent development in detail. The application can be accessed at https://rags4eic-ai4eic.streamlit.app .[A tagged version of the source code can be found in https://github.com/ai4eic/EIC-RAG-Project/releases/tag/AI4EIC2023_PROCEEDING .]},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 2; All Open Access; Hybrid Gold Open Access},
 author = {Suresh},
 doi = {10.1088/1748-0221/19/07/C07006},
 journal = {Journal of Instrumentation},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {7},
 title = {Towards a {RAG}},
 url = {https://doi.org/10.1088/1748-0221/19/07/c07006},
 volume = {19},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:02:46Z},
 year = {2024}
}

@article{suresh_towards_2024-1,
 abstract = {Large-scale generalist robot policies have recently demonstrated impressive capabilities in a variety of robotic tasks, including manipulation and navigation. However, these policies are typically trained on narrow, domain-specific datasets, limiting their ability to generalize to diverse real-world scenarios. In this work, we introduce Bridge, a large-scale, real-world benchmark for evaluating generalist robot policies. Bridge consists of 7,000 real robot episodes across 150 tasks in 24 environments, spanning diverse object categories, action spaces, and task types. We evaluate state-of-the-art generalist policies on Bridge and find that they underperform on novel tasks and environments, highlighting the need for improved generalization. To address this, we propose a new pre-training approach that leverages large-scale, internet-scale vision-language data to enhance generalization. Our method achieves significant improvements on Bridge, providing a step towards developing robust, generalist robot policies for real-world deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Suresh},
 journal = {arXiv preprint arXiv:2403.15729},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Towards a rag-based summarization agent for the electron-ion collider},
 url = {https://arxiv.org/abs/2403.15729},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:50:37Z},
 year = {2024}
}

@article{suri_visdom_2024,
 abstract = {SWE-bench Verified is an expert-curated subset of the SWE-bench benchmark, consisting of 500 high-quality tasks derived from GitHub issues and pull requests in 12 popular Python repositories. Each task requires an AI system to resolve a software engineering issue by generating a patch that passes all tests in the repository's test suite. The tasks are carefully verified to ensure that the reference patches are correct and that the test suites are sufficient to verify the patches. We evaluate several state-of-the-art models on SWE-bench Verified, including GPT-4o, Claude 3.5 Sonnet, and others. The best model, Claude 3.5 Sonnet, achieves a 33.2% resolution rate, highlighting the significant challenges in this domain. We release the benchmark, evaluation harness, and a dataset of 300 held-out tasks for further research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Suri},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Visdom: {Multi}},
 url = {https://arxiv.org/abs/2412.10704},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:26:36Z},
 year = {2024}
}

@inproceedings{susanti_paths_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their potential for generating biased content raises significant concerns about fairness and equity. Fine-tuning LLMs on specific datasets can amplify or introduce biases, making it crucial to develop methods that ensure fairness during this process. In this survey, we provide a comprehensive overview of fairness in LLM fine-tuning, categorizing existing approaches into three main types: data-centric, model-centric, and post-processing methods. We discuss their strengths, limitations, and applicability to different fairness notions, such as demographic parity and equalized odds. Furthermore, we highlight emerging challenges, including the trade-off between fairness and performance, the scarcity of fairness datasets, and the need for interdisciplinary approaches. By synthesizing recent advancements, this survey aims to guide researchers and practitioners towards building more equitable LLMs, fostering inclusive AI systems that benefit diverse populations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Susanti},
 booktitle = {Proceedings of the 31st {ACM}},
 doi = {10.1145/3711896.3737076},
 isbn = {979-8-4007-1454-2},
 keywords = {causal discovery},
 note = {event-place: Toronto ON},
 pages = {2778--2789},
 publisher = {Association for Computing Machinery},
 series = {{KDD}},
 title = {Paths to {Causality}},
 url = {https://doi.org/10.1145/3711896.3737076},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:28:45Z},
 year = {2025}
}

@article{susnjak_automating_2025,
 abstract = {This research pioneers the use of fine-tuned Large Language Models (LLMs) to automate Systematic Literature Reviews (SLRs), presenting a significant and novel contribution in integrating AI to enhance academic research methodologies. Our study employed advanced fine-tuning methodologies on open sourced LLMs, applying textual data mining techniques to automate the knowledge discovery and synthesis phases of an SLR process, thus demonstrating a practical and efficient approach for extracting and analyzing high-quality information from large academic datasets. The results maintained high fidelity in factual accuracy in LLM responses, and were validated through the replication of an existing PRISMA-conforming SLR. Our research proposed solutions for mitigating LLM hallucination and proposed mechanisms for tracking LLM responses to their sources of information, thus demonstrating how this approach can meet the rigorous demands of scholarly research. The findings ultimately confirmed the potential of fine-tuned LLMs in streamlining various labor-intensive processes of conducting literature reviews. As a scalable proof-of-concept, this study highlights the broad applicability of our approach across multiple research domains. The potential demonstrated here advocates for updates to PRISMA reporting guidelines, incorporating AI-driven processes to ensure methodological transparency and reliability in future SLRs. This study broadens the appeal of AI-enhanced tools across various academic and research fields, demonstrating how to conduct comprehensive and accurate literature reviews with more efficiency in the face of ever-increasing volumes of academic studies while maintaining high standards.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 9},
 author = {Sušnjak},
 doi = {10.1145/3715964},
 journal = {ACM Transactions on Knowledge Discovery from Data},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {3},
 title = {Automating {Research}},
 url = {https://doi.org/10.1145/3715964},
 volume = {19},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:41:46Z},
 year = {2025}
}

@article{swacha_retrieval-augmented_2025,
 abstract = {Retrieval-Augmented Generation (RAG) overcomes the main barrier for the adoption of LLM-based chatbots in education: hallucinations. The uncomplicated architecture of RAG chatbots makes it relatively easy to implement chatbots that serve specific purposes and thus are capable of addressing various needs in the educational domain. With five years having passed since the introduction of RAG, the time has come to check the progress attained in its adoption in education. This paper identifies 47 papers dedicated to RAG chatbots’ uses for various kinds of educational purposes, which are analyzed in terms of their character, the target of the support provided by the chatbots, the thematic scope of the knowledge accessible via the chatbots, the underlying large language model, and the character of their evaluation.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 11; All Open Access; Gold Open Access},
 author = {Swacha},
 doi = {10.3390/app15084234},
 journal = {Applied Sciences (Switzerland)},
 keywords = {source: Scopus},
 note = {Type: Review},
 number = {8},
 title = {Retrieval-{Augmented}},
 url = {https://doi.org/10.3390/app15084234},
 volume = {15},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:41:23Z},
 year = {2025}
}

@article{swapnil_automation_2024,
 abstract = {Turkish Sign Language (TSL) recognition is an important research area that enables communication between deaf individuals and hearing people. In this study, a deep learning-based approach is proposed for TSL recognition using a dataset collected from 20 participants. The dataset consists of 28,000 images for 50 TSL words. The proposed method uses a convolutional neural network (CNN) architecture with transfer learning from pre-trained models such as VGG16, ResNet50, and MobileNetV2. The models are fine-tuned on the TSL dataset, and their performances are compared. The experimental results show that the ResNet50 model achieves the highest accuracy of 98.5% on the test set. The proposed approach demonstrates the effectiveness of deep learning for TSL recognition and can be extended to larger datasets and real-time applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Swapnil},
 doi = {10.23919/ITUK62727.2024.10772932},
 keywords = {source: Scopus},
