@article{sheng_talk2traffic_2025-1,
 abstract = {Generating diverse and realistic traffic scenarios is crucial for the development and testing of autonomous driving systems. However, existing methods often struggle to produce scenarios that are both interactive and editable, limiting their applicability in real-world simulation and validation. In this paper, we introduce Talk2Traffic, a novel framework for interactive and editable traffic scenario generation using natural language instructions. Talk2Traffic leverages a multimodal large language model to interpret user queries and guide a diffusion-based traffic generation model, enabling the creation of dynamic, customizable traffic environments. Our approach supports real-time modifications, such as altering agent behaviors, environmental conditions, and scenario complexity, while ensuring physical plausibility and safety constraints. Extensive experiments on benchmark datasets demonstrate that Talk2Traffic outperforms state-of-the-art methods in terms of scenario diversity, realism, and user control, paving the way for more effective autonomous driving simulations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Sheng},
 journal = {Proceedings of the …},
