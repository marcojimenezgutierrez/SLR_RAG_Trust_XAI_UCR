 x_enrich_ts = {2025-11-02T06:24:16Z},
 year = {2025}
}

@inproceedings{gao_preference-guided_2024,
 abstract = {The complexity of prompt engineering and the difficulty of evaluating large language models (LLMs) pose significant barriers to their widespread adoption. We introduce ChainForge, a visual toolkit for prompt engineering and LLM hypothesis testing. ChainForge enables rapid iteration over prompt variations, visualization of model outputs, and systematic exploration of prompt design. By supporting branching, merging, and versioning of prompt chains, it facilitates reproducible experimentation and collaboration. We evaluate ChainForge through a user study with 12 participants, finding that it significantly improves efficiency and confidence in prompt engineering tasks compared to a baseline text editor. ChainForge is open-source and available at chainforge.ai.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
