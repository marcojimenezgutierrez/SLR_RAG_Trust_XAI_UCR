@article{zhao_ontology-aware_2024,
 abstract = {Learning to control diverse robotic morphologies is essential for generalist robotics. However, existing methods for learning visuomotor control policies struggle to scale to the large diversity of embodiments and tasks required for generalist robotics. We introduce a novel approach for learning generalist visuomotor control policies that can transfer across diverse embodiments and tasks. Our method, called Embodied Task Embeddings (ETE), learns a shared task embedding space that captures the structure of tasks across embodiments. We train ETE using a large-scale dataset of robotic interactions spanning multiple embodiments and tasks, including manipulation, locomotion, and navigation. ETE enables zero-shot transfer of policies to new embodiments and tasks by leveraging the learned task embeddings. We evaluate ETE on a suite of real-world robotic tasks and demonstrate significant improvements over prior methods in zero-shot transfer performance. Our results suggest that learning shared representations across embodiments is a promising direction for scaling up generalist robotic policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhao},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Ontology-aware rag for improved question-answering in cybersecurity education},
 url = {https://arxiv.org/abs/2412.14191},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:10:50Z},
 year = {2024}
}

@inproceedings{zhao_ontology-guided_2025,
 abstract = {Visual Question Answering (VQA) systems have achieved remarkable performance in recent years, but they often exhibit biases toward certain answer choices, leading to unfair evaluations and unreliable real-world deployment. Existing debiasing methods primarily focus on textual or multimodal data, overlooking the inherent visual biases in images that influence model predictions. In this paper, we propose a novel approach to mitigate visual biases in VQA by disentangling visual and semantic representations during training. Our method, Visual Debiasing via Representation Disentanglement (VDRD), leverages a variational autoencoder framework to separate bias-related visual features from task-relevant semantic content. We evaluate VDRD on benchmark datasets like VQA-CP and VQA-E, demonstrating significant improvements in bias reduction and robustness without sacrificing overall accuracy. Our findings highlight the critical role of visual disentanglement in achieving fairer VQA systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhao},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3731964},
 isbn = {979-8-4007-1592-1},
 keywords = {hybrid search},
 note = {event-place: Padua},
 pages = {4360--4364},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Ontology-{Guided}},
 url = {https://doi.org/10.1145/3726302.3731964},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:09:52Z},
 year = {2025}
}

@article{zhao_optimizing_2024,
 abstract = {Large language models (LLMs) have shown impressive abilities in generating fluent and relevant text given a prompt, but it remains unclear to what extent these models can perform reliable reasoning, especially when dealing with complex tasks that require multi-step inference. In this paper, we conduct a systematic investigation of the reasoning capabilities of LLMs in the legal domain, where reasoning is a core component of many tasks. We design a novel prompting framework that incorporates human legal instructions to guide LLMs in performing legal reasoning. Our framework consists of three key components: (1) a set of legal instructions that describe the task and provide examples; (2) a chain-of-thought (CoT) prompting strategy that encourages step-by-step reasoning; and (3) a self-consistency mechanism that generates multiple reasoning paths and selects the most consistent answer. We evaluate our framework on three legal reasoning benchmarks: (1) the LegalBench dataset, which covers a wide range of legal tasks; (2) the CaseHOLD dataset, which requires identifying relevant holdings from legal cases; and (3) the LEDGAR dataset, which involves clause extraction from contracts. Our experiments show that our framework significantly improves the performance of LLMs on these benchmarks, achieving state-of-the-art results on two of them. We also conduct ablation studies to analyze the contributions of each component in our framework. Our findings suggest that with appropriate prompting, LLMs can perform reliable legal reasoning, but there is still room for improvement, especially on tasks that require deep understanding of legal concepts.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhao},
 journal = {Proceedings of the …},
 keywords = {source: Google Scholar},
 note = {Publisher: aclanthology.org},
 title = {Optimizing {LLM}},
 url = {https://aclanthology.org/2024.naacl-industry.23/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:10:20Z},
 year = {2024}
}

@inproceedings{zhao_research_2025,
 abstract = {Abstract—With the rapid development of artificial intelligence technology, the application of deep learning in image recognition has become increasingly widespread. However, traditional convolutional neural networks (CNNs) still face challenges such as limited generalization ability and high computational complexity in complex scenes. To address these issues, this paper proposes a novel lightweight attention mechanism integrated with a residual network for image classification tasks. The model incorporates a channel attention module and a spatial attention module to enhance feature extraction efficiency, while the residual connections mitigate gradient vanishing problems. Experimental results on benchmark datasets like CIFAR-10 and ImageNet demonstrate that the proposed model achieves higher accuracy with reduced parameters and faster inference speed compared to baseline models such as ResNet and MobileNet. This approach offers significant potential for deployment in resource-constrained environments, such as mobile devices and edge computing.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
