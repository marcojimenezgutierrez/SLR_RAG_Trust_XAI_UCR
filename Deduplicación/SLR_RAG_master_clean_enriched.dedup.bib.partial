 keywords = {document analysis},
 note = {event-place: Berlin},
 pages = {147--150},
 publisher = {Association for Computing Machinery},
 series = {{SIGMOD}},
 title = {Graphy'our {Data}},
 url = {https://doi.org/10.1145/3722212.3725106},
 x_enrich_source = {x-ai/grok-4-fast},
