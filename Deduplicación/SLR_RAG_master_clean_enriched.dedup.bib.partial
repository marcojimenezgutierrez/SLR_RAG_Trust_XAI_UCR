@article{kumawat_sh-rag_2025,
 abstract = {This paper proposes a novel framework for enhancing cybersecurity in smart grid systems through the integration of machine learning and blockchain technologies. The proposed approach addresses key vulnerabilities such as data tampering and unauthorized access by leveraging federated learning for decentralized model training and blockchain for immutable transaction logging. Simulation results demonstrate a 35% improvement in detection accuracy and a 28% reduction in response time compared to traditional methods. The framework is evaluated on a realistic smart grid dataset, highlighting its scalability and robustness against adversarial attacks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
