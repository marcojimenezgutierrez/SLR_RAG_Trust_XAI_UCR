@inproceedings{tel_rag_2025,
 abstract = {This study investigates the effects of climate change on coastal ecosystems in the Mediterranean region. Using a combination of satellite imagery and field data collected over a 20-year period, we analyze changes in biodiversity, sea level rise, and temperature variations. Results indicate a significant decline in native species populations and an increase in invasive species, with projections suggesting further degradation if current trends continue. Policy recommendations include enhanced marine protected areas and international cooperation for mitigation strategies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
