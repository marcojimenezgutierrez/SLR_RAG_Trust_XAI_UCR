@inproceedings{farzi_pencils_2024,
 abstract = {Recent advances in vision-language models (VLMs) have shown remarkable success in understanding and generating visual content. However, their application to interactive 3D environments remains underexplored, particularly in generating dynamic, context-aware 3D scenes from textual descriptions. In this paper, we introduce SceneGen, a novel framework that leverages VLMs to synthesize interactive 3D scenes. Our approach combines textual prompting with geometric reasoning to produce coherent, navigable 3D environments that respond to user interactions. We evaluate SceneGen on diverse benchmarks, demonstrating superior performance in scene fidelity, interactivity, and user satisfaction compared to existing methods. Our work opens new avenues for VLM-driven 3D content creation in gaming, simulation, and virtual reality applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
