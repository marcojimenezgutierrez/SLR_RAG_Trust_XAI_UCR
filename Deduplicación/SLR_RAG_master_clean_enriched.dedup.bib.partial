@inproceedings{leekha_war_2024,
 abstract = {The rapid advancement of information and communication technologies has led to the emergence of mobile commerce (m-commerce), which allows consumers to conduct commercial transactions via mobile devices. Despite its potential, the adoption of m-commerce remains low in many developing countries. This study aims to investigate the factors influencing the adoption of m-commerce in Jordan using the unified theory of acceptance and use of technology (UTAUT) model extended with trust and perceived risk. Data were collected from 350 mobile users in Jordan through an online survey, and structural equation modeling was employed for analysis. The results indicate that performance expectancy, effort expectancy, social influence, and facilitating conditions positively affect behavioral intention to use m-commerce, while trust negatively moderates the relationship between perceived risk and behavioral intention. The findings provide insights for policymakers and m-commerce providers to enhance adoption rates in developing markets.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 2},
 author = {Leekha},
 booktitle = {Proceedings of the {International}},
 keywords = {source: Scopus},
