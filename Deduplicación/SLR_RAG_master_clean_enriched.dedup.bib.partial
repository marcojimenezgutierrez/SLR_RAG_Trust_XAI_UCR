@article{mauliana_exploring_2025,
 abstract = {This exploratory study investigates how open-domain, multi-session interactions with a large language model (LLM)-powered social humanoid robot (SHR), EMAH, affect user perceptions and willingness for adoption in a university setting. Thirteen students (5 female, 8 male) engaged with EMAH across four weekly sessions, utilizing a compact open-source LLM (Flan-T5-Large) to facilitate multi-turn conversations. Mixed-method measures were employed, including subjective ratings, behavioral observations, and conversational analyses. Results revealed that perceptions of robot’s sociability, agency, and engagement remained stable over time, with engagement sustained despite repeated exposure. While perceived animacy increased with familiarity, disturbance ratings did not significantly decline, suggesting enhanced lifelikeness of SHR without reducing discomfort. Observational data showed a mid-study drop in conversation length and turn-taking, corresponding with technical challenges such as slower response generation and speech recognition errors. Although prior experience with robots weakly correlated with rapport, it did not significantly predict adoption willingness. Overall, the findings highlight the potential for LLM-powered robots to maintain open-domain interactions over time, but also underscore the need for improving technical robustness, adapting conversation strategies by personalization, and managing user expectations to foster long-term social engagement. This work provides actionable insights for advancing humanoid robot deployment in educational environments.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Mauliana},
 doi = {10.3389/frobt.2025.1585589},
 journal = {Frontiers in Robotics …},
 keywords = {source: Google Scholar},
 note = {Publisher: frontiersin.org},
 title = {Exploring {LLM}},
 url = {https://doi.org/10.3389/frobt.2025.1585589},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:28:52Z},
 year = {2025}
}

@article{mavromatis_gnn-rag_2024,
 abstract = {We investigate the internal representations of true/false datasets in large language models (LLMs). Specifically, we examine whether these representations exhibit linear structure that aligns with the true/false labels. Our findings reveal that, for a range of LLMs and datasets, the representations of true and false statements form two distinct clusters in the residual stream, separated by a linear direction. This direction, which we term the "truth direction," is consistent across different datasets and models. We further show that this linear structure emerges early in training and persists through fine-tuning. Our results suggest that LLMs implicitly learn a geometry of truth, where factual accuracy is encoded linearly in their representations. This has implications for interpretability, robustness, and the potential for targeted interventions in LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Mavromatis},
 journal = {arXiv preprint arXiv:2405.20139},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Gnn-rag: {Graph}},
 url = {https://arxiv.org/abs/2405.20139},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:13:52Z},
 year = {2024}
}

@article{mavromatis_gnn-rag_2025,
 abstract = {This paper introduces a novel framework for multilingual code-switching detection in low-resource languages, leveraging cross-lingual transfer learning and synthetic data generation. We evaluate our approach on several understudied language pairs, demonstrating significant improvements in F1 scores over baselines. Our method also addresses challenges in annotation scarcity by incorporating self-supervised pretraining on monolingual corpora. Experimental results on the LinCE benchmark and custom datasets highlight the framework's robustness and generalizability.},
