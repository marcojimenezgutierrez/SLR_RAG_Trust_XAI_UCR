Type: PDF},
 title = {Bailicai: {A}},
 url = {https://file.sciopen.com/sciopen_public/1895014766676131841.pdf},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:13:25Z},
 year = {2025}
}

@inproceedings{cui_cirag_2025,
 abstract = {Social media platforms have become a primary source of user-generated content (UGC), which is often reused by other users, creators, or the platforms themselves for various purposes, including content recommendation, advertising, and AI training. However, such reuse raises significant privacy, ethical, and intellectual property concerns, as users may not be fully aware of or consent to how their content is repurposed. In this position paper, we explore the challenges and opportunities in detecting and mitigating unauthorized reuse of UGC, with a focus on short-form video platforms like TikTok. We propose a multimodal framework that combines computer vision, natural language processing, and audio analysis to identify reused content, even when it has been edited or remixed. Through case studies and preliminary experiments on a dataset of over 10,000 TikTok videos, we demonstrate the framework's effectiveness in detecting reuse patterns, such as duets, stitches, and background music overlays. Our findings reveal that up to 25% of popular UGC involves some form of reuse, often without attribution. We discuss implications for platform policies, user empowerment tools, and future research directions to foster more ethical content ecosystems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Cui},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3729921},
 isbn = {979-8-4007-1592-1},
 keywords = {information retrieval},
 note = {event-place: Padua},
 pages = {1316--1326},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{CIRAG}},
 url = {https://doi.org/10.1145/3726302.3729921},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:37:16Z},
 year = {2025}
}

@inproceedings{cui_nlctables_2025,
 abstract = {Personalized news recommendation systems have been widely deployed to help users discover relevant news articles. However, these systems can inadvertently amplify biases present in the data, leading to unfair recommendations that marginalize certain groups or viewpoints. In this paper, we propose a novel causal intervention approach to mitigate bias in personalized news recommendation. Our method leverages counterfactual reasoning to identify and counteract biased associations in the recommendation model. Specifically, we model the recommendation process as a causal graph and intervene on sensitive attributes to generate fairer recommendations. We evaluate our approach on real-world news datasets and demonstrate significant improvements in fairness metrics while maintaining recommendation utility. Our work provides a principled framework for addressing bias in news recommendation systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Cui},
