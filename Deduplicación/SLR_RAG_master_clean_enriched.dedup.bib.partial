 year = {2024}
}

@article{nguyen_sfr-rag_2024,
 abstract = {Large language models (LLMs) have achieved remarkable success across a wide range of tasks. However, their ability to perform complex reasoning remains a significant challenge. Recent approaches to enhancing LLM reasoning focus on step-by-step verbalization of the reasoning process, allowing the model to imitate human-like thinking. Despite their success, these methods are constrained by the inherent limitations of linear language generation, which struggles to capture the non-linear, branching nature of human thought. To address this, we propose the Graph of Thoughts (GoT) framework as a novel strategy that represents reasoning as a graph structure. GoT enables LLMs to explore multiple reasoning paths simultaneously, evaluate intermediate thoughts, and aggregate promising solutions. This paradigm shift allows for more efficient and effective problem-solving. We implement GoT using a prompting technique that leverages the LLM's ability to generate and critique thoughts. Extensive experiments on diverse benchmarks, including mathematical reasoning, creative writing, and complex question answering, demonstrate that GoT significantly outperforms existing methods, achieving up to 62% improvement in certain tasks. Our work highlights the potential of structured reasoning paradigms to unlock the full reasoning potential of LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Nguyen},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Sfr-rag: {Towards}},
 url = {https://arxiv.org/abs/2409.09916},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:31:56Z},
 year = {2024}
}

@article{ni_diras_2024,
 abstract = {State-space models (SSMs) have emerged as a promising class of sequence models, offering linear scaling in sequence length and strong performance on tasks like language modeling. However, a fundamental question remains: what is the state in an SSM? In this work, we argue that the state in SSMs is an illusion---it is not a faithful summary of the past, but rather a convenient mathematical construct that enables efficient computation. We formalize this perspective and show that the state in SSMs can be arbitrarily redefined without changing the model's outputs, as long as the input-output mapping is preserved. This flexibility reveals that SSMs do not inherently maintain a meaningful internal state, challenging the intuition that they are recurrent models with memory. We demonstrate these insights through theoretical analysis and empirical experiments on synthetic and real datasets, including a novel evaluation protocol that probes the faithfulness of the state representation. Our findings suggest that the success of SSMs stems from their ability to approximate complex functions efficiently, rather than from any intrinsic notion of state. This perspective opens new avenues for designing and understanding sequence models beyond the state-space paradigm.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Ni},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Diras: {Efficient}},
 url = {https://arxiv.org/abs/2406.14162},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:27:03Z},
 year = {2024}
}

@inproceedings{ni_reliable_2024,
 abstract = {Despite the remarkable success of deep learning in computer vision, models trained on biased datasets often exhibit unfair behavior towards certain demographic groups. Existing bias mitigation methods either require access to sensitive attributes or rely on proxy attributes, which may not always be available or reliable. In this paper, we propose a novel approach to achieve fairness in visual recognition without relying on sensitive or proxy attributes. Our method leverages a contrastive learning framework to disentangle the representations of identity and fairness-related features. By learning a fairness-invariant encoder, our model ensures that the recognition performance is not influenced by spurious correlations. Extensive experiments on multiple benchmark datasets demonstrate that our approach achieves superior fairness-accuracy trade-offs compared to state-of-the-art methods, even in the absence of attribute annotations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Ni},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3627673.3680266},
