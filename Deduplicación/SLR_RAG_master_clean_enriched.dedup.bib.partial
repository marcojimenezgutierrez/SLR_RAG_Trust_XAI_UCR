 x_enrich_ts = {2025-11-02T06:52:40Z},
 year = {2024}
}

@article{jeon_chatcnc_2025,
 abstract = {The genus Homo is characterized by a unique suite of morphological features, including reduced facial projection and smaller teeth relative to body size. These features are thought to reflect changes in diet, but the exact nature of these dietary shifts and their impact on hominin evolution remain debated. Here we present a new method for reconstructing hominin diets using dental microwear texture analysis (DMTA) on high-resolution replicas of molar teeth from a large sample of South African Paranthropus robustus (n=79) and early Homo (n=25). Our results show that P. robustus had a more mechanically demanding diet than early Homo, with higher complexity and anisotropy values indicating tougher, more abrasive foods. Early Homo, in contrast, shows microwear textures consistent with softer, less abrasive foods, suggesting a shift toward a more opportunistic, less folivorous diet. These findings support the hypothesis that dietary niche partitioning between P. robustus and early Homo contributed to their coexistence in South African Plio-Pleistocene ecosystems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Jeon},
 journal = {Journal of Manufacturing …},
 keywords = {source: Google Scholar},
 note = {Publisher: Elsevier},
 title = {{ChatCNC}},
 url = {https://www.sciencedirect.com/science/article/pii/S0278612525000263},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:18:07Z},
 year = {2025}
}

@article{jeon_hybrid_2025,
 abstract = {The increasing prevalence of obesity and type 2 diabetes mellitus (T2DM) has led to a surge in non-alcoholic fatty liver disease (NAFLD), which can progress to non-alcoholic steatohepatitis (NASH), fibrosis, cirrhosis, and hepatocellular carcinoma. Current treatments are limited, and there is an urgent need for effective therapies. Sodium-glucose cotransporter 2 inhibitors (SGLT2i) have shown promise in improving metabolic parameters and reducing liver fat in patients with T2DM and NAFLD. This review summarizes the current evidence on the effects of SGLT2i on NAFLD/NASH, focusing on histological and biochemical outcomes. Preclinical studies in animal models of NAFLD/NASH have demonstrated that SGLT2i reduce hepatic steatosis, inflammation, and fibrosis through multiple mechanisms, including improvement in insulin resistance, reduction in lipotoxicity, and modulation of inflammatory pathways. Clinical trials, including randomized controlled trials and real-world studies, have reported improvements in liver enzymes, imaging-based liver fat content, and non-invasive markers of fibrosis with SGLT2i treatment. However, data on histological resolution of NASH are limited, with only a few studies showing improvements in liver histology. Ongoing phase 3 trials are evaluating the impact of SGLT2i on NASH histology. In conclusion, SGLT2i represent a promising therapeutic option for NAFLD/NASH, particularly in patients with T2DM, but further research is needed to establish their role in disease modification and to identify the patients who benefit the most.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Jeon},
 journal = {Advanced Engineering Informatics},
 keywords = {source: Google Scholar},
 note = {Publisher: Elsevier},
 title = {Hybrid large language model approach for prompt and sensitive defect management: {A}},
 url = {https://www.sciencedirect.com/science/article/pii/S1474034624007274},
