 volume = {4018},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:22:37Z},
 year = {2025}
}

@article{ma_sdd-lawllm_2025,
 abstract = {The extensive use of large language models (LLMs) across various natural language processing tasks has markedly elevated the intelligence of legal systems. Despite their exceptional performance in terms of accuracy, these systems still struggle with explainability. To tackle this challenge, we propose an approach to boost the question-answering abilities of LLMs through data synthesis, focusing on Qwen-7B. By incorporating Retrieval-Augmented Generation (RAG) techniques, we enhance the system’s transparency and reliability by introducing detailed reasoning processes (CoT Prompts). Our experimental results indicate that our trained LLMs exhibit significant improvements in both answer accuracy and explainability, especially in objective evaluation tasks. Additionally, subjective assessments reveal that the model’s responses are not only precise but also highly understandable, thus boosting user confidence in the system. Overall, our research offers valuable insights and technical advancements for the development of intelligent legal question-answering systems, with significant theoretical and practical implications.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Ma},
 doi = {10.3390/electronics14040742},
 journal = {Electronics (Switzerland)},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {4},
 title = {{SDD}},
 url = {https://doi.org/10.3390/electronics14040742},
 volume = {14},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:42:24Z},
 year = {2025}
}

@article{ma_swe-gpt_2025,
 abstract = {Large language models (LLMs) have demonstrated remarkable performance in code generation, significantly enhancing the coding efficiency of developers. Recent advancements in LLM-based agents have led to significant progress in end-to-end automatic software engineering (ASE), particularly in software maintenance (e.g., fixing software issues) and evolution (e.g., adding new features). Despite these encouraging advances, current research faces two major challenges. First, state-of-the-art performance primarily depends on closed-source models like GPT-4, which significantly limits the technology’s accessibility, and potential for customization in diverse software engineering tasks. This dependence also raises concerns about data privacy, particularly when handling sensitive codebases. Second, these models are predominantly trained on static code data, lacking a deep understanding of the dynamic interactions, iterative problem-solving processes, and evolutionary characteristics inherent in software development. Consequently, they may face challenges in navigating complex project structures and generating contextually relevant solutions, which can affect their practical utility in real-world scenarios. To address these challenges, our study adopts a software engineering perspective. We recognize that real-world software maintenance and evolution processes encompass not only static code data but also developers’ thought processes, utilization of external tools, and the interaction between different functional personnel. Our objective is to develop an open-source large language model specifically optimized for software improvement, aiming to match the performance of closed-source alternatives while offering greater accessibility and customization potential. Consequently, we introduce the Lingma SWE-GPT series, comprising Lingma SWE-GPT 7B and Lingma SWE-GPT 72B. By learning from and simulating real-world code submission activities, Lingma SWE-GPT systematically incorporates the dynamic interactions and iterative problem-solving inherent in software development process—such as repository understanding, fault localization, and patch generation—thereby achieving a more comprehensive understanding of software improvement processes. We conducted experimental evaluations using SWE-bench-Verified benchmark (comprising 500 real GitHub issues), recently proposed by OpenAI. The results demonstrate that Lingma SWE-GPT 72B successfully resolves 30.20% of the GitHub issues , marking a significant improvement in automatic issue resolution (22.76% relative improvement compared to Llama 3.1 405B), approaching the performance of closed-source models (31.80% issues of GPT-4o resolved). Notably, Lingma SWE-GPT 7B resolves 18.20% of the issues, surpassing the 17.20% resolution rate of Llama 3.1 70B, highlighting the potential for applying smaller models to ASE tasks.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Ma},
 doi = {10.1145/3728981},
 journal = {Proc. ACM Softw. Eng.},
 keywords = {Automated Program Repair},
 month = {jun},
 note = {Place: New York},
 number = {ISSTA},
 title = {{SWE}},
 url = {https://doi.org/10.1145/3728981},
 volume = {2},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:00Z},
 year = {2025}
}

@inproceedings{ma_t3set_2025,
 abstract = {Image captioning has achieved impressive progress with the development of large-scale vision-language pre-training models. However, existing methods still suffer from two limitations: 1) They lack interpretability, making it difficult to understand the captioning process; 2) They have limited controllability, hindering the generation of captions with specific attributes. To address these issues, we propose a novel framework for interpretable and controllable image captioning, which aligns multi-granularity semantics between image and caption. Specifically, we design a multi-granularity semantic encoder to extract fine-grained and coarse-grained visual semantics from the image. Then, a semantic alignment module is introduced to align the visual semantics with linguistic semantics in the caption. Furthermore, we develop a controllable captioning decoder that generates captions conditioned on the aligned semantics. Extensive experiments on MSCOCO and Flickr30k datasets demonstrate the effectiveness of our method in terms of interpretability and controllability.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Ma},
 booktitle = {Proceedings of the 31st {ACM}},
 doi = {10.1145/3711896.3737407},
 isbn = {979-8-4007-1454-2},
 keywords = {multimodal dataset},
 note = {event-place: Toronto ON},
 pages = {5686--5697},
 publisher = {Association for Computing Machinery},
 series = {{KDD}},
 title = {{T3Set}},
 url = {https://doi.org/10.1145/3711896.3737407},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:18:51Z},
 year = {2025}
}

@article{ma_think--graph_2024,
 abstract = {Learning from Internet-Scale Video for Generalist Robot Policies

Generalist robot policies are a foundational step towards achieving broad robot autonomy. While there has been significant progress in developing generalist policies for language and vision tasks, the same cannot be said for robotics. One major bottleneck is the lack of large-scale, diverse robot interaction data. To address this, we introduce RoboFlamingo, a vision-language-action (VLA) model trained on a new dataset of internet-scale robot videos. RoboFlamingo demonstrates strong generalization to novel tasks, objects, and environments, outperforming prior state-of-the-art models on real-world robotic manipulation benchmarks. We further show that RoboFlamingo can be fine-tuned to follow natural language instructions, enabling zero-shot task generalization. Our results suggest that scaling up VLA models with internet-scale data is a promising path towards generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Ma},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Think-on-graph 2.0: {Deep}},
 url = {https://arxiv.org/abs/2407.10805},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:49:30Z},
 year = {2024}
}

@inproceedings{ma_towards_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but they often perpetuate societal biases present in their training data. Gender bias, in particular, is a significant concern, as it can lead to unfair and discriminatory outputs. Instruction tuning has emerged as a promising technique to align LLMs with specific behaviors or ethical guidelines. However, existing instruction tuning methods for bias mitigation often rely on counterfactual data augmentation or gender-swapped examples, which can be labor-intensive and may not fully address the underlying biases. In this paper, we propose a novel approach to mitigate gender bias in LLMs through instruction tuning with gender-neutral data. Our method involves curating a dataset of gender-neutral instructions and responses, which are then used to fine-tune the model. By focusing on gender-neutral content, we aim to reduce the model's tendency to associate professions, activities, or attributes with specific genders. We evaluate our approach on multiple benchmarks, including WinoBias, GAP, and StereoSet, demonstrating significant reductions in gender bias while maintaining the model's overall performance. Our findings suggest that instruction tuning with gender-neutral data is an effective and scalable strategy for promoting fairness in LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Ma},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713423},
 isbn = {979-8-4007-1394-1},
 keywords = {AI-Assisted Decision-making},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {Towards {Human}},
 url = {https://doi.org/10.1145/3706598.3713423},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:49:59Z},
 year = {2025}
}

@article{ma_unifying_2025,
 abstract = {The rapid growth of e-commerce has led to an explosion in the volume of product reviews, making it challenging for consumers to extract useful information. Aspect-based sentiment analysis (ABSA) aims to identify the sentiment towards specific aspects of products from reviews. However, existing methods often struggle with the complexity of aspect-sentiment pairs and the nuances of sentiment expressions. In this paper, we propose a novel graph neural network-based approach for ABSA that leverages syntactic dependencies and co-occurrence relations to enhance aspect extraction and sentiment classification. Our model, SynGraph-ABSA, constructs a heterogeneous graph where nodes represent words, aspects, and sentiments, and edges capture syntactic and semantic relationships. We evaluate our approach on benchmark datasets such as SemEval-2014 and demonstrate significant improvements in F1-score for both aspect term extraction and sentiment polarity classification compared to state-of-the-art baselines.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Ma},
 journal = {EDBT},
 keywords = {source: Google Scholar},
 note = {Publisher: openproceedings.org
Type: PDF},
 title = {Unifying {Large}},
 url = {https://www.openproceedings.org/2025/conf/edbt/paper-T4.pdf},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:20:25Z},
 year = {2025}
}

@article{madden_databases_2024,
 abstract = {Over the past five decades, the relational database model has proven to be a scaleable and adaptable model for querying a variety of structured data, with use cases in analytics, transactions, graphs, streaming and more. However, most of the world's data is unstructured. Thus, despite their success, the reality is that the vast majority of the world's data has remained beyond the reach of relational systems. The rise of deep learning and generative AI offers an opportunity to change this. These models provide a stunning capability to extract semantic understanding from almost any type of document, including text, images, and video, which can extend the reach of databases to all the world's data. In this paper we explore how these new technologies will transform the way we build database management software, creating new that systems that can ingest, store, process, and query all data. Building such systems presents many opportunities and challenges. In this paper we focus on three: scalability, correctness, and reliability, and argue that the declarative programming paradigm that has served relational systems so well offers a path forward in the new world of AI data systems as well. To illustrate this, we describe several examples of such declarative AI systems we have built in document and video processing, and provide a set of research challenges and opportunities to guide research in this exciting area going forward. And lovely apparitions, -dim at first , Then radiant, as the mind arising bright From the embrace of beauty (whence the forms Of which these are the phantoms) casts on them The gathered rays which are reality- Shall visit us the progeny immortal Of Painting, Sculpture, and rapt Poesy , And arts, though unimagined, yet to be ; Prometheus Unbound, Percy Bysshe Shelley},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Madden},
 doi = {10.14778/3685800.3685916},
 issn = {2150-8097},
 journal = {Proc. VLDB Endow.},
 keywords = {source: ACM},
 month = {aug},
 note = {Publisher: VLDB Endowment},
 number = {12},
 pages = {4546--4554},
 title = {Databases {Unbound}},
 url = {https://doi.org/10.14778/3685800.3685916},
 volume = {17},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:44Z},
 year = {2024}
}

@book{maes_fixing_2024,
 abstract = {Obesity is a major risk factor for type 2 diabetes, cardiovascular disease, and certain types of cancer. The worldwide obesity epidemic has been attributed to increased consumption of energy-dense foods and decreased physical activity. However, emerging evidence suggests that exposure to environmental chemicals may also contribute to the obesity epidemic. Here, we review the evidence linking exposure to environmental chemicals, particularly endocrine-disrupting chemicals (EDCs), to obesity and metabolic dysfunction. We discuss potential mechanisms by which EDCs may promote obesity, including effects on adipocyte differentiation, lipid metabolism, energy balance, and the gut microbiome. We also highlight critical windows of susceptibility during development when EDC exposure may have particularly profound effects on obesity risk later in life. Finally, we discuss challenges and future directions for research in this area, including the need for improved exposure assessment, consideration of chemical mixtures, and translation of findings to inform public health policy.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Maes},
 keywords = {source: Google Scholar},
 note = {Type: CITATION},
 publisher = {OSF},
 title = {Fixing {Reference}},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:12:15Z},
 year = {2024}
}

@article{magesh_hallucination-free_2025,
 abstract = {ABSTRACT Legal practice has witnessed a sharp rise in products incorporating artificial intelligence (AI). Such tools are designed to assist with a wide range of core legal tasks, from search and summarization of caselaw to document drafting. However, the large language models used in these tools are prone to “hallucinate,” or make up false information, making their use risky in high‐stakes domains. Recently, certain legal research providers have touted methods such as retrieval‐augmented generation (RAG) as “eliminating” or “avoid[ing]” hallucinations, or guaranteeing “hallucination‐free” legal citations. Because of the closed nature of these systems, systematically assessing these claims is challenging. In this article, we design and report on the first preregistered empirical evaluation of AI‐driven legal research tools. We demonstrate that the providers' claims are overstated. While hallucinations are reduced relative to general‐purpose chatbots (GPT‐4), we find that the AI research tools made by LexisNexis (Lexis+ AI) and Thomson Reuters (Westlaw AI‐Assisted Research and Ask Practical Law AI) each hallucinate between 17% and 33% of the time. We also document substantial differences between systems in responsiveness and accuracy. Our article makes four key contributions. It is the first to assess and report the performance of RAG‐based proprietary legal AI tools. Second, it introduces a comprehensive, preregistered dataset for identifying and understanding vulnerabilities in these systems. Third, it proposes a clear typology for differentiating between hallucinations and accurate legal responses. Last, it provides evidence to inform the responsibilities of legal professionals in supervising and verifying AI outputs, which remains a central open question for the responsible integration of AI into law.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 6; All Open Access; Hybrid Gold Open Access},
 author = {Magesh},
 doi = {10.1111/jels.12413},
 journal = {Journal of Empirical Legal Studies},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {2},
 pages = {216 -- 242},
 title = {Hallucination-{Free}},
 url = {https://doi.org/10.1111/jels.12413},
 volume = {22},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:39:30Z},
 year = {2025}
}

@inproceedings{mahalakshmi_real-time_2024,
 abstract = {In the digital age, the proliferation of online reviews has made sentiment analysis a vital tool for businesses to gauge customer opinions. However, existing methods often fall short in handling complex linguistic features like sarcasm and context-dependent sentiments. This paper introduces a hybrid deep learning framework that integrates BERT for contextual embeddings with a Bi-LSTM-CRF model for sequence labeling, aimed at improving sentiment classification accuracy. The proposed model is evaluated on the SemEval-2017 Task 4 dataset, achieving an F1-score of 68.5%, surpassing baseline models by 4.2%. Experimental results highlight the framework's robustness in capturing nuanced sentiments, offering practical implications for e-commerce and social media analytics.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
