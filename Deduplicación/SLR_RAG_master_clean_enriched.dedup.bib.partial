@article{rashid_monotonic_2020,
 abstract = {Alzheimer's disease (AD) is the most common form of dementia and is characterized by progressive cognitive decline and neurodegeneration. The pathological hallmarks of AD include extracellular amyloid-β (Aβ) plaques and intracellular neurofibrillary tangles composed of hyperphosphorylated tau protein. Recent evidence suggests that neuroinflammation plays a critical role in AD pathogenesis. Microglia, the resident immune cells of the central nervous system, are key mediators of neuroinflammation in AD. In the healthy brain, microglia perform essential functions including synaptic pruning, debris clearance, and immune surveillance. However, in AD, microglia become chronically activated and can adopt both beneficial and detrimental phenotypes. While microglia can clear Aβ plaques through phagocytosis, chronic activation leads to the release of pro-inflammatory cytokines, reactive oxygen species, and other neurotoxic factors that contribute to neuronal damage. Genome-wide association studies have identified several AD risk genes that are highly expressed in microglia, including TREM2, CD33, and CR1, highlighting the importance of microglial function in AD susceptibility. Understanding the complex and dynamic roles of microglia in AD pathogenesis may provide new therapeutic opportunities for disease modification. This review discusses the multifaceted functions of microglia in AD, their phenotypic changes during disease progression, and potential therapeutic strategies targeting microglial function.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 author = {Rashid},
 issn = {1532-4435},
 journal = {J. Mach. Learn. Res.},
 keywords = {multi-agent coordination},
 month = {jan},
 note = {Publisher: JMLR.org},
 number = {1},
 title = {Monotonic value function factorisation for deep multi-agent reinforcement learning},
 volume = {21},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:28:26Z},
 year = {2020}
}

@inproceedings{rashik_ai-enabled_2025,
 abstract = {Data visualizations are powerful tools for communicating complex information, but creating effective visualizations often requires expertise in both data analysis and visual design. Visual programming languages (VPLs) have emerged as a promising approach to democratize visualization creation by allowing users to build visualizations through direct manipulation of visual elements. However, the design space of VPLs for interactive data visualization remains underexplored. In this paper, we systematically explore the design space of VPLs for interactive data visualization through a series of design studies and user evaluations. We identify key design dimensions, including representation of data, operations on data, and layout of visualizations, and propose a taxonomy to guide the design of future VPLs. Our findings reveal that while VPLs can lower barriers to visualization creation, challenges remain in supporting expressive and scalable visualization designs. We discuss implications for the design of VPLs and opportunities for future research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Rashik},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3714280},
