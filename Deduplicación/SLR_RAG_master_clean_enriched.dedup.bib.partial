@inproceedings{ji_rela_2024,
 abstract = {This paper proposes a blockchain-based framework for enhancing supply chain finance (SCF) efficiency and security. Traditional SCF faces challenges such as information asymmetry, high transaction costs, and trust issues among participants. By integrating blockchain technology, the framework ensures data immutability, transparency, and smart contract automation for financing processes. We design a multi-layer architecture including data layer, network layer, consensus layer, and application layer, tailored for SCF scenarios. Simulation results demonstrate that the proposed system reduces financing time by 40% and lowers costs by 25% compared to conventional methods, while improving risk management through decentralized verification. The approach is validated using Hyperledger Fabric, showing strong applicability in real-world supply chains.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
