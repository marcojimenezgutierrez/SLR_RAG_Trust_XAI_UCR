@article{yuan_hybrid_2024,
 abstract = {Generalist robot policies are increasingly being developed to handle a wide range of tasks in diverse environments. However, the design space for these policies remains largely unexplored, with most works focusing on specific aspects like data, training, or evaluation. In this work, we systematically study the key factors that influence the performance of generalist robot policies. We identify and evaluate several critical design choices, including data curation strategies, training objectives, and evaluation protocols. Our findings reveal that careful selection of these elements can significantly improve policy generalization and robustness. We also introduce a new benchmark for assessing generalist robot policies, which emphasizes real-world applicability. Through extensive experiments on both simulation and real-world robotic platforms, we demonstrate that our insights lead to state-of-the-art performance on multiple tasks. This work provides a comprehensive guide for practitioners aiming to build effective generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
