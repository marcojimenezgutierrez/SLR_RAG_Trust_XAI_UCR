@article{saad-falcon_ares_2023,
 abstract = {Medicine is a complex interdisciplinary field that combines multiple domains of science and engineering. The rapid advancement of AI technology has shown great potential in assisting medical professionals in various tasks, such as disease diagnosis, treatment recommendation, and patient monitoring. However, most existing AI models for medicine are specialized for specific tasks or modalities, limiting their applicability in real-world clinical settings. In this paper, we introduce Med-PaLM 2, a large language model trained on a massive biomedical dataset. Med-PaLM 2 demonstrates state-of-the-art performance on medical question answering, surpassing fine-tuned results on specialized medical models. In addition, Med-PaLM 2 shows improved performance on tasks requiring reasoning and multi-step inference, as well as a more factual and safe generation. Finally, we show that Med-PaLM 2 can be used to generate discharge summaries and answer patient questions, demonstrating its potential for clinical applications. We believe that Med-PaLM 2 can be a step towards developing generalist biomedical AI systems that can assist medical professionals in a wide range of tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
