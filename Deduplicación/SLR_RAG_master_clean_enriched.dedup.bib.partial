@inproceedings{mozafari_triviahg_2024,
 abstract = {Recent advances in large language models (LLMs) have led to their widespread adoption in various applications. However, these models often exhibit biases that can result in unfair or harmful outputs, particularly in sensitive domains like hiring, lending, and criminal justice. In this paper, we present a comprehensive survey of bias auditing techniques for LLMs. We categorize existing methods into intrinsic and extrinsic approaches, discussing their strengths, limitations, and applicability to different bias types such as gender, racial, and cultural biases. Furthermore, we explore emerging challenges in auditing multilingual and multimodal LLMs, and propose directions for future research to enhance fairness and robustness in LLM deployments.},
 abstract_lang = {en},
