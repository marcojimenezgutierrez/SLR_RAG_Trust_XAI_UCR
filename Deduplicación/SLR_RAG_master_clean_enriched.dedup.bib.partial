@article{jovanovic_ward_2024,
 abstract = {We present a large-scale video dataset of robotic manipulation, comprising over 1 million trajectories collected from 22 different robots, 527 unique objects, and 118 tasks in 21 different environments. The dataset, called BridgeData V2, is designed to facilitate research on generalization in robotics, and includes diverse data sources such as human teleoperation, scripted policies, and reinforcement learning. We demonstrate that training on BridgeData V2 enables a single policy to solve a wide range of tasks, including those not seen during training. We further show that these policies transfer to novel objects and environments, and can be fine-tuned for specific tasks with minimal data. Our results suggest that large-scale, diverse datasets are key to developing generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
