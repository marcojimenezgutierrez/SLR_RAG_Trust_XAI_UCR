@inproceedings{vassos_now_2024,
 abstract = {Large language models (LLMs) underpin an ecosystem of tools that support their use. However, the complexity of LLM-based workflows makes it difficult for users to explore, debug, and refine their prompts. We introduce ChainForge, a visual toolkit for building, visualizing, and testing chains of LLM calls. ChainForge provides a canvas for constructing LLM workflows, a library of prompts and model configurations, and a debugger for inspecting intermediate outputs. We evaluate ChainForge through a study with 10 users, finding that it helps users explore the design space of LLM workflows, understand the effects of prompt changes, and debug unexpected behaviors. Our findings suggest that visual programming tools can make LLM workflows more accessible to non-experts.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 0},
