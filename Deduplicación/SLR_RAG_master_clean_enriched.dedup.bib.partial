@inproceedings{tang_test_2024,
 abstract = {Recent advances in large language models (LLMs) have enabled the creation of powerful AI assistants that can perform complex tasks, such as writing code, generating text, and answering questions. However, these assistants often struggle with tasks that require deep understanding of user intent, context, and long-term planning. In this paper, we introduce a novel framework for human-AI collaboration that leverages reinforcement learning from human feedback (RLHF) to improve the alignment of AI assistants with user preferences. Our approach combines supervised fine-tuning with RLHF to create assistants that are not only helpful but also safe and interpretable. We evaluate our framework on a suite of benchmarks and demonstrate significant improvements in task completion rates and user satisfaction. Our results highlight the potential of RLHF to bridge the gap between current AI capabilities and human-like intelligence.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Tang},
 booktitle = {Proceedings of the 19th {Workshop}},
 doi = {10.1145/3691555.3696825},
