@article{tan_llama-utp_2025,
 abstract = {This paper proposes a novel framework for secure federated learning in edge computing environments, addressing privacy preservation and communication efficiency challenges. We introduce a differential privacy mechanism integrated with homomorphic encryption to protect model updates during aggregation. Extensive simulations on real-world datasets demonstrate that our approach achieves up to 30% reduction in communication overhead while maintaining model accuracy within 2% of baseline methods. The framework is evaluated under various network conditions, highlighting its robustness against adversarial attacks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
