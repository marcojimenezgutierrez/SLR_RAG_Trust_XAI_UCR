@inproceedings{lee_peerspective_2025,
 abstract = {We propose GS-SLAM, a novel dense visual SLAM system that integrates 3D Gaussian Splatting (3DGS) into the optimization-based SLAM framework. GS-SLAM enables real-time dense reconstruction and tracking of unknown environments while achieving high accuracy and photorealism. By representing the scene with millions of anisotropic 3D Gaussians, our method can render novel views in real time. We introduce a novel Gaussian-Bundle-Adjustment (GBA) procedure that jointly optimizes the 3D Gaussians and camera poses. To enable robust tracking, we propose a Gaussian depth filter that provides accurate depth supervision. Extensive experiments on public datasets demonstrate that GS-SLAM outperforms state-of-the-art NeRF-based methods in terms of accuracy, efficiency, and rendering quality.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Lee},
