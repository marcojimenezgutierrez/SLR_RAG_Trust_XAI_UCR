@inproceedings{al_owayyed_controlled_2025,
 abstract = {This paper introduces PromptChainer, a novel system that leverages large language models (LLMs) to generate and iteratively refine chain-of-thought (CoT) prompts for code generation tasks. By treating prompt engineering as a collaborative process between humans and AI, PromptChainer enables users to create more effective prompts without deep expertise in prompt design. We evaluate PromptChainer on a benchmark of programming problems, demonstrating significant improvements in code correctness and efficiency compared to standard CoT prompting. Our findings highlight the potential of LLM-assisted prompt chaining to democratize advanced AI usage in software development.},
