@inproceedings{ku_enhancing_2025,
 abstract = {This paper presents a novel approach for optimizing energy consumption in smart grids using reinforcement learning techniques. We propose a deep Q-network (DQN) model integrated with multi-agent systems to dynamically manage load balancing and renewable energy integration. Simulation results on a real-world dataset demonstrate a 25% reduction in peak demand and improved grid stability compared to traditional methods. The framework is scalable and adaptable to varying grid topologies, offering practical implications for sustainable energy management.},
