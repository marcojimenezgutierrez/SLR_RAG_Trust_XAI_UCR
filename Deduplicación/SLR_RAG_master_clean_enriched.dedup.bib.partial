@article{hwang_efficient_2025,
 abstract = {In this study, we propose a novel framework for enhancing cybersecurity in IoT environments using blockchain technology integrated with machine learning algorithms. The framework addresses key challenges such as data privacy, scalability, and real-time threat detection. By leveraging distributed ledger technology, our approach ensures tamper-proof transaction records while employing supervised learning models to predict and mitigate potential attacks. Experimental results on a simulated IoT network demonstrate a 25% improvement in detection accuracy and a 40% reduction in response time compared to traditional methods. This work provides a scalable solution for securing interconnected devices in smart cities and industrial applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
