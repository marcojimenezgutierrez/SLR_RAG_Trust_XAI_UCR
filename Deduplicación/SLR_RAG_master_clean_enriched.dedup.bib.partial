@article{mukhopadhyay_designing_2025,
 abstract = {The rapid advancement of blockchain technology has opened new avenues for its application in various sectors, including libraries and information management. This paper provides a comprehensive review of blockchain's potential in digital libraries, focusing on its ability to ensure data integrity, enhance security, and facilitate decentralized access to resources. Key applications discussed include secure digital archiving, copyright management, and peer-to-peer resource sharing. The study also examines challenges such as scalability, interoperability, and regulatory issues. Drawing from existing literature and case studies, the paper concludes with recommendations for libraries to adopt blockchain while addressing implementation barriers, emphasizing the need for collaborative efforts among stakeholders to harness its full potential.},
