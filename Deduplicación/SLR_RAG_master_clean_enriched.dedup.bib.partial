 title = {Marketsenseai 2.0: {Enhancing}},
 url = {https://arxiv.org/abs/2502.00415},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:54:38Z},
 year = {2025}
}

@inproceedings{fayyazi_advancing_2024,
 abstract = {Adversarial machine learning (AML) has emerged as a significant threat to the security and reliability of machine learning (ML) systems. While much research has focused on generating adversarial examples to attack ML models, the detection of such examples remains a critical challenge, particularly in real-world deployments where adversaries may use unknown or adaptive attacks. This paper provides a comprehensive survey of adversarial example detection methods, categorizing them into four main types: statistical methods, model-based methods, input transformation methods, and hybrid approaches. We analyze the strengths and limitations of each category, discuss their applicability to different attack scenarios, and highlight open challenges such as robustness against adaptive adversaries and scalability in production environments. By synthesizing insights from over 100 recent works, this survey aims to guide researchers and practitioners in developing more resilient ML systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
