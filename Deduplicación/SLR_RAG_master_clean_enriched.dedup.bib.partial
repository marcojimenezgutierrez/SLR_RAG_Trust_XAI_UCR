@inproceedings{nethassanai_mari_2025,
 abstract = {This paper presents a novel approach for enhancing the security of Internet of Things (IoT) devices using blockchain technology integrated with machine learning algorithms. The proposed system addresses key challenges in IoT ecosystems, such as data privacy, integrity, and scalability, by leveraging a decentralized ledger for secure data transactions and anomaly detection models for threat identification. Experimental results demonstrate improved detection accuracy of 95% and reduced latency compared to traditional methods, making it suitable for real-time applications in smart homes and industrial IoT environments.},
