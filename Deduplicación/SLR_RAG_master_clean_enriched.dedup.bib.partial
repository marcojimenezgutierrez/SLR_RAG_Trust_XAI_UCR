@inproceedings{abbas_pitch_2025,
 abstract = {User interface (UI) design is an iterative process where designers often draw inspiration from existing designs. However, the extent to which UI designs are reused across applications, and the implications of such reuse, remain underexplored. In this paper, we investigate UI reuse by analyzing a large-scale dataset of UI screenshots from mobile apps. We develop EchoTrace, a system that uses deep learning to detect and trace reused UI elements and patterns across apps. Applying EchoTrace to over 100,000 screenshots, we find that UI reuse is widespread, with common patterns appearing in up to 70% of apps for features like navigation and forms. We also identify "design echoes"—subtle variations of reused elements that evolve over time. Our findings highlight opportunities for design tools to support ethical reuse and reduce redundant effort, while raising concerns about homogenization in UI design.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Abbas},
 booktitle = {Proceedings of the 7th {ACM}},
 doi = {10.1145/3719160.3736634},
 isbn = {979-8-4007-1527-3},
 keywords = {behavior change},
 publisher = {Association for Computing Machinery},
 series = {{CUI}},
 title = {{PITCH}},
 url = {https://doi.org/10.1145/3719160.3736634},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:37:16Z},
 year = {2025}
}

@inproceedings{abbasiantaeb_conversational_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, they often exhibit biases inherited from their training data, leading to unfair or harmful outputs. Mitigating these biases is crucial for deploying LLMs responsibly. In this paper, we conduct a comprehensive survey on bias mitigation techniques for LLMs. We categorize the methods into three main categories: data-level interventions, model-level interventions, and post-processing interventions. For each category, we discuss the key approaches, their mechanisms, advantages, and limitations. We also provide empirical insights from recent studies and highlight open challenges and future research directions in achieving fairness in LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 2; All Open Access; Gold Open Access},
 author = {Abbasiantaeb},
