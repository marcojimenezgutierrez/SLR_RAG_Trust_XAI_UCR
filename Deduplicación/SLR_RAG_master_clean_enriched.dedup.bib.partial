 x_enrich_ts = {2025-11-02T06:31:36Z},
 year = {2024}
}

@article{leschanowsky_transparent_2025,
 abstract = {This paper introduces a novel framework for learning generalist robot policies that can transfer across diverse manipulation tasks and embodiments. We argue that transfer learning is key to scaling robot learning, and propose a two-stage approach: first, pre-training on a large corpus of diverse, self-supervised data to learn robust visual representations and low-level control skills; second, fine-tuning with reinforcement learning on task-specific data to adapt to new objectives. Our method leverages a transformer-based architecture that unifies perception, planning, and control, enabling zero-shot transfer to unseen tasks and robots. Experiments on simulated and real-world benchmarks demonstrate significant improvements in sample efficiency and generalization compared to prior specialized policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Leschanowsky},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Transparent nlp: {Using}},
 url = {https://arxiv.org/abs/2502.06652},
 x_enrich_source = {x-ai/grok-4-fast},
