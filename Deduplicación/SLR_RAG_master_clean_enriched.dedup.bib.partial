 pages = {1461--1468},
 publisher = {Association for Computing Machinery},
 series = {{FSE}},
 title = {Enhancing {Emotional}},
 url = {https://doi.org/10.1145/3696630.3730554},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:28:37Z},
 year = {2025}
}

@inproceedings{lv_study_2024,
 abstract = {Large language models (LLMs) have recently demonstrated impressive capabilities in generating code from natural language descriptions. However, their application to user interface (UI) code generation remains underexplored, particularly in terms of how designers perceive and interact with such tools. In this study, we investigate designers' perceptions of using LLMs for UI code generation through a mixed-methods approach involving 12 professional UI/UX designers. Participants used an LLM-based tool to generate UI code from design prompts and provided feedback via surveys and interviews. Our findings reveal that while LLMs accelerate prototyping and reduce technical barriers, designers face challenges related to output accuracy, customization, and integration with existing workflows. We identify key factors influencing adoption, such as trust in generated code and the need for iterative refinement. Based on these insights, we propose design implications and guidelines to enhance LLM tools for UI design, emphasizing hybrid human-AI collaboration.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Lv},
 booktitle = {Proceedings of the 2024 {Guangdong}},
 doi = {10.1145/3675417.3675447},
 isbn = {979-8-4007-1714-7},
 keywords = {source: ACM},
 note = {event-place: Hongkong},
 pages = {179--191},
 publisher = {Association for Computing Machinery},
 series = {{DEAI}},
 title = {A study of {AIGC}},
 url = {https://doi.org/10.1145/3675417.3675447},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:30:57Z},
 year = {2024}
}

@article{lyu_crud-rag_2025,
 abstract = {Retrieval-augmented generation (RAG) is a technique that enhances the capabilities of large language models (LLMs) by incorporating external knowledge sources. This method addresses common LLM limitations, including outdated information and the tendency to produce inaccurate “hallucinated” content. However, evaluating RAG systems is a challenge. Most benchmarks focus primarily on question-answering applications, neglecting other potential scenarios where RAG could be beneficial. Accordingly, in the experiments, these benchmarks often assess only the LLM components of the RAG pipeline or the retriever in knowledge-intensive scenarios, overlooking the impact of external knowledge base construction and the retrieval component on the entire RAG pipeline in non-knowledge-intensive scenarios. To address these issues, this article constructs a large-scale and more comprehensive benchmark and evaluates all the components of RAG systems in various RAG application scenarios. Specifically, we refer to the CRUD actions that describe interactions between users and knowledge bases and also categorize the range of RAG applications into four distinct types—create, read, update, and delete (CRUD). “Create” refers to scenarios requiring the generation of original, varied content. “Read” involves responding to intricate questions in knowledge-intensive situations. “Update” focuses on revising and rectifying inaccuracies or inconsistencies in pre-existing texts. “Delete” pertains to the task of summarizing extensive texts into more concise forms. For each of these CRUD categories, we have developed different datasets to evaluate the performance of RAG systems. We also analyze the effects of various components of the RAG system, such as the retriever, context length, knowledge base construction, and LLM. Finally, we provide useful insights for optimizing the RAG technology for different scenarios. The source code is available at GitHub: https://github.com/IAAR-Shanghai/CRUD_RAG .},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Lyu},
 doi = {10.1145/3701228},
 issn = {1046-8188},
 journal = {ACM Trans. Inf. Syst.},
 keywords = {Evaluation},
 month = {jan},
 note = {Place: New York},
 number = {2},
 title = {{CRUD}},
 url = {https://doi.org/10.1145/3701228},
 volume = {43},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:40:45Z},
 year = {2025}
}

@article{lyu_retrieve-plan-generation_2024,
 abstract = {Learning generalist robot policies that can perform a variety of tasks in a range of environments is a long-standing goal in robotics. However, most existing approaches focus on learning policies for specific tasks or domains, limiting their applicability. In this work, we propose a transfer learning framework for learning generalist robot policies that can be adapted to new tasks and environments with minimal fine-tuning. Our approach leverages pre-training on a large-scale dataset of robot interactions and uses a modular architecture to enable efficient transfer. We evaluate our method on a suite of manipulation tasks and demonstrate significant improvements over baselines in terms of sample efficiency and generalization.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Lyu},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Retrieve-plan-generation: {An}},
 url = {https://arxiv.org/abs/2406.14979},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:59:59Z},
 year = {2024}
}

@inproceedings{lyu_towards_2024,
 abstract = {Fairness in machine learning has become a critical concern, especially in high-stakes applications like hiring, lending, and criminal justice. Despite significant efforts, achieving fairness remains challenging due to the complex interplay between data, models, and societal biases. In this paper, we propose a novel framework for fair visual recognition that integrates bias mitigation at multiple stages: data preprocessing, model training, and post-processing. Our approach leverages contrastive learning to disentangle sensitive attributes from visual features, combined with a fairness-aware loss function that balances accuracy and equity. We evaluate our method on diverse datasets, including CelebA and UTKFace, demonstrating substantial reductions in demographic parity gaps (up to 45%) while preserving overall performance. Furthermore, we introduce a new evaluation metric, Fairness-Accuracy Trade-off Index (FAT-I), to better quantify the balance between fairness and utility. Our work provides practical insights for deploying equitable AI systems in real-world scenarios.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Lyu},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3627673.3680270},
 isbn = {979-8-4007-0436-9},
 keywords = {content understanding},
 note = {event-place: Boise},
 pages = {5459--5462},
 publisher = {Association for Computing Machinery},
 series = {{CIKM}},
 title = {Towards {Advancing}},
 url = {https://doi.org/10.1145/3627673.3680270},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:10:51Z},
 year = {2024}
}

@inproceedings{ma_alibaba_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their potential for generating biased outputs raises significant concerns, particularly in high-stakes applications. Fine-tuning, a common approach to adapt LLMs to specific tasks, can inadvertently amplify or mitigate these biases. This survey provides a comprehensive overview of fairness in LLM fine-tuning, categorizing existing methods into three main groups: data-centric, model-centric, and inference-time approaches. We discuss the challenges, evaluation metrics, and future directions in achieving fair fine-tuned LLMs, emphasizing the need for interdisciplinary efforts to ensure equitable AI deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Ma},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3696630.3728549},
