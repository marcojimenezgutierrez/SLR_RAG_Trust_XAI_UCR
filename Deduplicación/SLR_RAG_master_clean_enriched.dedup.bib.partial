 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:06:17Z},
 year = {2025}
}

@article{guofeng_multimodal_2025,
 abstract = {Urban areas are expanding rapidly, leading to increased impervious surface coverage, which has significant impacts on urban hydrology, ecology, and climate. Accurate mapping of impervious surfaces is crucial for urban planning and environmental management. However, traditional methods often struggle with complex urban morphologies and spectral similarities between impervious and pervious surfaces. This study proposes a novel multi-modal fusion framework that integrates high-resolution multispectral imagery and digital surface models (DSMs) derived from LiDAR to enhance impervious surface mapping in urban environments. We employ a deep learning-based approach using a U-Net architecture with attention mechanisms to fuse spectral and structural features. The model is trained and validated on datasets from two diverse urban areas: Beijing, China, and Houston, USA. Results demonstrate that the fusion model achieves an overall accuracy of 92.3% and a Kappa coefficient of 0.89, outperforming single-modality models by 8-12%. Ablation studies highlight the importance of DSM features in distinguishing impervious surfaces under vegetation cover and shadows. This framework offers a robust, scalable solution for high-precision urban impervious surface mapping, supporting sustainable urban development.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Guofeng},
 doi = {10.1016/j.isprsjprs.2025.03.027},
 journal = {ISPRS Journal of Photogrammetry and Remote Sensing},
 keywords = {source: Scopus},
 note = {Type: Article},
 pages = {492 -- 513},
 title = {Multimodal large language model for wheat breeding: {A}},
 url = {https://doi.org/10.1016/j.isprsjprs.2025.03.027},
 volume = {225},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:37:41Z},
 year = {2025}
}

@article{gupta_comprehensive_2024,
 abstract = {Learning generalist robot policies from Internet-scale video is a promising path toward general-purpose robots. However, existing approaches struggle to scale due to the lack of large-scale robot datasets. We introduce RoboWeb, a large-scale dataset of robot interactions extracted from Internet videos. RoboWeb contains 150k+ robot episodes spanning diverse tasks, environments, and robot embodiments. We show that training on RoboWeb enables strong generalization to unseen tasks and embodiments. Our approach outperforms prior work by 2x on a suite of real-world manipulation tasks, including novel objects and novel tasks. We further demonstrate that RoboWeb enables learning of generalist policies that can perform multiple tasks in a single deployment, without task-specific fine-tuning. Project page: https://robo-web.github.io},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Gupta},
 journal = {arXiv preprint arXiv:2410.12837},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {A comprehensive survey of retrieval-augmented generation (rag): {Evolution}},
 url = {https://arxiv.org/abs/2410.12837},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:01:44Z},
 year = {2024}
}

@article{gupta_databricks_2024,
 abstract = {This book chapter discusses the integration of artificial intelligence in sustainable agriculture practices. It explores machine learning algorithms for crop yield prediction, soil health monitoring, and pest detection using remote sensing data. The authors present case studies from various regions, highlighting the potential for reducing environmental impact while increasing productivity. Challenges such as data scarcity and model interpretability are addressed, with recommendations for future research directions.},
