@inproceedings{bordino_uniask_2025,
 abstract = {Graph Neural Networks (GNNs) have emerged as a powerful tool for learning representations over graph-structured data, with applications in various domains such as social networks, biological networks, and recommendation systems. However, training GNNs on large-scale graphs poses significant challenges due to the high computational cost and memory requirements. In this paper, we propose a novel framework for efficient GNN training that leverages graph sampling and mini-batch processing to reduce the computational overhead. Our approach introduces a dynamic sampling strategy that adaptively selects subgraphs based on the query patterns, ensuring both accuracy and efficiency. We evaluate our method on real-world datasets and demonstrate significant improvements in training time and scalability compared to state-of-the-art baselines.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Bordino},
 booktitle = {Advances in {Database}},
 doi = {10.48786/edbt.2025.89},
 keywords = {source: Scopus},
 note = {Issue: 3
Type: Conference paper},
