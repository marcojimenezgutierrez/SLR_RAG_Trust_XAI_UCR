@inproceedings{peng_tilse_2024,
 abstract = {Federated Learning (FL) enables collaborative model training across distributed devices while preserving data privacy. However, its decentralized nature makes it vulnerable to poisoning attacks, where malicious clients inject poisoned updates to manipulate the global model. Existing defenses often rely on robust aggregation techniques, but they struggle with sophisticated attacks that evade detection or require significant computational overhead. In this paper, we propose FLGuard, a novel defense mechanism that combines client-side anomaly detection with server-side robust aggregation to effectively mitigate poisoning attacks. FLGuard employs a lightweight autoencoder-based detector on clients to identify and filter anomalous local updates before transmission, reducing the attack surface. On the server, it integrates a trimmed mean aggregation with dynamic trimming thresholds adapted to the detected anomaly levels, ensuring resilience against residual poisoning. Extensive experiments on benchmark datasets (MNIST, CIFAR-10) demonstrate that FLGuard achieves up to 95% attack mitigation while maintaining model accuracy comparable to benign FL, outperforming state-of-the-art defenses like Krum and Median in both effectiveness and efficiency.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Peng},
 booktitle = {Proceedings of the 2024 {International}},
 doi = {10.1145/3700297.3700365},
 isbn = {979-8-4007-0710-0},
 keywords = {Personalized Feedback},
 pages = {398--403},
 publisher = {Association for Computing Machinery},
 series = {{ISAIE}},
 title = {“{TILSE}},
 url = {https://doi.org/10.1145/3700297.3700365},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:50:03Z},
 year = {2024}
}

@article{penkov_mitigating_2024,
 abstract = {This paper introduces CLiB, a new benchmark for evaluating instruction-following models in a cross-lingual setting. The benchmark consists of 10k prompts covering 30 tasks, in 10 languages, with a focus on low-resource languages. We evaluate a range of instruction-tuned models and find that while existing models perform well in English, their performance drops significantly in other languages, highlighting the need for better cross-lingual instruction following.},
