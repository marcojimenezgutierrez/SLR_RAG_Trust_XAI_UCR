 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:17:24Z},
 year = {2024}
}

@inproceedings{celik_hybridizing_2025,
 abstract = {This paper proposes a novel approach for enhancing the security of IoT devices using blockchain technology integrated with machine learning algorithms. We address the challenges of data privacy and integrity in distributed networks by implementing a decentralized ledger system that verifies transactions through a consensus mechanism optimized for resource-constrained environments. Experimental results on a simulated IoT network demonstrate a 35% improvement in detection accuracy for anomalous activities compared to traditional methods, with reduced latency in transaction processing. The proposed framework is scalable and adaptable to various IoT applications, including smart homes and industrial automation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
