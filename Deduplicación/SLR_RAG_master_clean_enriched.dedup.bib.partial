 journal = {Proceedings of the 5th …},
 keywords = {source: Google Scholar},
 note = {Publisher: dl.acm.org},
 pages = {74--81},
 publisher = {Association for Computing Machinery},
 series = {{EuroMLSys}},
 title = {Efficient federated search for retrieval-augmented generation},
 url = {https://doi.org/10.1145/3721146.3721942},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:19:00Z},
 year = {2025}
}

@inproceedings{guettala_building_2024,
 abstract = {The rapid development of Internet of Things (IoT) devices has led to an exponential increase in data generation, necessitating efficient data processing techniques. Traditional centralized data processing approaches face challenges such as latency, bandwidth limitations, and privacy concerns. To address these issues, this paper proposes a novel edge computing framework integrated with federated learning for real-time IoT data analytics. The framework leverages edge nodes to perform local computations, reducing the data transmission to the cloud while preserving user privacy through federated learning mechanisms. We introduce an optimized aggregation algorithm that enhances model convergence and accuracy in heterogeneous IoT environments. Extensive simulations using real-world datasets demonstrate that the proposed framework achieves up to 40% reduction in latency and 25% improvement in prediction accuracy compared to baseline methods. The results highlight the framework's potential for scalable and secure IoT deployments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Guettala},
 booktitle = {2024 2nd {International}},
 doi = {10.1109/ICCDA64887.2024.10867361},
