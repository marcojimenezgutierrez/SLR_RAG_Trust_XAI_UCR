@inproceedings{cerqueira_grounded_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly impacted various sectors, including healthcare. This study explores the integration of machine learning algorithms in diagnostic imaging to enhance early detection of diseases such as cancer. Using a dataset of over 10,000 medical images from public repositories, we developed and evaluated convolutional neural network (CNN) models, achieving an accuracy of 94.5% in classifying malignant versus benign tumors. Our findings demonstrate the potential of AI to reduce diagnostic errors and improve patient outcomes, while highlighting ethical considerations regarding data privacy and algorithmic bias. Future research should focus on real-world clinical validation and interdisciplinary collaboration.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
