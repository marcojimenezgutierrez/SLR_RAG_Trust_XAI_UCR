 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:07:00Z},
 year = {2025}
}

@article{wang_feb4rag_2024,
 abstract = {Large language models (LLMs) have recently demonstrated impressive capabilities in generating human-like text. However, their use in interactive systems, particularly in conversational settings, often leads to verbose or irrelevant responses, which can disrupt the flow of interaction. In this paper, we explore the role of silence in human-AI conversations, hypothesizing that intentional pauses can improve user experience by allowing time for reflection and reducing cognitive load. Through a mixed-methods study involving 48 participants interacting with an LLM-based chatbot, we examine different silence strategies (e.g., fixed-duration pauses, context-aware silences) and their impact on perceived naturalness, engagement, and task efficiency. Our quantitative results show that moderate silences (2-5 seconds) significantly increase user satisfaction (p < 0.01) compared to continuous responses, while qualitative feedback highlights preferences for silences that mimic human conversational rhythms. We discuss design implications for LLM interfaces and propose a framework for integrating silence as a core interaction element.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
