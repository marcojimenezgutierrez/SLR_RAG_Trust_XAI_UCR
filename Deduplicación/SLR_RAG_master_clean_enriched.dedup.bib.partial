 x_enrich_ts = {2025-11-02T07:42:04Z},
 year = {2025}
}

@inproceedings{xu_research_2024,
 abstract = {With the rapid development of the Internet, the number of users of online shopping platforms has increased significantly, and the problem of malicious comments has become increasingly prominent. Malicious comments not only affect the shopping experience of consumers but also damage the reputation of merchants. Therefore, it is of great significance to identify malicious comments. Traditional malicious comment recognition methods mainly rely on manual feature extraction, which has the problems of high cost and low efficiency. In recent years, deep learning technology has been widely used in the field of natural language processing, showing excellent performance. This paper proposes a malicious comment recognition model based on multi-head attention mechanism and BiLSTM. The model first uses the multi-head attention mechanism to capture the contextual semantic information of comments from multiple perspectives, and then uses BiLSTM to model the long-term dependencies in the sequence. Finally, the softmax classifier is used to classify the comments. Experiments on the public dataset show that the proposed model achieves better performance than the baseline models.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Xu},
 booktitle = {2024 7th {International}},
 doi = {10.1109/DSIT61374.2024.10881483},
