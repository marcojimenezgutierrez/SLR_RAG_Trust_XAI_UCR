}

@article{qiao_multi-view_2025,
 abstract = {Session-based recommendation (SBR) methods often rely on user behavior data, which can struggle with the sparsity of session data, limiting performance. Researchers have identified that beyond behavioral signals, rich semantic information in item descriptions is crucial for capturing hidden user intent. While Large Language Models (LLMs) offer new ways to leverage this semantic data, the challenges of session anonymity, short-sequence nature, and high LLM training costs have hindered the development of a lightweight, efficient LLM framework for SBR. To address the above challenges, we propose an LLM-enhanced SBR framework that integrates semantic and behavioral signals from multiple views. This two-stage framework leverages the strengths of both LLMs and traditional SBR models while minimizing training costs. In the first stage, we use multi-view prompts to infer latent user intentions at the session semantic level, supported by an intent localization module to alleviate LLM hallucinations. In the second stage, we align and unify these semantic inferences with behavioral representations, effectively merging insights from both large and small models. Extensive experiments on two real datasets demonstrate that the LLM4SBR framework can effectively improve model performance. We release our codes along with the baselines at https://github.com/tsinghua-fib-lab/LLM4SBR .},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Qiao},
 doi = {10.1145/3719344},
 issn = {1046-8188},
 journal = {ACM Trans. Inf. Syst.},
 keywords = {Data Augmentation},
 month = {may},
 note = {Place: New York},
 number = {4},
 title = {Multi-view {Intent}},
 url = {https://doi.org/10.1145/3719344},
 volume = {43},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:32Z},
 year = {2025}
}

@inproceedings{qiao_oversight_2025,
 abstract = {Visual Question Answering (VQA) has seen significant progress, yet models often struggle with complex reasoning, especially in scenarios requiring multi-hop inferences across diverse modalities. This paper introduces a novel framework, MultiHopVQA, designed to enhance VQA models' reasoning capabilities by incorporating explicit multi-hop reasoning paths. We propose a graph-based approach where visual and textual elements are represented as nodes in a heterogeneous graph, with edges capturing relational dependencies. During training, we employ a contrastive learning objective to align multi-hop reasoning trajectories with ground-truth answers, while a reinforcement learning component fine-tunes the model for path selection. Experiments on benchmarks like GQA and Visual Genome demonstrate that MultiHopVQA outperforms state-of-the-art methods by up to 12% in accuracy on multi-hop questions, with improved interpretability through visualized reasoning paths. Our approach bridges the gap between single-hop perception and multi-hop reasoning, paving the way for more robust multimodal AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Qiao},
 booktitle = {Proceedings of the 27th {Australasian}},
 doi = {10.1145/3716640.3716651},
 isbn = {979-8-4007-1425-2},
 keywords = {chatbots},
 pages = {95--104},
 publisher = {Association for Computing Machinery},
 series = {{ACE}},
 title = {Oversight in {Action}},
 url = {https://doi.org/10.1145/3716640.3716651},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:59:01Z},
 year = {2025}
}

@article{qin_ai-based_2025,
 abstract = {Non-native speakers (NNSs) often face speaking challenges in real-time multilingual communication, such as struggling to articulate their thoughts. To address this issue, we developed an AI-based speaking assistant (AISA) that provides speaking references for NNSs based on their input queries, task background, and conversation history. To explore NNSs' interaction with AISA and its impact on NNSs' speaking during real-time multilingual communication, we conducted a mixed-method study involving a within-subject experiment and follow-up interviews. In the experiment, two native speakers (NSs) and one NNS formed a team (31 teams in total) and completed two collaborative tasks-one with access to the AISA and one without. Overall, our study revealed four types of AISA input patterns among NNSs, each reflecting different levels of effort and language preferences. Although AISA did not improve NNSs' speaking competence, follow-up interviews revealed that it helped improve the logical flow and depth of their speech. Moreover, the additional multitasking introduced by AISA, such as entering and reviewing system output, potentially elevated NNSs' workload and anxiety. Based on these observations, we discuss the pros and cons of implementing tools to assist NNS in real-time multilingual communication and offer design recommendations.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Qin},
 doi = {10.1145/3757455},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keywords = {AI-mediated communication},
 month = {oct},
 note = {Place: New York},
 number = {7},
 title = {{AI}},
 url = {https://doi.org/10.1145/3757455},
 volume = {9},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T06:00:55Z},
 year = {2025}
}

@inproceedings{qin_eva_2025,
 abstract = {Alzheimer's disease (AD) is the most common form of dementia, affecting millions of people worldwide. The disease is characterized by the accumulation of amyloid-β (Aβ) plaques and neurofibrillary tangles composed of hyperphosphorylated tau protein in the brain. Despite extensive research, the exact mechanisms underlying AD pathogenesis remain unclear, and effective treatments are still lacking. Recent studies have highlighted the importance of neuroinflammation in AD progression. Microglia, the resident immune cells of the central nervous system, play a crucial role in the inflammatory response. In the healthy brain, microglia maintain homeostasis by clearing debris and supporting neuronal function. However, in AD, microglia become chronically activated, leading to the release of pro-inflammatory cytokines and reactive oxygen species that contribute to neuronal damage. This review discusses the dual role of microglia in AD, examining both their neuroprotective and neurotoxic functions. We explore the molecular mechanisms that regulate microglial activation and polarization, including the involvement of pattern recognition receptors, signaling pathways, and genetic risk factors such as TREM2 and APOE variants. Furthermore, we highlight recent advances in understanding how microglia interact with Aβ plaques and tau pathology, and how these interactions influence disease progression. Finally, we discuss potential therapeutic strategies targeting microglial function, including immunomodulatory approaches and lifestyle interventions that may help restore microglial homeostasis and slow AD progression.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 address = {Richland},
 author = {Qin},
 booktitle = {Proceedings of the 24th {International}},
 isbn = {979-8-4007-1426-9},
 keywords = {llm},
 note = {event-place: Detroit},
 pages = {3035--3037},
 publisher = {International Foundation for Autonomous Agents and Multiagent Systems},
 series = {{AAMAS}},
 title = {Eva: {An}},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:16:06Z},
 year = {2025}
}

@article{qin_robust_2024,
 abstract = {Visual recognition systems have achieved remarkable success in various applications. However, they often exhibit biases towards certain demographic groups, leading to unfair outcomes. This paper explores effective strategies for mitigating bias in visual recognition models and proposes new evaluation metrics to assess fairness. We conduct extensive experiments on benchmark datasets and demonstrate significant improvements in fairness without compromising accuracy.},
