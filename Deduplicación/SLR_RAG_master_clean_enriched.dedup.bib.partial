@article{seas_commentary_2024,
 abstract = {Artificial intelligence (AI) is revolutionizing various fields of medicine, including spine surgery. This review aims to explore the current applications of AI in spine surgery and discuss its future potential. AI technologies, such as machine learning and deep learning, have been utilized for preoperative diagnosis, surgical planning, intraoperative guidance, and postoperative outcome prediction. In preoperative settings, AI algorithms can analyze imaging data to detect spinal pathologies with high accuracy, aiding in personalized treatment planning. Intraoperatively, AI-enhanced navigation systems and robotic assistance improve precision and reduce complications. Postoperatively, predictive models help in monitoring recovery and identifying risks early. Despite these advancements, challenges including data privacy, algorithmic bias, and integration into clinical practice persist. Future directions involve developing explainable AI models, large-scale validation studies, and ethical frameworks to ensure safe and equitable implementation. AI holds promise to enhance surgical outcomes, efficiency, and patient care in spine surgery.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1; All Open Access; Gold Open Access; Green Final Open Access; Green Open Access},
 author = {Seas},
 doi = {10.14245/ns.2448248.124},
 journal = {Neurospine},
 keywords = {source: Scopus},
 note = {Type: Note},
 number = {1},
 pages = {159 -- 161},
 title = {Commentary on “{Use}},
 url = {https://doi.org/10.14245/ns.2448248.124},
 volume = {21},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:03:15Z},
 year = {2024}
}

@article{seeman_between_2024,
 abstract = {Differential privacy (DP) aims to confer data processing systems with inherent privacy guarantees, offering strong protections for personal data. But DP’s approach to privacy carries with it certain assumptions about how mathematical abstractions will be translated into real-world systems, which—if left unexamined and unrealized in practice—could function to shield data collectors from liability and criticism, rather than substantively protect data subjects from privacy harms. This article investigates these assumptions and discusses their implications for using DP to govern data-driven systems. In Parts 1 and 2, we introduce DP as, on one hand, a mathematical framework and, on the other hand, a kind of real-world sociotechnical system, using a hypothetical case study to illustrate how the two can diverge. In Parts 3 and 4, we discuss the way DP frames privacy loss, data processing interventions, and data subject participation, arguing it could exacerbate existing problems in privacy regulation. In part 5, we conclude with a discussion of DP’s potential interactions with the endogeneity of privacy law, and we propose principles for best governing DP systems. In making such assumptions and their consequences explicit, we hope to help DP succeed at realizing its promise for better substantive privacy protections.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Seeman},
 doi = {10.1145/3626494},
 journal = {ACM J. Responsib. Comput.},
 keywords = {critical code studies},
 month = {mar},
 note = {Place: New York},
 number = {1},
 title = {Between {Privacy}},
 url = {https://doi.org/10.1145/3626494},
 volume = {1},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:16Z},
 year = {2024}
}

@article{segalini_tanagpt_2025,
 abstract = {The analysis of large EHR data volumes in adult emergency departments contributes to physician burnout due to time-consuming manual information extraction. To address this, Hospital Italiano de Buenos Aires conducted a pilot study integrating TanaGPT, a generative AI assistant, into emergency consultations. This mixed-methods study assessed usability, adoption, and user perceptions through observations, a UMUX-Lite survey, and interviews. Results show that TanaGPT improved real-time access to patient information, streamlining workflows and reducing EHR navigation time. While improvements in response speed and workflow integration are needed, participants found the tool useful and easy to use, highlighting its potential for broader implementation in time-sensitive clinical settings.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Hybrid Gold Open Access},
 author = {Segalini},
 doi = {10.3233/SHTI250813},
