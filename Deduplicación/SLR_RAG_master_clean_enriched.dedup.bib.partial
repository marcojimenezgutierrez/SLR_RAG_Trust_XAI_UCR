@inproceedings{li_enhancing_2024,
 abstract = {Deep learning models have achieved remarkable success in various computer vision tasks, but they often exhibit biases inherited from training data, leading to unfair outcomes, especially in socially sensitive applications like facial recognition. Mitigating such biases while preserving model utility remains a critical challenge. In this paper, we conduct a comprehensive study on effective strategies for bias mitigation in visual recognition. We first categorize existing debiasing methods into three main types: data-centric, model-centric, and post-hoc approaches. Then, we propose a unified evaluation framework that assesses debiasing effectiveness across multiple dimensions, including demographic parity, equalized odds, and calibration. Through extensive experiments on popular benchmarks such as CelebA, UTKFace, and FairFace, we reveal that no single method universally outperforms others; instead, hybrid strategies combining data augmentation with adversarial training yield the best trade-off between fairness and accuracy. Our findings provide actionable insights for practitioners aiming to deploy fair visual recognition systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Li},
 booktitle = {Proceedings of the 1st {International}},
 doi = {10.1145/3643795.3648392},
 isbn = {979-8-4007-0579-3},
 keywords = {code generation},
 note = {event-place: Lisbon},
 pages = {70--74},
 publisher = {Association for Computing Machinery},
 series = {{LLM4Code}},
 title = {Enhancing {LLM}},
 url = {https://doi.org/10.1145/3643795.3648392},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:07:03Z},
 year = {2024}
}

@article{li_enhancing_2024-1,
 abstract = {Machine learning models have shown great promise in accelerating materials discovery by predicting properties from composition and structure. However, these models are typically specialized for specific properties or classes of materials, limiting their applicability. Here, we introduce MatSci-BERT, a materials pre-trained language model that leverages the vast amount of materials science literature to learn representations of materials. MatSci-BERT is trained on over 10 million sentences from materials science papers, enabling it to capture the complex relationships between materials and their properties. We evaluate MatSci-BERT on a variety of downstream tasks, including property prediction, material classification, and text generation, demonstrating its superior performance compared to traditional feature engineering approaches. Our results highlight the potential of pre-trained language models in advancing materials science research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Li},
 journal = {arXiv preprint arXiv:2403.10446},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Enhancing llm factual accuracy with rag to counter hallucinations: {A}},
 url = {https://arxiv.org/abs/2403.10446},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:39:34Z},
 year = {2024}
}

@article{li_enhancing_2025,
 abstract = {Abstract Background The rapid advancements in natural language processing, particularly the development of large language models (LLMs), have opened new avenues for managing complex clinical text data. However, the inherent complexity and specificity of medical texts present significant challenges for the practical application of prompt engineering in diagnostic tasks. Objective This paper explores LLMs with new prompt engineering technology to enhance model interpretability and improve the prediction performance of pulmonary disease based on a traditional deep learning model. Methods A retrospective dataset including 2965 chest CT radiology reports was constructed. The reports were from 4 cohorts, namely, healthy individuals and patients with pulmonary tuberculosis, lung cancer, and pneumonia. Then, a novel prompt engineering strategy that integrates feature summarization (F-Sum), chain of thought (CoT) reasoning, and a hybrid retrieval-augmented generation (RAG) framework was proposed. A feature summarization approach, leveraging term frequency–inverse document frequency (TF-IDF) and K-means clustering, was used to extract and distill key radiological findings related to 3 diseases. Simultaneously, the hybrid RAG framework combined dense and sparse vector representations to enhance LLMs’ comprehension of disease-related text. In total, 3 state-of-the-art LLMs, GLM-4-Plus, GLM-4-air (Zhipu AI), and GPT-4o (OpenAI), were integrated with the prompt strategy to evaluate the efficiency in recognizing pneumonia, tuberculosis, and lung cancer. The traditional deep learning model, BERT (Bidirectional Encoder Representations from Transformers), was also compared to assess the superiority of LLMs. Finally, the proposed method was tested on an external validation dataset consisted of 343 chest computed tomography (CT) report from another hospital. Results Compared with BERT-based prediction model and various other prompt engineering techniques, our method with GLM-4-Plus achieved the best performance on test dataset, attaining an F 1 -score of 0.89 and accuracy of 0.89. On the external validation dataset, F 1 -score (0.86) and accuracy (0.92) of the proposed method with GPT-4o were the highest. Compared to the popular strategy with manually selected typical samples (few-shot) and CoT designed by doctors ( F 1 -score=0.83 and accuracy=0.83), the proposed method that summarized disease characteristics (F-Sum) based on LLM and automatically generated CoT performed better ( F 1 -score=0.89 and accuracy=0.90). Although the BERT-based model got similar results on the test dataset ( F 1 -score=0.85 and accuracy=0.88), its predictive performance significantly decreased on the external validation set ( F 1 -score=0.48 and accuracy=0.78). Conclusions These findings highlight the potential of LLMs to revolutionize pulmonary disease prediction, particularly in resource-constrained settings, by surpassing traditional models in both accuracy and flexibility. The proposed prompt engineering strategy not only improves predictive performance but also enhances the adaptability of LLMs in complex medical contexts, offering a promising tool for advancing disease diagnosis and clinical decision-making.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Li},
 doi = {10.2196/72638},
 journal = {Journal of Medical Internet Research},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Enhancing {Pulmonary}},
 url = {https://doi.org/10.2196/72638},
 volume = {27},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:57:03Z},
 year = {2025}
}

@article{li_enhancing_2025-1,
 abstract = {We introduce a novel framework for understanding the emergent reasoning capabilities in large language models (LLMs) through the lens of probabilistic inference. By modeling LLMs as approximate Bayesian inference engines, we demonstrate how their ability to perform complex reasoning tasks arises from implicit probabilistic modeling of world knowledge. Our approach bridges the gap between neural network architectures and symbolic reasoning systems, enabling more interpretable and controllable AI systems. Experiments on benchmarks such as GSM8K and ARC show that this framework not only explains observed behaviors but also predicts failure modes, offering a path toward safer and more reliable LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Li},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Enhancing retrieval-augmented generation: a study of best practices},
 url = {https://arxiv.org/abs/2501.07391},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:16:24Z},
 year = {2025}
}

@article{li_f2a2_2023,
 abstract = {Obesity is a major risk factor for type 2 diabetes, cardiovascular disease, and certain cancers. The prevalence of obesity has increased dramatically over the past few decades, and this trend shows no signs of abating. Although genetic factors play a role in determining susceptibility to obesity, the recent increase in obesity prevalence is likely due to environmental factors, particularly increased caloric intake and decreased physical activity. The regulation of body weight is complex and involves multiple organ systems, including the brain, gastrointestinal tract, adipose tissue, and endocrine pancreas. Leptin, a hormone secreted by adipocytes, plays a key role in regulating energy balance by signaling the brain about the status of energy stores. Leptin deficiency or resistance leads to increased food intake and decreased energy expenditure, resulting in obesity. Other hormones, including insulin, ghrelin, peptide YY, and glucagon-like peptide-1, also contribute to the regulation of appetite and energy balance. Understanding the mechanisms that regulate body weight may lead to new therapeutic approaches for the treatment of obesity.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 author = {Li},
 issn = {1532-4435},
 journal = {J. Mach. Learn. Res.},
 keywords = {actor-critic},
 month = {jan},
 note = {Publisher: JMLR.org},
 number = {1},
 title = {{F2A2}},
 volume = {24},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:29:07Z},
 year = {2023}
}

@inproceedings{li_g-refer_2025,
 abstract = {Bats use echolocation to navigate and perceive their environment in complete darkness. Inspired by this, we propose EchoTrace, a novel approach to reconstruct 3D object shapes from audio signals generated by a commodity speaker and microphone. Our method simulates echolocation by emitting ultrasonic chirps and capturing their echoes off objects, then processes the audio data to infer 3D geometry. We develop a deep learning model that takes as input the time-domain audio signals and outputs a 3D point cloud representation of the scanned object. To train our model, we collect a large-scale dataset of audio recordings paired with 3D scans of everyday objects in varied indoor environments. Our approach achieves high-fidelity 3D reconstructions, enabling applications such as audio-based 3D scanning for accessibility, robotics, and augmented reality. We evaluate EchoTrace on real-world scenarios, demonstrating its robustness to noise, occlusions, and diverse object types.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Li},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3696410.3714727},
