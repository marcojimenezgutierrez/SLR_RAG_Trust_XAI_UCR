@inproceedings{alam_memento_2024,
 abstract = {Graph neural networks (GNNs) have achieved remarkable success in various real-world tasks. However, existing GNNs suffer from poor generalization to out-of-distribution (OOD) graphs and vulnerability to adversarial attacks. To address these issues, we propose a novel graph mixup framework, GraphMix, which generates mixed graphs by combining pairs of input graphs and their labels. Specifically, we design a graph mixup strategy that interpolates the graph structures and node features in a learnable manner. By training on these mixed graphs, our model learns more robust and generalizable representations. Extensive experiments on node classification, graph classification, and adversarial robustness tasks demonstrate the effectiveness of our approach.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
