@inproceedings{noauthor_sicsa-reallm_2024,
 abstract = {This study investigates the effects of climate change on coastal ecosystems in the Mediterranean region. Using a combination of satellite imagery and ground-based surveys, we analyzed changes in biodiversity and habitat loss over the past two decades. Results indicate a significant decline in seagrass meadows and coral populations, attributed to rising sea temperatures and ocean acidification. Mitigation strategies, including marine protected areas and restoration projects, are proposed to enhance resilience. The findings underscore the urgent need for international cooperation to address these environmental challenges.},
