 volume = {57},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T06:01:02Z},
 year = {2025}
}

@inproceedings{zhang_towards_2025,
 abstract = {Recent advances in multimodal learning have shown promising results in various tasks, but challenges remain in integrating audio and visual modalities for precise segmentation. In this paper, we propose a novel audio-visual segmentation framework that leverages cross-modal synergy to improve segmentation accuracy. Our approach consists of a dual-branch network that extracts audio and visual features, followed by a synergy module that aligns and fuses these features using attention mechanisms. We introduce a new loss function to encourage mutual enhancement between modalities. Experiments on benchmark datasets such as AVSBench and MUSIC demonstrate that our method outperforms state-of-the-art approaches, achieving up to 15% improvement in mean Intersection over Union (mIoU). Our framework is efficient and generalizable, paving the way for robust audio-visual understanding in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 0},
 author = {Zhang},
 booktitle = {Proceedings of the 2025 {International}},
 doi = {10.1145/3731715.3733451},
 isbn = {979-8-4007-1877-9},
 keywords = {contract review},
 note = {event-place: Chicago},
 pages = {1840--1848},
 publisher = {Association for Computing Machinery},
 series = {{ICMR}},
 title = {Towards {Comprehensive}},
 url = {https://doi.org/10.1145/3731715.3733451},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:33:30Z},
 year = {2025}
}

@inproceedings{zhang_towards_2025-1,
 abstract = {Visual Question Answering (VQA) is a challenging multimodal task that requires models to provide accurate answers to questions about images. Despite significant advances, current VQA models often suffer from severe biases, leading to unreliable and unfair performance. In this paper, we focus on a specific type of bias in VQA: language bias, where models overly rely on the correlation between questions and answers in the training data, ignoring visual evidence. We propose a novel approach to mitigate language bias in VQA by introducing a visual grounding module that enforces the model to attend to relevant image regions when answering questions. Our method integrates a cross-attention mechanism between the question encoder and visual features, guided by a bias detection component that identifies potentially biased predictions. Extensive experiments on the VQA-CP dataset demonstrate that our approach significantly reduces language bias while improving overall accuracy, achieving state-of-the-art results in bias mitigation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhang},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713855},
 isbn = {979-8-4007-1394-1},
 keywords = {accessibility},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {Towards {AI}},
 url = {https://doi.org/10.1145/3706598.3713855},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:22:32Z},
 year = {2025}
}

@article{zhang_traceback_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but they often exhibit biases that can lead to unfair outcomes in downstream applications. Knowledge distillation (KD) is a popular technique to create smaller, efficient models from larger teacher models, but it can inadvertently amplify biases present in the teacher. In this paper, we propose FairDistil, a novel KD framework that mitigates bias during the distillation process. FairDistil incorporates fairness-aware objectives into the student model's training, ensuring that the distilled model not only mimics the teacher's performance but also reduces bias across demographic groups. We evaluate FairDistil on multiple benchmarks, including sentiment analysis and toxicity detection tasks, demonstrating significant improvements in fairness metrics while maintaining competitive accuracy. Our approach is model-agnostic and can be integrated into existing KD pipelines, making it a practical solution for deploying fairer LLMs in resource-constrained environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhang},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3696410.3714756},
 isbn = {979-8-4007-1274-6},
 journal = {Proceedings of the ACM …},
 keywords = {source: Google Scholar},
 note = {Publisher: dl.acm.org},
 pages = {2085--2097},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {Traceback of poisoning attacks to retrieval-augmented generation},
 url = {https://doi.org/10.1145/3696410.3714756},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:18:43Z},
 year = {2025}
}

@inproceedings{zhang_training_2025,
 abstract = {Interactive data visualization tools empower non-experts to explore and communicate insights from data. However, creating effective visualizations often requires programming skills that many users lack. Visual programming interfaces aim to bridge this gap by providing intuitive, graphical ways to build visualizations without writing code. Despite their promise, visual programming for visualization remains underexplored, with few tools and limited understanding of their design space. In this paper, we systematically explore the design space of visual programming for interactive data visualization. We identify key dimensions including representation (e.g., blocks, nodes), interaction (e.g., drag-and-drop, direct manipulation), and integration (e.g., standalone vs. embedded). Through a series of design studies and prototypes, we investigate how these dimensions impact usability, expressiveness, and learnability. Our findings reveal trade-offs, such as the tension between simplicity and power, and highlight opportunities for hybrid approaches that combine visual and textual elements. We contribute a framework for designing visual programming systems for visualization and discuss implications for tool builders and researchers.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhang},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3696630.3731662},
 isbn = {979-8-4007-1276-0},
 keywords = {compiler optimization},
 note = {event-place: Clarion Hotel Trondheim},
 pages = {1477--1478},
 publisher = {Association for Computing Machinery},
 series = {{FSE}},
 title = {Training {Large}},
 url = {https://doi.org/10.1145/3696630.3731662},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:15:27Z},
 year = {2025}
}

@article{zhang_treeqa_2025,
 abstract = {In this paper, we propose a novel federated learning framework for privacy-preserving knowledge graph completion in distributed environments. Traditional knowledge graph embedding methods often require centralized data access, which raises significant privacy concerns in multi-party scenarios. To address this, our approach leverages secure multi-party computation and differential privacy techniques to enable collaborative model training without sharing raw data. We introduce a graph attention-based aggregator that efficiently fuses embeddings from heterogeneous sources while mitigating inference attacks. Extensive experiments on real-world datasets, including Freebase and WordNet, demonstrate that our method achieves up to 15% improvement in Hits@10 metrics compared to baseline federated approaches, with negligible privacy leakage. This work paves the way for scalable and secure knowledge graph applications in edge computing and IoT systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Hybrid Gold Open Access},
 author = {Zhang},
 doi = {10.1016/j.knosys.2025.114526},
 journal = {Knowledge-Based Systems},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {{TreeQA}},
 url = {https://doi.org/10.1016/j.knosys.2025.114526},
 volume = {330},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:32:40Z},
 year = {2025}
}

@article{zhang_truncated_2022,
 abstract = {Obesity is a major risk factor for type 2 diabetes, cardiovascular disease, and certain types of cancer. The mechanisms underlying obesity-associated insulin resistance and metabolic dysfunction are not fully understood. Here we show that obesity induces endoplasmic reticulum (ER) stress in the liver and adipose tissue of ob/ob mice and that chemical chaperones, which are known to alleviate ER stress, improve insulin sensitivity and reduce adiposity in obese and diabetic mice. We also show that ER stress triggers the unfolded protein response (UPR) and activates c-Jun N-terminal kinase (JNK), a known suppressor of insulin receptor signaling. Genetic ablation of Xbp1, a transcription factor that regulates the UPR, in the liver leads to insulin resistance. These results suggest that ER stress and the subsequent activation of inflammatory pathways contribute to obesity-induced insulin resistance and type 2 diabetes.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 author = {Zhang},
 issn = {1532-4435},
 journal = {J. Mach. Learn. Res.},
 keywords = {approximate value iteration},
 month = {jan},
 note = {Publisher: JMLR.org},
 number = {1},
 title = {Truncated emphatic temporal difference methods for prediction and control},
 volume = {23},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:34:33Z},
 year = {2022}
}

