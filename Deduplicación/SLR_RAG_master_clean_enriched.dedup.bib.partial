 x_enrich_ts = {2025-11-02T06:47:48Z},
 year = {2025}
}

@inproceedings{liu_efficient_2025,
 abstract = {This paper introduces a novel framework for enhancing user privacy in federated learning systems by integrating differential privacy mechanisms with secure multi-party computation. We address the challenges of balancing model utility and privacy guarantees in heterogeneous data environments. Through extensive experiments on benchmark datasets, our approach demonstrates superior performance in terms of accuracy preservation while achieving strong privacy bounds, outperforming existing baselines by up to 15%. The framework is designed to be scalable and adaptable to real-world deployment scenarios in edge computing.},
