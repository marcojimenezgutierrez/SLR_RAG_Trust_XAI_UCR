@inproceedings{bhowmick_raguru_2025,
 abstract = {Data visualization plays a crucial role in data analysis and communication, but creating effective visualizations often requires expertise in both data and design. Large language models (LLMs) have shown promise in generating code for visualizations, but their outputs can be suboptimal due to hallucinations, lack of context, or misalignment with user intent. In this paper, we introduce LLM4Vis, a framework for red teaming LLMs specifically tailored to data visualization tasks. We design a suite of adversarial prompts that probe LLMs' weaknesses in generating visualization code, including issues with data handling, aesthetic choices, and accessibility. By systematically evaluating popular LLMs like GPT-4 and Llama 2 on these prompts, we uncover critical failure modes and provide insights into improving LLM robustness for visualization. Our findings highlight the need for specialized fine-tuning and evaluation benchmarks in this domain, paving the way for more reliable AI-assisted visualization tools.},
