 series = {{CHI}},
 title = {Generative and {Malleable}},
 url = {https://doi.org/10.1145/3706598.3713285},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:27:58Z},
 year = {2025}
}

@inproceedings{cao_javabench_2024,
 abstract = {Visual Question Answering (VQA) has achieved remarkable progress with the advent of large vision-language models (LVLMs). However, the inherent biases in these models, stemming from imbalanced training data, often lead to unfair and unreliable answers, particularly for underrepresented groups. Existing debiasing methods for VQA primarily focus on post-hoc interventions, which are suboptimal for mitigating biases in LVLMs. In this paper, we propose a simple yet effective training-free debiasing framework, named FairVQA, to promote fairness in LVLMs for VQA. Specifically, we first introduce a fairness-oriented prompting strategy that leverages chain-of-thought reasoning to guide the model in generating unbiased answers. Then, we design a counterfactual answer generation module to produce diverse and fair alternative answers, which are used to calibrate the confidence scores of the original answers. Extensive experiments on the VQA-v2 and VQA-CP datasets demonstrate that our FairVQA significantly reduces gender and racial biases while maintaining competitive performance on the original VQA task.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Cao},
 booktitle = {Proceedings of the 39th {IEEE}},
 doi = {10.1145/3691620.3695470},
