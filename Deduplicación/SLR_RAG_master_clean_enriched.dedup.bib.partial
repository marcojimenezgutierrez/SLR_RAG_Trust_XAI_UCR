@article{singh_advanced_2025,
 abstract = {In this paper, we introduce a novel approach to training generalist robot policies using transfer learning from large vision-language models (VLMs). Traditional robot learning methods often require extensive task-specific data and fine-tuning, limiting their scalability and generalization. Our method, termed RoboTransfer, leverages the rich semantic understanding of VLMs to initialize robot policies, enabling zero-shot adaptation to new manipulation tasks. We demonstrate that by distilling VLM knowledge into a transformer-based policy network, robots can perform complex, long-horizon tasks in unseen environments with minimal additional training. Experiments on the RT-1 and Bridge datasets show significant improvements in success rates, outperforming baselines by up to 40%. Our approach paves the way for more versatile and efficient robot learning systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Singh},
 journal = {arXiv preprint arXiv:2501.15290},
 keywords = {source: Google Scholar},
