 year = {2025}
}

@inproceedings{ding_enhancing_2024,
 abstract = {Machine learning (ML) models are increasingly used in safety-critical applications, such as autonomous vehicles and medical diagnosis, where their robustness against adversarial attacks is crucial. However, recent studies have shown that even state-of-the-art models can be easily fooled by imperceptible perturbations. In this paper, we systematically study the robustness of deep neural networks (DNNs) against adversarial examples in the context of Android malware detection. We first evaluate the vulnerability of popular ML-based malware detectors using a large dataset of Android apps. Our results reveal that these models are highly susceptible to adversarial attacks, with attack success rates exceeding 90% in many cases. To mitigate this, we propose a novel defense mechanism called RobustDroid, which combines adversarial training with feature distillation to enhance model robustness without significantly sacrificing accuracy. Extensive experiments demonstrate that RobustDroid achieves up to 70% reduction in attack success rates while maintaining comparable detection performance to undefended models. Our work highlights the need for robust ML in mobile security and provides a practical solution for deploying reliable malware detection systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
