 publisher = {Association for Computing Machinery},
 series = {{ICAIF}},
 title = {Customized {FinGPT}},
 url = {https://doi.org/10.1145/3677052.3698637},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:00:04Z},
 year = {2024}
}

@inproceedings{tian_respark_2025,
 abstract = {Recent advancements in large language models (LLMs) have enabled the development of sophisticated AI systems capable of generating human-like text. However, ensuring the safety and alignment of these models with human values remains a critical challenge. This paper introduces a novel framework for evaluating and improving the robustness of LLMs against adversarial prompts designed to elicit harmful or biased outputs. We propose a multi-stage training pipeline that incorporates red-teaming techniques, where diverse adversarial examples are generated to probe model vulnerabilities. Through extensive experiments on benchmark datasets, we demonstrate that our approach significantly reduces the incidence of unsafe responses by up to 40% while maintaining performance on standard tasks. Our findings highlight the importance of iterative safety tuning and provide actionable insights for deploying more reliable AI systems in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
