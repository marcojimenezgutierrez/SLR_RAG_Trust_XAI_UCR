 keywords = {cyber-physical systems},
 note = {event-place: Linz},
 pages = {578--586},
 publisher = {Association for Computing Machinery},
 series = {{MODELS}},
 title = {A {Human}},
 url = {https://doi.org/10.1145/3652620.3687806},
 x_enrich_source = {x-ai/grok-4-fast},
