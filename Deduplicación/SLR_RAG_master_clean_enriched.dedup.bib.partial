 year = {2024}
}

@article{chu_patent_2024,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has led to their widespread adoption across various sectors, including healthcare, finance, and transportation. This paper explores the ethical implications of AI deployment, focusing on issues such as bias in algorithms, privacy concerns, and accountability in decision-making processes. Through a comprehensive review of existing literature and case studies, we identify key challenges and propose a framework for ethical AI governance that emphasizes transparency, fairness, and human oversight. Our findings suggest that while AI offers significant benefits, unchecked implementation could exacerbate societal inequalities, underscoring the need for interdisciplinary collaboration to ensure responsible innovation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
