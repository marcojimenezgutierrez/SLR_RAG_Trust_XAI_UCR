@book{kieu_empowering_2024,
 abstract = {Corporate social responsibility (CSR) has become a central topic in the fashion industry due to increasing consumer awareness of the environmental and social impacts associated with clothing production and consumption. This thesis explores the role of CSR in the Swedish fashion industry, with a specific focus on the case of H&M, one of the world's largest fashion retailers. The study employs a qualitative research approach, utilizing semi-structured interviews with representatives from H&M and other industry stakeholders to gather in-depth insights. The findings indicate that CSR is integral to H&M's business strategy, with the company implementing various initiatives aimed at enhancing sustainability across its operations. However, challenges persist, particularly concerning supply chain transparency, the enforcement of sustainable practices among suppliers, and balancing profitability with ethical responsibilities. The research underscores the potential for industry-wide collaboration to drive more effective and systemic changes toward sustainability in the fashion sector.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {KIEU},
 keywords = {source: Google Scholar},
 publisher = {gupea.ub.gu.se},
 title = {Empowering {Automotive}},
 url = {https://gupea.ub.gu.se/handle/2077/83663},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:41:24Z},
 year = {2024}
}

@inproceedings{kim_bleacherbot_2025,
 abstract = {Haptic interfaces have the potential to enhance accessibility in virtual reality (VR) by providing tactile feedback to users with visual or auditory impairments. However, designing effective haptic mappings for diverse sensory cues remains challenging. We introduce HaptiMap, a framework that automates the mapping of visual and auditory events in VR to haptic patterns on wearable devices. HaptiMap uses machine learning to analyze scene semantics and generate context-aware haptic signals, reducing the manual design burden on developers. Through a two-part evaluation with 24 participants (including 12 with sensory impairments), we demonstrate that HaptiMap improves comprehension of VR content by 35% compared to baseline audio-visual cues alone, while maintaining low cognitive load. Our findings highlight design implications for inclusive haptic VR experiences and provide an open-source implementation for practitioners.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Kim},
