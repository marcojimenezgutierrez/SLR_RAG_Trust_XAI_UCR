@article{liang_saferag_2025,
 abstract = {We introduce Grok-1.5V, the first multimodal model from xAI. At 314 billion parameters, Grok-1.5V excels in real-world spatial understanding, outperforming previous frontier models in tasks such as RealWorldQA, which evaluates spatial understanding on real-world images. Grok-1.5V also achieves strong performance on standard multimodal benchmarks like MMMU and MathVista. Our model demonstrates capabilities in interpreting and answering questions about a wide range of visual content, from photographs and diagrams to charts and screenshots.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
