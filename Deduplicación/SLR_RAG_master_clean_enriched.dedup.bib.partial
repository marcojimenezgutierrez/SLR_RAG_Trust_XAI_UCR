@article{bergman_leveraging_2025,
 abstract = {Large language models (LLMs) are increasingly used to generate code, but how professional software engineers actually use LLMs for coding remains underexplored. We conducted a formative study with 32 professional software engineers to understand their current practices when using LLMs for coding tasks. Our findings reveal that engineers use LLMs in an interactive and iterative manner, often refining prompts and inspecting generated code. We identify three key strategies: prompt engineering, code inspection, and iterative refinement. Engineers also face challenges such as hallucinations, context limitations, and integration issues. Based on these findings, we propose design implications for LLM-based coding assistants to better support professional workflows.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
