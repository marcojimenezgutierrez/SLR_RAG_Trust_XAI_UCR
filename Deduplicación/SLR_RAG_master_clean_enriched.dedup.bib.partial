@article{varma_data_2025,
 abstract = {This paper proposes a novel federated learning framework integrated with differential privacy for secure IoT data analytics. Traditional centralized machine learning approaches face significant privacy risks when handling sensitive IoT data. To address this, we introduce a differentially private federated learning model that enables collaborative training across distributed IoT devices without sharing raw data. Our approach incorporates noise addition via Gaussian mechanisms to ensure privacy guarantees while maintaining model utility. We evaluate the framework on benchmark IoT datasets, demonstrating improved accuracy and privacy preservation compared to existing methods. Experimental results show that our model achieves up to 15% higher accuracy under stringent privacy budgets (ε=1.0).},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
