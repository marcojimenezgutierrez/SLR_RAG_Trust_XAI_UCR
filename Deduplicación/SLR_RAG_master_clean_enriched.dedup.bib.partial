 title = {{TRIAGEAGENT}},
 url = {https://doi.org/10.18653/v1/2024.findings-emnlp.329},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:06:34Z},
 year = {2024}
}

@inproceedings{lubos_llm-generated_2024,
 abstract = {Recommendation systems have been widely deployed in various online platforms, which provide users with personalized suggestions and significantly improve user experience. However, recent studies have shown that recommendation systems can amplify the biases existing in the training data, resulting in unfair recommendations for certain user groups. In this paper, we conduct a comprehensive survey on fairness in recommendation systems. We first provide a clear definition of fairness in recommendation and categorize fairness notions into three classes: individual fairness, group fairness, and counterfactual fairness. Then, we review the existing fairness-aware recommendation methods from the perspectives of data, model, and post-processing. Specifically, we discuss the main challenges of existing methods and point out several promising research directions for future work.},
