 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:18:53Z},
 year = {2025}
}

@inproceedings{paria_navigating_2024,
 abstract = {Data Comics for Professional Data Analysis: A Case Study on Visual Storytelling in Data Science. Data comics are a promising medium for communicating data stories, but their use in professional data analysis remains underexplored. We conducted a case study with data scientists at a large technology company to understand how data comics could support their work. Through interviews and workshops, we identified key challenges in data analysis communication and explored how data comics could address them. Our findings reveal that data comics can enhance collaboration, facilitate knowledge sharing, and improve decision-making by providing a structured yet flexible format for presenting complex data narratives. We discuss design implications for creating effective data comics in professional settings and outline future research directions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
