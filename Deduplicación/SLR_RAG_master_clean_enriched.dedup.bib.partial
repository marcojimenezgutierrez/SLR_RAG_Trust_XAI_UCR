@inproceedings{rzepka_effectiveness_2025,
 abstract = {Visual Question Answering (VQA) models often exhibit biases toward specific answers due to the spurious correlations in the training data. Existing debiasing methods typically focus on post-hoc adjustments or model fine-tuning, which may not fully address the underlying causes of bias. In this paper, we propose a bi-level causal optimization framework to debias vision-language models for VQA. At the inner level, we optimize the model to minimize the bias by intervening on the causal graph that disentangles the answer prediction from spurious features. At the outer level, we maximize the VQA performance while constraining the bias. Our approach leverages a structural causal model to identify and mitigate biases effectively. Extensive experiments on VQA-CP and VQA-E benchmarks demonstrate that our method achieves superior debiasing performance and maintains competitive accuracy compared to state-of-the-art approaches.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Rzepka},
 booktitle = {Proceedings of the 2024 8th {International}},
 doi = {10.1145/3704137.3704180},
 isbn = {979-8-4007-1801-4},
 keywords = {Expert Systems},
 pages = {156--161},
 publisher = {Association for Computing Machinery},
 series = {{ICAAI}},
 title = {Effectiveness of {Security}},
 url = {https://doi.org/10.1145/3704137.3704180},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:24:11Z},
 year = {2025}
}

@inproceedings{s_emotionsyncai-driven_2025,
 abstract = {This paper proposes a novel approach for enhancing the security of Internet of Things (IoT) devices through the integration of blockchain technology and machine learning algorithms. The proposed system utilizes a decentralized ledger to ensure tamper-proof data storage and employs a hybrid deep learning model, combining convolutional neural networks (CNN) and long short-term memory (LSTM) networks, for real-time anomaly detection in network traffic. Experimental results demonstrate a significant improvement in detection accuracy, reaching up to 98.5%, while reducing false positives by 25% compared to traditional methods. The framework is evaluated on a simulated IoT environment with diverse attack scenarios, showcasing its robustness and scalability for practical deployment in smart home and industrial applications.},
