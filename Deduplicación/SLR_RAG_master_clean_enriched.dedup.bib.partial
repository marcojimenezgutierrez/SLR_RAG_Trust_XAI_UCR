 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:12:57Z},
 year = {2025}
}

@inproceedings{liu_personaflow_2025,
 abstract = {Haptic wearables have the potential to enhance user experiences across various applications, from gaming to rehabilitation. However, their design often overlooks the diverse needs of users with physical disabilities, particularly upper-limb amputees who may use prosthetic devices. This paper investigates the requirements for inclusive haptic wearables through a qualitative study with 12 upper-limb amputees. Using semi-structured interviews and iterative prototype evaluations, we explored challenges related to comfort, customization, integration with existing prosthetics, and sensory feedback efficacy. Participants highlighted the need for modular designs that accommodate residual limb variations and phantom limb sensations. Our findings reveal key design considerations, including adaptive pressure mapping and biofeedback integration, to ensure accessibility. We contribute a set of guidelines for developing haptic wearables that prioritize inclusivity and discuss implications for broader assistive technology design.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Liu},
 booktitle = {Proceedings of the 2025 {ACM}},
 doi = {10.1145/3715336.3735789},
