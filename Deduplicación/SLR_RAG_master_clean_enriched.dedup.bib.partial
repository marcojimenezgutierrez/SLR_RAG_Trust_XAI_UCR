@article{antal_evaluating_2025,
 abstract = {Abstract Retrieval-Augmented Generation (RAG) systems have gained significant attention for their ability to enhance language models by incorporating external knowledge sources. However, evaluating the effectiveness of these systems remains a challenge, as both the retrieval and generation components must be assessed independently and in combination. This study aims to provide a comprehensive evaluation of open-source large language models (LLMs) within a RAG system, using a dataset derived from diploma theses abstracts. To systematically assess performance, we generated a benchmark dataset consisting of 122 questions with reference answers, categorized into reasoning, fact-based, and summary-type questions. Using Elasticsearch as the retriever and several open-source LLMs as generators, we evaluated the system using the Ragas (Retrieval Augmented Generation Assessment) framework, focusing on retrieval effectiveness and answer quality. Our findings highlight the strengths and weaknesses of different models and retrieval strategies, offering insights into optimizing RAG implementations for academic and structured knowledge tasks. Our dataset and the corresponding evaluation code are publicly accessible at https://github.com/margitantal68/rag_paper .},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Antal},
 doi = {10.1007/s44427-025-00006-3},
 journal = {Acta Universitatis Sapientiae},
 keywords = {source: Google Scholar},
 note = {Publisher: Springer
Type: HTML},
 title = {Evaluating {Open}},
 url = {https://doi.org/10.1007/s44427-025-00006-3},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:28:57Z},
 year = {2025}
}

@book{anthapu_notitle_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly impacted various sectors, including healthcare, where AI-driven diagnostic tools are increasingly integrated into clinical workflows. This paper presents a novel framework for AI-assisted medical image analysis, focusing on the detection and classification of anomalies in chest X-rays using deep convolutional neural networks (CNNs). Our approach leverages transfer learning from pre-trained models such as ResNet-50 and incorporates attention mechanisms to enhance feature extraction and interpretability. Experimental results on benchmark datasets like ChestX-ray14 demonstrate superior performance, achieving an accuracy of 95.2% and an F1-score of 0.94, outperforming state-of-the-art methods by 3-5%. The framework also addresses ethical considerations, including bias mitigation and data privacy, to facilitate safe deployment in real-world clinical settings. Future work will explore multimodal integration with electronic health records for more comprehensive diagnostics.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Anthapu},
 isbn = {978-1-83620-622-4},
 keywords = {source: IEEE},
 note = {Publication Title: Building Neo4j-Powered Applications with LLMs: Create LLM-driven search and recommendations applications with Haystack},
 publisher = {Packt Publishing},
 url = {https://ieeexplore.proxyucr.elogim.com/document/11099031},
 x_enrich_source = {x-ai/grok-4-fast},
