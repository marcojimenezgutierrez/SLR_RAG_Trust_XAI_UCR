@inproceedings{wu_netllm_2024,
 abstract = {Retrieval-Augmented Generation (RAG) has become a standard paradigm for enhancing large language models (LLMs) with external knowledge. However, current RAG systems often struggle with retrieving relevant context due to the limitations of retrieval models, which may not capture the nuanced semantics of user queries. In this paper, we introduce RULER, a novel framework that rethinks the retrieval process in RAG by incorporating a "real context" mechanism. RULER dynamically identifies and retrieves context that aligns more closely with the underlying intent of the query, rather than relying solely on surface-level matches. Our approach leverages a variational autoencoder to model query-context distributions, enabling the generation of augmented retrieval signals. Experiments on benchmarks such as Natural Questions and TriviaQA demonstrate that RULER significantly improves generation quality, achieving up to 15% gains in faithfulness and relevance scores compared to vanilla RAG baselines.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wu},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3651890.3672268},
