@inproceedings{s_graph_2025,
 abstract = {This paper proposes a novel framework for enhancing cybersecurity in IoT ecosystems through machine learning-based anomaly detection. We introduce a hybrid model combining convolutional neural networks (CNNs) and long short-term memory (LSTM) networks to identify and mitigate potential threats in real-time. The approach is evaluated on benchmark datasets, demonstrating superior accuracy and reduced false positives compared to traditional methods. Experimental results show an improvement of up to 15% in detection rates, highlighting the framework's efficacy for sustainable and secure IoT deployments.},
