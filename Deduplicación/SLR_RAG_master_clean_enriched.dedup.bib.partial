@article{aksoy_architecting_2024,
 abstract = {This study introduces a novel fractional-order chaotic respiratory disease model, integrating Caputo fractional derivatives to capture memory effects in disease dynamics. The model exhibits complex chaotic behaviors, analyzed through bifurcation diagrams, Lyapunov exponents, and phase portraits. To enhance interpretability, explainable artificial intelligence (XAI) techniques, including SHAP and LIME, are employed to demystify the black-box nature of neural network predictions for disease trajectories. Numerical simulations using the Adams-Bashforth-Moulton method validate the model's efficacy, revealing sensitive parameters influencing chaos onset. The integration of XAI provides transparent insights into model predictions, aiding clinical decision-making and epidemic forecasting. This interdisciplinary approach bridges fractional calculus, chaos theory, and AI, offering a robust framework for understanding and controlling respiratory disease spread.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Aksoy},
 journal = {ICAMƩ'24},
 keywords = {source: Google Scholar},
