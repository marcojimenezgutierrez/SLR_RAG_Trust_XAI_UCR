}

@inproceedings{sarmah_towards_2024,
 abstract = {Digital contact tracing (DCT) apps have been proposed as a way to control the spread of COVID-19 while minimizing economic and social disruption. However, adoption has been low in many countries. We conducted a mixed-methods study to understand the barriers to adoption of the Norwegian Smittestopp app. We surveyed 1,000 Norwegians and interviewed 20 of them. We found that privacy concerns were the main barrier, but also that many users did not see the personal benefit. We propose design implications to increase adoption.},
