@inproceedings{pratap_harnessing_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly impacted various sectors, including education. This paper explores the integration of AI-driven tools in higher education curricula, focusing on their potential to enhance personalized learning experiences. Through a comprehensive review of existing literature and case studies from leading universities, we examine the benefits, challenges, and ethical considerations associated with AI adoption. Our findings indicate that while AI can improve student engagement and outcomes, issues such as data privacy, algorithmic bias, and the digital divide must be addressed to ensure equitable access. We propose a framework for sustainable AI integration that emphasizes interdisciplinary collaboration and continuous evaluation. This study contributes to the ongoing discourse on technology-enhanced education, offering practical insights for educators and policymakers.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
