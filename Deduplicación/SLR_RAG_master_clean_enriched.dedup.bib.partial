 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:19:56Z},
 year = {2024}
}

@inproceedings{pang_understanding_2025,
 abstract = {Recent advancements in large language models (LLMs) have shown promise in generating human-like text, but their application in retrieval-augmented generation (RAG) systems remains underexplored, particularly in terms of reranking retrieved documents. This paper evaluates the utility of LLM-based reranking in RAG pipelines. We conduct experiments across diverse datasets and tasks, comparing LLM rerankers to traditional methods like BM25 and cross-encoders. Our findings reveal that while LLMs can improve relevance scoring in certain scenarios, they often introduce inefficiencies and biases, leading to mixed performance gains. We discuss implications for practical RAG deployment and suggest hybrid approaches for optimal results.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Pang},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713726},
