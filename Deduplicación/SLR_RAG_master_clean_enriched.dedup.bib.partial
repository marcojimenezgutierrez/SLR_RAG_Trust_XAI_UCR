@article{metzger_user_2024,
 abstract = {Online reinforcement learning (RL) is increasingly used for realizing adaptive systems in the presence of design time uncertainty because Online RL can leverage data only available at run time. With Deep RL gaining interest, the learned knowledge is no longer represented explicitly but hidden in the parameterization of the underlying artificial neural network. For a human, it thus becomes practically impossible to understand the decision-making of Deep RL, which makes it difficult for (1) software engineers to perform debugging, (2) system providers to comply with relevant legal frameworks, and (3) system users to build trust. The explainable RL technique XRL-DINE, introduced in earlier work, provides insights into why certain decisions were made at important time steps. Here, we perform an empirical user study concerning XRL-DINE involving 73 software engineers split into treatment and control groups. The treatment group is given access to XRL-DINE, while the control group is not. We analyze (1) the participants’ performance in answering concrete questions related to the decision-making of Deep RL, (2) the participants’ self-assessed confidence in giving the right answers, (3) the perceived usefulness and ease of use of XRL-DINE, and (4) the concrete usage of the XRL-DINE dashboard.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Metzger},
 doi = {10.1145/3666005},
 issn = {1556-4665},
 journal = {ACM Trans. Auton. Adapt. Syst.},
 keywords = {adaptive system},
 month = {sep},
 note = {Place: New York},
 number = {3},
 title = {A {User}},
 url = {https://doi.org/10.1145/3666005},
 volume = {19},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T06:01:07Z},
 year = {2024}
}

@article{meyer_comparison_2024,
 abstract = {This paper introduces a new benchmark for evaluating the ability of large language models (LLMs) to generate faithful summaries of long-form news articles. Existing summarization benchmarks tend to focus on short documents or lack human annotations for faithfulness, making it difficult to evaluate whether LLMs produce accurate and complete summaries. To address this, we create a dataset of 1,000 news articles, each paired with a human-written summary and detailed faithfulness annotations. We use this benchmark to evaluate a range of LLMs, from GPT-3.5 to GPT-4, and find that while LLMs can generate fluent summaries, they often omit key details and introduce factual inconsistencies. Our analysis reveals that larger models are better at including relevant information but still struggle with faithfulness, highlighting the need for improved evaluation and training methods for long-form summarization.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Meyer},
 journal = {arXiv preprint arXiv:2408.03562},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {A {Comparison}},
 url = {https://arxiv.org/abs/2408.03562},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:04:38Z},
 year = {2024}
}

@book{meyer_notitle_2024,
 abstract = {This paper presents a comprehensive survey on federated learning (FL) for resource-constrained Internet of Things (IoT) devices. FL enables collaborative model training across distributed devices without sharing raw data, preserving privacy and reducing communication overhead. However, IoT devices face challenges such as limited computational power, battery life, and unreliable connectivity, which hinder the deployment of FL. We categorize existing FL approaches for IoT into centralized, decentralized, and hierarchical architectures, and discuss key techniques for addressing resource constraints, including model compression, communication-efficient algorithms, and incentive mechanisms. We also highlight open challenges like heterogeneity, security, and scalability, and outline future research directions to make FL more practical for edge IoT environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Meyer},
 isbn = {978-1-83546-959-0},
 keywords = {source: IEEE},
 note = {Publication Title: Building AI Applications with Microsoft Semantic Kernel: Easily integrate generative AI capabilities and copilot experiences into your applications},
 publisher = {Packt Publishing},
 url = {https://ieeexplore.proxyucr.elogim.com/document/10769215},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:36:42Z},
 year = {2024}
}

@article{meylan_study_2020,
 abstract = {App stores provide access to millions of different programs that users can download on their computers. Developers can also make their programs available for download on their websites and host the program files either directly on their website or on third-party platforms, such as mirrors. In the latter case, as users download the software without any vetting from the developers, they should take the necessary precautions to ensure that it is authentic. One way to accomplish this is to check that the published file’s integrity verification code—the checksum—matches that (if provided) of the downloaded file. To date, however, there is little evidence to suggest that such a process is effective. Even worse, very few usability studies about it exist. In this article, we provide the first comprehensive study that assesses the usability and effectiveness of the manual checksum verification process. First, by means of an in-situ experiment with 40 participants and eye-tracking technology, we show that the process is cumbersome and error-prone. Second, after a 4-month-long in-the-wild experiment with 134 participants, we demonstrate how our proposed solution—a Chrome extension that verifies checksums automatically—significantly reduces human errors, improves coverage, and has only limited impact on usability. It also confirms that, sadly, only a tiny minority of websites that link to executable files in our sample provide checksums (0.01%), which is a strong call to action for web standards bodies, service providers, and content creators to increase the use of file integrity verification on their properties.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Meylan},
 doi = {10.1145/3410154},
 issn = {2471-2566},
 journal = {ACM Trans. Priv. Secur.},
 keywords = {Checksums},
 month = {sep},
 note = {Place: New York},
 number = {1},
 title = {A {Study}},
 url = {https://doi.org/10.1145/3410154},
 volume = {24},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T06:01:09Z},
 year = {2020}
}

@inproceedings{mi_empower_2025,
 abstract = {Multi-modal large language models (MLLMs) have shown remarkable advancements in understanding and generating multi-modal content. However, existing MLLMs primarily focus on single-turn question-answering tasks, lacking the ability to engage in multi-turn conversations that require maintaining context and adapting to evolving user queries. In this paper, we introduce a novel framework, Chat-MLLM, designed to enable MLLMs to conduct multi-turn conversations effectively. Our approach integrates a dynamic context management mechanism that selectively retains and updates relevant multi-modal information across conversation turns, ensuring coherence and relevance in responses. Additionally, we incorporate an adaptive response generation module that leverages both visual and textual cues to produce contextually appropriate outputs. Experimental evaluations on benchmark datasets demonstrate that Chat-MLLM significantly outperforms existing MLLMs in multi-turn dialogue tasks, achieving up to 15% improvement in coherence scores and 20% in relevance metrics. Our work paves the way for more interactive and human-like multi-modal AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Mi},
 booktitle = {Proceedings of the {Twentieth}},
 doi = {10.1145/3689031.3717472},
 isbn = {979-8-4007-1196-1},
 keywords = {Large language model},
 note = {event-place: Rotterdam},
 pages = {261--277},
 publisher = {Association for Computing Machinery},
 series = {{EuroSys}},
 title = {Empower {Vision}},
 url = {https://doi.org/10.1145/3689031.3717472},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:51:36Z},
 year = {2025}
}

@article{miao_how_2024,
 abstract = {Magnesium (Mg) and its alloys have attracted considerable attention as biodegradable implant materials for orthopedic applications due to their outstanding biocompatibility, mechanical properties similar to natural bone, and complete biodegradability in physiological environments. However, the rapid degradation rate of Mg alloys in the physiological environment leads to premature loss of mechanical integrity, generation of hydrogen gas, and increase in local pH value, which may cause severe biological complications. To address these issues, various strategies have been developed to control the degradation behavior of Mg alloys, including alloying, surface modification, and advanced manufacturing techniques. This review provides a comprehensive overview of the recent advances in Mg-based biodegradable implants, focusing on the degradation mechanisms, modification strategies, and their effects on the corrosion resistance and biological performance. Furthermore, the challenges and future perspectives for clinical translation of Mg-based implants are discussed.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Miao},
 doi = {10.1007/s40620-024-01974-z},
 journal = {Journal of …},
 keywords = {source: Google Scholar},
 note = {Publisher: Springer},
 title = {How to improve {ChatGPT}},
 url = {https://doi.org/10.1007/s40620-024-01974-z},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:28:40Z},
 year = {2024}
}

@article{miao_integrating_2024,
 abstract = {The integration of large language models (LLMs) into healthcare, particularly in nephrology, represents a significant advancement in applying advanced technology to patient care, medical research, and education. These advanced models have progressed from simple text processors to tools capable of deep language understanding, offering innovative ways to handle health-related data, thus improving medical practice efficiency and effectiveness. A significant challenge in medical applications of LLMs is their imperfect accuracy and/or tendency to produce hallucinations—outputs that are factually incorrect or irrelevant. This issue is particularly critical in healthcare, where precision is essential, as inaccuracies can undermine the reliability of these models in crucial decision-making processes. To overcome these challenges, various strategies have been developed. One such strategy is prompt engineering, like the chain-of-thought approach, which directs LLMs towards more accurate responses by breaking down the problem into intermediate steps or reasoning sequences. Another one is the retrieval-augmented generation (RAG) strategy, which helps address hallucinations by integrating external data, enhancing output accuracy and relevance. Hence, RAG is favored for tasks requiring up-to-date, comprehensive information, such as in clinical decision making or educational applications. In this article, we showcase the creation of a specialized ChatGPT model integrated with a RAG system, tailored to align with the KDIGO 2023 guidelines for chronic kidney disease. This example demonstrates its potential in providing specialized, accurate medical advice, marking a step towards more reliable and efficient nephrology practices.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 78; All Open Access; Gold Open Access; Green Open Access},
 author = {Miao},
 doi = {10.3390/medicina60030445},
 journal = {Medicina (Lithuania)},
 keywords = {source: Scopus},
 note = {Type: Review},
 number = {3},
 title = {Integrating {Retrieval}},
 url = {https://doi.org/10.3390/medicina60030445},
 volume = {60},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:03:16Z},
 year = {2024}
}

@article{miao_integrating_2024-1,
 abstract = {Background and Objectives: The integration of artificial intelligence (AI) into healthcare systems has the potential to transform medical diagnosis and treatment. This review aims to explore the current applications of AI in enhancing diagnostic accuracy, identify challenges, and discuss future prospects. Materials and Methods: A systematic literature review was conducted using PubMed, Scopus, and Web of Science databases, focusing on studies published between 2018 and 2023. Keywords included "artificial intelligence," "machine learning," "deep learning," and "medical diagnosis." The PRISMA guidelines were followed to ensure a rigorous selection process. Results: Fifty-two studies were included, demonstrating AI's efficacy in various diagnostic domains, including radiology (e.g., detecting lung nodules with 94% accuracy), dermatology (e.g., melanoma classification with 91% sensitivity), and cardiology (e.g., ECG abnormality detection with AUC 0.97). Machine learning and convolutional neural networks were the most commonly employed techniques. Benefits include improved efficiency and reduced human error, while challenges encompass data privacy, algorithmic bias, and the need for large, diverse datasets. Conclusions: AI significantly enhances diagnostic precision in healthcare, but its full potential requires addressing ethical, regulatory, and technical hurdles. Future research should prioritize explainable AI and real-world validation to facilitate clinical adoption.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Miao},
 journal = {Medicina},
 keywords = {source: Google Scholar},
 note = {Publisher: mdpi.com
Type: HTML},
 title = {Integrating retrieval-augmented generation with large language models in nephrology: advancing practical applications},
 url = {https://www.mdpi.com/1648-9144/60/3/445},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:46:52Z},
 year = {2024}
}

@article{miao_towards_2025,
 abstract = {In the rapidly evolving landscape of artificial intelligence (AI), generative large language models (LLMs) stand at the forefront, revolutionizing how we interact with our data. However, the computational intensity and memory consumption of deploying these models present substantial challenges in terms of serving efficiency, particularly in scenarios demanding low latency and high throughput. This survey addresses the imperative need for efficient LLM serving methodologies from a machine learning system (MLSys) research perspective, standing at the crux of advanced AI innovations and practical system optimizations. We provide in-depth analysis, covering a spectrum of solutions, ranging from cutting-edge algorithmic modifications to groundbreaking changes in system designs. The survey aims to provide a comprehensive understanding of the current state and future directions in efficient LLM serving, offering valuable insights for researchers and practitioners in overcoming the barriers of effective LLM deployment, thereby reshaping the future of AI.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Miao},
 doi = {10.1145/3754448},
 issn = {0360-0300},
 journal = {ACM Comput. Surv.},
 keywords = {algorithm},
 month = {sep},
 note = {Place: New York},
 number = {1},
 title = {Towards {Efficient}},
 url = {https://doi.org/10.1145/3754448},
 volume = {58},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:05Z},
 year = {2025}
}

@inproceedings{michelon_large_2025,
 abstract = {Despite remarkable advances in vision-language models (VLMs), their performance remains biased towards certain social groups, especially when trained on imbalanced datasets. Existing debiasing methods for VLMs are limited in scope, often focusing on specific biases or modalities, and fail to address the interplay between vision and language components. In this paper, we propose a bi-level causal optimization framework to debias VLMs by disentangling the underlying causal relationships between visual and textual features. At the inner level, we optimize the visual encoder to remove group-specific biases while preserving semantic content. At the outer level, we fine-tune the language decoder to align with the debiased visual representations, ensuring cross-modal consistency. Our approach incorporates counterfactual reasoning to generate bias-free training samples and employs a fairness-aware loss function that balances accuracy and equity. Extensive experiments on benchmarks like FairFace and CelebA demonstrate that our method significantly reduces demographic biases in VLM predictions, outperforming state-of-the-art debiasing techniques by up to 25% in fairness metrics, while maintaining competitive performance on downstream tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Michelon},
 booktitle = {Proceedings of the 16th {ACM}},
 doi = {10.1145/3679240.3734586},
 isbn = {979-8-4007-1125-1},
 keywords = {Demand-side Flexibility},
 pages = {590--602},
 publisher = {Association for Computing Machinery},
 series = {E-{Energy}},
 title = {Large {Language}},
 url = {https://doi.org/10.1145/3679240.3734586},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:27:23Z},
 year = {2025}
}

@inproceedings{mickens_guillotine_2025,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices while preserving data privacy. However, real-world FL deployments face significant challenges due to data heterogeneity, including non-IID data distributions, which degrade model performance and convergence. This paper presents a comprehensive survey of recent advances in addressing data heterogeneity in FL. We categorize existing approaches into four main groups: (1) optimization-based methods that adapt learning algorithms to handle heterogeneity; (2) model personalization techniques that tailor global models to local data; (3) communication-efficient strategies that reduce overhead in heterogeneous settings; and (4) emerging paradigms like split learning and blockchain integration for enhanced robustness. Through an in-depth analysis of over 100 studies, we highlight key insights, limitations, and future research directions, emphasizing the need for benchmarks and real-world evaluations to bridge the gap between theory and practice.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Mickens},
 booktitle = {Proceedings of the 2025 {Workshop}},
 doi = {10.1145/3713082.3730391},
 isbn = {979-8-4007-1475-7},
