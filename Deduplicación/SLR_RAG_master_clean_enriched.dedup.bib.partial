 year = {2025}
}

@inproceedings{jin_intentiongpt_2025,
 abstract = {Designing Interactive Visualizations for Non-Experts to Make Sense of Time Series Data

Time series data is ubiquitous in many domains, yet making sense of it remains challenging for non-experts. We investigate how interactive visualizations can help non-experts explore and understand time series data. Through a design study with domain experts, we identify key challenges and design requirements for such visualizations. We then develop TimeSense, an interactive visualization tool that supports non-experts in exploring time series data through a combination of overview, detail, and pattern discovery features. A user study with non-experts shows that TimeSense significantly improves their understanding and sensemaking of time series data compared to static visualizations. Our findings provide insights into designing effective interactive visualizations for time series sensemaking by non-experts.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Jin},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3701716.3718370},
