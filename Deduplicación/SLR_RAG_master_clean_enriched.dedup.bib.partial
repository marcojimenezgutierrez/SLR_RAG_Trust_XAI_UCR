 year = {2025}
}

@article{kashmira_tobugraph_2024,
 abstract = {Deep reinforcement learning (RL) algorithms have achieved remarkable success in a variety of domains, from video games to robotics. However, these methods often struggle to generalize to new environments, especially when the visual observations change. In this work, we propose a novel approach to improve the generalization of visual RL by leveraging causal representations. Specifically, we introduce a framework that disentangles the causal factors underlying the visual observations and uses them to guide the RL policy learning. Our method, Causal Visual RL (CVRL), identifies invariant causal structures across different environments and exploits them to learn robust policies. We evaluate CVRL on a suite of benchmark tasks with distributional shifts and demonstrate significant improvements in generalization performance compared to state-of-the-art baselines. Our results highlight the potential of causal learning to address the longstanding challenge of generalization in visual RL.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kashmira},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {{TOBUGraph}},
 url = {https://arxiv.org/abs/2412.05447},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:51:11Z},
 year = {2024}
}

@inproceedings{kashyap_rag-em_2025,
 abstract = {This paper proposes a novel method for mitigating electromagnetic interference (EMI) in high-speed data transmission lines using adaptive filtering techniques. The approach integrates machine learning algorithms to dynamically adjust filter parameters based on real-time signal characteristics. Simulation results demonstrate a reduction in EMI by up to 25 dB, while experimental validation on a 10 Gbps Ethernet prototype confirms the method's effectiveness in practical scenarios. The proposed solution offers low computational overhead, making it suitable for integration into existing communication systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Kashyap},
 booktitle = {2025 {IEEE}},
