@inproceedings{zhai_confsum_2025,
 abstract = {Rendering high-quality images from novel viewpoints is a long-standing challenge in computer graphics. Recent advances in neural radiance fields (NeRFs) have led to remarkable progress in this area. However, existing methods often require expensive training and lack flexibility in handling dynamic scenes or relighting. We introduce a novel approach for real-time neural appearance-preserving image-based rendering that leverages pre-trained diffusion models to generate consistent multi-view images from a single input photo. Our method, called DiffusionNeRF, combines the strengths of diffusion models for high-fidelity synthesis with neural radiance fields for view synthesis, enabling photorealistic rendering of complex scenes with minimal input. We demonstrate our approach on a variety of indoor and outdoor scenes, achieving state-of-the-art results in both quality and efficiency.},
