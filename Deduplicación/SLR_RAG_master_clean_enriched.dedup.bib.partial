@inproceedings{jeon_rag-based_2024,
 abstract = {The rapid proliferation of Internet of Things (IoT) devices has significantly expanded the attack surface for cyber threats, necessitating robust intrusion detection systems (IDS). Traditional centralized IDS struggle with the distributed and heterogeneous nature of IoT networks. Federated Learning (FL) emerges as a privacy-preserving paradigm for collaborative IDS training across edge devices. However, FL faces challenges such as data heterogeneity (non-IID), communication overhead, and vulnerability to adversarial attacks. To mitigate these, we propose FedHHO, a novel FL framework integrated with a Hybrid Harris Hawks Optimization (HHO) algorithm. The hybrid HHO enhances client selection, hyperparameter tuning, and model aggregation by mimicking the intelligent hunting behavior of hawks, ensuring efficient convergence and robustness. Extensive experiments on benchmark datasets like NSL-KDD and CIC-IDS2018 demonstrate that FedHHO outperforms state-of-the-art FL-based IDS in terms of accuracy (up to 98.5%), F1-score, and reduced communication rounds, while maintaining data privacy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Jeon},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/TrustCom63139.2024.00098},
