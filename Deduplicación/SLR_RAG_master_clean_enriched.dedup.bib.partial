@inproceedings{ming_faitheval_2025,
 abstract = {This study investigates the application of machine learning techniques to predict the mechanical properties of additively manufactured lattice structures. Using a dataset of over 500 samples from various lattice designs, including gyroid, octet-truss, and diamond configurations, fabricated via selective laser melting, we employ random forest and neural network models to forecast compressive strength and energy absorption. Key features include strut diameter, relative density, and build orientation. Results show that neural networks achieve a mean absolute error of 5.2% for strength prediction, outperforming traditional finite element simulations in computational efficiency. The models are validated through cross-validation and physical testing, highlighting the potential for rapid design optimization in lightweight engineering applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Ming},
 keywords = {source: Scopus},
