@article{tao_llm-r_2024,
 abstract = {While large language models (LLMs) have shown impressive capabilities in generating code, they often struggle with producing code that is both correct and efficient, especially for complex tasks. In this paper, we introduce a novel approach to enhance the code generation capabilities of LLMs by incorporating formal verification techniques. Our method, called VeriCode, integrates lightweight formal methods into the LLM's generation pipeline to iteratively refine and verify generated code snippets. We evaluate VeriCode on a diverse set of programming problems, including algorithmic challenges and real-world software tasks, demonstrating significant improvements in correctness, efficiency, and robustness over state-of-the-art baselines. Our results highlight the potential of combining LLMs with formal verification to advance reliable automated programming.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Tao},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {{LLM}},
 url = {https://arxiv.org/abs/2411.04476},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:16:52Z},
 year = {2024}
}

@article{tao_multimodal_2024,
 abstract = {Recent multi-modal fake news detection methods often use the consistency between textual and visual contents to determine the truth or fake of a news information. Higher levels of textual-visual consistency typically lead to a greater likelihood of classifying a news item as real. However, a critical observation reveals that creators of most fake news intentionally select images that align with the textual content, thereby enhancing the credibility of the news. Consequently, high consistency between textual and visual contents alone cannot guarantee the authenticity of the information. To address this problem, we introduce a novel approach termed Multimodal Consistency-based Suppression Factor to modulate the significance of textual-visual consistency in information assessment. When the textual-visual matching is high, this suppression factor reduces the influence of consistency during the judgment process. Moreover, we use Contrastive Language-Image Pre-training (CLIP) model to extract features and measure the consistency level between modalities to guide multimodal fusion. In addition, we also use a method of compressing and fusing modal information based on Variational Autoencoder (VAE) to reconstruct CLIP features, learning the shared representation of different modal information of CLIP. Finally, extensive experiments were conducted on three publicly datasets, Weibo, Twitter and Weibo21, and the results confirmed that our method outperformed the state-of-the-art methods in the field, and had 0.8%, 2.6% and 4.1% effect improvement on the accuracy rate.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Just Accepted},
 author = {Tao},
 doi = {10.1145/3699959},
 issn = {1551-6857},
 journal = {ACM Trans. Multimedia Comput. Commun. Appl.},
 keywords = {Fake news detection},
 month = {oct},
 note = {Place: New York},
 title = {Multimodal {Consistency}},
 url = {https://doi.org/10.1145/3699959},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:52Z},
 year = {2024}
}

@article{taormina_interpretable_2024,
 abstract = {This study proposes a novel approach for enhancing the security of Internet of Things (IoT) devices in smart home environments through the integration of blockchain technology and machine learning algorithms. The proposed system employs a decentralized ledger to ensure tamper-proof data storage and transaction verification among interconnected devices. Additionally, a hybrid machine learning model, combining convolutional neural networks (CNNs) and long short-term memory (LSTM) networks, is utilized for real-time anomaly detection in network traffic patterns. Experimental evaluations conducted on a simulated smart home network demonstrate that the system achieves a detection accuracy of 98.5% with a false positive rate of less than 1%, significantly outperforming traditional intrusion detection methods. The results highlight the potential of this framework to mitigate cybersecurity threats in resource-constrained IoT ecosystems, paving the way for more secure and reliable smart home applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 2; All Open Access; Gold Open Access},
 author = {Taormina},
 doi = {10.3390/engproc2024069158},
 journal = {Engineering Proceedings},
 keywords = {source: Scopus},
