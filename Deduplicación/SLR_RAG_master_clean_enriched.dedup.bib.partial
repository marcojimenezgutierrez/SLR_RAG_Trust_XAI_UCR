 x_enrich_ts = {2025-11-02T07:26:53Z},
 year = {2025}
}

@inproceedings{maity_leveraging_2025,
 abstract = {Recent advances in conversational AI have enabled the development of sophisticated chatbots capable of engaging in natural language interactions. However, these systems often struggle with maintaining coherent long-term conversations, especially in multi-turn dialogues involving complex topics. In this paper, we investigate the role of memory mechanisms in enhancing the coherence and relevance of chatbot responses. We propose a novel memory-augmented architecture that integrates external knowledge retrieval with internal state tracking to simulate human-like recall and adaptation. Through extensive experiments on benchmark datasets, we demonstrate significant improvements in dialogue quality metrics, including coherence, engagement, and factual accuracy. Our findings highlight the importance of hybrid memory systems for advancing conversational AI towards more robust and context-aware interactions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Maity},
