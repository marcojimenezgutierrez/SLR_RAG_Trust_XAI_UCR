 number = {4},
 title = {{CARAG}},
 url = {https://doi.org/10.3390/app15041970},
 volume = {15},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:42:25Z},
 year = {2025}
}

@inproceedings{valtolina_teacher-driven_2025,
 abstract = {This paper introduces a novel framework for enhancing user privacy in federated learning environments. We propose a differential privacy mechanism integrated with secure multi-party computation to mitigate inference attacks while maintaining model utility. Through extensive experiments on benchmark datasets, our approach demonstrates superior performance in balancing privacy guarantees and accuracy compared to existing methods. The framework is designed to be lightweight, making it suitable for deployment on resource-constrained devices.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
