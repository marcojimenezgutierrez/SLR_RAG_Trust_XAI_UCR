@inproceedings{bouchekir_hallucination_2025,
 abstract = {In the era of big data and cloud computing, data quality issues in distributed systems have become increasingly prominent, leading to unreliable analytics and decision-making processes. This paper proposes a novel framework for automated data quality assessment and improvement in large-scale data pipelines. Our approach leverages machine learning techniques to detect anomalies, inconsistencies, and errors in real-time, while incorporating blockchain for tamper-proof auditing. Through comprehensive experiments on benchmark datasets and real-world deployments, we demonstrate that our framework achieves up to 95% accuracy in anomaly detection and reduces data correction time by 60% compared to traditional methods. The results highlight the framework's scalability and robustness, making it suitable for enterprise-level applications.},
