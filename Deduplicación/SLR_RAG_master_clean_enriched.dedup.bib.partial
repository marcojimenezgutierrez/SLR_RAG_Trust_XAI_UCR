 pages = {105--114},
 publisher = {Association for Computing Machinery},
 series = {Internetware '24},
 title = {T-{RAP}},
 url = {https://doi.org/10.1145/3671016.3672506},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:31:11Z},
 year = {2024}
}

@inproceedings{liu_teaching_2024,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their potential in recommendation systems remains underexplored. Existing recommendation methods heavily rely on explicit user feedback, such as ratings and reviews, which are often sparse and biased. In this paper, we propose Chat-REC, a novel LLM-empowered recommendation framework that leverages implicit user feedback to enhance recommendation quality. By crafting effective prompts that incorporate user interaction histories and item descriptions, Chat-REC enables LLMs to generate personalized recommendations without requiring labeled data. We conduct extensive experiments on real-world datasets, demonstrating that Chat-REC outperforms traditional collaborative filtering and content-based methods in terms of accuracy and diversity. Our work highlights the promising role of LLMs in building more robust and generalizable recommendation systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
