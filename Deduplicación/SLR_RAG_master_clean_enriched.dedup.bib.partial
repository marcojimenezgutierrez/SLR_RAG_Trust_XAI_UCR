@inproceedings{zhou_research_2024,
 abstract = {This paper presents a study on the integration of generative AI tools into middle school design education. We conducted a case study in a 7th-grade classroom where students used AI to generate visual design concepts for a sustainable city project. Through qualitative analysis of student artifacts, interviews, and classroom observations, we examine how AI influences creative processes, collaboration, and learning outcomes. Findings reveal that while AI enhances ideation speed and idea diversity, it also introduces challenges in originality, ethical considerations, and equitable access. We discuss implications for curriculum design and teacher training to leverage AI as a supportive design material in education.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhou},
 booktitle = {Proceedings of the 2024 9th {International}},
 doi = {10.1145/3675812.3675821},
