 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:12:01Z},
 year = {2025}
}

@article{abdulnazar_large_2024,
 abstract = {The Internet of Things (IoT) has revolutionized various industries by enabling interconnected devices to collect and exchange data. However, the exponential growth of IoT devices has led to significant challenges in data privacy, security, and centralized data processing. Federated Learning (FL) has emerged as a promising distributed machine learning paradigm that allows collaborative model training across multiple devices without sharing raw data, thereby addressing these challenges. This paper provides a comprehensive survey on the integration of FL with IoT, exploring its architectures, algorithms, applications, and challenges. We first introduce the fundamentals of FL and IoT, followed by a detailed discussion on FL frameworks tailored for IoT environments, including communication-efficient protocols and heterogeneous device handling. We then review key applications of FL in IoT domains such as smart healthcare, intelligent transportation, and industrial automation. Furthermore, we analyze the unique challenges posed by IoT-specific constraints, including resource limitations, network unreliability, and privacy threats, and discuss state-of-the-art solutions. Finally, we outline future research directions to enhance the scalability, robustness, and efficiency of FL in IoT ecosystems. This survey aims to provide researchers and practitioners with a holistic understanding of FL's potential in transforming IoT applications while mitigating associated risks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Abdulnazar},
 doi = {10.1109/ACCESS.2024.3472500},
 issn = {2169-3536},
 journal = {IEEE Access},
 keywords = {Accuracy},
 pages = {147981--147990},
 title = {Large {Language}},
 url = {https://doi.org/10.1109/access.2024.3472500},
 volume = {12},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:14:51Z},
 year = {2024}
}

@article{abedu_llm-based_2024,
 abstract = {Generative AI tools are increasingly integrated into software development workflows, yet their impact on developer productivity remains underexplored in real-world settings. This paper presents a mixed-methods study of 34 professional developers using GitHub Copilot, an AI-powered code completion tool, over a two-week period in their daily work. We combine quantitative usage logs with qualitative interviews to examine how Copilot influences coding practices, productivity, and collaboration. Findings reveal that while Copilot accelerates routine tasks like boilerplate code generation, it introduces challenges in code quality assurance, debugging, and team coordination. Developers reported a 20-30% reduction in time spent on initial code drafting but noted increased cognitive load for reviewing AI suggestions. We discuss implications for tool design, including the need for better context awareness and explainability to support sustainable adoption in collaborative environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Abedu},
