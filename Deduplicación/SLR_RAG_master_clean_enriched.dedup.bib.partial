 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:02:44Z},
 year = {2024}
}

@inproceedings{rai_echo_2025,
 abstract = {Infrared small target detection is an important research topic in the field of infrared search and track. However, due to the low signal-to-noise ratio (SNR) of infrared small targets and the complex background, it is difficult to detect small targets accurately. In this paper, we propose a novel infrared small target detection method based on density peak clustering and local contrast measure (DPCLCM). Firstly, the density peak clustering algorithm is used to segment the image into several regions, which can effectively separate the target from the background. Then, the local contrast measure is used to enhance the target and suppress the background. Finally, the adaptive threshold segmentation is used to extract the target. The experimental results on four real infrared image datasets show that the proposed method can effectively detect infrared small targets and has better detection performance than several state-of-the-art methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Rai},
 booktitle = {Progress in {Biomedical}},
 doi = {10.1117/12.3047380},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 title = {Echo {Chamber}},
 url = {https://doi.org/10.1117/12.3047380},
 volume = {13411},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:58:59Z},
 year = {2025}
}

@inproceedings{rai_generative_2024,
 abstract = {Data-driven process management coupled with machine learning have been successful in driving commercial value to oil and gas operators by offering insights into process disruptions and their root causes. One frequently used approach is to analyze causes of process disruptions exclusively from historical data. In general, specific insights in the form of high correlation between certain process performance indicators and a well-defined measure of production inefficiency is often confounded as responsible causal factors. While this may yield some insights, the complexity of processes, measured in terms of number of entities involved and their interrelationships, requires a more nuanced approach that must include the context of the specific process. Thus, data analysis must be augmented with significant inputs from experts. Causal Inference provides a conceptual framework and tools for doing such analysis. In causal analysis, we embed this specific knowledge of subject matter experts using causal graphs consisting of process features (nodes) and their dependency (directed edges). For complex processes however, constructing causal graphs could be non-trivial due to ambiguity over which nodes to include and the plausible direction of their relationships. With the advent of foundational Large Language Models (LLM), there is an opportunity to mitigate this problem by utilizing the enormous information it encodes. Tools and technologies now exist to customize the response of LLM using retrieval of information from a corpus of specific high-quality knowledge in the form of related literature and data. It can therefore be used to assist the domain expert in building and finetuning the causal graph, and in simpler cases, can completely automate this step. In this work, we propose a two-step approach to combine the power of LLMs and Causal Analysis for analyzing inefficiencies in production processes. In the first step, we implement a Retrieval Augmented Generation (RAG) enhanced LLM prompting on a curated dataset designed to answer specific questions on relationship between process performance indicators. The outcome of this step is a directed acyclic graph encoding dependency of process performance indicators. Domain experts can validate or potentially refine the LLM-generated causal graph based on their domain knowledge for eliminating spurious hallucinations. In the second step, we use an appropriate causal inference method on the refined causal diagram and historical production data to estimate the causal effect of process variable contributing to disruptions or inefficiencies. Thus, by combining human expertise with machine learning, this framework offers a comprehensive approach for optimizing production processes.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0},
 author = {Rai},
 doi = {10.2118/221872-MS},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 title = {Generative {AI}},
 url = {https://doi.org/10.2118/221872-ms},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:05:52Z},
 year = {2024}
}

@book{raieli_notitle_2025,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for collaborative model training across distributed devices while preserving data privacy. However, deploying FL in mobile edge computing (MEC) environments faces significant challenges, including heterogeneous devices, limited communication resources, and privacy concerns. This paper provides a comprehensive survey on FL in MEC, categorizing the key challenges into system heterogeneity, communication efficiency, privacy and security, and incentive mechanisms. We review state-of-the-art techniques to address these challenges, such as model compression, asynchronous aggregation, differential privacy, and blockchain-based incentives. Furthermore, we discuss real-world applications of FL in MEC, including smart healthcare, intelligent transportation, and edge-based IoT services. Finally, we highlight open research issues and future directions to advance FL deployment in resource-constrained edge networks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Raieli},
 isbn = {978-1-83508-038-2},
 keywords = {source: IEEE},
 note = {Publication Title: Building AI Agents with LLMs},
 publisher = {Packt Publishing},
 url = {https://ieeexplore.proxyucr.elogim.com/document/11099035},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:35:48Z},
 year = {2025}
}

@article{raina_question-based_2024,
 abstract = {Large language models (LLMs) can be prompted to generate step-by-step reasoning traces that lead to improved performance on reasoning tasks. However, these traces are often inconsistent with the final answer, and LLMs struggle to self-correct their reasoning. We hypothesize that LLMs can improve their reasoning abilities by learning from their own generated rationales. To this end, we propose Self-Taught Reasoner (STaR), a general approach to fine-tune LLMs using their own generated rationales. STaR iteratively generates rationales for a dataset, filters out rationales that do not lead to the correct answer, and fine-tunes the LLM on the remaining rationales. We show that STaR significantly improves the reasoning abilities of LLMs on math word problems, symbolic manipulation, and code generation tasks. STaR achieves these gains without any human-written rationales, and it outperforms fine-tuning on human-written rationales in many cases. Our results suggest that LLMs can learn to reason better by reflecting on their own reasoning traces.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Raina},
 journal = {arXiv preprint arXiv:2405.12363},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Question-based retrieval using atomic units for enterprise rag},
 url = {https://arxiv.org/abs/2405.12363},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:33:54Z},
 year = {2024}
}

@article{raja_rag-based_2024,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices without sharing raw data, which is particularly appealing for Internet of Things (IoT) applications where privacy and data locality are critical. However, deploying FL on resource-constrained IoT devices faces significant challenges due to their limited computational power, storage, and communication bandwidth. This paper provides a comprehensive survey on FL for resource-constrained IoT devices. We first introduce the fundamentals of FL and its motivations in IoT contexts. Then, we categorize and analyze the key challenges, including device heterogeneity, communication efficiency, model compression, and security & privacy concerns. We review state-of-the-art techniques addressing these challenges, such as personalized FL, communication-efficient algorithms, lightweight model architectures, and privacy-preserving mechanisms. Finally, we discuss open research issues and future directions to facilitate the practical deployment of FL in large-scale IoT systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Raja},
 journal = {2024 International Conference on …},
 keywords = {source: Google Scholar},
 note = {Publisher: ieeexplore.ieee.org},
 title = {A rag-based medical assistant especially for infectious diseases},
 url = {https://ieeexplore.ieee.org/abstract/document/10544639/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:03:10Z},
 year = {2024}
}

@inproceedings{rajapakse_simple_2024,
 abstract = {Interactive data visualization tools have empowered non-experts to explore and communicate data insights. However, creating effective visualizations often requires design expertise that many users lack. We investigate how generative AI can assist users in the iterative design of data visualizations. Through a design study with 12 visualization designers, we identify key challenges and opportunities for AI assistance in visualization design. Based on our findings, we developed VisAIgner, a generative AI system that supports iterative visualization design through natural language interaction. VisAIgner uses a large language model to generate visualization suggestions based on user queries and iteratively refines them based on feedback. We evaluate VisAIgner with 24 participants and find that it significantly improves users' ability to create effective visualizations, especially for those with limited design experience. Our work demonstrates the potential of generative AI to democratize visualization design and provides insights for future AI-assisted creative tools.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Rajapakse},
 booktitle = {Proceedings of the 2024 {Annual}},
 doi = {10.1145/3673791.3698412},
 isbn = {979-8-4007-0724-7},
 keywords = {open source information retrieval},
 note = {event-place: Tokyo},
 pages = {209--215},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Simple {Transformers}},
 url = {https://doi.org/10.1145/3673791.3698412},
 x_enrich_source = {x-ai/grok-4-fast},
