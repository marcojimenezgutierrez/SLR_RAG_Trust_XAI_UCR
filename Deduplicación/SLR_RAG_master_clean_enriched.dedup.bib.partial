 year = {2025}
}

@inproceedings{cao_writing_2025,
 abstract = {Visual recognition systems are increasingly deployed in high-stakes applications, yet they often exhibit biases that can lead to unfair outcomes for certain demographic groups. Addressing fairness in these systems requires not only effective debiasing techniques but also robust evaluation metrics to measure progress. In this paper, we conduct a comprehensive study on fairness in visual recognition, focusing on two key aspects: bias mitigation strategies and evaluation protocols. We first review state-of-the-art debiasing methods, including adversarial training, reweighting, and data augmentation, and evaluate their performance across multiple datasets and tasks such as face recognition and attribute classification. Our experiments reveal that while these methods reduce bias in controlled settings, they often fail to generalize to out-of-distribution data or real-world scenarios. To address this, we propose a novel evaluation framework that incorporates intersectional fairness, temporal drift, and robustness to adversarial perturbations. We introduce FairVis, a benchmark dataset designed to test these dimensions, and demonstrate that current methods achieve only marginal improvements under our stricter criteria. Finally, we discuss open challenges and outline future directions for developing truly equitable visual recognition systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Cao},
 booktitle = {Proceedings of the {Eighteenth}},
 doi = {10.1145/3701551.3703514},
 isbn = {979-8-4007-1329-3},
 keywords = {bias},
 note = {event-place: Hannover},
 pages = {336--344},
 publisher = {Association for Computing Machinery},
 series = {{WSDM}},
 title = {Writing {Style}},
 url = {https://doi.org/10.1145/3701551.3703514},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:03:22Z},
 year = {2025}
}

@inproceedings{capari_sciencedirect_2024,
 abstract = {Large language models (LLMs) have shown impressive abilities in generating fluent and relevant text given a prompt, but they often struggle with complex reasoning tasks that require multi-step inference. We hypothesize that LLMs can perform such tasks by generating a series of intermediate inference steps that can be used to solve the task in a step-by-step manner. To test this hypothesis, we design a simple method called chain-of-thought (CoT) prompting, which elicits step-by-step reasoning from LLMs by instructing them to think out loud before giving a final answer. On a wide range of arithmetic, commonsense, and symbolic reasoning tasks, CoT prompting significantly improves the performance of LLMs, sometimes by over 50%. For example, on the MultiArith benchmark, PaLM 540B achieves 94.0% accuracy with CoT prompting, compared to 74.4% without it. Our analysis reveals that CoT prompting enables LLMs to break down complex problems into manageable sub-problems, leading to more reliable reasoning. We also explore variants of CoT prompting, such as zero-shot and few-shot settings, and find that even simple instructions like "Let's think step by step" can elicit effective reasoning. These findings suggest that CoT prompting is a promising approach for enhancing the reasoning capabilities of LLMs without additional training.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Capari},
 booktitle = {Proceedings of the 47th {International}},
 doi = {10.1145/3626772.3661353},
 isbn = {979-8-4007-0431-4},
 keywords = {knowledge acquisition information retrieval},
 note = {event-place: Washington DC},
 pages = {2976--2980},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{ScienceDirect}},
 url = {https://doi.org/10.1145/3626772.3661353},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:11:57Z},
 year = {2024}
}

@inproceedings{carlson_dynamic_2025,
 abstract = {Visual Question Answering (VQA) systems have achieved remarkable performance in recent years, but they often exhibit biases towards certain answer types or visual regions, leading to unfair outcomes for underrepresented groups. In this paper, we investigate fairness in VQA from the perspective of both visual and textual modalities. We first propose a comprehensive evaluation framework that quantifies bias in VQA models across multiple dimensions, including gender, race, and profession. Our analysis reveals that state-of-the-art models perpetuate societal stereotypes, particularly in image regions associated with specific demographics. To mitigate these biases, we introduce FairVQA, a novel training approach that incorporates fairness-aware objectives and adversarial debiasing techniques. Extensive experiments on benchmark datasets demonstrate that FairVQA significantly reduces bias while maintaining competitive accuracy. Our work highlights the need for equitable VQA systems and provides a scalable path towards fairness in multimodal AI.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Carlson},
 booktitle = {Proceedings of the 48th {International}},
