@article{gokcimen_novel_2025,
 abstract = {This study proposes a novel hybrid machine learning model for predicting the shear strength of reinforced concrete beams without stirrups. The model integrates extreme gradient boosting (XGBoost) with particle swarm optimization (PSO) to enhance prediction accuracy. Data from 614 experimental tests were used for training and validation. The results demonstrate that the XGBoost-PSO model outperforms traditional empirical formulas and other machine learning approaches, achieving an R² value of 0.95 and a mean absolute error of 0.12. Sensitivity analysis reveals that concrete compressive strength and beam depth are the most influential parameters. This approach offers a reliable tool for structural engineers in designing safe and efficient concrete beams.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
