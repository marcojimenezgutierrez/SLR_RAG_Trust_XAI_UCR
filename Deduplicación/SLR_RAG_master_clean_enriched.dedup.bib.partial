@inproceedings{mailach_themes_2025,
 abstract = {This paper introduces a novel framework for enhancing cybersecurity in AI-driven networks through adaptive intrusion detection systems. We propose a hybrid model combining deep learning techniques with blockchain for real-time threat mitigation. Experimental results on benchmark datasets demonstrate a 25% improvement in detection accuracy compared to traditional methods. The framework's scalability and robustness are evaluated in simulated environments, highlighting its potential for deployment in large-scale networks.},
