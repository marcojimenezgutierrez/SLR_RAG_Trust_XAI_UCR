@inproceedings{liu_comprehensive_2024,
 abstract = {This paper presents a novel approach to enhance the security of Internet of Things (IoT) devices using blockchain technology integrated with machine learning algorithms. We propose a decentralized framework that leverages smart contracts for secure data sharing among IoT nodes, while employing a federated learning model to detect anomalies in real-time without compromising user privacy. Experimental results on a simulated IoT network demonstrate a 25% improvement in detection accuracy and a 40% reduction in latency compared to traditional centralized methods. The framework is evaluated under various attack scenarios, showing robustness against common threats such as DDoS and data tampering.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
