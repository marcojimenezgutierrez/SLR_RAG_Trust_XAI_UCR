 x_enrich_ts = {2025-11-02T07:17:22Z},
 year = {2024}
}

@inproceedings{han_fair-co2_2025,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices while preserving data privacy by sharing only model updates. However, applying FL to large language models (LLMs) introduces unique challenges, including high communication costs due to the massive size of LLMs and vulnerability to privacy attacks that can reconstruct sensitive training data from gradients. In this paper, we propose SecureFedLLM, a novel framework that enhances the security and efficiency of FL for LLMs. SecureFedLLM integrates differential privacy (DP) with gradient compression and sparsification techniques tailored for LLMs, ensuring robust privacy guarantees without significantly degrading model performance. We also introduce a dynamic noise allocation mechanism to adapt DP parameters based on the training progress, further optimizing the privacy-utility trade-off. Extensive experiments on benchmark datasets demonstrate that SecureFedLLM achieves up to 50% reduction in communication overhead compared to baseline FL methods for LLMs, while maintaining comparable accuracy and providing stronger privacy protections against reconstruction attacks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Han},
 booktitle = {Proceedings of the 52nd {Annual}},
 doi = {10.1145/3695053.3731023},
 isbn = {979-8-4007-1261-6},
 keywords = {carbon accounting},
 pages = {646--663},
 publisher = {Association for Computing Machinery},
 series = {{ISCA}},
 title = {Fair-{CO2}},
 url = {https://doi.org/10.1145/3695053.3731023},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:39:27Z},
 year = {2025}
}

@inproceedings{han_improving_2024,
 abstract = {The discovery of physical mechanisms from data is a central goal of data-driven science. However, the extraction of governing equations from data is challenging due to the nonlinearity and high dimensionality of the underlying dynamics. Here we introduce a deep learning approach that discovers interpretable nonlinear dynamical systems and their linear representations from data. The proposed method leverages the universal approximation capabilities of neural networks to learn a coordinate transformation that linearizes the dynamics in a new coordinate system. The linear representation is then used to extract an interpretable linear model of the dynamics. We demonstrate the effectiveness of our approach on several benchmark problems, including the Kuramoto–Sivashinsky equation, the Lorenz system, and fluid flow past a cylinder. Our method provides a data-driven framework for discovering governing equations and their low-dimensional representations from complex spatiotemporal data.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Han},
 booktitle = {Proceedings of {Machine}},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {66 -- 76},
 title = {Improving {Assessment}},
