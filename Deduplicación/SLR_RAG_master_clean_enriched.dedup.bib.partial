}

@inproceedings{yang_boosting_2025,
 abstract = {Fine-grained action recognition aims to distinguish actions with subtle differences, which is challenging due to the lack of discriminative cues in visual data. Recent advances in audio-visual learning have shown that incorporating audio can provide complementary information to improve recognition performance. However, existing methods often treat audio and visual modalities equally, ignoring their distinct contributions to fine-grained action understanding. In this paper, we propose a novel audio-visual style-disentangled representation learning framework, AVStyle, to address this issue. Specifically, we design a style disentanglement module that separates content and style representations in both modalities, enabling the model to focus on action-relevant content while capturing modality-specific stylistic variations. Furthermore, we introduce a cross-modal content alignment strategy to enhance the complementarity between audio and visual content features. Extensive experiments on three fine-grained action recognition benchmarks demonstrate that our AVStyle achieves state-of-the-art performance, with notable improvements in scenarios where visual cues are ambiguous. Our approach highlights the importance of modality-specific style modeling for robust audio-visual fine-grained action recognition.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Yang},
 booktitle = {Proceedings of the 31st {ACM}},
