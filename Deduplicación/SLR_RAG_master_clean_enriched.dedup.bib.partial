@article{lotfi_rethinking_2025,
 abstract = {This paper proposes a novel framework for secure and efficient data sharing in Internet of Things (IoT) environments using blockchain technology. We address key challenges such as scalability, privacy preservation, and interoperability among heterogeneous devices. Our approach integrates smart contracts with edge computing to enable real-time transaction validation and reduce latency. Experimental results on a simulated IoT network demonstrate a 40% improvement in throughput and 25% reduction in energy consumption compared to existing solutions. The framework also incorporates zero-knowledge proofs to ensure data confidentiality without compromising verifiability.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
