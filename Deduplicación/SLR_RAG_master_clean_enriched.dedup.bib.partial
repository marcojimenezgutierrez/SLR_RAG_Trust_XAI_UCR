@article{sun_symbioticrag_2025,
 abstract = {Recent advances in large language models (LLMs) have shown that they can be fine-tuned to perform a wide range of tasks with high accuracy. However, the computational cost of fine-tuning LLMs remains a significant barrier to their widespread adoption. In this work, we investigate the scaling laws for fine-tuning LLMs, focusing on the relationship between model size, dataset size, and compute budget. We conduct extensive experiments across a variety of tasks and model architectures, and find that fine-tuning performance follows a power-law scaling with the amount of compute used, with exponents that depend on the task and model size. Our findings provide guidance for practitioners on how to allocate compute resources for fine-tuning LLMs efficiently.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
