 keywords = {attributions},
 note = {event-place: Padua},
 pages = {22--32},
 publisher = {Association for Computing Machinery},
 series = {{ICTIR}},
 title = {Correctness is not {Faithfulness}},
 url = {https://doi.org/10.1145/3731120.3744592},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:18:05Z},
 year = {2025}
}

@inproceedings{wampfler_platform_2025,
 abstract = {This paper presents EchoState, a framework for simulating future user states to enable adaptive user interfaces. We leverage large language models to predict user intentions and emotional trajectories based on interaction history and contextual cues. Through a series of user studies (N=120), we demonstrate that EchoState-powered interfaces significantly improve task completion rates (by 25%) and user satisfaction (by 18%) compared to static designs. Our approach addresses key challenges in proactive computing, including prediction accuracy and privacy preservation, and opens avenues for more empathetic and anticipatory systems in everyday applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
