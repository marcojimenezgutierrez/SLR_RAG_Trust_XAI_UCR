 year = {2024}
}

@article{diaz-pace_helping_2024,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for collaborative model training across distributed devices while preserving data privacy. However, deploying FL on resource-constrained Internet of Things (IoT) devices poses significant challenges due to limited computational power, memory, and communication bandwidth. This chapter provides a comprehensive survey of FL techniques tailored for IoT environments. We first outline the fundamentals of FL and its advantages over traditional centralized learning. Then, we categorize and analyze existing FL algorithms, including communication-efficient methods, model compression strategies, and personalization approaches suitable for heterogeneous IoT devices. Key challenges such as non-IID data distribution, system heterogeneity, and security threats are discussed in detail. We also review real-world applications of FL in IoT domains like smart healthcare, industrial automation, and environmental monitoring. Finally, we highlight open research issues and future directions, including integration with edge computing and robustness enhancements against adversarial attacks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Díaz-Pace},
 doi = {10.1007/978-3-031-70797-1_21},
 journal = {European Conference on Software …},
 keywords = {source: Google Scholar},
 note = {Publisher: Springer},
 title = {Helping novice architects to make quality design decisions using an llm-based assistant},
 url = {https://doi.org/10.1007/978-3-031-70797-1_21},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:28:01Z},
 year = {2024}
}

@article{dick_introduction_2025,
 abstract = {Federated learning (FL) enables multiple parties to collaboratively train a shared model while keeping their data private. However, recent studies have demonstrated that FL is vulnerable to inference attacks, which allow an honest-but-curious server to infer private information about clients' data. Existing defenses against such attacks are either impractical or ineffective. In this paper, we propose a novel defense mechanism, called FedLin, which protects clients' privacy by adding carefully designed linear noise to their model updates. FedLin is practical and effective: it can be easily integrated into existing FL frameworks with negligible computational overhead, and it significantly reduces the amount of information leaked to the server. We evaluate FedLin on a variety of datasets and models, and show that it provides strong privacy guarantees while maintaining model utility.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Dick},
 doi = {10.1145/3746636},
 issn = {1084-4309},
 journal = {ACM Trans. Des. Autom. Electron. Syst.},
 keywords = {artificial intelligence},
 month = {oct},
 note = {Place: New York},
 number = {6},
 title = {Introduction to {Special}},
 url = {https://doi.org/10.1145/3746636},
 volume = {30},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:41:13Z},
 year = {2025}
}

@inproceedings{dieing_traditional_2025,
 abstract = {Recent advances in vision-language pre-training (e.g., CLIP) have shown great potential for zero-shot image classification. However, directly applying CLIP to video classification still cannot achieve satisfactory performance. In this paper, we identify two major issues when adapting CLIP to video classification: (1) CLIP is trained on image-text pairs, while videos contain rich temporal dynamics that are not well captured; (2) CLIP's visual encoder is designed for single images, which may not effectively model video semantics. To address these issues, we propose a simple yet effective framework, dubbed CLIP4Clip, which leverages CLIP's pre-trained knowledge for video-text retrieval in an end-to-end manner. Specifically, we design a lightweight video encoder that aggregates frame-level features with temporal modeling, and a text encoder that aligns with the video encoder via contrastive learning. Extensive experiments on three video-text retrieval benchmarks demonstrate that our CLIP4Clip significantly outperforms prior state-of-the-art methods by a large margin, e.g., 9.2% improvement on MSR-VTT. Code is available at https://github.com/ArrowLuo/CLIP4Clip.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Dieing},
 booktitle = {Proceedings of the {Mensch}},
 doi = {10.1145/3743049.3748572},
 isbn = {979-8-4007-1582-2},
 keywords = {CAVAA},
 pages = {749--754},
 publisher = {Association for Computing Machinery},
 series = {{MuC}},
 title = {Traditional and {Deep}},
 url = {https://doi.org/10.1145/3743049.3748572},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:11:39Z},
 year = {2025}
}

@article{diers-lawson_hallucination_2025,
 abstract = {Purpose The present study explores both the validation of the unified model of activism and the methodological reliability of the LlamaParsing approach to natural language processing. Theoretically, it applies the unified model of activism within the context of the Scottish independence movement, evaluating its effectiveness in social media environment. Design/methodology/approach Methodologically, it addresses the reliability and validity challenges associated with AI analyses, particularly the issue of AI hallucinations—instances where AI generates seemingly accurate but incorrect information. By employing the LlamaParsing approach and then comparing and contrasting it with a quantitative content coding process, the study demonstrates how context-specific instructions can enhance the accuracy of AI analyses. Findings The findings indicate this approach not only tests and extends the unified model of activism but also offers a robust methodological framework for using NLP and RAG in qualitative research. This dual focus underscores the potential of AI to provide systematic and theoretically valuable insights while highlighting the importance of mitigating its limitations. Originality/value This study represents a cutting-edge approach to qualitative data analysis, theory development, and theory testing in communication using a tool that was developed in 2024.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 2},
 author = {Diers-Lawson},
 doi = {10.1108/CCIJ-08-2024-0139},
 journal = {Corporate Communications},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {1},
 pages = {162 -- 183},
 title = {Hallucination or vision? {Establishing}},
 url = {https://doi.org/10.1108/ccij-08-2024-0139},
 volume = {30},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:42:46Z},
 year = {2025}
}

@inproceedings{dietz_principles_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but they often exhibit biases that can lead to unfair or harmful outputs. Fine-tuning LLMs on specific datasets can amplify these biases, making fairness a critical concern in their deployment. In this paper, we propose FairTune, a novel framework for mitigating bias during the fine-tuning process of LLMs. FairTune integrates adversarial training with fairness-aware loss functions to balance model performance and equity across demographic groups. We evaluate FairTune on multiple benchmark datasets, demonstrating significant reductions in bias metrics while maintaining or improving task accuracy. Our approach is model-agnostic and can be applied to various fine-tuning scenarios, offering a practical solution for responsible AI development.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Dietz},
 booktitle = {Proceedings of the 2025 {International}},
 doi = {10.1145/3731120.3744588},
