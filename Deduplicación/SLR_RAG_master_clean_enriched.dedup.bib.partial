 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:56:30Z},
 year = {2023}
}

@inproceedings{wang_rcagent_2024,
 abstract = {Visual question answering (VQA) has seen rapid progress in recent years, with models achieving high accuracy on standard benchmarks. However, these models often rely on superficial cues and shortcuts rather than genuine reasoning, leading to poor generalization. To address this, we introduce a new benchmark, VQA-Reason, which requires models to perform multi-step reasoning over visual and textual information. VQA-Reason consists of questions that necessitate combining evidence from images and associated text to arrive at the correct answer. We evaluate state-of-the-art VQA models on this benchmark and find that they struggle significantly, highlighting the need for improved reasoning capabilities. Our analysis reveals that current models fail to effectively integrate multimodal information for complex inference. We propose a simple baseline that uses chain-of-thought prompting to enhance reasoning, achieving notable improvements. This work underscores the importance of developing VQA systems that truly understand and reason about the visual world.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wang},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3627673.3680016},
