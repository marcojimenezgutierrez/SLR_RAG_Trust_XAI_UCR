 x_enrich_ts = {2025-11-02T06:34:07Z},
 year = {2025}
}

@inproceedings{yang_cascadercg_2025,
 abstract = {We introduce a novel approach to generating personalized workout plans using large language models (LLMs). Our system, FitLLM, leverages user-specific data such as fitness goals, current fitness level, available equipment, and preferences to create tailored exercise routines. By fine-tuning LLMs on a dataset of expert-curated workout plans, FitLLM produces plans that are safe, effective, and engaging. We evaluate our system through user studies and compare it against traditional fitness apps, showing significant improvements in user adherence and satisfaction. Our work demonstrates the potential of LLMs in personalized health and wellness applications.},
