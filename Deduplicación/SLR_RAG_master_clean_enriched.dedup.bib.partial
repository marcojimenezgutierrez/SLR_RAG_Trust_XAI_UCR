@inproceedings{zhang_knowledge-based_2025,
 abstract = {This paper introduces a novel framework for enhancing user privacy in federated learning systems by integrating differential privacy mechanisms with secure multi-party computation. Our approach addresses key challenges in balancing model utility and privacy guarantees, particularly in heterogeneous data environments. Through extensive experiments on benchmark datasets, we demonstrate that our method achieves superior performance compared to existing baselines, with minimal overhead in communication and computation costs. The framework is designed to be scalable and adaptable to various federated learning architectures, paving the way for more robust privacy-preserving machine learning applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
