 year = {2025}
}

@inproceedings{lin_raccoon_2025,
 abstract = {Generative AI (GenAI) has shown great potential in assisting developers, but its effectiveness in real-world software development remains underexplored. This paper presents a field study of GenAI-assisted software development in industry, focusing on how developers integrate GenAI into their workflows and the challenges they face. Through semi-structured interviews with 24 professional developers from diverse backgrounds, we identify key practices, such as prompt engineering, iterative refinement, and integration with existing tools, as well as barriers including reliability concerns, context limitations, and ethical considerations. Our findings reveal that while GenAI accelerates routine tasks like code generation and debugging, it often falls short in handling complex, domain-specific problems, leading to a hybrid approach where human oversight remains crucial. We discuss implications for tool design, emphasizing the need for better context awareness and explainability to enhance adoption in professional settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
