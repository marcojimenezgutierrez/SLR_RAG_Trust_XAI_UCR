@article{sun_taming_2025,
 abstract = {This paper proposes a novel federated learning framework for privacy-preserving health data analysis in wearable devices. Traditional machine learning approaches often require centralized data collection, raising significant privacy concerns in biomedical applications. Our framework enables collaborative model training across distributed devices without sharing raw data, leveraging differential privacy and secure multi-party computation. We evaluate the approach on real-world datasets for activity recognition and vital sign monitoring, demonstrating comparable accuracy to centralized methods while ensuring strong privacy guarantees. Experimental results show a 5-10% performance degradation under stringent privacy budgets, highlighting the trade-offs and potential for scalable deployment in IoT health systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
