 pages = {137 -- 148},
 title = {Benchmarking of {Retrieval}},
 url = {https://doi.org/10.5220/0013065700003838},
 volume = {3},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:05:46Z},
 year = {2024}
}

@article{knollmeyer_benchmarking_2024-1,
 abstract = {This paper proposes a novel framework for enhancing cybersecurity in IoT environments through the integration of blockchain technology and machine learning algorithms. The framework addresses key challenges such as data integrity, privacy preservation, and real-time threat detection. By leveraging distributed ledger technology for secure data sharing and anomaly detection models for predictive analytics, our approach ensures robust protection against common IoT vulnerabilities. Experimental evaluations on simulated IoT networks demonstrate significant improvements in detection accuracy and response time compared to traditional methods. The results highlight the potential of this hybrid solution for scalable and resilient IoT deployments.},
