@inproceedings{paul_tasca_2025,
 abstract = {This paper introduces a novel framework for enhancing the accessibility of interactive systems through adaptive haptic feedback. We explore the design space of wearable haptic devices tailored for users with diverse motor abilities, emphasizing inclusivity in user-centered design processes. Through iterative prototyping and user studies involving participants with upper-body mobility impairments, we evaluate the effectiveness of our proposed system in improving task performance and user satisfaction. Our findings reveal key challenges in personalization and integration with existing assistive technologies, offering design guidelines and future directions for inclusive haptics in human-computer interaction.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
