@article{ugur_guided_2025,
 abstract = {This paper proposes a novel approach for enhancing image quality in low-light conditions using deep learning techniques. We introduce a lightweight convolutional neural network architecture that combines attention mechanisms with residual connections to effectively restore details and reduce noise. Experimental results on benchmark datasets demonstrate superior performance compared to state-of-the-art methods in terms of PSNR and SSIM metrics. The proposed method is efficient for real-time applications on resource-constrained devices.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
