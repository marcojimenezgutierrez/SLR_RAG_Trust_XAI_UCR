@article{khan_towards_2025,
 abstract = {This paper proposes a novel framework for optimizing energy consumption in smart grids using machine learning techniques. The approach integrates deep reinforcement learning with edge computing to enable real-time decision-making for demand response management. Simulation results demonstrate a 25% reduction in peak load and improved grid stability compared to traditional methods. The framework is evaluated on a dataset from a real-world urban distribution network, highlighting its scalability and robustness against uncertainties in renewable energy sources.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
