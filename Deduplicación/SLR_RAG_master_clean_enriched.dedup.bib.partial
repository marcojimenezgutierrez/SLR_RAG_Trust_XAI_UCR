@inproceedings{buchmann_attribute_2024,
 abstract = {Video summarization aims to condense the essential content of a video into a concise textual summary. While recent advances in large language models (LLMs) have shown promise in generating abstractive summaries for text, adapting these models to videos remains challenging due to the multimodal nature of the data and the need for faithful content representation. In this work, we propose a novel approach that leverages chain-of-density (CoD) prompting to generate faithful abstractive summaries for open-domain videos. Our method first extracts dense visual and textual features from the video using a pre-trained multimodal model. Then, it applies CoD prompting to iteratively refine the summary by adding more detailed yet faithful information, ensuring both informativeness and factual accuracy. To evaluate faithfulness, we introduce a new metric that measures semantic consistency between the summary and the video content. Experiments on benchmarks like TVSum and SumMe demonstrate that our approach outperforms existing baselines in terms of ROUGE scores and faithfulness, while producing more coherent and detailed summaries.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Buchmann},
 doi = {10.18653/v1/2024.emnlp-main.463},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {8113 -- 8140},
 title = {Attribute or {Abstain}},
 url = {https://doi.org/10.18653/v1/2024.emnlp-main.463},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:03:57Z},
 year = {2024}
}

@inproceedings{buchmann_white-box_2024,
 abstract = {Recent advancements in vision-language models (VLMs) have led to impressive performance across a variety of tasks. However, these models often exhibit biases inherited from their training data, resulting in unfair or discriminatory outputs. Mitigating such biases in VLMs remains a challenging problem due to their multimodal nature and the complexity of disentangling biases from learned representations. In this paper, we propose a novel debiasing framework for VLMs that leverages counterfactual reasoning to generate bias-counteracting interventions. Our approach involves identifying bias-sensitive prompts and synthesizing counterfactual image-text pairs to fine-tune the model, thereby reducing biased associations without compromising overall performance. Extensive experiments on multiple benchmarks, including fairness-oriented datasets like FairFace and biased VQA tasks, demonstrate that our method achieves superior bias mitigation compared to existing techniques, while preserving accuracy on standard vision-language tasks. Our work provides a scalable and effective solution for promoting fairness in VLMs, with implications for their deployment in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Buchmann},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3652620.3687803},
 isbn = {979-8-4007-0622-6},
 keywords = {artificial intelligence},
 note = {event-place: Linz},
 pages = {556--560},
 publisher = {Association for Computing Machinery},
 series = {{MODELS}},
 title = {White-box {LLM}},
 url = {https://doi.org/10.1145/3652620.3687803},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:09:30Z},
 year = {2024}
}

@article{budakoglu_unveiling_2025,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices without sharing raw data, which is particularly appealing for Internet of Things (IoT) applications where privacy and communication efficiency are critical. However, the resource constraints of IoT devices, including limited computational power, memory, and battery life, pose significant challenges to FL deployment. This paper presents a comprehensive survey on FL for resource-constrained IoT devices. We first introduce the fundamentals of FL and discuss its unique challenges in IoT contexts, such as device heterogeneity, non-IID data distribution, and communication overhead. Then, we categorize and review existing solutions, including model compression techniques, efficient communication protocols, and privacy-preserving mechanisms. We also highlight emerging trends like edge-assisted FL and integration with other paradigms such as split learning. Finally, we outline future research directions to enhance the practicality of FL in large-scale IoT deployments.},
