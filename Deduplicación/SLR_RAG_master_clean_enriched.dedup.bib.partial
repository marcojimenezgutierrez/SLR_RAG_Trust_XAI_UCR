 year = {2025}
}

@article{donvir_leveraging_2025,
 abstract = {This paper proposes a novel framework for integrating artificial intelligence (AI) with Internet of Things (IoT) devices to enhance real-time data processing and decision-making in smart environments. We introduce an edge-based AI model that optimizes resource allocation while ensuring privacy and security. Through extensive simulations and real-world deployments, our approach demonstrates a 30% improvement in latency and energy efficiency compared to traditional cloud-centric methods. The framework is evaluated on various IoT applications, including smart homes and industrial automation, highlighting its scalability and robustness against adversarial attacks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
