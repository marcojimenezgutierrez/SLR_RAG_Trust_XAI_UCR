@inproceedings{huang_medeeprag_2025,
 abstract = {This paper proposes a novel deep learning-based framework for real-time traffic sign recognition in adverse weather conditions. The framework integrates a multi-scale feature extraction module with an attention mechanism to enhance the robustness of the YOLOv8 model against challenges such as rain, fog, and snow. Extensive experiments on benchmark datasets like TT100K and a custom adverse weather dataset demonstrate that the proposed method achieves superior performance, with an average precision (AP) improvement of 12.3% compared to the baseline YOLOv8, while maintaining real-time inference speeds suitable for autonomous driving applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
