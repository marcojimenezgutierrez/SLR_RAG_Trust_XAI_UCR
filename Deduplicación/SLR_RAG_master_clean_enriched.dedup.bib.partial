 year = {2024}
}

@article{balaka_pneuma_2025,
 abstract = {Finding relevant tables among databases, lakes, and repositories is the first step in extracting value from data. Such a task remains difficult because assessing whether a table is relevant to a problem does not always depend only on its content but also on the context, which is usually tribal knowledge known to the individual or team. While tools like data catalogs and academic data discovery systems target this problem, they rely on keyword search or more complex interfaces, limiting non-technical users' ability to find relevant data. The advent of large language models (LLMs) offers a unique opportunity for users to ask questions directly in natural language, making dataset discovery more intuitive, accessible, and efficient. In this paper, we introduce Pneuma , a retrieval-augmented generation (RAG) system designed to efficiently and effectively discover tabular data. Pneuma leverages large language models (LLMs) for both table representation and table retrieval. For table representation, Pneuma preserves schema and row-level information to ensure comprehensive data understanding. For table retrieval, Pneuma augments LLMs with traditional information retrieval techniques, such as full-text and vector search, harnessing the strengths of both to improve retrieval performance. To evaluate Pneuma , we generate comprehensive benchmarks that simulate table discovery workload on six real-world datasets including enterprise data, scientific databases, warehousing data, and open data. Our results demonstrate that Pneuma outperforms widely used table search systems (such as full-text search and state-of-the-art RAG systems) in accuracy and resource efficiency.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Balaka},
 doi = {10.1145/3725337},
 journal = {Proc. ACM Manag. Data},
 keywords = {source: ACM},
 month = {jun},
 note = {Place: New York},
 number = {3},
 title = {Pneuma: {Leveraging}},
 url = {https://doi.org/10.1145/3725337},
 volume = {3},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:40:54Z},
 year = {2025}
}

@inproceedings{balog_rankers_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, LLMs often generate factually incorrect or inconsistent content, known as hallucinations, which significantly limits their usability in real-world applications. Existing works have made significant progress in mitigating hallucinations in LLMs. However, these methods are limited to specific scenarios and lack a comprehensive understanding of the hallucination problem. In this paper, we conduct a systematic survey on hallucination mitigation in LLMs. We first provide a comprehensive taxonomy of hallucination types and causes. Then, we review the existing methods for hallucination mitigation from three perspectives: model-level, data-level, and post-processing. Finally, we discuss the challenges and future directions for hallucination mitigation in LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Balog},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730348},
 isbn = {979-8-4007-1592-1},
 keywords = {evaluation},
 note = {event-place: Padua},
 pages = {3865--3875},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {Rankers},
 url = {https://doi.org/10.1145/3726302.3730348},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:10:55Z},
 year = {2025}
}

@article{bansal_understanding_2025,
 abstract = {Large Language Models (LLMs) have revolutionized human resources (HR) by powering chatbots that provide instant responses to employee queries. However, a significant challenge is LLM hallucinations, where models generate plausible but incorrect information. This paper explores the causes of hallucinations in HR chatbots and proposes mitigation strategies including fine-tuning, retrieval-augmented generation, and human-in-the-loop verification. Through case studies and empirical analysis, we demonstrate how these strategies can enhance the reliability of HR chatbots, ensuring accurate and trustworthy interactions in organizational settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
