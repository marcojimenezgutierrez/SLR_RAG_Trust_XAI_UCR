@inproceedings{kusuma_trisurya_2024,
 abstract = {Diabetic retinopathy (DR) is a complication of diabetes that affects the eyes and can lead to vision loss if not detected early. Early detection and classification of DR are crucial for timely intervention. Traditional methods for DR detection rely on manual examination by ophthalmologists, which is time-consuming and prone to human error. In recent years, deep learning techniques have shown promising results in automating DR detection from retinal fundus images. This paper provides a comprehensive review of deep learning-based approaches for DR detection and classification. We discuss various convolutional neural network (CNN) architectures, including custom-designed models and pre-trained models fine-tuned for DR tasks. Additionally, we explore the use of ensemble methods and attention mechanisms to improve classification accuracy. The review covers popular datasets such as APTOS 2019, EyePACS, and DDR, along with performance metrics like accuracy, sensitivity, specificity, and AUC-ROC. Challenges such as class imbalance, limited annotated data, and generalizability across different populations are also addressed. Finally, we highlight future research directions, including the integration of explainable AI and multi-modal data fusion for more robust DR detection systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Kusuma},
 booktitle = {2024 {International}},
 doi = {10.1109/ICIMCIS63449.2024.10956359},
 keywords = {source: IEEE},
 month = {nov},
 note = {ISSN: 2837-5203},
 pages = {601--607},
 title = {Trisurya: {A}},
 url = {https://doi.org/10.1109/icimcis63449.2024.10956359},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:04:55Z},
 year = {2024}
}

@inproceedings{kwak_adaptive_2025,
 abstract = {This paper introduces EchoTrace, a novel system that enables users to trace and visualize the propagation of audio signals through physical structures in smart homes, enhancing privacy awareness and security. We address the challenge of detecting covert audio channels that exploit everyday objects like walls and furniture to transmit sensitive information between devices. By leveraging acoustic signal processing and machine learning, EchoTrace passively monitors environmental audio reflections to map signal paths and identify potential vulnerabilities. Our evaluation in real-world smart home setups demonstrates EchoTrace's accuracy in detecting 85% of simulated covert transmissions with minimal false positives. We discuss implications for IoT security and propose design guidelines for mitigating such acoustic side-channels.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Kwak},
