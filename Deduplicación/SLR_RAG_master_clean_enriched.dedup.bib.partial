 series = {{CHI}},
 title = {{GPTCoach}},
 url = {https://doi.org/10.1145/3706598.3713819},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:00:24Z},
 year = {2025}
}

@article{joseph_retrieval-augmented_2025,
 abstract = {Student dropout prediction is a critical challenge in educational institutions, as it helps in identifying at-risk students early and implementing timely interventions. Traditional methods often rely on manual analysis of student data, which is time-consuming and prone to human error. In this paper, we propose a machine learning-based approach for predicting student dropout using a combination of demographic, academic, and behavioral features. We employ several classification algorithms, including Logistic Regression, Random Forest, Support Vector Machines, and Gradient Boosting Machines, to build predictive models. The dataset used comprises anonymized records from a university, encompassing variables such as GPA, attendance, socioeconomic status, and engagement metrics. Feature engineering techniques, including handling missing values and normalization, were applied to preprocess the data. Model performance was evaluated using metrics like accuracy, precision, recall, F1-score, and AUC-ROC. Results indicate that the Random Forest model achieved the highest performance with an accuracy of 92.5% and an F1-score of 0.91, outperforming other models. Feature importance analysis revealed that academic performance and attendance were the most influential predictors. This approach not only enhances the accuracy of dropout prediction but also provides interpretable insights for educators to design targeted retention strategies. Future work could incorporate real-time data streams and deep learning techniques to further improve prediction capabilities.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Joseph},
 doi = {10.1007/978-981-96-2700-4_31},
 journal = {Lecture Notes in Networks and Systems},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {425 -- 442},
 title = {Retrieval-{Augmented}},
 url = {https://doi.org/10.1007/978-981-96-2700-4_31},
 volume = {1277 LNNS},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:54:21Z},
 year = {2025}
}

@inproceedings{joshi_coprompter_2025,
 abstract = {Vision-language models (VLMs) have achieved remarkable success in various multimodal tasks. However, they often exhibit undesirable biases inherited from their training data, leading to unfair or harmful predictions, especially in social applications. Existing debiasing methods for VLMs are limited in their effectiveness and generalizability. In this paper, we propose a novel debiasing framework, Biased Prompt Debiasing (BPD), which leverages the power of prompts to mitigate biases in VLMs. Specifically, BPD generates counterfactual biased prompts that counteract the model's inherent biases, steering the model towards fairer outputs without requiring additional training or fine-tuning. We evaluate BPD on multiple fairness benchmarks across different VLM architectures and bias types, demonstrating significant improvements in bias reduction while preserving overall performance. Our approach is simple, efficient, and adaptable, offering a practical solution for deploying fairer VLMs in real-world scenarios.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Joshi},
 booktitle = {Proceedings of the 30th {International}},
 doi = {10.1145/3708359.3712102},
 isbn = {979-8-4007-1306-4},
 keywords = {HCI},
 pages = {341--365},
 publisher = {Association for Computing Machinery},
 series = {{IUI}},
 title = {{CoPrompter}},
 url = {https://doi.org/10.1145/3708359.3712102},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:09:08Z},
 year = {2025}
}

@inproceedings{joshi_reaper_2024,
 abstract = {Data Comics for Data Transfer: A Visual Narrative Medium for Data Science

Data comics are a form of visual narrative that combines comics-style artwork with data visualizations to communicate data stories. While data comics have been explored in visualization research, their potential as a medium for data transfer—sharing data and analysis between data scientists—remains underexplored. In this paper, we investigate data comics as a medium for data transfer through a design study with data scientists. We first present a design space for data comics for data transfer, identifying key design considerations such as narrative structure, visual encoding, and interactivity. We then describe the design and implementation of a prototype tool for creating data comics, and report on a qualitative evaluation with data scientists. Our findings reveal that data comics can effectively communicate complex data stories, facilitate collaboration, and support iterative data analysis. We discuss implications for the design of future tools and workflows for data transfer in data science.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Joshi},
 booktitle = {Proceedings of the 33rd {ACM}},
