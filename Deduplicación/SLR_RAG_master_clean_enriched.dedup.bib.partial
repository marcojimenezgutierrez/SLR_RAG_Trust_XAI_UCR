@article{pham_towards_2024,
 abstract = {Generalist robot policies are emerging as an exciting direction for robot learning, offering the potential for a single policy to perform a wide range of tasks. However, current approaches to training generalist policies often rely on large-scale data collection and compute-intensive training procedures. In this work, we explore transfer learning as a means to develop generalist robot policies more efficiently. We propose a framework for transferring knowledge from pre-trained vision-language models (VLMs) to robot policies, leveraging the rich world understanding of VLMs to bootstrap robot learning. Our approach, VLM-Transfer, involves distilling VLM representations into a robot policy via imitation learning, enabling the policy to reason about tasks using natural language instructions. We evaluate VLM-Transfer on a suite of robotic manipulation tasks, demonstrating significant improvements in sample efficiency and generalization compared to training from scratch. Our results suggest that transfer learning from VLMs is a promising path towards developing generalist robot policies with minimal data and compute requirements.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Pham},
 journal = {arXiv preprint arXiv:2408.13808},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Towards reliable medical question answering: {Techniques}},
 url = {https://arxiv.org/abs/2408.13808},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:49:21Z},
 year = {2024}
}

@article{pham_vigpt_2025,
 abstract = {This paper proposes a novel framework for enhancing cybersecurity in IoT ecosystems through the integration of blockchain and machine learning techniques. The proposed system leverages distributed ledger technology to ensure secure data sharing among IoT devices while employing advanced anomaly detection algorithms to identify and mitigate potential threats in real-time. Experimental results demonstrate a significant improvement in detection accuracy and response time compared to traditional methods, achieving up to 95% precision in identifying cyber attacks. The framework is evaluated on a simulated IoT network, highlighting its scalability and robustness against common vulnerabilities such as DDoS attacks and data tampering.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
