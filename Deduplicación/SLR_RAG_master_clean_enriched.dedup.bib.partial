@inproceedings{liu_dual_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their performance is often limited by the quality and diversity of the training data. Instruction tuning, which fine-tunes LLMs on datasets of instruction-response pairs, has emerged as a powerful technique to enhance model capabilities. Despite its effectiveness, instruction tuning can inadvertently amplify biases present in the instruction datasets, leading to unfair outputs. In this paper, we conduct a comprehensive survey on fairness in instruction tuning for LLMs. We first categorize existing fairness-enhancing methods into three main groups: data-centric, model-centric, and post-processing approaches. For each category, we discuss the key techniques, their strengths, and limitations. We then analyze the unique challenges in ensuring fairness during instruction tuning, such as the scarcity of fair instruction data and the trade-off between fairness and performance. Finally, we outline promising future research directions to advance fair instruction tuning, including the development of standardized benchmarks and the integration of fairness-aware mechanisms into the tuning process.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Liu},
 booktitle = {Proceedings of the 2025 {ACM}},
 doi = {10.1145/3733965.3733972},
