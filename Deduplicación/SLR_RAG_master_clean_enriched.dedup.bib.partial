 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {4176 -- 4179},
 title = {The 1st {NIP}},
 url = {https://doi.org/10.1145/3726302.3730364},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:36:44Z},
 year = {2025}
}

@inproceedings{zhou_boosting_2024,
 abstract = {This study examines the impact of climate change on agricultural productivity in sub-Saharan Africa, using panel data from 1990 to 2020 across 45 countries. We employ a fixed-effects regression model to assess how temperature and precipitation variations affect crop yields for major staples like maize, rice, and sorghum. Results indicate a significant negative correlation between rising temperatures and yields, with precipitation deficits exacerbating losses in arid regions. Adaptation strategies, such as improved irrigation and drought-resistant varieties, show potential to mitigate up to 30% of projected declines. Policy recommendations include increased investment in climate-resilient agriculture to enhance food security.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 3},
 author = {Zhou},
 booktitle = {Advances in {Neural}},
 keywords = {source: Scopus},
