@article{huang_understanding_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in various tasks, and the emergence of LLM agents has further extended their potential in complex, multi-step problem-solving. Planning is a crucial component in LLM agents, enabling them to break down tasks into manageable sub-tasks and execute them efficiently. This survey provides a comprehensive overview of planning methods in LLM agents, categorizing them into classical planning, learning-based planning, and LLM-specific planning techniques. We discuss the strengths and limitations of each approach, highlight key challenges such as long-horizon planning and robustness, and outline future research directions to advance the field.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Huang},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: researchgate.net
Type: PDF},
 title = {Understanding the planning of {LLM}},
 url = {https://www.researchgate.net/profile/Xu-Huang-37/publication/380756642_Understanding_the_planning_of_LLM_agents_A_survey/links/664d5a9dbc86444c72f64b6f/Understanding-the-planning-of-LLM-agents-A-survey.pdf},
 x_enrich_source = {x-ai/grok-4-fast},
