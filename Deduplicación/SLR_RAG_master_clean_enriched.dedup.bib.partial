 year = {2024}
}

@inproceedings{zhao_empirical_2024,
 abstract = {This paper presents a novel approach to low-resource accented Mandarin automatic speech recognition (ASR) by leveraging large-scale untranscribed accented speech data. We propose a two-stage training framework that first pre-trains a teacher model on a large amount of untranscribed accented speech using self-supervised learning, and then distills the knowledge to a student model fine-tuned on limited transcribed data. To enhance the distillation process, we introduce an accent-aware knowledge distillation method that aligns the accent distributions between teacher and student models. Experimental results on the Accented Mandarin Speech dataset demonstrate that our approach significantly outperforms traditional supervised training methods, achieving up to 15% relative WER reduction in low-resource scenarios.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Zhao},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/ISCSLP63861.2024.10800207},
