@article{xu_chattf_2024,
 abstract = {The rapid proliferation of Internet of Things (IoT) devices has led to an exponential increase in data generation, necessitating efficient and privacy-preserving machine learning techniques. Federated Learning (FL) has emerged as a decentralized approach that enables collaborative model training across distributed devices without sharing raw data, thus addressing privacy concerns in IoT ecosystems. This survey provides a comprehensive overview of FL applications in IoT, focusing on resource-constrained environments. We categorize FL strategies based on communication efficiency, model optimization, and security enhancements, while discussing key challenges such as heterogeneity, scalability, and adversarial attacks. Furthermore, we explore real-world use cases in smart cities, healthcare, and industrial IoT, and outline future research directions to enhance FL's robustness and applicability in next-generation IoT networks.},
