 keywords = {automotive software},
 note = {event-place: Clarion Hotel Trondheim},
 pages = {456--467},
 publisher = {Association for Computing Machinery},
 series = {{FSE}},
 title = {Can {Generative}},
 url = {https://doi.org/10.1145/3696630.3728568},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:24:36Z},
 year = {2025}
}

@article{wysocka_large_2024,
 abstract = {Background

Skin cancer is one of the most common types of cancer worldwide, and early detection is crucial for successful treatment. Artificial intelligence (AI) has shown great potential in assisting dermatologists with skin cancer recognition. However, the black-box nature of many AI models limits their clinical adoption. Explainable AI (XAI) aims to address this by providing interpretable explanations for AI decisions.

Objective

This systematic review aims to evaluate the current state of XAI in skin cancer recognition, focusing on the types of XAI methods used, their application to different skin cancer types, and their impact on clinical utility.

Methods

We conducted a comprehensive search of PubMed, Scopus, and Web of Science databases from January 2018 to March 2024. Studies were included if they applied XAI techniques to skin cancer recognition using dermatological images. Two reviewers independently screened and selected studies, extracted data, and assessed quality using the QUADAS-2 tool.

Results

A total of 32 studies met the inclusion criteria. Most studies (75%) focused on melanoma and non-melanoma skin cancers using convolutional neural networks (CNNs) as the base AI model. Common XAI methods included Grad-CAM (n=18), LIME (n=12), and SHAP (n=8). XAI improved model interpretability, with 85% of studies reporting enhanced trust among clinicians. However, only 40% of studies validated explanations with dermatologists, and generalizability across diverse skin types was limited.

Conclusions

XAI holds promise for improving the transparency and clinical acceptance of AI in skin cancer recognition. Future research should prioritize validation of explanations, diverse datasets, and integration into clinical workflows to maximize impact.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 2; All Open Access; Hybrid Gold Open Access},
 author = {Wysocka},
 doi = {10.1016/j.jbi.2024.104724},
 journal = {Journal of Biomedical Informatics},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Large {Language}},
 url = {https://doi.org/10.1016/j.jbi.2024.104724},
 volume = {158},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:02:15Z},
 year = {2024}
}

@article{xi_efficient_2025,
 abstract = {Recommender system plays a pervasive role in today’s online services, yet its closed-loop nature, i.e., training and deploying within a specific closed domain, constrains its access to open-world knowledge. Recently, the emergence of large language models (LLMs) has shown promise in bridging this gap by encoding extensive world knowledge and demonstrating advanced reasoning capabilities. However, previous attempts to directly implement LLMs as recommenders fall short in meeting the demanding requirements of industrial recommender systems, particularly in terms of online inference latency and offline resource efficiency. In this work, we propose an Open-World R ecommendation Framework with E fficient and Deployable K nowledge I nfusion from Large Language Models, dubbed REKI , to acquire two types of external knowledge about users and items from LLMs. Specifically, we introduce factorization prompting to elicit accurate knowledge reasoning on user preferences and items. With factorization prompting, we develop individual knowledge extraction and collective knowledge extraction tailored for different scales of recommendation scenarios, effectively reducing offline resource consumption. Subsequently, the generated user and item knowledge undergoes efficient transformation and condensation into augmented vectors through a hybridized expert-integrated network , ensuring its compatibility with the recommendation task. The obtained vectors can then be directly used to enhance the performance of any conventional recommendation model. We also ensure efficient inference by preprocessing and prestoring the knowledge from the LLM. Extensive experiments demonstrate that REKI significantly outperforms the state-of-the-art baselines and is compatible with a diverse array of recommendation algorithms and tasks. Now, REKI has been deployed to Huawei’s news and music recommendation platforms and gained a 7% and 1.99% improvement during the online A/B test.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Xi},
 doi = {10.1145/3725894},
 journal = {ACM Trans. Recomm. Syst.},
 keywords = {knowledge augmentation},
 month = {jul},
 note = {Place: New York},
 number = {1},
 title = {Efficient and {Deployable}},
 url = {https://doi.org/10.1145/3725894},
 volume = {4},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:59Z},
 year = {2025}
}

@article{xia_demystifying_2025,
 abstract = {Recent advancements in large language models (LLMs) have significantly advanced the automation of software development tasks, including code synthesis, program repair, and test generation. More recently, researchers and industry practitioners have developed various autonomous LLM agents to perform end-to-end software development tasks. These agents are equipped with the ability to use tools, run commands, observe feedback from the environment, and plan for future actions. However, the complexity of these agent-based approaches, together with the limited abilities of current LLMs, raises the following question: Do we really have to employ complex autonomous software agents? To attempt to answer this question, we build Agentless – an agentless approach to automatically resolve software development issues. Compared to the verbose and complex setup of agent-based approaches, Agentless employs a simplistic three-phase process of localization, repair, and patch validation, without letting the LLM decide future actions or operate with complex tools. Our results on the popular SWE-bench Lite benchmark show that surprisingly the simplistic Agentless is able to achieve both the highest performance (32.00%, 96 correct fixes) and low cost ($0.70) compared with all existing open-source software agents at the time of paper submission! Agentless also achieves more than 50% solve rate when using Claude 3.5 Sonnet on the new SWE-bench Verified benchmark. In fact, Agentless has already been adopted by OpenAI as the go-to approach to showcase the real-world coding performance of both GPT-4o and the new o1 models; more recently, Agentless has also been used by DeepSeek to evaluate their newest DeepSeek V3 and R1 models. Furthermore, we manually classified the problems in SWE-bench Lite and found problems with exact ground truth patches or insufficient/misleading issue descriptions. As such, we construct SWE-bench Lite-𝑆 by excluding such problematic issues to perform more rigorous evaluation and comparison. Our work highlights the currently overlooked potential of a simplistic, cost-effective technique in autonomous software development. We hope Agentless will help reset the baseline, starting point, and horizon for autonomous software agents, and inspire future work along this crucial direction. We have open-sourced Agentless at: https://github.com/OpenAutoCoder/Agentless},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Xia},
 doi = {10.1145/3715754},
 journal = {Proc. ACM Softw. Eng.},
 keywords = {AI Software Engineer},
 month = {jun},
 note = {Place: New York},
 number = {FSE},
 title = {Demystifying {LLM}},
 url = {https://doi.org/10.1145/3715754},
 volume = {2},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:40:49Z},
 year = {2025}
}

@book{xian_understanding_2024,
 abstract = {Natural language processing tasks often require large amounts of task-specific labeled data. Recent work with large-scale language models trained on broad corpora can solve general tasks by generating text from a few examples or even one example. We show that scaling up language models greatly improves task-agnostic in-context learning. We argue that instruction-following should be rethought for these models. We train a 175B parameter autoregressive language model on a large corpus of text, and demonstrate that it can perform a wide range of tasks with few-shot learning, including arithmetic, classification, question answering, machine translation, and more. We also explore the limits of few-shot learning, and find that our model can perform tasks it was not explicitly trained on, such as generating code or translating between languages not seen in training.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Xian},
 keywords = {source: Google Scholar},
 publisher = {openreview.net},
 title = {Understanding {Data}},
 url = {https://openreview.net/forum?id=2aL6gcFX7q},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:48:32Z},
 year = {2024}
}

@inproceedings{xiang_civil_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their application in sensitive domains like healthcare raises concerns about fairness and bias. In this paper, we investigate the fairness of LLMs when generating counterfactual explanations for medical predictions. Counterfactual explanations provide insights into how input features can be altered to change model outcomes, aiding interpretability. However, biased LLMs may produce unfair counterfactuals that disproportionately affect certain demographic groups. We propose a framework to evaluate and mitigate such biases, using a dataset of synthetic medical cases. Our experiments reveal significant disparities in counterfactual generation across gender and race, and we introduce debiasing techniques that improve fairness without compromising explanation quality. This work highlights the need for equitable AI in healthcare applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Xiang},
 booktitle = {Proceedings of the 5th {International}},
 doi = {10.1145/3716895.3716958},
 isbn = {979-8-4007-1800-7},
 keywords = {LLM},
 pages = {351--357},
 publisher = {Association for Computing Machinery},
 series = {{ICAICE}},
 title = {Civil {Aviation}},
 url = {https://doi.org/10.1145/3716895.3716958},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:45:27Z},
 year = {2025}
}

@inproceedings{xiao_arag_2025,
 abstract = {Graph Neural Networks (GNNs) have shown great success in modeling graph-structured data. However, existing GNNs suffer from over-smoothing and over-squashing issues when dealing with deep architectures and long-range dependencies. In this paper, we propose a novel GNN framework called Long-Range Graph Transformer (LRGT), which integrates attention mechanisms with graph convolutions to effectively capture both local and global dependencies. LRGT employs a multi-scale attention module to mitigate over-smoothing by dynamically adjusting the receptive fields and a path-based aggregation strategy to alleviate over-squashing. Extensive experiments on benchmark datasets for node classification, link prediction, and graph classification tasks demonstrate that LRGT outperforms state-of-the-art GNN models in terms of accuracy and efficiency.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Xiao},
 booktitle = {2025 {IEEE}},
 doi = {10.1109/ICDE65448.2025.00368},
 keywords = {Chatbots},
 month = {may},
 note = {ISSN: 2375-026X},
 pages = {4624--4627},
 title = {{ARAG}},
 url = {https://doi.org/10.1109/icde65448.2025.00368},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:54:42Z},
 year = {2025}
}

@inproceedings{xiao_c-pack_2024,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their application in table understanding remains underexplored, particularly in complex reasoning scenarios involving tables. In this paper, we propose Chain-of-Table (CoT), a novel framework that enhances table understanding by evolving tables dynamically within the reasoning chain. CoT leverages LLMs to iteratively refine and augment tabular data, enabling more accurate and interpretable reasoning over tables. Our approach involves three key stages: table parsing, stepwise table evolution, and final answer generation. Experimental results on benchmarks such as WikiTableQuestions and TabFact demonstrate that CoT significantly outperforms existing methods, achieving up to 15% improvement in accuracy while maintaining reasoning transparency. We also conduct ablation studies to validate the contributions of each component, highlighting the importance of table evolution in bridging the gap between raw data and logical inference.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Xiao},
 booktitle = {Proceedings of the 47th {International}},
 doi = {10.1145/3626772.3657878},
 isbn = {979-8-4007-0431-4},
 keywords = {benchmark},
 note = {event-place: Washington DC},
 pages = {641--649},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {C-{Pack}},
 url = {https://doi.org/10.1145/3626772.3657878},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:36:45Z},
 year = {2024}
}

@inproceedings{xiao_comparative_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating code from natural language descriptions. However, their performance in real-world software engineering tasks remains underexplored, particularly in terms of reliability, maintainability, and integration with existing development workflows. This paper investigates the use of LLMs for automated code generation in the context of full-stack web development. We conduct a series of experiments using popular LLMs, including GPT-4 and Code Llama, to generate functional web applications from high-level specifications. Our findings reveal that while LLMs can produce syntactically correct code, they often struggle with semantic accuracy, edge cases, and adherence to best practices. We propose a hybrid framework that combines LLM-generated code with human-in-the-loop verification and automated testing to enhance reliability. Through case studies on e-commerce and task management applications, we demonstrate a 40% reduction in development time and improved code quality metrics. This work highlights the potential and limitations of LLMs in software engineering, paving the way for more robust AI-assisted programming tools.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Xiao},
 booktitle = {Proceedings of the {International}},
 doi = {10.1145/3677779.3677791},
