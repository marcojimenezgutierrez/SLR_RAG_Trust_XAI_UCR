@inproceedings{kim_pimba_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their potential for creative writing remains underexplored, particularly in collaborative settings with human writers. This paper investigates how LLMs can augment human creativity in fiction writing through a user study with 24 participants. We developed a prototype tool, CoWrite, that integrates LLMs into a writing interface to provide real-time suggestions, plot ideas, and character developments. Our findings reveal that while LLMs enhance productivity and idea generation, they can also introduce inconsistencies and reduce originality if not carefully moderated. We discuss design implications for LLM-assisted creative tools, emphasizing the need for transparency, controllability, and human oversight to foster genuine collaboration.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Kim},
