@inproceedings{singh_rags_2025,
 abstract = {People with upper limb difference (PULD) often face barriers to accessing wearable haptic devices due to their design for two-handed use. To address this, we conducted a three-phase design study with 12 PULD participants to explore inclusive haptic wearable design. In the first phase, we gathered requirements through semi-structured interviews, revealing needs for customizable attachment mechanisms, adjustable intensity, and intuitive controls. The second phase involved co-design workshops where participants prototyped solutions using low-fidelity materials, emphasizing modularity and accessibility. In the third phase, we developed and evaluated high-fidelity prototypes, finding that inclusive designs significantly improved usability (p < 0.01) and satisfaction scores. Our findings contribute design guidelines for haptic wearables, including adaptive interfaces and user-centered customization, to promote equitable technology access for PULD.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
