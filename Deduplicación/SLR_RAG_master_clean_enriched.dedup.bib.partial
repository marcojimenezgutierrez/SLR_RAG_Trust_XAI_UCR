@article{ali_atlasgpt_2025,
 abstract = {OBJECTIVE Large language models (LLMs) have shown promising performance on medical licensing examinations, but their ability to excel in subspecialty domains and their robustness under adversarial conditions remain unclear. Herein, the authors present AtlasGPT, a subspecialty-focused LLM for neurosurgery, and evaluate its performance on a benchmark multiple-choice question bank and under adversarial testing, as well as its ability to generate high-quality explanations. METHODS AtlasGPT was built by fine-tuning GPT-4 architecture and retrieval-augmented generation from neurosurgical knowledge sources. Its performance was compared with that of GPT-4 and Gemini Advanced on a 149-question neurosurgery examination. Adversarial testing assessed robustness to misinformation. Answer explanations were rated by 15 independent neurosurgeons and compared with the question bank. RESULTS Across all 149 questions and on text-only questions, AtlasGPT (96%) outperformed Gemini Advanced (93%) and GPT-4 (88%) in accuracy. In adversarial testing, under which AtlasGPT was tasked with identifying medical misinformation, it was fooled 14% of the time, compared with 44% for GPT-4 and 68% for Gemini Advanced. Neurosurgeons rated AtlasGPT’s answer explanations as significantly more comprehensive, relevant, and better referenced than the question bank’s explanations of the responses (p < 0.001). AtlasGPT did not demonstrate any evidence of hallucination or other content that would be harmful for patient care or the surgeon’s clinical decision. CONCLUSIONS AtlasGPT demonstrates the potential of subspecialty-focused LLMs to outperform general models, exhibit robustness to misinformation, and generate high-quality explanations. Domain-specific LLMs may improve medical knowledge, decision-making, and educational materials in complex fields like neurosurgery.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 2},
 author = {Ali},
 doi = {10.3171/2024.12.JNS241607},
 journal = {Journal of Neurosurgery},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {2},
 pages = {560 -- 567},
 title = {{AtlasGPT}},
 url = {https://doi.org/10.3171/2024.12.jns241607},
 volume = {143},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:35:38Z},
 year = {2025}
}

@article{alinejad_evaluating_2024,
 abstract = {The field of robotics has seen significant progress in developing generalist policies that can perform a wide range of tasks. However, existing approaches often require large amounts of data and compute, limiting their accessibility. In this work, we explore transfer learning as a means to develop generalist robot policies more efficiently. We propose a framework that leverages pre-trained vision-language models (VLMs) and fine-tunes them for robotic tasks using a small amount of robot data. Specifically, we use a VLM to encode visual observations and language instructions into a shared embedding space, and then train a policy to map these embeddings to actions. Our approach demonstrates that transfer learning from VLMs can significantly reduce the data and compute requirements for training generalist policies, while maintaining competitive performance across diverse tasks. We evaluate our method on a suite of robotic manipulation tasks and show that it outperforms baselines in sample efficiency and generalization to unseen tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Alinejad},
 journal = {arXiv preprint arXiv:2406.06458},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Evaluating the retrieval component in llm-based question answering systems},
 url = {https://arxiv.org/abs/2406.06458},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:40:41Z},
 year = {2024}
}

@article{alkhalaf_applying_2024,
 abstract = {Background

Healthcare quality assessment is essential for improving patient outcomes and ensuring efficient resource utilization. Traditional methods rely heavily on structured data, which often underrepresents the rich information in unstructured clinical notes. Natural language processing (NLP) offers a promising approach to extract and analyze quality indicators from free-text data. This systematic review synthesizes the current state of NLP applications in healthcare quality assessment.

Methods

We conducted a comprehensive search of PubMed, Embase, Scopus, and Web of Science databases from inception to March 2023. Studies were included if they applied NLP techniques to unstructured clinical text for assessing healthcare quality domains as defined by the Institute of Medicine (safety, effectiveness, patient-centeredness, timeliness, efficiency, and equity). Data were extracted on study characteristics, NLP methods, quality indicators, performance metrics, and challenges. Quality assessment was performed using the QUADAS-2 tool.

Results

Of 1,247 unique records screened, 52 studies met inclusion criteria. The majority (60%) focused on safety indicators, such as adverse events (n=18) and medication errors (n=12). Effectiveness of care was addressed in 25% of studies, primarily through outcome prediction and guideline adherence. NLP approaches included rule-based systems (42%), machine learning (35%), deep learning (18%), and hybrids (5%). Performance varied, with F1-scores ranging from 0.65 to 0.97 (median 0.85). Common challenges included data sparsity, lack of generalizability across institutions, and ethical concerns regarding bias and privacy.

Conclusions

NLP has demonstrated substantial potential in automating healthcare quality assessment from clinical narratives, particularly for safety and effectiveness domains. However, standardization of methods, validation in diverse settings, and integration with electronic health record systems are needed to translate these applications into clinical practice. Future research should prioritize equity-focused indicators and real-world impact evaluations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 45; All Open Access; Hybrid Gold Open Access},
 author = {Alkhalaf},
 doi = {10.1016/j.jbi.2024.104662},
 journal = {Journal of Biomedical Informatics},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Applying generative {AI}},
 url = {https://doi.org/10.1016/j.jbi.2024.104662},
 volume = {156},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:02:44Z},
 year = {2024}
}

@article{alkouz_ukrag_2025,
 abstract = {This chapter introduces the key concepts and methodologies in explainable artificial intelligence (XAI), highlighting the importance of transparency and interpretability in AI systems. We discuss the motivations for XAI, including regulatory requirements, ethical considerations, and practical needs in high-stakes domains such as healthcare and finance. The chapter outlines the main challenges in achieving explainability, such as the trade-off between model accuracy and interpretability, and surveys existing approaches, including feature importance methods, surrogate models, and counterfactual explanations. We also preview the subsequent chapters, which delve deeper into specific techniques and applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
