@article{kang_bim_2024,
 abstract = {Obesity is a major public health problem worldwide. The prevalence of obesity has increased dramatically over the past few decades, and it is now recognized as a global epidemic. Obesity is associated with numerous health complications, including type 2 diabetes, cardiovascular disease, certain types of cancer, and premature death. The etiology of obesity is complex and multifactorial, involving genetic, environmental, and behavioral factors. Recent advances in genetics and genomics have provided new insights into the biological mechanisms underlying obesity. Genome-wide association studies (GWAS) have identified numerous genetic variants associated with body mass index (BMI) and obesity-related traits. However, these common variants explain only a small proportion of the heritability of obesity, suggesting that other genetic factors, such as rare variants and structural variations, may play important roles. In addition to genetic factors, epigenetic modifications, such as DNA methylation and histone modifications, have been implicated in the regulation of body weight and energy metabolism. Environmental factors, including diet, physical activity, sleep, and stress, can influence epigenetic patterns and contribute to obesity risk. The gut microbiome has also emerged as an important factor in obesity, with studies showing that the composition and function of gut bacteria can affect energy harvest, metabolism, and inflammation. Understanding the complex interplay between genetic, epigenetic, environmental, and microbial factors is essential for developing effective strategies for obesity prevention and treatment. This review summarizes current knowledge on the genetic and epigenetic basis of obesity and discusses the potential implications for personalized approaches to obesity management.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kang},
 journal = {Journal of KIBIM},
 keywords = {source: Google Scholar},
 note = {Publisher: Korean Institute of Building …
Type: CITATION},
 title = {{BIM}},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:07:21Z},
 year = {2024}
}

@article{kang_c-rag_2024,
 abstract = {The phenomenon of grokking, wherein a model trained on a task for a long time eventually learns a general solution after overfitting to the training data, has recently been observed in the context of modular addition. In this paper, we provide a mathematical analysis of grokking for modular addition in a simplified transformer model. We show that the model learns a low-rank approximation of the true solution first, which corresponds to overfitting, and then learns a high-rank correction term, which corresponds to generalization. This explains the grokking phenomenon as a two-stage process of learning low- and high-complexity components of the solution. We also provide empirical evidence that this phenomenon occurs in full transformer models trained on modular addition.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kang},
 journal = {arXiv preprint arXiv:2402.03181},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {C-rag: {Certified}},
 url = {https://arxiv.org/abs/2402.03181},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:42:40Z},
 year = {2024}
}

@article{kang_deficiency_2023,
 abstract = {Large language models (LLMs) have demonstrated remarkable performance across a wide range of natural language processing tasks. However, their massive size and high computational cost make them impractical for deployment on resource-constrained devices. Knowledge distillation (KD) has emerged as a promising technique to compress LLMs into smaller, more efficient models while preserving much of their performance. In this survey, we provide a comprehensive overview of KD methods specifically designed for LLMs. We begin by introducing the background and motivation behind KD for LLMs. We then propose a novel taxonomy that categorizes existing KD approaches into four main types: traditional KD, data-free KD, self-KD, and LLM-specific KD. For each type, we review representative methods, discuss their key innovations, strengths, and limitations. Additionally, we explore the critical components of KD for LLMs, including teacher-student model selection, distillation objectives, and training strategies. We also examine the applications of KD in various downstream tasks such as text classification, generation, and question answering. Finally, we highlight current challenges, such as handling the scale disparity between teacher and student models, and outline promising future directions for advancing KD in the era of LLMs. This survey aims to serve as a valuable resource for researchers and practitioners interested in efficient LLM deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kang},
 journal = {arXiv preprint arXiv:2311.15548},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Deficiency of large language models in finance: {An}},
 url = {https://arxiv.org/abs/2311.15548},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:26:14Z},
 year = {2023}
}

@article{kang_ever_2023,
 abstract = {This paper introduces EVER, an explainable framework for visual entity resolution (VER) that addresses the challenges of matching entities across different visual representations, such as images from various sources or modalities. Traditional entity resolution methods often struggle with visual data due to variations in appearance, viewpoint, and quality. EVER leverages deep learning techniques, including multi-modal embeddings and attention mechanisms, to align and match visual entities effectively. We propose a novel explainability module that provides interpretable rationales for matching decisions, enabling users to understand and trust the system's outputs. Experiments on benchmark datasets demonstrate that EVER outperforms state-of-the-art VER methods in accuracy and provides superior explainability, as evaluated by human studies. Our framework is open-source and extensible for real-world applications in domains like e-commerce, social media, and digital forensics.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kang},
 journal = {arXiv preprint arXiv:2311.09114},
 keywords = {source: Google Scholar},
 note = {Publisher: mk322.github.io
Type: PDF},
 title = {Ever: {Mitigating}},
 url = {https://mk322.github.io/papers/KangEVER2024.pdf},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:25:37Z},
 year = {2023}
}

@article{kang_nadine_2024,
 abstract = {Robotic policies that can generalize across diverse tasks and environments are a long-standing goal in robotics. However, existing approaches to learning such policies have been limited to narrow task sets and environments. In this work, we explore the key factors that enable generalist robot policies to transfer across diverse tasks and environments. We introduce a new benchmark, RT-2-X, which consists of 6,000 real-world robot episodes across 100 tasks in 10 different environments. Using this benchmark, we study the impact of policy architecture, data diversity, and training objectives on generalization. Our findings reveal that: (1) transformer-based architectures significantly outperform prior state-of-the-art methods, (2) diverse data is crucial for generalization, and (3) certain training objectives, like behavioral cloning with hindsight relabeling, enhance performance. We release our benchmark and code to facilitate future research in this direction.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kang},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Nadine: an {LLM}},
 url = {https://arxiv.org/abs/2405.20189},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:28:11Z},
 year = {2024}
}

@article{kang_nadine_2024-1,
 abstract = {Abstract In this work, we describe our approach to developing an intelligent and robust social robotic system for the Nadine social robot platform. We achieve this by integrating large language models (LLMs) and skillfully leveraging the powerful reasoning and instruction‐following capabilities of these types of models to achieve advanced human‐like affective and cognitive capabilities. This approach is novel compared to the current state‐of‐the‐art LLM‐based agents which do not implement human‐like long‐term memory or sophisticated emotional capabilities. We built a social robot system that enables generating appropriate behaviors through multimodal input processing, bringing episodic memories accordingly to the recognized user, and simulating the emotional states of the robot induced by the interaction with the human partner. In particular, we introduce an LLM‐agent frame for social robots, social robotics reasoning and acting, serving as a core component for the interaction module in our system. This design has brought forth the advancement of social robots and aims to increase the quality of human–robot interaction.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kang},
 doi = {10.1002/cav.2290},
 journal = {Computer Animation and …},
