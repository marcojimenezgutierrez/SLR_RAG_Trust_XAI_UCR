 series = {{EASE}},
 title = {Llm-based chatbots for mining software repositories: {Challenges}},
 url = {https://doi.org/10.1145/3661167.3661218},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:47:05Z},
 year = {2024}
