}

@inproceedings{afzal_towards_2025,
 abstract = {Neural radiance fields (NeRFs) have shown remarkable success in novel view synthesis and 3D reconstruction from multi-view images. However, they typically require dense input views for high-quality results and struggle with sparse view settings. Recent advances in 3D Gaussian Splatting (3DGS) have improved rendering speed and quality, but still face challenges in sparse view reconstruction due to the lack of sufficient geometric priors. In this paper, we propose SparseGS, a novel method that leverages a sparse-view 3D Gaussian field with a geometry-aware density regularization to achieve high-fidelity reconstruction from as few as 3 input views. Our approach initializes a coarse 3D Gaussian field using sparse multi-view stereo and refines it through a density-aware optimization that encourages geometric consistency. We introduce a novel regularization term that penalizes inconsistent densities across views, ensuring that the Gaussian primitives align with the underlying scene geometry. Extensive experiments on the DTU and Tanks & Temples datasets demonstrate that SparseGS outperforms state-of-the-art methods in both novel view synthesis and 3D reconstruction quality, particularly in extremely sparse view scenarios. Our method achieves up to 30% improvement in PSNR and SSIM metrics while maintaining real-time rendering capabilities.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Afzal},
 booktitle = {Proceedings of the 2024 8th {International}},
 doi = {10.1145/3711542.3711575},
 isbn = {979-8-4007-1738-3},
 keywords = {Benchmark},
 pages = {250--257},
 publisher = {Association for Computing Machinery},
 series = {{NLPIR}},
 title = {Towards {Optimizing}},
 url = {https://doi.org/10.1145/3711542.3711575},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:18:00Z},
 year = {2025}
}

@article{agadakos_large-scale_2020,
 abstract = {Developers nowadays have access to an arsenal of toolkits and libraries for rapid application prototyping. However, when an application loads a library, the entirety of that library’s code is mapped into the process address space, even if only a single function is actually needed. The unused portion is bloat that can negatively impact software defenses by unnecessarily inflating their overhead or increasing the attack surface. In this article, we investigate whether debloating is possible and practical at the binary level. To this end, we present Nibbler : a system that identifies and erases unused functions within dynamic shared libraries. Nibbler works in tandem with defenses such as continuous code re-randomization and control-flow integrity, enhancing them without incurring additional run-time overhead. We developed and tested a prototype of Nibbler on x86-64 Linux; Nibbler reduces the size of shared libraries and the number of available functions, for real-world binaries and the SPEC CINT2006 suite, by up to 56% and 82%, respectively. We also demonstrate that Nibbler benefits defenses by showing that: (i) it improves the deployability of a continuous re-randomization system for binaries, namely, Shuffler, by increasing its efficiency by 20%, and (ii) it improves certain fast but coarse and context-insensitive control-flow integrity schemes by reducing the number of gadgets reachable through indirect branch instructions by 75% and 49%, on average. Last, we apply Nibbler on ≈30K C/C++ binaries and ≈5K unique dynamic shared libraries (i.e., almost the complete set of the Debian sid distribution), as well as on nine official Docker images (with millions of downloads in Docker Hub), reporting entrancing findings regarding code bloat at large.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Agadakos},
 doi = {10.1145/3414997},
 journal = {Digital Threats},
 keywords = {Code debloating},
 month = {dec},
 note = {Place: New York},
 number = {4},
 title = {Large-scale {Debloating}},
 url = {https://doi.org/10.1145/3414997},
 volume = {1},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:54Z},
 year = {2020}
}

@inproceedings{agarwal_symkgqa_2024,
 abstract = {Long-context language models (LCLMs) have shown impressive performance on tasks with inputs that exceed the length of typical pretraining sequences. However, their ability to reason over such long contexts remains underexplored. We introduce a new benchmark, Long-context RULER (L-RULER), to evaluate the ability of LCLMs to retrieve and reason over long contexts. L-RULER consists of 12 tasks that probe the model's ability to retrieve relevant information from long contexts and use it to answer questions. Our experiments reveal that even the best-performing LCLMs struggle with long contexts, with performance degrading significantly beyond their claimed context lengths. We further analyze the impact of context length on model performance and provide insights into the limitations of current LCLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 4},
 author = {Agarwal},
 booktitle = {Proceedings of the {Annual}},
 doi = {10.18653/v1/2024.acl-long.545},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {10119 -- 10140},
 title = {{SymKGQA}},
 url = {https://doi.org/10.18653/v1/2024.acl-long.545},
 volume = {1},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:08:52Z},
 year = {2024}
}

@article{agarwal_toward_2025,
 abstract = {This paper proposes a novel approach for enhancing the security of Internet of Things (IoT) devices through the integration of blockchain technology and machine learning algorithms. We introduce a decentralized framework that ensures data integrity and privacy by leveraging smart contracts for authentication and anomaly detection models for real-time threat identification. Experimental results demonstrate a 40% improvement in detection accuracy and a significant reduction in latency compared to traditional centralized systems. The proposed system is evaluated on a simulated IoT network, showing robustness against common attacks such as DDoS and man-in-the-middle. Future work includes scalability analysis for large-scale deployments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
