@article{yue_democratizing_2023,
 abstract = {This paper examines the impact of artificial intelligence (AI) on the U.S. labor market using novel data from online job vacancies. We construct measures of AI exposure for occupations and regions based on the overlap between AI capabilities and occupational task content. We find that AI exposure is associated with slower employment growth and wage growth in more exposed occupations and regions between 2010 and 2018. These effects are concentrated in routine-intensive occupations and regions with higher initial exposure to AI. We also document a reallocation of employment toward less AI-exposed occupations within firms and industries. Our results suggest that AI is already beginning to reshape the labor market, with implications for future policy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Yue},
 journal = {Available at SSRN 4346152},
 keywords = {source: Google Scholar},
 note = {Publisher: papers.ssrn.com},
 title = {Democratizing financial knowledge with {ChatGPT}},
 url = {https://papers.ssrn.com/sol3/papers.cfm?abstract_id=4346152},
