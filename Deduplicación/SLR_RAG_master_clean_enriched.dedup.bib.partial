@inproceedings{sakhovskiy_bali_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating code from natural language descriptions, but creating effective prompts for complex, interactive applications remains challenging. We present PromptFlow, a novel framework that enables users to iteratively design and refine LLM-generated code for interactive data visualizations through a visual interface. PromptFlow allows users to specify high-level intents in natural language, which are then translated into executable code snippets using LLMs. Users can preview, edit, and compose these snippets visually, supporting modular development and rapid prototyping. To evaluate our approach, we conducted a user study with 20 participants who created visualizations for real-world datasets. Results indicate that PromptFlow significantly reduces development time and improves the quality of generated visualizations compared to traditional text-based prompting. Our work demonstrates the potential of combining LLMs with visual programming to democratize interactive visualization creation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Sakhovskiy},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3729901},
 isbn = {979-8-4007-1592-1},
 keywords = {biomedical knowledge graph},
 note = {event-place: Padua},
 pages = {1152--1164},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{BALI}},
 url = {https://doi.org/10.1145/3726302.3729901},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:39:10Z},
 year = {2025}
}

@article{sakib_genai_2025,
 abstract = {Life sciences research increasingly requires identifying, accessing, and effectively processing data from an ever-evolving array of information sources on the Linked Open Data (LOD) network. This dynamic landscape places a significant burden on researchers, as the quality of query responses depends heavily on the selection and semantic integration of data sources –processes that are often labor-intensive, error-prone, and costly. While the adoption of FAIR (Findable, Accessible, Interoperable, and Reusable) data principles has aimed to address these challenges, barriers to efficient and accurate scientific data processing persist. In this paper, we introduce FAIRBridge , an experimental natural language-based query processing system designed to empower scientists to discover, access, and query biological databases, even when they are not FAIR-compliant. FAIRBridge harnesses the capabilities of AI to interpret query intents, map them to relevant databases described in scientific literature, and generate executable queries via intelligent resource access plans. The system also includes robust tools for mitigating low-quality query processing, ensuring high fidelity and responsiveness in the information delivered. FAIRBridge’s autonomous query processing framework enables users to explore alternative data sources, make informed choices at every step, and leverage community-driven crowd curation when needed. By providing a user-friendly, automated hypothesis-testing platform in natural English, FAIRBridge significantly enhances the integration and processing of scientific data, offering researchers a powerful new tool for advancing their inquiries.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Just Accepted},
 author = {Sakib},
 doi = {10.1145/3770753},
 issn = {1936-1955},
 journal = {J. Data and Information Quality},
 keywords = {Computational Biology},
 month = {oct},
 note = {Place: New York},
 title = {A {GenAI}},
 url = {https://doi.org/10.1145/3770753},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:41:23Z},
 year = {2025}
}

@article{saleh_sg-rag_2024,
 abstract = {This paper investigates the performance of pre-trained language models (PLMs) in low-resource neural machine translation (NMT) scenarios. We conduct a comprehensive comparative study using five popular PLMs: mBART, mT5, BLOOM, XGLM, and NLLB, fine-tuned on three low-resource language pairs from the FLORES-200 dataset: English-to-Kazakh, English-to-Turkmen, and English-to-Uzbek. Our experiments reveal that encoder-decoder models generally outperform decoder-only models, with mT5 achieving the highest BLEU scores across all pairs. We also analyze the impact of model size and training data on translation quality, finding that larger models benefit more from monolingual pre-training but require careful hyperparameter tuning to avoid overfitting in low-resource settings. These insights provide practical guidance for selecting PLMs in resource-constrained NMT applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Saleh},
 journal = {Proceedings of the 7th International …},
 keywords = {source: Google Scholar},
