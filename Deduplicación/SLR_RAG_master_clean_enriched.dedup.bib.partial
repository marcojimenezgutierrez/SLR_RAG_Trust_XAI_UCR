@inproceedings{yan_challenges_2025,
 abstract = {Data visualization is an important tool for data analysis and communication. However, visually impaired people (VIP) are often excluded from accessing data visualizations. Data physicalization and tactile graphics are two common approaches to make data visualization accessible to VIP. However, they have limitations: data physicalizations are often static and require physical space, while tactile graphics are limited in their ability to convey complex data. In this paper, we propose VibraView, a system that enables VIP to visually explore data through data physicalization and vibrotactile feedback. VibraView uses a 3D printer to create data physicalizations and a haptic device to provide vibrotactile feedback. We conducted a user study with 12 VIP to evaluate VibraView. The results show that VibraView is effective in enabling VIP to explore data visualizations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
