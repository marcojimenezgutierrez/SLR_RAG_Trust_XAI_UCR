 keywords = {Creativity},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {Creative {Blends}},
 url = {https://doi.org/10.1145/3706598.3713683},
 we employ generative text-to-image techniques to blend visual elements through their overlapping attributes. a user study (n = {24) demonstrated that our approach reduces participants’ cognitive load},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:08:29Z},
 year = {2025}
}

@inproceedings{sun_d-bot_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their potential biases and unfairness issues have drawn increasing attention from the research community. In this paper, we conduct a comprehensive survey on fairness in LLMs, aiming to provide a systematic understanding of the current landscape. We first introduce the definition of fairness in the context of LLMs and categorize the sources of bias. Then, we review the existing fairness evaluation methods, including intrinsic and extrinsic metrics. Next, we discuss the mitigation techniques for fairness, which can be broadly divided into three categories: data-centric, model-centric, and post-processing approaches. Finally, we highlight the challenges and future directions for fairness in LLMs. This survey aims to serve as a valuable resource for researchers and practitioners working on responsible AI.},
