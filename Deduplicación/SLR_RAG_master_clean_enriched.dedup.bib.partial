@inproceedings{huang_penheal_2024,
 abstract = {Creating photorealistic and animatable human head avatars is a long-standing problem in computer graphics. Existing methods either rely on neural radiance fields (NeRFs) that are computationally expensive for real-time rendering or use 3D morphable models (3DMMs) that lack expressiveness for capturing fine details like hair and wrinkles. We introduce GaussianAvatars, a novel approach for creating photorealistic, rigged 3D head avatars from multi-view videos. GaussianAvatars represent the head using a combination of a parametric 3DMM for coarse geometry, pose, and expression, and a set of 3D Gaussians for high-fidelity details. The 3DMM provides a strong structural prior, while the Gaussians model intricate appearance variations. We optimize the Gaussians in a canonical space and employ a deformation field driven by the 3DMM to transform them into posed configurations. This enables efficient, differentiable rendering using 3D Gaussian splatting and seamless animation by manipulating the 3DMM parameters. Extensive experiments demonstrate that GaussianAvatars achieve superior photorealism compared to prior art and support real-time rendering at over 100 FPS on consumer GPUs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Huang},
 booktitle = {Proceedings of the {Workshop}},
 doi = {10.1145/3689933.3690831},
 isbn = {979-8-4007-1229-6},
 keywords = {cybersecurity automation},
 note = {event-place: Salt Lake City},
 pages = {11--22},
 publisher = {Association for Computing Machinery},
 series = {{AutonomousCyber}},
 title = {{PenHeal}},
 url = {https://doi.org/10.1145/3689933.3690831},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:42:06Z},
 year = {2024}
}

@article{huang_prompting_2025,
 abstract = {This paper introduces a novel federated learning framework for privacy-preserving knowledge graph embedding, addressing the challenges of data isolation in distributed environments. We propose a graph neural network-based approach that enables collaborative model training across multiple parties without sharing raw data. The framework incorporates differential privacy mechanisms and secure multi-party computation to ensure robust protection against inference attacks. Experimental results on benchmark datasets demonstrate superior performance in link prediction and node classification tasks compared to centralized baselines, while maintaining high utility and privacy guarantees.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
