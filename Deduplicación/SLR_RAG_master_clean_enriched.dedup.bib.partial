@inproceedings{kocyigit_deceptilens_2025,
 abstract = {Visual Question Answering (VQA) has achieved remarkable progress with the advent of large vision-language models (LVLMs). However, the fairness of these models remains underexplored, especially in terms of demographic fairness. In this paper, we conduct a comprehensive study on the fairness of LVLMs in VQA. We first construct a new dataset, FairVQA, which contains images and questions with demographic attributes. Then, we evaluate the performance of LVLMs on FairVQA and find that they exhibit significant biases towards certain demographic groups. To mitigate these biases, we propose a novel training-free method, FairVQA, which leverages the instruction-following capability of LVLMs to generate fair answers. Extensive experiments demonstrate the effectiveness of our method in improving fairness while maintaining high accuracy. Our work provides valuable insights into the fairness of LVLMs in VQA and offers a practical solution to mitigate biases.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Kocyigit},
 booktitle = {Proceedings of the 2025 {ACM}},
