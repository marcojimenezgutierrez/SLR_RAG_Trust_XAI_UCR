@article{kumar_improving_2025,
 abstract = {Robotic policies with broad generalization are key to real-world robotic applications, yet remain challenging to develop. In this work, we study what matters in building generalist robot policies. We first propose a new benchmark, Generalist Robot Benchmark (GRB), which consists of 100 diverse tasks spanning manipulation, navigation, and interaction. We then train a series of policies on subsets of GRB and evaluate their generalization to unseen tasks. Our results reveal that: (1) Data diversity is crucial for generalization; (2) Policies trained on diverse data can generalize to unseen tasks with similar embodiments; (3) Scaling data and model size improves performance, but data quality matters more than quantity. Finally, we release GRB and our models to facilitate future research on generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kumar},
 journal = {arXiv preprint arXiv:2505.09031},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Improving the reliability of {LLMs}},
 url = {https://arxiv.org/abs/2505.09031},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:08:55Z},
 year = {2025}
}

@article{kumar_leveraging_2025,
 abstract = {This chapter presents a comprehensive review of deep learning techniques applied to medical image analysis for the early detection of breast cancer using mammograms. We explore convolutional neural networks (CNNs) and their variants, including transfer learning approaches with pre-trained models like ResNet and VGG. The proposed methodology involves data augmentation, feature extraction, and classification stages, achieving an accuracy of 96.5% on the DDSM dataset. Challenges such as imbalanced datasets and interpretability are discussed, along with future directions for integrating explainable AI in clinical settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
