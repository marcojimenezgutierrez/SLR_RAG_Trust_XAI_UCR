@article{antico_unimib_2024,
 abstract = {A central goal in robotics is to develop generalist agents that can perform a wide range of tasks in diverse environments. However, current approaches struggle to generalize across tasks and environments due to the challenge of defining a suitable action space. In this work, we investigate what matters in building a perceptually grounded action space for generalist robot policies. We propose a novel action space that combines low-level continuous control with high-level discrete subgoals, grounded in visual perception via a pre-trained vision-language model. This hierarchical structure allows the policy to reason about tasks at multiple levels of abstraction, enabling better generalization. We evaluate our approach on a suite of simulated robotic manipulation tasks, including those requiring tool use and sequential reasoning. Our results show significant improvements in success rates and sample efficiency compared to baselines, particularly on unseen tasks and environments. We further demonstrate real-world transfer on a Franka Emika Panda robot arm, achieving robust performance on novel manipulation tasks. Our findings highlight the importance of perceptual grounding and hierarchical decomposition in scaling up generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Antico},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Unimib {Assistant}},
 url = {https://arxiv.org/abs/2411.19554},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:48:19Z},
 year = {2024}
}

@misc{anwar_evaluating_2024,
 abstract = {This paper examines the application of ChatGPT, a large language model (LLM), for question-and-answer (Q&A) tasks in the highly specialized field of nuclear data. The primary focus is on evaluating ChatGPT's performance on a curated test dataset, comparing the outcomes of a standalone LLM with those generated through a Retrieval Augmented Generation (RAG) approach. LLMs, despite their recent advancements, are prone to generating incorrect or 'hallucinated' information, which is a significant limitation in applications requiring high accuracy and reliability. This study explores the potential of utilizing RAG in LLMs, a method that integrates external knowledge bases and sophisticated retrieval techniques to enhance the accuracy and relevance of generated outputs. In this context, the paper evaluates ChatGPT's ability to answer domain-specific questions, employing two methodologies: A) direct response from the LLM, and B) response from the LLM within a RAG framework. The effectiveness of these methods is assessed through a dual mechanism of human and LLM evaluation, scoring the responses for correctness and other metrics. The findings underscore the improvement in performance when incorporating a RAG pipeline in an LLM, particularly in generating more accurate and contextually appropriate responses for nuclear domain-specific queries. Additionally, the paper highlights alternative approaches to further refine and improve the quality of answers in such specialized domains.},
 abstract_lang = {en},
 abstract_source = {doi-json},
 author = {Anwar},
 doi = {10.48550/arXiv.2409.00090},
 file = {Preprint PDF:C\:\\Users\\Marco\\Zotero\\storage\\PGRQDWY4\\Anwar et al. - 2024 - Evaluating ChatGPT on Nuclear Domain-Specific Data.pdf:application/pdf},
 keywords = {Computer Science - Artificial Intelligence},
 month = {aug},
 note = {arXiv:2409.00090 [cs]},
 publisher = {arXiv},
 title = {Evaluating {ChatGPT}},
 url = {https://doi.org/10.48550/arxiv.2409.00090},
 urldate = {2025-10-26},
 x_enrich_source = {doi-json},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:30:33Z},
 year = {2024}
}

@inproceedings{aodeng_inreactable_2025,
 abstract = {We present a novel approach to 3D Gaussian Splatting (3DGS) based Simultaneous Localization and Mapping (SLAM) that can build and reconstruct high-fidelity scenes with general surfaces and relightable global illumination. Our method extends 3DGS to handle general surfaces by introducing a novel representation that combines 3D Gaussians with a neural field to model the geometry and appearance of the scene. We leverage the explicit nature of 3D Gaussians to enable efficient tracking and mapping, while the neural field allows for modeling complex surfaces and global illumination effects. To achieve relightable global illumination, we introduce a novel differentiable renderer that can handle both explicit and implicit representations. Our method achieves state-of-the-art performance on challenging indoor and outdoor datasets, demonstrating high-fidelity reconstructions with accurate relighting.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
