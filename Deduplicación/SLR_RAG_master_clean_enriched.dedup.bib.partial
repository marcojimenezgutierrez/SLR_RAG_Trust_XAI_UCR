@inproceedings{quddus_enhanced_2024,
 abstract = {The increasing complexity of cyber threats necessitates advanced detection mechanisms. This paper presents a novel framework for anomaly detection in network traffic using deep learning techniques. We evaluate our approach on benchmark datasets, demonstrating superior performance compared to traditional methods in terms of accuracy and false positive rates. The results highlight the potential of AI-driven solutions in proactive cybersecurity.},
