Type: CITATION},
 title = {Generative {AI}},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:28:32Z},
 year = {2023}
}

@inproceedings{jeong_lightweight_2025,
 abstract = {This paper proposes a novel framework for enhancing cybersecurity in IoT ecosystems using machine learning techniques. We address the challenges of real-time threat detection by integrating federated learning with edge computing paradigms. Experimental results on benchmark datasets demonstrate a 25% improvement in detection accuracy compared to traditional methods, while maintaining low latency suitable for resource-constrained devices. The framework's scalability and adaptability make it applicable to smart city applications and industrial IoT deployments.},
