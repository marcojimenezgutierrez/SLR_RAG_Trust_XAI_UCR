 year = {2025}
}

@article{wei_enhanced_2025,
 abstract = {Explainable Artificial Intelligence (XAI) is an emerging research area aiming to make the decision-making process of AI systems more transparent and understandable to humans. As AI systems become more complex and are increasingly deployed in critical domains such as healthcare, finance, and autonomous driving, the need for explainability becomes paramount to ensure trust, accountability, and regulatory compliance. This paper provides a comprehensive survey of XAI methods, categorizing them into feature attribution, model-agnostic, and visualization-based approaches. We discuss the theoretical foundations, practical implementations, and evaluation metrics for these methods. Furthermore, we highlight the challenges in XAI, including the trade-off between accuracy and explainability, the subjectivity of explanations, and the lack of standardized benchmarks. Finally, we outline future research directions to advance XAI towards more robust and user-centric AI systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Wei},
 journal = {Journal of Artificial …},
 keywords = {source: Google Scholar},
 note = {Publisher: jair.org},
 title = {Enhanced recommendation systems with retrieval-augmented large language model},
 url = {https://www.jair.org/index.php/jair/article/view/17809},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:16:34Z},
 year = {2025}
}

@inproceedings{wei_garag_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but they also exhibit biases that can lead to unfair outcomes in downstream applications. Fine-tuning LLMs on domain-specific data can amplify these biases, making fairness a critical concern. In this paper, we propose FairTune, a novel framework for fair LLM fine-tuning that integrates fairness constraints directly into the optimization process. Our approach uses adversarial training to mitigate biases while preserving model utility. We evaluate FairTune on multiple datasets and tasks, demonstrating significant reductions in bias metrics (e.g., demographic parity) with minimal performance degradation. Our results highlight the importance of fairness-aware fine-tuning for responsible AI deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Cited by: 2},
