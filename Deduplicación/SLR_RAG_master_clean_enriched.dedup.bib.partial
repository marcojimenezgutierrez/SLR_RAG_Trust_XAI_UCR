 year = {2025}
}

@article{heldens_landscape_2020,
 abstract = {The next generation of supercomputers will break the exascale barrier. Soon we will have systems capable of at least one quintillion (billion billion) floating-point operations per second (10 18 FLOPS). Tremendous amounts of work have been invested into identifying and overcoming the challenges of the exascale era. In this work, we present an overview of these efforts and provide insight into the important trends, developments, and exciting research opportunities in exascale computing. We use a three-stage approach in which we (1) discuss various exascale landmark studies, (2) use data-driven techniques to analyze the large collection of related literature, and (3) discuss eight research areas in depth based on influential articles. Overall, we observe that great advancements have been made in tackling the two primary exascale challenges: energy efficiency and fault tolerance. However, as we look forward, we still foresee two major concerns: the lack of suitable programming tools and the growing gap between processor performance and data bandwidth (i.e., memory, storage, networks). Although we will certainly reach exascale soon, without additional research, these issues could potentially limit the applicability of exascale computing.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Heldens},
 doi = {10.1145/3372390},
 issn = {0360-0300},
 journal = {ACM Comput. Surv.},
 keywords = {data-driven analysis},
 month = {mar},
 note = {Place: New York},
 number = {2},
 title = {The {Landscape}},
 url = {https://doi.org/10.1145/3372390},
 volume = {53},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:57Z},
 year = {2020}
}

@inproceedings{hellas_experiences_2024,
 abstract = {Recommendation systems have achieved remarkable success in various online platforms. However, they may exhibit bias against certain user groups, leading to unfair recommendations. Existing fairness-aware recommendation methods mainly focus on improving fairness for a single protected attribute, while neglecting the interactions between multiple protected attributes. In this paper, we propose a novel framework, named Multi-Attribute Fairness-aware Recommendation (MAFRec), to mitigate bias for multiple protected attributes simultaneously. Specifically, we first design a multi-attribute debiasing module to disentangle the representations of users and items with respect to multiple protected attributes. Then, we develop a fairness-aware contrastive learning module to enhance the fairness of user and item representations by pulling representations of similar users/items closer and pushing dissimilar ones apart in the fair subspace. Moreover, we introduce a group-wise re-ranking strategy to further improve the fairness of the recommendation list. Extensive experiments on three real-world datasets demonstrate the effectiveness of our proposed MAFRec in improving both individual and group fairness while maintaining high recommendation performance.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Hellas},
 booktitle = {Proceedings of the 2024 on {ACM}},
