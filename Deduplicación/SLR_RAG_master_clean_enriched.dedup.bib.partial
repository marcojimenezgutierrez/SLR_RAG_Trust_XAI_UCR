}

@inproceedings{ding_diagram_2025,
 abstract = {Visual question answering (VQA) is a challenging multimodal task that requires deep understanding of both visual and textual information. Despite significant progress, current VQA models often struggle with complex reasoning and exhibit biases toward superficial patterns in the data. In this paper, we introduce a novel framework, called Reasoning-Enhanced VQA (RE-VQA), which integrates explicit reasoning mechanisms into the VQA pipeline to improve both accuracy and interpretability. Our approach consists of three key components: (1) a visual grounding module that identifies relevant regions in the image using attention mechanisms, (2) a textual reasoning chain that decomposes the question into sub-questions and generates intermediate reasoning steps, and (3) a multimodal fusion network that combines visual and textual representations for final answer prediction. We evaluate RE-VQA on several benchmark datasets, including VQA v2.0 and GQA, demonstrating substantial improvements in performance, particularly on questions requiring multi-step reasoning. Additionally, our model provides interpretable reasoning traces, enabling better analysis of model decisions. Our work highlights the importance of incorporating structured reasoning in multimodal AI systems and opens avenues for more robust VQA applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
