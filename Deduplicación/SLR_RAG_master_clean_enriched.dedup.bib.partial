@article{ding_automatic_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their performance in mathematical reasoning remains limited, especially for complex problems requiring multi-step reasoning. In this paper, we introduce MathChain, a novel framework that enhances LLM-based mathematical reasoning by integrating chain-of-thought (CoT) prompting with dynamic verification mechanisms. Our approach decomposes complex math problems into intermediate steps, generates multiple reasoning paths, and employs a verifier to select the most consistent solution. Experiments on benchmarks like GSM8K and MATH demonstrate that MathChain outperforms standard CoT methods by up to 15% in accuracy, while reducing hallucination rates. We further analyze the impact of model scale and fine-tuning on performance, providing insights into scaling laws for math-specific LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
