 x_enrich_ts = {2025-11-02T07:38:37Z},
 year = {2025}
}

@inproceedings{dutta_ai_2024,
 abstract = {This paper proposes a novel approach for enhancing the security of Internet of Things (IoT) devices by integrating blockchain technology with machine learning algorithms. The proposed system utilizes a distributed ledger to ensure tamper-proof data storage and employs a convolutional neural network (CNN) for anomaly detection in real-time IoT network traffic. Experimental results demonstrate a 95% accuracy in detecting unauthorized access attempts, with reduced latency compared to traditional centralized security methods. The framework is evaluated on a simulated IoT environment comprising 100 heterogeneous devices, highlighting its scalability and robustness against common cyber threats such as DDoS attacks and data manipulation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
