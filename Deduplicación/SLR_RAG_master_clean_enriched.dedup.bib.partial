}

@article{mala_hybrid_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but they often produce factually incorrect or inconsistent outputs, especially when dealing with complex reasoning tasks. Fact-checking such outputs is crucial for ensuring reliability in real-world applications. Traditional fact-checking methods rely on external knowledge bases or human verification, which can be slow and resource-intensive. In this paper, we propose a novel multi-agent debate framework for automated fact-checking of LLM-generated text. Our approach leverages retriever-augmented generation (RAG) to ground the debate in verifiable evidence from a knowledge corpus. Multiple specialized agents engage in a structured debate, where each agent proposes claims, retrieves supporting evidence, and critiques opposing arguments. The debate process iteratively refines the factuality assessment through adversarial interaction, mimicking human deliberation. We evaluate our framework on benchmark datasets for fact-checking, demonstrating significant improvements over single-agent baselines and state-of-the-art methods. Our results highlight the potential of multi-agent systems in enhancing the trustworthiness of LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Mala},
 journal = {arXiv preprint arXiv:2504.05324},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Hybrid {Retrieval}},
 url = {https://arxiv.org/abs/2504.05324},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:08:01Z},
 year = {2025}
}

@inproceedings{malaborbor_enhancing_2024,
 abstract = {We propose a novel approach to enhance the accessibility of virtual reality (VR) environments for users with visual impairments by integrating haptic feedback with audio cues. Our system, HapticEcho, uses depth-sensing cameras and wearable haptic devices to translate visual elements into tactile patterns and spatial audio. Through a user study with 20 participants, we demonstrate significant improvements in navigation accuracy and user satisfaction compared to traditional audio-only systems. The results suggest that multimodal feedback can bridge accessibility gaps in immersive technologies, paving the way for more inclusive VR applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
