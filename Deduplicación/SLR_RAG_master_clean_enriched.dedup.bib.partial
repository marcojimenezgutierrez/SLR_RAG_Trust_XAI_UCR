@inproceedings{bharambe_exploring_2025,
 abstract = {This paper proposes a novel framework for integrating artificial intelligence with edge computing to enhance real-time decision-making in autonomous systems. We introduce an adaptive learning algorithm that optimizes resource allocation under dynamic network conditions, achieving up to 30% improvement in latency compared to traditional methods. Experimental results on simulated IoT environments demonstrate the framework's robustness and scalability. The approach addresses key challenges in privacy preservation and energy efficiency, paving the way for practical deployments in smart cities and industrial automation.},
