@inproceedings{meng_analysis_2025,
 abstract = {This paper proposes a novel framework for enhancing explainability in deep learning models applied to medical image analysis. We introduce an attention-based mechanism that integrates spatial and channel attention to highlight salient features in X-ray images for pneumonia detection. The proposed model achieves superior performance on benchmark datasets, with an accuracy of 95.2% and improved interpretability scores compared to state-of-the-art methods. Experimental results demonstrate the framework's robustness and potential for clinical deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
