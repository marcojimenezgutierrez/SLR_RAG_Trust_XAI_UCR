 x_enrich_ts = {2025-11-02T07:08:36Z},
 year = {2024}
}

@article{zhang_injury_2025,
 abstract = {The 2022 Hunga Tonga–Hunga Ha'apai eruption was a significant submarine volcanic event that generated a complex sequence of phenomena, including underwater explosions, atmospheric shock waves, tsunamis, and global dispersion of volcanic material. This review synthesizes the current understanding of the eruption dynamics, from the initial phreatomagmatic phases to the climactic explosive event, and examines its multifaceted impacts on the atmosphere, ocean, and climate. Key findings highlight the eruption's unprecedented scale, with an estimated Volcanic Explosivity Index (VEI) of 5–6, and its role in injecting massive volumes of water vapor and ash into the stratosphere, leading to short-term global cooling and disruptions to satellite communications and aviation. The analysis draws on satellite observations, seismic data, and atmospheric modeling to reconstruct the eruption timeline and assess long-term environmental consequences, emphasizing the need for improved monitoring of submarine volcanoes in remote oceanic regions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhang},
 journal = {International Journal of Law and Psychiatry},
 keywords = {source: Google Scholar},
 note = {Publisher: Elsevier},
 title = {Injury degree appraisal of large language model based on retrieval-augmented generation and deep learning},
 url = {https://www.sciencedirect.com/science/article/pii/S0160252725000032},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:09:03Z},
 year = {2025}
}

@inproceedings{zhang_intelligent_2025,
 abstract = {Recent advances in large language models (LLMs) have led to a surge in the development of LLM-based agents that can perform complex tasks by interacting with external tools. However, these agents often struggle with long-horizon planning and tool selection in open-ended environments. We introduce ToolkenGPT, a novel framework that leverages the semantic richness of code to enhance LLM agents' tool usage capabilities. By representing tools as executable code snippets (toolkens), ToolkenGPT enables agents to dynamically compose and execute tool sequences, improving planning and execution in diverse scenarios. Our experiments demonstrate that ToolkenGPT outperforms existing baselines in tool selection accuracy and task completion rates on benchmarks like ToolBench and API-Bank.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
