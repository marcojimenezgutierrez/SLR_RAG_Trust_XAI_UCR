@article{wilkerson_implementing_2024,
 abstract = {This paper proposes a novel federated learning framework for privacy-preserving anomaly detection in IoT networks. Traditional centralized approaches for anomaly detection often require sensitive data to be shared with a central server, raising significant privacy concerns. To address this, we introduce a federated learning-based system where edge devices collaboratively train a shared anomaly detection model without exchanging raw data. Our framework leverages a combination of autoencoders and graph neural networks to capture both temporal and spatial dependencies in IoT traffic patterns. Extensive experiments on real-world datasets demonstrate that our approach achieves comparable accuracy to centralized methods while preserving user privacy, with up to 95% reduction in data exposure risks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
