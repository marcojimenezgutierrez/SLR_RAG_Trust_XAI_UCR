@inproceedings{shen_large_2025,
 abstract = {Data visualization is a powerful tool for exploring and communicating insights from complex datasets. However, creating effective visualizations often requires expertise in both data analysis and graphic design, which can be a barrier for many users. To address this, we introduce VizGen, a generative AI system that automates the creation of interactive data visualizations from natural language descriptions. VizGen leverages large language models (LLMs) combined with visualization-specific prompting strategies to generate Vega-Lite specifications, which are then rendered as interactive charts. Our system supports a wide range of chart types, including bar charts, line charts, scatter plots, and more advanced visualizations like layered and multi-view compositions. Through a user study with 24 participants, we demonstrate that VizGen significantly reduces the time and effort required to create visualizations while producing outputs comparable in quality to those created by experts. We also discuss the limitations of current LLMs in handling ambiguous queries and propose directions for future improvements, such as incorporating user feedback loops and domain-specific fine-tuning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Shen},
 booktitle = {Proceedings of the 10th {International}},
 doi = {10.1145/3759179.3760456},
 isbn = {979-8-4007-1863-2},
 keywords = {digital technology},
 pages = {344--352},
 publisher = {Association for Computing Machinery},
 series = {{ICCSIE}},
 title = {A large language model algorithm for green finance innovation for digital technology innovation of heavily polluting enterprises},
 url = {https://doi.org/10.1145/3759179.3760456},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:30:25Z},
 year = {2025}
}

@article{shen_large_2025-1,
 abstract = {Supply chain management (SCM) plays a pivotal role in modern business operations, ensuring the seamless flow of goods, services, and information from suppliers to end consumers. However, traditional SCM systems are plagued by issues such as lack of transparency, vulnerability to fraud, and inefficient data sharing among stakeholders. Blockchain technology offers a decentralized, immutable, and transparent platform to address these challenges, but its integration into SCM introduces new security risks, including scalability limitations, privacy concerns, and susceptibility to advanced cyber threats. This paper introduces a novel framework to bolster the security of blockchain-based SCM through the integration of deep learning techniques. The proposed approach employs convolutional neural networks (CNNs) for real-time anomaly detection in transaction data and long short-term memory (LSTM) networks for forecasting potential security breaches. By synergizing blockchain's core security attributes with deep learning's analytical prowess, the framework provides robust safeguards against fraudulent transactions and unauthorized intrusions. Experimental evaluations reveal that the system attains a 98.5% accuracy in anomaly detection, with a 15% reduction in false positives relative to conventional techniques. Additionally, it upholds superior throughput and minimal latency, rendering it viable for practical SCM deployments. This research advances the development of secure and streamlined SCM ecosystems, facilitating broader industrial adoption of blockchain solutions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1; All Open Access; Gold Open Access},
 author = {Shen},
 doi = {10.32604/cmc.2025.067427},
 journal = {Computers},
 keywords = {source: Scopus},
 note = {Type: Review},
 number = {2},
 pages = {1921 -- 1950},
 title = {Large {Language}},
 url = {https://doi.org/10.32604/cmc.2025.067427},
 volume = {84},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:54:28Z},
 year = {2025}
}

@article{shen_pentestagent_2025,
 abstract = {Data Comics: Sequential Art for Data-Driven Storytelling  
Authors: Zezhong Wang, Matthew J. Xu, Donghao Ren, Fanny Chevalier  
Abstract: Data comics are a form of sequential art that uses a combination of words, images, and data visualizations to tell stories about data. They leverage the narrative structure and visual language of comics to make data stories more engaging and accessible to a broad audience. In this paper, we introduce data comics as a new medium for data-driven storytelling and explore their design space through a series of examples. We discuss the key elements of data comics, including panels, transitions, characters, and data visualizations, and how they can be combined to create compelling narratives. We also present a set of design guidelines for creating effective data comics, based on our experience and feedback from readers. Our work aims to inspire designers, journalists, and researchers to experiment with data comics as a way to communicate data insights in a more narrative and visually appealing manner.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 annote = {Query date: 2025-10-25 20:50:36},
