}

@inproceedings{mikriukov_ai_2025,
 abstract = {3D Gaussian Splatting (3DGS) has revolutionized novel view synthesis with its real-time rendering capabilities. However, its potential for simultaneous localization and mapping (SLAM) remains underexplored due to the lack of a fast and accurate online training method. We propose the first real-time 3DGS-based SLAM system that supports both high-fidelity novel view synthesis and accurate 6-DoF pose tracking. Our approach leverages the explicit nature of 3DGS and introduces a novel online densification and pruning strategy that enables efficient adaptation to new scenes. By integrating a robust pose optimization module and a density control mechanism, our system achieves state-of-the-art performance on standard SLAM benchmarks while maintaining real-time operation on consumer-grade GPUs. Extensive experiments demonstrate superior accuracy and rendering quality compared to neural radiance field-based methods, paving the way for practical AR/VR applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Mikriukov},
 booktitle = {Proceedings of the 2025 {International}},
