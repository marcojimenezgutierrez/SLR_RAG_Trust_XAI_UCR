 x_enrich_ts = {2025-11-02T09:20:20Z}
}

@inproceedings{zou_pscon_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their potential biases, inherited from training data or fine-tuning processes, raise significant concerns about fairness. Instruction tuning, a prevalent fine-tuning paradigm, plays a pivotal role in adapting LLMs to specific tasks while potentially exacerbating biases. In this survey, we provide a comprehensive overview of fairness in instruction tuning for LLMs. We first delineate the unique challenges posed by instruction tuning in terms of fairness. Subsequently, we categorize existing fairness-enhancing methods into three primary groups: data-centric, model-centric, and post-processing approaches. For each category, we delve into the methodologies, their strengths, limitations, and empirical findings. Furthermore, we discuss evaluation metrics and datasets pivotal for assessing fairness in this context. Finally, we outline future research directions to advance fairness in instruction-tuned LLMs, emphasizing the need for interdisciplinary collaboration and robust evaluation frameworks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zou},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3730278},
