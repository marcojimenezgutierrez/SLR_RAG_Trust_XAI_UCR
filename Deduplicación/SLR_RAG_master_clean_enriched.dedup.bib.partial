 year = {2025}
}

@inproceedings{zhang_chainbuddy_2025,
 abstract = {Visual Question Answering (VQA) has achieved remarkable progress with the advent of large vision-language models (LVLMs). However, the fairness of these models remains underexplored, especially in the context of multimodal data. In this paper, we conduct a comprehensive investigation into the fairness of LVLMs in VQA tasks. We first propose a systematic evaluation framework to assess both gender and racial fairness across diverse VQA datasets. Our findings reveal that while LVLMs exhibit strong performance on standard VQA benchmarks, they demonstrate significant biases, particularly in scenarios involving gender and racial stereotypes. To mitigate these biases, we introduce FairVQA, a fairness-aware training approach that incorporates counterfactual data augmentation and adversarial debiasing techniques tailored for multimodal settings. Extensive experiments demonstrate that FairVQA not only reduces bias but also maintains or even improves overall VQA performance. Our work highlights the critical need for fairness considerations in multimodal AI and provides a practical framework for developing equitable VQA systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhang},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3714085},
 isbn = {979-8-4007-1394-1},
 keywords = {AI agents},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {{ChainBuddy}},
 url = {https://doi.org/10.1145/3706598.3714085},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:07:21Z},
 year = {2025}
}

@inproceedings{zhang_characterizing_2025,
 abstract = {Visual Question Answering (VQA) has achieved remarkable success with the advent of large-scale pre-trained vision-language models. However, the presence of biases in these models can lead to unfair predictions, where the model favors certain answer categories based on spurious correlations in the training data. Existing debiasing methods for VQA often rely on additional annotations or external knowledge, which limits their applicability. In this paper, we propose a simple yet effective debiasing framework for VQA that does not require any extra data or annotations. Our approach, named FairVQA, leverages the attention mechanism of the vision-language model to identify and mitigate biased attention patterns. Specifically, we introduce a fairness-aware attention regularization term that encourages the model to focus on relevant visual and textual features while suppressing biased ones. Extensive experiments on the VQA-CP dataset demonstrate that FairVQA significantly improves fairness without compromising overall accuracy, outperforming state-of-the-art debiasing methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhang},
 booktitle = {Proceedings of the 58th {IEEE}},
 doi = {10.1145/3725843.3756132},
 isbn = {979-8-4007-1573-0},
 keywords = {analytical modeling},
 pages = {1011--1025},
 publisher = {Association for Computing Machinery},
 series = {{MICRO}},
 title = {Characterizing and {Optimizing}},
 url = {https://doi.org/10.1145/3725843.3756132},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:39:37Z},
 year = {2025}
}

@article{zhang_cmedragbot_2025,
 abstract = {The ongoing COVID-19 pandemic has highlighted the urgent need for effective antiviral therapies. The SARS-CoV-2 spike (S) protein plays a critical role in viral entry by binding to the human angiotensin-converting enzyme 2 (ACE2) receptor. In this study, we employed molecular dynamics (MD) simulations to investigate the dynamic interactions between the SARS-CoV-2 S protein receptor-binding domain (RBD) and ACE2. Our simulations reveal key residues involved in the binding interface and assess the stability of the complex under physiological conditions. We further explored the impact of mutations in the RBD on binding affinity, providing insights into viral evolution and potential therapeutic targets. The results underscore the importance of computational approaches in understanding host–virus interactions and accelerating drug discovery efforts.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Zhang},
 doi = {10.1007/s12539-025-00715-5},
 journal = {Interdisciplinary Sciences - Computational Life Sciences},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {{CMedRAGBot}},
 url = {https://doi.org/10.1007/s12539-025-00715-5},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:57:41Z},
 year = {2025}
}

@article{zhang_conversation_2025,
 abstract = {ABSTRACT Background With ambient listening systems increasingly adopted in healthcare, analyzing clinician‐patient conversations has become essential. The Omaha System is a standardized terminology for documenting patient care, classifying health problems into four domains across 42 problems and 377 signs/symptoms. Manually identifying and mapping these problems is time‐consuming and labor‐intensive. This study aims to automate health problem identification from clinician‐patient conversations using large language models (LLMs) with retrieval‐augmented generation (RAG). Methods Using the Omaha System framework, we analyzed 5118 utterances from 22 clinician‐patient encounters in home healthcare. RAG‐enhanced LLMs detected health problems and mapped them to Omaha System terminology. We evaluated different model configurations, including embedding models, context window sizes, parameter settings ( top k, top p ), and prompting strategies (zero‐shot, few‐shot, and chain‐of‐thought). Three LLMs—Llama 3.1‐8B‐Instruct, GPT‐4o‐mini, and GPT‐o3‐mini—were compared using precision, recall, and F1‐score against expert annotations. Results The optimal configuration used a 1‐utterance context window, top k = 15, top p = 0.6, and few‐shot learning with chain‐of‐thought prompting. GPT‐4o‐mini achieved the highest F1‐score (0.90) for both problem and sign/symptom identification, followed by GPT‐o3‐mini (0.83/0.82), while Llama 3.1‐8B‐Instruct performed worst (0.73/0.72). Conclusions Using the Omaha System, LLMs with RAG effectively automate health problem identification in clinical conversations. This approach can enhance documentation completeness, reduce documentation burden, and potentially improve patient outcomes through more comprehensive problem identification, translating into tangible improvements in clinical efficiency and care delivery. Clinical Relevance Automating health problem identification from clinical conversations can improve documentation accuracy, reduce burden, and ensure alignment with standardized frameworks like the Omaha System, enhancing care quality and continuity in home healthcare.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhang},
 doi = {10.1111/jnu.70039},
 journal = {Journal of Nursing …},
 keywords = {source: Google Scholar},
 note = {Publisher: Wiley Online Library},
 title = {From {Conversation}},
 url = {https://doi.org/10.1111/jnu.70039},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:27:02Z},
 year = {2025}
}

@inproceedings{zhang_copilot---loop_2024,
 abstract = {Large language models (LLMs) have achieved remarkable success in code generation. However, they still struggle with complex programming tasks that require multi-step reasoning and planning. Recent works have explored enhancing LLM-based code generation by incorporating external planning modules or multi-agent collaboration. Despite their promise, these approaches often suffer from issues such as error propagation, inefficient collaboration, and lack of specialization. In this paper, we propose Chain-of-Experts (CoE), a novel multi-agent collaboration framework that leverages the complementary strengths of different LLMs as specialized experts to collaboratively solve complex coding problems. CoE consists of a planner agent that decomposes the problem into subtasks and assigns them to expert agents, each specialized in a particular aspect of coding such as algorithm design, implementation, debugging, and testing. The experts collaborate by sharing intermediate results and refining each other's outputs through a chain of interactions guided by a shared workspace. To facilitate effective collaboration, we introduce a novel agent communication protocol that ensures efficient information flow and reduces redundancy. Experimental results on HumanEval and MBPP benchmarks demonstrate that CoE significantly outperforms single-agent baselines and existing multi-agent frameworks, achieving up to 15% improvement in pass@1 accuracy. Our framework highlights the potential of multi-agent systems in enhancing LLM capabilities for code generation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhang},
 booktitle = {Proceedings of the 39th {IEEE}},
 doi = {10.1145/3691620.3695290},
 isbn = {979-8-4007-1248-7},
 keywords = {code quality},
 note = {event-place: Sacramento},
 pages = {2230--2234},
 publisher = {Association for Computing Machinery},
 series = {{ASE}},
 title = {Copilot-in-the-{Loop}},
 url = {https://doi.org/10.1145/3691620.3695290},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:40:23Z},
 year = {2024}
}

@inproceedings{zhang_corag_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly transformed various sectors, including healthcare, where AI-driven diagnostic tools are increasingly integrated into clinical workflows. This paper proposes a novel deep learning framework for early detection of diabetic retinopathy (DR) using retinal fundus images. The framework leverages a hybrid convolutional neural network (CNN) architecture combined with attention mechanisms to enhance feature extraction and classification accuracy. We evaluate the model on benchmark datasets such as APTOS 2019 and EyePACS, achieving an accuracy of 95.2%, sensitivity of 94.8%, and specificity of 96.1%, outperforming state-of-the-art methods. The results demonstrate the framework's potential for scalable deployment in resource-constrained environments, facilitating timely interventions and reducing the burden on healthcare systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
