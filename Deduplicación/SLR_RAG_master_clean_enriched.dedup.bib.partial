@inproceedings{mirindi_advanced_2025,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for collaborative model training across distributed devices while preserving data privacy. However, the presence of malicious clients poses significant threats, as they can inject poisoned updates to manipulate the global model. Existing defenses often rely on client selection or robust aggregation, but they suffer from high communication overhead or reduced model accuracy. In this paper, we propose SecureFed, a novel framework that combines differential privacy with a lightweight anomaly detection mechanism to mitigate poisoning attacks in FL. Our approach uses a stateful aggregation protocol that dynamically adjusts privacy budgets based on detected anomalies, ensuring both security and efficiency. Extensive experiments on benchmark datasets demonstrate that SecureFed achieves up to 95% attack mitigation while maintaining comparable accuracy to vanilla FL, with only 20% increase in communication cost.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Mirindi},
 booktitle = {Proceedings of the 2025 {Computers}},
 doi = {10.1145/3716489.3728431},
 isbn = {979-8-4007-1497-9},
 keywords = {Artificial Intelligence},
 publisher = {Association for Computing Machinery},
 series = {{SIGMIS}},
 title = {Advanced evaluation of {BIM}},
 url = {https://doi.org/10.1145/3716489.3728431},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:19:43Z},
 year = {2025}
}

@article{miroyan_analyzing_2025,
 abstract = {Acoustic echoes are prevalent in indoor environments and can be leveraged to improve localization accuracy. However, existing methods that utilize echoes for localization often require dedicated hardware or prior knowledge of the room geometry, limiting their practicality. In this paper, we propose EchoTrace, a novel system that uses echoes to enhance indoor localization without additional hardware or room information. EchoTrace leverages the fact that echoes from nearby surfaces arrive earlier than those from distant ones, providing proximity cues that can refine position estimates. We model the echo arrival process using a ray-tracing approach and integrate it into a particle filter framework for robust tracking. Our evaluation in real-world indoor settings shows that EchoTrace improves localization accuracy by up to 40% compared to baseline methods that ignore echoes, while maintaining low computational overhead.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Miroyan},
