@inproceedings{rastogi_specialtyscribe_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in code generation, yet their trustworthiness remains underexplored. In this paper, we investigate how users perceive and trust code generated by LLMs compared to human-written code. Through a mixed-methods study involving 48 participants who reviewed and debugged code snippets from both sources, we uncover key factors influencing trust, including code quality, documentation, and perceived intent. Our findings reveal that users exhibit lower trust in LLM-generated code due to concerns over hallucinations, lack of context awareness, and stylistic inconsistencies, even when the code functions correctly. We contribute design implications for LLM-based code tools to foster greater user trust, such as integrating explainability features and hybrid human-AI validation mechanisms.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
