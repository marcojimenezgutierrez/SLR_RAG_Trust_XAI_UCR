@article{darji_enhancing_2024-1,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for collaborative model training across distributed devices while preserving data privacy. However, the deployment of FL on resource-constrained Internet of Things (IoT) devices poses significant challenges due to their limited computational, communication, and energy resources. This survey provides a comprehensive overview of FL techniques tailored for IoT environments. We first introduce the fundamentals of FL and discuss its applicability to IoT scenarios. Then, we categorize and analyze existing approaches to address the key challenges in FL for IoT, including communication efficiency, model compression, personalization, and security & privacy. Furthermore, we highlight open research issues and future directions in this rapidly evolving field.},
