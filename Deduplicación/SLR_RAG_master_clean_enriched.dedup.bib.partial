@article{perak_incorporating_2024,
 abstract = {We present a study on the identification of Swiss German dialects using pre-trained language models. Swiss German is a collection of dialects spoken in Switzerland, and identifying the specific dialect can be challenging due to their similarity and the lack of standardized orthography. We experiment with fine-tuning transformer-based models, such as XLM-RoBERTa and mBERT, on a dataset of Swiss German tweets labeled with dialect information. Our results show that fine-tuned models achieve high accuracy in distinguishing between major dialect regions, with XLM-RoBERTa outperforming others. We also analyze the impact of different pre-training strategies and discuss the potential for low-resource dialect identification tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Perak},
 journal = {… of the Eleventh Workshop on NLP …},
 keywords = {source: Google Scholar},
 note = {Publisher: aclanthology.org},
 title = {Incorporating dialect understanding into llm using rag and prompt engineering techniques for causal commonsense reasoning},
