}

@article{wan_facilitating_2025,
 abstract = {This paper explores the integration of artificial intelligence in sustainable manufacturing processes. We propose a framework that leverages machine learning algorithms to optimize energy consumption and reduce waste in production lines. Through case studies from the automotive industry, we demonstrate a 25% improvement in efficiency. The results highlight the potential for AI to drive green innovation in industrial settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
