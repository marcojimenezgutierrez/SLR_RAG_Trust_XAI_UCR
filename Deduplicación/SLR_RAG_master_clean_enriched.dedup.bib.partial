@inproceedings{mulakala_evaluation_2025,
 abstract = {This paper proposes a novel framework for secure multi-drone coordination in beyond-visual-line-of-sight (BVLOS) operations, addressing challenges in communication reliability and collision avoidance. We introduce a hybrid blockchain-edge computing architecture that ensures tamper-proof data sharing among unmanned aerial systems (UAS) while minimizing latency. The system integrates federated learning for real-time anomaly detection, enabling adaptive path planning in dynamic environments. Simulation results using a realistic urban scenario demonstrate a 25% reduction in communication overhead and a 40% improvement in mission success rate compared to existing centralized approaches. Experimental validation on a fleet of three quadcopters confirms the framework's robustness against jamming attacks and GPS spoofing.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
