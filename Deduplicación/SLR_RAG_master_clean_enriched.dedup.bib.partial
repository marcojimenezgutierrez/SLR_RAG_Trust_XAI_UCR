@inproceedings{zhao_enhancing_2024,
 abstract = {Dense semantic SLAM systems have achieved impressive results by directly optimizing neural radiance fields (NeRFs) with image evidence. However, they are limited to small-scale environments and require long training times. In this work, we propose a novel approach that combines neural implicit representations with a dense semantic SLAM pipeline to enable large-scale mapping and relocalization. Our method, Neural Implicit Dense Semantic SLAM (NIDS-SLAM), leverages a semantic NeRF as a global map representation, which is incrementally updated using a sliding-window bundle adjustment. To handle large environments, we introduce a map summarization technique that compresses the NeRF while preserving geometric and semantic details. We evaluate our system on challenging indoor and outdoor datasets, demonstrating superior performance in terms of accuracy, efficiency, and scalability compared to state-of-the-art methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhao},
