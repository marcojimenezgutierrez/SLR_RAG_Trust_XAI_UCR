 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:56:43Z},
 year = {2025}
}

@inproceedings{wynn-williams_can_2025,
 abstract = {Multi-modal large language models (MLLMs) have shown remarkable capabilities in understanding and generating multi-modal content. However, their performance in complex reasoning tasks, especially those requiring multi-hop reasoning across modalities, remains limited. In this paper, we introduce a novel framework, MultiHopChain, designed to enhance MLLMs' multi-hop reasoning abilities through a chain-of-thought (CoT) inspired approach tailored for multi-modal inputs. MultiHopChain decomposes complex queries into sequential reasoning steps, integrating visual and textual information at each hop. We evaluate our framework on a new benchmark, MultiHopQA, comprising diverse multi-modal question-answering tasks that demand multi-step inference. Experimental results demonstrate that MultiHopChain significantly outperforms existing MLLMs, achieving up to 15% improvement in accuracy on MultiHopQA. Our work highlights the potential of structured reasoning chains in advancing multi-modal AI capabilities.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wynn-Williams},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3696630.3728568},
