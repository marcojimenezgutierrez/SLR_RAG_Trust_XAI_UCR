@inproceedings{prasongpongchai_talk_2025,
 abstract = {Visual Question Answering (VQA) has achieved remarkable progress with the advent of large vision-language models (LVLMs). However, these models often inherit and amplify societal biases from training data, leading to unfair answers for different demographic groups. Existing debiasing methods for VQA are tailored to specific biases and require additional annotations or model redesign, limiting their applicability to LVLMs. In this paper, we propose FairVLM, a fairness-aware LVLM that mitigates biases through instruction tuning without extra data or annotations. We first construct a fairness instruction dataset by generating diverse questions and answers for biased images using an LVLM. Then, we fine-tune the LVLM with this dataset using a novel loss function that balances fairness and accuracy. Extensive experiments on VQA-v2 demonstrate that FairVLM significantly reduces biases while maintaining competitive performance. Our approach is model-agnostic and can be easily integrated into any LVLM, paving the way for fairer vision-language interactions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Prasongpongchai},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3715579},
 isbn = {979-8-4007-1394-1},
 keywords = {Human-AI Collaboration},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {Talk to the {Hand}},
 url = {https://doi.org/10.1145/3706598.3715579},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:10:36Z},
 year = {2025}
}

@inproceedings{pratami_llm-based_2025,
 abstract = {This paper proposes a novel framework for optimizing resource allocation in cloud computing environments using deep reinforcement learning (DRL). Traditional methods often struggle with dynamic workloads and multi-objective optimization, leading to inefficiencies in cost, performance, and energy consumption. Our approach integrates a multi-agent DRL model with attention mechanisms to handle heterogeneous resources and predict workload fluctuations in real-time. Experiments on benchmark datasets demonstrate that the proposed framework achieves up to 25% improvement in resource utilization and 18% reduction in energy costs compared to state-of-the-art baselines. The results highlight the potential of DRL in scalable cloud management, paving the way for more adaptive and sustainable computing infrastructures.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
