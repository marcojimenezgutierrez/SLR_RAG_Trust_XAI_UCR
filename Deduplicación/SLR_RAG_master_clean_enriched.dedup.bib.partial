@article{tang_hivegen_2025,
 abstract = {This paper proposes a novel approach to enhance adaptive learning systems using AI-driven personalization techniques. We introduce a framework that integrates multimodal data analysis to tailor educational content to individual learner profiles, improving engagement and retention rates. Experimental results from a pilot study with 200 participants demonstrate a 25% increase in learning outcomes compared to traditional methods. The system leverages machine learning algorithms for real-time feedback, addressing challenges in diverse educational environments. Future work will explore scalability in large-scale deployments.},
