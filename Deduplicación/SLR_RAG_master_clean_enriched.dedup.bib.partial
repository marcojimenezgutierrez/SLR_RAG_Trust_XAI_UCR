 isbn = {979-8-4007-0686-8},
 keywords = {embodied ai},
 note = {event-place: Melbourne VIC},
 pages = {6969--6978},
 publisher = {Association for Computing Machinery},
 series = {{MM}},
 title = {P-{RAG}},
 url = {https://doi.org/10.1145/3664647.3680661},
 x_enrich_source = {x-ai/grok-4-fast},
