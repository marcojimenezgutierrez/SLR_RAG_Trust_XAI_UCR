 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:38:10Z},
 year = {2025}
}

@inproceedings{abdallah_arabicaqa_2024,
 abstract = {Large language models (LLMs) have recently exploded in popularity, enabling a wide range of applications from creative writing to code generation. However, effectively utilizing LLMs often requires careful prompt engineering, which is typically a manual, iterative, and error-prone process. We introduce ChainForge, a visual toolkit that enables users to build, visualize, and test LLM prompt chains in a structured and reproducible way. ChainForge's node-based interface allows users to construct complex workflows by connecting prompts, LLM calls, and other components such as external tools or data sources. It supports real-time execution across multiple LLM providers, parameter sweeps for systematic exploration, and features for hypothesis testing like A/B comparisons. By making prompt engineering more accessible and transparent, ChainForge empowers both novices and experts to iterate faster, share workflows, and gain deeper insights into LLM behavior. We present the design and implementation of ChainForge, demonstrate its use in several domains, and report findings from a user study with 15 participants showing significant improvements in efficiency and understanding.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Abdallah},
 booktitle = {Proceedings of the 47th {International}},
 doi = {10.1145/3626772.3657889},
 isbn = {979-8-4007-0431-4},
 keywords = {arabic question answering},
 note = {event-place: Washington DC},
 pages = {2049--2059},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{ArabicaQA}},
 url = {https://doi.org/10.1145/3626772.3657889},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:16:09Z},
 year = {2024}
}

@article{abdelaziem_innovative_2024,
 abstract = {Summary The process of outlining a scope of work and evaluating technical bids in the oil and gas industry is commonly burdensome, labor-intensive, and susceptible to human bias. This paper introduces an AI-assistant chatbot based on the power of open-source large language models (LLMs), natural language processing (NLP), and data analytics, to aid in automating the entire workflow of technical tendering processes, facilitating an improved decision support system (DSS), and mitigating potential subjectivity. The workflow starts with loading documents in the format of scanned PDF files. Firstly, data was extracted using optical character recognition (OCR), and text mining techniques. Secondly, Langchain was implemented to optimally split the document into chunks with adequate overlapping. Thirdly, embeddings were created using sentence transformers, and a vector store was constructed. After that, LlaMa model, was optimized and employed to query the vector store efficiently. Then, retrieval augmented generative (RAG) query engines were used to retrieve the matching documents and generate the final answer. Finally, a chat memory buffer was incorporated to maintain context and initialize a chatbot. Implementing LLM in the tendering process has proven promising for reviewing and ranking the technical data of the submitted bids based on pre-defined criteria. However, it was shown that extracting tabulated data effectively from scanned documents is challenging. Consequently, it was essential to pre-process documents and extract tables into structured databases before querying them. In addition, model augmentation was employed to avoid hallucination and enhance the model reasoning and capability of identifying pass and fail criteria, nonetheless, human feedback is required to assess satisfying performance. Recall-Oriented Understudy for Gisting Evaluation (ROUGE) was found valuable to expedite the comparison between the submitted data in technical tables and the detailed data sheets. Furthermore, LLM was found effective in accelerating the process of market survey comparison, by retrieving and comparing prices and conditions of different documents. Moreover, supervised fine-tuning (SFT) was implemented to improve the model's capacity to compare clauses of the scope of work along with terms and conditions across different contracts, in order to discern major inherent differences and reduce potential bias in the future. This enhancement was configured through quantized low-rank adaptation (QLoRA) and parameter-efficient fine-tuning (PEFT). This paper presented a novel approach, which integrated LLMs into procurement information development systems, automating multiple tasks in the tendering process in the oil and gas upstream industry. This is the first time that such an application has been applied to the oil industry, which shall provide a foundation for future research.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 2},
 author = {Abdelaziem},
 doi = {10.2118/223359-MS},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 title = {Innovative {Approach}},
 url = {https://doi.org/10.2118/223359-ms},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T09:06:18Z},
 year = {2024}
}

@inproceedings{abdenebaoui_value-driven_2025,
 abstract = {Federated learning enables collaborative model training across distributed devices while keeping data localized, enhancing privacy. However, real-world deployments face challenges from data heterogeneity, communication costs, and privacy leakage risks. This paper introduces FedNova, a novel federated optimization algorithm that normalizes local update steps to mitigate divergence caused by heterogeneous data distributions. By aligning the progress of local models with the global objective, FedNova improves convergence speed and stability without requiring additional communication rounds or privacy compromises. Extensive experiments on benchmark datasets demonstrate that FedNova outperforms state-of-the-art methods in non-IID settings, achieving up to 30% faster convergence while maintaining comparable accuracy. Our approach is simple to implement and compatible with existing federated frameworks, paving the way for more robust privacy-preserving machine learning in heterogeneous environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Abdenebaoui},
 booktitle = {Proceedings of the 2025 {ACM}},
 doi = {10.1145/3715275.3732103},
 isbn = {979-8-4007-1482-5},
 keywords = {AI in public administration},
 pages = {1554--1564},
 publisher = {Association for Computing Machinery},
 series = {{FAccT}},
 title = {Value-{Driven}},
 url = {https://doi.org/10.1145/3715275.3732103},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:20:09Z},
 year = {2025}
}

@inproceedings{abdullah_p4omp_2025,
 abstract = {This paper presents a novel approach to accelerating graph neural networks (GNNs) on high-performance computing (HPC) systems using hybrid CPU-GPU architectures. We propose a distributed framework that optimizes data partitioning and communication overhead for large-scale graph processing. Experimental results on benchmark datasets demonstrate up to 5x speedup compared to state-of-the-art methods, with detailed analysis of scalability and energy efficiency.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Abdullah},
