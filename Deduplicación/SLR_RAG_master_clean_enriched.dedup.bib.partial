}

@inproceedings{liu_transrag_2025,
 abstract = {This paper addresses the issue of finite-time stabilization for a class of uncertain nonlinear systems with time-varying delays and external disturbances. A novel adaptive fuzzy neural network (AFNN) is employed to approximate the unknown nonlinear functions. By utilizing the backstepping technique and Lyapunov stability theory, a finite-time adaptive fuzzy controller is designed to ensure that all signals in the closed-loop system remain bounded and the tracking error converges to a small neighborhood of the origin in finite time. The proposed method does not require the precise knowledge of the system dynamics and handles the time-varying delays effectively. Simulation results illustrate the effectiveness and superiority of the proposed control scheme.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Liu},
 booktitle = {2025 37th {Chinese}},
 doi = {10.1109/CCDC65474.2025.11090835},
