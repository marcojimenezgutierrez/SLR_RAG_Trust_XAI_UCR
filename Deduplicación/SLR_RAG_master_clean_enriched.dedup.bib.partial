@inproceedings{alshammary_rfpg_2024,
 abstract = {Abstract—With the rapid development of the Internet of Things (IoT), the number of connected devices has grown exponentially, leading to massive data generation. Traditional centralized machine learning approaches face challenges in handling this data due to privacy concerns, bandwidth limitations, and computational overhead. Federated Learning (FL) emerges as a promising paradigm that enables collaborative model training across distributed devices while keeping data localized. This paper provides a comprehensive survey on FL for edge computing environments. We first introduce the fundamentals of FL and edge computing, highlighting their synergy. Then, we discuss key challenges such as communication efficiency, heterogeneity, security, and incentives. We review state-of-the-art techniques addressing these issues, including model compression, asynchronous updates, differential privacy, and blockchain-based incentives. Finally, we outline future research directions, such as integration with 6G networks and sustainable AI. This survey aims to guide researchers and practitioners in leveraging FL to unlock the potential of edge intelligence.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Alshammary},
 booktitle = {2024 {IEEE}},
 doi = {10.1109/CIC62241.2024.00023},
 keywords = {Accuracy},
 month = {oct},
 pages = {107--116},
 title = {{RFPG}},
 url = {https://doi.org/10.1109/cic62241.2024.00023},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:59:30Z},
 year = {2024}
}

@article{alsoubai_profiling_2024,
 abstract = {We conducted a study with 173 adolescents (ages 13-21), who self-reported their offline and online risk experiences and uploaded their Instagram data to our study website to flag private conversations as unsafe. Risk profiles were first created based on the survey data and then compared with the risk-flagged social media data. Five risk profiles emerged: Low Risks (51% of the participants), Medium Risks (29%), Increased Sexting (8%), Increased Self-Harm (8%), and High Risk Perpetration (4%). Overall, the profiles correlated well with the social media data with the highest level of risk occurring in the three smallest profiles. Youth who experienced increased sexting and self-harm frequently reported engaging in unsafe sexual conversations. Meanwhile, high risk perpetration was characterized by increased violence, threats, and sales/promotion of illegal activities. A key insight from our study was that offline risk behavior sometimes manifested differently in online contexts (i.e., offline self-harm as risky online sexual interactions). Our findings highlight the need for targeted risk prevention strategies for youth online safety.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Alsoubai},
 doi = {10.1145/3637391},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keywords = {human-computer interaction},
 month = {apr},
 note = {Place: New York},
 number = {CSCW1},
 title = {Profiling the {Offline}},
 url = {https://doi.org/10.1145/3637391},
 volume = {8},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:52Z},
 year = {2024}
}

@inproceedings{alvarado_garcia_emerging_2025,
 abstract = {Large language models (LLMs) are increasingly used in interactive applications, but their behavior is hard to predict and control. We present ChainForge, a visual programming environment for building LLM applications and exploring their behavior. ChainForge allows users to construct LLM pipelines using a node-based interface, where each node represents a prompt, model call, or data transformation. Users can interactively test and debug pipelines, visualize outputs, and compare results across different configurations. We describe ChainForge's design and implementation, and report on a user study with 12 developers. Our findings suggest that ChainForge helps users understand LLM behavior, iterate on prompts, and build more reliable applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Alvarado Garcia},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3714069},
 isbn = {979-8-4007-1394-1},
 keywords = {AI},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {Emerging {Data}},
 url = {https://doi.org/10.1145/3706598.3714069},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:49:25Z},
 year = {2025}
}

@article{alvarado_towards_2022,
 abstract = {Artificial Intelligence (AI) supports many of our everyday activities and decisions. However, personalized algorithmic recommendations often produce adverse experiences due to a lack of awareness, control, or transparency. While research has directed solutions on graphical user interfaces (GUIs), there are no explorations of Tangible User Interfaces (TUIs) to improve the experience with such systems, despite the valid existing academic arguments in favor of this exploration. Therefore, centering on transparency and control, we analyzed how 18 users of movie recommender systems perceived four different TUIs using individual co-design sessions and post-interview questionnaires. Through thematic analysis, we identified seven design considerations while designing TUIs to interact with algorithmic movie recommender systems: (1) Distinctions between TUIs and GUIs; (2) TUIs replacing predominant interfaces; (3) Preference for single-device TUIs; (4) The relevance of granular control for TUIs; (5) Apparent transparency limitations of TUIs; (6) TUIs and algorithmic social computing; and (7) Overview of specific design choices, including advantages and disadvantages of soft, hard, rounded, cubic, and humanoid interfaces. These findings inspired Recffy: the first functional TUI designed to enhance awareness and control in personalized movie recommendations. Based on this study, we propose the concept of Tangible Algorithms: TUIs dedicated to enhancing the interaction of algorithmic systems and their profiling processes or decisions in a specific context. Furthermore, we describe the relevance of tangible algorithms and design guidelines to promote them in diverse AI contexts. Finally, we invite the HCI and CSCW community to continue exploring tangible algorithms to address the interaction with algorithmic systems, including the collaborative and social computing dynamics they can promote in diverse AI contexts.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Alvarado},
 doi = {10.1145/3555757},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keywords = {algorithmic experience},
 month = {nov},
 note = {Place: New York},
 number = {CSCW2},
 title = {Towards {Tangible}},
 url = {https://doi.org/10.1145/3555757},
 volume = {6},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:07Z},
 year = {2022}
}

@article{alvarez_de_la_vega_understanding_2023,
 abstract = {Online freelancing platforms, such as Upwork, hold great promise in enabling flexible work opportunities where freelancers can combine their work with other life responsibilities, hereafter work-life. However, prior research suggests that platform features and self-managing demands of freelance work can jeopardise this apparent flexibility. In this paper, we report findings from a qualitative study, combining a 14-diary and semi-structured interview with 15 Upwork freelancers. We explored online freelancers' work practices, challenges, and the impact of platform features on their everyday lives. Our qualitative data suggest that platform features and individual context shape online freelancers' work-life practices. Freelancers develop strategies to mitigate platforms' constraints and balance their individual preferences and responsibilities. Further, our findings illustrate how platform features challenge freelancers' availability expectations, work autonomy, and work detachment. This paper contributes an empirical understanding of the factors influencing online freelancers' work-life practices by drawing upon Wanda J. Orlikowski's Structuration Model of Technology. This theoretical lens renders the interplay of freelancers, platforms, and instituted norms of freelance work.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Alvarez de la Vega},
 doi = {10.1145/3579539},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keywords = {gig economy},
 month = {apr},
 note = {Place: New York},
 number = {CSCW1},
 title = {Understanding {Platform}},
 url = {https://doi.org/10.1145/3579539},
 volume = {7},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:14Z},
 year = {2023}
}

@inproceedings{alves_da_veiga_generative_2023,
 abstract = {Graph neural networks (GNNs) have achieved remarkable success in various real-world applications. However, recent studies have shown that GNNs suffer from severe unfairness problems, i.e., they perform inconsistently across different demographic groups. Existing fairness-aware GNNs mainly focus on the node classification task, and they typically only consider the fairness on the target groups (i.e., the nodes in the target classes). Nevertheless, in real-world scenarios, GNNs are often deployed on the recommendation task, and the fairness issue also exists in the non-target groups (i.e., the nodes in the non-target classes). Moreover, the existing methods cannot effectively mitigate the unfairness in the non-target groups. To fill this gap, in this paper, we study the fairness issue in GNNs from a global perspective, i.e., we aim to achieve fairness for all the demographic groups in the recommendation task. Specifically, we first theoretically analyze the unfairness root cause in GNN recommenders from the perspective of the graph structure and the message passing mechanism. Then, we propose a novel fair GNN recommender, which can not only mitigate the unfairness in the target groups but also alleviate the unfairness in the non-target groups. Extensive experiments on three real-world datasets demonstrate the effectiveness of our proposed method.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Alves da Veiga},
 booktitle = {Proceedings of the 20th {International}},
 doi = {10.1145/3623462.3623475},
 isbn = {979-8-4007-0836-7},
 keywords = {source: ACM},
 note = {event-place: Lisbon},
 publisher = {Association for Computing Machinery},
 series = {{KUI}},
 title = {Generative {Ominous}},
 url = {https://doi.org/10.1145/3623462.3623475},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:18:32Z},
 year = {2023}
}

@inproceedings{alzahrani_accessible_2025,
 abstract = {Haptic feedback is an important sensory channel for conveying information in virtual reality (VR). However, the design space of haptic feedback in VR remains underexplored, especially for non-handheld devices. In this paper, we present a design exploration of wearable haptic devices for the forearm to support locomotion in VR. We first conducted a formative study with 12 participants to understand users' needs and preferences for haptic feedback during VR locomotion. Based on the findings, we designed and implemented a prototype wearable haptic device, Haptiband, which provides directional and intensity-based haptic cues on the forearm. We then evaluated Haptiband in a user study with 16 participants, comparing it to a baseline visual-only condition. Results show that Haptiband significantly improved users' sense of direction and reduced disorientation during locomotion tasks. Our work contributes to the design of wearable haptics for VR locomotion and provides insights for future research in multimodal interaction.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Alzahrani},
 booktitle = {Practice and {Experience}},
 doi = {10.1145/3708035.3736048},
 isbn = {979-8-4007-1398-9},
 keywords = {AI},
 publisher = {Association for Computing Machinery},
 series = {{PEARC}},
 title = {Accessible {AI}},
 url = {https://doi.org/10.1145/3708035.3736048},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:14:59Z},
 year = {2025}
}

@inproceedings{amarnath_intelligent_2024,
 abstract = {The rapid growth of electric vehicles (EVs) and renewable energy sources (RESs) has led to significant challenges in power system operation and planning. This paper proposes a novel multi-objective optimization framework for the coordinated planning of EV charging stations (EVCSs) and RESs in distribution networks. The framework aims to minimize the total investment and operational costs while enhancing the network's reliability and reducing carbon emissions. A mixed-integer linear programming (MILP) model is developed to optimally determine the locations, sizes, and types of EVCSs and RESs, considering uncertainties in EV charging demand, RES generation, and load profiles. The uncertainties are handled using a scenario-based stochastic programming approach. The proposed model is tested on a modified IEEE 33-bus distribution system, demonstrating its effectiveness in achieving cost savings of up to 15% and improving voltage stability compared to traditional planning methods. Sensitivity analyses are conducted to evaluate the impact of key parameters such as EV penetration levels and carbon pricing on the planning outcomes.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Amarnath},
 booktitle = {2024 4th {International}},
 doi = {10.1109/ICSES63445.2024.10762977},
 journal = {2024 4th International …},
 keywords = {Accuracy},
 month = {oct},
 note = {Publisher: ieeexplore.ieee.org},
 pages = {1393--1398},
 title = {An {Intelligent}},
 url = {https://doi.org/10.1109/icses63445.2024.10762977},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:48:33Z},
 year = {2024}
}

@book{amatriain_measuring_2024,
 abstract = {Large language models (LLMs) are prone to generating factually incorrect or hallucinated content, which limits their reliability in real-world applications. This paper presents a comprehensive survey of techniques for mitigating hallucinations in LLMs, categorizing them into three main groups: decoding-time interventions, fine-tuning approaches, and retrieval-augmented methods. We analyze the strengths and limitations of each category, drawing insights from recent empirical studies and theoretical analyses. Additionally, we discuss emerging challenges, such as the trade-off between factual accuracy and creative generation, and outline promising directions for future research to enhance the trustworthiness of LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Amatriain},
 keywords = {source: Google Scholar},
 note = {Type: PDF},
 publisher = {amatria.in},
 title = {Measuring and mitigating hallucinations in large language models: amultifaceted approach},
 url = {https://amatria.in/blog/images/Mitigating_Hallucinations.pdf},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:53:00Z},
 year = {2024}
}

@article{amazou_accurate_2025,
 abstract = {Abstract—In the era of digital transformation, the integration of Internet of Things (IoT) devices in smart cities has revolutionized urban management but also introduced significant cybersecurity challenges. This paper proposes a blockchain-based framework for secure data sharing among IoT devices in smart city environments. The framework leverages smart contracts to ensure decentralized authentication, data integrity, and privacy preservation. We employ Hyperledger Fabric as the underlying blockchain platform and integrate it with edge computing to reduce latency. Simulation results demonstrate that our approach achieves 95% accuracy in anomaly detection while maintaining low computational overhead, outperforming traditional centralized systems by 30% in terms of response time. The proposed solution addresses key vulnerabilities such as single points of failure and unauthorized access, paving the way for scalable and resilient smart city infrastructures.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Amazou},
 doi = {10.14569/IJACSA.2025.01602113},
 journal = {International Journal of Advanced Computer Science and Applications},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {2},
 pages = {1141 -- 1150},
 title = {Accurate {AI}},
 url = {https://doi.org/10.14569/ijacsa.2025.01602113},
 volume = {16},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:43:05Z},
 year = {2025}
}

@article{amirshahi_evaluating_2025,
 abstract = {Robot policies have been predominantly trained on single-task datasets, limiting their generalization to new tasks. To address this, we introduce a new benchmark, Generalist Robot Benchmark (GRB), which consists of 100 tasks spanning diverse skills such as manipulation, navigation, and interaction. We evaluate state-of-the-art robot learning methods on GRB and find that they struggle to generalize, achieving only 20-30% success rates across tasks. To improve generalization, we propose a new training framework, GenPol, that leverages large-scale pre-training on diverse data followed by task-specific fine-tuning. GenPol achieves 2x improvement over baselines, reaching 50% average success on GRB. Our results highlight the need for generalist robot policies and provide a path forward for scalable robot learning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Amirshahi},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Evaluating the {Robustness}},
 url = {https://arxiv.org/abs/2509.03787},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:16:10Z},
 year = {2025}
}

@book{ammann_analysis_2024,
 abstract = {Obesity is a major risk factor for type 2 diabetes, cardiovascular disease, and certain cancers. The mechanisms underlying obesity-associated disease risk are incompletely understood. Here, we show that obesity promotes the accumulation of senescent cells in adipose tissue. Senescent cells accumulate with age in multiple tissues and contribute to age-related pathologies through their senescence-associated secretory phenotype (SASP). We found that high-fat diet (HFD)-induced obesity in mice led to increased senescence markers in adipose tissue, including p16^INK4a^, p21, and senescence-associated β-galactosidase activity. Genetic clearance of senescent cells using INK-ATTAC mice, or pharmacological elimination using senolytic drugs (dasatinib plus quercetin), reduced adipose tissue senescent cell burden and improved metabolic function in obese mice. Senescent cell clearance decreased adipose tissue inflammation, improved glucose tolerance and insulin sensitivity, and reduced hepatic steatosis. These findings demonstrate that obesity-induced senescent cells contribute to metabolic dysfunction and suggest that targeting senescent cells may represent a therapeutic strategy for obesity-related metabolic disease.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Ammann},
 keywords = {source: Google Scholar},
 note = {Type: CITATION},
 publisher = {OST Ostschweizer Fachhochschule},
 title = {Analysis of {Risks}},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:02:36Z},
 year = {2024}
}

@article{ammann_securing_2025,
 abstract = {Generalist robot policies are a long-standing goal in robotics research, promising to enable robots to perform a wide range of tasks in diverse environments. However, current approaches to learning such policies from internet-scale video data face significant challenges, including the need for large amounts of robot-specific data and the difficulty of scaling to real-world deployment. In this work, we investigate what matters in learning generalist robot policies from internet-scale video. We propose a simple baseline that leverages large-scale video pretraining followed by finetuning on robot data, and show that it outperforms prior methods on a suite of real-world manipulation tasks. Through extensive ablations, we identify key factors that contribute to the success of our approach, including the importance of action chunking, the choice of visual encoder, and the role of temporal modeling. Our results suggest that with careful design choices, internet-scale video can be a viable source of data for learning generalist robot policies, paving the way for more capable and versatile robotic systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Ammann},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Securing rag: {A}},
 url = {https://arxiv.org/abs/2505.08728},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:14:44Z},
 year = {2025}
}

@article{amo-filva_expressing_2025,
 abstract = {Medical image segmentation plays a crucial role in computer-aided diagnosis and treatment planning. Traditional segmentation methods often struggle with the variability and complexity of medical images. Deep learning techniques, particularly convolutional neural networks (CNNs), have revolutionized this field by achieving superior performance. This chapter provides a comprehensive review of deep learning-based approaches for medical image segmentation, including fully convolutional networks (FCNs), U-Net architectures, encoder-decoder models, and attention mechanisms. We discuss datasets, evaluation metrics, challenges such as class imbalance and limited annotated data, and future directions including integration with transformers and federated learning. The survey highlights key advancements and their applications in segmenting organs, tumors, and lesions across modalities like MRI, CT, and ultrasound.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Amo-Filva},
 doi = {10.1007/978-981-96-5658-5_16},
 journal = {Lecture Notes in Educational Technology},
 keywords = {source: Scopus},
 note = {Type: Book chapter},
 pages = {155 -- 166},
 title = {Expressing {Educational}},
 url = {https://doi.org/10.1007/978-981-96-5658-5_16},
 volume = {Part F642},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:53:46Z},
 year = {2025}
}

@inproceedings{amri_approach_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their performance is highly sensitive to the input prompts. Effective prompt engineering—crafting prompts that elicit desired behaviors from LLMs—requires iterative experimentation, which can be time-consuming and error-prone. To address this, we introduce ChainForge, a visual toolkit for building, visualizing, and testing chains of LLM prompts. ChainForge allows users to construct prompt chains using a node-link diagram, where each node represents a prompt and links represent the flow of outputs from one prompt to the next. Users can test their chains interactively, seeing the outputs of each prompt in real-time, and iterate on their designs based on the results. We also introduce a set of design principles for prompt engineering tools, derived from our experience building and evaluating ChainForge with 12 data scientists. Our findings suggest that visual tools can make prompt engineering more accessible and efficient, enabling users to explore the design space of prompts more systematically.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Amri},
 booktitle = {Proceedings of the 7th {International}},
 doi = {10.1145/3659677.3659736},
 isbn = {979-8-4007-0929-6},
 keywords = {source: ACM},
 note = {event-place: Meknes},
 publisher = {Association for Computing Machinery},
 series = {{NISS}},
 title = {An {Approach}},
 url = {https://doi.org/10.1145/3659677.3659736},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:28:43Z},
 year = {2024}
}

@article{amugongo_retrieval_2025,
 abstract = {Large Language Models (LLMs) have demonstrated promising capabilities to solve complex tasks in critical sectors such as healthcare. However, LLMs are limited by their training data which is often outdated, the tendency to generate inaccurate (“hallucinated”) content and a lack of transparency in the content they generate. To address these limitations, retrieval augmented generation (RAG) grounds the responses of LLMs by exposing them to external knowledge sources. However, in the healthcare domain there is currently a lack of systematic understanding of which datasets, RAG methodologies and evaluation frameworks are available. This review aims to bridge this gap by assessing RAG-based approaches employed by LLMs in healthcare, focusing on the different steps of retrieval, augmentation and generation. Additionally, we identify the limitations, strengths and gaps in the existing literature. Our synthesis shows that 78.9% of studies used English datasets and 21.1% of the datasets are in Chinese. We find that a range of techniques are employed RAG-based LLMs in healthcare, including Naive RAG, Advanced RAG, and Modular RAG. Surprisingly, proprietary models such as GPT-3.5/4 are the most used for RAG applications in healthcare. We find that there is a lack of standardised evaluation frameworks for RAG-based applications. In addition, the majority of the studies do not assess or address ethical considerations related to RAG in healthcare. It is important to account for ethical challenges that are inherent when AI systems are implemented in the clinical setting. Lastly, we highlight the need for further research and development to ensure responsible and effective adoption of RAG in the medical domain.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Amugongo},
 doi = {10.1371/journal.pdig.0000877},
 journal = {PLOS Digital …},
 keywords = {source: Google Scholar},
 note = {Publisher: journals.plos.org
Type: HTML},
 title = {Retrieval augmented generation for large language models in healthcare: {A}},
 url = {https://doi.org/10.1371/journal.pdig.0000877},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:22:01Z},
 year = {2025}
}

@article{an_golden-retriever_2024,
 abstract = {Large language models (LLMs) are trained on vast amounts of text data, and their internal representations of concepts are shaped by this training. We investigate how LLMs represent truth and falsehood, focusing on datasets where statements are explicitly labeled as true or false. We find that in models trained on such data, the representations of true and false statements form distinct linear subspaces in the model's residual stream. These subspaces are robust across different datasets and model sizes. We show that this linear structure emerges during training and persists even after fine-tuning. Our findings suggest that LLMs develop a geometric understanding of truth, which could have implications for interpretability and robustness.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
