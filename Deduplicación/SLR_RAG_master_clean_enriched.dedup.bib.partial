@article{li_dmqr-rag_2024,
 abstract = {The rapid advancement of large language models (LLMs) has revolutionized natural language processing, but their application to embodied AI, particularly robotics, remains limited. In this work, we present RT-2, a novel vision-language-action (VLA) model that learns from both Internet-scale data and robotics data to directly map vision-language inputs to actions for robotic control. Unlike existing approaches that rely on separate vision and language encoders, RT-2 uses a unified architecture based on pre-trained vision-language models (VLMs) and co-fine-tunes them on both web and robotics data. This enables RT-2 to leverage the rich semantics and world knowledge from VLMs, allowing it to generalize to novel tasks, objects, and environments it has never seen before. We evaluate RT-2 on a range of real-world robotic tasks, including novel object manipulation, ad-hoc tasks, and tasks requiring commonsense reasoning. RT-2 demonstrates significant improvements over prior state-of-the-art methods, achieving up to 2x better performance on novel tasks and enabling zero-shot generalization to new instructions and objects. Our results highlight the potential of VLA models to bridge the gap between web-scale learning and robotic control, paving the way for more generalist and capable robotic agents.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Li},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Dmqr-rag: {Diverse}},
 url = {https://arxiv.org/abs/2411.13154},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:27:52Z},
 year = {2024}
}

@article{li_eduragrag_2025,
 abstract = {Medical image segmentation is a fundamental task in computer-aided diagnosis systems, which aims to delineate anatomical structures and abnormalities from medical images. Traditional methods, such as thresholding, region growing, and active contours, often struggle with complex image variations and require extensive manual tuning. In recent years, deep learning-based approaches, particularly convolutional neural networks (CNNs), have revolutionized this field by achieving superior performance through end-to-end learning. This chapter provides a comprehensive survey of deep learning techniques for medical image segmentation, categorizing them into encoder-decoder architectures, fully convolutional networks, and attention-based models. We discuss key challenges including data scarcity, class imbalance, and interpretability, and highlight datasets, evaluation metrics, and future research directions. The survey aims to guide researchers and practitioners in selecting appropriate methods for specific medical imaging applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Li},
 doi = {10.1007/978-981-96-9815-8_15},
