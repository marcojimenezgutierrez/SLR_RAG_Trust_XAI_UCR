}

@inproceedings{hedi_personalized_2025,
 abstract = {Alzheimer's disease (AD) is a progressive neurodegenerative disorder and the most common cause of dementia. The neuropathological hallmarks of AD are extracellular amyloid-β (Aβ) plaques and intracellular neurofibrillary tangles composed of hyperphosphorylated tau protein. Microglia, the resident immune cells of the central nervous system, play a crucial role in AD pathogenesis. In the healthy brain, microglia survey their environment and maintain homeostasis. However, in AD, microglia become activated and can adopt different phenotypes ranging from neuroprotective to neurotoxic. Recent genetic studies have identified several AD risk genes that are highly or exclusively expressed in microglia, highlighting the importance of these cells in disease development. This review discusses the role of microglia in AD, focusing on their response to Aβ and tau pathology, the impact of AD risk genes on microglial function, and the potential of targeting microglia for therapeutic intervention. We also discuss recent advances in understanding microglial heterogeneity and the application of novel technologies such as single-cell RNA sequencing to study microglia in AD. Understanding the complex role of microglia in AD pathogenesis may provide new opportunities for developing disease-modifying therapies.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 address = {Richland},
 and listening skills. these limitations are further compounded by the challenges of low-resource languages like luxembourgish. this demonstration https://www.youtube.com/watch?v = {5bxVHsuK-Hs presents a Multi-Agent System (MAS) powered by Large Language Models (LLMs)},
 author = {Hedi},
 booktitle = {Proceedings of the 24th {International}},
 isbn = {979-8-4007-1426-9},
 keywords = {language learning},
 note = {event-place: Detroit},
 pages = {3032--3034},
 publisher = {International Foundation for Autonomous Agents and Multiagent Systems},
 series = {{AAMAS}},
 title = {Personalized {Language}},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:20:03Z},
 year = {2025}
}

@inproceedings{hegde_self_2025,
 abstract = {Fairness in machine learning has gained significant attention in recent years, with a particular focus on addressing biases in visual recognition tasks. However, existing debiasing methods often fall short in achieving comprehensive fairness across multiple protected attributes and downstream tasks. In this paper, we propose a novel framework for debiasing vision-language models (VLMs) that leverages biased prompts to identify and mitigate biases effectively. Our approach involves generating biased prompts tailored to specific protected attributes, using them to probe the model's internal representations, and then applying targeted interventions to reduce bias while preserving overall performance. We evaluate our method on standard benchmarks for facial recognition and attribute classification, demonstrating substantial improvements in fairness metrics such as demographic parity and equalized odds, with minimal impact on accuracy. Our results highlight the potential of prompt-based debiasing as a lightweight and interpretable alternative to traditional fine-tuning techniques.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Hegde},
 booktitle = {Proceedings of the 4th {International}},
