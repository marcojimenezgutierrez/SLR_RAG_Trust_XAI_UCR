@article{priola_addressing_2024,
 abstract = {Developing generalist robot policies that can perform a wide range of tasks in diverse environments is a key challenge in robotics. While large-scale data and compute have enabled impressive results in simulation, transferring these policies to real-world robots remains difficult due to the sim-to-real gap. In this work, we study what matters in building generalist robot policies that can transfer to the real world. We introduce a new benchmark, RoboArena, consisting of 100 diverse manipulation tasks spanning various objects, environments, and skills. Using this benchmark, we evaluate a range of design choices for building generalist policies, including data collection strategies, model architectures, and training procedures. Our findings reveal that: (1) data diversity and quality are crucial, with a focus on collecting data for edge cases improving generalization; (2) transformer-based architectures with appropriate scaling outperform simpler models; and (3) careful curriculum learning and fine-tuning strategies enhance performance. We demonstrate that our approach enables a single policy to achieve strong performance across all tasks in RoboArena, including novel tasks not seen during training. Finally, we deploy our policy on a real robot and show successful transfer to real-world manipulation tasks. Our results provide practical guidance for developing effective and efficient generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Priola},
 journal = {arXiv preprint arXiv:2412.04235},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Addressing hallucinations with rag and nmiss in italian healthcare llm chatbots},
 url = {https://arxiv.org/abs/2412.04235},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:01:49Z},
 year = {2024}
}

@article{procko_graph_2024,
 abstract = {This paper presents a comprehensive survey on federated learning (FL) techniques tailored for resource-constrained Internet of Things (IoT) devices. We first introduce the fundamentals of FL and its advantages in preserving data privacy while enabling collaborative model training across distributed devices. Then, we categorize existing FL approaches for IoT environments based on key challenges such as communication efficiency, computational limitations, heterogeneity, and security. For each category, we review state-of-the-art methods, including model compression, asynchronous updates, and differential privacy mechanisms. We also discuss real-world applications in smart cities, healthcare, and industrial IoT. Finally, we highlight open research issues and future directions, emphasizing the need for lightweight FL frameworks that balance accuracy, efficiency, and robustness in dynamic IoT networks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Procko},
 journal = {2024 Conference on AI},
 keywords = {source: Google Scholar},
 note = {Publisher: ieeexplore.ieee.org},
 title = {Graph retrieval-augmented generation for large language models: {A}},
 url = {https://ieeexplore.ieee.org/abstract/document/10771030/},
