@inproceedings{he_low-cost_2025,
 abstract = {Interactive data visualization tools empower non-experts to explore and communicate insights from data. However, creating effective visualizations often requires programming skills, limiting accessibility. Visual programming environments aim to bridge this gap by providing graphical interfaces for constructing visualizations. Despite their promise, these tools often fall short in supporting the full spectrum of visualization design tasks, from data preparation to interactive exploration. In this paper, we explore the design space of visual programming for interactive data visualization through a systematic analysis of existing tools and a series of design studies. We identify key challenges in expressiveness, usability, and scalability, and propose a framework for future visual programming systems that better support iterative design and collaboration. Our findings inform the development of more intuitive and powerful tools for data visualization.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
