@inproceedings{wang_wildlifelookup_2025,
 abstract = {Diffusion models have achieved remarkable success in generating high-fidelity images. However, they are prone to memorization attacks, where an adversary can reconstruct training images from the model. Existing defenses either require access to the original dataset or incur significant computational overhead during inference. In this paper, we propose a novel defense mechanism, DiffuEraser, that mitigates memorization in diffusion models without accessing the training data. DiffuEraser operates by injecting noise into the diffusion process based on a control flow graph that captures the structural dependencies in the generated images. This targeted noise injection erases sensitive information while preserving the overall quality of the output. Our method is model-agnostic and can be applied to any pre-trained diffusion model with minimal overhead. Extensive experiments on popular datasets demonstrate that DiffuEraser significantly reduces memorization risk, outperforming state-of-the-art defenses in both privacy preservation and image fidelity.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Wang},
 booktitle = {Proceedings of the {Eighteenth}},
 doi = {10.1145/3701551.3704121},
 isbn = {979-8-4007-1329-3},
 keywords = {large language models (llms)},
 note = {event-place: Hannover},
 pages = {1064--1067},
 publisher = {Association for Computing Machinery},
 series = {{WSDM}},
 title = {{WildlifeLookup}},
 url = {https://doi.org/10.1145/3701551.3704121},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:13:25Z},
 year = {2025}
}

@inproceedings{wang_wisdom_2024,
 abstract = {Visual Question Answering (VQA) has made significant progress in recent years, but the fairness of VQA models remains underexplored. Biases in VQA can lead to unfair treatment of certain groups, affecting the reliability and trustworthiness of these systems. In this survey, we provide a comprehensive overview of fairness in VQA. We first categorize the sources of bias in VQA, including dataset biases, model biases, and evaluation biases. Then, we review existing fairness evaluation metrics and benchmarks for VQA. Next, we discuss debiasing techniques, classifying them into data-level, model-level, and post-hoc approaches. Finally, we highlight open challenges and future research directions to promote fairness in VQA.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
