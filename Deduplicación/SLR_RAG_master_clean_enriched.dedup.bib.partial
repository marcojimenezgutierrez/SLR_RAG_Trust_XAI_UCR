}

@inproceedings{yen_memolet_2024,
 abstract = {Fairness in vision-language models (VLMs) has gained increasing attention recently. However, most existing works focus on evaluating VLMs' fairness, while the bias mitigation in VLMs remains under-explored. In this paper, we conduct a systematic study on bias mitigation in VLMs. Specifically, we first identify the key challenges in mitigating biases in VLMs, including the entangled bias in visual and language modalities, the lack of diverse training data, and the difficulty in measuring fairness. To address these challenges, we propose a novel framework, FairVLM, which disentangles the bias in visual and language modalities and mitigates them separately. FairVLM consists of three main components: (1) a bias disentanglement module that separates the bias-related and bias-unrelated features in visual and language modalities; (2) a fairness-aware training strategy that leverages diverse training data to mitigate the bias; and (3) a fairness evaluation metric that measures the fairness of VLMs from multiple perspectives. Extensive experiments on various VLMs demonstrate the effectiveness of FairVLM in mitigating biases while maintaining the performance of VLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 and generation refinement. we examine the system’s usefulness with an n = {12 within-subject study and provide design implications for future systems that support user-AI conversational memory reusing.}},
 author = {Yen},
 booktitle = {Proceedings of the 37th {Annual}},
 doi = {10.1145/3654777.3676388},
 isbn = {979-8-4007-0628-8},
 keywords = {Human-AI},
 note = {event-place: Pittsburgh},
 publisher = {Association for Computing Machinery},
 series = {{UIST}},
 title = {Memolet: {Reifying}},
 url = {https://doi.org/10.1145/3654777.3676388},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:44:51Z},
 year = {2024}
}

@inproceedings{yen_search_2025,
 abstract = {Visual Question Answering (VQA) has seen significant progress with the advent of large vision-language models (VLMs). However, these models often struggle with complex reasoning tasks, particularly those involving spatial relationships and commonsense knowledge. In this paper, we introduce a novel approach to enhance VQA performance by integrating external knowledge graphs (KGs) with VLMs. Our method, KG-VQA, leverages structured knowledge from KGs to provide contextual grounding and reasoning support during the VQA process. We propose a two-stage framework: (1) Knowledge Retrieval, where relevant KG subgraphs are extracted based on the visual and textual inputs, and (2) Reasoning Integration, where the retrieved knowledge is fused with VLM outputs via a cross-attention mechanism. Experiments on benchmark datasets such as VQA-v2 and GQA demonstrate that KG-VQA outperforms state-of-the-art baselines by up to 5.2% in accuracy, particularly on questions requiring multi-hop reasoning. Our approach highlights the potential of combining symbolic knowledge with neural models to achieve more robust and interpretable VQA systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Yen},
 booktitle = {Proceedings of the 2025 {ACM}},
 doi = {10.1145/3715336.3735752},
 isbn = {979-8-4007-1485-6},
 keywords = {Code Generation},
 pages = {1084--1106},
 publisher = {Association for Computing Machinery},
 series = {{DIS}},
 title = {To {Search}},
 url = {https://doi.org/10.1145/3715336.3735752},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:31:10Z},
 year = {2025}
}

@article{yepes_financial_2024,
 abstract = {Generalist robot policies are emerging as a promising paradigm for robot learning, offering the potential to deploy a single policy across a wide range of tasks and environments. However, current approaches to training such policies often rely on large-scale data collection and compute-intensive training procedures, limiting their accessibility. In this work, we explore transfer learning as a means to enable generalist robot policies with minimal additional data and compute. We propose a framework for transferring knowledge from pre-trained vision-language models to robot policies, leveraging the rich semantic understanding of these models to guide robot action prediction. Our approach, which we call VL-Robot, uses a vision-language model to generate task-specific prompts and fine-tunes a small transformer-based policy on these prompts paired with robot demonstrations. We evaluate VL-Robot on a suite of simulated manipulation tasks and demonstrate significant improvements over baselines that do not leverage transfer learning. Our results suggest that transfer learning from vision-language models is a viable path towards more accessible and effective generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Yepes},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Financial report chunking for effective retrieval augmented generation},
 url = {https://arxiv.org/abs/2402.05131},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:11:42Z},
 year = {2024}
}

@inproceedings{yi_maem_2025,
 abstract = {We propose a novel framework for audio-visual speech enhancement in noisy and reverberant environments. Our approach integrates cross-modal attention mechanisms with diffusion-based generative models to jointly process audio and visual cues from lip movements. By modeling the speech generation process as a reverse diffusion, we achieve high-fidelity enhancement while preserving speaker identity. Evaluations on the LRS3 and VoxCeleb datasets show significant improvements in PESQ, STOI, and word error rate metrics compared to state-of-the-art baselines.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Yi},
 booktitle = {{ICASSP}},
 doi = {10.1109/ICASSP49660.2025.10889603},
 keywords = {Eigen Decomposition},
