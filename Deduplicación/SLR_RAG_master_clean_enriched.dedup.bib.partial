 year = {2024}
}

@article{huang_embedding-informed_2024,
 abstract = {Large language models (LLMs) are increasingly being deployed in real-world applications, but their safety remains a major concern. One common way to evaluate the safety of LLMs is through red-teaming, where the model is prompted with adversarial inputs to elicit unsafe behaviors. In this work, we focus on a specific type of red-teaming called jailbreaking, where the goal is to bypass the model's safety guardrails and generate harmful content. We introduce a new jailbreaking method called "torture," which iteratively refines adversarial prompts using a genetic algorithm. Our method is simple, effective, and works across a wide range of LLMs, including GPT-4, Claude, and Llama. We evaluate our method on a variety of harmful behaviors, including hate speech, misinformation, and illegal activities. Our results show that torture can jailbreak even the strongest LLMs with high success rates, highlighting the need for more robust safety mechanisms in LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Huang},
 journal = {arXiv preprint arXiv …},
