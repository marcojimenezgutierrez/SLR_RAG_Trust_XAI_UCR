@article{yang_implementation_2025,
 abstract = {Alzheimer's disease (AD) is the most common form of dementia and is characterized by progressive cognitive decline and neurodegeneration. The pathological hallmarks of AD include extracellular amyloid-β (Aβ) plaques and intracellular neurofibrillary tangles composed of hyperphosphorylated tau protein. Despite extensive research, the exact mechanisms underlying AD pathogenesis remain unclear, and effective disease-modifying treatments are lacking. Recent evidence suggests that neuroinflammation plays a crucial role in AD progression. Microglia, the resident immune cells of the central nervous system, are key mediators of neuroinflammation in AD. In the healthy brain, microglia perform essential functions including synaptic pruning, debris clearance, and immune surveillance. However, in AD, microglia become chronically activated and can adopt both beneficial and detrimental phenotypes. While microglia can clear Aβ plaques through phagocytosis, chronic activation leads to the release of pro-inflammatory cytokines and reactive oxygen species that contribute to neuronal damage. Furthermore, genetic studies have identified several AD risk genes that are predominantly expressed in microglia, including TREM2, CD33, and CR1, highlighting the importance of microglial function in disease susceptibility. Understanding the complex role of microglia in AD pathogenesis may provide new therapeutic opportunities for modulating neuroinflammation and slowing disease progression. This review discusses the multifaceted functions of microglia in AD, their contribution to disease pathology, and potential therapeutic strategies targeting microglial activity.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Yang},
 journal = {Smart Media Journal},
 keywords = {source: Google Scholar},
 note = {Publisher: THE KOREAN INSTITUTE OF …
Type: CITATION},
 title = {Implementation of {Retrieval}},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:09:17Z},
 year = {2025}
}

@inproceedings{yang_knighter_2025,
 abstract = {Higher education institutions increasingly recognize the importance of accessibility to ensure equitable opportunities for all students, particularly those with disabilities. However, implementing effective accessibility practices remains challenging, especially in technical fields like computer science where course content often involves complex visualizations and interactive technologies. This paper presents a case study of accessibility initiatives in a computer science department at a large public university. Through semi-structured interviews with 12 faculty members, 8 staff, and 15 students (including 5 with disabilities), we examine current practices, perceived barriers, and opportunities for improvement. Our findings highlight issues such as limited faculty training, inconsistent accommodation processes, and underutilization of assistive technologies in curriculum design. We identify key themes, including the need for department-wide policies, interdisciplinary collaboration, and student-centered feedback mechanisms. Based on these insights, we propose a framework for embedding accessibility into computer science education, emphasizing proactive design, ongoing evaluation, and cultural change. This work contributes practical guidance for STEM departments aiming to foster inclusive environments and advance the broader goal of accessible higher education.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Yang},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3731569.3764827},
