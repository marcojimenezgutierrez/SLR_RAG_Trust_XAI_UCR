@article{patel_agentic_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly impacted various sectors, including healthcare, where AI-driven diagnostic tools are increasingly integrated into clinical workflows. This paper explores the development and evaluation of an AI-based system for early detection of cardiovascular diseases using electrocardiogram (ECG) signals. The proposed model employs a convolutional neural network (CNN) architecture combined with long short-term memory (LSTM) layers to analyze ECG data, achieving an accuracy of 95.2% on a benchmark dataset. Experimental results demonstrate the system's superior performance compared to traditional methods, highlighting its potential for real-time deployment in resource-limited settings. Challenges such as data privacy and model interpretability are also addressed, with recommendations for future enhancements.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
