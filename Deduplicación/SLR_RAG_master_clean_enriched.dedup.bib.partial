 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:38:02Z},
 year = {2025}
}

@inproceedings{hu_research_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but evaluating their performance remains challenging, especially when comparing multiple models side-by-side. Existing tools often focus on isolated metrics or lack interactive visualization for qualitative analysis. We introduce LLM Comparator, an interactive visual analytics system designed to facilitate the side-by-side evaluation of LLMs. It supports diverse evaluation tasks, including prompt engineering, model comparison, and error analysis, through coordinated views that integrate quantitative metrics (e.g., perplexity, BLEU scores) with qualitative inspections of generated outputs. Users can explore model behaviors via heatmaps, scatterplots, and text highlighting, enabling insights into consistency, bias, and task-specific strengths. We demonstrate LLM Comparator's utility through case studies on creative writing and code generation, and validate its design with expert feedback from AI researchers. Our system lowers the barrier for LLM evaluation, empowering users to make informed decisions in model selection and fine-tuning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Hu},
 booktitle = {Proceedings of the 2024 {International}},
 doi = {10.1145/3744103.3744120},
