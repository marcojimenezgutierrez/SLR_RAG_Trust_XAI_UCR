@inproceedings{pan_survey_2025-1,
 abstract = {Machine Learning-Based Approach for Predicting Student Performance in Online Learning Environments

Online learning has become increasingly prevalent, especially after the COVID-19 pandemic. Predicting student performance in such environments is crucial for timely interventions to improve learning outcomes. This paper proposes a machine learning-based approach to predict student performance using data from learning management systems (LMS). We employ a combination of supervised learning algorithms, including Random Forest, Support Vector Machines, and Neural Networks, to classify students into performance categories based on features such as engagement metrics, assignment scores, and interaction patterns. The dataset used is from a real-world online course with over 1,000 students. Experimental results demonstrate that the Random Forest model achieves the highest accuracy of 92.5%, outperforming other models. Feature importance analysis reveals that quiz participation and forum interactions are key predictors. This approach can assist educators in identifying at-risk students early and personalizing learning experiences.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
