 year = {2025}
}

@article{wang_enhancing_2025,
 abstract = {Background: Artificial intelligence (AI) has shown promise in various healthcare applications, but its integration into clinical workflows remains challenging. This study aims to evaluate the performance of a novel AI-driven diagnostic tool for early detection of sepsis in emergency departments.

Methods: We conducted a multicenter retrospective cohort study using electronic health records from 2018 to 2023. The AI model, based on deep learning architectures, was trained on 50,000 patient episodes and validated on an independent set of 10,000 cases. Performance metrics included sensitivity, specificity, area under the receiver operating characteristic curve (AUC-ROC), and comparison with standard clinical scores like qSOFA.

Results: The AI tool achieved an AUC-ROC of 0.92 (95% CI: 0.90-0.94), with sensitivity of 88% and specificity of 85% at the optimal threshold. It outperformed qSOFA (AUC-ROC 0.76) in predicting sepsis within 6 hours of presentation, potentially reducing time to intervention by 2.5 hours on average.

Conclusions: This AI diagnostic tool demonstrates high accuracy for early sepsis detection and could enhance clinical decision-making in high-stakes environments. Future prospective trials are needed to assess real-world impact on patient outcomes.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Wang},
 doi = {10.1007/s13755-025-00379-x},
