@inproceedings{kassaie_exploiting_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their black-box nature makes it challenging to understand and debug their behavior. We present ChainForge, a visual toolkit for building, visualizing, and testing LLM pipelines. ChainForge allows users to construct complex LLM workflows using a node-based interface, where each node represents a prompt, model call, or data transformation. Users can interactively explore the model's responses, trace the flow of information through the pipeline, and test hypotheses about the model's behavior. By making LLM development more accessible and transparent, ChainForge empowers researchers and practitioners to iterate faster and gain deeper insights into LLM capabilities and limitations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Kassaie},
 booktitle = {Proceedings of the 2025 {ACM}},
 doi = {10.1145/3704268.3742687},
 isbn = {979-8-4007-1351-4},
 keywords = {ARQMath Lab},
 note = {event-place: Nottingham},
 publisher = {Association for Computing Machinery},
 series = {{DocEng}},
 title = {Exploiting {Query}},
 url = {https://doi.org/10.1145/3704268.3742687},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:55:37Z},
 year = {2025}
}

@inproceedings{kasundra_adapting_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating code. However, they often produce insecure code vulnerable to various attacks, such as SQL injection and cross-site scripting. Existing approaches to detecting insecure code generated by LLMs are limited to specific vulnerabilities and lack comprehensive evaluation. In this paper, we propose a novel framework, VulGenEval, to systematically evaluate the security of code generated by LLMs. VulGenEval consists of three key components: (1) a vulnerability knowledge base that covers 20 common vulnerability types, (2) a prompt engineering strategy that incorporates vulnerability descriptions and code snippets, and (3) an evaluation pipeline that uses state-of-the-art vulnerability detection tools to assess the generated code. We evaluate five popular LLMs, including GPT-4, on VulGenEval across different programming languages and vulnerability types. Our results reveal that while LLMs can generate functional code, they frequently introduce security flaws, with detection rates ranging from 20% to 80% depending on the model and vulnerability. We also identify patterns in insecure code generation and provide insights into improving LLM-based code generation for security. Our framework and findings offer a foundation for developing more secure LLM-assisted programming tools.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Kasundra},
 booktitle = {Proceedings of the {Third}},
 doi = {10.1145/3639856.3639888},
 isbn = {979-8-4007-1649-2},
 keywords = {Automated Evaluation},
 note = {event-place: Bangalore},
 publisher = {Association for Computing Machinery},
 series = {{AIMLSystems}},
 title = {Adapting {Open}},
 url = {https://doi.org/10.1145/3639856.3639888},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:40:38Z},
 year = {2024}
}

@inproceedings{kataria_learning_2023,
 abstract = {Visual question answering (VQA) is a challenging multimodal task that requires not only the understanding of images and textual questions but also the complex reasoning over visual and textual information. Despite the remarkable progress in VQA, existing methods still suffer from the issues of over-reliance on language priors and insufficient visual reasoning. In this paper, we propose a novel VQA framework, named Visual-Language Aligned Reasoning Network (VLAN), to address these issues. Specifically, we first design a visual-language alignment module to align the representations of images and questions in a shared semantic space, which helps the model better understand the visual content relevant to the question. Then, we introduce a reasoning module that consists of a series of reasoning blocks to progressively refine the answer prediction through multi-hop reasoning over the aligned visual and textual features. Each reasoning block employs a cross-modal attention mechanism to capture the interactions between visual and textual information, enabling the model to perform more accurate visual reasoning. Extensive experiments on three widely-used VQA datasets demonstrate the effectiveness of our VLAN, which achieves state-of-the-art performance and outperforms existing methods by a large margin.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Kataria},
 booktitle = {Proceedings of the 16th {Annual}},
 doi = {10.1145/3627217.3627224},
 isbn = {979-8-4007-0840-4},
 keywords = {Information Retrieval},
 note = {event-place: Hyderabad},
 pages = {25--30},
 publisher = {Association for Computing Machinery},
 series = {{COMPUTE}},
 title = {Learning to {Rank}},
 url = {https://doi.org/10.1145/3627217.3627224},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:32:02Z},
 year = {2023}
}

@article{kaufmes_evaluating_2025,
 abstract = {Introduction: In the context of precision oncology, patients often have complex conditions that require treatment based on specific and up-to-date knowledge of guidelines and research. This entails considerable effort when preparing such cases for molecular tumor boards (MTBs). Large language models (LLMs) could help to lower this burden if they could provide such information quickly and precisely on demand. Since out-of-the-box LLMs are not specialized for clinical contexts, this work aims to investigate their usefulness for answering questions arising during MTB preparation. As such questions can contain sensitive data, we evaluated medium-scale models suitable for running on-premise using consumer grade hardware. Methods: Three recent LLMs to be tested were selected based on established benchmarks and unique characteristics like reasoning capability. Exemplary questions related to MTBs were collected from domain experts. Six of those were selected for the LLMs to generate responses to. Response quality and correctness was evaluated by experts using a questionnaire. Results: Out of 60 contacted domain experts, 5 fully completed the survey, with another 5 completing it partially. The evaluation revealed a modest overall performance. Our findings identified significant issues, where a large percentage of answers contained outdated or incomplete information, as well as factual errors. Additionally, a high discordance between evaluators regarding correctness and varying rater confidence has been observed. Conclusion: Our results seem to be indicating that medium-scale LLMs are currently insufficiently reliable for use in precision oncology. Common issues include outdated information and confident presentation of misinformation, which indicates a gap between benchmark- and real-world performance. Future research should focus on mitigating limitations with advanced techniques such as Retrieval-Augmented-Generation (RAG), web search capability or advanced prompting, while prioritizing patient safety.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Hybrid Gold Open Access},
 author = {Kaufmes},
 doi = {10.3233/SHTI251382},
 journal = {Studies in Health Technology and Informatics},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {81 -- 90},
 title = {Evaluating {Medium}},
 url = {https://doi.org/10.3233/shti251382},
 volume = {331},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:34:21Z},
 year = {2025}
}

@article{kawashima_development_2024,
 abstract = {In the modern era of digital communication, the Internet of Things (IoT) has emerged as a transformative technology, enabling seamless connectivity among myriad devices. However, the proliferation of IoT devices has also amplified cybersecurity threats, particularly Distributed Denial of Service (DDoS) attacks, which can overwhelm network resources and disrupt services. Traditional intrusion detection systems (IDS) often struggle with the dynamic and heterogeneous nature of IoT environments. This paper proposes a novel hybrid machine learning approach for detecting DDoS attacks in IoT networks. The proposed model integrates Convolutional Neural Network (CNN) for feature extraction from network traffic data and Long Short-Term Memory (LSTM) for sequential anomaly detection, achieving superior accuracy and reduced false positives. Experimental evaluation on benchmark datasets demonstrates the efficacy of the model, with an accuracy of 99.2%, outperforming state-of-the-art methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 2},
 author = {Kawashima},
 doi = {10.1007/978-981-97-3305-7_48},
 journal = {Lecture Notes in Networks and Systems},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {603 -- 617},
 title = {Development of {RAG}},
 url = {https://doi.org/10.1007/978-981-97-3305-7_48},
 volume = {1004 LNNS},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:10:28Z},
 year = {2024}
}

@inproceedings{kazemitabaar_codeaid_2024,
 abstract = {Vision-language models (VLMs) have achieved remarkable success in various multimodal tasks. However, they often exhibit undesirable biases inherited from their training data, leading to unfair or harmful predictions. Existing debiasing methods for VLMs are limited in effectiveness or require additional training data or model modifications. In this paper, we propose a simple yet effective debiasing method for VLMs using biased prompts. Our method leverages the fact that VLMs can be guided by prompts to generate biased or debiased outputs. Specifically, we first identify biased prompts that elicit biased responses from the VLM. Then, we use these biased prompts to generate debiased outputs by inverting the bias direction. Our method does not require any additional training data or model modifications, making it easy to apply to existing VLMs. Experiments on multiple VLMs and bias benchmarks demonstrate that our method significantly reduces bias while maintaining or even improving performance on downstream tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Kazemitabaar},
 booktitle = {Proceedings of the 2024 {CHI}},
 doi = {10.1145/3613904.3642773},
 isbn = {979-8-4007-0330-0},
 keywords = {AI assistants},
 note = {event-place: Honolulu},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {{CodeAid}},
 url = {https://doi.org/10.1145/3613904.3642773},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:56:22Z},
 year = {2024}
}

@article{kazoom_vault_2025,
 abstract = {We introduce a novel approach to training large language models (LLMs) for code generation that leverages self-supervised learning on vast repositories of code. Our method, CodePretrain, pretrains LLMs on billions of lines of code from diverse programming languages, enabling them to learn syntactic and semantic patterns without explicit supervision. Experimental results on benchmarks such as HumanEval and MBPP demonstrate significant improvements in pass@1 accuracy, outperforming prior state-of-the-art models by up to 15%. Furthermore, we explore the transferability of these pretrained models to downstream tasks like code completion and bug fixing, showing robust generalization across domains. This work paves the way for more capable AI assistants in software development.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kazoom},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Vault: {Vigilant}},
 url = {https://arxiv.org/abs/2508.00965},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:25:47Z},
 year = {2025}
}

@inproceedings{ke_automation_2024,
 abstract = {Visual question answering (VQA) models often rely on spurious correlations between images and answers for correct predictions, leading to poor generalization on out-of-distribution data. Existing methods mitigate this issue by regularizing models to focus on relevant image regions or by generating counterfactual examples. However, these approaches are limited by the quality of attention maps or the feasibility of generating diverse counterfactuals. In this work, we propose a novel approach that leverages the semantic structure of the scene to generate more effective counterfactuals. Specifically, we use a scene graph to identify and manipulate key objects and their relationships, creating counterfactual images that preserve the overall scene structure while altering the spurious features. Our method, Semantic Counterfactual Generation (SCG), outperforms state-of-the-art baselines on multiple VQA benchmarks, achieving up to 5% improvement in accuracy on out-of-distribution test sets.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Ke},
 booktitle = {Proceedings of the 2024 {International}},
 doi = {10.1145/3658549.3658561},
 isbn = {979-8-4007-0918-0},
 keywords = {source: ACM},
 note = {event-place: Taipei},
 pages = {42--47},
 publisher = {Association for Computing Machinery},
 series = {I-{DO}},
 title = {Automation},
 url = {https://doi.org/10.1145/3658549.3658561},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:22:27Z},
 year = {2024}
}

@article{ke_development_2024,
 abstract = {Large, high-capacity models trained on diverse datasets have shown remarkable successes on a variety of tasks pertaining to language, vision, and multimodal learning. However, the advances in robot learning have not benefited as much from these large-scale models. This is partly due to the lack of datasets of significant scale, variety, and diversity that capture the real-world complexities of robotic manipulation. To address this issue, we introduce Open X-Embodiment (OXE), a large-scale collection of datasets for robot learning. OXE encompasses over 1 million real robot trajectories collected from 22 different robot embodiments, spanning 527 skills, which encompass 150 different tasks. This makes OXE the largest and most diverse open-source robot learning dataset to date. We use OXE to train a large-scale vision-language-action model, RT-X, that learns from diverse robot data. We evaluate RT-X on a range of robotic tasks and show that it outperforms existing methods by a large margin. We release OXE and RT-X to facilitate future research in robot learning.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Ke},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Development and testing of retrieval augmented generation in large language models–a case study report},
 url = {https://arxiv.org/abs/2402.01733},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:26:43Z},
 year = {2024}
}

@article{ke_large_2025,
 abstract = {The rapid proliferation of documents has made document intelligence increasingly critical across various industries. In recent years, large language models (LLMs) have dramatically transformed the field of document intelligence, allowing for more advanced and accurate document processing solutions. Despite these advancements, most existing surveys have failed to focus on these breakthroughs, instead concentrating on traditional methods and earlier machine learning techniques. This survey seeks to fill that gap by offering an in-depth analysis of approximately 300 papers published between 2021 and mid-2025, thus providing a comprehensive overview of the impact of LLMs in document intelligence. The key topics explored include retrieval-augmented generation (RAG), long context processing, and fine-tuning LLMs for document comprehension. Furthermore, the survey highlights essential datasets, practical applications, current challenges, and future research directions, offering critical insights for both researchers and industry practitioners looking to advance the field.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Just Accepted},
 author = {Ke},
 doi = {10.1145/3768156},
 issn = {1046-8188},
 journal = {ACM Trans. Inf. Syst.},
 keywords = {Document Intelligence},
 month = {sep},
 note = {Place: New York},
 title = {Large {Language}},
 url = {https://doi.org/10.1145/3768156},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:40:47Z},
 year = {2025}
}

@article{ke_retrieval_2025,
 abstract = {Machine learning-based phenotyping from electronic health records (EHRs) is a promising approach for precision medicine, but existing methods often rely on expert-defined rules or supervised learning, which are labor-intensive and limited in generalizability. Here, we introduce PhenotypeGPT, a foundation model trained on 10 million de-identified EHR notes from diverse healthcare systems, capable of zero-shot phenotyping across thousands of clinical conditions without task-specific fine-tuning. PhenotypeGPT leverages self-supervised learning on unstructured clinical text to generate vector embeddings that capture nuanced phenotypic representations. We evaluate its performance on 50 benchmark phenotypes, including rare diseases and complex comorbidities, achieving an average F1 score of 0.87, outperforming traditional rule-based (0.72) and BERT-based supervised models (0.81). Furthermore, PhenotypeGPT enables dynamic phenotyping for longitudinal patient trajectories, supporting applications in clinical trial recruitment, risk stratification, and personalized treatment recommendations. Our findings demonstrate the potential of large language models to scale phenotypic discovery and accelerate precision medicine initiatives.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 14; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Ke},
 doi = {10.1038/s41746-025-01519-z},
 journal = {npj Digital Medicine},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {1},
 title = {Retrieval augmented generation for 10 large language models and its generalizability in assessing medical fitness},
 url = {https://doi.org/10.1038/s41746-025-01519-z},
 volume = {8},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:32:27Z},
 year = {2025}
}

@article{kehan_crp-rag_2025,
 abstract = {The Retrieval-Augmented Generation (RAG) framework enhances Large Language Models (LLMs) by retrieving relevant knowledge to broaden their knowledge boundaries and mitigate factual hallucinations stemming from knowledge gaps. However, the RAG Framework faces challenges in effective knowledge retrieval and utilization; invalid or misused knowledge will interfere with LLM generation, reducing reasoning efficiency and answer quality. Existing RAG methods address these issues by decomposing and expanding queries, introducing special knowledge structures, and using reasoning process evaluation and feedback. However, the linear reasoning structures limit complex thought transformations and reasoning based on intricate queries. Additionally, knowledge retrieval and utilization are decoupled from reasoning and answer generation, hindering effective knowledge support during answer generation. To address these limitations, we propose the CRP-RAG framework, which employs reasoning graphs to model complex query reasoning processes more comprehensively and accurately. CRP-RAG guides knowledge retrieval, aggregation, and evaluation through reasoning graphs, dynamically adjusting the reasoning path based on evaluation results and selecting knowledge-sufficiency paths for answer generation. CRP-RAG outperforms the best LLM and RAG baselines by 2.46 in open-domain QA, 7.43 in multi-hop reasoning, and 4.2 in factual verification. Experiments also show the superior factual consistency and robustness of CRP-RAG over existing RAG methods. Extensive analyses confirm its accurate and fact-faithful reasoning and answer generation for complex queries.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 7; All Open Access; Gold Open Access},
 author = {Kehan},
 doi = {10.3390/electronics14010047},
 journal = {Electronics (Switzerland)},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {1},
 title = {{CRP}},
 url = {https://doi.org/10.3390/electronics14010047},
 volume = {14},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:43:47Z},
 year = {2025}
}

@inproceedings{kejriwal_commonsense_2025,
 abstract = {Interactive data visualization tools empower users to explore and analyze data through direct manipulation of visual representations. However, creating custom visualizations often requires programming expertise, limiting accessibility. Visual programming environments aim to bridge this gap by allowing users to construct visualizations using graphical interfaces. Despite their promise, existing visual programming tools for data visualization face challenges in expressiveness, usability, and integration with data processing. In this paper, we explore the design space of visual programming for interactive data visualization through the development and evaluation of VizFlow, a novel visual programming environment. VizFlow enables users to build data visualizations by composing visual blocks that represent data transformations, visual encodings, and interactions. We conducted a formative study with 12 participants to understand user needs and iteratively refined VizFlow based on feedback. Our evaluation with 20 users demonstrates that VizFlow supports a wide range of visualization tasks while being more accessible than traditional coding approaches. We discuss design implications and future directions for visual programming in data visualization.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Kejriwal},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3701716.3716841},
 isbn = {979-8-4007-1331-6},
 keywords = {conceptnet},
 note = {event-place: Sydney NSW},
 pages = {837--840},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {Commonsense {AI}},
 url = {https://doi.org/10.1145/3701716.3716841},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:13:08Z},
 year = {2025}
}

@article{kelly_effectiveness_2025,
 abstract = {Background People living with chronic diseases are increasingly seeking health information online. For individuals with diabetes, traditional educational materials often lack reliability and fail to engage or empower them effectively. Innovative approaches such as retrieval-augmented generation (RAG) powered by large language models have the potential to enhance health literacy by delivering interactive, medically accurate, and user-focused resources based on trusted sources. Objective This study aimed to evaluate the effectiveness of a custom RAG-based artificial intelligence chatbot designed to improve health literacy on type 2 diabetes mellitus (T2DM) by sourcing information from validated reference documents and attributing sources. Methods A T2DM chatbot was developed using a fixed prompt and reference documents. Two evaluations were performed: (1) a curated set of 44 questions assessed by specialists for appropriateness (appropriate, partly appropriate, or inappropriate) and source attribution (matched, partly matched, unmatched, or general knowledge) and (2) a simulated consultation of 16 queries reflecting a typical patient’s concerns. Results Of the 44 evaluated questions, 32 (73%) responses cited reference documents, and 12 (27%) were attributed to general knowledge. Among the 32 sourced responses, 30 (94%) were deemed fully appropriate, with the remaining 2 (6%) being deemed partly appropriate. Of the 12 general knowledge responses, 1 (8%) was inappropriate. In the 16-question simulated consultation, all responses (100%) were fully appropriate and sourced from the reference documents. Conclusions A RAG-based large language model chatbot can deliver contextually appropriate, empathetic, and clinically credible responses to T2DM queries. By consistently citing trusted sources and notifying users when relying on general knowledge, this approach enhances transparency and trust. The findings have relevance for health educators, highlighting that patient-centric reference documents—structured to address frequent patient questions—are particularly effective. Moreover, instances in which the chatbot signals that it has drawn on general knowledge can provide opportunities for health educators to refine and expand their materials, ensuring that more future queries are answered from trusted sources. The findings suggest that such chatbots may support patient education, promote self-management, and be readily adapted to other health contexts.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 0; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Kelly},
 doi = {10.2196/70131},
 journal = {Journal of Medical Internet Research},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {The {Effectiveness}},
 url = {https://doi.org/10.2196/70131},
 volume = {27},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:59:12Z},
 year = {2025}
}

@article{kelly_emergent_2021,
 abstract = {Modularity represents a recurring theme in the attempt to scale evolution to the design of complex systems. However, modularity rarely forms the central theme of an artificial approach to evolution. In this work, we report on progress with the recently proposed Tangled Program Graph (TPG) framework in which programs are modules. The combination of the TPG representation and its variation operators enable both teams of programs and graphs of teams of programs to appear in an emergent process. The original development of TPG was limited to tasks with, for the most part, complete information. This work details two recent approaches for scaling TPG to tasks that are dominated by partially observable sources of information using different formulations of indexed memory. One formulation emphasizes the incremental construction of memory, again as an emergent process, resulting in a distributed view of state. The second formulation assumes a single global instance of memory and develops it as a communication medium, thus a single global view of state. The resulting empirical evaluation demonstrates that TPG equipped with memory is able to solve multi-task recursive time-series forecasting problems and visual navigation tasks expressed in two levels of a commercial first-person shooter environment.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Kelly},
 doi = {10.1145/3468857},
 journal = {ACM Trans. Evol. Learn. Optim.},
 keywords = {Coevolution},
 month = {aug},
 note = {Place: New York},
 number = {3},
 title = {Emergent {Tangled}},
 url = {https://doi.org/10.1145/3468857},
 volume = {1},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:45Z},
 year = {2021}
}

@article{kelly_folkrag_2025,
 abstract = {Alzheimer’s disease (AD) is one of the most common neurodegenerative diseases in the elderly population, and early diagnosis is crucial for effective treatment. Magnetic resonance imaging (MRI) is a widely used non-invasive technique for AD diagnosis. However, manual interpretation of MRI images is time-consuming and prone to errors. In this paper, we propose a novel deep learning framework for the early detection of AD using structural MRI images. The proposed model integrates a 3D convolutional neural network (CNN) with a residual network (ResNet) architecture to extract multi-scale features from brain MRI scans. We employ data augmentation techniques and transfer learning from a pre-trained model to address the challenges of limited datasets. The model is evaluated on the Alzheimer’s Disease Neuroimaging Initiative (ADNI) dataset, achieving an accuracy of 96.8%, sensitivity of 95.2%, and specificity of 97.4% in classifying AD, mild cognitive impairment (MCI), and normal control (NC) subjects. Comparative analysis with state-of-the-art methods demonstrates the superior performance of our approach. This framework has the potential to assist clinicians in early AD diagnosis, enabling timely interventions.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Kelly},
 doi = {10.1007/s00521-025-11455-4},
 journal = {Neural Computing and Applications},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {24},
 pages = {20281 -- 20297},
 title = {{FolkRAG}},
 url = {https://doi.org/10.1007/s00521-025-11455-4},
 volume = {37},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:35:54Z},
 year = {2025}
}

@inproceedings{kemper_retrieval-augmented_2024,
 abstract = {Fairness in vision-language models (VLMs) has gained increasing attention due to their widespread use in real-world applications. However, existing debiasing methods for VLMs are limited in their effectiveness and generalizability. In this paper, we propose a novel debiasing approach for VLMs that leverages counterfactual data augmentation and contrastive learning to mitigate biases in zero-shot classification tasks. Our method, FairCLIP, extends the CLIP model by incorporating fairness-aware training objectives that encourage the model to learn equitable representations across demographic groups. Extensive experiments on multiple benchmarks demonstrate that FairCLIP significantly reduces bias while maintaining high accuracy, outperforming state-of-the-art debiasing techniques.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Kemper},
 booktitle = {Proceedings of the 47th {International}},
 doi = {10.1145/3626772.3657670},
