 note = {event-place: Washington DC},
 pages = {2713--2718},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {An {Integrated}},
 url = {https://doi.org/10.1145/3626772.3657671},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:16:20Z},
 year = {2024}
}

@inproceedings{sun_irrational_2025,
 abstract = {Abstract—With the rapid development of 5G and beyond networks, efficient resource allocation becomes crucial for supporting diverse services. This paper proposes a novel deep reinforcement learning-based approach for dynamic spectrum sharing in multi-tenant wireless networks. The proposed model, termed DRL-MTSS, leverages a multi-agent deep Q-network to optimize spectrum allocation while considering interference management and quality-of-service requirements. Simulation results demonstrate that DRL-MTSS achieves up to 25% higher throughput and 30% better fairness compared to baseline methods such as greedy allocation and traditional optimization techniques.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Sun},
 booktitle = {2025 34th {International}},
