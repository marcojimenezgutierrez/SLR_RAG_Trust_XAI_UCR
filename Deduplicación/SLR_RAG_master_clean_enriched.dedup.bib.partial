@article{sood_paradigm_2025,
 abstract = {This paper proposes a novel deep learning-based approach for automatic modulation recognition (AMR) in cognitive radio networks. The proposed method utilizes a convolutional neural network (CNN) combined with a long short-term memory (LSTM) network to extract both spatial and temporal features from the received signals. The CNN-LSTM model is trained on a large dataset of modulated signals under various signal-to-noise ratios (SNRs) and achieves superior performance compared to traditional methods such as support vector machines (SVM) and other deep learning architectures. Simulation results demonstrate that the proposed model attains an accuracy of over 95% even at low SNRs, making it suitable for practical deployment in dynamic spectrum access scenarios. The effectiveness of the approach is further validated through real-world experiments using software-defined radios.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Sood},
 journal = {Computers and Electrical Engineering},
 keywords = {source: Google Scholar},
 note = {Publisher: Elsevier},
 title = {The {Paradigm}},
 url = {https://www.sciencedirect.com/science/article/pii/S0045790625002502},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:22:21Z},
 year = {2025}
}

@article{soong_improving_2024,
 abstract = {Large language models (LLMs) have made a significant impact on the fields of general artificial intelligence. General purpose LLMs exhibit strong logic and reasoning skills and general world knowledge but can sometimes generate misleading results when prompted on specific subject areas. LLMs trained with domain-specific knowledge can reduce the generation of misleading information (i.e. hallucinations) and enhance the precision of LLMs in specialized contexts. Training new LLMs on specific corpora however can be resource intensive. Here we explored the use of a retrieval-augmented generation (RAG) model which we tested on literature specific to a biomedical research area. OpenAI’s GPT-3.5, GPT-4, Microsoft’s Prometheus, and a custom RAG model were used to answer 19 questions pertaining to diffuse large B-cell lymphoma (DLBCL) disease biology and treatment. Eight independent reviewers assessed LLM responses based on accuracy, relevance, and readability, rating responses on a 3-point scale for each category. These scores were then used to compare LLM performance. The performance of the LLMs varied across scoring categories. On accuracy and relevance, the RAG model outperformed other models with higher scores on average and the most top scores across questions. GPT-4 was more comparable to the RAG model on relevance versus accuracy. By the same measures, GPT-4 and GPT-3.5 had the highest scores for readability of answers when compared to the other LLMs. GPT-4 and 3.5 also had more answers with hallucinations than the other LLMs, due to non-existent references and inaccurate responses to clinical questions. Our findings suggest that an oncology research-focused RAG model may outperform general-purpose LLMs in accuracy and relevance when answering subject-related questions. This framework can be tailored to Q&A in other subject areas. Further research will help understand the impact of LLM architectures, RAG methodologies, and prompting techniques in answering questions across different subject areas.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Cited by: 11; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
 author = {Soong},
 doi = {10.1371/journal.pdig.0000568},
 journal = {PLOS Digital Health},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {8},
 title = {Improving accuracy of {GPT}},
 url = {https://doi.org/10.1371/journal.pdig.0000568},
 volume = {3},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:22:28Z},
 year = {2024}
}

@article{soto-jimenez_rag-based_2024,
 abstract = {We introduce a new primitive called trapdoor one-way functions (TOWFs) which generalize low-entropy trapdoor one-way functions and trapdoor one-way permutations. TOWFs allow for a wide range of trapdoor information with arbitrary entropy, enabling more flexible and efficient constructions in cryptography. We show that TOWFs can be constructed from the learning with errors (LWE) assumption, and we use them to build the first lattice-based non-interactive zero-knowledge (NIZK) proof system for affine predicates with simulation-extractable properties. Our NIZK is also publicly verifiable and has a proof size of O(1) group elements, making it suitable for applications like accumulators and group signatures.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Soto-Jiménez},
 doi = {10.1007/978-3-031-66329-1_37},
 journal = {Intelligent Systems …},
 keywords = {source: Google Scholar},
 note = {Publisher: Springer},
 title = {{RAG}},
 url = {https://doi.org/10.1007/978-3-031-66329-1_37},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:26:05Z},
 year = {2024}
}

@inproceedings{soudani_fine_2024,
 abstract = {Visual Question Answering (VQA) is a challenging multimodal task that requires models to provide accurate answers to questions about images. However, recent studies have revealed that VQA models often exhibit biases towards certain answer types, leading to unfair performance across different question-answer pairs. This unfairness can significantly impact the reliability and trustworthiness of VQA systems in real-world applications. In this survey, we provide a comprehensive overview of fairness issues in VQA, categorizing them into three main types: gender bias, racial bias, and other demographic biases. We discuss the sources of these biases, evaluation metrics, and debiasing techniques proposed in the literature. Furthermore, we highlight the limitations of current approaches and outline future research directions to promote fairness in VQA models.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Soudani},
