@inproceedings{gu_lens_2024,
 abstract = {This paper proposes a novel deep learning-based approach for real-time ultrasound image reconstruction from sparse measurements. Traditional ultrasound imaging systems often suffer from limited resolution and artifacts due to the ill-posed nature of the inverse problem. We introduce a convolutional neural network (CNN) architecture that leverages multi-scale feature extraction and attention mechanisms to enhance image quality. The model is trained on a large dataset of simulated and clinical ultrasound data, achieving significant improvements in peak signal-to-noise ratio (PSNR) and structural similarity index (SSIM) compared to conventional methods like filtered back-projection. Experimental results on in-vivo datasets demonstrate the feasibility of our method for portable ultrasound devices, enabling faster imaging without compromising diagnostic accuracy.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Gu},
 booktitle = {2024 7th {International}},
 doi = {10.1109/UV63228.2024.11189150},
