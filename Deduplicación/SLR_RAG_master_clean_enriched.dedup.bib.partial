@article{zou_poisonedrag_2025,
 abstract = {Soil organic carbon (SOC) is the largest terrestrial carbon pool and plays a critical role in the global carbon cycle. However, the spatial distribution of SOC and its controlling factors remain poorly understood at large scales. Here, we compiled a comprehensive database of 5,275 soil profiles across China and used machine learning algorithms to predict the spatial distribution of SOC stocks and identify the dominant controlling factors. Our results show that the total SOC stock in the top 1 m of soil across China is 69.1 Pg C, with a mean density of 7.4 kg C m−2. The spatial distribution of SOC stocks shows strong regional variations, with higher values in northeastern and southwestern China and lower values in northwestern China. Random forest models explained 71% of the spatial variation in SOC stocks. Climate variables, particularly mean annual precipitation and temperature, were the most important predictors of SOC stocks at the national scale, followed by soil properties and vegetation type. However, the relative importance of controlling factors varied substantially across different climate zones. In humid regions, climate and vegetation were the dominant controls, whereas in arid and semi-arid regions, soil properties became more important. Our findings highlight the complex interactions between climate, soil, and vegetation in regulating SOC stocks and provide important insights for predicting SOC dynamics under future climate change.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 title = {\{{PoisonedRAG},
  author = {Zou, W. and Geng, R. and Wang, B. and Jia, J.},
  year = {2025},
  url = {https://www.usenix.org/conference/usenixsecurity25/presentation/zou-poisonedrag},
  journal = {34th USENIX Security Symposium …},
  note = {Publisher: usenix.org},
  keywords = {source: Google Scholar},
  abstract = {… database of a RAG system to induce an LLM to generate an … RAG enables an LLM to utilize external knowledge in a plug-and-play manner. Moreover, RAG can reduce hallucinations …},
  annote = {Query date: 2025-10-25 20:50:36},}},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
