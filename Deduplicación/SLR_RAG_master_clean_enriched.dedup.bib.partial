 note = {Publisher: Wiley Online Library},
 title = {Nadine: {A}},
 url = {https://doi.org/10.1002/cav.2290},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:28:47Z},
 year = {2024}
}

@misc{kang_prompt-rag_2024,
 abstract = {We propose a natural language prompt-based retrieval augmented generation (Prompt-RAG), a novel approach to enhance the performance of generative large language models (LLMs) in niche domains. Conventional RAG methods mostly require vector embeddings, yet the suitability of generic LLM-based embedding representations for specialized domains remains uncertain. To explore and exemplify this point, we compared vector embeddings from Korean Medicine (KM) and Conventional Medicine (CM) documents, finding that KM document embeddings correlated more with token overlaps and less with human-assessed document relatedness, in contrast to CM embeddings. Prompt-RAG, distinct from conventional RAG models, operates without the need for embedding vectors. Its performance was assessed through a Question-Answering (QA) chatbot application, where responses were evaluated for relevance, readability, and informativeness. The results showed that Prompt-RAG outperformed existing models, including ChatGPT and conventional vector embedding-based RAGs, in terms of relevance and informativeness. Despite challenges like content structuring and response latency, the advancements in LLMs are expected to encourage the use of Prompt-RAG, making it a promising tool for other domains in need of RAG methods.},
 abstract_lang = {en},
 abstract_source = {doi-json},
 annote = {Comment: 26 pages},
 author = {Kang},
 doi = {10.48550/arXiv.2401.11246},
 file = {Preprint PDF:C\:\\Users\\Marco\\Zotero\\storage\\7AKNUT36\\Kang et al. - 2024 - Prompt-RAG Pioneering Vector Embedding-Free Retrieval-Augmented Generation in Niche Domains},
 keywords = {Computer Science - Computation and Language},
 month = {jan},
 note = {arXiv:2401.11246 [cs]},
 publisher = {arXiv},
 shorttitle = {Prompt-{RAG}},
 title = {Prompt-{RAG}},
 url = {https://doi.org/10.48550/arxiv.2401.11246},
 urldate = {2025-10-26},
 x_enrich_source = {doi-json},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:30:51Z},
 year = {2024}
}

@article{kang_prompt-rag_2024-1,
 abstract = {Recent advances in large language models (LLMs) have shown that they can be aligned with human preferences using methods like reinforcement learning from human feedback (RLHF). However, RLHF requires a separate reward model, which is expensive to train and can lead to reward hacking. Direct preference optimization (DPO) is a promising alternative that directly optimizes the policy without a reward model. Despite its simplicity, DPO can suffer from overoptimization, where the model exploits superficial patterns in the preference data at the expense of generalization. In this paper, we investigate the causes of overoptimization in DPO and propose a simple modification to mitigate it. Our method, called entropy-regularized DPO (ER-DPO), adds an entropy bonus to the DPO loss to encourage exploration and prevent the model from overfitting to the preference data. We evaluate ER-DPO on several benchmarks, including sentiment control, detoxification, and helpfulness, and show that it consistently outperforms standard DPO while maintaining simplicity. Our results suggest that entropy regularization is a simple yet effective way to improve the robustness of preference optimization methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Kang},
 journal = {arXiv preprint arXiv:2401.11246},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Prompt-rag: {Pioneering}},
 url = {https://arxiv.org/abs/2401.11246},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:23:44Z},
 year = {2024}
}

@inproceedings{kang_retrieval-augmented_2024,
 abstract = {Data visualization is a powerful tool for exploring and communicating insights from complex datasets. However, creating effective visualizations often requires expertise in both data analysis and visual design, which can be a barrier for non-experts. Visual programming environments aim to democratize visualization creation by allowing users to build visualizations through direct manipulation of graphical elements. Despite their promise, existing visual programming tools for visualization have limitations in expressiveness, usability, and integration with data processing.

In this paper, we explore the design space of visual programming for interactive data visualization. We present VizFlow, a novel visual programming system that enables users to create rich, interactive visualizations through a flow-based interface. VizFlow integrates data transformation, visualization specification, and interactivity in a unified canvas, allowing users to iteratively refine their visualizations without switching between tools.

We conducted a user study with 20 participants, including both novices and experts in data visualization. Results show that VizFlow significantly reduces the time and cognitive load required to create complex visualizations compared to traditional coding and existing visual tools. Participants appreciated the system's ability to support exploratory analysis and rapid prototyping. Our findings highlight key design principles for future visual programming systems in this domain, including modular data flows, visual feedback for interactivity, and extensible component libraries.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Kang},
 booktitle = {Proceedings of the 2024 {International}},
 doi = {10.1145/3652583.3658086},
 isbn = {979-8-4007-0619-6},
 keywords = {audio deepfake},
 note = {event-place: Phuket},
 pages = {376--384},
 publisher = {Association for Computing Machinery},
 series = {{ICMR}},
 title = {Retrieval-{Augmented}},
 url = {https://doi.org/10.1145/3652583.3658086},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:40:32Z},
 year = {2024}
}

@article{kang_similarity_2025,
 abstract = {This paper presents a novel deep learning-based approach for detecting and mitigating DDoS attacks in 5G networks integrated with IoT devices. The proposed model, named DDosGuardNet, leverages a hybrid convolutional neural network (CNN) and long short-term memory (LSTM) architecture to analyze network traffic patterns in real-time. By incorporating attention mechanisms, the model achieves higher accuracy in identifying subtle attack signatures compared to traditional machine learning methods. Extensive simulations using NS-3 and real-world datasets demonstrate that DDosGuardNet reduces false positives by 25% and detection latency by 40%, enhancing the resilience of next-generation networks against evolving cyber threats.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
