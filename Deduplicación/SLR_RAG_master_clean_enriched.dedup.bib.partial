@article{bao_faithbench_2024,
 abstract = {Building generalist robot policies that can perform a wide range of tasks in diverse environments is a key challenge in robotics. While large-scale data collection and training have led to impressive results in specific domains, generalist policies that can transfer across tasks and environments remain elusive. In this work, we study what factors contribute to the success of generalist robot policies. We conduct a comprehensive study across a variety of tasks, including manipulation, navigation, and interaction, using a diverse set of environments and robot embodiments. Our findings reveal that the choice of action space, observation modality, and training data distribution play critical roles in achieving generalization. Specifically, we show that policies trained with low-level actions and rich visual observations outperform those with high-level actions and sparse proprioceptive observations. Furthermore, we demonstrate that incorporating diverse, multi-task data during training significantly improves policy robustness and transferability. Our results provide actionable insights for designing generalist robot policies and highlight the importance of careful design choices in bridging the gap between specialized and generalist capabilities in robotics.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Bao},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Faithbench: {A}},
 url = {https://arxiv.org/abs/2410.13210},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:11:32Z},
 year = {2024}
}

@article{bao_mindwell_2025,
 abstract = {Multimodal fusion is a fundamental problem in many real-world applications, such as autonomous driving, healthcare, and surveillance. In recent years, deep learning has emerged as a powerful tool for multimodal fusion, enabling the integration of different data modalities, such as images, text, and audio, in a unified framework. This paper provides a comprehensive survey of deep learning methods for multimodal fusion, covering the main architectures, techniques, and applications. We discuss the challenges and open issues in this field and provide insights into future research directions.},
