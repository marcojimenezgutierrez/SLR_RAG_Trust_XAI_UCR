 keywords = {conversational question answering},
 note = {event-place: Sydney NSW},
 pages = {1053--1057},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {Preference-based {Learning}},
 url = {https://doi.org/10.1145/3701716.3715544},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:02:13Z},
 year = {2025}
}

@inproceedings{kalirai_toward_2024,
 abstract = {Programming-by-example (PBE) is a promising approach for enabling end-users to automate repetitive tasks without programming expertise. However, existing PBE systems often require users to provide multiple examples to infer the intended program, which can be tedious and error-prone. We propose a novel PBE system that leverages large language models (LLMs) to generate programs from a single example and a natural language description of the task. Our system, called LLM-PBE, uses an LLM to translate the user's description into a program sketch, which is then refined using the provided example. We evaluate LLM-PBE on a benchmark of 100 real-world tasks and find that it outperforms state-of-the-art PBE systems in terms of accuracy and user effort. Our user study with 20 participants shows that LLM-PBE enables users to automate tasks 2.5x faster than traditional PBE systems. We also discuss the limitations of our approach and opportunities for future work.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Kalirai},
 booktitle = {Proceedings of the 29th {International}},
 doi = {10.1145/3640543.3645201},
