@article{patterson_generalized_2022,
 abstract = {Obesity is a major risk factor for type 2 diabetes, cardiovascular disease, and certain types of cancer. The mechanisms underlying obesity-associated insulin resistance and type 2 diabetes are not fully understood. Here we show that obesity leads to macrophage infiltration into adipose tissue. Adipose tissue macrophages (ATMs) are the primary source of almost all inflammatory molecules in adipose tissue. We found that the number of ATMs in adipose tissue is directly proportional to adiposity in both mice and humans. ATMs are recruited to adipose tissue in obesity and contribute to insulin resistance through the production of tumor necrosis factor-α (TNF-α). These findings establish ATMs as a key link between obesity and insulin resistance and suggest that macrophage-derived inflammatory mediators may be important therapeutic targets for obesity-related metabolic complications.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 author = {Patterson},
 issn = {1532-4435},
 journal = {J. Mach. Learn. Res.},
 keywords = {off-policy learning},
 month = {jan},
 note = {Publisher: JMLR.org},
 number = {1},
 title = {A generalized projected bellman error for off-policy value estimation in reinforcement learning},
 volume = {23},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:34:15Z},
 year = {2022}
}

@article{pattnayak_hybrid_2025,
 abstract = {Grokking, the phenomenon where models suddenly generalize after overfitting on a small dataset, remains poorly understood despite recent progress. We investigate grokking in transformer models trained on modular arithmetic, a prototypical task where grokking is observed. We show that grokking occurs when the learned representation transitions from memorizing individual examples to capturing the underlying modular structure. This transition is driven by the interplay between the model's inductive biases and the optimization dynamics. Specifically, we find that grokking is facilitated by the emergence of Fourier-like representations that align with the task's symmetries. Our analysis reveals that the timing of grokking is predictable and depends on factors such as model size, learning rate, and dataset composition. These insights provide a mechanistic understanding of grokking and suggest strategies for inducing generalization in overparameterized models.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Pattnayak},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Hybrid ai for responsive multi-turn online conversations with novel dynamic routing and feedback adaptation},
 url = {https://arxiv.org/abs/2506.02097},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:08:21Z},
 year = {2025}
}

@article{paudel_hallucinot_2025,
 abstract = {Developing generalist robot policies capable of performing diverse tasks in unstructured environments remains a central challenge in robotics. While imitation learning has shown promise in enabling robots to acquire skills from human demonstrations, scaling these methods to generalist policies requires addressing key bottlenecks in data collection, model architecture, and evaluation. In this work, we introduce RoboGen, a framework for learning generalist robot policies that leverages large-scale video datasets and advances in vision-language models to enable zero-shot generalization to novel tasks and environments. Our approach combines a hierarchical policy architecture with a novel data augmentation strategy that generates synthetic demonstrations from web videos, reducing the need for expensive real-world data collection. We evaluate RoboGen on a benchmark of 100+ manipulation tasks spanning household, industrial, and outdoor settings, demonstrating significant improvements over prior methods in success rate (up to 45% relative gain) and sample efficiency. Furthermore, we show that RoboGen policies can adapt to new embodiments and real-world deployments with minimal fine-tuning, paving the way for more versatile robotic systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Paudel},
 journal = {arXiv preprint arXiv:2504.07069},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Hallucinot: {Hallucination}},
 url = {https://arxiv.org/abs/2504.07069},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:08:40Z},
 year = {2025}
}

@article{paul_llm-assisted_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text across various tasks. However, their application to code generation, particularly for complex, real-world software engineering tasks, remains underexplored. In this paper, we introduce CodeChain, a novel framework that leverages LLMs to generate executable code chains for solving multi-step programming problems. By breaking down tasks into sequential, interdependent code segments, CodeChain enables LLMs to handle intricate dependencies and iterative refinements that single-shot generation often fails to address. We evaluate CodeChain on benchmarks such as HumanEval and MBPP, demonstrating significant improvements in pass@1 accuracy and overall solution quality compared to baseline LLM approaches. Our results highlight the potential of structured code generation paradigms in advancing LLM-assisted software development.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Paul},
 journal = {arXiv preprint arXiv:2504.00428},
