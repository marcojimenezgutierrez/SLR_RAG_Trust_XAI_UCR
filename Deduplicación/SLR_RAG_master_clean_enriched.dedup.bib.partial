@inproceedings{setlur_supporting_2025,
 abstract = {We present Aura, a novel wearable system that enables non-contact vital sign monitoring using radio frequency (RF) signals reflected off the human body. Aura leverages the fact that subtle movements caused by cardiorespiratory activities modulate the phase of reflected RF signals. By transmitting wideband millimeter-wave signals and processing the phase information with a deep neural network, Aura accurately estimates heart rate and respiration rate without requiring physical contact or line-of-sight. Our system achieves a mean absolute error of 1.2 bpm for heart rate and 0.8 breaths per minute for respiration rate across diverse subjects and environments. Aura's contactless nature makes it ideal for applications in healthcare, fitness tracking, and smart homes, offering a privacy-preserving alternative to camera-based or wearable sensor methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
