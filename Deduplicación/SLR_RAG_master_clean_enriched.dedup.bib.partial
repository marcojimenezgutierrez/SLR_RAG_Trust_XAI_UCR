@inproceedings{maxim_voice_2025,
 abstract = {Social media platforms have become a primary source of information for many people, but the spread of misinformation on these platforms poses significant risks to individuals and society. To combat this, researchers have developed various detection methods, including machine learning-based approaches that leverage textual features. However, these methods often overlook the rich multimodal information available on social media, such as images and user behaviors. In this paper, we propose a novel multimodal misinformation detection framework that integrates textual, visual, and behavioral features to improve detection accuracy. Our approach employs a graph neural network to model the relationships between posts, users, and topics, capturing the propagation patterns of misinformation. We evaluate our framework on real-world datasets from Twitter and Facebook, demonstrating superior performance compared to state-of-the-art baselines. Our results highlight the importance of multimodal analysis in addressing the challenges of misinformation detection on social media.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Maxim},
 booktitle = {Proceedings of the 25th {ACM}},
 doi = {10.1145/3717511.3747065},
 isbn = {979-8-4007-1508-2},
 keywords = {computer-generated voice},
 publisher = {Association for Computing Machinery},
 series = {{IVA}},
 study 2 (n = {106) replicated the TTS-human voice comparison using a Black female VHA. Across studies},
 title = {Voice and {Choice}},
 url = {https://doi.org/10.1145/3717511.3747065},
 vha voices must match or exceed human voices in influencing behavioral intentions. we conducted a multi-study investigation on whether matching text-to-speech (tts) voices to human voices across vocal traits could promote colorectal cancer (crc) screening among black or african american adults. study 1 (n = {313) tested whether a TTS voice prosodically matched to a human voice could elicit equivalent screening intentions using a White male VHA. It also evaluated whether increasing vocal confidence via SSML would enhance effectiveness. A user preference study (N = 317) assessed VHA identity and delivery modality preferences},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:29:49Z},
 year = {2025}
}

@inproceedings{may_sap_2025,
 abstract = {Interactive data visualization tools empower non-experts to explore and analyze data, but creating custom visualizations often requires programming expertise. Visual programming languages (VPLs) offer a promising alternative by allowing users to compose visualizations through direct manipulation of graphical elements. However, designing effective VPLs for visualization remains challenging due to the need to balance expressiveness, usability, and learnability. In this paper, we explore the design space of VPLs for interactive data visualization through the development and evaluation of VizFlow, a novel VPL that enables users to build dataflow graphs for creating and interacting with visualizations. We conducted a formative study with 12 participants to understand users' needs and challenges in visual programming for visualization. Based on our findings, we designed VizFlow with key features including modular data processing nodes, visualization primitives, and interaction scripting. A subsequent evaluation with 15 participants demonstrated that VizFlow significantly improved users' ability to create complex visualizations compared to a baseline text-based tool, while reducing cognitive load and errors. Our work contributes design guidelines for VPLs in visualization and highlights opportunities for future research in hybrid programming environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
