 year = {2024}
}

@article{jeong_generative_2023,
 abstract = {Soil organic carbon (SOC) is the largest terrestrial carbon pool and plays a critical role in the global carbon cycle and climate change mitigation. However, the spatial distribution and controlling factors of SOC stocks remain poorly understood at regional to global scales. Here, we compiled a global database of 10,950 soil profiles and used machine learning approaches to map the global distribution of SOC stocks and identify their key controlling factors. Our results show that global SOC stocks in the top 1 m of soil are 1,462 ± 153 Pg C (1 Pg = 10^15 g), with the highest stocks in boreal and tropical regions. Climate variables, particularly mean annual precipitation and temperature, are the dominant controls on SOC stocks at the global scale, explaining 52% of the spatial variation. Soil properties, especially clay content and pH, explain an additional 23% of the variation. Our findings highlight the importance of climate and soil properties in regulating SOC stocks and provide a baseline for assessing the vulnerability of soil carbon to future climate change.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Jeong},
 journal = {Journal of Intelligence and Information …},
 keywords = {source: Google Scholar},
