@inproceedings{noauthor_proceedings_2025-2,
 abstract = {This study explores the integration of artificial intelligence in sustainable urban planning. Using machine learning algorithms, we analyze urban growth patterns in major cities across Europe. Data from satellite imagery and census records were processed to predict future land use changes. Findings indicate that AI-driven models can reduce urban sprawl by 25% while enhancing green space allocation. Implications for policy makers include the adoption of predictive analytics for resilient city development.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
