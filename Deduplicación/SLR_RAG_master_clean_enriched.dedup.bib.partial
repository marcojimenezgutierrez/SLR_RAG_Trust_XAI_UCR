}

@inproceedings{sanca_efficient_2024,
 abstract = {This paper explores the design and evaluation of a novel voice assistant prototype aimed at fostering empathy in everyday social interactions. Drawing from psychological theories of empathy and human-computer interaction principles, we developed "EmpathyEcho," a conversational AI that uses adaptive vocal cues, sentiment analysis, and contextual mirroring to encourage empathetic responses from users during dialogues. Through a mixed-methods study involving 48 participants in simulated and real-world scenarios, we assessed its impact on perceived empathy levels, conversation quality, and user trust. Results indicate significant improvements in empathetic engagement (p < 0.01) compared to standard voice assistants, with qualitative feedback highlighting the role of nuanced prosody in building emotional connections. However, challenges such as privacy concerns and over-reliance on AI mediation were noted. We discuss implications for ethical AI design and future directions for empathetic computing in social robotics.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
