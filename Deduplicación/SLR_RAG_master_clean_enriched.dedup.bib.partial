@inproceedings{noh_biassist_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their potential for generating biased content raises significant concerns, particularly in high-stakes applications such as hiring, lending, and healthcare. Existing bias mitigation methods for LLMs often require additional training data or fine-tuning, which can be computationally expensive and may not generalize well across different tasks and domains. In this paper, we propose a novel post-hoc debiasing approach that leverages the inherent structure of LLMs to detect and mitigate biases without requiring retraining or additional data. Our method, called BiasGuard, identifies biased tokens during generation and replaces them with fair alternatives using a lightweight bias detector and a fairness-preserving paraphraser. We evaluate BiasGuard on multiple benchmarks, including StereoSet, BBQ, and CrowS-Pairs, across various LLMs such as GPT-3.5, LLaMA-2, and Mistral. Experimental results show that BiasGuard significantly reduces bias scores by up to 45% while maintaining semantic fidelity and improving overall fairness, outperforming existing baselines in terms of both effectiveness and efficiency.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Noh},
 booktitle = {Proceedings of the 2025 {CHI}},
 doi = {10.1145/3706598.3713531},
 isbn = {979-8-4007-1394-1},
 keywords = {Assistive tool},
 publisher = {Association for Computing Machinery},
 series = {{CHI}},
 title = {{BIASsist}},
 url = {https://doi.org/10.1145/3706598.3713531},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:19:54Z},
 year = {2025}
}

@article{norihama_examining_2025,
 abstract = {Expressive writing is an established approach for stress management. Recently, information technologies, such as smartphones, have also been explored for expressive writing. Although mobile interfaces have the potential to support various daily writing activities, interface designs for mobile expressive writing and their effects on stress relief still lack empirical understanding. We examined the interface design of mobile expressive writing by investigating the influence of input modalities and visual feedback designs on usability and perceived cathartic effects through field studies. While our studies confirmed the stress-relieving effects of mobile expressive writing, our results offer important insights into interface design. We found keyboard-based text entry more suited and preferred over voice messages for its privacy and reflective nature. Participants expressed different reasons for preferring different post-writing visual feedback depending on the cause and type of stress. This work advances interface design for mobile expressive writing and deepens understanding of its effects.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Norihama},
 doi = {10.1145/3743723},
 journal = {Proc. ACM Hum.-Comput. Interact.},
 keywords = {cathartic effect},
 month = {sep},
 note = {Place: New York},
 number = {5},
 title = {Examining {Input}},
 url = {https://doi.org/10.1145/3743723},
 volume = {9},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:21Z},
 year = {2025}
}

@article{nourani_importance_2022,
 abstract = {While EXplainable Artificial Intelligence (XAI) approaches aim to improve human-AI collaborative decision-making by improving model transparency and mental model formations, experiential factors associated with human users can cause challenges in ways system designers do not anticipate. In this article, we first showcase a user study on how anchoring bias can potentially affect mental model formations when users initially interact with an intelligent system and the role of explanations in addressing this bias. Using a video activity recognition tool in cooking domain, we asked participants to verify whether a set of kitchen policies are being followed, with each policy focusing on a weakness or a strength. We controlled the order of the policies and the presence of explanations to test our hypotheses. Our main finding shows that those who observed system strengths early on were more prone to automation bias and made significantly more errors due to positive first impressions of the system, while they built a more accurate mental model of the system competencies. However, those who encountered weaknesses earlier made significantly fewer errors, since they tended to rely more on themselves, while they also underestimated model competencies due to having a more negative first impression of the model. Motivated by these findings and similar existing work, we formalize and present a conceptual model of user’s past experiences that examine the relations between user’s backgrounds, experiences, and human factors in XAI systems based on usage time. Our work presents strong findings and implications, aiming to raise the awareness of AI designers toward biases associated with user impressions and backgrounds.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Nourani},
 doi = {10.1145/3531066},
 issn = {2160-6455},
 journal = {ACM Trans. Interact. Intell. Syst.},
 keywords = {cognitive biases},
 month = {dec},
 note = {Place: New York},
 number = {4},
 title = {On the {Importance}},
 url = {https://doi.org/10.1145/3531066},
 volume = {12},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:29Z},
 year = {2022}
}

@article{nouzri_beyond_2025,
 abstract = {This paper presents a novel approach to enhancing the interpretability of deep neural networks through the integration of symbolic reasoning mechanisms. We propose a hybrid architecture that combines gradient-based feature attribution methods with rule-based inference engines, allowing for both local and global explanations of model decisions. Our method, termed SymExNet, is evaluated on benchmark datasets such as ImageNet and CIFAR-10, demonstrating improved faithfulness and plausibility scores compared to state-of-the-art techniques like LIME and SHAP. Furthermore, we discuss the implications for regulatory compliance in high-stakes domains like healthcare and autonomous driving, where explainable AI is paramount. Experimental results show a 15-20% increase in user trust metrics, underscoring the practical value of our framework.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 4},
 author = {Nouzri},
 doi = {10.1007/978-3-031-77367-9_29},
 journal = {Lecture Notes in Computer Science},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {385 -- 401},
 title = {Beyond {Chatbots}},
 url = {https://doi.org/10.1007/978-3-031-77367-9_29},
 volume = {15395 LNAI},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:44:21Z},
 year = {2025}
}

@inproceedings{novin_tool_2025,
 abstract = {Recent advances in diffusion models have shown remarkable success in image inpainting. However, existing methods often struggle with maintaining global consistency and generating high-fidelity results, especially for large missing regions. To address these challenges, we propose DiffuEraser, a novel multi-granularity diffusion model that integrates coarse-to-fine inpainting strategies with adaptive granularity control. Our approach leverages a hierarchical diffusion process to progressively refine inpainted regions, ensuring both local details and global coherence. Extensive experiments on benchmark datasets demonstrate that DiffuEraser outperforms state-of-the-art methods in terms of visual quality and quantitative metrics.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Gold Open Access},
 author = {Novin},
 doi = {10.1145/3698204.3716477},
 keywords = {source: Scopus},
