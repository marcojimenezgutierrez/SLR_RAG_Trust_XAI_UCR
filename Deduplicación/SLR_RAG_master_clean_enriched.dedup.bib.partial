@inproceedings{chaudhary_developing_2024,
 abstract = {Python comments play a crucial role in program comprehension and maintenance. However, little is known about the characteristics of Python comments, especially in comparison to comments in other programming languages. In this paper, we conduct an empirical study on Python comments from 10 popular open-source projects on GitHub. We analyze the distribution, length, and content of comments, and compare them with Java comments. Our findings reveal that Python comments are shorter and less descriptive than Java comments, with a higher proportion of inline comments. We also identify common patterns in Python comments, such as TODOs and docstrings. These insights can guide developers in writing better comments and inform tool support for comment generation and analysis in Python.},
 abstract_lang = {en},
