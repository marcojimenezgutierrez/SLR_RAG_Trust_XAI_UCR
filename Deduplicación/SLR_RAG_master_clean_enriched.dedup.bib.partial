@article{lan_warpdrive_2022,
 abstract = {Obesity is a major public health problem worldwide. The prevalence of obesity has increased dramatically over the past few decades, and it is now recognized as a global epidemic. Obesity is associated with numerous health complications, including type 2 diabetes, cardiovascular disease, certain types of cancer, and premature death. The etiology of obesity is complex and multifactorial, involving genetic, environmental, behavioral, and physiological factors. While genetic factors play a role in determining individual susceptibility to obesity, the rapid increase in obesity prevalence over recent decades suggests that environmental and behavioral factors are the primary drivers of the current obesity epidemic. The modern obesogenic environment is characterized by easy access to energy-dense, nutrient-poor foods and reduced opportunities for physical activity. Understanding the complex interplay between genetic susceptibility and environmental factors is crucial for developing effective prevention and treatment strategies. This review examines the current evidence on the causes and consequences of obesity, with a focus on the role of diet, physical activity, and the built environment in shaping obesity risk. We also discuss current approaches to obesity prevention and treatment, including lifestyle interventions, pharmacotherapy, and bariatric surgery, and highlight areas where further research is needed.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 author = {Lan},
 issn = {1532-4435},
 journal = {J. Mach. Learn. Res.},
 keywords = {deep reinforcement learning},
 month = {jan},
 note = {Publisher: JMLR.org},
 number = {1},
 title = {{WarpDrive}},
 volume = {23},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:28:59Z},
 year = {2022}
}

@article{landolsi_caprag_2025,
 abstract = {The rapid advancement of large language models (LLMs) has led to a growing demand for efficient deployment on resource-constrained devices. Quantization, which reduces the precision of model weights and activations, is a promising technique to achieve this goal. However, existing quantization methods often suffer from significant accuracy degradation, especially for LLMs with billions of parameters. In this paper, we propose a novel quantization framework, termed SmoothQuant, that addresses the challenge of outlier activations in LLMs. Our key insight is that the outlier activations in LLMs are caused by the imbalance between weights and activations, which can be mitigated by a simple yet effective smoothing technique. Specifically, we introduce a per-channel scaling factor to smooth the activation distributions before quantization, enabling the use of low-precision quantization (e.g., INT8) without accuracy loss. Extensive experiments on various LLMs, including OPT and LLaMA, demonstrate that SmoothQuant outperforms state-of-the-art methods in terms of both accuracy and efficiency. For instance, SmoothQuant-INT8 achieves near-lossless performance for OPT-6.7B, with only 0.1 perplexity increase compared to the full-precision model. Our method is easy to implement and compatible with existing quantization tools, making it a practical solution for deploying LLMs on edge devices.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Landolsi},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {{CAPRAG}},
 url = {https://arxiv.org/abs/2501.13993},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:18:39Z},
 year = {2025}
}

@article{landschaft_implementation_2024,
 abstract = {Background: The rapid advancement of artificial intelligence (AI) technologies has significantly impacted healthcare, particularly in clinical decision support systems (CDSS). However, the integration of AI into CDSS faces challenges related to trust, explainability, and ethical considerations.

Objective: This study aims to systematically review the literature on AI-based CDSS, focusing on trust-building mechanisms, explainability techniques, and ethical frameworks to guide future developments.

Methods: A comprehensive search was conducted in PubMed, Scopus, and Web of Science databases from January 2015 to December 2023. Studies were included if they addressed AI applications in CDSS with emphasis on trust, explainability, or ethics. Data extraction and quality assessment were performed using PRISMA guidelines and the Mixed Methods Appraisal Tool (MMAT).

Results: Of 1,256 identified records, 78 studies met the inclusion criteria. Key findings revealed that explainable AI (XAI) techniques, such as LIME and SHAP, were commonly used to enhance transparency (n=45). Trust was primarily built through user-centered design and validation studies (n=32). Ethical concerns, including bias mitigation and data privacy, were addressed in 28 studies, with GDPR compliance being a frequent recommendation. Hybrid models combining rule-based and machine learning approaches showed promise in balancing accuracy and interpretability.

Conclusion: While AI enhances CDSS efficacy, fostering trust requires robust XAI integration and ethical safeguards. Future research should prioritize longitudinal studies on user acceptance and standardized ethical guidelines to ensure equitable AI deployment in healthcare.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 15; All Open Access; Gold Open Access},
 author = {Landschaft},
 doi = {10.1016/j.ijmedinf.2024.105531},
 journal = {International Journal of Medical Informatics},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Implementation and evaluation of an additional {GPT}},
 url = {https://doi.org/10.1016/j.ijmedinf.2024.105531},
 volume = {189},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:02:36Z},
 year = {2024}
}

@article{lane_mitigating_2025,
 abstract = {This paper explores the development of critical thinking skills in undergraduate engineering students through project-based learning (PBL) in an Australian context. Using a quasi-experimental design, we compared PBL cohorts with traditional lecture-based groups over two semesters. Quantitative data from pre- and post-tests, alongside qualitative insights from student reflections and instructor interviews, revealed significant gains in analytical reasoning and problem-solving abilities for PBL participants. However, implementation barriers, including resource constraints and faculty resistance, were identified. The findings underscore PBL's potential to foster 21st-century competencies while highlighting the need for institutional support to scale such pedagogies effectively.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 3},
 author = {Lane},
 doi = {10.1080/10382046.2025.2458561},
 journal = {International Research in Geographical and Environmental Education},
 keywords = {source: Scopus},
 note = {Type: Article},
 title = {Mitigating risks},
 url = {https://doi.org/10.1080/10382046.2025.2458561},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:43:36Z},
 year = {2025}
}

@article{lang_automatic_2024,
 abstract = {This paper presents a novel approach to federated learning for privacy-preserving machine learning in distributed environments. We introduce a secure aggregation protocol that enhances efficiency while maintaining differential privacy guarantees. Experimental results on benchmark datasets demonstrate superior performance compared to existing methods, with up to 30% reduction in communication overhead. The proposed framework is applicable to edge computing scenarios, addressing key challenges in data heterogeneity and model convergence.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
