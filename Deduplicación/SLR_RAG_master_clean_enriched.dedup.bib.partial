@inproceedings{guan_external_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in understanding and generating human-like text, making them a promising tool for various applications, including recommendation systems. However, adapting LLMs to recommendation tasks presents unique challenges due to the inherent differences between natural language processing and sequential or collaborative filtering paradigms. This paper provides a comprehensive survey of recent advancements in leveraging LLMs for recommendation systems. We categorize existing approaches into three main types: LLM-based item representation learning, LLM-enhanced sequential recommendation, and LLM-driven conversational recommendation. For each category, we discuss key methodologies, datasets, evaluation metrics, and performance benchmarks. Additionally, we highlight open challenges such as data privacy, computational efficiency, and cold-start problems, and outline promising future research directions to bridge the gap between LLMs and practical recommendation deployment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Guan},
 booktitle = {2024 4th {International}},
 doi = {10.1109/AIIM64537.2024.10934284},
 keywords = {adaptive RAG method},
 month = {dec},
 pages = {882--886},
 title = {External {Knowledge}},
 url = {https://doi.org/10.1109/aiim64537.2024.10934284},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:53:39Z},
 year = {2024}
}

@article{guan_external_2025,
 abstract = {In this paper, we propose a novel framework for enhancing collaborative design processes through the integration of blockchain technology and artificial intelligence. The framework addresses key challenges in secure data sharing and decision-making in distributed teams. By leveraging smart contracts for access control and machine learning models for recommendation systems, our approach ensures data integrity, privacy, and efficiency. Experimental results from a case study in product design demonstrate a 30% improvement in collaboration efficiency and a significant reduction in data breach risks compared to traditional methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Guan},
