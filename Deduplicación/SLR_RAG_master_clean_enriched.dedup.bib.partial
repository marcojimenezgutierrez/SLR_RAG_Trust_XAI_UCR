 x_enrich_ts = {2025-11-02T06:16:53Z},
 year = {2025}
}

@inproceedings{kim_cyberally_2025,
 abstract = {Wearable haptic devices offer promising avenues for enhancing user experiences in virtual reality (VR), gaming, and accessibility applications by providing tactile feedback. However, their design often assumes full upper-body mobility, excluding users with impairments such as those from spinal cord injuries or muscular dystrophy. This paper presents a co-design approach to create inclusive wearable haptics for people with upper-body mobility impairments. Through workshops with 12 participants, we identified key design considerations including modularity for easy attachment, adjustable intensity to accommodate sensitivity variations, and integration with assistive technologies. We developed HaptiCore, a prototype vest with interchangeable haptic modules that can be positioned via magnetic attachments and controlled through simple interfaces. User testing (n=8) showed high usability scores (SUS=82) and positive feedback on customization. Our work contributes guidelines for inclusive haptic design and demonstrates how participatory methods can bridge accessibility gaps in emerging technologies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Kim},
 booktitle = {Companion {Proceedings}},
 doi = {10.1145/3701716.3715171},
