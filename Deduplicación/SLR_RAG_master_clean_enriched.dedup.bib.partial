 title = {R-{Eval}},
 url = {https://doi.org/10.1145/3637528.3671564},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:51:30Z},
 year = {2024}
}

@inproceedings{tu_robust_2025,
 abstract = {Visual Question Answering (VQA) has seen significant progress with the advent of large vision-language models (LVLMs). However, current VQA benchmarks primarily focus on evaluating models' ability to answer questions about images, often overlooking their capacity to reason about complex visual scenes involving multiple objects and their relationships. To address this gap, we introduce a new benchmark, Multi-Object VQA (MO-VQA), which consists of questions that require understanding interactions between multiple objects in an image. MO-VQA includes diverse question types such as spatial relationships, object attributes in context, and causal reasoning. We evaluate state-of-the-art LVLMs on MO-VQA and find that while they perform well on single-object questions, their performance drops significantly on multi-object scenarios, highlighting the need for improved multi-object reasoning capabilities. Our benchmark provides a challenging yet realistic evaluation framework for advancing VQA research.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Tu},
 booktitle = {Proceedings of the 48th {International}},
