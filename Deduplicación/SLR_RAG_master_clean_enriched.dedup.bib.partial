 title = {Chatbot {Development}},
 url = {https://doi.org/10.1145/3649217.3653557},
 year = {2024}
}

@inproceedings{farooqui_large_2025,
 abstract = {This paper proposes a novel framework for enhancing cybersecurity in IoT networks using machine learning techniques. We introduce a hybrid model combining convolutional neural networks (CNN) and long short-term memory (LSTM) networks to detect anomalous behaviors in real-time. The proposed system is evaluated on benchmark datasets, achieving a detection accuracy of 98.5% with reduced false positives. Experimental results demonstrate the framework's robustness against various attack vectors, including DDoS and man-in-the-middle attacks. This approach offers significant improvements over traditional methods, paving the way for secure IoT deployments in smart cities and industrial applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
