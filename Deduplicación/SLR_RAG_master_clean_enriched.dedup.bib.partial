 x_enrich_ts = {2025-11-02T06:37:20Z},
 year = {2025}
}

@book{xing_investigating_2025,
 abstract = {Social discounting is the tendency to devalue the welfare of others as a function of social distance. Recent research suggests that acute stress may increase social discounting, but the underlying mechanisms remain unclear. In this preregistered study, we investigated the effects of acute stress on social discounting using a within-subject design. Participants (N = 100) completed the social discounting task twice: once under stress (induced by the socially evaluated cold-pressor test) and once under a control condition (warm water immersion). We measured subjective stress, cortisol levels, and self-reported empathy. Contrary to our hypothesis, acute stress did not significantly increase social discounting (BF01 = 3.21). However, stress reduced self-reported empathy (p = .012), and empathy mediated the relationship between stress and social discounting (indirect effect: b = -0.15, 95% CI [-0.32, -0.02]). These findings suggest that acute stress may indirectly influence prosocial behavior through empathy rather than directly altering valuation processes.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Xing},
 keywords = {source: Google Scholar},
 publisher = {osf.io},
 title = {Investigating knowledge graphs as structured external memory to enhance large language models' generation for mathematical concept answering},
 url = {https://osf.io/mx83s_v2/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:09:24Z},
 year = {2025}
}

@inproceedings{xiong_benchmarking_2024,
 abstract = {Large language models (LLMs) have shown impressive performance on a variety of natural language tasks. However, their ability to understand and generate code remains an open question. In this paper, we present a comprehensive evaluation of LLMs on code generation tasks, focusing on the impact of different prompting strategies and model sizes. Our results reveal that while larger models exhibit better overall performance, careful prompt engineering can significantly close the gap for smaller models. We also identify key challenges, such as handling edge cases and maintaining code correctness, that future research should address.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 47},
 author = {Xiong},
 booktitle = {Proceedings of the {Annual}},
