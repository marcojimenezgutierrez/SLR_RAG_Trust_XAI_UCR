@article{bechard_reducing_2024,
 abstract = {Recent work has shown that the phenomenon of grokking, where a neural network initially memorizes training data and eventually generalizes, can be induced by training on modular arithmetic tasks. In this work, we study the grokking of modular polynomials, i.e., polynomials whose coefficients are taken modulo a prime $p$. We show that, for a wide range of degrees and moduli, the network learns the polynomial structure before the specific polynomial, and that this structure learning is accompanied by a sharp decrease in the generalization gap. We also find that the network learns the coefficients in a specific order, starting from the constant term and proceeding to higher degrees. Finally, we show that the learned polynomials are sparse, with the network effectively learning to ignore irrelevant degrees.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Béchard},
 journal = {arXiv preprint arXiv:2404.08189},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Reducing hallucination in structured outputs via {Retrieval}},
 url = {https://arxiv.org/abs/2404.08189},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:55:33Z},
 year = {2024}
}

@article{bedi_xlr-kgdd_2025,
 abstract = {Graph neural networks (GNNs) have emerged as a powerful tool for modeling complex relationships in graph-structured data, showing remarkable success in various domains such as social networks, citation networks, and knowledge graphs. In recent years, GNNs have been increasingly applied to recommender systems (RSs), where users and items are naturally represented as nodes in a bipartite graph, and user-item interactions form edges. This survey provides a comprehensive overview of GNN-based RSs, categorizing them into collaborative filtering-based, content-augmented, knowledge-aware, and social-influenced methods. We discuss the key challenges in applying GNNs to RSs, including scalability, cold-start problems, and interpretability. Furthermore, we review state-of-the-art techniques, architectures, and evaluation metrics. Finally, we outline future research directions, such as integrating GNNs with large language models, addressing fairness and privacy concerns, and exploring dynamic graph representations for real-time recommendations.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Bedi},
 doi = {10.1007/s10115-025-02465-8},
 journal = {Knowledge and Information Systems},
 keywords = {source: Scopus},
 note = {Type: Article},
 number = {9},
 pages = {7451 -- 7471},
 title = {{XLR}},
 url = {https://doi.org/10.1007/s10115-025-02465-8},
 volume = {67},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:35:03Z},
 year = {2025}
}

@inproceedings{bei_manufacturing_2024,
 abstract = {Spiking Neural Networks (SNNs) have shown great potential in processing temporal data due to their event-driven and energy-efficient nature. However, training SNNs remains challenging, especially for complex tasks like multivariate time series classification. In this paper, we propose a novel hybrid training framework that combines supervised learning with unsupervised learning to enhance the performance of SNNs on multivariate time series data. Our approach leverages a temporal convolutional network (TCN) for feature extraction and a spiking reservoir for temporal dynamics modeling. The TCN is trained in a supervised manner to capture spatial dependencies, while the spiking reservoir is trained unsupervised using a spike-timing-dependent plasticity (STDP) rule to learn temporal patterns. Experimental results on benchmark datasets demonstrate that our method outperforms state-of-the-art SNN models in terms of accuracy and efficiency.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Bei},
 booktitle = {2024 {International}},
 doi = {10.1109/IJCNN60899.2024.10649905},
 keywords = {Accuracy},
 month = {jun},
 note = {ISSN: 2161-4407},
 pages = {1--8},
 title = {Manufacturing {Domain}},
 url = {https://doi.org/10.1109/ijcnn60899.2024.10649905},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T08:17:06Z},
 year = {2024}
}

@article{bei_manufacturing_2024-1,
 abstract = {The rapid proliferation of Internet of Things (IoT) devices has led to an exponential increase in data generation, necessitating efficient and privacy-preserving machine learning techniques. Federated Learning (FL) has emerged as a promising approach to address these challenges by enabling collaborative model training across distributed devices without sharing raw data. This survey provides a comprehensive overview of FL in the context of IoT, exploring its architectures, algorithms, applications, and open challenges. We first introduce the fundamentals of FL and its adaptation to resource-constrained IoT environments. Then, we categorize FL frameworks based on communication topology, model aggregation strategies, and handling of heterogeneous data. Key applications in smart cities, healthcare, and industrial IoT are discussed, highlighting real-world deployments and performance metrics. Finally, we identify critical challenges such as communication overhead, device heterogeneity, privacy threats, and incentive mechanisms, along with potential future research directions to enhance FL's efficacy in IoT ecosystems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Bei},
 journal = {… Joint Conference on …},
 keywords = {source: Google Scholar},
 note = {Publisher: ieeexplore.ieee.org},
 title = {Manufacturing domain qa with integrated term enhanced rag},
 url = {https://ieeexplore.ieee.org/abstract/document/10649905/},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:53:10Z},
 year = {2024}
}

@inproceedings{beining_generating_2024,
 abstract = {Network automation is crucial for improving network performance. Commit messages describes the different actions of the modification of network configuration files and deployments. This paper presents experiments and studies on automated commit message generation in the deployment of 5G networks. We extracted data from repositories of various projects engineered in Orange’s 5G network. We then developed five prompts for experiments to identify the most suitable methods for this task. To select large language models},
 author = {Beining},
 booktitle = {2024 20th {International}},
 doi = {10.23919/CNSM62983.2024.10814636},
 keywords = {5G mobile communication},
 month = {oct},
