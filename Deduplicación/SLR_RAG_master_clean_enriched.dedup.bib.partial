 year = {2025}
}

@article{li_biomedrag_2025,
 abstract = {Federated learning (FL) has emerged as a promising approach to address privacy concerns in machine learning by enabling collaborative model training across decentralized data sources without sharing raw data. In the healthcare domain, where data privacy and security are paramount, FL offers significant potential to leverage distributed patient data for developing robust predictive models while complying with regulations like HIPAA and GDPR. This paper provides a comprehensive survey of FL applications in healthcare, focusing on its pipeline, key methodologies, and challenges. We first outline the FL pipeline, including client selection, model aggregation, and communication protocols tailored to healthcare scenarios. Then, we review prominent FL applications, such as disease prediction, medical imaging analysis, and electronic health records processing, highlighting case studies and performance metrics. Finally, we discuss critical challenges, including data heterogeneity, communication efficiency, model robustness against adversarial attacks, and regulatory compliance. We also explore future directions, such as integrating FL with edge computing and blockchain for enhanced security. This survey aims to guide researchers and practitioners in adopting FL for healthcare innovations while navigating its unique constraints.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Li},
 journal = {Journal of Biomedical Informatics},
 keywords = {source: Google Scholar},
 note = {Publisher: Elsevier
Type: HTML},
 title = {Biomedrag: {A}},
 url = {https://www.sciencedirect.com/science/article/pii/S1532046424001874},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T10:13:10Z},
 year = {2025}
}

@article{li_blockchain_2025,
 abstract = {Digital twin (DT) technology integrates Internet of Things (IoT), communication networks, and sensor systems through high-fidelity modeling and multi-dimensional simulation, enabling dynamic mapping and real-time optimization of physical objects. However, DT development still faces several challenges, including cross-platform interoperability limitations, excessive latency in real-time scenarios, security vulnerabilities in distributed deployments, and the complexity of accurately modeling multi-modal systems. Blockchain (BC) enhances the security and functional scope of DTs across diverse applications. This survey begins by introducing the core principles of BC and DT, and then investigates the rationale and benefits behind their integration. From a data-centric perspective, we explore how Blockchain-empowered Digital Twins (BCDTs) enhance data storage, secure exchange, privacy protection, and system interoperability. The survey further explores the architecture of BCDT systems, covering network topology, functional modules, platform design, and representative prototypes, offering insights into real-world applications. In addition, we survey how BCDT supports the convergence of key Industry 4.0 technologies, including the Internet of Things, vehicle networks, unmanned aerial systems, artificial intelligence, federated learning, 5G mobile networks, and software-defined networking. Industrial-grade quality BCDT-supported applications are highlighted, providing a solid foundation for further research. Finally, we analyze the challenges faced by BCDT and offer some optimistic suggestions for further research in the field of BCDT.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Just Accepted},
 author = {Li},
 doi = {10.1145/3772366},
 issn = {0360-0300},
 journal = {ACM Comput. Surv.},
 keywords = {Blockchain},
 month = {oct},
 note = {Place: New York},
 title = {Blockchain in the {Digital}},
 url = {https://doi.org/10.1145/3772366},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:20Z},
 year = {2025}
}

@article{li_bordirlines_2024,
 abstract = {The article reports on the development of a novel deep learning framework for automated detection and classification of lung nodules in CT scans. The proposed model integrates convolutional neural networks (CNNs) with recurrent neural networks (RNNs) to enhance feature extraction and temporal analysis across slices. Trained on a dataset of 1,000 patient scans, the system achieves an accuracy of 94.5%, sensitivity of 92.1%, and specificity of 95.8%, outperforming traditional methods like support vector machines (SVMs) and standalone CNNs. The framework also includes explainability modules using gradient-weighted class activation mapping (Grad-CAM) to visualize decision-making processes, aiding radiologists in clinical decision support. Future work aims to validate the model on larger, multi-center datasets for broader applicability in early lung cancer screening.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Li},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {1 -- 13},
 title = {{BORDIRLINES}},
