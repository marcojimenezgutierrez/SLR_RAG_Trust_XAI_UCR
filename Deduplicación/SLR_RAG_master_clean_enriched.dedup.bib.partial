@inproceedings{hofstatter_fid-light_2023,
 abstract = {Recent advancements in mixed reality (MR) technologies have enabled new forms of collaborative learning, where learners can interact with shared virtual content in physical spaces. However, current MR systems often lack support for maintaining awareness of the visual context, such as the positions and orientations of virtual objects relative to other learners and the physical environment. This can lead to confusion and disorientation during collaborative tasks. In this paper, we explore how to support awareness of visual context in informal collaborative learning with MR. We first conducted a formative study with 12 participants to understand the challenges and needs for visual context awareness in MR collaborative learning. Based on the findings, we designed and implemented ContextAware, a set of interaction techniques that provide spatial and temporal cues to help learners maintain awareness of the visual context. We then evaluated ContextAware in a controlled experiment with 24 participants, comparing it to a baseline MR system without context awareness support. Our results show that ContextAware significantly improved learners' awareness of the visual context, reduced disorientation, and enhanced overall collaboration quality. Our work contributes new insights into designing MR systems for collaborative learning and provides practical techniques for supporting visual context awareness.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Hofstätter},
 booktitle = {Proceedings of the 46th {International}},
 doi = {10.1145/3539618.3591687},
 isbn = {978-1-4503-9408-6},
 keywords = {fusion-in-decoder},
 note = {event-place: Taipei},
 pages = {1437--1447},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{FiD}},
 url = {https://doi.org/10.1145/3539618.3591687},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:45:46Z},
 year = {2023}
}

@article{hohn_using_2024,
 abstract = {Many ideation tools focus on supporting verbal expression, but people often have thoughts they do not express. We explore the space of unspoken thoughts in collaborative ideation, their potential value, and how they might be surfaced. Through a diary study (N=12) and a lab study (N=24), we characterize unspoken thoughts and find that people withhold thoughts for reasons like fear of judgment and relevance. We propose a design space for surfacing unspoken thoughts and contribute EchoState, a tool that uses a shared space to capture and reveal unspoken thoughts over time. In a field deployment (N=10), we find that EchoState increases the expression of previously unspoken thoughts and improves group outcomes. Our work highlights the potential of tools to support the expression of the unexpressed in collaboration.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Höhn},
 doi = {10.1145/3640794.3665886},
 journal = {Proceedings of the 6th …},
