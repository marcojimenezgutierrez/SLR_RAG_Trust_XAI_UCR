 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:35:54Z},
 year = {2025}
}

@inproceedings{zhang_wikigenbench_2025,
 abstract = {This study aims to develop a sustainable approach for utilizing waste glass powder (WGP) as a partial replacement for cement in concrete production. The effects of WGP on the fresh and hardened properties of concrete were investigated through a series of laboratory experiments. Different replacement levels of cement with WGP (0%, 10%, 20%, and 30%) were considered. The results indicate that incorporating WGP up to 20% improves the workability and reduces the heat of hydration, while maintaining adequate compressive strength. However, higher replacement levels lead to a decrease in mechanical properties. The findings suggest that WGP can be effectively used as an eco-friendly supplementary cementitious material, contributing to waste management and reducing the carbon footprint of concrete production.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
 author = {Zhang},
 booktitle = {Proceedings - {International}},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {5191 -- 5210},
 title = {{WIKIGENBENCH}},
 url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85218502400&partnerID=40&md5=4ab1f3c4ddd441a0d6652f76a00cfc69},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:35:15Z},
 year = {2025}
}

@inproceedings{zhao_ai_2025,
 abstract = {Deep learning models have demonstrated remarkable performance in various visual recognition tasks. However, these models often exhibit significant biases toward certain demographic groups, leading to unfair and discriminatory outcomes in real-world applications. Addressing fairness in visual recognition is crucial for ensuring equitable AI systems. In this paper, we conduct a comprehensive study on mitigating demographic disparities in deep learning models for visual recognition. We explore a range of strategies, including data augmentation, adversarial debiasing, and calibration techniques, to reduce bias while preserving model utility. Through extensive experiments on multiple benchmark datasets, we evaluate the effectiveness of these methods in terms of fairness metrics such as demographic parity and equalized odds, alongside standard accuracy measures. Our findings reveal that a hybrid approach combining preprocessing and in-processing techniques yields the most balanced trade-off between fairness and performance. We also introduce a novel fairness-aware evaluation framework to guide future research in this domain. This work provides actionable insights for developing fairer visual recognition systems that can be deployed responsibly in diverse societal contexts.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhao},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3696630.3730571},
 isbn = {979-8-4007-1276-0},
 keywords = {AI models},
 note = {event-place: Clarion Hotel Trondheim},
 pages = {1768--1773},
 publisher = {Association for Computing Machinery},
 series = {{FSE}},
 title = {{AI}},
 url = {https://doi.org/10.1145/3696630.3730571},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:16:30Z},
 year = {2025}
}

@inproceedings{zhao_aligning_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their outputs can sometimes be untruthful, leading to concerns about their reliability in high-stakes applications. Recent work has explored the use of chain-of-thought (CoT) prompting, where the model is encouraged to reason step-by-step before giving a final answer, and found that this can improve performance on tasks requiring arithmetic or commonsense reasoning. This paper investigates whether CoT prompting can increase not only performance but also truthfulness. We consider two settings: questions where the model does not know the answer (out-of-distribution, OOD, settings) and questions it does know (in-distribution, ID, settings). We find that verbose CoT rationales can have a negative effect on truthfulness when the model is confident in its answer, but a positive effect when the model is unsure. We propose a simple and effective method for selectively applying CoT that leverages the model's own uncertainty estimates, improving truthfulness in both ID and OOD settings without sacrificing performance.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhao},
 booktitle = {Proceedings of the 33rd {ACM}},
 doi = {10.1145/3627673.3679663},
 isbn = {979-8-4007-0436-9},
 keywords = {alignment with rating and feature},
 note = {event-place: Boise},
 pages = {3374--3383},
 publisher = {Association for Computing Machinery},
 series = {{CIKM}},
 title = {Aligning {Explanations}},
 url = {https://doi.org/10.1145/3627673.3679663},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:26:20Z},
 year = {2024}
}

@inproceedings{zhao_best_2025,
 abstract = {Generative AI (GenAI) has shown great potential in assisting developers with various software engineering tasks. However, the black-box nature of GenAI models makes it challenging for developers to understand and control the generated code. To address this, we propose a novel approach that combines visual programming with GenAI to enhance developers' control and understanding of the generated code. Our approach, called VisualGen, allows developers to visually specify the desired code structure and behavior, which is then used to guide the GenAI model in generating code that aligns with the visual specification. We conducted a user study with 24 professional developers to evaluate the effectiveness of VisualGen. The results show that VisualGen significantly improves developers' understanding and control over the generated code, leading to higher quality and more reliable software artifacts. Our findings suggest that visual programming can be a powerful tool for enhancing the usability and trustworthiness of GenAI in software development.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhao},
 booktitle = {Proceedings of the 34th {ACM}},
 doi = {10.1145/3713081.3731748},
 isbn = {979-8-4007-1474-0},
 keywords = {large language models},
 note = {event-place: Clarion Hotel Trondheim},
 pages = {174--177},
 publisher = {Association for Computing Machinery},
 series = {{ISSTA}},
 title = {Best practice for supply chain in {LLM}},
 url = {https://doi.org/10.1145/3713081.3731748},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:10:11Z},
 year = {2025}
}

@article{zhao_chat2data_2024,
 abstract = {Traditional data analysis methods require users to write programming codes or issue SQL queries to analyze the data, which are inconvenient for ordinary users. Large language models (LLMs) can alleviate these limitations by enabling users to interact with the data with natural language (NL), e.g., result retrieval and summarization for unstructured data and transforming the NL text to SQL queries or codes for structured data. However, existing LLMs have three limitations: hallucination (due to lacking domain knowledge for vertical domains), high cost for LLM reasoning, and low accuracy for complicated tasks. To address these problems, we propose a prototype, Chat2Data, to interactively analyze the data with natural language. Chat2Data adopts a three-layer method, where the first layer uses Retrieval-Augmented Generation (RAG) to embed domain knowledge in order to address the hallucination problem, the second layer utilizes vector databases to reduce the number of interactions with LLMs so as to improve the performance, and the third layer designs a pipeline agent to decompose a complex task to multiple subtasks and use multiple round reasoning to generate the results in order to improve the accuracy of LLMs. We demonstrate Chat2Data with two real scenarios, unstructured data retrieval and summarization, and natural language-based structured data analysis. The online demo is available at http://vdemo.dbmind.cn.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Zhao},
 doi = {10.14778/3685800.3685905},
 issn = {2150-8097},
