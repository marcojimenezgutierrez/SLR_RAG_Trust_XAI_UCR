@inproceedings{martinez_enhancing_2025,
 abstract = {Diabetes mellitus is a metabolic disorder characterized by hyperglycemia resulting from defects in insulin secretion, insulin action, or both. The chronic hyperglycemia of diabetes is associated with long-term damage, dysfunction, and failure of various organs, especially the eyes, kidneys, nerves, heart, and blood vessels. Several pathogenic processes are involved in the development of diabetes. These range from autoimmune destruction of the β-cells of the pancreas with consequent insulin deficiency to abnormalities that result in resistance to insulin action. The basis of the abnormalities in carbohydrate, fat, and protein metabolism in diabetes is deficient action of insulin on target tissues. Deficient insulin action results from inadequate insulin secretion and/or diminished tissue responses to insulin at one or more points in the complex pathways of hormone action. Impairment of insulin secretion and defects in insulin action frequently coexist in the same patient, and it is often unclear which abnormality, if either alone, is the primary cause of the hyperglycemia.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 address = {Orlando},
 author = {Martínez},
 booktitle = {Proceedings of the {Winter}},
 isbn = {979-8-3315-3420-2},
 keywords = {source: ACM},
 pages = {666--677},
 publisher = {IEEE Press},
 series = {{WSC}},
 title = {Enhancing {GPT}},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:15:57Z},
 year = {2025}
}

@article{martinon_towards_2025,
 abstract = {We introduce a new benchmark for evaluating the capabilities of vision-language models (VLMs) on visual question answering (VQA) tasks involving complex reasoning. Our benchmark, named ComplexVQA, consists of 10,000 questions that require multi-step reasoning over images, covering diverse domains such as science, history, and everyday scenarios. Unlike existing VQA datasets, ComplexVQA emphasizes compositional reasoning, where answers depend on integrating multiple visual and linguistic cues. We evaluate several state-of-the-art VLMs, including GPT-4V and LLaVA, and find that even top-performing models struggle with questions requiring more than two reasoning steps, achieving accuracy below 30% on hard examples. Our analysis reveals key failure modes, such as hallucination and inability to track multi-object relations. We release ComplexVQA to facilitate further research in advancing VLM reasoning abilities.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Martinon},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Towards a rigorous evaluation of {RAG}},
 url = {https://arxiv.org/abs/2507.21753},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:21:42Z},
 year = {2025}
}

