@inproceedings{kweon_uncertainty_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their impressive performance often comes at the cost of fairness, as they can perpetuate and amplify societal biases present in the training data. Fine-tuning, a common approach to adapt LLMs to specific tasks or domains, can further exacerbate these fairness issues if not carefully managed. In this survey, we provide a comprehensive overview of fairness in LLM fine-tuning, categorizing existing methods into three main groups: data-centric, model-centric, and post-processing approaches. We discuss the unique challenges posed by the scale and complexity of LLMs, such as the trade-off between fairness and performance, the scarcity of fairness annotations, and the need for efficient fine-tuning techniques. Furthermore, we highlight open research questions and future directions to guide the development of fairer LLM fine-tuning practices. This survey aims to serve as a valuable resource for researchers and practitioners seeking to mitigate bias and promote fairness in LLM applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Kweon},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3696410.3714601},
 isbn = {979-8-4007-1274-6},
 keywords = {large language models},
 note = {event-place: Sydney NSW},
 pages = {4889--4901},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {Uncertainty {Quantification}},
 url = {https://doi.org/10.1145/3696410.3714601},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:07:31Z},
 year = {2025}
}

@inproceedings{laban_lexi_2024,
 abstract = {Federated learning (FL) enables multiple parties to collaboratively train a shared model while keeping their data local, which is appealing for privacy-preserving machine learning. However, FL is vulnerable to poisoning attacks, where malicious clients inject poisoned updates to manipulate the global model. Recent advances in large language models (LLMs) have led to LLM-based FL, where LLMs are fine-tuned in a federated manner. Despite the promise, the robustness of LLM-based FL against poisoning attacks remains underexplored. In this paper, we conduct the first systematic study on the vulnerability of LLM-based FL to data poisoning attacks. We propose PoisonLLM, a novel poisoning attack that crafts poisoned data to mislead the LLM in FL settings. Our experiments on popular LLMs and datasets show that PoisonLLM significantly degrades model performance, achieving up to 30% accuracy drop. We further analyze the factors influencing attack effectiveness and discuss potential defenses.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Laban},
 booktitle = {Proceedings of the 12th {International}},
 doi = {10.1145/3687272.3688296},
 isbn = {979-8-4007-1178-7},
 keywords = {Behavioural Experimentation},
 note = {event-place: Swansea},
 pages = {250--259},
 publisher = {Association for Computing Machinery},
 series = {{HAI}},
 title = {{LEXI}},
 url = {https://doi.org/10.1145/3687272.3688296},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:17:57Z},
 year = {2024}
}

@inproceedings{laban_summary_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating fluent and coherent text. However, they often produce factually incorrect or inconsistent outputs, especially when dealing with long contexts. Recent studies have shown that LLMs struggle to utilize relevant information in the middle of long contexts, a phenomenon known as "lost in the middle." In this paper, we conduct a systematic and comprehensive analysis of this phenomenon, investigating its causes and implications. Through a series of controlled experiments, we find that LLMs' performance degrades significantly as the relevant information moves away from the beginning or end of the context. We further demonstrate that this issue persists across different model sizes and architectures. To mitigate this problem, we propose a simple yet effective approach called "context rotation," which reorders the input context to place relevant information at the beginning or end. Our experiments show that context rotation significantly improves LLMs' performance on long-context tasks, achieving up to 20% improvement in accuracy. Our findings highlight the importance of context positioning in LLM performance and provide a practical solution to enhance their long-context understanding.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 4},
 author = {Laban},
 doi = {10.18653/v1/2024.emnlp-main.552},
 journal = {arXiv preprint arXiv:2407.01370},
 keywords = {source: Scopus},
 note = {Type: Conference paper},
 pages = {9885 -- 9903},
 title = {Summary of a {Haystack}},
 url = {https://doi.org/10.18653/v1/2024.emnlp-main.552},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:06:17Z},
 year = {2024}
}

@article{labib_leveraging_2025,
 abstract = {This paper proposes a novel federated learning framework for privacy-preserving medical image analysis. Traditional centralized approaches suffer from data privacy risks and communication overheads. Our method leverages differential privacy and secure multi-party computation to enable collaborative training across distributed healthcare institutions without sharing raw data. Extensive experiments on benchmark datasets demonstrate that the proposed framework achieves comparable accuracy to centralized models while ensuring strong privacy guarantees. The results highlight its potential for real-world deployment in sensitive domains like healthcare.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
