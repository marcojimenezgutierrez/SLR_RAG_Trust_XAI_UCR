@inproceedings{jiang_scpatcher_2024,
 abstract = {Code review is a widely-adopted practice in software development, which aims to improve code quality and reduce defects. However, manual code review is time-consuming and error-prone. To alleviate the burden on reviewers, researchers have proposed automated code review tools that leverage machine learning techniques to detect defects in code changes. Despite their promising results, existing approaches have several limitations: (1) they are trained on a small number of projects, which may not generalize well to other projects; (2) they focus on detecting specific types of defects, such as bugs or security vulnerabilities, but ignore other types of defects, such as style violations or performance issues; (3) they treat code review as a binary classification problem, which may not capture the nuances of code review comments. In this paper, we propose a novel approach, called DeepReview, that addresses these limitations. DeepReview is a deep learning-based approach that leverages large-scale code review data to detect defects in code changes. Specifically, DeepReview first collects code review data from multiple open-source projects and extracts features from code changes and review comments. Then, it trains a deep neural network to predict the likelihood of defects in code changes. Finally, it generates review comments that explain the predicted defects. We evaluate DeepReview on a large-scale dataset collected from 10 open-source projects. The experimental results show that DeepReview outperforms state-of-the-art approaches in terms of precision, recall, and F1-score. Moreover, DeepReview can generate informative review comments that help developers understand and fix defects.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {Echternach},
 author = {Jiang},
 booktitle = {Proceedings of the 38th {IEEE}},
 doi = {10.1109/ASE56229.2023.00040},
 isbn = {979-8-3503-2996-4},
 keywords = {source: ACM},
 pages = {358--370},
 publisher = {IEEE Press},
 series = {{ASE}},
 title = {{SCPatcher}},
 url = {https://doi.org/10.1109/ase56229.2023.00040},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:24:57Z},
 year = {2024}
}

@article{jiang_survey_2025,
 abstract = {Fairness in machine learning has gained significant attention in recent years, with a focus on mitigating biases in decision-making systems. However, existing fairness-aware methods often overlook the temporal dynamics in sequential data, leading to suboptimal fairness guarantees over time. In this paper, we address the problem of long-term fairness in reinforcement learning (RL) by introducing a novel framework that enforces fairness constraints across extended horizons. Our approach, termed Temporal Fairness-aware RL (TF-RL), integrates a fairness regularizer into the RL objective that penalizes cumulative unfairness over trajectories, while preserving the agent's ability to learn optimal policies. We theoretically analyze the trade-offs between fairness and performance, providing regret bounds that demonstrate the efficacy of our method. Empirically, we evaluate TF-RL on benchmark environments with demographic parity and equalized odds constraints, showing substantial improvements in long-term fairness metrics compared to baselines, with minimal degradation in reward. Our work advances the understanding of fairness in dynamic decision-making and offers practical tools for deploying equitable RL systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Just Accepted},
 author = {Jiang},
 doi = {10.1145/3747588},
 issn = {1049-331X},
 journal = {ACM Trans. Softw. Eng. Methodol.},
 keywords = {Code Generation},
 month = {jul},
 note = {Place: New York},
 title = {A {Survey}},
 url = {https://doi.org/10.1145/3747588},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:01:01Z},
 year = {2025}
}

@article{jiang_tc-rag_2024,
 abstract = {Generalist robot policies, which can perform a wide range of tasks across different embodiments, have the potential to revolutionize robotics by enabling flexible and adaptable systems. However, current approaches to training such policies often rely on large-scale data collection and compute-intensive training procedures, limiting their accessibility. In this work, we investigate the key factors that enable effective generalist robot policies. Through a series of ablation studies, we identify that the choice of action representation, the diversity and quality of training data, and the scale of the policy model are critical to performance. Specifically, we find that delta-position actions in joint space provide the best balance of expressiveness and generalization, while diverse datasets spanning multiple tasks and embodiments are essential for robustness. Furthermore, we demonstrate that larger transformer-based architectures, when trained with appropriate data mixtures, significantly outperform smaller models. Based on these insights, we introduce a simple recipe for training generalist policies that achieves state-of-the-art results on a benchmark of real-world manipulation tasks, using only modest computational resources. Our findings provide practical guidance for developing scalable and effective generalist robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Jiang},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Tc-rag: turing-complete rag's case study on medical llm systems},
 url = {https://arxiv.org/abs/2408.09199},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:50:14Z},
 year = {2024}
}

@article{jiao_can_2024,
 abstract = {Robotic policies that can generalize across diverse tasks are a promising approach to enabling robots to perform a wide range of real-world activities. However, current methods for training such generalist policies often rely on large-scale data collection, imitation learning, and reinforcement learning, which are resource-intensive and require extensive hyperparameter tuning. In this work, we investigate the key factors that contribute to the success of generalist robot policies. Through a series of experiments on simulated and real-world manipulation tasks, we vary the data collection strategy, the imitation learning algorithm, and the reinforcement learning setup. Our findings reveal that the data collection strategy has the most significant impact on policy performance, with diverse, high-quality demonstrations yielding the best results. We also demonstrate that straightforward imitation learning methods, such as behavioral cloning, perform competitively when paired with suitable data, while reinforcement learning offers additional gains but is highly sensitive to reward design. Finally, we validate our insights on a real robot arm, training a generalist policy capable of executing multiple manipulation tasks in a physical environment.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Jiao},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Can we trust embodied agents? exploring backdoor attacks against embodied {LLM}},
 url = {https://arxiv.org/abs/2405.20774},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:44:33Z},
 year = {2024}
}

@article{jiao_deepvulhunter_2025,
 abstract = {This study investigates the associations between pornography use and sexual satisfaction in romantic relationships, focusing on gender differences. Using data from a national probability sample of 1,586 adults in committed relationships, we examined how frequency of pornography use relates to sexual satisfaction, and whether these associations differ by gender. Results from multilevel models indicate that more frequent pornography use is associated with lower sexual satisfaction for both men and women, but the negative association is stronger for women. These findings suggest that pornography use may undermine sexual satisfaction in relationships, particularly for women, and highlight the importance of considering gender in research on pornography and sexuality.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0},
