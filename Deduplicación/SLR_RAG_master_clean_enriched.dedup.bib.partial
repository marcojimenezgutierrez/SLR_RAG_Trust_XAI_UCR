@article{yang_geometry_2024,
 abstract = {Robot learning has made significant progress in recent years, enabled by the availability of large-scale datasets and advances in foundation models. However, much of this progress has been limited to simulation or specific task settings, leaving open the question of how to build generalist robot policies that can transfer across diverse tasks and embodiments. In this work, we study what matters in building generalist robot policies. We conduct a comprehensive study across policy architectures, training data, and fine-tuning strategies, using a new suite of simulated and real-world robotic tasks. Our findings reveal that the choice of action representation and the inclusion of diverse, high-quality training data are critical for achieving robust generalization. We also show that simple fine-tuning methods, such as low-rank adaptation, can significantly improve performance on downstream tasks without the need for extensive retraining. These insights offer practical guidelines for developing more capable and versatile robot policies.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Yang},
