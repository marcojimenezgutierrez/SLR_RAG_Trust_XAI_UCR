@inproceedings{mohd_comparative_2024,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly impacted various sectors, including education. This paper explores the integration of AI in higher education, focusing on its potential to enhance teaching and learning processes. We examine key applications such as personalized learning systems, intelligent tutoring, and automated assessment tools. Through a comprehensive review of existing literature and case studies, we identify benefits including improved student engagement, adaptive instruction, and data-driven decision-making. However, challenges such as ethical concerns, data privacy, and the digital divide are also discussed. The study proposes a framework for ethical AI implementation in educational settings to maximize benefits while mitigating risks. Findings suggest that with proper guidelines, AI can transform higher education into a more inclusive and effective ecosystem.},
