@article{jiang_multi_semantic_2025,
 abstract = {This chapter proposes a novel framework for enhancing the security of Internet of Things (IoT) devices using blockchain technology integrated with machine learning algorithms. The proposed system addresses key challenges such as data privacy, authentication, and scalability in IoT networks. By leveraging a permissioned blockchain, the framework ensures tamper-proof storage and sharing of device data, while machine learning models are employed for anomaly detection and predictive maintenance. Experimental results demonstrate a significant improvement in detection accuracy (up to 95%) and reduced latency compared to traditional methods. The approach is evaluated on a simulated IoT environment, highlighting its potential for real-world deployment in smart cities and industrial applications.},
