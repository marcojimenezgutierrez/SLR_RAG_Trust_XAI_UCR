 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:24:31Z},
 year = {2025}
}

@book{bazzi_wonders_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly transformed various sectors, including healthcare, education, and finance. This paper examines the ethical implications of AI deployment in decision-making processes, focusing on issues of bias, transparency, and accountability. Through a comprehensive review of existing literature and case studies, we identify key challenges and propose a framework for ethical AI governance that emphasizes interdisciplinary collaboration and regulatory oversight. Our findings suggest that without proactive measures, AI systems risk exacerbating social inequalities, underscoring the need for global standards to ensure equitable and responsible innovation.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
