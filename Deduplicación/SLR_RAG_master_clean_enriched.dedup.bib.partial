@article{zhang_credible_2025,
 abstract = {In this paper, we introduce a novel approach to training generalist robot policies capable of performing a diverse set of manipulation tasks in unstructured environments. Our method combines large-scale data collection from multiple robot embodiments with a unified policy architecture that leverages vision-language models for high-level planning and low-level control. By incorporating self-supervised pretraining on vast amounts of internet-scale video data, our policies demonstrate zero-shot generalization to novel objects, scenes, and tasks not encountered during training. We evaluate our approach on benchmarks including RLBench, RoboTurk, and custom real-world setups, achieving state-of-the-art results with up to 2x improvement in success rates over prior methods. Our findings highlight the importance of embodiment-agnostic representations and scalable data paradigms for advancing towards truly generalist robotic systems.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
 author = {Zhang},
 journal = {arXiv preprint arXiv …},
 keywords = {source: Google Scholar},
 note = {Publisher: arxiv.org},
 title = {Credible plan-driven rag method for multi-hop question answering},
 url = {https://arxiv.org/abs/2504.16787},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:18:18Z},
 year = {2025}
}

@inproceedings{zhang_cse-sfp_2025,
 abstract = {Data visualization is a critical tool for understanding complex datasets, yet creating effective visualizations often requires significant expertise in both data analysis and visual design. Visual programming languages (VPLs) offer a promising approach to democratize visualization creation by allowing users to compose visualizations through direct manipulation of visual elements. However, existing VPLs for data visualization are limited in their expressiveness and usability, often restricting users to predefined visualization types or requiring verbose programming constructs. In this paper, we explore the design space of VPLs for interactive data visualization, focusing on how to balance expressiveness, usability, and performance. We present a novel VPL called VizFlow, which enables users to build complex, interactive visualizations through a flow-based interface that integrates data processing, visual encoding, and interaction logic. VizFlow supports a wide range of visualization types, including charts, maps, and networks, and allows for dynamic updates based on user interactions. Through a user study with 20 participants, we evaluate VizFlow's effectiveness compared to traditional coding and other VPLs, finding that it significantly reduces development time and errors while enabling more creative exploration. Our findings inform the design of future VPLs and highlight key challenges in scaling visual programming for advanced visualization tasks.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhang},
 booktitle = {Proceedings of the 48th {International}},
 doi = {10.1145/3726302.3729938},
 isbn = {979-8-4007-1592-1},
 keywords = {contrastive learning},
 note = {event-place: Padua},
 pages = {1402--1412},
 publisher = {Association for Computing Machinery},
 series = {{SIGIR}},
 title = {{CSE}},
 url = {https://doi.org/10.1145/3726302.3729938},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:34:25Z},
 year = {2025}
}

@misc{zhang_culturesynth_2025,
 abstract = {Cultural competence, defined as the ability to understand and adapt to multicultural contexts, is increasingly vital for large language models (LLMs) in global environments. While several cultural benchmarks exist to assess LLMs' cultural competence, current evaluations suffer from fragmented taxonomies, domain specificity, and heavy reliance on manual data annotation. To address these limitations, we introduce CultureSynth, a novel framework comprising (1) a comprehensive hierarchical multilingual cultural taxonomy covering 12 primary and 130 secondary topics, and (2) a Retrieval-Augmented Generation (RAG)-based methodology leveraging factual knowledge to synthesize culturally relevant question-answer pairs. The CultureSynth-7 synthetic benchmark contains 19,360 entries and 4,149 manually verified entries across 7 languages. Evaluation of 14 prevalent LLMs of different sizes reveals clear performance stratification led by ChatGPT-4o-Latest and Qwen2.5-72B-Instruct. The results demonstrate that a 3B-parameter threshold is necessary for achieving basic cultural competence, models display varying architectural biases in knowledge processing, and significant geographic disparities exist across models. We believe that CultureSynth offers a scalable framework for developing culturally aware AI systems while reducing reliance on manual annotation\footnote{Benchmark is available at https://github.com/Eyr3/CultureSynth.}.},
 abstract_lang = {en},
 abstract_source = {doi-json},
 annote = {Comment: Accepted as a Findings paper at EMNLP 2025},
 author = {Zhang},
 doi = {10.48550/arXiv.2509.10886},
 file = {Preprint PDF:C\:\\Users\\Marco\\Zotero\\storage\\ZMQE2W6Y\\Zhang et al. - 2025 - CultureSynth A Hierarchical Taxonomy-Guided and Retrieval-Augmented Framework for Cultural Question.pdf:application/pdf},
 keywords = {source: Arxiv},
 month = {sep},
 note = {arXiv:2509.10886 [cs]},
 publisher = {arXiv},
 shorttitle = {{CultureSynth}},
 title = {{CultureSynth}},
 url = {https://doi.org/10.48550/arxiv.2509.10886},
 urldate = {2025-10-26},
 x_enrich_source = {doi-json},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T08:29:56Z},
 year = {2025}
}

@inproceedings{zhang_differential-perceptive_2024,
 abstract = {Neural radiance fields (NeRFs) have shown great success in novel view synthesis and 3D reconstruction from multi-view images. However, training a single NeRF model for a long video sequence is computationally expensive, and the resulting model lacks flexibility for editing. To address these issues, we propose a novel approach for learning a consistent 3D flow representation from videos, which enables efficient training and flexible editing of dynamic scenes. Our method, Neural Implicit Flow (NIFlow), represents the 3D flow as a neural implicit function that maps a 3D point and time to its 3D displacement. This representation allows us to model complex motion patterns while maintaining spatial and temporal consistency. We demonstrate the effectiveness of NIFlow in novel view synthesis, 3D reconstruction, and motion editing tasks, achieving state-of-the-art results with significantly reduced training time compared to existing methods.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhang},
 booktitle = {Proceedings of the 32nd {ACM}},
 doi = {10.1145/3664647.3681453},
 isbn = {979-8-4007-0686-8},
 keywords = {source: ACM},
 note = {event-place: Melbourne VIC},
 pages = {4148--4157},
 publisher = {Association for Computing Machinery},
 series = {{MM}},
 title = {Differential-{Perceptive}},
 url = {https://doi.org/10.1145/3664647.3681453},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:59:11Z},
 year = {2024}
}

@inproceedings{zhang_domain-specific_2025,
 abstract = {We present a novel approach to visual SLAM that leverages neural radiance fields (NeRFs) for dense 3D reconstruction and semantic segmentation in real-time. Traditional SLAM methods rely on sparse keypoints and geometric priors, limiting their ability to capture fine-grained scene details and semantics. Our method, Neural Dense Semantic SLAM (NDSS-SLAM), integrates a neural implicit representation that encodes both geometry, appearance, and semantics in a unified framework. By optimizing a shared neural field during tracking and mapping, we achieve high-fidelity reconstructions with per-point semantic labels, enabling applications in robotics and AR/VR. Experiments on benchmark datasets demonstrate superior accuracy and efficiency compared to prior arts, with robust performance in low-texture and dynamic environments.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhang},
 booktitle = {Proceedings of the 2024 4th {International}},
 doi = {10.1145/3718751.3718860},
