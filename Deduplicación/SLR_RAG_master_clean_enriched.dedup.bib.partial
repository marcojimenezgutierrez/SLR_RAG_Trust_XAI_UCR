 year = {2025}
}

@article{wang_hierarchical_2025-1,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices while preserving data privacy. However, real-world FL deployments face significant challenges due to heterogeneous client capabilities, unreliable connectivity, and privacy concerns. In this paper, we propose FedHDP, a novel heterogeneous differential privacy framework for FL in mobile computing environments. FedHDP dynamically adapts noise injection levels based on client heterogeneity and network conditions to balance utility and privacy. Our approach incorporates a hierarchical aggregation mechanism that clusters similar clients for efficient communication and reduces privacy leakage. Extensive experiments on benchmark datasets demonstrate that FedHDP achieves up to 25% higher accuracy than baseline methods while maintaining strong differential privacy guarantees (ε ≤ 1.0). We also evaluate FedHDP on real mobile devices, showing its robustness to practical constraints like battery life and intermittent connectivity.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Wang},
 doi = {10.1109/TMC.2025.3564937},
 issn = {1558-0660},
 journal = {IEEE Transactions on Mobile Computing},
