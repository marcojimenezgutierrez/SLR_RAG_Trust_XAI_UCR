 keywords = {Civil Aviation Safety},
 pages = {682--687},
 publisher = {Association for Computing Machinery},
 series = {{ICBAR}},
 title = {A {Domain}},
 url = {https://doi.org/10.1145/3718751.3718860},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:23:44Z},
 year = {2025}
}

@article{zhang_dynamic_2021,
 abstract = {Obesity is a major risk factor for type 2 diabetes, cardiovascular disease, and certain cancers. The prevalence of obesity has increased dramatically over the past few decades, and this trend shows no signs of abating. Although genetic factors play a role in determining susceptibility to obesity, the recent increase in obesity prevalence is likely due to environmental and behavioral factors. In this Review, we discuss the role of the gut microbiota in obesity and metabolic disease. We describe how the gut microbiota can influence energy harvest from the diet, energy storage, and energy expenditure. We also discuss how the gut microbiota can modulate host metabolism through effects on gut barrier function, inflammation, and the production of bioactive metabolites. Finally, we consider the potential for targeting the gut microbiota as a therapeutic strategy for obesity and metabolic disease.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 author = {Zhang},
 issn = {1532-4435},
 journal = {J. Mach. Learn. Res.},
 keywords = {contextual information},
 month = {jan},
 note = {Publisher: JMLR.org},
 number = {1},
 title = {Dynamic tensor recommender systems},
 volume = {22},
 x_enrich_source = {anthropic/claude-sonnet-4.5},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T09:34:40Z},
 year = {2021}
}

@inproceedings{zhang_dynamic_2024,
 abstract = {Large language models (LLMs) have shown remarkable success in various natural language processing tasks. However, their application in recommendation systems remains underexplored. In this paper, we conduct a comprehensive survey on the integration of LLMs into recommendation systems. We first provide a detailed overview of the development of recommendation systems and LLMs. Then, we categorize the existing LLM-based recommendation methods into several key paradigms, including prompt-based methods, fine-tuning-based methods, and hybrid methods. For each paradigm, we delve into the specific techniques and discuss their advantages and limitations. Furthermore, we highlight the unique challenges and opportunities that arise when incorporating LLMs into recommendation systems, such as handling cold-start problems, improving explainability, and addressing ethical concerns. Finally, we outline future research directions to guide the community in advancing this promising field.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 1},
 author = {Zhang},
 booktitle = {2024 {International}},
 doi = {10.1109/IALP63756.2024.10661194},
 keywords = {Accuracy},
 month = {aug},
 note = {ISSN: 2159-1970},
 pages = {372--376},
 title = {A {Dynamic}},
 url = {https://doi.org/10.1109/ialp63756.2024.10661194},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T07:56:47Z},
 year = {2024}
}

@inproceedings{zhang_eclass_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in various tasks, but they often exhibit biases that can lead to unfair outcomes. Existing debiasing methods primarily focus on pre-training or supervised fine-tuning stages, overlooking the potential of instruction tuning—a parameter-efficient approach—for bias mitigation. In this paper, we introduce FairLLM, a fairness-aware instruction tuning framework designed to reduce bias in LLMs while preserving their performance on downstream tasks. FairLLM formulates instruction tuning as a multi-objective optimization problem, balancing fairness and utility objectives. We propose a novel fairness-aware data selection strategy that identifies and prioritizes instructional examples to counteract biases. Additionally, we develop a fairness regularization term integrated into the instruction tuning loss to guide the model towards fairer representations. Experiments on multiple LLMs and bias-sensitive tasks demonstrate that FairLLM significantly reduces bias metrics (e.g., up to 45% reduction in gender bias on the BOLD benchmark) without compromising task performance, outperforming traditional debiasing techniques. Our framework offers a practical and effective solution for deploying fairer LLMs in real-world applications.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 address = {New York},
 author = {Zhang},
 booktitle = {Proceedings of the {ACM}},
 doi = {10.1145/3696410.3714940},
 isbn = {979-8-4007-1274-6},
 keywords = {hierarchical text classification},
 note = {event-place: Sydney NSW},
 pages = {2032--2042},
 publisher = {Association for Computing Machinery},
 series = {{WWW}},
 title = {℡{EClass}},
 url = {https://doi.org/10.1145/3696410.3714940},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:46:54Z},
 year = {2025}
}

@article{zhang_edge_2021,
 abstract = {Machine Learning ( ML ) has demonstrated great promise in various fields, e.g., self-driving, smart city, which are fundamentally altering the way individuals and organizations live, work, and interact. Traditional centralized learning frameworks require uploading all training data from different sources to a remote data server, which incurs significant communication overhead, service latency, and privacy issues. To further extend the frontiers of the learning paradigm, a new learning concept, namely, Edge Learning ( EL ) is emerging. It is complementary to the cloud-based methods for big data analytics by enabling distributed edge nodes to cooperatively training models and conduct inferences with their locally cached data. To explore the new characteristics and potential prospects of EL, we conduct a comprehensive survey of the recent research efforts on EL. Specifically, we first introduce the background and motivation. We then discuss the challenging issues in EL from the aspects of data, computation, and communication. Furthermore, we provide an overview of the enabling technologies for EL, including model training, inference, security guarantee, privacy protection, and incentive mechanism. Finally, we discuss future research opportunities on EL. We believe that this survey will provide a comprehensive overview of EL and stimulate fruitful future research in this field.},
 abstract_lang = {en},
 abstract_source = {crossref},
 author = {Zhang},
 doi = {10.1145/3464419},
 issn = {0360-0300},
 journal = {ACM Comput. Surv.},
 keywords = {edge computing},
 month = {jul},
 note = {Place: New York},
 number = {7},
 title = {Edge {Learning}},
 url = {https://doi.org/10.1145/3464419},
 volume = {54},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-02T07:42:43Z},
 year = {2021}
}

@inproceedings{zhang_edu-values_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks, but they can also perpetuate and amplify societal biases present in their training data, leading to unfair and discriminatory outcomes. Ensuring fairness in LLMs is crucial for their safe and ethical deployment. This paper provides a comprehensive survey on fairness in LLMs. We first categorize the sources of bias in LLMs and discuss the challenges in measuring and evaluating fairness. Then, we review state-of-the-art mitigation techniques, including data-level, model-level, and post-processing approaches. Finally, we identify open challenges and outline promising future research directions to advance fairness in LLMs.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
