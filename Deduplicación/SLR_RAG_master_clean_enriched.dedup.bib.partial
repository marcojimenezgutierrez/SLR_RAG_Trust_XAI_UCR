@article{gokdemir_hiperrag_2025,
 abstract = {Social interactions are a fundamental aspect of human behavior, yet capturing and analyzing them in unconstrained environments remains challenging. This paper presents WildSocial, a large-scale multimodal dataset designed for studying social dynamics in the wild. Collected from 200+ hours of video footage in public spaces, it includes synchronized audio, video, and wearable sensor data from over 100 participants engaging in spontaneous interactions. We annotate the dataset for social roles, emotional states, and interaction types, enabling fine-grained analysis. To demonstrate its utility, we benchmark state-of-the-art models for tasks such as group detection, turn-taking prediction, and rapport estimation. Our results highlight the dataset's potential for advancing research in social computing, affective computing, and human-AI interaction, while addressing key challenges like privacy and scalability.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
