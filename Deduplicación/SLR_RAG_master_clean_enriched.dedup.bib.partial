 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-02T06:28:22Z},
 year = {2024}
}

@article{baumann_combining_2024,
 abstract = {The increasing complexity of software systems requires new approaches to ensure their quality and reliability. In this paper, we present a novel framework for automated testing of distributed systems using machine learning techniques. Our approach leverages reinforcement learning to generate test cases that explore the system's behavior under various conditions, including edge cases and failure scenarios. We evaluate our framework on real-world distributed applications and demonstrate significant improvements in fault detection compared to traditional testing methods. The results show that our method achieves a 30% higher coverage of critical paths while reducing the manual effort required for test design.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Query date: 2025-10-25 20:50:36},
