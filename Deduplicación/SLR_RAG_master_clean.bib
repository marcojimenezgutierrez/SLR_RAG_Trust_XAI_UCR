@article{Bedi20257451,
  abbrev_source_title    = {Knowl. Inf. Systems. Syst.},
  abstract               = {Large Language Models (LLMs) are making a big impact in Artificial Intelligence due to their ability to perform tasks as humans. However, using LLMs in many domain-specific tasks is a relatively unexplored area, specifically in disease diagnosis. This is due to challenges such as multiple modalities in patient clinical information and LLM's high memory and computational power requirements. This study proposes a framework, XLR-KGDD, that overcomes these challenges and performs an LLM-based disease diagnosis. Additionally, XLR-KGDD generates explanations to establish the trust of clinicians and support the diagnosis. These explanations are precise and unambiguous as they adhere to the standard medical guidelines and are presented in natural language. The proposed framework maps multimodal patient clinical information to a patient Knowledge Graph (KG) using the N2K mapper and CheXzero. Prompt Engineering is then applied to create an LLM-compatible input prompt from the patient KG. The framework employs a Parameter Efficient Fine-tuning technique to fine-tune LLM efficiently by optimizing numerical computations and memory requirements. The framework uses Retrieval Augmented Generation to provide standard medical guidelines as context to the LLM, addressing the issue of hallucinations in LLMs and generating coherent explanations. A system based on the XLR-KGDD framework was developed and tested on the multimodal MIMIC-Eye dataset. The LLaMA-3 LLM shows an AUC value of 0.88 and 0.91 in ROC and PR curves, respectively, in diagnosing patients with CHF disease. Furthermore, the system-generated explanations support the diagnosis with evidence from medical guidelines. © 2025 Elsevier B.V., All rights reserved.},
  affiliations           = {University of Delhi, Department of Computer Science, New Delhi, India; Keshav Mahavidyalaya, New Delhi, India},
  author                 = {Bedi, Punam and Thukral, Anjali and Dhiman, Shivani},
  author_keywords        = {Disease diagnosis; Electronic health record; Knowledge graph; Large language model; Multimodal},
  correspondence_address = {S. Dhiman; Department of Computer Science, University of Delhi, Delhi, India; email: shivani@cs.du.ac.in},
  doi                    = {10.1007/s10115-025-02465-8},
  issn                   = {02193116; 02191377},
  journal                = {Knowledge and Information Systems},
  keyword                = {Clinical information; Disease diagnosis; Electronic health; Graph-based; Health records; Knowledge graphs; Language model; Large language model; Medical guidelines; Multi-modal; Electronic health record},
  keywords               = {source: SCOPUS},
  language               = {English},
  note                   = {Cited by: 0},
  number                 = {9},
  pages                  = {7451 - 7471},
  publication_stage      = {Final},
  publisher              = {Springer Science and Business Media Deutschland GmbH},
  source                 = {Scopus},
  title                  = {XLR-KGDD: leveraging LLM and RAG for knowledge graph-based explainable disease diagnosis using multimodal clinical information},
  type                   = {Article},
  url                    = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105004900785&doi=10.1007%2Fs10115-025-02465-8&partnerID=40&md5=4d36632d1fd8c78847feb12aaa4e7436},
