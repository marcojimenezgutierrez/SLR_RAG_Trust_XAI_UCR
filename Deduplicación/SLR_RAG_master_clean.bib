  keyword                = {Data visualization; Decision making; Natural language processing systems; Presses (machine tools); Semantics; Visualization; Accessibility; Conversational agents; Data driven; Data materials; Language processing; Natural language processing; Natural languages; Online press article; Question-answer pairs; Screen readers; Artificial intelligence},
  keywords               = {source: SCOPUS},
