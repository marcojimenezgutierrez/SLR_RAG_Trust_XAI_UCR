  isbn                   = {9798350349504},
  keyword                = {Computational linguistics; Business products; Business service; Citation generation; Explainability; Language model; Large language model attribution; Product and services; Train data attribution; Unified framework; Verifiability; Petroleum reservoir evaluation},
