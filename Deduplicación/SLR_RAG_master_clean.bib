  doi                    = {10.1007/s10796-025-10581-7},
  issn                   = {13873326; 15729419},
  journal                = {Information Systems Frontiers},
  keyword                = {Artificial intelligence; Connectionism; Framework for generative artificial intelligence as a sociotechnical system; Generative artificial intelligence; Information system research; Language model; Large language model; Potential impacts; Societal impacts; Sociotechnical systems; Generative adversarial networks},
