  doi                    = {10.1016/j.inffus.2025.103033},
  issn                   = {15662535},
  journal                = {Information Fusion},
  keyword                = {Diagnosis; Medical robotics; Robotic surgery; Embodied artificial intelligence; Healthcare; Healthcare systems; Language model; Large language model; Multi-modal; Multi-modality; Multimodal large language model; World model; Clinical research},
