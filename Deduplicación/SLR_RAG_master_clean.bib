  author_keywords        = {Artificial intelligence; Communities of practice; Experts; Generative AI; HCI; Novices; Professional organizations; Professionals; Risk work; Technology and organizations; Work and occupations},
  coden                  = {ACMTE},
  correspondence_address = {K.C. Kellogg; MIT Sloan School of Management, United States; email: kkellogg@mit.edu},
  doi                    = {10.1016/j.infoandorg.2025.100559},
  issn                   = {14717727},
  journal                = {Information and Organization},
  keywords               = {source: SCOPUS},
  language               = {English},
  note                   = {Cited by: 3},
  number                 = {1},
