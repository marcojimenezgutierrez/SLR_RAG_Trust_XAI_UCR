  author_keywords        = {human-centered AI; human-in-the-loop; large-language models; verification},
  doi                    = {10.1145/3706598.3714113},
  isbn                   = {9798400713958; 9798400713941},
  keyword                = {User centered design; Automated planning; End-users; Human-centered AI; Human-in-the-loop; In-field; Language model; Large-language model; Planning tasks; Planning tools; Verification techniques; Model checking},
  keywords               = {source: SCOPUS},
  language               = {English},
  note                   = {Cited by: 2; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
  pages                  = {},
  publication_stage      = {Final},
  publisher              = {Association for Computing Machinery},
  source                 = {Scopus},
  title                  = {VeriPlan: Integrating Formal Verification and LLMs into End-User Planning},
  type                   = {Conference paper},
