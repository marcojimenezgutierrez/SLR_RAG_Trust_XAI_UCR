  correspondence_address = {J. He; HKUST, Hong Kong; email: junxianh@cse.ust.hk},
  editor                 = {Salakhutdinov, R. and Kolter, Z. and Heller, K. and Weller, A. and Oliver, N. and Scarlett, J. and Berkenkamp, F.},
  isbn                   = {9781713845065},
  issn                   = {26403498},
  journal                = {Proceedings of Machine Learning Research},
  keyword                = {Benchmarking; Modeling languages; Problem oriented languages; Constrained decoding; Decoding process; Entropy based metrics; Hidden state; In contexts; Language model; Practical solutions; Decoding},
  keywords               = {source: SCOPUS},
  language               = {English},
  note                   = {Cited by: 0},
  pages                  = {7553 - 7567},
  publication_stage      = {Final},
  publisher              = {ML Research Press},
  source                 = {Scopus},
  title                  = {In-Context Sharpness as Alerts: An Inner Representation Perspective for Hallucination Mitigation},
  type                   = {Conference paper},
