  keyword                = {Computer simulation languages; Problem oriented languages; Unified Modeling Language; 'current; External knowledge; Kgqa; Knowledge graphs; Knowledge retrieval; Language model; Large language model; Novel methods; Prompter; Retrieval-augmented generation; Knowledge graph},
