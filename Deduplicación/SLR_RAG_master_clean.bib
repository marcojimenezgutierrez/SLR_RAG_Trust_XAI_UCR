  keyword                = {Economic and social effects; Modeling languages; AI systems; Belief revision; Feature sequence; Language model; Model reasonings; Modeling belief; Real-world; Real-world scenario; Test language; Trade off; Computational linguistics},
  keywords               = {source: SCOPUS},
  language               = {English},
  note                   = {Cited by: 0},
  pages                  = {10480 - 10496},
  publication_stage      = {Final},
  publisher              = {Association for Computational Linguistics (ACL)},
  source                 = {Scopus},
  title                  = {Belief Revision: The Adaptability of Large Language Models Reasoning},
