  correspondence_address = {E. Mendez Guzman; Department of Computer Science, The University of Manchester, Manchester, United Kingdom; email: erick.mendezguzman@manchester.ac.uk},
  doi                    = {10.3389/frai.2024.1363531},
  issn                   = {26248212},
