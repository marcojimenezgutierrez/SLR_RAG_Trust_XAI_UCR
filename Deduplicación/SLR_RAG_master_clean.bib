  author_keywords        = {axiomatic ranking; explainable information retrieval; interpretable by design; post-hoc interpretability; probing},
  doi                    = {10.1145/3726302.3730343},
  isbn                   = {9798400715921},
  keyword                = {High level languages; Human engineering; Information use; Knowledge management; Open source software; Open systems; Python; Axiomatic ranking; Axiomatics; Explainable information retrieval; Interpretability; Interpretable by design; Post-hoc interpretability; Probing; Ranking model; Retrieval methods; Statistical retrieval; Information retrieval},
  keywords               = {source: SCOPUS},
  language               = {English},
  note                   = {Cited by: 0; All Open Access; Gold Open Access},
  pages                  = {3563 - 3572},
  publication_stage      = {Final},
  publisher              = {Association for Computing Machinery, Inc},
