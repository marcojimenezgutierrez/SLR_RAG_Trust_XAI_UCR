  doi                    = {10.1007/s10462-024-10916-x},
  issn                   = {15737462; 02692821},
  journal                = {Artificial Intelligence Review},
  keyword                = {Information use; Conceptualization; Costs consideration; Explainability; Explainable artificial intelligence; Generative artificial intelligence; Interactivity; Research agenda; Security considerations; Training data; Verifiability; Generative adversarial networks},
  keywords               = {source: SCOPUS},
  language               = {English},
