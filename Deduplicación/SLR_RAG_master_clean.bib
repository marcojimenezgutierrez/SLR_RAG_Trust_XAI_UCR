  location               = {Nijmegen, Netherlands},
  publisher              = {Association for Computing Machinery},
  title                  = {ITiCSE 2025: Proceedings of the 30th ACM Conference on Innovation and Technology in Computer Science Education V. 2},
  year                   = {2025}
}

