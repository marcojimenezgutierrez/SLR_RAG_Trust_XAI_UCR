  title                  = {Backdoor threats in large language models—a survey},
  type                   = {Review},
  url                    = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105013551209&doi=10.1007%2Fs11432-024-4351-3&partnerID=40&md5=dd15af1cc3eda771f1ae3a7a3fc2d05e},
