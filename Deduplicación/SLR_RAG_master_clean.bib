  number                 = {10},
  pages                  = {},
  publication_stage      = {Final},
  publisher              = {Multidisciplinary Digital Publishing Institute (MDPI)},
  source                 = {Scopus},
  title                  = {Integrating Graph Retrieval-Augmented Generation into Prescriptive Recommender Systems},
  type                   = {Article},
