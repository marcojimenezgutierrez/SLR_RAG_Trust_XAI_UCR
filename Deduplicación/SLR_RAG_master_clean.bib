  keywords               = {source: IEEE},
  month                  = {July},
  number                 = {},
  pages                  = {1-4},
  title                  = {AI Medical Health Assistant: Rag Approach},
  volume                 = {},
  year                   = {2025}
}

@inproceedings{11211290,
  abstract               = {The rapid expansion of online learning platforms has created challenges in filtering and recommending the most suitable courses to students. This paper introduces AcadGPT, a fine-tuned LLaMA-based Large Language Model (LLM) specifically designed for academic course recommendations. Unlike traditional collaborative filtering or retrieval-augmented generation (RAG) methods, AcadGPT leverages fine-tuning on structured course datasets to provide context-aware, personalized recommendations. By eliminating dependency on external retrieval mechanisms, it significantly reduces inference latency while improving adaptability to evolving curricula. The model is optimized using Quantized Low-Rank Adaptation (QLoRA), enabling efficient training and real-time deployment. Initial experiments demonstrate superior recommendation accuracy, lower hallucination rates, and improved scalability compared to baseline LLMs such as llama3-8b-8192 and GPT-4o. AcadGPT represents a major step forward in AI-driven academic advising, providing a scalable and efficient alternative to conventional recommendation approaches. Future research will explore integration with student information systems, reinforcement learning for continuous adaptation, and enhanced explainability for user trust.},
  author                 = {Saxena, Aditya and Kumar, Anmol Deepak},
  booktitle              = {2025 International Conference on Artificial intelligence and Emerging Technologies (ICAIET)},
  doi                    = {10.1109/ICAIET65052.2025.11211290},
  issn                   = {},
  keyword                = {Training;Adaptation models;Filtering;Large language models;Scalability;Retrieval augmented generation;Reinforcement learning;Learning (artificial intelligence);Real-time systems;Information systems;Large Language Model;Fine-Tuning;LLaMA;Course Recommendation;Personalized Learning;QLoRA;Cloud-Native Deployment;Higher Education},
  keywords               = {source: IEEE},
  month                  = {Aug},
  number                 = {},
  pages                  = {1-6},
  title                  = {AcadGPT: a Fine-Tuned LLaMA Model for Personalized Course Recommendations in Higher Education},
  volume                 = {},
  year                   = {2025}
}

@inproceedings{11211325,
  abstract               = {Traditional search engines often struggle to deliver accurate, up-to-date information, particularly for rapidly evolving topics, due to their reliance on semi-structured databases that can become stale. To address these limitations, we propose an enhanced search engine architecture leveraging Retrieval-Augmented Generation (RAG) technology. Our system combines Large Language Models (LLMs) with sophisticated document retrieval mechanisms to deliver contextually relevant and current information to users. The proposed framework's key innovation lies in its dynamic document retrieval system that continuously updates through databases, web crawlers, and APIs, enabling the LLM to generate responses based on fresh data. This approach significantly reduces the likelihood of inaccuracies and hallucinations commonly associated with standalone llMs. We further enhance the model's precision through domain-specific fine-tuning across sectors like finance, healthcare, and news media, optimizing both accuracy and relevance for specialized queries. A distinctive feature of our system is its transparent approach to information delivery, presenting users with both generated answers and their supporting source documents.The framework integrates private institutional data with publicly available knowledge to enhance response generation. This dual-output mechanism builds user trust by providing verifiable context for all responses. Through extensive testing, our model is demonstrated to have superior performance in delivering domain-specific, current, and accurate search results compared to traditional search engines.},
  author                 = {Konda, Nithin and Reddy, Y C A Padmanabha and Rohit, Tripurana Lakshmi and Pulabaigari, Viswanath},
  booktitle              = {2025 International Conference on Artificial intelligence and Emerging Technologies (ICAIET)},
  doi                    = {10.1109/ICAIET65052.2025.11211325},
  issn                   = {},
  keyword                = {Technological innovation;Accuracy;Databases;Large language models;Retrieval augmented generation;Finance;Search engines;Real-time systems;Tuning;Testing;Retrieval-Augmented Generation (RAG);Large Language Models (LLM);Real-time information retrieval;Dynamic search engines;Contextual accuracy;Document retrieval},
  keywords               = {source: IEEE},
  month                  = {Aug},
  number                 = {},
  pages                  = {1-6},
  title                  = {Enhanced Search Engine Using Retrieval-Augmented Generation (RAG)},
  volume                 = {},
  year                   = {2025}
}

@article{11214570,
  abstract               = {This paper investigates a GraphRAG framework that integrates knowledge graphs into the Retrieval-Augmented Generation (RAG) architecture to enhance networking applications. While RAG has shown promise in improving the contextual relevance of large language model (LLM) outputs, its flat-text retrieval structure often struggles with domain-specific tasks involving complex entity relationships and dynamic network environments. By leveraging graph-structured representations, GraphRAG captures hierarchical and semantic dependencies among network elements, enabling more accurate and context-aware information retrieval. We first review existing RAG applications in networking and identify their limitations. Then, we propose a domain-adapted GraphRAG framework with a step-by-step construction guide tailored for wireless network optimization. A case study on channel gain prediction demonstrates that GraphRAG significantly outperforms traditional RAG and model-based baselines in both retrieval accuracy and sum-rate performance. Finally, we highlight future research directions, including efficient graph update mechanisms, hallucination mitigation, and secure knowledge integration for real-time and trustworthy LLM-based networking solutions.},
  author                 = {Xiong, Yang and Zhang, Ruichen and Liu, Yinqiu and Niyato, Dusit and Xiong, Zehui and Liang, Ying-Chang and Mao, Shiwen},
  doi                    = {10.1109/MWC.2025.3600951},
  issn                   = {1558-0687},
  journal                = {IEEE Wireless Communications},
  keyword                = {Retrieval augmented generation;Knowledge graphs;Accuracy;Real-time systems;Optimization;Databases;Reliability;Decision making;Transmitters;Receivers},
  keywords               = {source: IEEE},
  month                  = {},
  number                 = {},
  pages                  = {1-9},
  title                  = {When Knowledge Graph Meets Retrieval Augmented Generation for Wireless Networks: A Tutorial and Case Study},
  volume                 = {},
  year                   = {2025}
}

@inproceedings{11216521,
  abstract               = {As artificial intelligence moves across all scientific and engineering disciplines, a big challenge remains: expert domain knowledge, especially in specialized areas like Design-of-Experiments (DoE), is hard to interpret or inaccessible to non-experts and thus hinders broader application and innovation. As large language models (LLMS) continue to improve, they offer a practical way to help close the knowledge gap and make expert-level information more accessible to a wider audience. To address this need, we designed and developed a new solution: a Design-of-Experiments Oracle (DOE), a conversational LLM. This paper presents this AI-powered system that changes how complex DoE principles are understood and used. DOE uses state-of-the-art techniques including a Llama 3.2 model inside a Retrieval-Augmented Fine-Tuned Transformer (RAFT) architecture. Its knowledge base is informed by and enables semantic retrieval from combinatorial testing research. This is a conversational expert system. With this system, we want to enable engineers and researchers to apply complex DoE principles, give them interactive, research-based guidance. Ultimately, this is to contribute to the efforts to speed up innovation, improve system reliability and make advanced engineering methods more accessible in the digital age.},
  author                 = {Margabandu, Logan and Chen, Zizhao and Wong, W. Eric and Hsu, Chih-Wei},
  booktitle              = {2025 25th International Conference on Software Quality, Reliability, and Security Companion (QRS-C)},
  doi                    = {10.1109/QRS-C65679.2025.00021},
  issn                   = {2693-9371},
  keyword                = {Technological innovation;Combinatorial testing;Large language models;Retrieval augmented generation;Semantics;Software quality;Transformers;Reliability engineering;Software reliability;Security;Design-of-Experiments (DoE);Oracle LLM;Conversational AI;Large Language Models;Retrieval Augmented Generation (RAG);Combinatorial Testing},
  keywords               = {source: IEEE},
  month                  = {July},
  number                 = {},
  pages                  = {82-90},
  title                  = {A Design of Experiments Oracle LLM for Research-Grounded Combinatorial Testing},
  volume                 = {},
  year                   = {2025}
}

