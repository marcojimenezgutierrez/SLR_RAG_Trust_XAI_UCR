  author_keywords        = {agent; large language models; tool learning},
  correspondence_address = {J. Xu; Gaoling School of Artificial Intelligence, Renmin University of China, Beijing, 100872, China; email: junxu@ruc.edu.cn},
  doi                    = {10.1007/s11704-024-40678-2},
  issn                   = {20952236; 20952228},
  journal                = {Frontiers of Computer Science},
  keyword                = {Adversarial machine learning; Federated learning; Complex problems; Language model; Large language model; Learning paradigms; Planning tools; Task planning; Tool integration; Tool learning; Tool selection; Work-flows; Contrastive Learning},
  keywords               = {source: SCOPUS},
