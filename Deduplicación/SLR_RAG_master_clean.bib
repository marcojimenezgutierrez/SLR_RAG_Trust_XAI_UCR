  doi                    = {10.1007/s10462-024-10902-3},
  issn                   = {15737462; 02692821},
  journal                = {Artificial Intelligence Review},
  keyword                = {Knowledge graph; Evaluation framework; Language model; Large language model; Literature reviews; Natural anguage processing; Research challenges; Review process; Semi-automatics; Systematic literature review; Usability; Usability engineering},
  keywords               = {source: SCOPUS},
