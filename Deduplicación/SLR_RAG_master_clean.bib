  doi                    = {10.1109/TAI.2024.3471735},
  issn                   = {26914581},
  journal                = {IEEE Transactions on Artificial Intelligence},
  keyword                = {Fake news; Fake news detection; Inter-personal communications; Language model; Large language model; Machine-learning; Modelling techniques; Social media; Traditional approaches; Traditional approachs; Fake detection},
