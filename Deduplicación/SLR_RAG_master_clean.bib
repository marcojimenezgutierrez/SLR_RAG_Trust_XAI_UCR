  correspondence_address = {U.M. Borghoff; Institute for Software Technology, University of the Bundeswehr Munich, Neubiberg, Germany; email: uwe.borghoff@unibw.de},
  doi                    = {10.3389/fhumd.2025.1540450},
  issn                   = {26732726},
