  author_keywords        = {Explainable AI; Knowledge Graph; Large Language Model; Retrieval-Augmented Generation},
  correspondence_address = {F. Anaguchi; Aoyama Gakuin University, Kanagawa, Japan; email: c5624178@aoyama.jp},
  doi                    = {10.1109/CANDAR64496.2024.00010},
  isbn                   = {9798331528362},
  keyword                = {Behavior-based; Daily activity; Explainable AI; Graph-based; Home environment; Knowledge graphs; Language model; Large language model; Retrieval-augmented generation; Social issues; Knowledge graph},
