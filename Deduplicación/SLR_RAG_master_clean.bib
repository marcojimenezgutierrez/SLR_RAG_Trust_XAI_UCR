  doi                    = {10.1007/s11432-024-4351-3},
  issn                   = {18691919; 1674733X},
  journal                = {Science China Information Sciences},
  keyword                = {Artificial life; Computational linguistics; Deep learning; Network security; Search engines; Surveying; Artificial intelligence security; Attack and defense category; Backdoor threat; Backdoors; Language comprehensions; Language model; Large language model; Large language model life cycle; Text generations; Life cycle},
  keywords               = {source: SCOPUS},
  language               = {English},
