  doi                    = {10.1111/jebm.70075},
  issn                   = {17565391; 17565383},
  journal                = {Journal of Evidence-Based Medicine},
  keyword                = {artificial intelligence; clinical decision making; diagnosis; female; generative artificial intelligence; hallucination; health care quality; human; knowledge; knowledge graph; patient safety; reliability; review; workflow; prevention and control; Artificial Intelligence; Clinical Decision-Making; Hallucinations; Humans},
