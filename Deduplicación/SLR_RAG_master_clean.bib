@article{Jiang2025,
  abbrev_source_title    = {Sci. Rep.},
  abstract               = {Large Language Models (LLMs) are transforming various aspects of our daily lives and work through their generated content, known as Artificial Intelligence Generated Content (AIGC). To effectively harness this change, it is essential to understand the limitations within these models. While extensive prior research has addressed biases in OpenAI’s ChatGPT, limited attention has been given to biases present in Chinese Large Language Models (C-LLMs). This study systematically examines biases in five representative C-LLMs. We collected 90 Chinese surnames derived from authoritative demographic statistics and 12 occupations covering various professional sectors as input prompts. Each prompt was generated three times by the C-LLMs, resulting in a dataset comprising 16,200 generated personal profiles. We then evaluated these profiles for biases regarding gender, region, age, and educational background. Our findings reveal that the content produced by each examined C-LLMs exhibits significant gender and regional biases, as well as age and educational stereotypes. Notably, while most models can generate some unbiased content, ChatGLM stands out as the exception. In contrast, Tongyiqianwen is the only model that may refuse to generate certain content, due to its strong privacy protection mechanisms. We also further analyze the underlying mechanisms of bias formation by examining different stages of the model lifecycle and considering the unique characteristics of the Chinese linguistic and sociocultural context. This paper will contribute substantially to the literature on biases in C-LLMs and provide important insights for users aiming to utilize these models more effectively and ethically. © 2025 Elsevier B.V., All rights reserved.},
  affiliations           = {Hefei University of Technology, College of Management, Hefei, China; Nanjing University of Finance and Economics, College of Information Engineering, Nanjing, China; Macquarie University, College of Computing, Sydney, Australia},
  author                 = {Jiang, Leilei and Zhu, Guixiang and Sun, Jianshan and Cao, Jie and Wu, Jia},
  author_keywords        = {AI-generated content (AIGC); Bias; Chinese Large Language Models (C-LLMs); Occupational stereotype},
  correspondence_address = {J. Cao; College of Management, Hefei University of Technology, Hefei, 230009, China; email: cao_jie@hfut.edu.cn},
  doi                    = {10.1038/s41598-025-03893-w},
  issn                   = {20452322},
  journal                = {Scientific Reports},
  keyword                = {article; artificial intelligence; ChatGPT; human; large language model; privacy; statistical bias; stereotypy},
  keywords               = {source: SCOPUS},
  language               = {English},
  note                   = {Cited by: 1; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
  number                 = {1},
  pages                  = {},
  pmid                   = {40436980},
  publication_stage      = {Final},
  publisher              = {Nature Research},
  source                 = {Scopus},
  title                  = {Exploring the occupational biases and stereotypes of Chinese large language models},
  type                   = {Article},
  url                    = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105006931927&doi=10.1038%2Fs41598-025-03893-w&partnerID=40&md5=2d5ffff7ed62d373dbb42126b307d38c},
  volume                 = {15},
