  author_keywords        = {experience of quality (QoE); generative artificial intelligence (GenAI); human-in-the-loop; intent alignment; Interactive wireless networks; large language models (LLMs); reinforcement learning from human feedback (RLHF); semantic communication (SemCom)},
  correspondence_address = {X. Xu; Beijing University of Posts and Telecommunications, State Key Laboratory of Networking and Switching Technology, Beijing, 100876, China; email: xuxiaodong@bupt.edu.cn},
