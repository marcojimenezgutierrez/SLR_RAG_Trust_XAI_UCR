  doi                    = {10.1016/j.apenergy.2025.126670},
  issn                   = {18729118; 03062619},
  journal                = {Applied Energy},
  keyword                = {Behavioral research; Data integration; Decision making; Digital twin; Energy policy; Forecasting; Modal analysis; Smart power grids; Agentic digital twin; Energy sector; Foundation models; Generative AI; Generative artificial intelligence; Language model; Large language model; Situational awareness; Smart grid; Transformer; Artificial intelligence; Electric transformers; digitization; energy management; literature review; machine learning; numerical model; smart grid},
