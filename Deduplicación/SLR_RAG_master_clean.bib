  keyword                = {Automation; Decision making; Graphic methods; Human engineering; Hydraulic machinery; Hydraulic structures; Hydraulics; Inspection; Intelligent agents; Knowledge based systems; Large datasets; Maintainability; Metadata; Personnel; Project management; Graph retrieval-augmented generation; Hydraulic engineering; Hydraulic projects; Language model; Multi agent; Multi-modal; Multimodal large language model; Operation and management; Operation decisions; Operations and maintenance; Multi agent systems},
