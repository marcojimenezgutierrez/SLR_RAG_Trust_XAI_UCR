  journal                = {IEEE Access},
  keyword                = {Generative adversarial networks; Multi-task learning; Natural sciences computing; Supervised learning; Text processing; Content creation; Ethical artificial intelligence and governance; Generative artificial intelligence; Generative model; High-fidelity; Multi-modal; Multi-modal artificial intelligence; Multi-modal learning; Text data; Text images; Reinforcement learning},
