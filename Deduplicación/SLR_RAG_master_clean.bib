  doi                    = {10.1016/j.apenergy.2025.126420},
  issn                   = {18729118; 03062619},
  journal                = {Applied Energy},
  keyword                = {Anomaly detection; Data handling; Energy utilization; Facilities; Graph neural networks; Graphic methods; HVAC; Real time systems; Semiconductor device manufacture; Chain management; Circular economy; Graph-based; HVAC system; Large multimodal model; Manufacturing facility; Multimodal models; Semiconductor manufacturing; Semiconductor manufacturing facility; Supply chain management; artificial neural network; circular economy; data processing; energy use; environmental conditions; manufacturing; model validation; optimization; paradigm shift; semiconductor industry; supply chain management},
