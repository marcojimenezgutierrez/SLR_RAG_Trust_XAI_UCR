  issn                   = {20799292},
  journal                = {Electronics (Switzerland)},
  keyword                = {Deep learning; Groupware; Learning systems; Memory architecture; Natural language processing systems; Robots; Software architecture; Software design; Cognitive architectures; Conversational systems; Episodic memory; Explainability; Explainable autonomous robot; Knowledge model; Learning techniques; Robotic cognitive architecture; Runtimes; Social robots; Software agents},
