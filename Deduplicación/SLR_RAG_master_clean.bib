@article{Goktas2024,
  abbrev_source_title    = {J. Decis. Syst.},
  abstract               = {This study conducts a bibliometric analysis of the evolution of ethics, transparency, and explainability in generative Artificial Intelligence (AI) within decision (Formula presented.) making systems from 2004 to 2024. Utilising VOSviewer and Biblioshiny tools, literature sourced from Scopus and Web of Science was analyzed following PRISMA guidelines. The findings highlight the rapid expansion of generative AI technologies, particularly since 2019, with a growing focus on ethical frameworks, especially in healthcare. The analysis underlines that as AI systems become more embedded in high-stakes decisions, aligning these systems with societal values is increasingly urgent. The United States and Europe lead in contributors, with significant insights from Asia. Key themes include AI’s ethical challenges, algorithmic transparency, and explainability, with these gaining prominence during the COVID (Formula presented.) 19 pandemic. By identifying trends such as the surge in chatbot and large language model research, this research provides a foundation for future studies on ethical AI and informs policy considerations for responsible AI innovation. © 2024 Elsevier B.V., All rights reserved.},
  affiliations           = {University College Dublin, School of Computer Science, Dublin, Ireland},
  author                 = {Goktas, Polat},
  author_keywords        = {Artificial intelligence; bibliometric analysis; ChatGPT; decision-making; ethics; generative AI},
  correspondence_address = {P. Goktas; UCD, School of Computer Science, University College Dublin, Belfield, Dublin, Ireland; email: polat.goktas@ucd.ie},
  doi                    = {10.1080/12460125.2024.2410042},
  issn                   = {12460125; 21167052},
  journal                = {Journal of Decision Systems},
  keyword                = {Artificial intelligence technologies; Bibliometric; Bibliometrics analysis; ChatGPT; Decision formulas; Decision-making systems; Decisions makings; Generative artificial intelligence; Rapid expansion; Web of Science; Generative adversarial networks},
  keywords               = {source: SCOPUS},
  language               = {English},
  note                   = {Cited by: 21},
  pages                  = {},
  publication_stage      = {aip},
  publisher              = {Taylor and Francis Ltd.},
  source                 = {Scopus},
  title                  = {Ethics, transparency, and explainability in generative ai decision-making systems: a comprehensive bibliometric study},
  type                   = {Review},
  url                    = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85206211654&doi=10.1080%2F12460125.2024.2410042&partnerID=40&md5=0fa89ec518bf110bdcb8304c0fa8efdb},
