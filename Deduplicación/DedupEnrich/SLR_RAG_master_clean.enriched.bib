Type: Article},
 number = {10},
 title = {Integrating {Graph} {Retrieval}-{Augmented} {Generation} into {Prescriptive} {Recommender} {Systems}},
 url = {https://doi.org/10.3390/bdcc9100261},
 volume = {9},
