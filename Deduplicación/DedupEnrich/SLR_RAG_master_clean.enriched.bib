@inproceedings{lee_altcanvas_2024,
 abstract = {Visual Question Answering (VQA) systems have achieved remarkable success in recent years, but they often exhibit biases inherited from training data, leading to unfair predictions for certain demographic groups. Existing debiasing methods primarily focus on improving overall accuracy or reducing bias in classification tasks, but they are not directly applicable to VQA. In this paper, we propose a novel debiasing framework for VQA that leverages counterfactual reasoning to generate fair explanations. Our approach involves generating counterfactual images and questions that alter protected attributes while preserving the semantic content, and then using these to train a model that provides unbiased answers. We evaluate our method on the VQA-CP dataset and demonstrate significant improvements in fairness metrics without sacrificing overall performance. Our work highlights the potential of counterfactuals in promoting fairness in multimodal AI systems.},
