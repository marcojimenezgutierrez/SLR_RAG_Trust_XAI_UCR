@article{ni_enhancing_2025,
 abstract = {This study proposes a novel framework for optimizing the integration of floating photovoltaic (FPV) systems with offshore wind farms to enhance energy yield and reduce levelized cost of energy (LCOE). Using a multi-objective optimization model that incorporates hydrodynamic, aerodynamic, and electrical interactions, we evaluate hybrid configurations in various marine environments. The results demonstrate up to 25% improvement in capacity factor and 15% reduction in LCOE compared to standalone systems, with sensitivity analyses on key parameters such as water depth, wind speed, and panel tilt. The approach is validated through case studies in the North Sea and East China Sea, highlighting its potential for scalable marine renewable energy deployment.},
