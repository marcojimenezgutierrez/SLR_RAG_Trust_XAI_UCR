@article{noauthor_24th_2025,
 abstract = {Background Bimekizumab (BKZ), a monoclonal antibody that selectively targets interleukin (IL)-17A and IL-17F, is approved for the treatment of moderate-to-severe plaque psoriasis (PsO), active psoriatic arthritis (PsA), and active non-radiographic axial spondyloarthritis (nr-axSpA) with objective signs of inflammation. Objective To report the 2-year interim safety results from a multicenter, prospective, observational study of adult patients with moderate-to-severe PsO, PsA, or nr-axSpA initiating BKZ in routine clinical practice in the USA. Methods The Biogen Bimekizumab Safety Study (NCT04825721) is enrolling approximately 1000 patients. Patients were eligible if they initiated BKZ for approved indications per the US label, had ≥ 1 prior biologic, and were naïve to BKZ. Adverse events (AEs) were collected from BKZ initiation until the earliest of 30 days after the last dose, study discontinuation, or study completion. Descriptive statistics were used to summarize AEs. Results As of 1 March 2023, 592 patients (PsO, n = 335; PsA, n = 198; nr-axSpA, n = 59) were enrolled and initiated BKZ; 316 (53.4%) remained on BKZ. Mean (standard deviation [SD]) exposure was 10.9 (5.5) months; mean (SD) follow-up was 12.0 (4.5) months. Overall, 404 patients (68.2%) reported ≥ 1 AE; most were mild (n = 239; 40.4%) or moderate (n = 284; 47.9%) in severity. Serious AEs were reported in 51 patients (8.6%). The most common AEs were oral candidiasis (n = 98; 16.6%), upper respiratory tract infection (n = 80; 13.5%), and nasopharyngitis (n = 53; 9.0%). There were 12 cases (2.0%) of active tuberculosis or tuberculosis infection, and two cases (0.3%) of ulcerative colitis. No cases of Crohn’s disease, malignancy, or deaths were reported. Conclusions These 2-year interim results from a real-world study support the safety profile of BKZ observed in the clinical trial program. No new safety signals were identified. Long-term follow-up is ongoing.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Article},
 doi = {10.1007/s40264-025-01605-x},
 journal = {Drug Safety},
 keywords = {source: SPRINGER},
 title = {24th {ISoP} {Annual} {Meeting} “{Pharmacovigilance}: {Back} to the {Future}” 24–27 {October} 2025 {Cairo}},
 url = {https://doi.org/10.1007/s40264-025-01605-x},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-10T01:07:17Z},
