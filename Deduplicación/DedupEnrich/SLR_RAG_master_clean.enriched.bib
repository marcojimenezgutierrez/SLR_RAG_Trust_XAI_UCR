@book{noauthor_esecfse_2022,
 abstract = {Severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) has caused a global pandemic of coronavirus disease 2019 (COVID-19). The spike (S) protein of SARS-CoV-2 mediates viral entry into host cells by binding to angiotensin-converting enzyme 2 (ACE2). Here, we report cryo-electron microscopy structures of the SARS-CoV-2 S trimer in the prefusion conformation with all three receptor-binding domains (RBDs) in the "down" conformation and in complex with ACE2 with one RBD in the "up" conformation. The SARS-CoV-2 S trimer is more compact than the SARS-CoV S trimer. The SARS-CoV-2 RBD binds to ACE2 with higher affinity than does the SARS-CoV RBD. These structures provide a blueprint for the design of vaccines and therapeutics.},
