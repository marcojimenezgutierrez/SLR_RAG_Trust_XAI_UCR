@article{antonesi_systematic_2025,
 abstract = {This study proposes a multi-objective optimization framework for designing hybrid renewable energy systems (HRES) integrating solar photovoltaic (PV), wind turbines, and battery storage to minimize levelized cost of energy (LCOE) and greenhouse gas emissions while ensuring reliability. A novel genetic algorithm-based approach is developed, incorporating uncertainty in renewable resource availability and load demand using Monte Carlo simulations. Case studies on residential, commercial, and grid-scale applications in different climatic zones demonstrate that the optimized HRES achieves up to 25% reduction in LCOE compared to conventional grid-dependent systems, with payback periods under 6 years. Sensitivity analysis highlights the impact of battery degradation and policy incentives on system performance, providing insights for policymakers and engineers to accelerate the transition to sustainable energy infrastructures.},
