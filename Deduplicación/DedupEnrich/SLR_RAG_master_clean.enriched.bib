 abstract_source = {x-ai/grok-4-fast},
 annote = {Article},
 author = {Bostanci},
 doi = {10.1007/s00464-025-12315-x},
 journal = {Surgical Endoscopy},
 keywords = {source: SPRINGER},
 title = {{ChatGPT} and other large language models in laparoscopic cholecystectomy: a multidimensional audit of reliability},
 url = {https://doi.org/10.1007/s00464-025-12315-x},
 x_enrich_source = {x-ai/grok-4-fast},
