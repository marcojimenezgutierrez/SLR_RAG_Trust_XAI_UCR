@book{noauthor_icer_2023,
 abstract = {Obesity is a major risk factor for type 2 diabetes, cardiovascular disease, and certain types of cancer. The mechanisms underlying obesity-associated insulin resistance and metabolic dysfunction are not fully understood. Here we show that obesity induces endoplasmic reticulum (ER) stress in the liver and adipose tissue of ob/ob mice and that chemical chaperones, which are known to alleviate ER stress, improve insulin sensitivity and reduce adiposity in ob/ob and diet-induced obese mice. We also show that ER stress triggers the unfolded protein response (UPR) and activates c-Jun N-terminal kinase (JNK), which in turn serine phosphorylates insulin receptor substrate-1 (IRS-1) and suppresses insulin signaling. Genetic ablation of Xbp-1, a transcription factor involved in the UPR, enhances insulin resistance in diet-induced obese mice. These results indicate that ER stress is a central feature of peripheral insulin resistance in obesity and type 2 diabetes and suggest that chemical chaperones may have therapeutic potential for metabolic diseases.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
