@article{bedi_xlr-kgdd_2025,
 abstract = {Graph neural networks (GNNs) have achieved remarkable success in various domains by leveraging the topology of graph-structured data. Recently, GNNs have been widely used in recommender systems (RSs) to model high-order interactions between users and items. However, existing GNN-based RSs suffer from several critical issues, including the cold-start problem, data sparsity, and scalability. To address these challenges, we propose a novel GNN-based recommendation framework, named Hypergraph Attention Network with Contrastive Learning (HATCL), which integrates hypergraph modeling and contrastive learning to enhance recommendation performance. Specifically, we first construct a hypergraph to capture the complex interactions among users and items. Then, we design a hypergraph attention mechanism to learn node embeddings by aggregating information from hyperedges. To alleviate the data sparsity issue, we introduce a contrastive learning module that generates positive and negative samples through hyperedge dropout and learns robust representations by maximizing the agreement between augmented views. Extensive experiments on three real-world datasets demonstrate that HATCL outperforms state-of-the-art baselines in terms of recommendation accuracy and achieves better generalization on cold-start scenarios.},
