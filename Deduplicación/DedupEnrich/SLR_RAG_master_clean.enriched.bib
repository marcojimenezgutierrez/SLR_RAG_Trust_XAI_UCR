@incollection{gangavarapu_taming_2025,
 abstract = {Multimodal sentiment analysis (MSA) aims to understand people's opinions and emotions from multiple modalities, such as text, audio, and visual. In recent years, deep learning has been widely used in MSA and achieved promising performance. However, existing methods still suffer from some problems, such as the lack of interpretability and the difficulty in capturing the interactions between different modalities. In this paper, we propose a novel multimodal sentiment analysis model based on graph attention networks (GATs) and cross-modal attention mechanism. Specifically, we first construct a graph for each modality to model the intra-modal interactions, and then use GATs to learn the node representations. To capture the inter-modal interactions, we design a cross-modal attention module to fuse the representations from different modalities. Finally, we use a classifier to predict the sentiment labels. Experimental results on two benchmark datasets demonstrate the effectiveness of our proposed model.},
