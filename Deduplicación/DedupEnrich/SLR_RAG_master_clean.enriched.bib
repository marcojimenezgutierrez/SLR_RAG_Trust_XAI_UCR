 journal = {European Journal on Criminal Policy and Research},
 keywords = {source: SPRINGER},
 title = {Food {Crime}: {Deterrence} of a {Potential} {Money} {Laundering} {Typology} {Through} {Blockchain} and {Generative} {Artificial} {Intelligence} ({Gen} {AI})},
