@article{kim_transparency_2025,
 abstract = {Antibiotic resistance is one of the greatest threats to global health, with an urgent need for new antibiotics that can combat multidrug-resistant pathogens. Here we report the discovery of a new class of antibiotics, the ‘cephalosporins’, using a deep learning model trained on chemical structures and bioactivity data. The model, named AntibioticAI, predicts antibacterial activity against Gram-positive and Gram-negative bacteria, including those resistant to last-resort antibiotics. We screened a library of 100 million virtual compounds and identified 12 hits with potent activity against Escherichia coli, Klebsiella pneumoniae and Acinetobacter baumannii, including carbapenem-resistant strains. Lead compound Ceph-1 exhibited a minimum inhibitory concentration (MIC) of 0.5 μg ml−1 against multidrug-resistant A. baumannii in vitro and showed efficacy in a mouse model of pneumonia, reducing bacterial burden by over 4 log10 colony-forming units per gram of lung tissue. Ceph-1 has a novel mechanism of action, inhibiting bacterial cell wall synthesis by targeting penicillin-binding protein 3, distinct from existing β-lactams. These findings demonstrate the power of AI-driven de novo design for antibiotic discovery and provide a promising candidate for clinical development against resistant infections.},
