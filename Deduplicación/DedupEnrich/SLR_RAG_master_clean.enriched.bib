@inproceedings{yao_lawyer_2024,
 abstract = {We present a novel approach for dense semantic SLAM that leverages neural implicit representations to achieve high-fidelity geometry and semantics reconstruction in real-time. Traditional SLAM systems often struggle with semantic integration, leading to sparse or inconsistent understanding of the environment. Our method, Neural Implicit Dense Semantic SLAM (NIDS-SLAM), combines neural radiance fields (NeRF) with semantic segmentation networks to implicitly encode both visual appearance and class labels in a continuous 3D space. By optimizing a unified loss function that includes photometric, geometric, and semantic supervision, NIDS-SLAM enables robust tracking and mapping even in challenging scenarios with dynamic objects or low-texture regions. Extensive experiments on benchmark datasets like TUM RGB-D and Replica demonstrate that our system outperforms state-of-the-art methods in terms of trajectory accuracy, reconstruction quality, and semantic consistency, while maintaining real-time performance on commodity hardware.},
