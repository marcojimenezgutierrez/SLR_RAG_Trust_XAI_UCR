@article{thanasi-boce_ideas_2024,
 abstract = {Artificial intelligence (AI) is rapidly transforming various sectors, including education. This systematic literature review aims to explore the applications, benefits, challenges, and future directions of AI in education. Following the PRISMA guidelines, we searched Web of Science, Scopus, and ERIC databases for peer-reviewed articles published between 2010 and 2023, resulting in 156 studies included in the analysis. The findings reveal that AI is predominantly used for personalized learning, intelligent tutoring systems, automated assessment, and predictive analytics to enhance student outcomes. Key benefits include improved accessibility, efficiency in administrative tasks, and adaptive learning experiences. However, challenges such as ethical issues, data privacy concerns, algorithmic bias, and the digital divide persist. The review also identifies emerging trends like AI-driven virtual reality and natural language processing in education. We conclude with recommendations for educators, policymakers, and researchers to foster equitable and effective AI integration in educational settings.},
