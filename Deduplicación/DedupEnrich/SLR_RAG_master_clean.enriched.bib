@article{lin_large_2025,
 abstract = {Background Antimicrobial resistance (AMR) poses a major threat to global health. We aimed to provide comprehensive estimates of the global burden of bacterial AMR between 1990 and 2021, including deaths and disability-adjusted life-years (DALYs) attributable to 22 bacterial pathogens and 88 pathogen–drug combinations in 204 countries and territories.

Methods We used data from the Global Burden of Diseases, Injuries, and Risk Factors Study (GBD) 2021 to estimate the burden of AMR. We modelled the fatal and associated burden of AMR using a Bayesian meta-regression tool, Disease Burden by Cause Based on Informatic Tools (DisMod-MR), and the Cause of Death Ensemble model (CODEm). We used the GBD 2021 antimicrobial resistance estimation framework, which incorporates data from multiple sources, including vital registration, surveillance systems, and hospital discharge data. We estimated the burden attributable to resistance to first-line drugs for 22 bacterial pathogens and the burden associated with resistance to any antibiotic for those pathogens.

Findings In 2021, 1·14 million (95% uncertainty interval [UI] 0·85–1·55) deaths were directly attributable to bacterial AMR, and 4·71 million (3·63–6·01) deaths were associated with bacterial AMR. The highest numbers of AMR-associated deaths were in sub-Saharan Africa, South Asia, and eastern Asia. The six pathogen–drug combinations associated with the highest numbers of deaths in 2021 were methicillin-resistant Staphylococcus aureus (MRSA; 109 000 deaths [95% UI 77 000–147 000]), Escherichia coli resistant to third-generation cephalosporins (92 000 deaths [68 000–124 000]), carbapenem-resistant Acinetobacter baumannii (86 000 deaths [63 000–116 000]), fluoroquinolone-resistant E coli (69 000 deaths [51 000–93 000]), carbapenem-resistant Pseudomonas aeruginosa (65 000 deaths [48 000–88 000]), and third-generation cephalosporin-resistant Klebsiella pneumoniae (64 000 deaths [47 000–86 000]). The highest age-standardised death rates due to AMR were in western sub-Saharan Africa (27·3 deaths per 100 000 population [95% UI 20·1–36·1]) and Oceania (26·7 per 100 000 [19·6–35·9]). Between 1990 and 2021, the age-standardised death rate due to AMR increased by 68·4% (95% UI 60·7–77·3), whereas the age-standardised DALY rate increased by 64·7% (56·8–73·6).

Interpretation Bacterial AMR is a growing threat to global health, with the highest burden in low-resource settings. Urgent action is needed to address this crisis through improved surveillance, antimicrobial stewardship, and access to effective antibiotics.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Cited by: 0; All Open Access; Gold Open Access; Green Accepted Open Access; Green Open Access},
