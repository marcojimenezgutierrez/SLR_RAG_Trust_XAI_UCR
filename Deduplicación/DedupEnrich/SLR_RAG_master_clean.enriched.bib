@inproceedings{prasongpongchai_talk_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in a wide range of natural language processing tasks. However, their impressive performance often comes at the cost of high computational and memory requirements, making them inaccessible for many real-world applications. Knowledge distillation has emerged as a popular technique to compress LLMs into smaller, more efficient models while preserving their performance. Despite its effectiveness, existing distillation methods often overlook the fairness implications of the student model, potentially perpetuating or even amplifying biases present in the teacher model. In this paper, we propose FairDistil, a novel framework for fair knowledge distillation that explicitly incorporates fairness constraints during the distillation process. Our approach leverages adversarial training to mitigate biases in the student model with respect to sensitive attributes, while maintaining high task performance. We evaluate FairDistil on multiple benchmark datasets across various NLP tasks, demonstrating significant improvements in fairness metrics (e.g., demographic parity and equalized odds) compared to standard distillation baselines, with minimal degradation in accuracy. Our results highlight the importance of fairness-aware distillation for deploying equitable AI systems in resource-constrained environments.},
