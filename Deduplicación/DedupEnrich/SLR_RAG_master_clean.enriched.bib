@article{hu_future_2024,
 abstract = {The construction sector is a major contributor to global environmental degradation, resource depletion, and waste generation. Adopting circular economy (CE) principles in construction offers a pathway to sustainability by emphasizing resource efficiency, waste minimization, and closed-loop systems. This study employs bibliometric analysis to map the intellectual landscape of CE research in the construction industry. Using the Scopus database, we analyzed 1234 publications from 2000 to 2023. The findings indicate a surge in research interest post-2015, with key themes encompassing waste management, sustainable building materials, and circular design strategies. Prominent contributors include researchers from the UK, China, and the USA, with journals like "Journal of Cleaner Production" being highly influential. This review identifies research gaps, such as the need for more empirical studies on implementation barriers and policy frameworks, providing a roadmap for advancing CE adoption in construction towards sustainable development goals.},
