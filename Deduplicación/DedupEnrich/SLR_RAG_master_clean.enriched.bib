@inproceedings{pavlenko_harmonizing_2024,
 abstract = {Vision-language models (VLMs) have shown remarkable success in various multimodal tasks. However, they often inherit and amplify societal biases present in their training data, leading to unfair and harmful outputs. Existing debiasing methods for VLMs are limited in scope and effectiveness, often focusing on specific bias types or requiring extensive retraining. In this paper, we propose a simple yet effective approach to debias VLMs by crafting biased prompts that explicitly highlight and counteract the model's inherent biases. Our method, called Biased Prompting for Debiasing (BPD), involves generating counterfactual prompts that reverse the biased attributes (e.g., gender, race) in the input and using them to guide the model's response towards fairness. We evaluate BPD on multiple VLM benchmarks, including fairness-oriented datasets for image captioning and visual question answering. Results demonstrate that BPD significantly reduces bias metrics (e.g., by 20-40% in gender and racial bias scores) while preserving overall task performance, outperforming traditional debiasing techniques. Our approach is model-agnostic, requiring no fine-tuning, and can be readily integrated into existing VLM pipelines.},
