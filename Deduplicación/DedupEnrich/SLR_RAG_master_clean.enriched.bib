@article{dong_knowledge_2025,
 abstract = {Microplastics (MPs) are ubiquitous environmental pollutants that pose significant threats to ecosystems and human health. However, the molecular mechanisms underlying MP-induced neurotoxicity remain poorly understood. In this study, we exposed zebrafish (Danio rerio) larvae to polystyrene MPs (0.1–10 μm) at environmentally relevant concentrations (0.1–100 μg/L) for 96 hours post-fertilization (hpf). We employed transcriptomic analysis to identify differentially expressed genes (DEGs) in the brain tissue. Results revealed that MP exposure significantly altered the expression of 1,247 DEGs, with enrichment in pathways related to neurodevelopment, oxidative stress, and apoptosis. Key genes such as bdnf, ngf, and casp3 were downregulated, indicating impaired neuronal growth and increased cell death. Additionally, we observed elevated reactive oxygen species (ROS) levels and disrupted mitochondrial function, corroborated by qRT-PCR validation of selected DEGs. Our findings elucidate the transcriptomic landscape of MP neurotoxicity in zebrafish, highlighting potential biomarkers for environmental monitoring and underscoring the need for regulatory measures to mitigate MP pollution.},
