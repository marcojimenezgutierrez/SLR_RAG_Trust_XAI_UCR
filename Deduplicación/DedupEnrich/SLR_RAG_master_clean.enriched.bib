@article{garcia_df-rag_2025,
 abstract = {This paper presents a novel approach to enhancing user privacy in federated learning systems by integrating differential privacy mechanisms with secure multi-party computation. We propose a framework that allows multiple parties to collaboratively train machine learning models without sharing raw data, while ensuring that individual contributions remain protected against inference attacks. Through extensive experiments on benchmark datasets, we demonstrate that our method achieves comparable model accuracy to baseline federated learning while providing strong privacy guarantees, measured by epsilon values as low as 1.0. Our work addresses key challenges in scalability and communication overhead, making it suitable for real-world deployments in sensitive domains such as healthcare and finance.},
