@article{siino_foundations_2025,
 abstract = {Machine learning has achieved considerable success in recent years, particularly in the domains of computer vision, natural language processing, and speech recognition. However, many of these successes are based on supervised learning, which requires large amounts of labeled data. In this tutorial, we introduce deep reinforcement learning (DRL), a paradigm that combines deep learning with reinforcement learning to enable agents to learn from interactions with the environment without explicit supervision. We cover the fundamentals of reinforcement learning, including Markov decision processes, value functions, and policy gradients. We then discuss how deep neural networks can be used to approximate these components, leading to powerful algorithms such as deep Q-networks (DQN), policy gradients, actor-critic methods, and proximal policy optimization (PPO). We also review applications of DRL in robotics, gaming, and autonomous systems, and discuss challenges such as sample efficiency, exploration, and safety. This tutorial aims to provide a comprehensive overview for researchers and practitioners interested in applying DRL to real-world problems.},
