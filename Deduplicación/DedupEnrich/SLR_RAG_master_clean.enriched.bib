@inproceedings{rao_fostering_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in a wide range of natural language processing tasks. However, their impressive performance often comes at the cost of generating biased outputs, which can perpetuate and amplify societal stereotypes and inequalities. Existing debiasing methods for LLMs are often task-specific, focus on a single type of bias, or require substantial additional resources. In this paper, we propose FairLLM, a unified framework for mitigating multiple types of biases during the fine-tuning of LLMs. FairLLM leverages a self-supervised learning approach to generate counterfactual data that counters various biases, and incorporates a fairness-aware objective into the fine-tuning process. Our method is model-agnostic and can be seamlessly integrated into standard fine-tuning pipelines. Extensive experiments on multiple datasets and bias types demonstrate that FairLLM significantly improves fairness across gender, race, and profession biases while preserving the model's overall performance. Our framework provides a practical and scalable solution for deploying fairer LLMs in real-world applications.},
