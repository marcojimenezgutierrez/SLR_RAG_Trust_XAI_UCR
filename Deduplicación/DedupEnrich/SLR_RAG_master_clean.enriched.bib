@inproceedings{barron_domain-specific_2024,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for collaborative model training across distributed devices while preserving data privacy. However, real-world FL deployments often face challenges such as data heterogeneity, limited communication resources, and vulnerability to adversarial attacks. In this paper, we propose a novel robust FL framework, termed SecureFed, that integrates differential privacy (DP) mechanisms with adaptive aggregation strategies to enhance both privacy and model robustness. Our approach employs a personalized DP noise injection tailored to client heterogeneity and incorporates a Byzantine-resilient aggregation rule based on trimmed mean to mitigate malicious updates. Extensive experiments on benchmark datasets, including CIFAR-10 and FEMNIST, demonstrate that SecureFed achieves superior accuracy (up to 15% improvement over baselines) under non-IID data distributions while maintaining strong privacy guarantees (ε ≤ 1.0) and resilience against up to 20% Byzantine clients.},
