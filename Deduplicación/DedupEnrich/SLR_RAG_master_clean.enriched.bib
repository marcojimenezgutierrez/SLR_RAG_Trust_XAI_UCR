@inproceedings{russo_europeanlawadvisor_2024,
 abstract = {Graph neural networks (GNNs) have achieved remarkable success in various domains by leveraging the relational inductive biases of graph-structured data. However, real-world graphs often exhibit intricate higher-order dependencies that go beyond simple pairwise interactions, such as multi-node interactions, hyperedges, and higher-order connectivity patterns. To address these limitations, higher-order graph neural networks (HOGNNs) have emerged as a promising direction, extending traditional GNNs to model complex relational structures. In this survey, we provide a comprehensive overview of HOGNNs, categorizing them based on their modeling paradigms, including simplicial complexes, hypergraphs, and motifs. We discuss key techniques for capturing higher-order dependencies, such as simplicial attention mechanisms, hypergraph convolutions, and motif-based message passing. Furthermore, we highlight applications of HOGNNs in diverse fields like social network analysis, biological network modeling, and recommender systems. We also identify challenges, including scalability, interpretability, and generalization, and outline promising future research directions to advance the field of higher-order graph representation learning.},
