@article{wang_internet_2025,
 abstract = {In this paper, we propose a novel framework for federated learning in wireless edge networks with mobility-aware client selection. Traditional federated learning schemes suffer from performance degradation due to client mobility, which leads to frequent disconnections and heterogeneous data distributions. To address this, we formulate the client selection problem as a contextual bandit, where the reward is the model accuracy improvement, and the context captures mobility patterns and channel conditions. We develop a lightweight algorithm that dynamically selects clients based on historical rewards and current contexts, ensuring convergence to the optimal policy. Simulation results on realistic mobility traces show that our approach improves model accuracy by up to 25% compared to static and random selection methods, while reducing communication overhead.},
