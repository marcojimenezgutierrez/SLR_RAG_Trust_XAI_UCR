@article{choi_unlocking_2024,
 abstract = {This paper addresses the problem of adaptive fuzzy output feedback control for a class of uncertain nonlinear strict-feedback systems with unmeasured states and time-varying delays. Fuzzy logic systems are employed to approximate the unknown nonlinear functions, and a fuzzy state observer is constructed to estimate the unmeasured states. By using the backstepping technique and Lyapunov–Krasovskii functionals, an adaptive fuzzy output feedback control scheme is developed. It is proved that all the signals in the closed-loop system are bounded, and the tracking error converges to a small neighborhood of the origin. Simulation results are provided to demonstrate the effectiveness of the proposed control scheme.},
