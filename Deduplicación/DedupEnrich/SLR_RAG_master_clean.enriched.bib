@inproceedings{kenthapadi_grounding_2024,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating human-like text, but their outputs can sometimes be inconsistent or misaligned with user intentions. This paper investigates the potential of LLMs as creative partners in storytelling, focusing on how they can co-create narratives with human writers. Through a series of workshops with 20 professional writers, we explore interaction paradigms, including prompt engineering, iterative refinement, and role-playing scenarios. Our findings reveal that while LLMs excel at idea generation and plot expansion, challenges remain in maintaining narrative coherence and emotional depth. We propose design guidelines for LLM-assisted writing tools and discuss implications for creative industries.},
