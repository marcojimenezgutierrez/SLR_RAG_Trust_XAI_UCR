@article{trigka_evolution_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly influenced various sectors, including healthcare, where AI-driven diagnostic tools are becoming increasingly prevalent. This paper explores the integration of deep learning models for early detection of cardiovascular diseases using electrocardiogram (ECG) signals. We propose a novel convolutional neural network (CNN) architecture combined with attention mechanisms to enhance feature extraction and classification accuracy. The model is trained and validated on a large dataset comprising over 50,000 ECG records from diverse patient populations. Experimental results demonstrate that our approach achieves an accuracy of 98.5%, surpassing traditional methods by 12%. Furthermore, we discuss ethical considerations, such as data privacy and model interpretability, to ensure responsible deployment in clinical settings. This work contributes to the ongoing efforts in AI-assisted medicine by providing a robust, scalable solution for real-time cardiac monitoring.},
