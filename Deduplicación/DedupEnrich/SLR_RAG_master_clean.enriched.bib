@inproceedings{wang_designing_2025,
 abstract = {Generative AI has shown great potential in automating complex tasks, but its application in creative writing remains underexplored, particularly in collaborative settings. We investigate how generative AI can support co-writing between humans and AI, focusing on the interplay of agency, creativity, and narrative coherence. Through a series of workshops with writers, we identify key challenges in maintaining authorial voice and plot consistency when integrating AI-generated content. Our findings reveal that while AI excels at producing diverse ideas, human oversight is crucial for refining emotional depth and thematic unity. We propose a framework for hybrid co-writing interfaces that balance AI assistance with human control, emphasizing iterative feedback loops and transparency in AI decision-making. This work contributes to HCI by highlighting design implications for AI tools in creative domains, advocating for systems that augment rather than replace human creativity.},
