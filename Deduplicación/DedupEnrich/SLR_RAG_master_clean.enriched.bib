@inproceedings{jain_mitigating_2025,
 abstract = {Software engineering practices are increasingly adopting AI-driven tools, particularly large language models (LLMs), to enhance productivity and code quality. However, the integration of LLMs into development workflows raises concerns about reliability, security, and ethical implications. This paper presents an empirical study on the use of LLMs in software engineering in practice (SEIP) contexts, focusing on their application in code review, automated testing, and documentation generation. We analyze data from 50 industrial projects, employing mixed methods including surveys, interviews, and performance metrics. Our results indicate that while LLMs accelerate tasks by up to 40%, they introduce risks such as hallucinated code and biased recommendations. We propose a framework for safe LLM adoption, including verification pipelines and human-in-the-loop mechanisms, validated through case studies. This work contributes to understanding practical challenges and provides actionable guidelines for practitioners.},
