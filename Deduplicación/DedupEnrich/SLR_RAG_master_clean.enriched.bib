@inproceedings{abrahamyan_stackrag_2024,
 abstract = {Jupyter Notebooks are widely used in data science and machine learning for their ability to combine code, visualizations, and narrative text in a single document. However, notebooks often exhibit code smells—symptoms of deeper design problems—that can hinder maintainability, reproducibility, and collaboration. Detecting these smells in notebooks is challenging due to their unique structure, which mixes executable code cells with markdown cells and outputs. Existing smell detection tools are primarily designed for traditional source code and do not adequately handle notebook-specific constructs. In this paper, we propose NotebookSmellDetector, a novel static analysis tool tailored for detecting code smells in Jupyter Notebooks. Our approach extends traditional smell detection techniques to account for notebook idiosyncrasies, such as cell dependencies, output pollution, and narrative-code entanglement. We implement detectors for five common notebook smells: Long Cell, Output Pollution, Unused Imports, Data Leakage, and Narrative Bloat. To evaluate our tool, we apply it to a corpus of 1,000 open-source notebooks from GitHub, revealing that 78% contain at least one smell, with Output Pollution being the most prevalent (52%). We also conduct a user study with 20 data scientists, who confirm the relevance of the detected smells and appreciate the tool's feedback. Our work provides the first comprehensive framework for notebook smell detection, enabling practitioners to improve notebook quality and researchers to study code quality in data science artifacts.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 author = {Abrahamyan},
 booktitle = {2024 {IEEE} {International} {Conference} on {Software} {Maintenance} and {Evolution} ({ICSME})},
