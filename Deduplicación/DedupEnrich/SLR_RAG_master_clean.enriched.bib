@inproceedings{tang_this_2025,
 abstract = {Photorealistic head avatars that can be animated with blendshapes are an important tool for applications such as virtual telepresence and film production. Current approaches either use linear or non-linear blendshape models, which lack photorealism, or neural radiance fields (NeRFs), which are difficult to animate. We propose GaussianAvatars, a novel representation for photorealistic head avatars that combines the expressiveness of 3D Gaussians with the control of blendshapes. Our method represents the head as a collection of 3D Gaussians in canonical space, which are deformed using a parametric blendshape model. This allows for efficient rendering and precise control over facial expressions. To capture high-frequency details, we introduce a multi-resolution Gaussian splatting approach. We demonstrate that GaussianAvatars achieve state-of-the-art photorealism and animation quality on benchmark datasets.},
