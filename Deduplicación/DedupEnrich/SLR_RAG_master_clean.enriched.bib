@inproceedings{reinhard_fact_2025,
 abstract = {In this paper, we investigate the role of silence in human-AI collaboration, particularly in conversational AI systems. While silence is a natural and meaningful aspect of human communication, its implications in AI interactions remain underexplored. We conducted a mixed-methods study involving 120 participants interacting with a conversational AI agent in task-oriented scenarios, analyzing how periods of silence—both intentional and unintentional—affect user perception, task efficiency, and emotional response. Our findings reveal that AI-induced silence can enhance user reflection and creativity but may also lead to frustration and disengagement if perceived as unresponsive. We identify key factors influencing these outcomes, including silence duration, context, and user personality traits. Based on these insights, we propose design guidelines for AI systems to incorporate adaptive silence mechanisms, fostering more natural and effective human-AI partnerships. Our work contributes to the broader understanding of non-verbal cues in AI design and highlights the need for nuanced handling of temporal dynamics in interactive systems.},
