@article{gonzalez_cognitive_2025,
 abstract = {The replication crisis in psychology has led to widespread calls for preregistration and other transparency practices. However, these practices are often framed as solutions to a narrowly defined problem: the file-drawer problem. Here, we argue that the replication crisis is better understood as a crisis of trust, stemming from a lack of shared standards for what constitutes good science. We propose a framework for rebuilding trust through the development of community-driven standards that go beyond preregistration to encompass the full research lifecycle, including theory-building, data collection, analysis and interpretation. Drawing on examples from cognitive psychology, we illustrate how such standards could be implemented and evaluate their potential to restore confidence in psychological science.},
