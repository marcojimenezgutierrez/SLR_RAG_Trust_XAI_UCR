 abstract_source = {x-ai/grok-4-fast},
 annote = {Article},
 doi = {10.1007/s00520-025-09559-7},
 journal = {Supportive Care in Cancer},
 keywords = {source: SPRINGER},
 title = {Abstracts for {MASCC}/{ISOO} {Annual} {Meeting} 2025},
 url = {https://doi.org/10.1007/s00520-025-09559-7},
