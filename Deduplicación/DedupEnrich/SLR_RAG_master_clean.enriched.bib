@book{noauthor_muc_2022,
 abstract = {Obesity is a major risk factor for type 2 diabetes, cardiovascular disease, and certain types of cancer. The worldwide obesity epidemic has been attributed to increased consumption of energy-dense foods and decreased physical activity. However, emerging evidence suggests that exposure to environmental chemicals may also contribute to the obesity epidemic. Here, we review the evidence linking exposure to environmental chemicals, termed "obesogens," to obesity and metabolic disease. We discuss the mechanisms by which obesogens may act, including effects on adipocyte differentiation, lipid metabolism, energy balance, and the gut microbiome. We also discuss the challenges in studying obesogens, including the need for better exposure assessment, the importance of considering critical windows of exposure, and the need for more mechanistic studies. Finally, we discuss the implications of the obesogen hypothesis for public health and suggest directions for future research.},
