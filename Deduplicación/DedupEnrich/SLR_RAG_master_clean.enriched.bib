@article{fan_why_2025,
 abstract = {Explainable artificial intelligence (XAI) is gaining increasing attention in medical imaging to address the black-box nature of deep learning models and enhance trust in clinical decision-making. This chapter provides a comprehensive overview of XAI methods applied to medical imaging tasks, including image classification, segmentation, and detection. We categorize XAI techniques into intrinsic and post-hoc methods, discussing their principles, strengths, and limitations. Key methods such as LIME, SHAP, Grad-CAM, and attention mechanisms are reviewed with examples from radiology, pathology, and cardiology imaging. We also explore evaluation strategies for XAI explanations, including faithfulness, plausibility, and user studies. Finally, we highlight challenges like computational efficiency, clinical interpretability, and regulatory considerations, along with future directions for advancing XAI in medical imaging to support safer AI-assisted diagnostics.},
