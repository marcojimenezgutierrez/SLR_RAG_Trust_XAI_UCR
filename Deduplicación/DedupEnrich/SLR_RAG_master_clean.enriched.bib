@article{noauthor_abstracts_2024,
 abstract = {Background: Following the Dobbs v. Jackson Women’s Health Organization decision in 2022, state abortion policies rapidly changed, potentially impacting access to care and health outcomes.

Objective: To evaluate the association between state abortion policies and pediatric emergency department (ED) utilization for abortion-related care.

Design: Retrospective cross-sectional study using the Pediatric Health Information System (PHIS) database from 2019 to 2022.

Participants: Female patients aged 10–21 years presenting to pediatric EDs with a primary or secondary diagnosis related to abortion, miscarriage, or pregnancy.

Main Measures: ED visits for abortion-related care, stratified by state abortion policy (ban, restriction, or protection).

Key Results: From 2019 to 2022, there were 1,234 ED visits for abortion-related care among 1,082 unique patients. States with abortion bans had 28% lower odds of ED visits for abortion-related care compared to states with protections (adjusted odds ratio [aOR] 0.72, 95% CI 0.55–0.94). This association was driven by visits for complications of induced abortion (aOR 0.64, 95% CI 0.45–0.91). There was no significant difference in visits for miscarriage or other pregnancy-related care.

Conclusions: State abortion bans were associated with decreased ED utilization for abortion-related care, particularly complications of induced abortion, suggesting potential underutilization of emergency care in restrictive states.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Article},
 doi = {10.1007/s11606-024-08797-5},
 journal = {Journal of General Internal Medicine},
 keywords = {source: SPRINGER},
 title = {Abstracts from the 2024 {Annual} {Meeting} of the {Society} of {General} {Internal} {Medicine}},
 url = {https://doi.org/10.1007/s11606-024-08797-5},
