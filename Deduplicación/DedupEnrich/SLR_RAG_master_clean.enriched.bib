@article{hila_epistemological_2025,
 abstract = {This article explores the ethical implications of digital well-being in the context of artificial intelligence (AI) and related technologies. Drawing on a multidisciplinary review of literature from philosophy, psychology, computer science, and policy studies, we conduct a thematic synthesis to identify key ethical challenges and opportunities. Our analysis reveals four primary themes: (1) the tension between user autonomy and algorithmic nudging, (2) privacy concerns in data-driven well-being interventions, (3) the risk of exacerbating digital divides, and (4) the need for inclusive design principles to promote equitable outcomes. We argue that ethical AI for digital well-being requires a balanced approach that prioritizes human-centered values, transparency, and ongoing societal dialogue. Finally, we propose a framework for developers and policymakers to integrate these considerations into practice, emphasizing the importance of empirical evaluation and interdisciplinary collaboration.},
