@book{noauthor_aiccc_2024,
 abstract = {Soil organic carbon (SOC) is a key component of the global carbon cycle and plays an important role in climate change mitigation. However, the spatial distribution of SOC stocks and their controlling factors at large scales remain poorly understood. Here, we compiled a comprehensive dataset of 5,275 soil profiles across China and used machine learning algorithms to map SOC stocks and identify their main controlling factors. Our results show that the total SOC stock in the top 1 m of soil across China is 69.8 ± 5.4 Pg C, with a mean density of 7.5 ± 0.6 kg C m−2. SOC stocks show large spatial variations, with higher values in northeastern and southwestern China and lower values in northwestern China. Climate variables, particularly mean annual precipitation and temperature, are the most important factors controlling SOC distribution at the national scale, explaining 42% and 23% of the spatial variation, respectively. Soil properties, especially soil pH and clay content, also play important roles in regulating SOC stocks. Our findings provide a comprehensive assessment of SOC stocks in China and highlight the importance of climate and soil properties in controlling SOC distribution, which has important implications for understanding the terrestrial carbon cycle and developing climate change mitigation strategies.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 address = {New York},
