@inproceedings{tuck_llms_2025,
 abstract = {People with intellectual and sensory disabilities (IPSD) often face barriers in accessing and interacting with digital technologies due to their unique needs. Multimodal interfaces, which integrate multiple sensory channels (e.g., visual, auditory, tactile), hold promise for enhancing accessibility. However, designing such interfaces for IPSD requires understanding their diverse requirements, which are often overlooked in current HCI research. In this paper, we investigate the design of inclusive multimodal interfaces through a participatory design approach involving 12 IPSD participants, their caregivers, and accessibility experts. We conducted workshops to co-design prototypes and iteratively refined them based on feedback. Our findings reveal key design considerations, including adaptive modality switching, simplified interaction flows, and emotional expressiveness. We contribute a framework for inclusive multimodal design and demonstrate its application through a prototype evaluated in real-world scenarios, showing improved usability and engagement for IPSD users.},
