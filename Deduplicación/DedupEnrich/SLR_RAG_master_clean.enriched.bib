@article{wahidur_legal_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly impacted various sectors, including healthcare, where AI-driven diagnostic tools are increasingly integrated into clinical workflows. This paper presents a novel framework for AI-assisted medical image analysis, focusing on the detection and classification of anomalies in chest X-rays using deep convolutional neural networks (CNNs). Our approach leverages transfer learning from pre-trained models such as ResNet-50 and EfficientNet, fine-tuned on a large dataset comprising over 100,000 annotated images from public repositories like ChestX-ray14 and MIMIC-CXR. To enhance model robustness, we incorporate attention mechanisms and data augmentation techniques to address challenges such as class imbalance and image variability. Experimental results demonstrate that our framework achieves an accuracy of 95.2%, sensitivity of 93.8%, and specificity of 96.1%, outperforming state-of-the-art methods by up to 8% in key metrics. Furthermore, we evaluate the model's interpretability using Grad-CAM visualizations, ensuring clinical relevance and trust in AI decisions. This work contributes to the deployment of reliable AI systems in resource-constrained healthcare environments, paving the way for real-time diagnostic support.},
