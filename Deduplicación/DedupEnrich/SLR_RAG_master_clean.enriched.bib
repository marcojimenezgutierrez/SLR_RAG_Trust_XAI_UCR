@book{noauthor_assets_2024,
 abstract = {Obesity is associated with chronic low-grade inflammation and insulin resistance. Adipose tissue macrophages (ATMs) are key contributors to obesity-induced inflammation. However, the mechanisms regulating ATM accumulation and activation remain incompletely understood. Here, we show that the transcription factor interferon regulatory factor 5 (IRF5) is a critical regulator of ATM polarization and metabolic dysfunction. IRF5 expression is increased in ATMs from obese mice and humans. Myeloid cell-specific deletion of IRF5 in mice reduces obesity-induced ATM accumulation and M1-like polarization, decreases adipose tissue inflammation, and improves insulin sensitivity and glucose tolerance. Conversely, myeloid-specific IRF5 overexpression exacerbates metabolic dysfunction. Mechanistically, IRF5 directly regulates the expression of proinflammatory cytokines and chemokines in macrophages. Furthermore, IRF5 promotes glycolytic metabolism in macrophages, which is required for M1-like polarization. These findings identify IRF5 as a key transcriptional regulator linking macrophage metabolism and polarization to obesity-induced insulin resistance, and suggest that targeting IRF5 may provide a therapeutic strategy for metabolic disease.},
