@incollection{yuan_bibliometric_2025,
 abstract = {Federated learning (FL) enables collaborative model training across distributed devices while keeping data local, enhancing privacy. However, FL is vulnerable to inference attacks that reconstruct private training data from shared model updates. Existing defenses, such as differential privacy (DP), incur significant utility costs, especially in high-dimensional settings like images. We propose DP-FLAME, a novel defense that combines DP with a lightweight model adaptation technique to mitigate these costs. DP-FLAME uses a low-dimensional projection to compress updates before applying DP noise, then reconstructs the full update using a small auxiliary model trained on public data. We theoretically analyze the privacy-utility trade-off and empirically evaluate DP-FLAME on benchmarks like CIFAR-10 and FEMNIST, showing improved accuracy over standard DP-FL while maintaining strong privacy guarantees.},
