@inproceedings{lee_veriplan_2025,
 abstract = {Gaussian Splatting SLAM is a novel approach to dense simultaneous localization and mapping (SLAM) that leverages 3D Gaussian splatting for real-time reconstruction of large-scale scenes. Unlike traditional methods that rely on sparse features or volumetric representations, our system uses a fully dense, differentiable 3D Gaussian representation to model the scene, enabling efficient tracking, mapping, and rendering. We introduce a novel Gaussian splatting formulation that supports dynamic updates to the scene representation during SLAM, allowing for high-fidelity reconstruction even in challenging environments with textureless regions or fast camera motion. Our method achieves state-of-the-art performance in terms of accuracy, efficiency, and visual quality, outperforming NeRF-based and point-based SLAM systems on standard benchmarks.},
