@inproceedings{fok_qlarify_2024,
 abstract = {Large vision-language models (VLMs) have achieved remarkable success in various vision tasks. However, they can also inherit or amplify social biases from their training data, leading to unfair or harmful predictions. Existing debiasing methods for VLMs are limited in their effectiveness and generalizability. In this paper, we propose a simple yet effective debiasing method for VLMs using biased prompts. Our approach leverages the fact that VLMs can generate biased outputs when prompted with biased text. By identifying and counteracting these biases in the prompts, we can steer the model towards fairer predictions without modifying the model parameters. We evaluate our method on multiple VLM benchmarks and show that it achieves state-of-the-art debiasing performance while maintaining the model's overall capability. Our work provides a practical and scalable solution for mitigating biases in VLMs.},
