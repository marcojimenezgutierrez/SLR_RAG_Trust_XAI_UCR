@article{xu_artificial_2025,
 abstract = {Purpose To evaluate the efficacy and safety of low-dose rituximab (RTX) in patients with primary membranous nephropathy (pMN). Methods We conducted a systematic review and meta-analysis by searching PubMed, Embase, Web of Science, and Cochrane Library databases up to December 2023. Randomized controlled trials (RCTs) and observational studies comparing low-dose RTX (≤ 1 g total dose) with standard-dose RTX (> 1 g total dose) or supportive care in adults with pMN were included. The primary outcome was complete or partial remission (CR/PR) of proteinuria at 6 and 12 months. Secondary outcomes included relapse rate, changes in proteinuria, serum albumin, anti-PLA2R antibody levels, renal function, and adverse events. Results Eight studies involving 456 patients were included. Low-dose RTX achieved a pooled CR/PR rate of 68% (95% CI 58–77%) at 6 months and 72% (95% CI 62–81%) at 12 months, comparable to standard-dose RTX (RR 0.98, 95% CI 0.89–1.08). Relapse rates were similar (RR 1.12, 95% CI 0.72–1.74). Low-dose RTX significantly reduced proteinuria (MD − 1.2 g/24 h, 95% CI − 1.8 to − 0.6) and anti-PLA2R levels (MD − 112 RU/mL, 95% CI − 156 to − 68) without differences in renal function preservation. Adverse events were less frequent with low-dose RTX (RR 0.65, 95% CI 0.48–0.88), mainly mild infusion reactions. Conclusion Low-dose RTX is as effective as standard-dose in inducing remission and reducing relapse in pMN, with a favorable safety profile. It represents a cost-effective option, particularly in resource-limited settings.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Article},
 author = {Xu},
 doi = {10.1007/s11255-025-04878-4},
 journal = {International Urology and Nephrology},
 keywords = {source: SPRINGER},
 title = {Artificial intelligence in nephrology: predicting {CKD} progression and personalizing treatment},
 url = {https://doi.org/10.1007/s11255-025-04878-4},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-10T01:09:27Z},
 year = {2025}
