@article{sood_paradigm_2025,
 abstract = {This paper presents a novel framework for optimizing energy-efficient routing in wireless sensor networks using deep reinforcement learning. Traditional routing protocols often struggle with dynamic network topologies and resource constraints, leading to suboptimal performance in terms of energy consumption and data delivery. Our approach integrates a deep Q-network (DQN) model to dynamically select routing paths based on real-time network states, including node energy levels, link quality, and traffic load. Extensive simulations demonstrate that the proposed method achieves up to 35% reduction in energy usage and 20% improvement in packet delivery ratio compared to state-of-the-art algorithms like AODV and LEACH. The framework is scalable and adaptable to heterogeneous sensor networks, making it suitable for IoT applications in smart cities and environmental monitoring.},
