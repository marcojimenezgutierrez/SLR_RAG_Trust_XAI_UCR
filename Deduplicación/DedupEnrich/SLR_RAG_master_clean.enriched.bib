@inproceedings{huang_rd-p_2024,
 abstract = {Visual language models (VLMs) trained on web-scale image-text data have become the foundation of many real-world applications. However, these models often exhibit social biases, making unfair predictions for different demographic groups. Existing debiasing methods for VLMs are limited in their effectiveness and generalizability across different bias types and datasets. In this paper, we propose a simple yet effective debiasing approach for VLMs based on biased prompts. Our method involves generating a set of biased prompts that explicitly introduce the bias we aim to mitigate, and then using these prompts to fine-tune the VLM in a way that encourages the model to ignore such biases. We demonstrate the effectiveness of our approach on multiple bias types, including gender, race, and age, across various VLMs and datasets. Our method achieves significant bias reduction while maintaining the model's performance on downstream tasks.},
