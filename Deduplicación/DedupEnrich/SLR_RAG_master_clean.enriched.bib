@article{namoun_artificial_2025,
 abstract = {Named entity recognition (NER) is a fundamental task in natural language processing (NLP) that identifies and classifies named entities in unstructured text into predefined categories such as person names, organizations, locations, etc. Traditional NER methods relied heavily on hand-crafted features and linguistic rules, which often struggled with domain adaptability and handling complex linguistic phenomena. The advent of deep learning has revolutionized NER by enabling models to automatically learn intricate patterns from large amounts of data, leading to significant improvements in accuracy and generalization. This survey provides a comprehensive overview of deep learning techniques for NER, covering architectures such as recurrent neural networks (RNNs), convolutional neural networks (CNNs), transformers, and hybrid models. We discuss key advancements, including word embeddings, contextual representations (e.g., BERT, ELMo), and transfer learning approaches. Additionally, we explore challenges like low-resource languages, nested entities, and noisy text, along with emerging trends such as multilingual NER, few-shot learning, and integration with knowledge graphs. Finally, we outline future directions to further enhance NER systems for real-world applications.},
