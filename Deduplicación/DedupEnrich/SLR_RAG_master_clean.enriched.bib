@article{yu_empowering_2025,
 abstract = {Multimodal learning has gained significant attention in recent years due to its ability to integrate and process information from multiple data sources, such as text, images, audio, and video. This survey provides a comprehensive overview of deep learning-based multimodal fusion techniques, focusing on their applications, architectures, and challenges. We begin by discussing the motivations and benefits of multimodal fusion, followed by an examination of key datasets and evaluation metrics used in the field. The core of the survey categorizes fusion strategies into early, late, and hybrid approaches, detailing representative models like attention-based mechanisms, graph neural networks, and transformer architectures. We highlight advancements in handling modality incompleteness, alignment, and cross-modal interactions. Finally, we identify open challenges, including scalability, interpretability, and robustness to noise, while outlining promising future directions such as integration with large language models and federated learning for privacy-preserving fusion.},
