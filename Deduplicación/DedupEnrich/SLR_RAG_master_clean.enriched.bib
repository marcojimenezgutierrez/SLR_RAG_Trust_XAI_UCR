@inproceedings{khurana_why_2024,
 abstract = {Programming by example (PBE) is a promising approach for end-user programming, but existing systems often require users to provide many examples and struggle with complex programs. We explore the design space of PBE visual programming languages (VPLs) through the lens of example-guided program synthesis, a technique that uses a small number of examples to synthesize programs. We identify key design decisions in PBE VPLs and propose a framework for designing PBE VPLs that leverage example-guided synthesis. We illustrate our framework with two novel PBE VPLs: one for data wrangling and one for web automation. Our VPLs support complex programs with few examples, enable users to iteratively refine programs, and provide explanations for synthesized programs. Through a user study, we find that our VPLs enable users to solve tasks faster and with higher accuracy than a baseline PBE VPL.},
