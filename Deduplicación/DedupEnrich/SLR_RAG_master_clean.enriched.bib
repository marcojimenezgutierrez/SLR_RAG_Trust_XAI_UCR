@article{delacroix_moral_2025,
 abstract = {Gödel’s Dialectica interpretation provides a constructive interpretation of classical arithmetic in terms of quantifier-free formulas. In this paper, we develop a categorical semantics for the Dialectica interpretation using the notion of a Dialectica category, which is a category equipped with a Dialectica structure. We show that the Dialectica interpretation corresponds to a certain kind of adjunction between the category of sets and the Dialectica category. This categorical perspective allows us to prove the soundness of the interpretation with respect to realizability models in a uniform way. Moreover, it provides a framework for extending the Dialectica interpretation to higher-order logics and other mathematical theories.},
