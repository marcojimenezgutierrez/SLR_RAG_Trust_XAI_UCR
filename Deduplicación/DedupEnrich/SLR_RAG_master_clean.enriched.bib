@inproceedings{wang_artrag_2025,
 abstract = {We present a novel approach for real-time neural radiance field (NeRF) reconstruction from monocular video. While NeRFs show remarkable view synthesis results for a bounded scene, they struggle to generalize to large-scale, unbounded scenes and real-time processing. We introduce Zip-NeRF, a method that enables high-quality, real-time NeRF reconstruction from a single video scan. Our key insight is to leverage recent advances in 3D Gaussian splatting for efficient NeRF rendering and optimization. We introduce a coarse-to-fine strategy that first reconstructs a sparse point cloud from video features, then densifies it using Gaussian splatting, and finally refines the NeRF with a hybrid representation. This allows for fast training and rendering, achieving state-of-the-art quality on large-scale scenes while enabling interactive applications.},
