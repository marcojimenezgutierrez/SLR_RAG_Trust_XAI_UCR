@article{brahma_legal_2025,
 abstract = {This paper presents a thematic synthesis of the ethics of digital well-being, drawing on a systematic review of 128 publications from 2010 to 2023. We identify five key themes: (1) conceptualizations of digital well-being, (2) tensions between well-being and other values, (3) the role of design and technology in promoting well-being, (4) ethical challenges in measuring and assessing digital well-being, and (5) implications for policy and governance. Our synthesis reveals that digital well-being is often framed in terms of psychological, social, and existential dimensions, but there is a lack of consensus on definitions and metrics. We highlight ethical tensions, such as the conflict between user autonomy and paternalistic interventions, and discuss how design choices can either enhance or undermine well-being. The paper concludes with recommendations for future research and ethical guidelines to support the responsible development of digital technologies that foster human flourishing.},
