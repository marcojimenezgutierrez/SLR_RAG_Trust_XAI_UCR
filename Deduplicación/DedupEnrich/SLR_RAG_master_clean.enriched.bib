@article{nirmala_advancing_2025,
 abstract = {This article examines the ethical implications of deploying large language models (LLMs) in professional settings, focusing on the risks of over-reliance and the erosion of critical thinking skills among users. Drawing on psychological and philosophical perspectives, we analyze how LLMs can foster dependency, potentially leading to diminished human autonomy and accountability. Through case studies in education, journalism, and legal practice, we identify key challenges, including bias propagation, misinformation amplification, and the illusion of competence. We propose a balanced approach that integrates LLMs as collaborative tools while emphasizing human oversight, continuous education, and regulatory frameworks to mitigate these risks. Ultimately, we argue for a human-centered AI ethics that prioritizes cognitive resilience and ethical discernment in an increasingly automated world.},
