@article{boulos_generative_2025,
 abstract = {### Background
The ongoing COVID-19 pandemic has disproportionately affected marginalized populations, highlighting the role of social determinants of health (SDOH) in disease outcomes. This study aimed to examine the spatial distribution of SDOH and their association with COVID-19 incidence across Ontario, Canada, to inform targeted public health interventions.

### Methods
We conducted a retrospective observational study using linked administrative health data from the Ontario Health Data Platform, including confirmed COVID-19 cases from January 2020 to December 2022. SDOH variables were derived from the 2016 Canadian Census, including income, education, housing, immigration status, and Indigenous identity at the dissemination area level (n = 49,835). Spatial autocorrelation was assessed using Global and Local Moran's I, hot spot analysis (Getis-Ord Gi*), and geographically weighted regression (GWR) to model associations between SDOH and age-standardized COVID-19 incidence rates, adjusting for population density and mobility.

### Results
Significant spatial clustering of high COVID-19 incidence was identified in urban hotspots, particularly in the Greater Toronto Area and Windsor-Essex. Low income (Moran's I = 0.62, p < 0.001), overcrowded housing (Moran's I = 0.58, p < 0.001), and recent immigration (Moran's I = 0.49, p < 0.001) exhibited strong positive spatial autocorrelation and were associated with 15-25% higher incidence rates in vulnerable areas. GWR models showed spatially varying relationships, with stronger associations in urban settings (local R² = 0.45-0.67) compared to rural areas (local R² = 0.22-0.38). Indigenous communities displayed elevated risk independent of other SDOH (β = 1.32, 95% CI: 1.18-1.46).

### Conclusions
SDOH contribute to spatial inequities in COVID-19 burden in Ontario, with urban marginalized neighborhoods at greatest risk. Spatial analytics reveal opportunities for place-based interventions to reduce health disparities in future outbreaks. Policymakers should prioritize equitable resource allocation based on these geographic insights.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Article},
 author = {Boulos},
 doi = {10.1186/s12942-025-00391-0},
 journal = {International Journal of Health Geographics},
 keywords = {source: SPRINGER},
 title = {The generative revolution: {AI} foundation models in geospatial health—applications},
 url = {https://doi.org/10.1186/s12942-025-00391-0},
 x_enrich_source = {x-ai/grok-4-fast},
