@article{noauthor_abstracts_2025,
 abstract = {Purpose: Cancer cachexia is a multifactorial syndrome characterized by involuntary weight loss, muscle wasting, and systemic inflammation. This study aimed to investigate the role of circulating microRNAs (miRNAs) as potential biomarkers for early detection and monitoring of cancer cachexia in patients with advanced gastrointestinal cancers.

Methods: We conducted a prospective cohort study involving 150 patients with stage III-IV gastrointestinal cancers. Plasma samples were collected at baseline and at 3-month intervals. miRNA expression profiles were analyzed using quantitative real-time PCR for selected candidates (miR-21, miR-155, miR-206, and miR-133a). Cachexia was defined by >5% weight loss over 6 months or body mass index <20 with ongoing weight loss. Associations with clinical outcomes were assessed using logistic regression and survival analysis.

Results: Of the 150 patients, 62 (41.3%) developed cachexia within 6 months. Elevated baseline levels of miR-21 (fold change 2.8, p<0.001) and miR-155 (fold change 2.1, p=0.002) were significantly associated with cachexia development, while miR-206 and miR-133a were downregulated (fold changes 0.4 and 0.5, respectively, p<0.01). A miRNA panel combining miR-21 and miR-155 showed 85% sensitivity and 78% specificity for predicting cachexia (AUC=0.87). Higher miR-21 expression correlated with shorter overall survival (HR 1.9, 95% CI 1.3-2.8, p=0.001).

Conclusion: Circulating miR-21 and miR-155 emerge as promising non-invasive biomarkers for early identification of cancer cachexia in gastrointestinal cancer patients, potentially aiding in personalized nutritional and therapeutic interventions.},
