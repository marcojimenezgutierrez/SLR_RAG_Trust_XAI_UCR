@incollection{sukumar_discovery_2024,
 abstract = {The rapid advancement of deep learning techniques has significantly improved the accuracy and efficiency of medical image analysis. In this paper, we propose a novel deep learning-based approach for detecting and localizing anatomical landmarks in hand X-ray images, which is crucial for diagnosing and monitoring hand-related disorders such as rheumatoid arthritis. Our method combines a modified YOLOv8 object detection model with a keypoint detection head to simultaneously identify and precisely localize multiple anatomical landmarks, including the centers of the metacarpophalangeal (MCP) joints and proximal interphalangeal (PIP) joints. To enhance performance, we incorporate data augmentation techniques and a custom loss function that balances detection and localization errors. Experimental results on a benchmark dataset of hand X-ray images demonstrate that our approach achieves a mean average precision (mAP) of 92.3% for landmark detection and an average localization error of 1.8 pixels, outperforming state-of-the-art methods. This work paves the way for automated, reliable tools in clinical settings for hand X-ray analysis.},
