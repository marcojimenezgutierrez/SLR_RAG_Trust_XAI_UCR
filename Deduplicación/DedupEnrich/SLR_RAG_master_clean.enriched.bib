@inproceedings{lifschitz_enhancing_2025,
 abstract = {The rapid advancement of deep learning techniques has significantly impacted various fields, including medical image analysis. In this paper, we propose a novel hybrid deep learning model for the classification of brain MRI images to detect Alzheimer's disease (AD) at an early stage. The proposed model combines Convolutional Neural Networks (CNNs) with Long Short-Term Memory (LSTM) networks to capture both spatial and temporal features from MRI scans. We utilize transfer learning by fine-tuning pre-trained models such as VGG16 and ResNet50, followed by an LSTM layer to model sequential dependencies in the image slices. The model is evaluated on the ADNI dataset, achieving an accuracy of 96.8%, precision of 97.2%, recall of 96.5%, and F1-score of 96.8%. Comparative analysis with state-of-the-art methods demonstrates the superiority of our approach in terms of performance metrics and computational efficiency. This work contributes to the early diagnosis of AD, enabling timely interventions and improved patient outcomes.},
