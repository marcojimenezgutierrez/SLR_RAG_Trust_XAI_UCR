@book{noauthor_aiiip_2024,
 abstract = {Obesity is associated with chronic low-grade inflammation and insulin resistance. Adipose tissue macrophages (ATMs) are key mediators of obesity-induced inflammation and insulin resistance. However, the mechanisms underlying ATM accumulation in obesity remain incompletely understood. Here we show that the alarmin S100A8, which is released from adipocytes and ATMs, promotes ATM accumulation and insulin resistance in obesity. S100A8 expression is increased in adipose tissue of obese mice and humans. S100A8-deficient mice are protected from high-fat diet (HFD)-induced ATM accumulation, adipose tissue inflammation, and insulin resistance. Mechanistically, S100A8 promotes monocyte chemotaxis and ATM proliferation via Toll-like receptor 4 (TLR4) signaling. Neutralization of S100A8 reduces ATM accumulation and improves insulin sensitivity in obese mice. These findings identify S100A8 as a critical mediator of obesity-induced ATM accumulation and insulin resistance and suggest that targeting S100A8 may represent a therapeutic strategy for obesity-related metabolic disorders.},
 abstract_lang = {en},
