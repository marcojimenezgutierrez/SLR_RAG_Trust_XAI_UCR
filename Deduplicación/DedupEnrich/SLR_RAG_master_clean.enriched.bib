@inproceedings{wu_cardioai_2025,
 abstract = {Large language models (LLMs) have shown remarkable capabilities in generating text, code, and even complex reasoning chains. However, their inner workings remain opaque, making it challenging to understand why they produce certain outputs or to systematically test hypotheses about their behavior. We introduce ChainForge, a visual programming environment for building, visualizing, and analyzing LLM output chains. ChainForge allows users to construct complex LLM pipelines using a node-based interface, where each node represents an LLM call or a data transformation. Users can inspect the intermediate outputs of each node, modify prompts on the fly, and compare results across different configurations. By making LLM interactions more transparent and interactive, ChainForge lowers the barrier to prompt engineering and enables new forms of hypothesis testing, such as exploring how chain length affects reasoning accuracy or how prompt variations influence output diversity. We evaluate ChainForge through a series of case studies, demonstrating its utility in debugging prompt chains, teaching LLM concepts, and conducting empirical research on LLM behaviors.},
