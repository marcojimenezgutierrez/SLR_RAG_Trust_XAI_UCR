@inproceedings{sinha_fact-centric_2024,
 abstract = {Graph Neural Networks (GNNs) have emerged as a powerful tool for modeling graph-structured data, with applications spanning social networks, molecular chemistry, and recommendation systems. However, traditional GNNs often struggle with scalability on large graphs and lack interpretability in their decision-making processes. This paper proposes a novel framework, Interpretable Scalable GNN (IS-GNN), which integrates attention mechanisms with graph sampling techniques to address these challenges. By employing a multi-head attention layer to weigh node importance and a random walk-based sampling strategy to reduce computational overhead, IS-GNN achieves up to 5x speedup on benchmark datasets like Cora and PubMed while improving accuracy by 3-7%. Furthermore, we introduce a post-hoc explanation module using SHAP values adapted for graphs, enabling users to understand feature contributions. Experimental results on real-world datasets demonstrate the framework's effectiveness in both performance and interpretability, paving the way for practical deployment in resource-constrained environments.},
