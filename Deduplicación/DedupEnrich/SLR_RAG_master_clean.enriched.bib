@inproceedings{ma_towards_2025,
 abstract = {Visual Question Answering (VQA) systems have achieved remarkable success in recent years, but they often exhibit biases inherited from training data, leading to unfair predictions for certain demographic groups. Existing debiasing methods primarily focus on textual or visual modalities separately, overlooking the intricate interplay between them. In this paper, we propose FairVQA, a novel framework that mitigates bias in VQA through fairness-aware training. FairVQA disentangles the representations into bias-sensitive and bias-invariant components, enabling the model to learn fair features while preserving task performance. Specifically, we introduce a fairness loss that encourages equitable predictions across demographic groups and a contrastive loss to align bias-invariant representations. Extensive experiments on the VQA-CP dataset demonstrate that FairVQA significantly reduces bias while maintaining competitive accuracy, outperforming state-of-the-art debiasing methods. Our approach offers a promising step towards fair and reliable VQA systems.},
