@inproceedings{kim_legisflow_2025,
 abstract = {Visual recognition systems have achieved remarkable performance in various tasks, but they often exhibit biases towards certain demographic groups, leading to unfair outcomes. Addressing fairness in these systems is crucial for ethical AI deployment. This paper presents a comprehensive study on bias mitigation strategies in visual recognition, focusing on three key aspects: (1) identifying sources of bias in datasets and models, (2) proposing effective debiasing techniques including adversarial training and reweighting methods, and (3) developing robust evaluation metrics for fairness assessment. Through extensive experiments on benchmark datasets like CelebA and UTKFace, we demonstrate that our proposed strategies significantly reduce demographic biases while maintaining high accuracy. Our findings provide practical guidelines for building fairer visual recognition systems.},
