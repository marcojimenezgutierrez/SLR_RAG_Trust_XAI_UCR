@inproceedings{zheng_evalignux_2025,
 abstract = {Sequential recommendation (SR) aims to model the dynamic user interests from historical interactions and predict the next item of interest. While pre-trained language models (PLMs) have shown promising results in SR, they are limited by the vocabulary size and lack of domain knowledge. To address these issues, recent works focus on adapting PLMs for SR by aligning the textual embeddings of items with their interaction embeddings. However, these methods suffer from the alignment error caused by the semantic gap between textual and interaction embeddings. In this paper, we propose a novel framework, named Text-Enhanced Contrastive Learning (TECL), to alleviate the alignment error by enhancing the textual embeddings with interaction information. Specifically, we design a text enhancer to incorporate the interaction information into textual embeddings. Then, we propose a contrastive learning objective to align the enhanced textual embeddings with interaction embeddings. Extensive experiments on four benchmark datasets demonstrate the superiority of our TECL over state-of-the-art methods.},
