@article{klesel_retrieval-augmented_2025,
 abstract = {Digital nudging has become a popular tool for influencing behavior in digital environments, yet its application in the public sector remains underexplored. This systematic literature review synthesizes 52 empirical studies on digital nudging in public administration published between 2010 and 2023. We identify key themes, intervention types, target behaviors, and outcomes, while also examining contextual factors and methodological approaches. The findings reveal that digital nudges are predominantly used to promote compliance, efficiency, and sustainable behaviors in areas such as taxation, health, and environmental policy. Default options, social proof, and salience are the most common nudge techniques, with varying degrees of effectiveness depending on the context. Ethical considerations, including transparency and autonomy, emerge as critical challenges. We discuss implications for public administrators and propose an agenda for future research, emphasizing the need for more rigorous experimental designs and cross-cultural studies.},
