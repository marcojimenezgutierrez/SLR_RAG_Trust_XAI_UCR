@inproceedings{li_accurate_2025,
 abstract = {Recent advances in large language models (LLMs) have led to a surge in the development of LLM-based code generation tools. However, these tools often struggle with generating code that is both correct and efficient, especially for complex programming tasks. In this paper, we propose a novel framework, CodeChain, that leverages the reasoning capabilities of LLMs to generate high-quality code through a chain-of-thought process. Our approach involves breaking down the code generation task into smaller, manageable subtasks, solving each subtask sequentially, and combining the solutions to form the final code. We evaluate CodeChain on several benchmarks, including HumanEval and MBPP, and demonstrate significant improvements in both accuracy and efficiency over existing methods. Our results highlight the potential of chain-of-thought reasoning in enhancing LLM-based code generation.},
