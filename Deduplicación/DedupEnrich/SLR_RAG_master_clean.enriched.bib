@inproceedings{hsu_addressing_2024,
 abstract = {This paper proposes a novel deep learning-based approach for detecting and classifying anomalies in industrial control systems (ICS) using a hybrid model combining convolutional neural networks (CNN) and long short-term memory (LSTM) networks. The proposed model, termed CNN-LSTM-ICS, leverages the spatial feature extraction capabilities of CNNs and the temporal dependency modeling of LSTMs to analyze network traffic data from ICS environments. Experiments conducted on the Mississippi State University (MSU) ICS dataset demonstrate that the model achieves an accuracy of 98.5%, precision of 97.2%, and recall of 96.8%, outperforming traditional machine learning methods such as support vector machines (SVM) and random forests. The results highlight the effectiveness of the hybrid model in real-time anomaly detection, enhancing cybersecurity for critical infrastructure.},
