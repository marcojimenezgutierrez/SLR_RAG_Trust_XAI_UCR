@article{pan_unifying_2024,
 abstract = {Federated learning (FL) enables multiple clients to collaboratively train a shared model while keeping their data locally, thereby enhancing privacy. However, real-world FL systems often face challenges due to data heterogeneity across clients and the need for strong privacy guarantees. In this paper, we propose FedPD, a novel federated learning framework that integrates personalized models with differential privacy (DP) to address both data heterogeneity and privacy concerns. Specifically, we design a personalized aggregation mechanism that allows each client to maintain a model tailored to its local data distribution, while using DP noise to protect against inference attacks. We theoretically analyze the convergence of our algorithm under heterogeneous data and DP constraints, providing bounds on the expected excess risk. Extensive experiments on benchmark datasets demonstrate that FedPD achieves superior performance compared to state-of-the-art baselines in terms of accuracy, personalization, and privacy preservation.},
