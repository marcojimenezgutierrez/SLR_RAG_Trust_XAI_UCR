@article{skolnick_valsci_2025,
 abstract = {Background  
Protein-protein interactions (PPIs) are fundamental to many biological processes, and their accurate prediction is crucial for understanding cellular functions and disease mechanisms. Traditional experimental methods for identifying PPIs are labor-intensive and costly, driving the need for computational approaches. Recent advances in deep learning have shown promise in PPI prediction using protein sequences, but integrating additional biological information like gene ontology (GO) annotations could improve accuracy.  

Methods  
We developed DeepPPI-GO, a novel deep learning framework for PPI prediction that leverages protein sequences and GO annotations. The model employs convolutional neural networks (CNNs) to extract features from amino acid sequences and graph neural networks (GNNs) to capture hierarchical relationships in GO terms. These features are fused and passed through a multilayer perceptron for binary classification of PPIs. We trained and evaluated DeepPPI-GO on benchmark datasets from human and yeast, comparing it to state-of-the-art methods.  

Results  
On the human dataset, DeepPPI-GO achieved an accuracy of 98.5%, precision of 98.7%, recall of 98.3%, F1-score of 98.5%, and AUC of 99.8%, outperforming competitors like DeepPPI (AUC 97.2%) and PIPR (AUC 96.8%). Similar superior performance was observed on the yeast dataset. Ablation studies confirmed the contributions of sequence features, GO annotations, and the fusion strategy.  

Conclusions  
DeepPPI-GO effectively integrates sequence and GO data via deep learning, providing a robust tool for PPI prediction. This approach enhances predictive power and could aid in drug target identification and systems biology research. The source code is available at https://github.com/DeepPPI-GO.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Article},
 author = {Skolnick},
 doi = {10.1186/s12859-025-06159-4},
 journal = {BMC Bioinformatics},
 keywords = {source: SPRINGER},
 title = {Valsci: an open-source},
 url = {https://doi.org/10.1186/s12859-025-06159-4},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-10T01:29:46Z},
 year = {2025}
}

@article{song_leveraging_2024,
