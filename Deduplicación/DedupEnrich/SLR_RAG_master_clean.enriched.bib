@incollection{macha_artificial_2025,
 abstract = {The rapid advancement of deep learning techniques has significantly impacted the field of medical image analysis, particularly in the automated detection and classification of brain tumors using magnetic resonance imaging (MRI). This study proposes a hybrid deep learning model that combines convolutional neural networks (CNNs) with long short-term memory (LSTM) networks to improve the accuracy of brain tumor classification. The model is trained on a dataset comprising T1-weighted MRI images of glioma, meningioma, pituitary, and no tumor cases. Feature extraction is performed using a pre-trained VGG16 CNN architecture, followed by sequence modeling with LSTM to capture spatial-temporal dependencies in the image features. The proposed approach achieves an accuracy of 98.5%, precision of 98.2%, recall of 98.7%, and F1-score of 98.4%, outperforming state-of-the-art methods such as ResNet50 and InceptionV3. Experimental results demonstrate the model's robustness and potential for clinical deployment in early brain tumor diagnosis.},
