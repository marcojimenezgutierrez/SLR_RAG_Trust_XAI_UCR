@incollection{cho_foundations_2025,
 abstract = {Medical image segmentation is a fundamental task in computer-aided diagnosis systems, which aims to delineate anatomical structures and abnormalities from medical images. Traditional methods, such as thresholding, region growing, and active contours, often struggle with complex image variations and require extensive manual tuning. In recent years, deep learning-based approaches, particularly convolutional neural networks (CNNs), have achieved remarkable success in this domain due to their ability to learn hierarchical features automatically. This chapter provides a comprehensive review of deep learning techniques for medical image segmentation, covering encoder-decoder architectures like U-Net, fully convolutional networks (FCNs), and more advanced variants incorporating attention mechanisms and generative adversarial networks (GANs). We discuss key challenges including class imbalance, limited annotated data, and domain adaptation, along with evaluation metrics such as Dice coefficient and Hausdorff distance. Finally, we highlight future directions, including integration with multimodal data and explainable AI for clinical adoption.},
