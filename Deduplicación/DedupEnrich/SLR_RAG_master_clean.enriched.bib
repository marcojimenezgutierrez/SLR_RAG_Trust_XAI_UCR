@inproceedings{si_large_2024,
 abstract = {Although recent advances in large language models (LLMs) have shown remarkable performance on long-context tasks, there is a concerning trend: LLMs appear to perform worse as the length of the context increases. In this paper, we investigate this phenomenon through the lens of how LLMs use long contexts. Specifically, we study how attention in LLMs changes as a function of context length. We find that LLMs tend to pay disproportionately more attention to the beginning and end of the input context, while neglecting the middle. We call this the "lost in the middle" effect. To mitigate this, we propose a simple method to reorder the input context such that relevant information is placed at the beginning or end. Our experiments on a diverse set of long-context tasks show that this reordering significantly improves performance, often by 10-20 percentage points.},
