@article{lin_beyond_2024,
 abstract = {Sodium-ion batteries (SIBs) are considered as a promising alternative to lithium-ion batteries for large-scale energy storage due to the abundance and low cost of sodium resources. However, the large radius of Na+ ions and the lack of suitable anode materials hinder the development of high-performance SIBs. Herein, we report a novel anode material, nitrogen-doped carbon nanofibers embedded with SnS2 nanoparticles (SnS2@N-CNFs), which is synthesized via electrospinning followed by sulfidation. The synergistic effects of the hierarchical structure, the conductive N-CNFs matrix, and the pseudocapacitive SnS2 nanoparticles enable the SnS2@N-CNFs anode to deliver a high reversible capacity of 512 mA h g−1 after 500 cycles at 1 A g−1, superior rate capability (285 mA h g−1 at 10 A g−1), and excellent cycling stability (retaining 89.3% capacity after 1000 cycles at 5 A g−1). The full cell paired with a Na3V2(PO4)3 cathode exhibits a high energy density of 142.5 W h kg−1 at a power density of 0.25 kW kg−1. This work provides a new avenue for designing high-performance anodes for SIBs.},
