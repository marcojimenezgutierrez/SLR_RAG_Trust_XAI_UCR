@article{noauthor_eanm24_2024,
 abstract = {Purpose: This study aimed to evaluate the potential of [18F]FAPI-46 PET/CT for the detection of primary tumors and metastases in patients with various types of cancer and to compare its performance with [18F]FDG PET/CT.

Methods: Fifty patients (34 men, 16 women; median age 62 years) with histologically confirmed malignancies (n = 25 lung cancer, n = 10 colorectal cancer, n = 5 breast cancer, n = 5 head and neck cancer, n = 5 other) underwent [18F]FAPI-46 PET/CT and [18F]FDG PET/CT within a median interval of 7 days. Tracer uptake was quantified by calculating the maximum standardized uptake value (SUVmax). Visual and semiquantitative comparisons were performed on a lesion-based analysis. Additionally, background uptake in muscle, blood pool, liver, and brain was assessed.

Results: [18F]FAPI-46 PET/CT detected 312 lesions in 48/50 patients, while [18F]FDG PET/CT detected 289 lesions in 47/50 patients. [18F]FAPI-46 showed significantly higher SUVmax in primary tumors (median 12.5 vs. 8.2, p < 0.001) and metastases (median 10.8 vs. 6.5, p < 0.001). Particularly in peritoneal carcinomatosis, [18F]FAPI-46 demonstrated superior detection rates (28/30 vs. 18/30 lesions). Background uptake was low for both tracers, but [18F]FAPI-46 showed lower uptake in the brain (median SUVmax 0.4 vs. 7.1, p < 0.001), facilitating better lesion delineation in brain metastases.

Conclusion: [18F]FAPI-46 PET/CT demonstrates higher sensitivity for detecting primary tumors and metastases compared to [18F]FDG PET/CT, especially in fibrotic or desmoplastic lesions. It represents a promising alternative imaging modality in oncology.},
 abstract_lang = {en},
