@inproceedings{zhang_dynamic_2024,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their performance in complex reasoning tasks remains limited, particularly when requiring multi-step inference or integration of external knowledge. This paper introduces a novel framework, Knowledge-Enhanced Reasoning Network (KERN), which augments LLMs with a dynamic knowledge retrieval module and a structured reasoning graph to improve logical inference capabilities. KERN retrieves relevant factual knowledge from external databases and constructs a graph-based reasoning path that guides the LLM through intermediate steps. We evaluate KERN on benchmarks including StrategyQA, CommonsenseQA, and ARC-Challenge, achieving state-of-the-art results with improvements of up to 15% in accuracy. Our approach demonstrates the efficacy of hybrid systems combining neural and symbolic methods for advancing AI reasoning.},
