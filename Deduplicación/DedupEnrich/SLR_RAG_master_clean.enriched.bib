@inproceedings{spitzer_beyond_2024,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks, but their application in structured data processing, particularly table understanding, remains underexplored. Existing methods often rely on simplistic table representations or lack effective reasoning mechanisms, leading to suboptimal performance in complex table-related tasks. In this paper, we propose Chain-of-Table (CoT), a novel framework that evolves tables dynamically within the reasoning chain to enhance table-based fact verification. CoT consists of three key components: Table Reformulation, which refines the input table to better align with the claim; Reasoning Chain Generation, which iteratively updates the table based on intermediate reasoning steps; and Fact Verification, which leverages the evolved table for accurate verification. By integrating table evolution into the reasoning process, CoT enables more precise and context-aware fact checking. Experimental results on benchmark datasets demonstrate that CoT significantly outperforms state-of-the-art baselines, achieving up to 15% improvement in verification accuracy. Our approach not only advances table-based fact verification but also offers a generalizable paradigm for LLM reasoning over structured data.},
