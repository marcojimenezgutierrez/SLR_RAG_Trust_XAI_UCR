@inproceedings{huang_accessibility_2025,
 abstract = {Data visualizations are often created to communicate insights to a broad audience, but the process of designing effective visualizations can be challenging, especially for non-experts. We investigate how large language models (LLMs) can assist in the visualization design process by generating visualization code from natural language descriptions. Through a series of experiments, we explore the capabilities and limitations of LLMs in this context, focusing on their ability to produce accurate, aesthetically pleasing, and interpretable visualizations. Our findings reveal that while LLMs can generate functional code for basic visualizations, they struggle with complex designs, edge cases, and ensuring semantic correctness. We discuss implications for integrating LLMs into visualization tools and propose directions for improving their performance in supporting data visualization tasks.},
