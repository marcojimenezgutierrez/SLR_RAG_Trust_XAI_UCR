@inproceedings{lee_understanding_2025,
 abstract = {Despite the remarkable progress in visual recognition, a critical challenge remains: the fairness of these models across diverse demographic groups. Existing benchmarks for fairness evaluation in visual recognition are limited in scale and diversity, hindering the development and assessment of fair models. To address this, we introduce FairFace, a large-scale image dataset designed to evaluate fairness in face recognition models. FairFace consists of 108,501 face images sourced from the FFHQ dataset, with balanced representation across race (7 groups), gender (2 groups), and age (10 groups). We provide comprehensive annotations for these attributes, enabling detailed fairness analysis. Additionally, we establish standardized evaluation protocols and metrics to facilitate consistent and rigorous assessment of fairness in face recognition models. Our benchmark reveals significant biases in state-of-the-art models, highlighting the need for improved fairness-aware training strategies. FairFace serves as a vital resource for advancing research towards equitable visual recognition systems.},
