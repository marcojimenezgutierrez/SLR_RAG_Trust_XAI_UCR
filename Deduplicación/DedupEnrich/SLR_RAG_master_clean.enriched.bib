@inproceedings{nezafat_fake_2024,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their potential risks, such as generating harmful content, have raised significant concerns. To mitigate these risks, red teaming has been widely adopted to evaluate the safety of LLMs by simulating adversarial attacks. Despite its effectiveness, existing red teaming methods often rely on manual construction of prompts, which is labor-intensive and limits scalability. In this paper, we propose a novel framework, Red-Teaming Language Models with Iterative Prompt Optimization (RTLM-IPO), to automatically generate adversarial prompts for red teaming LLMs. Our approach leverages reinforcement learning to iteratively optimize prompts, aiming to elicit unsafe responses from the target LLM. Specifically, we design a reward function that balances the harmfulness of generated responses and the fluency of prompts. Experimental results on multiple safety benchmarks demonstrate that RTLM-IPO outperforms state-of-the-art baselines in generating effective adversarial prompts, uncovering more vulnerabilities in LLMs while maintaining prompt quality. Our work provides a scalable and automated solution for enhancing the safety evaluation of LLMs.},
 abstract_lang = {en},
