@inproceedings{worledge_unifying_2024,
 abstract = {Federated learning (FL) enables collaborative model training across distributed clients without sharing raw data, offering privacy benefits for sensitive domains like healthcare. However, FL is vulnerable to poisoning attacks, where malicious clients manipulate local updates to degrade global model performance. In medical imaging, such attacks could compromise diagnostic accuracy, posing serious risks. This paper investigates poisoning attacks on FL for medical image classification, focusing on the impact of model architectures, data heterogeneity, and attack strategies. We evaluate attacks on popular architectures (ResNet, DenseNet) using datasets like ChestX-ray14 and MIMIC-CXR, simulating realistic federated scenarios with non-IID data distributions. Results show that targeted label-flipping attacks can reduce global accuracy by up to 30% while remaining stealthy. We also explore defenses like robust aggregation and client selection, highlighting trade-offs in utility and robustness. Our findings underscore the need for tailored security measures in federated medical AI systems.},
