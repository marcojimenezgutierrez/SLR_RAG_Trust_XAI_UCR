@inproceedings{selva_kumar_overcoming_2024,
 abstract = {Brain tumors are a serious health concern, and early detection is crucial for effective treatment. Magnetic Resonance Imaging (MRI) is a primary diagnostic tool for identifying brain tumors. However, manual interpretation of MRI images is time-consuming and prone to human error. In this paper, we propose a deep learning-based approach for the classification of brain tumors using MRI images. The proposed model employs a convolutional neural network (CNN) architecture enhanced with transfer learning from pre-trained models like VGG16 and ResNet50. The dataset used consists of 7023 MRI images categorized into three types: glioma, meningioma, and pituitary tumors. Data augmentation techniques are applied to improve model robustness. Experimental results show that the proposed model achieves an accuracy of 98.57%, precision of 98.62%, recall of 98.57%, and F1-score of 98.59%, outperforming existing methods. This approach demonstrates the potential of deep learning in automating brain tumor diagnosis, aiding radiologists in faster and more accurate assessments.},
