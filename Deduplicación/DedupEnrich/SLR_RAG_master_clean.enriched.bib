@article{lang_leveraging_2025,
 abstract = {Memory forensics plays an important role in modern digital investigations in terms of detecting stealthy, fileless malware, and advanced persistent threats. Moreover, large language models (LLMs) have shown promise in different cybersecurity tasks. In this paper, we integrate intelligence based on LLM into memory forensic workflows and evaluate multiple LLMs, including OpenAI GPT4o, OpenAI o1, Gemini 2.0 Flash, Gemini 2.0 Flash-Thinking, Grok 3, and Grok 3 with thinking mode enabled . We collect memory dumps encompassing a variety of attack scenarios such as process injection (using msfvenom) , a PowerShell Empire-based attack , and real-world malware such as Quasar RAT, MassLogger, DarkCloud, LockBit, and LockiBot . Our evaluation includes accuracy, precision, recall and F1 score metrics and statistical analyses (ANOVA and correlation tests). The findings show that the reasoning-based (’thinking’) LLM models outperform standard models. OpenAI o1 and Gemini Flash-Thinking excel at decoding base64 obfuscated payloads, while Grok3 leads in detecting network anomalies. All LLM-based approaches suffer from high false-positive (FP) rates, reflected in low precision (often <20%). This tendency appears to stem from the precautionary principle in AI safety orientation, leading to models erring on the side of caution and occasionally hallucinating plausible threats when faced with ambiguous or incomplete evidence. The LockBit indicator of compromise (IoC) could not be detected with the LLM because the IoCs lie beyond the Volatility3 modules used. Due to this reason and the limited size of the context window from the LLM, it is essential to select appropriate data. Despite limitations, the study demonstrates the practical viability of integrating LLM-driven intelligence into a forensic system. The study lays the foundation for hybrid forensic systems combining symbolic analysis, domain-specific heuristics, and LLM-driven intelligence.},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Just Accepted},
 author = {Lang},
 doi = {10.1145/3748263},
 journal = {Digital Threats},
 keywords = {Digital Forensics},
 month = {jul},
 note = {Place: New York},
 title = {Leveraging {LLMs} for {Memory} {Forensics}: {A} {Comparative} {Analysis} of {Malware} {Detection}},
 url = {https://doi.org/10.1145/3748263},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-10T00:55:45Z},
 year = {2025}
}

@inproceedings{lau_ban_2023,
 abstract = {Social media platforms have become a primary source of news for many people, but they also facilitate the spread of misinformation. While prior work has studied how people perceive and respond to misinformation on social media, less is known about how platform design choices influence these perceptions and responses. In this paper, we investigate how two common design choices---the presence of a platform's fact-checking label and the visibility of social context (e.g., likes, shares, comments)---affect people's perceptions of and responses to news posts on social media. We conducted a between-subjects experiment (N=1,200) in which participants viewed news posts that varied in veracity (true vs. false) and were presented with or without a fact-checking label and with low or high social context. We found that fact-checking labels reduced beliefs in both true and false news posts, but the effect was stronger for false posts. High social context increased beliefs in true posts but had no effect on false posts. We also found that fact-checking labels reduced the intention to share both true and false posts, while high social context increased sharing intentions for true posts but not false posts. Our findings suggest that platform design choices can meaningfully influence how people perceive and respond to news on social media, with implications for the design of misinformation interventions.},
