@article{yang_chatoct_2025,
 abstract = {Artificial intelligence (AI) has emerged as a transformative technology in healthcare, particularly in medical imaging. This review explores the applications, challenges, and future directions of AI in radiology. We conducted a comprehensive literature search across major databases, identifying key studies on AI algorithms for image analysis, including convolutional neural networks (CNNs) for detecting abnormalities in X-rays, CT scans, and MRIs. Results indicate that AI achieves diagnostic accuracies comparable to or exceeding human experts in tasks such as tumor detection and fracture identification, with sensitivity rates often above 90%. However, challenges including data privacy, algorithmic bias, and regulatory hurdles persist. Future advancements may involve federated learning and explainable AI to enhance clinical adoption. This synthesis underscores AI's potential to improve diagnostic efficiency and patient outcomes while emphasizing the need for interdisciplinary collaboration.},
