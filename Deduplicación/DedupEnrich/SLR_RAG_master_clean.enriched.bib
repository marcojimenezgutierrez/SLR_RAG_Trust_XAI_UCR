@inproceedings{craig_whats_2024,
 abstract = {Machine learning models have achieved remarkable success in various domains, but their performance can be severely degraded when applied to out-of-distribution (OOD) data. Detecting OOD data is crucial for ensuring the safety and reliability of machine learning systems in real-world applications. In this paper, we propose a novel OOD detection method based on the reconstruction error of a variational autoencoder (VAE) combined with a generative adversarial network (GAN). Our approach leverages the VAE to learn a latent representation of in-distribution data and uses the GAN to generate realistic OOD samples for training a discriminator. The reconstruction error from the VAE serves as an uncertainty measure, while the discriminator helps in distinguishing between in-distribution and OOD data more effectively. Experimental results on benchmark datasets demonstrate that our method outperforms state-of-the-art OOD detection techniques in terms of AUROC and FPR@95 metrics.},
