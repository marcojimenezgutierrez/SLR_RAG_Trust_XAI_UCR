@inproceedings{mezquita_scalable_2025,
 abstract = {Explainable Artificial Intelligence (XAI) has become a central topic in Artificial Intelligence (AI) research. The need for transparency and interpretability in AI systems is driven by ethical, legal, and practical considerations, especially as AI is increasingly deployed in high-stakes domains such as healthcare, finance, and autonomous driving. This chapter provides a comprehensive overview of XAI, starting with foundational concepts and definitions. We introduce key taxonomies that classify XAI methods based on their scope (local vs. global), inference type (model-specific vs. model-agnostic), and explanation form (feature-based, decision-based, etc.). Opportunities for XAI are discussed, including its potential to build trust, facilitate regulatory compliance, and enable human-AI collaboration. Finally, we highlight persistent challenges, such as the trade-off between accuracy and explainability, the subjectivity of explanations, and the lack of standardized evaluation metrics. By synthesizing current trends and future directions, this chapter aims to guide researchers and practitioners in advancing interpretable AI systems.},
