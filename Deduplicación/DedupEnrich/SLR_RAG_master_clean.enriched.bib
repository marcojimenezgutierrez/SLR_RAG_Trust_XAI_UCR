@book{noauthor_chi_2021,
 abstract = {Soil organic matter (SOM) is a key component of soil quality and plays a crucial role in nutrient cycling, water retention, and carbon sequestration. Understanding the factors that influence SOM dynamics is essential for sustainable soil management. This study investigated the effects of long-term fertilization on SOM fractions and their relationships with soil microbial biomass in a rice-wheat cropping system in subtropical China. Four fertilization treatments were compared: no fertilization (CK), chemical fertilizer (NPK), chemical fertilizer plus rice straw (NPKS), and chemical fertilizer plus pig manure (NPKM). Results showed that NPKS and NPKM treatments significantly increased total organic carbon (TOC), dissolved organic carbon (DOC), microbial biomass carbon (MBC), and particulate organic carbon (POC) compared with CK and NPK treatments. The NPKM treatment had the highest TOC (18.2 g kg⁻¹), followed by NPKS (16.8 g kg⁻¹), NPK (13.2 g kg⁻¹), and CK (11.5 g kg⁻¹). Correlation analysis revealed that MBC was significantly positively correlated with TOC, DOC, and POC. Path analysis indicated that the direct effect of MBC on TOC was the largest among all SOM fractions. These findings suggest that long-term application of organic amendments, especially pig manure, can effectively enhance SOM accumulation and improve soil quality in rice-wheat cropping systems, with soil microbial biomass playing a central role in mediating these effects.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
