@incollection{holz_legal_2025,
 abstract = {Graph contrastive learning (GCL) has achieved remarkable success in learning node representations for downstream tasks. However, existing GCL methods often suffer from the lack of interpretability, making it challenging to understand why certain graph augmentations are effective or how the learned representations capture graph structures. In this paper, we propose a novel interpretable GCL framework, Topology-Aware Graph Transformer (TAGT), which leverages a graph transformer architecture to explicitly model topological structures in the contrastive learning process. Specifically, TAGT introduces a topology-aware attention mechanism that dynamically weights graph edges based on their structural importance, enabling the model to focus on discriminative topological patterns during representation learning. Extensive experiments on benchmark datasets demonstrate that TAGT not only outperforms state-of-the-art GCL methods in node classification and link prediction tasks but also provides interpretable insights into the learned representations through attention visualizations. Our approach bridges the gap between performance and interpretability in GCL, paving the way for more transparent graph representation learning.},
