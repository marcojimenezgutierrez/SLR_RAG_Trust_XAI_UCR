@inproceedings{do_understanding_2025,
 abstract = {Large language models (LLMs) have achieved remarkable success in various natural language processing tasks. However, their impressive performance often masks underlying fairness issues, such as perpetuating societal biases and generating discriminatory content. Addressing fairness in LLMs is crucial for their safe and ethical deployment. In this survey, we provide a comprehensive overview of fairness in LLMs. We first introduce the sources of bias in LLMs and the corresponding fairness notions. Then, we discuss the evaluation of fairness in LLMs, including metrics and benchmarks. Next, we review the mitigation strategies for fairness in LLMs, categorizing them into three main types: data-centric, model-centric, and post-processing methods. Finally, we highlight the challenges and future directions in this field.},
