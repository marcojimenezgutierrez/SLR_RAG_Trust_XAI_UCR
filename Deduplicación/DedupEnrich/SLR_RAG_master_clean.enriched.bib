@inproceedings{djeffal_reflexive_2025,
 abstract = {Generative AI (GenAI) has shown great potential in automating complex tasks, but its application in creative writing remains underexplored, particularly in collaborative settings. This paper presents StoryMate, a novel GenAI-powered system designed to facilitate collaborative storytelling between a human writer and an AI co-author. StoryMate employs a multi-agent architecture that simulates a team of specialized AI agents, each responsible for distinct aspects of story development, such as plot progression, character development, and dialogue generation. Through a user study with 24 participants, we evaluate StoryMate's effectiveness in enhancing creativity, productivity, and user satisfaction in collaborative writing. Our findings indicate that StoryMate significantly improves story quality and writer engagement compared to traditional solo writing and basic GenAI tools. We discuss design implications for GenAI systems in creative collaboration and outline future directions for adaptive co-authorship interfaces.},
