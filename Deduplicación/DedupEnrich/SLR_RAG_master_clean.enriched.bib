@incollection{nicoletti_ai_2025,
 abstract = {Clustering categorical data is a challenging task due to the absence of inherent distance metrics and the discrete nature of the data. Traditional clustering methods often rely on distance-based measures that are not well-suited for categorical attributes. In this paper, we propose a novel multi-objective optimization approach for clustering categorical data. The proposed method formulates the clustering problem as a multi-objective optimization task, where the objectives are to maximize the intra-cluster similarity and minimize the inter-cluster similarity. We employ a genetic algorithm to search for the optimal clustering solution in the multi-objective space. The fitness of each solution is evaluated using a novel similarity measure specifically designed for categorical data. Experimental results on benchmark datasets demonstrate the effectiveness of the proposed approach in terms of clustering accuracy and robustness compared to state-of-the-art methods.},
