Type: Review},
 number = {9},
 title = {{ChatGPT}’s {Expanding} {Horizons} and {Transformative} {Impact} {Across} {Domains}: {A} {Critical} {Review} of {Capabilities}},
 url = {https://doi.org/10.3390/computers14090366},
