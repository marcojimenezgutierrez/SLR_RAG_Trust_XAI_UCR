@inproceedings{sudhi_rag-ex_2024,
 abstract = {Narrative visualizations combine text and graphics to tell data-driven stories. However, creators often struggle to effectively integrate interactivity into their narratives. We investigate how to support creators in designing interactive narrative visualizations through a design probe study with 12 expert visualization designers. Participants used a custom authoring tool to create narratives with varying degrees of interactivity. Through iterative design and analysis of their creations and reflections, we identify five design considerations for supporting interactivity in narrative visualization: (1) balancing interactivity with narrative flow, (2) providing flexible interaction mechanisms, (3) supporting modular narrative structures, (4) enabling dynamic content adaptation, and (5) facilitating user-guided exploration. Based on these considerations, we propose a set of guidelines for designing authoring tools that empower creators to craft compelling interactive narratives. Our findings contribute to the design of future tools and workflows for narrative visualization creation.},
