@article{noauthor_scientific_2024,
 abstract = {Purpose Medical images are increasingly stored and transmitted digitally, raising significant privacy and security concerns. Encryption is essential to protect sensitive patient data from unauthorized access. Traditional encryption methods often fail to adequately handle the unique characteristics of medical images, such as high correlation between pixels and large data volumes. In recent years, deep learning (DL)-based approaches have shown promise in enhancing medical image encryption by leveraging neural networks to generate complex keys and transformation functions. This survey provides a comprehensive review of both classical and DL-based medical image encryption techniques.

Methods We systematically reviewed literature from major databases (PubMed, IEEE Xplore, Scopus, and Web of Science) published between 2010 and 2023. Inclusion criteria focused on studies proposing encryption methods for medical images (e.g., MRI, CT, X-ray, ultrasound). We categorized methods into classical (e.g., AES, chaotic maps, DNA encoding) and DL-based (e.g., CNNs, GANs, autoencoders) approaches, evaluating them based on security metrics (e.g., key space, resistance to differential attacks), computational efficiency, and applicability to medical imaging modalities.

Results Classical methods provide robust security but suffer from high computational overhead and limited adaptability to image-specific features. DL-based techniques, such as those using chaotic neural networks or GAN-generated keys, offer improved performance in terms of encryption speed, visual quality preservation post-decryption, and resistance to brute-force attacks. Notable advancements include hybrid models combining chaos theory with DL for permutation and diffusion stages. However, challenges remain in real-time implementation, key management, and standardization for clinical use.

Conclusion DL-based medical image encryption represents a paradigm shift toward more efficient and secure protection of healthcare data. Future research should focus on lightweight models for resource-constrained devices, integration with federated learning for privacy-preserving training, and rigorous clinical validation to ensure compliance with regulations like HIPAA and GDPR. This survey underscores the potential of DL to address longstanding limitations in medical image security.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Article},
 doi = {10.1007/s10278-024-01278-5},
 journal = {Journal of Imaging Informatics in Medicine},
 keywords = {source: SPRINGER},
 title = {Scientific {Abstracts} from the 2024 {Conference} on {Machine} {Intelligence} in {Medical} {Imaging} ({CMIMI}) of the {Society} for {Imaging} {Informatics} in {Medicine} ({SIIM})},
 url = {https://doi.org/10.1007/s10278-024-01278-5},
 x_enrich_source = {x-ai/grok-4-fast},
 x_enrich_status = {ok},
 x_enrich_ts = {2025-11-10T01:26:54Z},
 year = {2024}
