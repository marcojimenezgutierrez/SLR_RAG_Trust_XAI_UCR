@article{wang_application_2025,
 abstract = {This paper proposes a novel methodology for the optimal allocation of distributed energy resources (DERs) in unbalanced distribution networks, considering the uncertainties associated with DER outputs and load demands. The approach integrates a multi-objective optimization framework with a chance-constrained programming model to minimize the expected energy losses and voltage deviation while ensuring the reliability of the system under uncertainty. The DER allocation problem is formulated as a mixed-integer nonlinear programming (MINLP) problem, which is solved using a hybrid algorithm combining the salp swarm algorithm (SSA) with the interior point method (IPM). The effectiveness of the proposed method is validated through simulations on the IEEE 33-bus and 123-bus unbalanced distribution test systems, demonstrating superior performance in terms of loss reduction, voltage profile improvement, and computational efficiency compared to existing techniques.},
