@article{sornlertlamvanich_enhancing_2025,
 abstract = {Graph neural networks (GNNs) have achieved remarkable success in various domains by leveraging the topology of graph-structured data. Recently, GNNs have been widely used in recommender systems (RSs) to model user-item interactions and improve recommendation performance. However, existing GNN-based RSs still suffer from several challenges, such as the cold-start problem, data sparsity, and scalability issues. In this paper, we provide a comprehensive survey on GNN-based RSs. We first introduce the background of GNNs and RSs, and then categorize GNN-based RSs into several groups based on their architectures and applications. We discuss the key challenges and propose potential future directions to advance the field.},
