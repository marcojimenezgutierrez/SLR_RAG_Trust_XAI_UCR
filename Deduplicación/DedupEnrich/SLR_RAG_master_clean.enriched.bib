@inproceedings{wang_it_2025,
 abstract = {Visual Question Answering (VQA) systems have achieved remarkable success in recent years, but they often exhibit biases that lead to unfair treatment of certain demographic groups. This paper investigates bias in VQA through the lens of intersectional fairness, focusing on how biases interact across multiple protected attributes such as gender, race, and age. We introduce a new benchmark dataset, IntersectVQA, which contains images and questions annotated for intersectional attributes to evaluate model fairness comprehensively. Our analysis reveals that state-of-the-art VQA models propagate biases from their training data, resulting in disparate performance across intersectional subgroups. To address this, we propose FairVQA, a debiasing framework that incorporates adversarial training and group-specific calibration to mitigate intersectional biases. Experiments on IntersectVQA and standard VQA datasets demonstrate that FairVQA significantly reduces bias while preserving overall accuracy, paving the way for more equitable VQA systems.},
