@inproceedings{ehsan_explainable_2024,
 abstract = {Social media platforms generate vast amounts of user-generated content, offering rich signals of user interests. However, the noisy and unstructured nature of social media data poses challenges for extracting reliable user interest signals for recommendation systems. In this paper, we propose a novel framework, Social Interest Distillation (SID), to distill high-quality user interest representations from social media data for recommendation. SID consists of three key components: (1) a social interest extractor that leverages large language models (LLMs) to generate structured interest descriptions from unstructured social media posts; (2) an interest aggregator that fuses multi-source social interests into a unified user interest profile; and (3) a recommendation module that incorporates the distilled user interests to enhance recommendation performance. We conduct extensive experiments on real-world datasets, demonstrating that SID significantly outperforms state-of-the-art baselines in terms of recommendation accuracy and diversity. Our work highlights the potential of LLMs in distilling valuable user signals from noisy social media data for personalized recommendation.},
