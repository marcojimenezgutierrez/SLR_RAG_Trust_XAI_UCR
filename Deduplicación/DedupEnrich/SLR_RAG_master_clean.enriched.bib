@inproceedings{gummadi_enhancing_2024,
 abstract = {The rapid growth of electric vehicles (EVs) has led to the development of various charging technologies, including wireless power transfer (WPT) systems. However, the efficiency of WPT systems is significantly affected by the misalignment between the transmitter and receiver coils. This paper proposes a novel misalignment-tolerant WPT system for EV charging using a double-D (DD) coil topology with ferrite cores. The proposed system employs a phase-shifted compensation network to achieve zero-voltage switching (ZVS) and improve efficiency under misalignment conditions. Finite element analysis (FEA) simulations and experimental results demonstrate that the proposed system maintains over 90% efficiency for lateral misalignments up to 30% of the coil width, outperforming traditional series-series (SS) compensated systems. The design considerations, including coil parameters and compensation capacitor selection, are discussed in detail.},
