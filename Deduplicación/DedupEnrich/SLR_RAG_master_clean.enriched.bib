@article{kabir_review_2024,
 abstract = {Multimodal data fusion is an active research area that aims to integrate information from multiple modalities to improve the performance of machine learning models. Deep learning has shown great success in various multimodal tasks, such as visual question answering, speech recognition, and emotion recognition. However, there are still many challenges in multimodal fusion, such as how to effectively fuse different modalities, how to handle missing modalities, and how to deal with noisy or incomplete data. In this paper, we provide a comprehensive survey on deep learning for multimodal data fusion. We first introduce the background and motivation of multimodal fusion. Then, we categorize the existing deep learning methods for multimodal fusion into three main types: early fusion, late fusion, and hybrid fusion. For each type, we discuss the representative methods, their advantages and disadvantages, and the applications. We also review the datasets and evaluation metrics for multimodal fusion. Finally, we discuss the challenges and future directions in this field.},
