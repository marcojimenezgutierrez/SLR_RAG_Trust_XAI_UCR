@article{yang_multi-agent_2025,
 abstract = {Urban flooding poses significant threats to infrastructure, economy, and human life, exacerbated by climate change and rapid urbanization. This study introduces a comprehensive framework for urban flood risk assessment that integrates high-resolution remote sensing data, hydrodynamic modeling, and machine learning algorithms. Utilizing Sentinel-1 synthetic aperture radar (SAR) imagery and multi-temporal precipitation data from the study area in the Pearl River Delta, China, we developed a coupled Inundation Probability Index (IPI) model combined with a convolutional neural network (CNN) for flood extent prediction and vulnerability mapping. The framework was validated against observed flood events from 2018–2022, achieving an overall accuracy of 92.3% and a Kappa coefficient of 0.89. Sensitivity analysis revealed that rainfall intensity and land use changes are the dominant factors influencing flood risk. The proposed approach demonstrates superior performance over traditional methods and provides actionable insights for urban planners to enhance flood resilience in densely populated regions.},
