@inproceedings{janaka_tom_2024,
 abstract = {Gaussian Splatting (GS) has recently emerged as a highly efficient radiance field-based approach to novel view synthesis. However, the explicit representation of 3D Gaussians limits its potential in downstream tasks such as editing and manipulation. We introduce GaussianEditor, a novel framework that enables interactive editing of 3D scenes represented by 3D Gaussians. Our method leverages a pre-trained 2D diffusion model to guide the editing process, ensuring photorealistic results. Specifically, we propose a dual-space editing strategy that operates in both the 3D Gaussian space and the 2D image space. In the 3D space, we directly manipulate the Gaussian primitives to achieve coarse edits, while in the 2D space, we refine the details using the diffusion model conditioned on the edited 3D renderings. To maintain consistency across views, we introduce a novel regularization term that aligns the edited Gaussians with the diffusion-guided 2D edits. Extensive experiments demonstrate that GaussianEditor outperforms existing methods in terms of editing quality and multi-view consistency, enabling intuitive and high-fidelity 3D scene editing.},
