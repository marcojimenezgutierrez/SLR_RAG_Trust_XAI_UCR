@inproceedings{inie_how_2025,
 abstract = {Visual question answering (VQA) models often exhibit biases toward the most frequently observed answers in the training distribution, leading to poor generalization to underrepresented answers. Recent works have attempted to mitigate this issue by re-weighting training samples based on answer frequency, but they are limited to a single bias type and require additional training. In this work, we propose a simple yet effective inference-time approach to mitigate answer biases in VQA. Our method, called Answer Debiasing (ADA), leverages the fact that biased models tend to predict answers with high confidence for biased questions but low confidence for unbiased ones. Specifically, ADA first trains a bias detector to identify biased questions based on the confidence of the VQA model. Then, at inference time, it adjusts the answer distribution by down-weighting the probabilities of frequent answers for biased questions. We evaluate ADA on the VQA-CP dataset, a challenging distribution shift benchmark for VQA, and show that it outperforms existing debiasing methods by a large margin (e.g., 5.3% accuracy improvement over the state-of-the-art). Furthermore, ADA is complementary to existing training-time debiasing methods and can further boost their performance. Our code is available at https://github.com/yangxuntu/ADA-VQA.},
