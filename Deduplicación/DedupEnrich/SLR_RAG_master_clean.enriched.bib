@inproceedings{huang_driverp_2024,
 abstract = {The rapid growth of Internet of Things (IoT) devices has led to increasing concerns about data privacy and security in distributed learning systems. Federated Learning (FL) has emerged as a promising paradigm to address these issues by enabling collaborative model training without sharing raw data. However, FL in IoT environments faces challenges such as single-point-of-failure vulnerabilities, malicious participants, and inefficient resource utilization. To mitigate these challenges, this paper proposes a blockchain-enabled federated learning framework, named BlockFL-IoT, tailored for IoT applications. BlockFL-IoT integrates blockchain technology to ensure secure and tamper-proof aggregation of model updates, while incorporating smart contracts for automated incentive mechanisms and consensus protocols optimized for resource-constrained devices. We evaluate the proposed framework through simulations on real-world IoT datasets, demonstrating improvements in model accuracy, privacy preservation, and resistance to attacks compared to traditional FL approaches. Our results highlight the potential of BlockFL-IoT in enabling secure and efficient distributed learning for next-generation IoT systems.},
