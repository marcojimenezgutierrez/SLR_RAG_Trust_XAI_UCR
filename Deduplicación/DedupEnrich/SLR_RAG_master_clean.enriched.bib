@inproceedings{dawson_mapping_2024,
 abstract = {This paper presents a comprehensive survey on the application of federated learning (FL) in edge computing environments. We first introduce the fundamental concepts of FL and edge computing, highlighting their synergy in enabling privacy-preserving, distributed machine learning at the network edge. Key challenges such as communication efficiency, heterogeneity of edge devices, and security threats are discussed in detail. We then review state-of-the-art FL algorithms tailored for edge scenarios, including personalized FL, asynchronous FL, and split learning approaches. Furthermore, we categorize existing solutions based on their handling of non-IID data distributions and resource constraints. Experimental evaluations on benchmark datasets demonstrate the efficacy of these methods in real-world edge applications like IoT and mobile networks. Finally, we outline future research directions, including integration with emerging technologies such as 6G and blockchain for enhanced trustworthiness.},
