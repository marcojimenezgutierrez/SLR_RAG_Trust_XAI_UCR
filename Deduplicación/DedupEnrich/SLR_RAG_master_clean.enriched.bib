@book{noauthor_chi_2021-1,
 abstract = {Obesity is a major public health problem worldwide. The prevalence of obesity has increased dramatically over the past few decades, and it is now recognized as a global epidemic. Obesity is associated with numerous health complications, including type 2 diabetes, cardiovascular disease, certain types of cancer, and premature death. The pathogenesis of obesity is complex and multifactorial, involving genetic, environmental, and behavioral factors. Recent advances in our understanding of the molecular mechanisms underlying obesity have identified several key pathways and molecules that regulate energy homeostasis and body weight. These include the leptin-melanocortin pathway, which plays a central role in regulating food intake and energy expenditure, and the endocannabinoid system, which modulates appetite and metabolism. In addition, the gut microbiota has emerged as an important factor in the development of obesity, with studies showing that alterations in the composition and function of the gut microbiome can influence energy harvest from the diet and contribute to weight gain. This review provides an overview of the current understanding of the molecular mechanisms underlying obesity, with a focus on the leptin-melanocortin pathway, the endocannabinoid system, and the role of the gut microbiota. We also discuss potential therapeutic targets for the treatment of obesity based on these mechanisms.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
