@article{kuntur_under_2025,
 abstract = {Large language models (LLMs) have shown remarkable success across various domains, including natural language processing, computer vision, and multimodal learning. In the field of recommender systems, LLMs have also demonstrated promising performance in tasks such as sequential recommendation, cold-start recommendation, and cross-domain recommendation. However, there is a lack of comprehensive surveys on the application of LLMs in recommender systems. To fill this gap, we conduct a systematic review of recent advances in LLMs for recommender systems. We first introduce the background of LLMs and recommender systems. Then, we categorize the existing works into three main directions: LLMs as recommenders, LLMs as recommenders' assistants, and LLMs as data sources. For each direction, we discuss the key techniques, advantages, and limitations. Finally, we point out several future research directions.},
