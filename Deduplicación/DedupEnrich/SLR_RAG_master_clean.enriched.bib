@inproceedings{hang_trumorgpt_2024,
 abstract = {Federated learning enables collaborative model training across distributed devices while keeping data localized, enhancing privacy. However, it is vulnerable to inference attacks that reconstruct private training data from shared model updates. To mitigate this, differential privacy (DP) adds calibrated noise to updates, but naive application can degrade model utility, especially under non-IID data distributions common in real-world federated settings. We propose FedDP-SecAgg, a privacy-preserving federated learning framework that integrates DP with secure aggregation (SecAgg) to jointly address privacy leakage and communication efficiency. Our approach uses partial homomorphic encryption for SecAgg to mask individual updates before noise addition, ensuring that even the server cannot access noisy updates during aggregation. We theoretically analyze the privacy-utility trade-off and empirically evaluate on benchmark datasets like CIFAR-10 and FEMNIST, demonstrating superior accuracy compared to baselines under stringent privacy budgets (ε ≤ 1). Results show up to 15% improvement in test accuracy while maintaining (ε, δ)-DP guarantees.},
