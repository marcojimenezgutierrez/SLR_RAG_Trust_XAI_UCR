@article{queloz_explainability_2025,
 abstract = {Abstract This paper argues that explainability is only one facet of a broader ideal that shapes our expectations towards artificial intelligence (AI). Fundamentally, the issue is to what extent AI exhibits systematicity —not merely in being sensitive to how thoughts are composed of recombinable constituents, but in striving towards an integrated body of thought that is consistent, coherent, comprehensive, and parsimoniously principled. This richer conception of systematicity has been obscured by the long shadow of the “systematicity challenge” to connectionism, according to which network architectures are fundamentally at odds with what Fodor and colleagues termed “the systematicity of thought.” I offer a conceptual framework for thinking about “the systematicity of thought” that distinguishes four senses of the phrase. I use these distinctions to defuse the perceived tension between systematicity and connectionism and show that the conception of systematicity that historically shaped our sense of what makes thought rational, authoritative, and scientific is more demanding than the Fodorian notion. To determine whether we have reason to hold AI models to this ideal of systematicity, I then argue, we must look to the rationales for systematization and explore to what extent they transfer to AI models. I identify five such rationales and apply them to AI. This brings into view the “hard systematicity challenge.” However, the demand for systematization itself needs to be regulated by the rationales for systematization. This yields a dynamic understanding of the need to systematize thought, which tells us how systematic we need AI models to be and when .},
 abstract_lang = {en},
 abstract_source = {crossref},
 annote = {Article},
 author = {Queloz},
 doi = {10.1007/s11023-025-09738-9},
 journal = {Minds and Machines},
 keywords = {source: SPRINGER},
 title = {Explainability {Through} {Systematicity}: {The} {Hard} {Systematicity} {Challenge} for {Artificial} {Intelligence}},
 url = {https://doi.org/10.1007/s11023-025-09738-9},
 x_enrich_source = {crossref},
 x_enrich_status = {fetched},
 x_enrich_ts = {2025-11-10T01:15:41Z},
 year = {2025}
}

@inproceedings{rachha_llm-enhanced_2024,
 abstract = {The COVID-19 pandemic accelerated the adoption of online learning in higher education, bringing attention to the critical role of self-regulated learning (SRL) in student success. Engineering students, who often engage in hands-on, collaborative activities, face unique challenges in transitioning to fully online environments. This systematic literature review examines empirical studies on engineering undergraduates' SRL in online learning contexts, published between 2010 and 2023. Following PRISMA guidelines, we screened 1,247 articles from databases including IEEE Xplore, Scopus, and ERIC, ultimately including 28 studies. Using Zimmerman's cyclical model of SRL (forethought, performance, self-reflection), we analyzed how engineering students enact SRL online and the factors influencing it. Key findings indicate that while digital tools (e.g., learning management systems, analytics dashboards) support forethought and performance phases, students struggle with self-reflection due to limited peer interaction and feedback. Contextual barriers, such as technical issues and course design, hinder SRL, particularly for underrepresented groups. Effective interventions include scaffolded prompts and peer mentoring. This review highlights gaps in longitudinal studies and discipline-specific adaptations, offering implications for engineering educators to foster SRL in hybrid and online formats.},
