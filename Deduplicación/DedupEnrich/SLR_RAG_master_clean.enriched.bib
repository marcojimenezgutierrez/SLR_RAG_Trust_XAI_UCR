@inproceedings{zhang_multi-agent_2025,
 abstract = {Contextualized query reformulation aims to rewrite a user's query by incorporating information from the retrieved passages to better align with the user's information need. Existing approaches to contextualized query reformulation (CQR) leverage the context provided by the top-k retrieved passages to generate a reformulated query. However, these methods often suffer from low-quality retrieved passages, which can mislead the reformulation process. To address this issue, we propose a novel approach, called Reinforced CQR (RCQR), which utilizes reinforcement learning (RL) to dynamically select high-quality passages for CQR. Specifically, we design a RL-based selector that learns to choose passages based on their relevance to the query and their potential to improve the reformulated query. The selector is trained with a reward function that measures the effectiveness of the reformulated query in retrieving relevant passages. Experimental results on two public datasets demonstrate that RCQR significantly outperforms state-of-the-art CQR methods in terms of retrieval effectiveness.},
