@inproceedings{obaid_seerahgpt_2024,
 abstract = {The rapid proliferation of Internet of Things (IoT) devices has led to an exponential increase in data generation, necessitating efficient and secure data management solutions. Traditional centralized data storage systems are vulnerable to single points of failure and privacy breaches. This paper proposes a novel blockchain-based framework for secure and efficient data sharing among IoT devices in smart city environments. The proposed scheme integrates lightweight consensus mechanisms and attribute-based encryption to ensure data integrity, confidentiality, and access control. By leveraging InterPlanetary File System (IPFS) for decentralized storage, the framework reduces latency and storage overhead compared to conventional blockchain solutions. Experimental evaluations on a simulated smart city network demonstrate that our approach achieves a 40% reduction in transaction latency and enhances security against common attacks such as tampering and unauthorized access. The results underscore the potential of this framework in enabling scalable and trustworthy IoT ecosystems for smart cities.},
