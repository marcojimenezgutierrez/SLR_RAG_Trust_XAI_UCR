@inproceedings{fan_towards_2025,
 abstract = {Graph Neural Networks (GNNs) have achieved remarkable success in modeling graph-structured data. However, existing GNNs suffer from the oversmoothing problem, where node representations become indistinguishable after multiple propagation steps. To address this issue, we propose a novel framework called Adaptive Propagation Graph Neural Network (APGNN), which adaptively learns the propagation mechanism for each node based on its local neighborhood structure. Specifically, APGNN introduces a propagation gating mechanism that dynamically adjusts the aggregation weights for different neighbors, preventing excessive smoothing while preserving expressive power. Extensive experiments on benchmark datasets demonstrate that APGNN outperforms state-of-the-art GNN models in node classification and graph classification tasks.},
