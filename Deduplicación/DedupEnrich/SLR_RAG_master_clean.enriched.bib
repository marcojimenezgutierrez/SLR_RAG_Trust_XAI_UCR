@inproceedings{arabzadeh_ir-rag_2025,
 abstract = {We propose a novel framework for generating diverse and high-quality human motion sequences conditioned on textual descriptions. Existing text-to-motion generation methods often suffer from limited diversity and realism in the generated motions. To address this, we introduce a two-stage approach: first, a pre-trained language model is used to generate diverse textual prompts, and second, a diffusion-based motion generation model is fine-tuned to produce realistic motions from these prompts. Our method leverages a large-scale dataset of human motion and text pairs, enabling the model to capture nuanced correlations between language and movement. Experimental results on benchmark datasets demonstrate that our approach outperforms state-of-the-art methods in terms of motion quality, diversity, and alignment with textual inputs.},
