@inproceedings{wu_time-sensitve_2024,
 abstract = {Visual question answering (VQA) models often exhibit biases toward specific answers conditioned on the questions, leading to unreliable performance in out-of-distribution scenarios. Existing debiasing methods typically require access to the model's parameters or training data, which is impractical for large pre-trained models. In this paper, we propose a simple yet effective debiasing method that operates solely on the input side by generating counterfactual prompts. Our approach leverages a pre-trained counterfactual generator to produce biased prompts that highlight the model's reliance on spurious correlations. By mixing these biased prompts with the original ones during inference, we encourage the model to focus on the correct visual features rather than shortcuts. Extensive experiments on the VQA-CP dataset demonstrate that our method significantly improves worst-case accuracy while maintaining competitive performance on other splits, outperforming existing parameter-free debiasing methods.},
