@inproceedings{spillo_gal-kars_2025,
 abstract = {Recent advancements in large language models (LLMs) have shown promise in generating code, but their application to user interface (UI) design remains limited. This paper explores the use of LLMs for automating the generation of UI layouts from natural language descriptions. We introduce UI-LLM, a framework that fine-tunes LLMs on UI datasets to produce structured UI specifications compatible with design tools. Through a series of experiments on benchmark datasets, we evaluate UI-LLM's ability to generate diverse, accessible, and aesthetically pleasing layouts. Our results demonstrate that UI-LLM outperforms traditional rule-based and diffusion-based methods in fidelity to descriptions and user satisfaction, while reducing design iteration time. We discuss implications for democratizing UI design and future directions for integrating LLMs into creative workflows.},
