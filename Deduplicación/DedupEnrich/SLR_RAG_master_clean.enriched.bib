@article{gitzel_toward_2024,
 abstract = {The Internet of Things (IoT) has revolutionized various sectors by enabling interconnected devices to collect and exchange data. However, the resource constraints of IoT devices, such as limited computational power, storage, and battery life, pose significant challenges for implementing advanced machine learning (ML) techniques. Federated learning (FL) has emerged as a promising paradigm to address these issues by allowing collaborative model training across distributed devices without sharing raw data, thereby preserving privacy. This survey provides a comprehensive overview of FL applications in resource-constrained IoT environments. We categorize existing approaches based on network architectures, communication protocols, and optimization strategies tailored for IoT constraints. Key challenges, including heterogeneity, scalability, security, and energy efficiency, are discussed in detail, along with potential solutions and future research directions. By synthesizing recent advancements, this work aims to guide researchers and practitioners in developing efficient FL frameworks for IoT deployments.},
