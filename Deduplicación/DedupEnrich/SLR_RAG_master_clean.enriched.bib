@book{noauthor_ukicer_2023,
 abstract = {Soil organic matter (SOM) is a key component of soil quality and plays a crucial role in nutrient cycling, water retention, and carbon sequestration. Understanding the factors that influence SOM dynamics is essential for sustainable soil management. This study investigated the effects of long-term fertilization on SOM fractions and their relationships with soil microbial biomass in a rice-wheat cropping system in eastern China. Four fertilization treatments were compared: no fertilization (CK), chemical fertilizer (NPK), chemical fertilizer plus rice straw (NPKS), and chemical fertilizer plus pig manure (NPKM). Results showed that long-term application of organic amendments (NPKS and NPKM) significantly increased total organic carbon (TOC), particulate organic carbon (POC), and mineral-associated organic carbon (MAOC) compared to CK and NPK treatments. The NPKM treatment had the highest TOC (18.2 g kg⁻¹), POC (5.8 g kg⁻¹), and MAOC (12.4 g kg⁻¹) contents. Soil microbial biomass carbon (MBC) and nitrogen (MBN) were also significantly higher in NPKS and NPKM treatments. Correlation analysis revealed that MBC and MBN were positively correlated with all SOM fractions, with the strongest correlations observed for POC. Path analysis indicated that organic amendments influenced MAOC primarily through their effects on POC and microbial biomass. These findings suggest that long-term application of organic amendments, particularly pig manure, can effectively enhance SOM accumulation and improve soil quality in rice-wheat cropping systems by promoting both labile and stable carbon pools and stimulating microbial activity.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
 address = {New York},
 isbn = {979-8-4007-0876-3},
 keywords = {source: ACM},
