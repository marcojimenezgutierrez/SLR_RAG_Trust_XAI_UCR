@article{zhang_large_2025,
 abstract = {Assembly sequence planning (ASP) is a critical issue in manufacturing systems, which has a significant impact on product quality, production efficiency, and cost. Traditional ASP methods often suffer from limitations such as high computational complexity and inability to handle complex constraints effectively. To address these challenges, this paper proposes a novel hybrid optimization approach that integrates the teaching–learning-based optimization (TLBO) algorithm with the slime mould algorithm (SMA) for ASP. The proposed TLBO-SMA algorithm leverages the exploration capabilities of SMA and the exploitation strengths of TLBO to achieve a balanced search process. Additionally, a novel constraint-handling mechanism is introduced to manage geometric feasibility, stability, and precedence constraints more effectively. The performance of the proposed method is evaluated on benchmark ASP problems and compared with state-of-the-art algorithms. Experimental results demonstrate that TLBO-SMA outperforms existing methods in terms of solution quality, convergence speed, and robustness, making it a promising approach for real-world ASP applications.},
