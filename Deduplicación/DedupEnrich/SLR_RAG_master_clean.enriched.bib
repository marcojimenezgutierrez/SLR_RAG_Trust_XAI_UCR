@inproceedings{zhou_instructpipe_2025,
 abstract = {Large language models (LLMs) have shown great potential in various natural language processing tasks, but their application to knowledge graph (KG) construction and augmentation remains underexplored. In this paper, we investigate how LLMs can be leveraged to extend existing KGs with new knowledge extracted from unstructured text. We propose a novel framework, FairLLM-KG, that combines LLMs with KG embedding models to generate and integrate new triples while ensuring fairness across different demographic groups. Our approach includes a bias detection module that identifies and mitigates disparities in entity representations and relation predictions. Through extensive experiments on real-world datasets, we demonstrate that FairLLM-KG not only improves KG completeness but also reduces bias by up to 40% compared to baseline LLM-based methods. Our findings highlight the importance of fairness considerations in LLM-driven KG augmentation and provide practical guidelines for deploying such systems in sensitive applications.},
