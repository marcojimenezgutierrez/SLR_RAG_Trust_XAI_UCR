@article{s_web_2025,
 abstract = {The rapid evolution of antibiotic resistance in bacterial pathogens poses a significant threat to global public health, necessitating the discovery of novel antibacterial agents. Here, we report the discovery and characterization of a novel class of antibacterial peptides derived from the venom of the scorpion Androctonus crassicauda. Using a combination of transcriptomic and proteomic approaches, we identified a 38-amino acid peptide, Acr-AMP1, which exhibits potent antibacterial activity against both Gram-positive and Gram-negative bacteria, including multidrug-resistant strains, with minimal inhibitory concentrations (MICs) ranging from 1 to 8 μg/mL. Acr-AMP1 disrupts bacterial cell membranes through a carpet-like mechanism, as evidenced by scanning electron microscopy and propidium iodide uptake assays. Furthermore, it demonstrates low cytotoxicity against mammalian cells (IC50 > 100 μg/mL) and limited hemolytic activity. In vivo studies in a murine model of sepsis induced by Escherichia coli showed that Acr-AMP1 significantly improves survival rates and reduces bacterial burden in infected tissues. These findings highlight Acr-AMP1 as a promising candidate for the development of new antimicrobial therapeutics to combat antibiotic-resistant infections.},
