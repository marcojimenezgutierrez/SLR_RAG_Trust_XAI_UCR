@inproceedings{wang_knowledge_2024,
 abstract = {Recent advances in large language models (LLMs) have enabled them to process long inputs, but their ability to generalize to longer sequences than those seen during training remains a critical challenge. This paper surveys the current state of length generalization in LLMs, categorizing methods into three main approaches: position interpolation, activation engineering, and dual training. We discuss the theoretical underpinnings, empirical findings, and limitations of each approach, highlighting the trade-offs between performance on short and long contexts. Additionally, we explore emerging techniques such as recurrent architectures and state-space models that inherently support longer contexts. Our analysis reveals that while significant progress has been made, achieving robust length generalization across diverse tasks and model scales remains an open problem, with implications for real-world applications requiring extended reasoning.},
