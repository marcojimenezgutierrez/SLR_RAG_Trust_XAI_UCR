@inproceedings{prathyush_turaga_information_2024,
 abstract = {The rapid growth of Internet of Things (IoT) devices has led to an explosion of data, necessitating efficient anomaly detection mechanisms to ensure network security. Traditional centralized approaches for anomaly detection in IoT networks face significant challenges, including privacy concerns, high communication overhead, and vulnerability to single points of failure. Federated Learning (FL) offers a promising solution by enabling collaborative model training across distributed devices without sharing raw data. However, applying FL to anomaly detection in resource-constrained IoT environments remains underexplored. In this paper, we propose FedIoTAD, a privacy-preserving federated learning framework specifically designed for anomaly detection in IoT networks. FedIoTAD leverages edge computing to train lightweight local models on IoT devices, aggregates model updates at edge servers using a secure aggregation protocol, and employs differential privacy to further protect sensitive information. To address the heterogeneity of IoT devices and non-IID data distributions, we introduce a personalized federated learning mechanism that fine-tunes global models for individual devices. Extensive experiments on benchmark IoT datasets demonstrate that FedIoTAD achieves superior anomaly detection accuracy compared to state-of-the-art baselines, while significantly reducing communication costs and enhancing privacy guarantees.},
