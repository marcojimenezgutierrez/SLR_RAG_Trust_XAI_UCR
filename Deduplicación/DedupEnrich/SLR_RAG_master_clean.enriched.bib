@article{tran-nguyen_vitip-ext_2025,
 abstract = {Social media has become an essential platform for people to express their opinions and sentiments on various topics. Sentiment analysis is a natural language processing (NLP) task that involves identifying and extracting subjective information from text data. Traditional sentiment analysis methods often struggle with sarcasm, irony, and context-dependent expressions. In this paper, we propose a novel hybrid approach that combines deep learning models with linguistic features to improve sentiment classification accuracy. Our model integrates bidirectional long short-term memory (Bi-LSTM) networks with attention mechanisms and incorporates handcrafted features such as part-of-speech tags and sentiment lexicons. We evaluate our approach on benchmark datasets including Twitter sentiment analysis and IMDb movie reviews. Experimental results demonstrate that our hybrid model outperforms state-of-the-art baselines, achieving up to 5% improvement in F1-score. This work contributes to more robust sentiment analysis systems capable of handling complex linguistic nuances.},
