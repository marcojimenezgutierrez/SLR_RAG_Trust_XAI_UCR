@inproceedings{dammu_claimver_2024,
 abstract = {Large language models (LLMs) have demonstrated impressive capabilities in natural language understanding and generation tasks. However, their performance in detecting and explaining logical fallacies—errors in reasoning that undermine the logic of an argument—remains underexplored. In this paper, we evaluate the effectiveness of several state-of-the-art LLMs in identifying and explaining logical fallacies using a newly curated dataset of 1,000 real-world argumentative texts annotated with 12 common fallacy types. Our experiments reveal that while LLMs achieve moderate accuracy in fallacy detection (up to 68% for the best model), their explanations are often superficial, inconsistent, and fail to capture the nuanced reasoning behind fallacious arguments. We further analyze the impact of prompting strategies, model scale, and fine-tuning on performance, highlighting key limitations and opportunities for improvement. Our findings underscore the need for targeted advancements in LLM reasoning capabilities to enhance their utility in critical discourse analysis and argumentation mining.},
