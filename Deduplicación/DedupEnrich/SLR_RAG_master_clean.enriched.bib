@incollection{gianfagna_explainability_2025,
 abstract = {Machine learning (ML) algorithms have been widely used in cybersecurity to detect and prevent cyber threats. However, the black-box nature of many ML models makes it difficult for security analysts to understand and trust their decisions. Explainable artificial intelligence (XAI) techniques aim to address this issue by providing human-understandable explanations for the model's predictions. In this chapter, we provide an overview of XAI methods and their applications in cybersecurity. We discuss various XAI techniques, including feature importance, local explanations, and counterfactuals, and review their use in tasks such as intrusion detection, malware classification, and anomaly detection. We also highlight the challenges of applying XAI in cybersecurity, such as the need for real-time explanations and handling adversarial attacks, and suggest future research directions.},
