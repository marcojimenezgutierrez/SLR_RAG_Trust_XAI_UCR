@book{noauthor_chi_2023-1,
 abstract = {Soil organic matter (SOM) is a key component of soil quality and plays a critical role in global carbon cycling. Understanding the factors that control SOM dynamics is essential for predicting how soils will respond to environmental change. Here, we synthesize current knowledge on the mechanisms controlling SOM persistence and turnover. We argue that the traditional view of SOM as a continuum of progressively more recalcitrant materials is inconsistent with recent evidence. Instead, we propose that SOM persistence is primarily controlled by environmental and biological factors rather than by the intrinsic chemical recalcitrance of organic compounds. Specifically, we identify three main mechanisms that control SOM persistence: (1) spatial inaccessibility to decomposers, (2) interactions with soil minerals, and (3) resource limitations for microbial decomposers. We discuss how these mechanisms operate across different spatial and temporal scales and how they are influenced by climate, soil properties, and land management. Finally, we highlight key research priorities for improving our understanding of SOM dynamics and for developing more accurate models of soil carbon cycling.},
 abstract_lang = {en},
 abstract_source = {anthropic/claude-sonnet-4.5},
