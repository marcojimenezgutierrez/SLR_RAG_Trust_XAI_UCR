@inproceedings{neupane_questions_2024,
 abstract = {This paper explores the potential of large language models (LLMs) for providing automated feedback on student programming assignments. We conducted an experiment with 120 undergraduate students in an introductory programming course, where half received LLM-generated feedback and the other half received traditional instructor feedback. Our results show that LLM feedback was rated as equally helpful and improved student performance comparably to human feedback. However, qualitative analysis revealed differences in feedback style and student perceptions. We discuss implications for scaling feedback in large CS courses and ethical considerations for LLM use in education.},
