@inproceedings{mickens_guillotine_2025,
 abstract = {Vision-language models (VLMs) have achieved remarkable success in various downstream tasks. However, they often inherit and amplify societal biases from their training data, leading to unfair and harmful predictions. Existing debiasing methods for VLMs are limited in their effectiveness and generalizability. In this paper, we propose a simple yet effective debiasing approach, Biased Prompts (BP), which leverages the power of prompts to mitigate biases in VLMs. Specifically, we design a set of biased prompts that explicitly encode the target bias and fine-tune the VLM on these prompts paired with debiased images. Our method is model-agnostic, requiring no access to the model's parameters or training data, and can be applied to any VLM. Extensive experiments on multiple VLMs and bias types demonstrate that BP significantly reduces bias while maintaining or even improving model performance. Our approach offers a practical and scalable solution to enhance fairness in VLMs.},
