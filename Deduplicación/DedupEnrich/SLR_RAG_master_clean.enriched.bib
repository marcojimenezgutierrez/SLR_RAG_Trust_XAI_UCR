@article{liu_enhancing_2025,
 abstract = {Anthropomorphic design features in AI chatbots can enhance user engagement but also risk over-reliance and disappointment when expectations are unmet. This study explores the dual effects of anthropomorphism on user perceptions and behaviors in human-AI interactions. Through two online experiments (N = 412), we manipulated levels of anthropomorphic cues (e.g., emotional language, avatar expressiveness) in a customer service chatbot. Findings reveal that moderate anthropomorphism boosts perceived warmth, trust, and interaction enjoyment, leading to higher satisfaction and repeated use intentions. However, high anthropomorphism increases perceived agency attribution, fostering dependency and negative reactions to errors. These effects were mediated by mind perception and moderated by users' AI familiarity. Theoretical contributions refine the computers as social actors paradigm, while practical implications guide ethical AI design to balance engagement with realistic user expectations.},
