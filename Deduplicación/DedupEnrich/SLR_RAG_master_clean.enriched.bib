@inproceedings{cheng_relic_2024,
 abstract = {Large language models (LLMs) have shown impressive abilities in generating human-like text, but their performance in speech-related tasks remains underexplored. In this paper, we investigate the potential of LLMs for general-purpose speech abilities, focusing on speech recognition, synthesis, and understanding. We propose a unified framework that leverages the multimodal capabilities of LLMs to process and generate speech signals directly, without relying on traditional speech processing pipelines. Our approach involves fine-tuning a pre-trained LLM on paired text-speech data, enabling it to perform end-to-end speech-to-text, text-to-speech, and speech-to-speech translation tasks. Experimental results on benchmark datasets demonstrate that our model achieves competitive performance compared to specialized speech models, while exhibiting emergent abilities such as zero-shot speech adaptation and cross-lingual transfer. We further analyze the model's internal representations to understand how it encodes speech information, revealing that LLMs can learn robust phonetic and prosodic features. This work opens new avenues for integrating speech modalities into LLMs, paving the way for more versatile and accessible AI systems.},
