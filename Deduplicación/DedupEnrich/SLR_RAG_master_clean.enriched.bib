@article{collini_context-aware_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly impacted various sectors, including healthcare, where AI-driven diagnostic tools are increasingly integrated into clinical workflows. This paper presents a novel framework for AI-assisted medical image analysis, focusing on the detection and classification of anomalies in chest X-rays for early diagnosis of respiratory diseases such as pneumonia and tuberculosis. Our approach leverages a hybrid deep learning model combining convolutional neural networks (CNNs) with transformer architectures to enhance feature extraction and contextual understanding. The model was trained on a diverse dataset comprising over 100,000 annotated images from public repositories like ChestX-ray14 and MIMIC-CXR, achieving an accuracy of 96.2%, sensitivity of 95.8%, and specificity of 97.1%. We also address challenges such as data imbalance and interpretability through techniques like focal loss and attention visualization. Experimental results demonstrate superior performance compared to state-of-the-art methods, underscoring the potential of this framework for real-world deployment in resource-limited settings. Future work will explore integration with federated learning to ensure privacy-preserving collaborative training across institutions.},
