@article{agarwal_toward_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly impacted various sectors, including healthcare, where AI-driven diagnostic tools are increasingly integrated into clinical workflows. This paper presents a novel framework for AI-assisted medical image analysis, focusing on the detection and classification of anomalies in chest X-rays for early diagnosis of respiratory diseases. Our approach leverages a hybrid deep learning model combining convolutional neural networks (CNNs) with transformer architectures to enhance feature extraction and contextual understanding. The model was trained on a diverse dataset comprising over 100,000 annotated images from public repositories such as ChestX-ray14 and MIMIC-CXR, achieving an accuracy of 96.2%, sensitivity of 94.8%, and specificity of 97.1%. Comparative evaluations against state-of-the-art methods demonstrate superior performance, particularly in handling class imbalance and noisy data. Furthermore, we discuss ethical considerations, including bias mitigation strategies and interpretability enhancements via attention mechanisms. The proposed framework offers a scalable solution for resource-constrained environments, paving the way for broader adoption of AI in global health systems.},
