@article{xiong_when_2024,
 abstract = {Federated learning (FL) enables multiple clients to collaboratively train a shared model without exchanging raw data, thereby preserving privacy. However, the data across clients are often non-independent and identically distributed (non-IID), which degrades the performance of FL significantly. To address this challenge, numerous methods have been proposed from the perspectives of data distribution, model architecture, optimization algorithms, and communication efficiency. In this survey, we provide a comprehensive overview of FL on non-IID data. First, we introduce the background of FL and the causes of non-IID data. Then, we categorize and review the existing methods for handling non-IID data in FL, including data-level methods (e.g., data sharing and augmentation), model-level methods (e.g., personalized FL and multi-task learning), and algorithm-level methods (e.g., clustering and regularization). Furthermore, we discuss the evaluation metrics, datasets, and benchmarks for non-IID FL. Finally, we highlight the open challenges and future research directions in this field.},
