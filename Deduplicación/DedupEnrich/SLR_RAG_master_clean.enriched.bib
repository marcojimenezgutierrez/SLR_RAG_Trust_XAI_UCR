@inproceedings{i_vilar_accessible_2025,
 abstract = {Abstract—This study investigates the role of artificial intelligence (AI) in enhancing engineering education through personalized learning platforms. We developed an AI-driven adaptive system and tested it with 150 undergraduate students in a core engineering course. Results show a 25% improvement in learning outcomes and increased student engagement. The paper discusses implementation challenges, ethical considerations, and implications for future educational technologies.},
