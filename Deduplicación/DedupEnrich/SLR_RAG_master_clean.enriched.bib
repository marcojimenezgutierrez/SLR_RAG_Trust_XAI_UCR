@inproceedings{pu_customized_2024,
 abstract = {Visual Question Answering (VQA) has achieved remarkable progress with the development of large-scale pre-trained vision-language models. However, these models often exhibit biases toward certain answer categories, leading to unfair performance across different question types. In this paper, we investigate the fairness issue in VQA from the perspective of answer distribution imbalance. We first empirically analyze the bias patterns in VQA models and find that the models tend to predict majority answers more frequently, resulting in unfair treatment of minority answers. To mitigate this issue, we propose a novel framework called FairVQA, which consists of two key components: (1) a bias-aware answer prediction module that explicitly models the answer distribution to reduce bias, and (2) a fairness-aware training strategy that balances the prediction across different answer categories. Extensive experiments on the VQA-v2 dataset demonstrate the effectiveness of our approach in improving both accuracy and fairness. Our method achieves state-of-the-art performance while significantly reducing bias, paving the way for more equitable VQA systems.},
