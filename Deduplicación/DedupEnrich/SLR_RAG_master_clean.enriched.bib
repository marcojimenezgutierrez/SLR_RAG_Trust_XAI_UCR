@article{nazmy_survey_2025,
 abstract = {This study introduces a novel approach for enhancing the performance of federated learning (FL) in non-IID data environments by integrating a dynamic client selection mechanism with a personalized model aggregation strategy. Traditional FL methods often suffer from performance degradation due to data heterogeneity across clients, leading to suboptimal global model convergence. To address this, we propose FedDyCS, a framework that dynamically selects clients based on their local data distribution similarity to the global dataset, measured via a lightweight gradient-based metric. Additionally, we incorporate a personalized aggregation technique that adjusts the contribution weights of selected clients according to their model performance and data quality. Extensive experiments on benchmark datasets, including CIFAR-10, CIFAR-100, and EMNIST, demonstrate that FedDyCS outperforms state-of-the-art FL baselines by up to 15% in accuracy under severe non-IID settings, while maintaining communication efficiency and privacy preservation.},
