@inproceedings{zhang_exploring_2025,
 abstract = {This paper proposes a novel framework for enhancing cybersecurity in industrial control systems (ICS) using federated learning (FL) integrated with blockchain technology. Traditional centralized machine learning approaches face challenges such as data privacy concerns, single points of failure, and vulnerability to adversarial attacks in distributed ICS environments. Our framework leverages FL to enable collaborative model training across multiple ICS nodes without sharing raw data, thus preserving privacy. Blockchain is employed to ensure secure and tamper-proof aggregation of model updates, providing immutability and consensus mechanisms against malicious participants. We introduce a lightweight consensus protocol tailored for resource-constrained ICS devices, reducing computational overhead while maintaining security. Experimental evaluations on a simulated ICS testbed demonstrate that our approach achieves up to 25% improvement in anomaly detection accuracy compared to baseline FL methods, with minimal latency increase. The results highlight the framework's robustness against poisoning and evasion attacks, making it suitable for real-world deployment in critical infrastructure.},
