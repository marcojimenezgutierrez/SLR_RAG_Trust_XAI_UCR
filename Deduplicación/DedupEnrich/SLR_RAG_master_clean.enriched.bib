@article{joglekar_n_2025,
 abstract = {This study investigates the application of deep reinforcement learning (DRL) to dynamic job shop scheduling problems (DJSP) with machine breakdowns. Traditional scheduling methods often struggle with real-time uncertainties, leading to suboptimal performance. We propose a DRL-based framework that integrates convolutional neural networks for state representation and proximal policy optimization for decision-making. The model is trained on simulated environments incorporating random breakdowns and tested on benchmark instances. Results demonstrate superior performance over heuristic and metaheuristic approaches in terms of makespan reduction and robustness to disruptions. Sensitivity analysis highlights the impact of breakdown frequency and repair times on scheduling efficacy. This approach offers practical insights for smart manufacturing systems.},
