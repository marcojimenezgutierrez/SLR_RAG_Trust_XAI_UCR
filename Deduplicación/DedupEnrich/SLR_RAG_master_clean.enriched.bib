@article{noauthor_ecr_2024,
 abstract = {Radiomics is a quantitative approach to medical imaging, which aims to enhance the existing data available to clinicians by means of advanced mathematical analysis. Various steps are required to create a radiomics model, including image acquisition and preprocessing, segmentation, feature extraction and selection, model training and validation. Each step poses several challenges that may negatively impact the reproducibility and generalizability of the model. In this paper, we provide a step-by-step guide for creating a radiomics model and highlight the pitfalls and challenges at each step. We also discuss the current state of radiomics, its limitations and future directions. The goal is to provide a comprehensive resource for researchers and clinicians interested in radiomics, to help them navigate the complexities of this rapidly evolving field.},
