@incollection{lobo_mastering_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) and machine learning (ML) has revolutionized various sectors, including healthcare, where predictive analytics plays a pivotal role in early disease detection and personalized treatment. This chapter explores the application of ML algorithms in predicting cardiovascular diseases (CVD) using patient data from electronic health records (EHRs). We review key ML techniques such as logistic regression, random forests, support vector machines, and deep neural networks, evaluating their performance metrics including accuracy, precision, recall, and F1-score on benchmark datasets like the Framingham Heart Study and UCI Heart Disease dataset. Challenges such as data imbalance, feature selection, and interpretability are discussed, along with ethical considerations in AI-driven healthcare. Future directions include integrating multimodal data (e.g., genomics and imaging) and federated learning for privacy-preserving models. Our comparative analysis demonstrates that ensemble methods and gradient boosting machines outperform traditional approaches, achieving up to 95% accuracy in CVD risk prediction.},
