@inproceedings{zotelli_integrating_2025,
 abstract = {Machine learning (ML) systems are increasingly integrated into safety-critical applications, such as autonomous vehicles and medical diagnostics. However, ensuring the reliability of these systems remains a significant challenge due to their inherent uncertainties and complexities. This paper proposes a novel framework for reliability assessment of ML systems, focusing on quantifying and mitigating risks associated with model uncertainty, data drift, and adversarial attacks. We introduce a set of metrics tailored to ML-specific failure modes and validate our approach through case studies on real-world datasets. Our results demonstrate that the framework can improve reliability predictions by up to 25% compared to traditional methods, providing a practical tool for developers to enhance the dependability of ML deployments.},
