@inproceedings{twitchell_explaining_2025,
 abstract = {Social media platforms have become a primary source of news for many users, but the spread of misinformation poses significant challenges. While prior work has explored how users perceive and respond to misinformation, less is known about how they perceive and respond to corrections of misinformation. In this paper, we investigate how corrections influence users' perceptions of the original misinformation and the correcting source. Through a mixed-methods approach, including surveys and interviews with 1,200+ U.S. participants, we examine the effects of correction format (e.g., text, image, video) and source credibility on belief change, sharing intentions, and trust. Our findings reveal that corrections reduce belief in misinformation by an average of 25%, with video corrections being most effective (32% reduction). However, corrections from low-credibility sources can backfire, increasing skepticism toward the platform. We discuss implications for platform design and policy to enhance misinformation mitigation.},
