@inproceedings{yin_lies_2024,
 abstract = {Large-scale vision-language pre-trained models have shown remarkable performance in various downstream tasks. However, they also exhibit biases against certain social groups, which could lead to unfair decisions in real-world applications. Existing debiasing methods for vision-language models mainly focus on improving fairness in classification tasks, while the fairness of generative tasks remains underexplored. In this paper, we propose a simple yet effective approach to debias vision-language models for both classification and generative tasks. Our method, named Biased Prompts (BP), leverages the fact that vision-language models are sensitive to textual prompts. Specifically, we first identify the biased prompts that lead to unfair predictions, and then use them to guide the model to generate fairer outputs. Extensive experiments on various vision-language models and tasks demonstrate the effectiveness of our method in improving fairness without sacrificing accuracy.},
