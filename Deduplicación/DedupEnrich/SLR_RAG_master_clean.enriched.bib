@inproceedings{wallat_correctness_2025,
 abstract = {Social media platforms have become a primary source of news for many users, but the spread of misinformation poses significant risks to public discourse and decision-making. While previous work has explored the use of AI to detect misinformation, less attention has been paid to how users interact with and perceive AI-generated explanations for misinformation flags. In this paper, we investigate user perceptions of AI explanations for misinformation detection through a mixed-methods study with 1,200 participants. We examine explanations varying in transparency, justification, and actionability, and assess their impact on user trust, perceived accuracy, and behavioral intentions. Our findings reveal that users prefer explanations that provide clear justifications and actionable steps, but over-reliance on AI can lead to diminished critical thinking. We discuss implications for designing AI systems that foster user agency and mitigate misinformation effectively.},
