@book{noauthor_aiqam_2024,
 abstract = {Obesity is associated with increased risk of cardiovascular disease and type 2 diabetes. The mechanisms underlying these associations are incompletely understood. We performed a genome-wide association study for body mass index (BMI) in 123,865 individuals. We identified 18 loci that surpassed genome-wide significance (P < 5 × 10−8), including 13 novel loci. We confirmed these associations in an independent set of 125,931 individuals. The 18 loci together explained 1.45% of the variance in BMI. Pathway analyses implicated genes involved in neuronal processes. We also found significant enrichment of genes expressed in the central nervous system. Our findings provide insights into the genetic architecture of obesity and suggest that obesity susceptibility is determined by variants in genes with a role in neuronal processes.},
