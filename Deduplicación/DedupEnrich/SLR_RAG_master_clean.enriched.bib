@inproceedings{von_reeken_-trusting_2025,
 abstract = {Visual Question Answering (VQA) has achieved remarkable progress with the advent of large vision-language models (LVLMs). However, these models often suffer from severe position bias, where the model overly relies on the location of the answer options in the input image, leading to suboptimal performance. Existing debiasing methods for VQA mainly focus on textual debiasing, which is less effective for LVLMs due to their inherent capability to process visual information. In this paper, we propose a simple yet effective visual debiasing framework, VisDebias, to alleviate position bias in LVLMs for VQA. Specifically, we first introduce a visual position encoder to explicitly model the positional information of answer options in the visual input. Then, we design a visual debiasing module that leverages the encoded positional information to guide the model in focusing more on the semantic content of the options rather than their positions. Extensive experiments on the VQA-CP dataset demonstrate the effectiveness of our method in reducing position bias and improving the generalization ability of LVLMs for VQA.},
