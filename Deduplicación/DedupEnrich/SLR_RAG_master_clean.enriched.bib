@inproceedings{balakrishnan_evaluating_2024,
 abstract = {Diabetic Retinopathy (DR) is one of the major causes of blindness in working-age adults. Early detection and timely treatment can prevent vision loss. Manual screening for DR is time-consuming and requires experienced ophthalmologists. Automated screening systems can help in early detection of DR. In this paper, we propose a deep learning-based approach for the detection of DR using fundus images. The proposed model uses a convolutional neural network (CNN) architecture to classify fundus images into five stages of DR: No DR, Mild, Moderate, Severe, and Proliferative DR. The model is trained and evaluated on the EyePACS dataset, which contains 35,126 fundus images. The proposed model achieves an accuracy of 92.5%, sensitivity of 91.2%, and specificity of 93.8% on the test set. The results demonstrate the effectiveness of the proposed approach in detecting DR stages, which can assist ophthalmologists in early diagnosis and treatment planning.},
