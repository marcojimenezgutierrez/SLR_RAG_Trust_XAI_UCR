@article{chen_unleashing_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) has led to the development of large language models (LLMs) that exhibit remarkable capabilities in generating human-like text. However, these models often produce outputs that are biased, unsafe, or factually incorrect, posing significant risks in real-world applications. In this work, we propose a novel framework called SafePattern, which leverages pattern-based reasoning to enhance the safety and reliability of LLMs. By identifying and mitigating harmful patterns in the model's internal representations, SafePattern achieves a 25% reduction in toxic outputs while preserving performance on benign tasks. Our approach integrates symbolic pattern extraction with neural fine-tuning, offering a scalable solution for deploying trustworthy AI systems. Experimental results on benchmark datasets demonstrate the effectiveness of SafePattern across diverse domains, including healthcare and finance.},
