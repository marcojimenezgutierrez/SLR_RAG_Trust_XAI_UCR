@article{gobbs_benchmarking_2025,
 abstract = {Systemic lupus erythematosus (SLE) is a complex autoimmune disease with a strong genetic component. Genome-wide association studies (GWAS) have identified numerous susceptibility loci, but the functional variants and underlying mechanisms remain largely unknown. Here, we performed a large-scale trans-ancestry meta-analysis of SLE GWAS data from 27,393 cases and 63,341 controls of European, East Asian, and African ancestries, identifying 112 independent SLE risk loci, including 30 novel loci. Fine-mapping analyses prioritized 423 candidate causal variants, of which 104 showed strong colocalization with expression quantitative trait loci (eQTLs) in relevant immune cells. Functional characterization revealed that many variants disrupt transcription factor binding sites and alter enhancer activity, leading to dysregulation of genes involved in immune cell activation, interferon signaling, and B-cell differentiation. Integration with single-cell RNA sequencing data from SLE patients highlighted cell-type-specific effects, particularly in B cells and monocytes. These findings provide new insights into the genetic architecture of SLE and identify potential therapeutic targets for precision medicine approaches.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
 annote = {Article},
