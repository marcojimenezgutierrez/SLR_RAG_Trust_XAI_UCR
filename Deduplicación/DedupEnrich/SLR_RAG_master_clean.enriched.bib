@inproceedings{shailya_lext_2025,
 abstract = {Recent advancements in large language models (LLMs) have led to their widespread adoption across diverse applications, from creative writing to code generation. However, these models often exhibit biases, generating content that may perpetuate stereotypes or produce harmful outputs. While much research has focused on mitigating biases in text generation, less attention has been paid to biases in code generation, particularly in the context of generating code for user interfaces (UIs). In this paper, we investigate how LLMs generate UI code and whether these generations reflect societal biases. We conduct a systematic study using a dataset of UI descriptions derived from real-world apps, prompting LLMs to generate corresponding code. Our analysis reveals that LLMs frequently introduce gender and racial biases in UI elements such as avatars, names, and roles. For instance, when generating code for a "doctor" character, models disproportionately assign male pronouns and lighter skin tones. We further explore the implications of these biases for end-users and propose mitigation strategies, including fine-tuning with debaised datasets and prompt engineering techniques. Our findings highlight the need for bias-aware UI code generation to ensure equitable digital experiences.},
