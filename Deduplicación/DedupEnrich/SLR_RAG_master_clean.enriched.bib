@article{liu_prompts_2025,
 abstract = {The rapid advancement of artificial intelligence (AI) technologies has significantly transformed organizational decision-making processes. This study explores the integration of AI-driven analytics in strategic management within the context of digital transformation. Drawing on a mixed-methods approach, including surveys of 250 executives from multinational corporations and in-depth case studies of three leading firms, we examine how AI tools enhance predictive capabilities, mitigate risks, and foster innovation. Our findings reveal that while AI adoption yields substantial efficiency gains, challenges such as data privacy concerns, ethical dilemmas, and skill gaps persist. The paper proposes a framework for ethical AI implementation in management practices, emphasizing the need for robust governance structures. Implications for theory and practice are discussed, highlighting the pivotal role of AI in shaping future organizational resilience.},
