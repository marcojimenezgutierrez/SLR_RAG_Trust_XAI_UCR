@inproceedings{fleisch_context_2025,
 abstract = {This paper proposes a novel approach to multi-agent path finding (MAPF) in dynamic environments using deep reinforcement learning (DRL). Traditional MAPF methods often struggle with scalability and adaptability in changing scenarios. Our method employs a decentralized framework where each agent learns a policy via DRL to navigate while avoiding collisions and adapting to dynamic obstacles and other agents. We model the problem as a partially observable Markov decision process (POMDP) and use proximal policy optimization (PPO) for training. Experiments on standard benchmarks demonstrate that our approach outperforms centralized planners in terms of success rate and computation time, especially in large-scale, dynamic settings.},
