@inproceedings{atzenbeck_integrating_2024,
 abstract = {Amodal entity segmentation is a fundamental yet challenging task for many vision applications, such as autonomous driving and robotic manipulation. However, existing methods for amodal segmentation are limited to 2D images and struggle with 3D scenes due to occlusions and sparse observations. In this paper, we propose a novel framework for 3D amodal segmentation that leverages multi-modal data, including RGB images, depth maps, and point clouds, to predict complete object shapes in 3D space. Our approach consists of a multi-modal fusion module that integrates complementary information from different modalities, followed by a shape completion network that infers occluded regions. We introduce a new dataset for 3D amodal segmentation and evaluate our method on both synthetic and real-world scenes, achieving state-of-the-art performance in terms of IoU and boundary accuracy.},
