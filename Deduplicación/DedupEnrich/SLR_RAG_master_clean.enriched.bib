@article{luo_large_2025,
 abstract = {Federated learning (FL) has emerged as a promising paradigm for collaborative model training across distributed devices while preserving data privacy. However, the inherent statistical heterogeneity among clients poses significant challenges to the convergence and generalization of FL models. In this paper, we propose a novel FL framework, termed FedHGD, which integrates hierarchical gradient descent with dynamic client selection to address data heterogeneity. Specifically, we design a hierarchical aggregation mechanism that decomposes the global model updates into local and global components, enabling more effective knowledge sharing. Additionally, a dynamic selection strategy is introduced to prioritize clients with diverse data distributions, enhancing the robustness of the training process. Extensive experiments on benchmark datasets demonstrate that FedHGD outperforms state-of-the-art FL methods in terms of accuracy and convergence speed, particularly under non-IID data settings. Our work provides new insights into mitigating heterogeneity in FL and paves the way for practical deployments in real-world scenarios.},
