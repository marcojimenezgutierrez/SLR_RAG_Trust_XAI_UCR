@inproceedings{spatharioti_effects_2025,
 abstract = {Automatic text summarization is a longstanding and challenging task in natural language processing. With the advent of large language models (LLMs), there is a renewed interest in this task. However, existing benchmarks for evaluating summarization models are limited in scope and do not adequately assess the capabilities of LLMs. In this paper, we introduce RULER, a novel benchmark for evaluating LLMs on news summarization. RULER consists of 10 diverse news datasets spanning multiple domains and languages, with human-annotated summaries for each article. We evaluate several state-of-the-art LLMs on RULER and find that while they achieve high scores on standard metrics, they struggle with factual consistency and coherence. Our analysis reveals that LLMs often hallucinate facts and fail to capture the main events in the articles. We hope that RULER will serve as a valuable resource for the community to develop more robust summarization models.},
