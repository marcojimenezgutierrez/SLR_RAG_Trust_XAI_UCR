 keywords = {source: SPRINGER},
 title = {Integration of {Generative} {AI} with {Human} {Expertise} in {HEOR}: {A} {Hybrid} {Intelligence} {Framework}},
 url = {https://doi.org/10.1007/s12325-025-03273-w},
