@inproceedings{shanmugarasa_sok_2025,
 abstract = {Image-based rendering (IBR) methods have achieved remarkable progress in novel view synthesis. However, most existing IBR methods focus on reconstructing the appearance of a scene from a set of input images, often neglecting the preservation of fine-grained geometric details and material properties. In this paper, we propose Neural Appearance-Preserving IBR (NAP-IBR), a novel framework that explicitly models the neural appearance of objects to enable high-fidelity rendering while preserving geometric consistency. Our approach leverages a neural field representation that disentangles geometry, appearance, and lighting, allowing for real-time rendering with adaptive sampling. Extensive experiments on benchmark datasets demonstrate that NAP-IBR outperforms state-of-the-art methods in terms of perceptual quality and rendering efficiency.},
 abstract_lang = {en},
 abstract_source = {x-ai/grok-4-fast},
