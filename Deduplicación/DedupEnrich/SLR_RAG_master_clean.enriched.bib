@inproceedings{yang_leveraging_2025,
 abstract = {Explainable artificial intelligence (XAI) has become a hot research topic in the past few years. The main reason is that machine learning (ML) models, especially deep neural networks (DNNs), are black boxes that are hard to understand. This lack of interpretability is a major obstacle for their adoption in high-stakes domains such as healthcare. In this chapter, we provide a comprehensive overview of the current state-of-the-art in XAI with a focus on medical imaging applications. We first introduce the motivations and challenges of XAI in medical imaging. Then, we categorize XAI methods into three main groups: (1) feature attribution methods, (2) concept-based explanations, and (3) generative explanations. For each category, we discuss the main techniques, their strengths and limitations, and their applications in medical imaging tasks such as classification, segmentation, and detection. Finally, we discuss open challenges and future directions for XAI in medical imaging.},
