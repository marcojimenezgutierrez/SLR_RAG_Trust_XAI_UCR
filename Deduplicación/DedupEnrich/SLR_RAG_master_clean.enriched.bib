@inproceedings{liu_automatic_2024,
 abstract = {While recent advances in large language models have enabled them to process longer contexts, it remains unclear whether these models can effectively leverage information from long contexts. In this work, we systematically evaluate the performance of language models on tasks that require retrieving relevant information from long contexts. We find that language models often fail to leverage relevant information in the middle of long contexts, and that this failure is exacerbated as the context length increases. We call this the "lost in the middle" phenomenon. Our findings suggest that current language models may not be as capable of using long contexts as previously thought, and that future work should focus on improving their ability to utilize information from long contexts.},
