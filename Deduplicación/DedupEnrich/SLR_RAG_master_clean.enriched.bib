@inproceedings{shah_building_2024,
 abstract = {The rapid growth of the Internet of Things (IoT) has introduced significant security challenges due to the large number of interconnected devices and the sensitive data they handle. Traditional centralized security mechanisms are often inadequate for distributed IoT environments. This paper proposes a novel hybrid blockchain-based authentication and key agreement scheme for IoT devices, integrating elliptic curve cryptography (ECC) with a lightweight consensus mechanism to ensure mutual authentication, session key establishment, and resistance to common attacks such as man-in-the-middle, replay, and impersonation. The scheme is designed to minimize computational overhead, making it suitable for resource-constrained IoT devices. Performance analysis and formal security verification using the AVISPA tool demonstrate that the proposed scheme achieves high security levels with reduced communication and computation costs compared to existing protocols. Simulation results on a testbed with Raspberry Pi devices confirm its efficiency and practicality for real-world IoT deployments.},
