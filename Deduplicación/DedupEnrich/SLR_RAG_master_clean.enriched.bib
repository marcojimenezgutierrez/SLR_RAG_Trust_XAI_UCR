@inproceedings{liu_information_2024,
 abstract = {Visual question answering (VQA) models often exhibit biases toward the most frequently occurring answers for a given question, leading to poor generalization to underrepresented answers. Existing debiasing methods focus on improving the VQA model's performance on out-of-distribution (OOD) data but often fail to generalize to other OOD datasets due to their reliance on specific bias patterns. In this work, we propose a novel debiasing approach that leverages the uncertainty of the VQA model to identify and mitigate biases. Our method, Uncertainty-guided Debiasing (UGD), uses the model's predictive uncertainty to detect biased predictions and re-trains the model with a novel loss function that encourages it to assign higher uncertainty to biased answers. We evaluate UGD on multiple VQA datasets and show that it outperforms state-of-the-art debiasing methods in terms of OOD generalization while maintaining strong performance on in-distribution data.},
