@article{cao_survey_2025,
 abstract = {Time series data are central to many real-world applications, such as finance, weather forecasting, and traffic prediction. Traditional methods for time series analysis often struggle with capturing complex spatiotemporal dependencies. Graph neural networks (GNNs) have emerged as a powerful paradigm for modeling such dependencies by representing time series as graphs, where nodes capture temporal or spatial entities, and edges encode relationships. This survey provides a comprehensive overview of GNNs for time series analysis, focusing on four key tasks: forecasting, classification, imputation, and anomaly detection. We first introduce the foundational concepts of GNNs and their adaptations for time series data, including dynamic graph construction and temporal message passing. Then, we categorize and review state-of-the-art GNN-based methods for each task, highlighting their innovations, strengths, and limitations. Finally, we discuss open challenges, such as scalability, interpretability, and handling heterogeneous data, and outline promising future directions in this rapidly evolving field.},
